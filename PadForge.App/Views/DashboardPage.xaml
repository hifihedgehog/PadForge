                                            <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="2,0"/>
                                        </Button>
                                        <TextBlock Text="{Binding TypeInstanceLabel, StringFormat={}#{0}}"
                                                   FontFamily="{StaticResource TelemetryFontFamily}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   VerticalAlignment="Center" Margin="5,0,4,0"/>
                                    </StackPanel>
                                    </Border>

                                </StackPanel>

                                <!-- Delete button (upper-right corner). Hover-
                                     revealed (#175 phase 2 item 1a): opacity
                                     rides the card hover so the X never
                                     competes with the card face at rest, and
                                     keyboard focus brings it back for tab
                                     users. Stays focusable and hit-testable
                                     the whole time. Same treatment as the
                                     device list row X (maintainer report
                                     2026-07-06): the reveal watches the whole
                                     item container, the ItemsControl analogue
                                     of the ListBoxItem trigger there, not the
                                     nearest Border, which a future wrapper
                                     could silently hijack. The click routes
                                     through the shared confirm dialog in
                                     code-behind. -->
                                <ui:Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                           ToolTip="{Binding Main_DeleteVC, Source={x:Static strings:Strings.Instance}}"
                                           Click="DeleteSlot_Click" Tag="{Binding PadIndex}">
                                    <ui:Button.Style>
                                        <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource EmberIconButtonHot}">
                                            <Setter Property="Opacity" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </DataTrigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </ui:Button>

                                <!-- Row 2: Device name (compact). Cold: the
                                     physical device feeding this slot (#175). -->
                                <Border Grid.Row="2" ClipToBounds="True" Margin="0,8,0,0">
                                    <!-- Edge fade (#175 round 3, made conditional
                                         2026-07-06): MarqueeBehavior now applies the
                                         transparency ramps to this clip ancestor ONLY
                                         while the content actually overflows and
                                         scrolls. The static mask here dimmed the edges
                                         of fully-legible text ("No device mapped"). -->
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Empty state only: roster below owns the mapped case.
                                             Tertiary, not cold (#175 item 74): cold is reserved
                                             for real hardware facts, and "no device" is not one. -->
                                        <TextBlock Text="{Binding DeviceName}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MappedDevices.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MappedDevices}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- Device roster (#175): name + dynamic battery glyph
                                             per mapped device, pipe separators, marquee when
                                             the roster outgrows the card. -->
                                        <ItemsControl ItemsSource="{Binding MappedDevices}"
                                                      AlternationCount="99"
                                                      common:MarqueeBehavior.IsEnabled="True"
                                                      ToolTipService.InitialShowDelay="400"
                                                      ToolTipService.ShowDuration="20000">
                                            <!-- Full roster on hover (#175 competitor item 9):
                                                 the marquee stays (user direction), the tooltip
                                                 shows every device untruncated, one per line. -->
                                            <ItemsControl.ToolTip>
                                                <ToolTip>
                                                    <ItemsControl ItemsSource="{Binding MappedDevices}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                    <!-- Same offline dim as the roster line (#175
                                                                         phase 2 item 14). -->
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                                    <Setter Property="Opacity" Value="0.5"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <!-- Same device-class glyph as the roster line (#175). -->
                                                                    <TextBlock Text="{Binding TypeGlyph}"
                                                                               FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                    <TextBlock Text="{Binding Name}" FontSize="12">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource ColdBrush}"/>
                                                                                <Style.Triggers>
                                                                                    <!-- Cold is reserved for live hardware (#175):
                                                                                         offline names fall to tertiary. -->
                                                                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock Text="{Binding TransportGlyph}"
                                                                               FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                               VerticalAlignment="Center" Margin="5,0,0,0"
                                                                               Visibility="{Binding HasTransportGlyph, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                    <TextBlock Text="{Binding BatteryGlyph}"
                                                                               FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                               Foreground="{DynamicResource ColdBrush}"
                                                                               VerticalAlignment="Center" Margin="6,0,0,0"
                                                                               Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                    <TextBlock Text="{Binding BatteryText}"
                                                                               FontFamily="{StaticResource TelemetryFontFamily}" FontSize="10.5"
                                                                               Foreground="{DynamicResource ColdBrush}" Opacity="0.85"
                                                                               VerticalAlignment="Center" Margin="3,0,0,0"
                                                                               Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ToolTip>
                                            </ItemsControl.ToolTip>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <!-- Offline dim (#175 phase 2 item 14): a disconnected
                                                             device's line drops to half opacity so it can't
                                                             read as live while the count says otherwise.
                                                             Opacity only; the marquee is untouched. -->
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                        <Setter Property="Opacity" Value="0.5"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBlock Text="  |  " FontSize="12"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <!-- Device-class glyph (#175): keyboards read as keyboards,
                                                             mice as mice (DeviceTypeGlyph vocabulary); rides inside
                                                             each roster item so it repeats per device. -->
                                                        <TextBlock Text="{Binding TypeGlyph}"
                                                                   FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="12">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ColdBrush}"/>
                                                                    <Style.Triggers>
                                                                        <!-- Cold is reserved for live hardware (#175):
                                                                             offline names fall to tertiary. -->
                                                                        <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <!-- Transport (#175 competitor item 9): Bluetooth
                                                             links carry the E702 glyph, wired stays
                                                             unmarked. -->
                                                        <TextBlock Text="{Binding TransportGlyph}"
                                                                   FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                   VerticalAlignment="Center" Margin="5,0,0,0"
                                                                   Visibility="{Binding HasTransportGlyph, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <TextBlock Text="{Binding BatteryGlyph}"
                                                                   FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                   Foreground="{DynamicResource ColdBrush}"
                                                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                                                   Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <TextBlock Text="{Binding BatteryText}"
                                                                   FontFamily="{StaticResource TelemetryFontFamily}" FontSize="10.5"
                                                                   Foreground="{DynamicResource ColdBrush}" Opacity="0.85"
                                                                   VerticalAlignment="Center" Margin="3,0,0,0"
                                                                   Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Row 3: Status -->
                                <StackPanel Grid.Row="3" Orientation="Horizontal"
                                            Margin="0,2,0,0">
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource WaitBrush}"/>
                                                    </DataTrigger>
                                                    <!-- Gold requires mappings (#175): enabled but
                                                         empty reads Cold in tertiary steel. -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                                            <Condition Binding="{Binding MappedDeviceCount}" Value="0"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    </MultiDataTrigger>
                                                    <DataTrigger Binding="{Binding IsVirtualControllerConnected}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource EmberHotBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- Middle-dot separator (#175 iter 71, artifact):
                                         "Forging · 2 mapped, 1 connected". -->
                                    <TextBlock Text="·" FontSize="11" Margin="5,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding MappedDeviceCount, Mode=OneWay}"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Dashboard_Mapped, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ConnectedDeviceCount, Mode=OneWay}"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Dashboard_Connected, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Row 4: pipeline stage ledger (#175 item 10).
                                     One tab glyph per configuration stage the
                                     slot's assigned devices actually have,
                                     mirroring the Pad page capability gates.
                                     Ember when the stage carries a non-default
                                     configuration, ashen steel when inert.
                                     Hover = per-device readout in the fan-in
                                     annotation idiom: mono value tokens, Body
                                     device suffix, one line per covered device
                                     (STOCK for the untouched ones). Wrapped so
                                     long readouts never clip at the screen
                                     edge. Inert stages carry no tooltip. -->
                                <ItemsControl Grid.Row="4" ItemsSource="{Binding StageLedger}"
                                              Margin="1,7,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,9,0" Background="Transparent"
                                                  ToolTipService.IsEnabled="{Binding HasSummary}"
                                                  ToolTipService.InitialShowDelay="400"
                                                  ToolTipService.ShowDuration="20000">
                                                <Grid.ToolTip>
                                                    <ItemsControl ItemsSource="{Binding SummaryLines}" MaxWidth="400">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <!-- Icon, name, settings (user direction 2026-07-06):
                                                                     the same order as the card's main device label. -->
                                                                <TextBlock TextWrapping="Wrap" Margin="0,1,0,1"><Run Text="{Binding DeviceGlyph, Mode=OneWay}" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/><Run Text="{Binding DeviceName, Mode=OneWay}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/><Run Text="{Binding Tokens, Mode=OneWay}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></TextBlock>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid.ToolTip>
                                                <!-- Zacksly stick silhouette (Sticks stage). -->
                                                <Grid Width="12" Height="12"
                                                      Visibility="{Binding IsStickShape, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Path Data="{StaticResource ZackslyStickOuterRingGeometry}" Style="{StaticResource StageGlyphShape}"/>
                                                    <Path Data="{StaticResource ZackslyStickInnerDiscGeometry}" Style="{StaticResource StageGlyphShape}"/>
                                                </Grid>
                                                <!-- Zacksly trigger silhouette (Triggers stage). -->
                                                <Grid Width="12" Height="12"
                                                      Visibility="{Binding IsTriggerShape, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Path Data="{StaticResource ZackslyTriggerOuterBodyGeometry}" Style="{StaticResource StageGlyphShape}"/>
                                                </Grid>
                                                <!-- Font stages (gyro / lighting / touchpad / audio). -->
                                                <TextBlock Text="{Binding Glyph}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource StageGlyphText}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Glyph}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Hover chevron (#175 phase 2 item 3): the
                                     whole card opens the controller page, so
                                     hovering reveals the app's forward glyph
                                     (E72A, same as the PadPage routing arrows)
                                     at the right edge. Opacity swap only; no
                                     layout shift, no hit-testing. -->
                                <TextBlock Grid.RowSpan="5" Text="&#xE72A;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           IsHitTestVisible="False"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,0,1,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Opacity" Value="0"/>
                                            <Setter Property="Foreground" Value="{DynamicResource EmberBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.Resources>
            </ItemsControl>

            <!-- ═══ Services group (#175): everything below serves other
                 software. Status stays above the fold. ═══ -->
            <!-- One panel so the welcome tour can ring the whole group,
                 header through last card, as a single target. It carries
                 the group's top margin so the ring hugs the header. -->
            <StackPanel x:Name="ServicesSection" Margin="0,28,0,0">
            <!-- Group header (#175 round 3): outranks the section titles
                 below it by one step (ember tick + larger mono). -->
            <StackPanel Orientation="Horizontal">
                <!-- Ember, not EmberHot: the amber pair read yellow against
                     the page's ember section glyphs (user report 2026-07-05). -->
                <Rectangle Width="3" Height="12" RadiusX="1.5" RadiusY="1.5"
                           Fill="{DynamicResource EmberBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="ServicesHeader"
                           Text="{Binding Dashboard_Services, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}"
                           Style="{StaticResource SectionTitle}"
                           FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,6,0,0"/>

            <!-- ═══ Motion Server ═══ -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,12">
                <TextBlock Text="&#xE7AD;" Style="{StaticResource SectionGlyph}"/>
                <TextBlock Text="{Binding Dashboard_MotionServer, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}" Style="{StaticResource SectionTitle}"/>
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Dashboard_DsuDescription, Source={x:Static strings:Strings.Instance}}"
                               Style="{StaticResource CardDescription}" Margin="0,0,0,12"/>
                    <CheckBox Content="{Binding Dashboard_EnableDsu, Source={x:Static strings:Strings.Instance}}"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              IsChecked="{Binding EnableDsuMotionServer}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{Binding Dashboard_Port, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,8,0"/>
                        <ui:NumberBox Value="{Binding DsuMotionServerPort, Mode=TwoWay}"
                                      Minimum="1024" Maximum="65535"
                                      SpinButtonPlacementMode="Inline" Width="200"/>
                        <ui:Button Style="{StaticResource EmberIconButton}"
                                   Command="{Binding ResetDsuPortCommand}" VerticalAlignment="Center"
                                   ToolTip="{Binding Common_Reset, Source={x:Static strings:Strings.Instance}}">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </ui:Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <!-- Serving = flame (#175 item 76); the green dot stays
                             strictly health. Binds the server's running truth,
                             not the enable checkbox (#175 phase 2 item 2). -->
                        <Path Data="{StaticResource FlameOuterGeometry}"
                              Width="11" Height="11" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,6,0">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="Transparent"/>
                                    <Setter Property="Stroke" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <Setter Property="StrokeThickness" Value="1.1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDsuServerRunning}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                            <Setter Property="Stroke" Value="{x:Null}"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#FF6B2C" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Text="{Binding DsuServerStatus}" FontSize="12"
                                   FontFamily="{StaticResource TelemetryFontFamily}"
                                   Foreground="{DynamicResource ColdBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Dashboard_DsuFooter, Source={x:Static strings:Strings.Instance}}"
                               FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- ═══ Web Controller ═══ -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,12">
                <TextBlock Text="&#xE774;" Style="{StaticResource SectionGlyph}"/>
                <TextBlock Text="{Binding Dashboard_WebController, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}" Style="{StaticResource SectionTitle}"/>
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Dashboard_WebDescription, Source={x:Static strings:Strings.Instance}}"
                               Style="{StaticResource CardDescription}" Margin="0,0,0,12"/>
                    <CheckBox AutomationProperties.AutomationId="EnableWebControllerCheckBox"
                              Content="{Binding Dashboard_EnableWeb, Source={x:Static strings:Strings.Instance}}"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              IsChecked="{Binding EnableWebController}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{Binding Dashboard_Port, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,8,0"/>
                        <ui:NumberBox Value="{Binding WebControllerPort, Mode=TwoWay}"
                                      Minimum="1024" Maximum="65535"
                                      SpinButtonPlacementMode="Inline" Width="200"/>
                        <ui:Button Style="{StaticResource EmberIconButton}"
                                   Command="{Binding ResetWebPortCommand}" VerticalAlignment="Center"
                                   ToolTip="{Binding Common_Reset, Source={x:Static strings:Strings.Instance}}">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </ui:Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <!-- Serving = flame (#175 item 76). Running truth,
                             not the enable checkbox (#175 phase 2 item 2). -->
                        <Path Data="{StaticResource FlameOuterGeometry}"
                              Width="11" Height="11" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,6,0">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="Transparent"/>
                                    <Setter Property="Stroke" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <Setter Property="StrokeThickness" Value="1.1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWebControllerRunning}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                            <Setter Property="Stroke" Value="{x:Null}"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#FF6B2C" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Text="{Binding WebControllerStatus}" FontSize="12"
                                   FontFamily="{StaticResource TelemetryFontFamily}"
                                   Foreground="{DynamicResource ColdBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Dashboard_WebFooter, Source={x:Static strings:Strings.Instance}}"
                               FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Remote Link (issue #138) -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,12">
                <TextBlock Text="&#xE969;" Style="{StaticResource SectionGlyph}"/>
                <TextBlock Text="{Binding Dashboard_RemoteLink, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}" Style="{StaticResource SectionTitle}"/>
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Dashboard_RemoteLinkDescription, Source={x:Static strings:Strings.Instance}}"
                               Style="{StaticResource CardDescription}" Margin="0,0,0,12"/>

                    <!-- On / off + port + live status -->
                    <CheckBox AutomationProperties.AutomationId="EnableRemoteLinkCheckBox"
                              Content="{Binding Dashboard_EnableRemoteLink, Source={x:Static strings:Strings.Instance}}"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              IsChecked="{Binding EnableRemoteLink}" Margin="0,0,0,8"/>
                    <CheckBox Content="{Binding RemoteLink_AutoReconnect, Source={x:Static strings:Strings.Instance}}"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              IsChecked="{Binding AutoReconnect}" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{Binding Dashboard_Port, Source={x:Static strings:Strings.Instance}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ui:NumberBox Value="{Binding RemoteLinkPort, Mode=TwoWay}"
                                      Minimum="1024" Maximum="65535"
                                      SpinButtonPlacementMode="Inline" Width="200"/>
                        <ui:Button Style="{StaticResource EmberIconButton}"
                                   Command="{Binding ResetRemoteLinkPortCommand}" VerticalAlignment="Center"
                                   ToolTip="{Binding Common_Reset, Source={x:Static strings:Strings.Instance}}">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </ui:Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <!-- Serving = flame (#175 item 76). Running truth,
                             not the enable checkbox: identity-unlock errors
                             leave the server down while the box stays
                             checked (#175 phase 2 item 2). -->
                        <Path Data="{StaticResource FlameOuterGeometry}"
                              Width="11" Height="11" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,6,0">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="Transparent"/>
                                    <Setter Property="Stroke" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <Setter Property="StrokeThickness" Value="1.1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRemoteLinkRunning}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                            <Setter Property="Stroke" Value="{x:Null}"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#FF6B2C" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Text="{Binding RemoteLinkStatus}" FontSize="12"
                                   FontFamily="{StaticResource TelemetryFontFamily}"
                                   Foreground="{DynamicResource ColdBrush}"/>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,14,0,14"/>

                    <!-- Identity protection. Divider-separated section title inside
                         the card, so it wears CardSectionTitle (display face); the
                         14px/secondary/6px locals keep the established sub-title
                         step below CardTitle. -->
                    <TextBlock Text="{Binding RemoteLink_IdentityTitle, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource CardSectionTitle}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding RemoteLink_IdentityDescription, Source={x:Static strings:Strings.Instance}}"
                               Style="{StaticResource CardDescription}"/>
                    <ComboBox Margin="0,10,0,8" Width="320" HorizontalAlignment="Left"
                              ItemsSource="{Binding RemoteLink.IdentityProtectionModes}"
                              SelectedIndex="{Binding RemoteLink.IdentityProtectionModeIndex, Mode=TwoWay}"/>
                    <TextBlock Text="{Binding RemoteLink.IdentityProtectionHint}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>

                    <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,14,0,14"/>

                    <!-- Paired PCs: online dot · editable name · revoke -->
                    <TextBlock Text="{Binding RemoteLink_PairedPeers, Source={x:Static strings:Strings.Instance}}"
                               Style="{StaticResource CardSectionTitle}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding RemoteLink_PairedPeersDescription, Source={x:Static strings:Strings.Instance}}"
                               Style="{StaticResource CardDescription}"/>
                    <ItemsControl ItemsSource="{Binding RemoteLink.TrustedPeers}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Margin="2,0,10,0" ToolTip="{Binding OnlineText}">
                                        <Path.Style>
                                            <Style TargetType="Path" BasedOn="{StaticResource LivenessFlameBase}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                                        <Setter Property="Stroke" Value="{x:Null}"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#FF6B2C" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <ui:TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                    PlaceholderText="{Binding RemoteLink_PeerNamePlaceholder, Source={x:Static strings:Strings.Instance}}" MaxLength="40"
                                                    HorizontalAlignment="Left" MinWidth="240"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="2,3,0,0" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding HostName, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text="{Binding FingerprintDisplay, Mode=OneWay, StringFormat='  ·  {0}'}" FontFamily="{StaticResource TelemetryFontFamily}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- No Appearance=Primary (dark text on the accent
                                             slab): Connect is the row's primary affirmative
                                             and wears the shared ember accent instead. -->
                                        <ui:Button Content="{Binding Dashboard_RemoteLinkConnectButton, Source={x:Static strings:Strings.Instance}}"
                                                   Command="{Binding ConnectCommand}" Style="{StaticResource EmberPrimaryButton}" Margin="0,0,8,0"
                                                   Visibility="{Binding CanConnect, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <Button Content="{Binding RemoteLink_Revoke, Source={x:Static strings:Strings.Instance}}"
                                                Command="{Binding RevokeCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{Binding RemoteLink_RevokeAll, Source={x:Static strings:Strings.Instance}}"
                            Command="{Binding RemoteLink.RevokeAllPeersCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"/>

                    <!-- Nearby PCs not yet paired -->
                    <StackPanel Margin="0,14,0,0"
                                Visibility="{Binding RemoteLink.HasNearbyUnpaired, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding RemoteLink_NearbyTitle, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource CardSectionTitle}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding RemoteLink.NearbyUnpaired}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding HostPort}" FontSize="11" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" VerticalAlignment="Center"
                                                   Content="{Binding ButtonLabel}" IsEnabled="{Binding CanPair}"
                                                   Command="{Binding PairCommand}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,14,0,14"/>

                    <!-- Connect by address (fallback when discovery can't see the PC) -->
                    <TextBlock Text="{Binding Dashboard_RemoteLinkConnect, Source={x:Static strings:Strings.Instance}}"
                               Style="{StaticResource CardSectionTitle}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBox Text="{Binding RemoteLinkConnectHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="192.168.1.20:27500" Width="220" VerticalAlignment="Center"/>
                        <ui:Button Command="{Binding ConnectToPeerCommand}" Margin="8,0,0,0"
                                   Content="{Binding Dashboard_RemoteLinkConnectButton, Source={x:Static strings:Strings.Instance}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Dashboard_RemoteLinkFooter, Source={x:Static strings:Strings.Instance}}"
                               FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ═══ Menu Overlay (#9 B-17) ═══ -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,12">
                <!-- E700 = Segoe MDL2 GlobalNavButton, the canonical menu glyph. -->
                <TextBlock Text="&#xE700;" Style="{StaticResource SectionGlyph}"/>
                <TextBlock Text="{Binding Dashboard_MenuOverlay, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}" Style="{StaticResource SectionTitle}"/>
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Dashboard_MenuOverlayDescription, Source={x:Static strings:Strings.Instance}}"
                               Style="{StaticResource CardDescription}" Margin="0,0,0,12"/>
                    <CheckBox Content="{Binding Dashboard_MenuOverlay, Source={x:Static strings:Strings.Instance}}"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              IsChecked="{Binding EnableMenuOverlay}"/>
                </StackPanel>
            </Border>

            <!-- ═══ Touchpad Overlay ═══ -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,12">
                <TextBlock Text="&#xEDA4;" Style="{StaticResource SectionGlyph}"/>
                <TextBlock Text="{Binding Dashboard_TouchpadOverlay, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}" Style="{StaticResource SectionTitle}"/>
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Dashboard_TouchpadOverlayDescription, Source={x:Static strings:Strings.Instance}}"
                               Style="{StaticResource CardDescription}" Margin="0,0,0,12"/>
                    <CheckBox Content="{Binding Dashboard_EnableTouchpadOverlay, Source={x:Static strings:Strings.Instance}}"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              IsChecked="{Binding EnableTouchpadOverlay}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{Binding Dashboard_TouchpadOverlayOpacity, Source={x:Static strings:Strings.Instance}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" Width="80"/>
                        <Slider Value="{Binding TouchpadOverlayOpacity, Mode=TwoWay}"
                                Minimum="0.0" Maximum="1.0"
                                SmallChange="0.05" LargeChange="0.1"
                                Width="160" VerticalAlignment="Center">
                            <!-- Hover glow (#175): the thumb flips ember-hot on hover
                                 (SliderThumbBackgroundPointerOver), so the bloom is
                                 ember. BasedOn the implicit style so the themed
                                 template survives. -->
                            <Slider.Style>
                                <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Effect" Value="{StaticResource EmberHoverGlow}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Slider.Style>
                        </Slider>
                        <ui:NumberBox Value="{Binding TouchpadOverlayOpacityPercent, Mode=TwoWay}"
                                      Minimum="0" Maximum="100"
                                      SpinButtonPlacementMode="Inline" Width="130"
                                      Margin="8,0,0,0"/>
                        <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <ui:Button Style="{StaticResource EmberIconButton}"
                                   Command="{Binding ResetOpacityCommand}" VerticalAlignment="Center"
                                   ToolTip="{Binding Common_Reset, Source={x:Static strings:Strings.Instance}}">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </ui:Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Command="{Binding ResetTouchpadOverlayPositionCommand}"
                                Content="{Binding Dashboard_TouchpadOverlayResetPosition, Source={x:Static strings:Strings.Instance}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <!-- Serving = flame (#175 item 76). Binds the overlay
                             window's running truth, which already drives the
                             status text (#175 phase 2 item 2). -->
                        <Path Data="{StaticResource FlameOuterGeometry}"
                              Width="11" Height="11" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,6,0">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="Transparent"/>
                                    <Setter Property="Stroke" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <Setter Property="StrokeThickness" Value="1.1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTouchpadOverlayRunning}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                            <Setter Property="Stroke" Value="{x:Null}"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#FF6B2C" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Text="{Binding TouchpadOverlayStatus}" FontSize="12"
                                   FontFamily="{StaticResource TelemetryFontFamily}"
                                   Foreground="{DynamicResource ColdBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══ Driver status ═══ -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,12">
                <TextBlock Text="&#xED5D;" Style="{StaticResource SectionGlyph}"/>
                <TextBlock Text="{Binding Dashboard_Drivers, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}" Style="{StaticResource SectionTitle}"/>
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xED1A;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="HidHide" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding HidHideStatusText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="MIDI Services" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding MidiServicesStatusText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,8,0,0"/>

                </Grid>
            </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
