                                            </StackPanel>
                                            <TextBlock Text="{Binding Macro_PointerCycleModes_Hint, Source={x:Static strings:Strings.Instance}}"
                                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <ItemsControl ItemsSource="{Binding PointerCycleModeOptions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Label}"
                                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                  MinWidth="160" Margin="0,0,8,4"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Pointer Mode Set card (issue #203 follow-up): one fixed
                                         mode, the pointer sibling of the lightbar mode-set card.
                                         Combo mirrors the Pointer tab's mode picker. -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6"
                                            Visibility="{Binding IsPointerModeSetType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MacroAction_Type_PointerModeSet, Source={x:Static strings:Strings.Instance}}"
                                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Macro_PointerSetMode_Hint, Source={x:Static strings:Strings.Instance}}"
                                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <DockPanel LastChildFill="True" HorizontalAlignment="Left">
                                                <reset:SettingResetButton DockPanel.Dock="Right" Command="{Binding ResetSettingCommand}" CommandParameter="PointerSetMode" SettingLabel="{Binding Macro_PointerSetModeName, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_PointerSetMode_2687"/>
                                                <ComboBox Width="240" SelectedValuePath="Tag"
                                                          SelectedValue="{Binding PointerSetMode, Mode=TwoWay}">
                                                    <ComboBoxItem Content="{Binding Pad_Pointer_Mode_Mouse, Source={x:Static strings:Strings.Instance}}" Tag="Mouse"/>
                                                    <ComboBoxItem Content="{Binding Pad_Pointer_Mode_FpsMouse, Source={x:Static strings:Strings.Instance}}" Tag="FpsMouse"/>
                                                    <ComboBoxItem Content="{Binding Pad_Pointer_Mode_43, Source={x:Static strings:Strings.Instance}}" Tag="Mouse43"/>
                                                    <ComboBoxItem Content="{Binding Pad_Pointer_Mode_169, Source={x:Static strings:Strings.Instance}}" Tag="Mouse169"/>
                                                </ComboBox>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Switch Layer card (#377): one-shot jump to a shift
                                         layer on this slot. Choices are the slot's own tab
                                         strip (Base + every authored layer), the same
                                         name/mask pairs the layer-scope picker uses. -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6"
                                            Visibility="{Binding IsSwitchLayerType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MacroAction_Type_SwitchLayer, Source={x:Static strings:Strings.Instance}}"
                                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Macro_SwitchLayer_Hint, Source={x:Static strings:Strings.Instance}}"
                                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <DockPanel LastChildFill="True" HorizontalAlignment="Left">
                                                <reset:SettingResetButton DockPanel.Dock="Right" Command="{Binding ResetSettingCommand}" CommandParameter="SwitchLayerMask" SettingLabel="{Binding Macro_SwitchLayerName, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_SwitchLayerMask_2712"/>
                                                <ComboBox Width="240"
                                                          ItemsSource="{Binding DataContext.LayerTabs, RelativeSource={RelativeSource AncestorType=UserControl}}"
