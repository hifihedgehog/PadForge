<UserControl x:Class="PadForge.Controls.CurveEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <!-- Fixed square by default. In full-width mode (IsFullWidth) the
         code-behind clears the Width binding so the border stretches to
         the parent and pins Height to ChartHeight + padding. -->
    <Border x:Name="RootBorder"
            BorderBrush="{DynamicResource SteelLineSoftBrush}" BorderThickness="1" CornerRadius="2"
            Width="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=TotalSize}"
            Height="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=TotalSize}">
        <Canvas x:Name="ChartCanvas" Margin="3" ClipToBounds="True"
                MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                MouseMove="Canvas_MouseMove"
                MouseRightButtonDown="Canvas_MouseRightButtonDown"
                Background="Transparent">
        </Canvas>
    </Border>
</UserControl>
