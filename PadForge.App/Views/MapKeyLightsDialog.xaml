<ui:FluentWindow AutomationProperties.IsDialog="True" x:Class="PadForge.Views.MapKeyLightsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        xmlns:controls="clr-namespace:PadForge.Controls"
        xmlns:common="clr-namespace:PadForge.Common"
        xmlns:views="clr-namespace:PadForge.Views"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Title="{Binding MapKeyLights_Title, Source={x:Static strings:Strings.Instance}}"
        Height="640" Width="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <!-- Map Key Lights (#557), the Learn Handheld Button dialog's shape:
         the device, Start, what to do now, the picture with every light
         named so far, and the footer that forgets, exports or imports the
         model's names. While it listens, every key pressed names the lit
         light, Escape and Tab too. Ctrl+Tab stops, as it leaves the Key
         Colors card's picture. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Padding="14"
                BorderBrush="{DynamicResource SteelLineSoftBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5"
                           Fill="{DynamicResource EmberBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontFamily="{StaticResource DisplayFontFamily}"
                           FontWeight="SemiBold" FontSize="15"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           TextTrimming="CharacterEllipsis"/>
                <ui:Button Grid.Column="2" Style="{StaticResource EmberIconButton}"
                           VerticalAlignment="Center" Click="CloseButton_Click"
                           ToolTip="{Binding Common_Close, Source={x:Static strings:Strings.Instance}}">
                    <controls:GlyphText Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </ui:Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding MapKeyLights_Intro, Source={x:Static strings:Strings.Instance}}"
                       TextWrapping="Wrap" Margin="0,0,0,8"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{Binding MapKeyLights_DeviceLabel, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding DeviceName}" VerticalAlignment="Center" FontFamily="{StaticResource TelemetryFontFamily}"/>
                <TextBlock Text="{Binding Progress}" VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="StartBtn" Content="{Binding MapKeyLights_Start, Source={x:Static strings:Strings.Instance}}"
                        Click="StartButton_Click" MinWidth="100" Margin="0,0,8,0" Style="{StaticResource EmberAccentButton}"
                        IsEnabled="{Binding CanLearn}"/>
                <Button Content="{Binding MapKeyLights_Back, Source={x:Static strings:Strings.Instance}}"
                        Click="BackButton_Click" MinWidth="80" Margin="0,0,8,0" IsEnabled="{Binding IsListening}"/>
                <Button Content="{Binding MapKeyLights_Skip, Source={x:Static strings:Strings.Instance}}"
                        Click="SkipButton_Click" MinWidth="80" Margin="0,0,8,0" IsEnabled="{Binding IsListening}"
                        ToolTip="{Binding MapKeyLights_Skip_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                <Button Content="{Binding MapKeyLights_Forget, Source={x:Static strings:Strings.Instance}}"
                        Click="ForgetButton_Click" MinWidth="80" Margin="0,0,8,0" IsEnabled="{Binding IsListening}"
                        ToolTip="{Binding MapKeyLights_Forget_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                <Button Content="{Binding MapKeyLights_Stop, Source={x:Static strings:Strings.Instance}}"
                        Click="StopButton_Click" MinWidth="80" IsEnabled="{Binding IsListening}"/>
            </StackPanel>

            <!-- What to do now, ember while the dialog listens. A live region:
                 the dialog is driven by key presses, and a screen reader hears
                 the next light to name without leaving the keyboard. Naming a
                 light moves the count beside the device and this line together,
                 so the count is not announced as well. -->
            <TextBlock Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,8"
                       common:LiveText.Polite="True">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsListening}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource EmberBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <views:KeyLightsView Source="{Binding}" HorizontalAlignment="Left"
                                         AutomationProperties.Name="{Binding MapKeyLights_Title, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock Text="{Binding MapKeyLights_NoLightHint, Source={x:Static strings:Strings.Instance}}"
                               TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <!-- What an export or an import did. -->
                    <TextBlock x:Name="NoteText" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"
                               common:LiveText.Polite="True"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="5" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="{Binding MapKeyLights_Export, Source={x:Static strings:Strings.Instance}}" MinWidth="90" Margin="0,0,8,0" Click="ExportButton_Click"/>
                    <Button Content="{Binding MapKeyLights_Import, Source={x:Static strings:Strings.Instance}}" MinWidth="90" Margin="0,0,8,0" Click="ImportButton_Click"/>
                    <Button Content="{Binding MapKeyLights_ForgetAll, Source={x:Static strings:Strings.Instance}}" MinWidth="90" Click="ForgetAllButton_Click"
                            Style="{StaticResource EmberDestructiveButton}"
                            ToolTip="{Binding MapKeyLights_ForgetAll_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                </StackPanel>
                <Button Content="{Binding Common_Close, Source={x:Static strings:Strings.Instance}}" MinWidth="90" IsCancel="True" Click="CloseButton_Click" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
