<views:DialogWindow AutomationProperties.IsDialog="True" x:Class="PadForge.Views.ProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        xmlns:controls="clr-namespace:PadForge.Controls"
        xmlns:reset="clr-namespace:PadForge.Controls"
        xmlns:views="clr-namespace:PadForge.Views"
        Title="{Binding ProfileDialog_SaveAs, Source={x:Static strings:Strings.Instance}}"
        Subtitle="{Binding ProfileDialog_SaveAsDescription, Source={x:Static strings:Strings.Instance}}">

    <!-- New, Save As and Edit Profile (#574), as the Record board draws Edit
         Profile: the name, then the games that load the profile as chips on
         one wrapping line with the two ways to add one. The title and the
         line under it are the Save As pair here, and the code-behind sets
         the New or the Edit pair. The polling rate, which the board does
         not draw, is under More. -->
    <views:DialogWindow.Foot>
        <controls:FlexLinePanel Style="{StaticResource DialogFootPanel}">
            <Button Style="{StaticResource DialogButton}" IsCancel="True"
                    Content="{Binding Common_Cancel, Source={x:Static strings:Strings.Instance}}"/>
            <Button x:Name="SaveButton" Style="{StaticResource DialogPrimaryButton}" IsDefault="True"
                    Content="{Binding Common_Save, Source={x:Static strings:Strings.Instance}}"
                    Click="SaveButton_Click"/>
        </controls:FlexLinePanel>
    </views:DialogWindow.Foot>

    <StackPanel>
        <controls:SettingRow MinHeight="44">
            <TextBlock Style="{StaticResource DialogLabel}"
                       Text="{Binding ProfileDialog_ProfileName, Source={x:Static strings:Strings.Instance}}"/>
            <ui:TextBox x:Name="NameBox" Style="{StaticResource DialogTextBox}" controls:SettingRow.Fills="True"
                        AutomationProperties.Name="{Binding ProfileDialog_ProfileName, Source={x:Static strings:Strings.Instance}}"/>
        </controls:SettingRow>

        <TextBlock x:Name="GamesHead" Style="{StaticResource DialogHead3}"
                   Text="{Binding ProfileDialog_Executables, Source={x:Static strings:Strings.Instance}}"/>
        <!-- The code-behind puts one chip per game ahead of the two buttons,
             so the chips and the buttons wrap as one line. Both buttons edit
             the staged list: nothing is kept until Save. -->
        <controls:FlexLinePanel x:Name="GamesLine" Gap="8" LineGap="8" MinLineHeight="30">
            <Button x:Name="AddRunningGameButton" Style="{StaticResource DialogSmallQuietButton}"
                    Content="{Binding ProfileDialog_AddRunningGame, Source={x:Static strings:Strings.Instance}}"
                    Click="AddRunningGame_Click"/>
            <Button x:Name="BrowseButton" Style="{StaticResource DialogSmallQuietButton}"
                    Content="{Binding Common_Browse, Source={x:Static strings:Strings.Instance}}"
                    Click="BrowseButton_Click"/>
        </controls:FlexLinePanel>

        <!-- Polling rate override (#365, discussion #362): the loop stays
             global, and this profile retunes it while it is loaded. The
             first choice follows the Settings page's rate. -->
        <controls:MoreRow x:Name="ProfileMore" Style="{StaticResource DialogMoreRow}"
                          Header="{Binding Common_More, Source={x:Static strings:Strings.Instance}}"
                          Hint="{Binding ProfileDialog_MoreHint, Source={x:Static strings:Strings.Instance}}">
            <controls:SettingRow MinHeight="44">
                <TextBlock Style="{StaticResource DialogLabel}"
                           Text="{Binding ProfileDialog_PollingRate, Source={x:Static strings:Strings.Instance}}"/>
                <ComboBox x:Name="PollingRateBox" Style="{StaticResource DialogSelect}" MinWidth="200" SelectedIndex="0"
                          AutomationProperties.Name="{Binding ProfileDialog_PollingRate, Source={x:Static strings:Strings.Instance}}"/>
                <reset:SettingResetButton Click="ResetPollingRate_Click" Tag="" Visibility="{Binding Visibility, ElementName=PollingRateBox}" IsEnabled="{Binding IsEnabled, ElementName=PollingRateBox}" SettingLabel="{Binding ProfileDialog_PollingRate, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_?dialog_PollingRateBox_109"/>
            </controls:SettingRow>
        </controls:MoreRow>
    </StackPanel>
</views:DialogWindow>
