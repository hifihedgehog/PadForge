<views:DialogWindow AutomationProperties.IsDialog="True" x:Class="PadForge.Views.ManageProfilesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        xmlns:common="clr-namespace:PadForge.Common"
        xmlns:controls="clr-namespace:PadForge.Controls"
        xmlns:views="clr-namespace:PadForge.Views"
        Title="{Binding ManageProfiles_Title, Source={x:Static strings:Strings.Instance}}"
        Subtitle="{Binding ManageProfiles_Description, Source={x:Static strings:Strings.Instance}}">

    <!-- Controller Presets (#574), as the Links board draws it: the
         presets added so far, each with its own Export and Delete, then
         the two ways to add one, from a file or from a controller that is
         connected now. A preset from a controller is used at once and
         closes the dialog. One from a file stays, so several files can be
         added in one visit. -->
    <views:DialogWindow.Resources>
        <!-- A row is read by its preset's name. -->
        <Style x:Key="PresetRow" TargetType="ListBoxItem" BasedOn="{StaticResource DialogListItemLinks}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name, TargetNullValue=''}"/>
        </Style>
        <!-- A connected device: its name in the closed picker, and in the
             list its name over its ids. -->
        <DataTemplate x:Key="DeviceClosed">
            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
        <DataTemplate x:Key="DeviceInList">
            <StackPanel Margin="0,2">
                <TextBlock Text="{Binding DisplayName}"/>
                <TextBlock Text="{Binding DetailLine}" FontSize="13"
                           FontFamily="{DynamicResource TelemetryFontFamily}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </DataTemplate>
        <controls:PickTemplateSelector x:Key="DeviceLook" Closed="{StaticResource DeviceClosed}" List="{StaticResource DeviceInList}"/>
    </views:DialogWindow.Resources>

    <views:DialogWindow.Foot>
        <controls:FlexLinePanel Style="{StaticResource DialogFootPanel}">
            <Button x:Name="CloseButton" Style="{StaticResource DialogButton}" IsCancel="True"
                    Content="{Binding Common_Close, Source={x:Static strings:Strings.Instance}}"
                    Click="CloseButton_Click"/>
        </controls:FlexLinePanel>
    </views:DialogWindow.Foot>

    <StackPanel>
        <!-- The presets added so far. With none, the heading and the list
             are left out. -->
        <StackPanel x:Name="ImportedBlock">
            <TextBlock x:Name="ImportedHeaderText" Style="{StaticResource DialogHead3}" Margin="0,0,0,8"
                       Text="{Binding ManageProfiles_Imported, Source={x:Static strings:Strings.Instance}}"/>
            <Border Style="{StaticResource DialogList}" Margin="0,0,0,8">
                <ListBox x:Name="ImportedList" Style="{StaticResource DialogListBox}" MaxHeight="234"
                         ItemContainerStyle="{StaticResource PresetRow}"
                         AutomationProperties.Name="{Binding ManageProfiles_Imported, Source={x:Static strings:Strings.Instance}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Id}" Style="{StaticResource DialogMonoNote}" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"/>
                                    <!-- Why HIDMaestro left this preset out
                                         of the pickers (2.0.0 loads presets
                                         strictly). -->
                                    <TextBlock Text="{Binding Problem}" FontSize="13" TextWrapping="Wrap"
                                               Foreground="{DynamicResource WaitBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Problem}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Problem}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource DialogSmallQuietButton}"
                                        Content="{Binding ManageProfiles_Export, Source={x:Static strings:Strings.Instance}}"
                                        Click="ExportRow_Click" Tag="{Binding}"/>
                                <!-- Delete asks first. Its words are the
                                     danger color, as the board writes them. -->
                                <Button Grid.Column="2" Style="{StaticResource DialogSmallQuietButton}"
                                        Foreground="{DynamicResource DangerInkBrush}"
                                        Content="{Binding ManageProfiles_Delete, Source={x:Static strings:Strings.Instance}}"
                                        Click="DeleteRow_Click" Tag="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </StackPanel>

        <controls:SettingRow MinHeight="44">
            <Button x:Name="ImportFromFileButton" Style="{StaticResource DialogButton}"
                    Content="{Binding ManageProfiles_ImportFromFile, Source={x:Static strings:Strings.Instance}}"
                    Click="ImportFromFileButton_Click"/>
        </controls:SettingRow>

        <TextBlock Style="{StaticResource DialogHead3}"
                   Text="{Binding ManageProfiles_ImportFromDevice, Source={x:Static strings:Strings.Instance}}"/>
        <!-- The picker lists the devices connected as it opens. -->
        <controls:SettingRow MinHeight="44">
            <ComboBox x:Name="DeviceList" Style="{StaticResource DialogSelect}" controls:SettingRow.Fills="True"
                      ItemTemplateSelector="{StaticResource DeviceLook}"
                      SelectionChanged="DeviceList_SelectionChanged" DropDownOpened="DeviceList_DropDownOpened"
                      AutomationProperties.Name="{Binding ManageProfiles_ImportFromDevice, Source={x:Static strings:Strings.Instance}}"/>
            <Button x:Name="ImportButton" Style="{StaticResource DialogButton}" Margin="10,0,0,0" IsEnabled="False" IsDefault="True"
                    Content="{Binding ImportFromDevice_Import, Source={x:Static strings:Strings.Instance}}"
                    Click="ImportButton_Click"/>
        </controls:SettingRow>

        <TextBlock x:Name="StatusText" common:LiveText.Polite="True" Margin="0,8,0,0" FontSize="13" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
</views:DialogWindow>
