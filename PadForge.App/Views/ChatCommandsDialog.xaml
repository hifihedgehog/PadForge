<views:DialogWindow AutomationProperties.IsDialog="True" x:Class="PadForge.Views.ChatCommandsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        xmlns:common="clr-namespace:PadForge.Common"
        xmlns:controls="clr-namespace:PadForge.Controls"
        xmlns:views="clr-namespace:PadForge.Views"
        Title="{Binding TwitchChat_DialogTitle, Source={x:Static strings:Strings.Instance}}"
        Subtitle="{Binding TwitchChat_DialogSubtitle, Source={x:Static strings:Strings.Instance}}">

    <!-- The Twitch Chat row's words (#555, #574), as the Record board
         draws it: a word to add, and the words there are, each as a viewer
         types it. How viewers combine and hold words is the Word box's
         tooltip. Restore Usual Words leads the foot. -->
    <views:DialogWindow.Resources>
        <!-- A row is read by its word, as a viewer types it. -->
        <Style x:Key="WordItem" TargetType="ListBoxItem" BasedOn="{StaticResource DialogListItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Display, TargetNullValue=''}"/>
        </Style>
    </views:DialogWindow.Resources>

    <views:DialogWindow.Foot>
        <controls:FlexLinePanel Style="{StaticResource DialogFootPanel}">
            <Button Style="{StaticResource DialogQuietButton}"
                    Content="{Binding TwitchChat_RestoreButton, Source={x:Static strings:Strings.Instance}}"
                    ToolTip="{Binding TwitchChat_RestoreButton_Tooltip, Source={x:Static strings:Strings.Instance}}"
                    Click="RestoreButton_Click"/>
            <Button Style="{StaticResource DialogButton}" IsCancel="True"
                    Content="{Binding Common_Close, Source={x:Static strings:Strings.Instance}}"/>
        </controls:FlexLinePanel>
    </views:DialogWindow.Foot>

    <StackPanel>
        <controls:SettingRow MinHeight="44">
            <TextBlock Style="{StaticResource DialogLabelNarrow}"
                       Text="{Binding TwitchChat_WordLabel, Source={x:Static strings:Strings.Instance}}"/>
            <ui:TextBox x:Name="WordBox" Style="{StaticResource DialogTextBox}" controls:SettingRow.Fills="True"
                        MaxLength="24" KeyDown="WordBox_KeyDown"
                        PlaceholderText="{Binding TwitchChat_WordPlaceholder, Source={x:Static strings:Strings.Instance}}"
                        ToolTip="{Binding TwitchChat_DialogHint, Source={x:Static strings:Strings.Instance}}"
                        AutomationProperties.Name="{Binding TwitchChat_WordLabel, Source={x:Static strings:Strings.Instance}}"
                        AutomationProperties.HelpText="{Binding TwitchChat_DialogHint, Source={x:Static strings:Strings.Instance}}"/>
            <Button x:Name="AddBtn" Style="{StaticResource DialogPrimaryButton}" Margin="10,0,0,0"
                    Content="{Binding TwitchChat_AddButton, Source={x:Static strings:Strings.Instance}}"
                    Click="AddButton_Click"/>
        </controls:SettingRow>

        <!-- The last add's result, or why the word cannot be one. It takes
             no room while it says nothing. -->
        <TextBlock x:Name="MessageText" common:LiveText.Polite="True" Margin="70,2,0,0" FontSize="13"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>

        <!-- The words. With none, the heading and the list are left out. -->
        <StackPanel x:Name="WordsBlock">
            <TextBlock Style="{StaticResource DialogHead3}"
                       Text="{Binding TwitchChat_ListHeader, Source={x:Static strings:Strings.Instance}}"/>
            <Border Style="{StaticResource DialogList}">
                <ListBox x:Name="WordListBox" Style="{StaticResource DialogListBox}" MaxHeight="322"
                         ItemContainerStyle="{StaticResource WordItem}"
                         AutomationProperties.Name="{Binding TwitchChat_ListHeader, Source={x:Static strings:Strings.Instance}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center" Margin="0,0,12,0"
                                           FontFamily="{DynamicResource TelemetryFontFamily}"/>
                                <Button Grid.Column="1" Style="{StaticResource DialogSmallQuietButton}"
                                        Content="{Binding Common_Remove, Source={x:Static strings:Strings.Instance}}"
                                        Click="RemoveButton_Click" Tag="{Binding Word}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </StackPanel>
    </StackPanel>
</views:DialogWindow>
