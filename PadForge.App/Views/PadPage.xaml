                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44"
                                            IsEnabled="{Binding TouchpadMouseMomentum}">
                                    <TextBlock Text="{Binding Pad_Touchpad_MomentumMaxSpeed, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Pad_Touchpad_MomentumMaxSpeed_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding TouchpadMomentumMaxSpeed, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}" Minimum="0" Maximum="30" TickFrequency="1"
                                            ToolTip="{Binding Pad_Touchpad_MomentumMaxSpeed_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding TouchpadMomentumMaxSpeed, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F1}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <ui:Button Command="{Binding ResetTouchpadMomentumMaxSpeedCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadMomentumMaxSpeed, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44"
                                            IsEnabled="{Binding TouchpadMouseMomentum}">
                                    <TextBlock Text="{Binding Pad_Touchpad_MomentumStacking, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{Binding Pad_Touchpad_MomentumStacking, Source={x:Static strings:Strings.Instance}}"
                                              ToolTip="{Binding Pad_Touchpad_MomentumStacking_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding TouchpadMomentumStacking, Mode=TwoWay}"
