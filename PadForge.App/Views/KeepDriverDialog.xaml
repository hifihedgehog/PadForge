<views:DialogWindow AutomationProperties.IsDialog="True" x:Class="PadForge.Views.KeepDriverDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        xmlns:controls="clr-namespace:PadForge.Controls"
        xmlns:views="clr-namespace:PadForge.Views"
        BodyPadding="22,14,22,18">

    <!-- The Keep prompt after a keyboard's switch to PadForge's driver
         (#549), a mouse's, or a touchpad's switch to PadForge alone, as the
         Confirm board draws it: the question, what changed, and a bar that
         drains beside the seconds left. Give It Back holds the default and
         the focus, so Enter, Esc and the countdown all end on the undo.
         Keep fires only on a deliberate click (or Tab then Enter). The
         code-behind words the title and the line under it for the device. -->
    <views:DialogWindow.Foot>
        <controls:FlexLinePanel Style="{StaticResource DialogFootPanel}">
            <Button x:Name="GiveBackButton" Style="{StaticResource DialogButton}"
                    Content="{Binding Devices_DriverGiveBack, Source={x:Static strings:Strings.Instance}}"
                    IsCancel="True" IsDefault="True"/>
            <Button x:Name="KeepButton" Style="{StaticResource DialogButton}"
                    Content="{Binding Devices_DriverKeep, Source={x:Static strings:Strings.Instance}}"
                    Click="KeepButton_Click"/>
        </controls:FlexLinePanel>
    </views:DialogWindow.Foot>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <!-- The time left, drained at the timer's step. It is named by the
             sentence beside it, which the code-behind keeps in step. -->
        <ProgressBar x:Name="CountdownBar" Style="{StaticResource DialogCountdownBar}" VerticalAlignment="Center"/>
        <!-- The sentence, its number in the code face. A live region, so a
             screen reader says each second as it changes. -->
        <TextBlock x:Name="CountdownText" Grid.Column="1" Margin="12,0,0,0" FontSize="14"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   AutomationProperties.LiveSetting="Polite"/>
    </Grid>
</views:DialogWindow>
