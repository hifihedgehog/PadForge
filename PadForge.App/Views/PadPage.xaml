                                     SDL wheels, which expose no set-range API. Set Rotation
                                     Range off leaves the range to the wheel and its own
                                     software, and the slider rests (discussion #512). -->
                                <StackPanel x:Name="WheelRangeRow">
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Text="{Binding Pad_Wheel_SetRotationRange, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
