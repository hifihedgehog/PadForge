<UserControl x:Class="PadForge.Views.ExtrasPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:common="clr-namespace:PadForge.Common"
             xmlns:strings="clr-namespace:PadForge.Resources.Strings"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="po"
             xmlns:reset="clr-namespace:PadForge.Controls"
             xmlns:controls="clr-namespace:PadForge.Controls">

    <!-- The Extras page (#574): the optional features that were the ten
         Services cards of the Dashboard. It opens on a catalog of tiles,
         and each extra has a page of its own in one frame, as the boards
         draw it: the way back to the catalog, a head with the extra's
         square, its name, one line on what it does and its switch, then a
         status card, the cards of its settings, a More card that opens the
         rest in place, and a note. Every control came over as it was: its
         binding, its AutomationId, its reset button and its tooltip. The
         paragraphs the boards drop are the tooltips of what they explain.
         The data context is DashboardViewModel, Home's too.
         ExtrasPage.xaml.cs shows one of the eleven panels at a time. -->
    <UserControl.Resources>

        <!-- Hover glow sweep (#175): stock-chrome classes bloom in the same
             moment their hover fill shifts. BasedOn the WPF-UI defaults so
             theme brushes survive. -->
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <!-- MinHeight and Padding mirror the App.xaml implicit Button
                 style (36 tall, 14 at the sides), which this page-local
                 implicit replaces. -->
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>
        <Style TargetType="ui:Button" BasedOn="{StaticResource DefaultUiButtonStyle}">
            <!-- PadUiButtonTemplate: the App.xaml pressed-foreground fix.
                 Page-local implicits replace the app implicit, so the
                 Template setter rides along here too. -->
            <Setter Property="Template" Value="{StaticResource PadUiButtonTemplate}"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
            <!-- Mirrors the App.xaml implicit CheckBox style, which this
                 page-local implicit replaces: the box keeps corners of 4. -->
            <Setter Property="Border.CornerRadius" Value="4"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
            <!-- These five setters mirror the App.xaml implicit ComboBox
                 style, which this page-local implicit replaces. -->
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible"/>
            <Setter Property="MaxDropDownHeight" Value="200"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ui:NumberBox" BasedOn="{StaticResource DefaultUiNumberBoxStyle}">
        </Style>
        <Style TargetType="ui:TextBox" BasedOn="{StaticResource DefaultUiTextBoxStyle}">
            <!-- Selection setters mirror the App.xaml implicit ui:TextBox
                 style, which this page-local implicit replaces. -->
            <Setter Property="SelectionBrush" Value="{DynamicResource EmberBrush}"/>
            <Setter Property="SelectionOpacity" Value="0.35"/>
        </Style>

        <!-- The way back at the top of an extra's page: the catalog's name as
             a link, the app's own (LinkButton). -->
        <Style x:Key="ExtrasCrumb" TargetType="Button" BasedOn="{StaticResource LinkButton}"/>
        <Style x:Key="ExtrasCrumbText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="18.85"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Text on the boards' line, 1.45 of its size high, as their
             stylesheets set it, so what stands under a line of text stands
             where the boards put it: the small gray text (13), a card's
             title (16), a status (14) and a page's name (26). -->
        <Style x:Key="ExtraSmall" TargetType="TextBlock" BasedOn="{StaticResource CardDescription}">
            <Setter Property="LineHeight" Value="18.85"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        </Style>
        <Style x:Key="ExtraCardTitle" TargetType="TextBlock" BasedOn="{StaticResource CardTitle}">
            <Setter Property="LineHeight" Value="23.2"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        </Style>
        <!-- A page's name, and the catalog's: the boards' page title, 28
             in the display face, as on every page. -->
        <Style x:Key="ExtraTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="40.6"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        </Style>
        <Style x:Key="ExtraLine" TargetType="TextBlock" BasedOn="{StaticResource ExtraSmall}">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <!-- The card under a page's head that says how the extra is doing:
             its flame, its live status and, where the board draws one, a
             gray line and an action. -->
        <Style x:Key="ExtraStatusCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Padding" Value="20,14,16,14"/>
            <Setter Property="Margin" Value="0,20,0,0"/>
        </Style>
        <Style x:Key="ExtraStatusText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20.3"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        </Style>
        <Style x:Key="ExtraStatusHint" TargetType="TextBlock" BasedOn="{StaticResource ExtraSmall}">
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="ExtraCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Margin" Value="0,16,0,0"/>
        </Style>
        <!-- A setting's label: the page's one label column, 260 wide, the
             boards' usual width. A page whose board draws another shadows
             DzLabel in its panel's resources with this look at its own width
             (Head Tracking 300, Web Controller 230, Twitch Chat 200). A row
             that rests disables its label with it. -->
        <Style x:Key="ExtraLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DzLabel" TargetType="TextBlock" BasedOn="{StaticResource ExtraLabel}">
            <Setter Property="Width" Value="260"/>
        </Style>
        <!-- The gray words beside a switch in its row. They take the room the
             row has left and wrap in it. -->
        <Style x:Key="ExtraRowHint" TargetType="TextBlock" BasedOn="{StaticResource ExtraSmall}">
            <Setter Property="Margin" Value="12,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="controls:SettingRow.Fills" Value="True"/>
        </Style>
        <!-- A number as the boards draw one: a plain field 34 tall with its
             digits at the right, no spin buttons and no clear button. It stays
             a NumberBox, so it keeps its Minimum and Maximum. -->
        <Style x:Key="ExtraNumberBox" TargetType="ui:NumberBox" BasedOn="{StaticResource DefaultUiNumberBoxStyle}">
            <Setter Property="SpinButtonPlacementMode" Value="Hidden"/>
            <Setter Property="ClearButtonEnabled" Value="False"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- A port as the Motion Server, Game Mods and Web Controller boards
             draw it: 96 wide, in the mono face, from the left. -->
        <Style x:Key="ExtraPortBox" TargetType="ui:NumberBox" BasedOn="{StaticResource ExtraNumberBox}">
            <Setter Property="Width" Value="96"/>
            <Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}"/>
            <Setter Property="TextAlignment" Value="Left"/>
        </Style>
        <!-- A text field as the boards draw one: 34 tall, the text centered,
             no clear button. -->
        <Style x:Key="ExtraField" TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ClearButtonEnabled" Value="False"/>
        </Style>
        <!-- An address or a code, as the boards draw them: the mono face in
             the cold color, wrapping where the line is short. -->
        <Style x:Key="ExtraAddress" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource ColdBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- A paired PC's name, typed over in place: the look of a macro's
             name on the controller page (HeadNameEdit), at the line's size. -->
        <Style x:Key="PeerNameEdit" TargetType="TextBox" BasedOn="{StaticResource DzValueEdit}">
            <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="Margin" Value="-4,0,0,0"/>
            <Setter Property="Padding" Value="3,1"/>
            <Setter Property="MinWidth" Value="40"/>
        </Style>
        <!-- A button as the boards draw .btn: 36 tall with 14 at either side. -->
        <Style x:Key="ExtraButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ExtraNote" TargetType="TextBlock" BasedOn="{StaticResource ExtraSmall}">
            <Setter Property="Margin" Value="0,14,0,0"/>
        </Style>
        <!-- A link in a note: the boards' link color, lighter under the pointer. -->
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource EmberHotBrush}"/>
            <Setter Property="TextDecorations" Value="Underline"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource LinkHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- A line that waits on the user inside a card: a gold flame and why. -->
        <Style x:Key="ExtraWarnText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxWidth" Value="560"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>

        <!-- The three overlays as the Overlays board draws them, on its 84 by
             48 grid, in the overlays' own colors: the overlays do not follow
             the theme. The clear rectangle keeps the bounds. -->
        <DrawingImage x:Key="OverlaysPreviewMenu">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 H84 V48 H0 Z"/>
                    <GeometryDrawing Geometry="M27,24 A15,15 0 1 1 57,24 A15,15 0 1 1 27,24 Z">
                        <GeometryDrawing.Pen><Pen Brush="#3A475A" Thickness="9"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M42,9 A15,15 0 0 1 57,24">
                        <GeometryDrawing.Pen><Pen Brush="#FF6B2C" Thickness="9"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="OverlaysPreviewShift">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 H84 V48 H0 Z"/>
                    <GeometryDrawing Brush="#2D2E2E">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="14,14,56,20" RadiusX="6" RadiusY="6"/></GeometryDrawing.Geometry>
                        <GeometryDrawing.Pen><Pen Brush="#3A475A" Thickness="1"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M24,28 V22 L21,25 M24,22 L27,25">
                        <GeometryDrawing.Pen><Pen Brush="#EEF2F7" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#A9B4C4">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="34,21.5,28,5" RadiusX="2.5" RadiusY="2.5"/></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="OverlaysPreviewProfile">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 H84 V48 H0 Z"/>
                    <GeometryDrawing Brush="#2D2E2E">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="10,14,64,20" RadiusX="6" RadiusY="6"/></GeometryDrawing.Geometry>
                        <GeometryDrawing.Pen><Pen Brush="#3A475A" Thickness="1"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FF6B2C" Geometry="M22,19 C22.5,20.8 24.8,21.8 24.8,24.3 A2.8,2.8 0 0 1 19.2,24.3 C19.2,21.8 21.5,20.8 22,19 Z"/>
                    <GeometryDrawing Brush="#A9B4C4">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="32,21.5,34,5" RadiusX="2.5" RadiusY="2.5"/></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <Style x:Key="OverlaysPreviewWell" TargetType="Border">
            <Setter Property="Width" Value="84"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource SteelFieldBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <!-- The page gutter sits on the scrolled panel, not on the scroll
         viewer: the light around a tile that is on needs room inside the
         scroll clip. It is the boards': 36 at the sides and the foot, 26
         over the title. Text with no size of its own is the boards' 14. -->
    <ScrollViewer x:Name="PageScroll" AutomationProperties.Name="{Binding Extras_Title, Source={x:Static strings:Strings.Instance}}">
        <StackPanel Margin="36,26,36,36" TextElement.FontSize="14">

            <!-- ═══ The catalog ═══
                 One tile for each extra, in three groups. A tile's switch is the
                 extra's own setting, the one its page shows, so the two always
                 agree. A click on a tile anywhere else opens the extra's page
                 (ExtraTile.OpenRequested, handled once here for every tile).
                 A group's tiles are at least 240 wide and share their row's
                 whole width, so a row of four and a row of three both end
                 at the page's edge, and four that do not fit one row stand
                 two and two. A tile is lit while its extra is on and the
                 engine runs (Heat.IsLive). The head's end says how many of
                 the extras are on, the number Home's Extras in Use counts. -->
            <StackPanel x:Name="CatalogView" controls:ExtraTile.OpenRequested="Tile_OpenRequested"
                        controls:Heat.IsLive="{Binding IsEngineOn}">
                <controls:FlexLinePanel x:Name="CatalogHead" Gap="16" LineGap="8">
                    <StackPanel controls:FlexLinePanel.Basis="320" controls:FlexLinePanel.Grow="1">
                        <TextBlock AutomationProperties.HeadingLevel="Level1" Text="{Binding Extras_Title, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraTitle}"/>
                        <TextBlock Text="{Binding Extras_Subtitle, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraLine}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <!-- 2 of 10 on: the number in the code face, large and
                         ember, and the words around it as the language puts
                         them. The three runs stay on one line so no space
                         falls between them. A screen reader hears the
                         sentence whole. -->
                    <TextBlock x:Name="OnCountText" VerticalAlignment="Bottom" FontSize="14"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               AutomationProperties.AutomationId="Extras_OnCount"
                               AutomationProperties.Name="{Binding ExtrasOnSpoken, TargetNullValue='', FallbackValue=''}"><Run Text="{Binding ExtrasOnLead, Mode=OneWay}"/><Run Text="{Binding ExtrasOnNumber, Mode=OneWay}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource EmberHotBrush}"/><Run Text="{Binding ExtrasOnTail, Mode=OneWay}"/></TextBlock>
                </controls:FlexLinePanel>

                <TextBlock Text="{Binding Extras_Group_Play, Source={x:Static strings:Strings.Instance}}"
                           Style="{StaticResource PageSectionTitle}" Margin="0,26,0,12"/>
                <controls:TileGridPanel MinItemWidth="240" Gap="14" FillRows="True" Balance="True">
                    <controls:ExtraTile x:Name="WebControllerTile" Key="WebController" Glyph="&#xE774;"
                                        Title="{Binding Dashboard_WebController, Source={x:Static strings:Strings.Instance}}"
                                        Line="{Binding Extras_Tile_WebController, Source={x:Static strings:Strings.Instance}}"
                                        SwitchLabel="{Binding Dashboard_EnableWeb, Source={x:Static strings:Strings.Instance}}"
                                        ActionText="{Binding Home_ShowQr, Source={x:Static strings:Strings.Instance}}"
                                        IsOn="{Binding EnableWebController}"
                                        Status="{Binding WebControllerStatus}"/>
                    <controls:ExtraTile x:Name="HeadTrackingTile" Key="HeadTracking" Glyph="&#xE77B;"
                                        Title="{Binding Dashboard_HeadTracking, Source={x:Static strings:Strings.Instance}}"
                                        Line="{Binding Extras_Tile_HeadTracking, Source={x:Static strings:Strings.Instance}}"
                                        SwitchLabel="{Binding Dashboard_HeadTracking, Source={x:Static strings:Strings.Instance}}"
                                        IsOn="{Binding HeadTrackingAnyEnabled}"
                                        Status="{Binding HeadTrackingStatus}"/>
                    <controls:ExtraTile x:Name="GameTelemetryTile" Key="GameTelemetry" Glyph="&#xEC4A;"
                                        Title="{Binding Dashboard_GameTelemetry, Source={x:Static strings:Strings.Instance}}"
                                        Line="{Binding Extras_Tile_GameTelemetry, Source={x:Static strings:Strings.Instance}}"
                                        SwitchLabel="{Binding Dashboard_EnableGameTelemetry, Source={x:Static strings:Strings.Instance}}"
                                        IsOn="{Binding EnableGameTelemetry}"
                                        Status="{Binding GameTelemetryStatus}"/>
                    <controls:ExtraTile x:Name="TwitchChatTile" Key="TwitchChat" Glyph="&#xE8F2;"
                                        Title="{Binding Dashboard_TwitchChat, Source={x:Static strings:Strings.Instance}}"
                                        Line="{Binding Extras_Tile_TwitchChat, Source={x:Static strings:Strings.Instance}}"
                                        SwitchLabel="{Binding Dashboard_EnableTwitchChat, Source={x:Static strings:Strings.Instance}}"
                                        IsOn="{Binding EnableTwitchChat}"
                                        Status="{Binding TwitchChatStatus}"/>
                </controls:TileGridPanel>

                <TextBlock Text="{Binding Extras_Group_Send, Source={x:Static strings:Strings.Instance}}"
                           Style="{StaticResource PageSectionTitle}" Margin="0,26,0,12"/>
                <controls:TileGridPanel MinItemWidth="240" Gap="14" FillRows="True" Balance="True">
                    <controls:ExtraTile x:Name="RemoteLinkTile" Key="RemoteLink" Glyph="&#xE969;"
                                        Title="{Binding Dashboard_RemoteLink, Source={x:Static strings:Strings.Instance}}"
                                        Line="{Binding Extras_Tile_RemoteLink, Source={x:Static strings:Strings.Instance}}"
                                        SwitchLabel="{Binding Dashboard_EnableRemoteLink, Source={x:Static strings:Strings.Instance}}"
                                        IsOn="{Binding EnableRemoteLink}"
                                        Status="{Binding RemoteLinkStatus}"/>
                    <controls:ExtraTile x:Name="MotionServerTile" Key="MotionServer" Glyph="&#xE7AD;"
                                        Title="{Binding Dashboard_MotionServer, Source={x:Static strings:Strings.Instance}}"
                                        Line="{Binding Extras_Tile_MotionServer, Source={x:Static strings:Strings.Instance}}"
                                        SwitchLabel="{Binding Dashboard_EnableDsu, Source={x:Static strings:Strings.Instance}}"
                                        IsOn="{Binding EnableDsuMotionServer}"
                                        Status="{Binding DsuServerStatus}"/>
                    <controls:ExtraTile x:Name="GameModsTile" Key="GameMods" Glyph="&#xEA86;"
                                        Title="{Binding Dashboard_GameMods, Source={x:Static strings:Strings.Instance}}"
                                        Line="{Binding Extras_Tile_GameMods, Source={x:Static strings:Strings.Instance}}"
                                        SwitchLabel="{Binding Dashboard_EnableGameMods, Source={x:Static strings:Strings.Instance}}"
                                        IsOn="{Binding EnableGameModServer}"
                                        Status="{Binding GameModServerStatus}"/>
                </controls:TileGridPanel>

                <TextBlock Text="{Binding Extras_Group_Screen, Source={x:Static strings:Strings.Instance}}"
                           Style="{StaticResource PageSectionTitle}" Margin="0,26,0,12"/>
                <controls:TileGridPanel MinItemWidth="240" Gap="14" FillRows="True" Balance="True">
                    <controls:ExtraTile x:Name="OverlaysTile" Key="Overlays" Glyph="&#xE700;"
                                        Title="{Binding Dashboard_Overlays, Source={x:Static strings:Strings.Instance}}"
                                        Line="{Binding Extras_Tile_Overlays, Source={x:Static strings:Strings.Instance}}"
                                        SwitchLabel="{Binding Dashboard_Overlays, Source={x:Static strings:Strings.Instance}}"
                                        IsOn="{Binding OverlaysAnyEnabled}"/>
                    <controls:ExtraTile x:Name="TouchpadOverlayTile" Key="TouchpadOverlay" Glyph="&#xEDA4;"
                                        Title="{Binding Dashboard_TouchpadOverlay, Source={x:Static strings:Strings.Instance}}"
                                        Line="{Binding Extras_Tile_TouchpadOverlay, Source={x:Static strings:Strings.Instance}}"
                                        SwitchLabel="{Binding Dashboard_EnableTouchpadOverlay, Source={x:Static strings:Strings.Instance}}"
                                        IsOn="{Binding EnableTouchpadOverlay}"
                                        Status="{Binding TouchpadOverlayStatus}"/>
                    <controls:ExtraTile x:Name="ScreenOverlayTile" Key="ScreenOverlay" Glyph="&#xE7F4;"
                                        Title="{Binding Dashboard_ScreenOverlay, Source={x:Static strings:Strings.Instance}}"
                                        Line="{Binding Extras_Tile_ScreenOverlay, Source={x:Static strings:Strings.Instance}}"
                                        SwitchLabel="{Binding Dashboard_ScreenOverlay, Source={x:Static strings:Strings.Instance}}"
                                        IsOn="{Binding ScreenOverlaysAnyEnabled}"/>
                </controls:TileGridPanel>
            </StackPanel>

            <!-- ═══ Web Controller ═══
                 Connect a Phone (the QR code, three steps and the address, or
                 why there is none) beside the phones connected now. Under
                 More: the port, and the plain HTTP address with its own port,
                 This PC Only and the access code. -->
            <StackPanel x:Name="WebControllerPage" Visibility="Collapsed">
                <StackPanel.Resources>
                    <!-- The Web Controller's rows, as its board draws them: a label column 230 wide. -->
                    <Style x:Key="DzLabel" TargetType="TextBlock" BasedOn="{StaticResource ExtraLabel}">
                        <Setter Property="Width" Value="230"/>
                    </Style>
                </StackPanel.Resources>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ExtrasCrumb}" Click="Back_Click"
                            AutomationProperties.AutomationId="Extras_Back_WebController"
                            Content="{Binding Extras_Title, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock Text="/" Style="{StaticResource ExtrasCrumbText}" Margin="4,0,4,0"/>
                    <TextBlock Text="{Binding Dashboard_WebController, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtrasCrumbText}"/>
                </StackPanel>
                <controls:HeadRowPanel LeadingMinWidth="328" Gap="12" Margin="0,10,0,0">
                    <Grid Margin="0,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:ExtraBadge Glyph="&#xE774;" IsOn="{Binding EnableWebController}"/>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="WebControllerTitle" AutomationProperties.HeadingLevel="Level1" Text="{Binding Dashboard_WebController, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraTitle}"/>
                            <TextBlock Text="{Binding Dashboard_WebDescription, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraLine}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <CheckBox Style="{StaticResource SwitchCheckBox}" controls:SwitchLook.ShowState="True"
                                  AutomationProperties.AutomationId="EnableWebControllerCheckBox"
                                  Content="{Binding Dashboard_EnableWeb, Source={x:Static strings:Strings.Instance}}"
                                  IsChecked="{Binding EnableWebController}"/>
                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="EnableWebController" SettingLabel="{Binding Dashboard_EnableWeb, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DashboardViewModel_EnableWebController_1488" Margin="14,0,0,0"/>
                    </StackPanel>
                </controls:HeadRowPanel>

                <!-- Connect a Phone and Phones side by side while both fit, as
                     the board's line: bases 460 and 300, the first takes what
                     is left, both as tall as the taller. -->
                <controls:FlexLinePanel Margin="0,20,0,0" Gap="16" LineGap="16">
                    <Border x:Name="WebControllerConnectCard" Style="{StaticResource ExtraCard}" Margin="0" Padding="20,14,20,20"
                            controls:FlexLinePanel.Basis="460" controls:FlexLinePanel.Grow="999">
                        <StackPanel>
                            <TextBlock Text="{Binding Extras_WebController_ConnectTitle, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraCardTitle}"/>
                            <controls:FlexLinePanel Margin="0,14,0,0" Gap="28" LineGap="20">
                                <!-- The QR code while the server serves (#296). White, so
                                     it scans in either theme. -->
                                <Border Width="168" Height="168" CornerRadius="10" Background="White" Padding="6" VerticalAlignment="Center"
                                        Visibility="{Binding HasWebControllerQr, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Image FlowDirection="LeftToRight" Source="{Binding WebControllerQr}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" RenderOptions.EdgeMode="Aliased"
                                           AutomationProperties.Name="{Binding WebControllerUrl, TargetNullValue='', FallbackValue=''}"/>
                                </Border>
                                <StackPanel controls:FlexLinePanel.Basis="240" controls:FlexLinePanel.Grow="1" VerticalAlignment="Center">
                                    <!-- Three steps, numbered in a 20 wide gutter. -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="1." Style="{StaticResource ExtraStatusText}" TextAlignment="Right" Margin="0,0,5,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Extras_WebController_Step1, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraStatusText}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="2." Style="{StaticResource ExtraStatusText}" TextAlignment="Right" Margin="0,0,5,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Extras_WebController_Step2, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraStatusText}"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="3." Style="{StaticResource ExtraStatusText}" TextAlignment="Right" Margin="0,0,5,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Extras_WebController_Step3, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraStatusText}"/>
                                    </Grid>
                                    <!-- The address while the server serves. -->
                                    <controls:FlexLinePanel Margin="0,16,0,0" Gap="10" LineGap="8"
                                                            Visibility="{Binding HasWebControllerQr, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Style="{StaticResource ExtraAddress}" Text="{Binding WebControllerUrl}"/>
                                        <ui:Button AutomationProperties.AutomationId="WebController_CopyAddress" MinHeight="32" Padding="12,0"
                                                   VerticalAlignment="Center" Command="{Binding CopyWebControllerUrlCommand}"
                                                   Content="{Binding Extras_CopyAddress, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:FlexLinePanel>
                                    <!-- In the address's place while the server does not
                                         serve: why ("Port 8080 in use", "Failed to start"). -->
                                    <DockPanel Margin="0,16,0,0"
                                               Visibility="{Binding HasWebControllerQr, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                        <controls:StatusFlame DockPanel.Dock="Left" IsOn="{Binding EnableWebController}" IsLive="{Binding IsWebControllerRunning}"
                                                              VerticalAlignment="Top" Margin="0,1,12,0"/>
                                        <TextBlock common:LiveText.Polite="True" Text="{Binding WebControllerStatus}" Style="{StaticResource ExtraStatusText}"/>
                                    </DockPanel>
                                    <!-- The main address fell back to plain HTTP: why phone
                                         motion is off. -->
                                    <DockPanel Margin="0,12,0,0" Visibility="{Binding WebControllerHttpsWarning, Converter={StaticResource StringToVisibility}}">
                                        <Path DockPanel.Dock="Left" FlowDirection="LeftToRight" Data="{StaticResource FlameOuterGeometry}" Width="16" Height="16"
                                              Stretch="Uniform" Fill="{DynamicResource WaitBrush}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                                        <TextBlock Text="{Binding WebControllerHttpsWarning}" Style="{StaticResource ExtraWarnText}"/>
                                    </DockPanel>
                                </StackPanel>
                            </controls:FlexLinePanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="WebControllerPhonesCard" Style="{StaticResource ExtraCard}" Margin="0" Padding="20,14,20,20"
                            controls:FlexLinePanel.Basis="300" controls:FlexLinePanel.Grow="1">
                        <StackPanel>
                            <TextBlock Text="{Binding Extras_WebController_Phones, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraCardTitle}"/>
                            <StackPanel Margin="0,14,0,0">
                                <ItemsControl ItemsSource="{Binding WebControllerPhones}" AutomationProperties.AutomationId="WebController_Phones">
                                    <!-- Out of the screen-reader tree while empty, as the
                                         paired PCs are. -->
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl" BasedOn="{StaticResource {x:Type ItemsControl}}">
                                            <Setter Property="Focusable" Value="False"/>
                                            <Style.Triggers>
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" MinHeight="32">
                                                <controls:StatusFlame IsOn="True" IsLive="True" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Extras_WebController_NoPhones, Source={x:Static strings:Strings.Instance}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ExtraStatusText}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WebControllerPhones.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Extras_WebController_PhonesHint, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraSmall}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </controls:FlexLinePanel>

                <controls:FoldList Gap="0" Margin="0,16,0,0">
                    <controls:MoreRow x:Name="WebControllerMore" Style="{StaticResource MoreCardRow}" StateKey="Extras.WebController.More"
                                      AutomationProperties.AutomationId="Extras_More_WebController"
                                      Header="{Binding Common_More, Source={x:Static strings:Strings.Instance}}"
                                      Hint="{Binding Extras_More_WebController, Source={x:Static strings:Strings.Instance}}">
                        <StackPanel>
                            <controls:SettingRow MinHeight="44">
                                <TextBlock Text="{Binding Dashboard_WebControllerPort, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                <ui:NumberBox Style="{StaticResource ExtraPortBox}" Width="120"
                                              Value="{Binding WebControllerPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=1000}"
                                              Minimum="1024" Maximum="65535"/>
                                <reset:SettingResetButton Command="{Binding ResetWebPortCommand}" SettingLabel="{Binding Dashboard_WebControllerPort, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:SettingRow>
                            <!-- The plain HTTP address: a second port on the same
                                 listener, behind the access code. -->
                            <controls:SettingRow MinHeight="44">
                                <TextBlock Text="{Binding Dashboard_WebPlainEnable, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                           ToolTip="{Binding Dashboard_WebPlainDescription, Source={x:Static strings:Strings.Instance}}"/>
                                <CheckBox Style="{StaticResource SwitchCheckBox}" AutomationProperties.AutomationId="EnableWebControllerPlainHttpCheckBox"
                                          Content="{Binding Dashboard_WebPlainEnable, Source={x:Static strings:Strings.Instance}}"
                                          ToolTip="{Binding Dashboard_WebPlainDescription, Source={x:Static strings:Strings.Instance}}"
                                          IsChecked="{Binding EnableWebControllerPlainHttp}"/>
                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="EnableWebControllerPlainHttp" SettingLabel="{Binding Dashboard_WebPlainEnable, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DashboardViewModel_EnableWebControllerPlainHttp_1608"/>
                            </controls:SettingRow>
                            <controls:SettingRow MinHeight="44">
                                <TextBlock Text="{Binding Dashboard_WebPlainPort, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                <ui:NumberBox Style="{StaticResource ExtraPortBox}" Width="120"
                                              Value="{Binding WebControllerPlainHttpPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=1000}"
                                              Minimum="1024" Maximum="65535"/>
                                <reset:SettingResetButton Command="{Binding ResetWebPlainPortCommand}" SettingLabel="{Binding Dashboard_WebPlainPort, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:SettingRow>
                            <controls:SettingRow MinHeight="44">
                                <TextBlock Text="{Binding Dashboard_WebPlainLocalOnly, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                           ToolTip="{Binding Dashboard_WebPlainLocalOnlyHint, Source={x:Static strings:Strings.Instance}}"/>
                                <CheckBox Style="{StaticResource SwitchCheckBox}" AutomationProperties.AutomationId="WebControllerPlainHttpLocalOnlyCheckBox"
                                          Content="{Binding Dashboard_WebPlainLocalOnly, Source={x:Static strings:Strings.Instance}}"
                                          ToolTip="{Binding Dashboard_WebPlainLocalOnlyHint, Source={x:Static strings:Strings.Instance}}"
                                          IsChecked="{Binding WebControllerPlainHttpLocalOnly}"/>
                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="WebControllerPlainHttpLocalOnly" SettingLabel="{Binding Dashboard_WebPlainLocalOnly, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DashboardViewModel_WebControllerPlainHttpLocalOnly_1615"/>
                            </controls:SettingRow>
                            <!-- The code has no default to reset to. New Code is its
                                 one way back, and its face says what it does. -->
                            <controls:SettingRow MinHeight="44">
                                <TextBlock Text="{Binding Dashboard_WebAccessCode, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                           ToolTip="{Binding Dashboard_WebAccessCodeHint, Source={x:Static strings:Strings.Instance}}"/>
                                <ui:TextBox Style="{StaticResource ExtraField}" Width="120" FontFamily="{StaticResource TelemetryFontFamily}"
                                            IsReadOnly="True" AutomationProperties.AutomationId="WebControllerAccessCodeBox"
                                            Text="{Binding WebControllerAccessCode, Mode=OneWay}"
                                            ToolTip="{Binding Dashboard_WebAccessCodeHint, Source={x:Static strings:Strings.Instance}}"/>
                                <ui:Button AutomationProperties.AutomationId="NewWebAccessCodeButton" Margin="12,0,0,0" MinHeight="34" Padding="14,0"
                                           VerticalAlignment="Center" Command="{Binding NewWebAccessCodeCommand}"
                                           Content="{Binding Dashboard_WebNewAccessCode, Source={x:Static strings:Strings.Instance}}"
                                           ToolTip="{Binding Dashboard_WebAccessCodeHint, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:SettingRow>
                            <!-- The plain address, shown while the server runs with it
                                 asked for (its status is set then): the address and
                                 Copy Address while it serves, why while it does not. -->
                            <StackPanel Visibility="{Binding WebControllerPlainStatus, Converter={StaticResource StringToVisibility}}">
                                <controls:SettingRow MinHeight="44">
                                    <TextBlock Text="{Binding Dashboard_WebPlainTitle, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Grid controls:SettingRow.Fills="True" VerticalAlignment="Center">
                                        <controls:FlexLinePanel Gap="10" LineGap="8"
                                                                Visibility="{Binding WebControllerPlainUrl, Converter={StaticResource StringToVisibility}}">
                                            <TextBlock Style="{StaticResource ExtraAddress}" Text="{Binding WebControllerPlainUrl}"/>
                                            <ui:Button AutomationProperties.AutomationId="WebController_CopyPlainAddress" MinHeight="32" Padding="12,0"
                                                       VerticalAlignment="Center" Command="{Binding CopyWebControllerPlainUrlCommand}"
                                                       Content="{Binding Extras_CopyAddress, Source={x:Static strings:Strings.Instance}}"/>
                                        </controls:FlexLinePanel>
                                        <DockPanel>
                                            <DockPanel.Style>
                                                <Style TargetType="DockPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding WebControllerPlainUrl}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DockPanel.Style>
                                            <Path DockPanel.Dock="Left" FlowDirection="LeftToRight" Data="{StaticResource FlameOuterGeometry}" Width="16" Height="16"
                                                  Stretch="Uniform" Fill="{DynamicResource WaitBrush}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                                            <TextBlock common:LiveText.Polite="True" Text="{Binding WebControllerPlainStatus}" Style="{StaticResource ExtraWarnText}"/>
                                        </DockPanel>
                                    </Grid>
                                </controls:SettingRow>
                                <!-- Its QR code on the network. This PC Only names
                                     localhost, which a phone cannot open, so none then.
                                     It stands at the control column (230 and 12). -->
                                <Border Width="144" Height="144" CornerRadius="10" Background="White" Padding="6" Margin="242,0,0,8"
                                        HorizontalAlignment="Left"
                                        Visibility="{Binding HasWebControllerPlainQr, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Image FlowDirection="LeftToRight" Source="{Binding WebControllerPlainQr}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" RenderOptions.EdgeMode="Aliased"
                                           AutomationProperties.Name="{Binding WebControllerPlainUrl, TargetNullValue='', FallbackValue=''}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </controls:MoreRow>
                </controls:FoldList>
            </StackPanel>

            <!-- ═══ Head Tracking (#355) ═══
                 A UDP listener on OpenTrack's port, a FreeTrack 2.0 shared-memory
                 reader and an OpenXR headset reader, surfaced as the Head Tracker
                 device row. The status line is the Devices row's source line,
                 pushed by InputService on the dashboard tick. The three inputs
                 have a switch each and no single one, so the page's switch is on
                 while any of them is (DashboardViewModel.HeadTrackingAnyEnabled).
                 First: the status with Set Neutral, the three inputs and the two
                 ranges. Under More: the UDP port, the OpenXR runtime and the
                 per-axis ranges. -->
            <StackPanel x:Name="HeadTrackingPage" Visibility="Collapsed">
                <StackPanel.Resources>
                    <!-- Head Tracking's rows, as its board draws them: a label column 300 wide. -->
                    <Style x:Key="DzLabel" TargetType="TextBlock" BasedOn="{StaticResource ExtraLabel}">
                        <Setter Property="Width" Value="300"/>
                    </Style>
                </StackPanel.Resources>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ExtrasCrumb}" Click="Back_Click"
                            AutomationProperties.AutomationId="Extras_Back_HeadTracking"
                            Content="{Binding Extras_Title, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock Text="/" Style="{StaticResource ExtrasCrumbText}" Margin="4,0,4,0"/>
                    <TextBlock Text="{Binding Dashboard_HeadTracking, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtrasCrumbText}"/>
                </StackPanel>
                <controls:HeadRowPanel LeadingMinWidth="328" Gap="12" Margin="0,10,0,0">
                    <Grid Margin="0,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:ExtraBadge Glyph="&#xE77B;" IsOn="{Binding HeadTrackingAnyEnabled}"/>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="HeadTrackingTitle" AutomationProperties.HeadingLevel="Level1" Text="{Binding Dashboard_HeadTracking, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraTitle}"/>
                            <TextBlock Text="{Binding Extras_PageLine_HeadTracking, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraLine}"
                                       ToolTip="{Binding Dashboard_HeadTrackingDesc, Source={x:Static strings:Strings.Instance}}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <CheckBox Style="{StaticResource SwitchCheckBox}" controls:SwitchLook.ShowState="True"
                                  AutomationProperties.AutomationId="HeadTrackingSwitch"
                                  Content="{Binding Dashboard_HeadTracking, Source={x:Static strings:Strings.Instance}}"
                                  IsChecked="{Binding HeadTrackingAnyEnabled}"/>
                        <reset:SettingResetButton Command="{Binding ResetHeadTrackingSourcesCommand}" SettingLabel="{Binding Dashboard_HeadTracking, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DashboardViewModel_HeadTrackingAnyEnabled" Margin="14,0,0,0"/>
                    </StackPanel>
                </controls:HeadRowPanel>

                <!-- The Head Tracker row's source line: which input is live, or
                     why none is. The flame burns while a pose arrives. -->
                <Border Style="{StaticResource ExtraStatusCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <controls:StatusFlame IsOn="{Binding HeadTrackingAnyEnabled}" IsLive="{Binding IsHeadTrackingReceiving}"
                                              VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock Grid.Column="1" common:LiveText.Polite="True" Text="{Binding HeadTrackingStatus}"
                                   Style="{StaticResource ExtraStatusText}" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Command="{Binding HeadTrackingRecenterCommand}"
                                Style="{StaticResource ExtraButton}" Margin="14,0,0,0"
                                Content="{Binding Dashboard_HeadTrackingRecenter, Source={x:Static strings:Strings.Instance}}"
                                ToolTip="{Binding Dashboard_HeadTrackingRecenter_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                    </Grid>
                </Border>

                <!-- The three inputs a pose comes from. -->
                <Border Style="{StaticResource ExtraCard}">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,4">
                            <TextBlock Text="{Binding Extras_HeadTracking_Sources, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraCardTitle}"
                                       ToolTip="{Binding Dashboard_HeadTrackingFooter, Source={x:Static strings:Strings.Instance}}"/>
                            <ui:Button Command="{Binding ResetHeadTrackingSourcesCommand}" Style="{StaticResource ResetAllButton}"
                                       Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}"
                                       AutomationProperties.AutomationId="Extras_ResetAll_HeadTrackingSources">
                                <ui:Button.ToolTip>
                                    <MultiBinding Converter="{StaticResource FormatTextConverter}">
                                        <Binding Path="Extras_HeadTracking_Sources" Source="{x:Static strings:Strings.Instance}"/>
                                        <Binding Path="Pad_ResetSection_Format" Source="{x:Static strings:Strings.Instance}"/>
                                    </MultiBinding>
                                </ui:Button.ToolTip>
                            </ui:Button>
                        </DockPanel>
                        <controls:SettingRow MinHeight="44">
                            <TextBlock Text="{Binding Dashboard_HeadTrackingEnable, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                       ToolTip="{Binding Dashboard_HeadTrackingEnable_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                            <CheckBox x:Name="HeadTrackingUdpCheckBox" Style="{StaticResource SwitchCheckBox}"
                                      Content="{Binding Dashboard_HeadTrackingEnable, Source={x:Static strings:Strings.Instance}}"
                                      ToolTip="{Binding Dashboard_HeadTrackingEnable_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                      IsChecked="{Binding HeadTrackingEnabled}"/>
                            <TextBlock Text="{Binding Extras_HeadTracking_UdpHint, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraRowHint}"/>
                            <reset:SettingResetButton x:Name="HeadTrackingEnabledReset" Command="{Binding ResetHeadTrackingEnabledCommand}" SettingLabel="{Binding Dashboard_HeadTrackingEnable, Source={x:Static strings:Strings.Instance}}"/>
                        </controls:SettingRow>
                        <controls:SettingRow MinHeight="44">
                            <TextBlock Text="{Binding Dashboard_HeadTrackingFreeTrack, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                       ToolTip="{Binding Dashboard_HeadTrackingFreeTrack_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                            <CheckBox x:Name="HeadTrackingFreeTrackCheckBox" Style="{StaticResource SwitchCheckBox}"
                                      Content="{Binding Dashboard_HeadTrackingFreeTrack, Source={x:Static strings:Strings.Instance}}"
                                      ToolTip="{Binding Dashboard_HeadTrackingFreeTrack_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                      IsChecked="{Binding HeadTrackingFreeTrack}"/>
                            <reset:SettingResetButton x:Name="HeadTrackingFreeTrackReset" Command="{Binding ResetHeadTrackingFreeTrackCommand}" SettingLabel="{Binding Dashboard_HeadTrackingFreeTrack, Source={x:Static strings:Strings.Instance}}"/>
                        </controls:SettingRow>
                        <controls:SettingRow MinHeight="44">
                            <TextBlock Text="{Binding Dashboard_HeadTrackingOpenXr, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                       ToolTip="{Binding Dashboard_HeadTrackingOpenXr_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                            <CheckBox x:Name="HeadTrackingOpenXrCheckBox" Style="{StaticResource SwitchCheckBox}"
                                      Content="{Binding Dashboard_HeadTrackingOpenXr, Source={x:Static strings:Strings.Instance}}"
                                      ToolTip="{Binding Dashboard_HeadTrackingOpenXr_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                      IsChecked="{Binding HeadTrackingOpenXr}"/>
                            <reset:SettingResetButton x:Name="HeadTrackingOpenXrReset" Command="{Binding ResetHeadTrackingOpenXrCommand}" SettingLabel="{Binding Dashboard_HeadTrackingOpenXr, Source={x:Static strings:Strings.Instance}}"/>
                        </controls:SettingRow>
                    </StackPanel>
                </Border>

                <!-- How far the head turns and moves for full deflection. -->
                <Border Style="{StaticResource ExtraCard}">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,4">
                            <TextBlock Text="{Binding Extras_HeadTracking_Range, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraCardTitle}"/>
                            <ui:Button Command="{Binding ResetHeadTrackingRangesCommand}" Style="{StaticResource ResetAllButton}"
                                       Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}"
                                       AutomationProperties.AutomationId="Extras_ResetAll_HeadTrackingRange">
                                <ui:Button.ToolTip>
                                    <MultiBinding Converter="{StaticResource FormatTextConverter}">
                                        <Binding Path="Extras_HeadTracking_Range" Source="{x:Static strings:Strings.Instance}"/>
                                        <Binding Path="Pad_ResetSection_Format" Source="{x:Static strings:Strings.Instance}"/>
                                    </MultiBinding>
                                </ui:Button.ToolTip>
                            </ui:Button>
                        </DockPanel>
                        <controls:SettingRow MinHeight="44">
                            <TextBlock Text="{Binding Dashboard_HeadTrackingRotationRange, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                       ToolTip="{Binding Dashboard_HeadTrackingRotationRange_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                            <ui:NumberBox Style="{StaticResource ExtraNumberBox}" Width="72"
                                          Value="{Binding HeadTrackingRotationRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Minimum="1" Maximum="180"
                                          ToolTip="{Binding Dashboard_HeadTrackingRotationRange_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                            <reset:SettingResetButton Command="{Binding ResetHeadTrackingRotationRangeCommand}" SettingLabel="{Binding Dashboard_HeadTrackingRotationRange, Source={x:Static strings:Strings.Instance}}"/>
                        </controls:SettingRow>
                        <controls:SettingRow MinHeight="44">
                            <TextBlock Text="{Binding Dashboard_HeadTrackingTranslationRange, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                       ToolTip="{Binding Dashboard_HeadTrackingTranslationRange_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                            <ui:NumberBox Style="{StaticResource ExtraNumberBox}" Width="72"
                                          Value="{Binding HeadTrackingTranslationRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Minimum="1" Maximum="500"
                                          ToolTip="{Binding Dashboard_HeadTrackingTranslationRange_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                            <reset:SettingResetButton Command="{Binding ResetHeadTrackingTranslationRangeCommand}" SettingLabel="{Binding Dashboard_HeadTrackingTranslationRange, Source={x:Static strings:Strings.Instance}}"/>
                        </controls:SettingRow>
                    </StackPanel>
                </Border>

                <controls:FoldList Gap="0" Margin="0,16,0,0">
                    <controls:MoreRow x:Name="HeadTrackingMore" Style="{StaticResource MoreCardRow}" StateKey="Extras.HeadTracking.More"
                                      AutomationProperties.AutomationId="Extras_More_HeadTracking"
                                      Header="{Binding Common_More, Source={x:Static strings:Strings.Instance}}">
                        <!-- The hint names the three settings under More in their own words. -->
                        <controls:MoreRow.Hint>
                            <MultiBinding StringFormat="{}{0}, {1}, {2}">
                                <Binding Path="Dashboard_HeadTrackingPort" Source="{x:Static strings:Strings.Instance}"/>
                                <Binding Path="Dashboard_HeadTrackingOpenXrRuntime" Source="{x:Static strings:Strings.Instance}"/>
                                <Binding Path="Dashboard_HeadTrackingAxisRanges" Source="{x:Static strings:Strings.Instance}"/>
                            </MultiBinding>
                        </controls:MoreRow.Hint>
                        <StackPanel>
                            <!-- Off while the UDP input is off, as the runtime is off
                                 while the headset input is. -->
                            <controls:SettingRow x:Name="HeadTrackingUdpPortControls" MinHeight="44" IsEnabled="{Binding HeadTrackingEnabled}">
                                <TextBlock Text="{Binding Dashboard_HeadTrackingPort, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                           ToolTip="{Binding Dashboard_HeadTrackingPort_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                <ui:NumberBox Style="{StaticResource ExtraNumberBox}" Width="72"
                                              Value="{Binding HeadTrackingUdpPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=1000}"
                                              Minimum="1" Maximum="65535"
                                              ToolTip="{Binding Dashboard_HeadTrackingPort_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                <reset:SettingResetButton Command="{Binding ResetHeadTrackingPortCommand}" SettingLabel="{Binding Dashboard_HeadTrackingPort, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:SettingRow>
                            <controls:SettingRow MinHeight="44" IsEnabled="{Binding HeadTrackingOpenXr}">
                                <TextBlock Text="{Binding Dashboard_HeadTrackingOpenXrRuntime, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                           ToolTip="{Binding Dashboard_HeadTrackingOpenXrRuntime_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                <ComboBox x:Name="HeadTrackingOpenXrRuntimeCombo" MinWidth="200" MinHeight="34" VerticalAlignment="Center"
                                          ToolTip="{Binding Dashboard_HeadTrackingOpenXrRuntime_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                          ItemsSource="{Binding OpenXrRuntimes}"
                                          SelectedItem="{Binding SelectedOpenXrRuntime, Mode=TwoWay}"
                                          DisplayMemberPath="Display"/>
                                <reset:SettingResetButton x:Name="HeadTrackingOpenXrRuntimeReset" Command="{Binding ResetHeadTrackingOpenXrRuntimeCommand}" SettingLabel="{Binding Dashboard_HeadTrackingOpenXrRuntime, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:SettingRow>
                            <!-- The per-axis ranges (#403). Zero in an axis follows the
                                 range above, so a setup is untouched until an axis is
                                 pinned. -->
                            <TextBlock Text="{Binding Extras_HeadTracking_AxisNote, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraSmall}" Margin="0,10,0,2"
                                       ToolTip="{Binding Dashboard_HeadTrackingAxisRangesDesc, Source={x:Static strings:Strings.Instance}}"/>
                            <controls:SettingRow MinHeight="44">
                                <TextBlock Text="{Binding Dashboard_HeadTrackingAxisYaw, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                <ui:NumberBox Style="{StaticResource ExtraNumberBox}" Width="72"
                                              Value="{Binding HeadTrackingRangeYaw, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Minimum="0" Maximum="180"
                                              ToolTip="{Binding Dashboard_HeadTrackingAxisRange_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                <reset:SettingResetButton Command="{Binding ResetHeadTrackingRangeYawCommand}" SettingLabel="{Binding Dashboard_HeadTrackingAxisYaw, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:SettingRow>
                            <controls:SettingRow MinHeight="44">
                                <TextBlock Text="{Binding Dashboard_HeadTrackingAxisPitch, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                <ui:NumberBox Style="{StaticResource ExtraNumberBox}" Width="72"
                                              Value="{Binding HeadTrackingRangePitch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Minimum="0" Maximum="180"
                                              ToolTip="{Binding Dashboard_HeadTrackingAxisRange_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                <reset:SettingResetButton Command="{Binding ResetHeadTrackingRangePitchCommand}" SettingLabel="{Binding Dashboard_HeadTrackingAxisPitch, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:SettingRow>
                            <controls:SettingRow MinHeight="44">
                                <TextBlock Text="{Binding Dashboard_HeadTrackingAxisRoll, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                <ui:NumberBox Style="{StaticResource ExtraNumberBox}" Width="72"
                                              Value="{Binding HeadTrackingRangeRoll, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Minimum="0" Maximum="180"
                                              ToolTip="{Binding Dashboard_HeadTrackingAxisRange_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                <reset:SettingResetButton Command="{Binding ResetHeadTrackingRangeRollCommand}" SettingLabel="{Binding Dashboard_HeadTrackingAxisRoll, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:SettingRow>
                            <controls:SettingRow MinHeight="44">
                                <TextBlock Text="{Binding Dashboard_HeadTrackingAxisX, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                <ui:NumberBox Style="{StaticResource ExtraNumberBox}" Width="72"
                                              Value="{Binding HeadTrackingRangeX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Minimum="0" Maximum="500"
                                              ToolTip="{Binding Dashboard_HeadTrackingAxisRange_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                <reset:SettingResetButton Command="{Binding ResetHeadTrackingRangeXCommand}" SettingLabel="{Binding Dashboard_HeadTrackingAxisX, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:SettingRow>
                            <controls:SettingRow MinHeight="44">
                                <TextBlock Text="{Binding Dashboard_HeadTrackingAxisY, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                <ui:NumberBox Style="{StaticResource ExtraNumberBox}" Width="72"
                                              Value="{Binding HeadTrackingRangeY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Minimum="0" Maximum="500"
                                              ToolTip="{Binding Dashboard_HeadTrackingAxisRange_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                <reset:SettingResetButton Command="{Binding ResetHeadTrackingRangeYCommand}" SettingLabel="{Binding Dashboard_HeadTrackingAxisY, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:SettingRow>
                            <controls:SettingRow MinHeight="44">
                                <TextBlock Text="{Binding Dashboard_HeadTrackingAxisZ, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                <ui:NumberBox Style="{StaticResource ExtraNumberBox}" Width="72"
                                              Value="{Binding HeadTrackingRangeZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Minimum="0" Maximum="500"
                                              ToolTip="{Binding Dashboard_HeadTrackingAxisRange_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                <reset:SettingResetButton Command="{Binding ResetHeadTrackingRangeZCommand}" SettingLabel="{Binding Dashboard_HeadTrackingAxisZ, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:SettingRow>
                        </StackPanel>
                    </controls:MoreRow>
                </controls:FoldList>

                <!-- One line of markup: a line break between runs would add a space. -->
                <TextBlock Style="{StaticResource ExtraNote}"><Run Text="{Binding Extras_Note_HeadTracking, Source={x:Static strings:Strings.Instance}, Converter={StaticResource BracketPartConverter}, ConverterParameter=0, Mode=OneWay}"/><Hyperlink Click="DevicesLink_Click" AutomationProperties.AutomationId="Extras_Link_HeadTracking"><Run Text="{Binding Extras_Note_HeadTracking, Source={x:Static strings:Strings.Instance}, Converter={StaticResource BracketPartConverter}, ConverterParameter=1, Mode=OneWay}"/></Hyperlink><Run Text="{Binding Extras_Note_HeadTracking, Source={x:Static strings:Strings.Instance}, Converter={StaticResource BracketPartConverter}, ConverterParameter=2, Mode=OneWay}"/></TextBlock>
            </StackPanel>

            <!-- ═══ Game Telemetry (#531) ═══
                 The UDP listener for driving games' telemetry and Assetto Corsa's
                 shared memory, surfaced as the Game Telemetry row. EC4A is Segoe
                 MDL2 SpeedHigh, a speedometer (verified in live segmdl2.ttf).
                 First: the row's status line, pushed by InputService on the
                 dashboard tick, and the game picker. Under More: the port, the
                 forward port, Full Speed and the custom format editor. -->
            <StackPanel x:Name="GameTelemetryPage" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ExtrasCrumb}" Click="Back_Click"
                            AutomationProperties.AutomationId="Extras_Back_GameTelemetry"
                            Content="{Binding Extras_Title, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock Text="/" Style="{StaticResource ExtrasCrumbText}" Margin="4,0,4,0"/>
                    <TextBlock Text="{Binding Dashboard_GameTelemetry, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtrasCrumbText}"/>
                </StackPanel>
                <controls:HeadRowPanel LeadingMinWidth="328" Gap="12" Margin="0,10,0,0">
                    <Grid Margin="0,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:ExtraBadge Glyph="&#xEC4A;" IsOn="{Binding EnableGameTelemetry}"/>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="GameTelemetryTitle" AutomationProperties.HeadingLevel="Level1" Text="{Binding Dashboard_GameTelemetry, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraTitle}"/>
                            <TextBlock Text="{Binding Extras_PageLine_GameTelemetry, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraLine}"
                                       ToolTip="{Binding Dashboard_GameTelemetryDescription, Source={x:Static strings:Strings.Instance}}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <CheckBox Style="{StaticResource SwitchCheckBox}" controls:SwitchLook.ShowState="True"
                                  x:Name="GameTelemetryCheckBox"
                                  Content="{Binding Dashboard_EnableGameTelemetry, Source={x:Static strings:Strings.Instance}}"
                                  IsChecked="{Binding EnableGameTelemetry}"/>
                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="EnableGameTelemetry" SettingLabel="{Binding Dashboard_EnableGameTelemetry, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DashboardViewModel_EnableGameTelemetry_2300" Margin="14,0,0,0"/>
                    </StackPanel>
                </controls:HeadRowPanel>

                <!-- The row's status line, and what to do while it waits. The
                     flame burns while a game's data arrives. -->
                <Border Style="{StaticResource ExtraStatusCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:StatusFlame IsOn="{Binding EnableGameTelemetry}" IsLive="{Binding IsGameTelemetryReceiving}"
                                              VerticalAlignment="Top" Margin="0,1,14,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <TextBlock common:LiveText.Polite="True" Text="{Binding GameTelemetryStatus}" Style="{StaticResource ExtraStatusText}"/>
                            <!-- What to do in the game, for a game that sends to a port.
                                 Assetto Corsa is read from shared memory and has no port
                                 to point at, so the line rests while it is picked. -->
                            <TextBlock Text="{Binding Extras_StatusHint_GameTelemetry, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraStatusHint}"
                                       Visibility="{Binding GameTelemetryReadsUdp, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- The game picker. -->
                <Border Style="{StaticResource ExtraCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding Dashboard_GameTelemetryGame, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraCardTitle}" Margin="0,0,0,4"/>
                        <controls:SettingRow MinHeight="44" IsEnabled="{Binding EnableGameTelemetry}">
                            <TextBlock Text="{Binding Dashboard_GameTelemetryGame, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                       ToolTip="{Binding Dashboard_GameTelemetryGame_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                            <ComboBox x:Name="GameTelemetryGameCombo" MinWidth="320" MinHeight="34" VerticalAlignment="Center"
                                      ToolTip="{Binding Dashboard_GameTelemetryGame_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                      ItemsSource="{Binding GameTelemetryOptions}"
                                      SelectedItem="{Binding SelectedGameTelemetryOption, Mode=TwoWay}"
                                      DisplayMemberPath="Display"/>
                            <reset:SettingResetButton Command="{Binding ResetGameTelemetryGameCommand}" SettingLabel="{Binding Dashboard_GameTelemetryGame, Source={x:Static strings:Strings.Instance}}"/>
                        </controls:SettingRow>
                    </StackPanel>
                </Border>

                <controls:FoldList Gap="0" Margin="0,16,0,0">
                    <controls:MoreRow x:Name="GameTelemetryMore" Style="{StaticResource MoreCardRow}" StateKey="Extras.GameTelemetry.More"
                                      AutomationProperties.AutomationId="Extras_More_GameTelemetry"
                                      Header="{Binding Common_More, Source={x:Static strings:Strings.Instance}}"
                                      Hint="{Binding Extras_More_GameTelemetry, Source={x:Static strings:Strings.Instance}}">
                        <StackPanel>
                            <!-- The ports and Full Speed follow the switch. The two
                                 ports rest while Assetto Corsa is picked: it is read
                                 from shared memory, with no socket and no copy on.
                                 The port's tooltip lists each game's port. -->
                            <StackPanel IsEnabled="{Binding EnableGameTelemetry}">
                                <controls:SettingRow MinHeight="44" IsEnabled="{Binding GameTelemetryReadsUdp}">
                                    <TextBlock Text="{Binding Dashboard_GameTelemetryPort, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Dashboard_GameTelemetryFooter, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:NumberBox Style="{StaticResource ExtraNumberBox}" Width="80"
                                                  Value="{Binding GameTelemetryPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=1000}"
                                                  Minimum="1024" Maximum="65535"
                                                  ToolTip="{Binding Dashboard_GameTelemetryFooter, Source={x:Static strings:Strings.Instance}}"/>
                                    <reset:SettingResetButton Command="{Binding ResetGameTelemetryPortCommand}" SettingLabel="{Binding Dashboard_GameTelemetryPort, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>
                                <controls:SettingRow MinHeight="44" IsEnabled="{Binding GameTelemetryReadsUdp}">
                                    <TextBlock Text="{Binding Dashboard_GameTelemetryForwardPort, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Dashboard_GameTelemetryForwardPort_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:NumberBox Style="{StaticResource ExtraNumberBox}" Width="80"
                                                  Value="{Binding GameTelemetryForwardPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=1000}"
                                                  Minimum="0" Maximum="65535"
                                                  ToolTip="{Binding Dashboard_GameTelemetryForwardPort_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <reset:SettingResetButton Command="{Binding ResetGameTelemetryForwardPortCommand}" SettingLabel="{Binding Dashboard_GameTelemetryForwardPort, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>
                                <controls:SettingRow MinHeight="44">
                                    <TextBlock Text="{Binding Dashboard_GameTelemetryFullSpeed, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Dashboard_GameTelemetryFullSpeed_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:NumberBox Style="{StaticResource ExtraNumberBox}" Width="80"
                                                  Value="{Binding GameTelemetryFullSpeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Minimum="10" Maximum="1000"
                                                  ToolTip="{Binding Dashboard_GameTelemetryFullSpeed_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <reset:SettingResetButton Command="{Binding ResetGameTelemetryFullSpeedCommand}" SettingLabel="{Binding Dashboard_GameTelemetryFullSpeed, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>
                            </StackPanel>
                            <!-- The custom formats open a dialog of their own, with the
                                 switch on or off. -->
                            <controls:SettingRow MinHeight="44">
                                <TextBlock Text="{Binding Extras_GameTelemetry_UnknownGames, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                <Button x:Name="GameTelemetryFormatsButton" Click="GameTelemetryFormatsButton_Click" Style="{StaticResource ExtraButton}"
                                        Content="{Binding Dashboard_GameTelemetryFormats, Source={x:Static strings:Strings.Instance}}"
                                        ToolTip="{Binding Dashboard_GameTelemetryFormats_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:SettingRow>
                        </StackPanel>
                    </controls:MoreRow>
                </controls:FoldList>

                <!-- One line of markup: a line break between runs would add a space. -->
                <TextBlock Style="{StaticResource ExtraNote}"><Run Text="{Binding Extras_Note_GameTelemetry, Source={x:Static strings:Strings.Instance}, Converter={StaticResource BracketPartConverter}, ConverterParameter=0, Mode=OneWay}"/><Hyperlink Click="DevicesLink_Click" AutomationProperties.AutomationId="Extras_Link_GameTelemetry"><Run Text="{Binding Extras_Note_GameTelemetry, Source={x:Static strings:Strings.Instance}, Converter={StaticResource BracketPartConverter}, ConverterParameter=1, Mode=OneWay}"/></Hyperlink><Run Text="{Binding Extras_Note_GameTelemetry, Source={x:Static strings:Strings.Instance}, Converter={StaticResource BracketPartConverter}, ConverterParameter=2, Mode=OneWay}"/></TextBlock>
            </StackPanel>

            <!-- ═══ Twitch Chat (#555) ═══
                 Viewers press the slots the Twitch Chat row is assigned to by
                 typing commands in the stream's chat. E8F2 is Segoe MDL2
                 ChatBubbles (verified in live segmdl2.ttf). Four parts: the
                 row's status line, which InputService pushes on the
                 dashboard tick. The channel, who approves a claim and the
                 chat's words. The streamer's controls, which act on the open
                 row. The address of the controller picture for the
                 broadcast. -->
            <StackPanel x:Name="TwitchChatPage" Visibility="Collapsed">
                <StackPanel.Resources>
                    <!-- Twitch Chat's rows, as its board draws them: a label column 200 wide. -->
                    <Style x:Key="DzLabel" TargetType="TextBlock" BasedOn="{StaticResource ExtraLabel}">
                        <Setter Property="Width" Value="200"/>
                    </Style>
                </StackPanel.Resources>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ExtrasCrumb}" Click="Back_Click"
                            AutomationProperties.AutomationId="Extras_Back_TwitchChat"
                            Content="{Binding Extras_Title, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock Text="/" Style="{StaticResource ExtrasCrumbText}" Margin="4,0,4,0"/>
                    <TextBlock Text="{Binding Dashboard_TwitchChat, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtrasCrumbText}"/>
                </StackPanel>
                <controls:HeadRowPanel LeadingMinWidth="328" Gap="12" Margin="0,10,0,0">
                    <Grid Margin="0,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:ExtraBadge Glyph="&#xE8F2;" IsOn="{Binding EnableTwitchChat}"/>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TwitchChatTitle" AutomationProperties.HeadingLevel="Level1" Text="{Binding Dashboard_TwitchChat, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraTitle}"/>
                            <TextBlock Text="{Binding Dashboard_TwitchChatDescription, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraLine}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <CheckBox Style="{StaticResource SwitchCheckBox}" controls:SwitchLook.ShowState="True"
                                  x:Name="TwitchChatCheckBox"
                                  Content="{Binding Dashboard_EnableTwitchChat, Source={x:Static strings:Strings.Instance}}"
                                  IsChecked="{Binding EnableTwitchChat}"/>
                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="EnableTwitchChat" SettingLabel="{Binding Dashboard_EnableTwitchChat, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DashboardViewModel_EnableTwitchChat_2245" Margin="14,0,0,0"/>
                    </StackPanel>
                </controls:HeadRowPanel>

                <!-- The row's status line. The flame burns while the chat is
                     read, and waits while it is paused or has no channel. -->
                <Border x:Name="TwitchChatStatusCard" Style="{StaticResource ExtraStatusCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:StatusFlame IsOn="{Binding EnableTwitchChat}" VerticalAlignment="Center" Margin="0,0,14,0">
                            <controls:StatusFlame.Style>
                                <Style TargetType="{x:Type controls:StatusFlame}" BasedOn="{StaticResource {x:Type controls:StatusFlame}}">
                                    <Setter Property="IsLive" Value="{Binding IsTwitchChatRunning}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TwitchChatPaused}" Value="True">
                                            <Setter Property="IsLive" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:StatusFlame.Style>
                        </controls:StatusFlame>
                        <TextBlock Grid.Column="1" common:LiveText.Polite="True" Text="{Binding TwitchChatStatus}"
                                   Style="{StaticResource ExtraStatusText}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border x:Name="TwitchChatChannelCard" Style="{StaticResource ExtraCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding Dashboard_TwitchChatChannel, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraCardTitle}" Margin="0,0,0,4"/>
                        <!-- The channel and the approval follow the switch. -->
                        <StackPanel IsEnabled="{Binding EnableTwitchChat}">
                            <!-- A second after the last key, so the row reopens
                                 once per edit rather than once per letter. -->
                            <controls:SettingRow MinHeight="44">
                                <TextBlock Text="{Binding Dashboard_TwitchChatChannel, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                           ToolTip="{Binding Dashboard_TwitchChatChannel_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                <ui:TextBox Style="{StaticResource ExtraField}" Width="220"
                                            Text="{Binding TwitchChatChannel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=1000}"
                                            PlaceholderText="{Binding Extras_TwitchChat_ChannelPlaceholder, Source={x:Static strings:Strings.Instance}}"
                                            AutomationProperties.Name="{Binding Dashboard_TwitchChatChannel, Source={x:Static strings:Strings.Instance}}"
                                            ToolTip="{Binding Dashboard_TwitchChatChannel_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:SettingRow>
                            <controls:SettingRow MinHeight="44">
                                <TextBlock Text="{Binding Dashboard_TwitchChatClaimApproval, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                           ToolTip="{Binding Dashboard_TwitchChatClaimApproval_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                <ComboBox SelectedIndex="{Binding TwitchChatClaimApprovalIndex}" MinWidth="300" MinHeight="34" VerticalAlignment="Center"
                                          AutomationProperties.Name="{Binding Dashboard_TwitchChatClaimApproval, Source={x:Static strings:Strings.Instance}}"
                                          ToolTip="{Binding Dashboard_TwitchChatClaimApproval_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                    <ComboBoxItem Content="{Binding TwitchChat_Approval_Streamer, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBoxItem Content="{Binding TwitchChat_Approval_Moderators, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBoxItem Content="{Binding TwitchChat_Approval_Viewers, Source={x:Static strings:Strings.Instance}}"/>
                                </ComboBox>
                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="TwitchChatClaimApprovalIndex" SettingLabel="{Binding Dashboard_TwitchChatClaimApproval, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DashboardViewModel_TwitchChatClaimApprovalIndex_2289"/>
                            </controls:SettingRow>
                        </StackPanel>
                        <!-- The words viewers type, the dialog the Twitch Chat row on
                             the Devices page opens too. -->
                        <controls:SettingRow MinHeight="44">
                            <TextBlock Text="{Binding Extras_TwitchChat_Words, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                       ToolTip="{Binding Extras_TwitchChat_Words_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                            <Button AutomationProperties.AutomationId="TwitchChat_ManageCommands" Style="{StaticResource ExtraButton}"
                                    Click="ManageChatCommands_Click"
                                    Content="{Binding TwitchChat_ManageButton, Source={x:Static strings:Strings.Instance}}"
                                    ToolTip="{Binding Extras_TwitchChat_Words_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                        </controls:SettingRow>
                    </StackPanel>
                </Border>

                <!-- The streamer's controls, live while the row is open. -->
                <Border x:Name="TwitchChatLiveCard" Style="{StaticResource ExtraCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding Extras_TwitchChat_LiveTitle, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraCardTitle}" Margin="0,0,0,4"/>
                        <controls:FlexLinePanel Gap="12" LineGap="8" MinLineHeight="44" IsEnabled="{Binding IsTwitchChatOpen}">
                            <Button Command="{Binding TwitchChatPauseCommand}" MinWidth="90"
                                    ToolTip="{Binding TwitchChat_Pause_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ExtraButton}">
                                        <Setter Property="Content" Value="{Binding TwitchChat_Pause, Source={x:Static strings:Strings.Instance}}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TwitchChatPaused}" Value="True">
                                                <Setter Property="Content" Value="{Binding TwitchChat_Resume, Source={x:Static strings:Strings.Instance}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Command="{Binding TwitchChatSkipCommand}" Style="{StaticResource ExtraButton}"
                                    Content="{Binding TwitchChat_Skip, Source={x:Static strings:Strings.Instance}}"
                                    ToolTip="{Binding TwitchChat_Skip_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                            <Button Command="{Binding TwitchChatClearCommand}" Style="{StaticResource ExtraButton}"
                                    Content="{Binding TwitchChat_ClearLine, Source={x:Static strings:Strings.Instance}}"
                                    ToolTip="{Binding TwitchChat_ClearLine_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                            <Button Command="{Binding TwitchChatEndClaimCommand}" Style="{StaticResource ExtraButton}"
                                    Content="{Binding TwitchChat_EndClaim, Source={x:Static strings:Strings.Instance}}"
                                    ToolTip="{Binding TwitchChat_EndClaim_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                        </controls:FlexLinePanel>
                        <TextBlock Text="{Binding Dashboard_TwitchChatFooter, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraSmall}" Margin="0,2,0,4"/>
                    </StackPanel>
                </Border>

                <!-- The controller picture for the broadcast, on the plain
                     address: OBS will not load the main address, whose
                     certificate is self-signed. -->
                <Border x:Name="TwitchChatDisplayCard" Style="{StaticResource ExtraCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding Extras_TwitchChat_DisplayTitle, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraCardTitle}" Margin="0,0,0,4"/>
                        <StackPanel Visibility="{Binding TwitchChatDisplayUrl, Converter={StaticResource StringToVisibility}}">
                            <TextBlock Text="{Binding Dashboard_TwitchChatDisplay, Source={x:Static strings:Strings.Instance}}" TextWrapping="Wrap" Margin="0,6,0,8"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <controls:FlexLinePanel Gap="12" LineGap="8" MinLineHeight="44">
                                <TextBlock Style="{StaticResource ExtraAddress}" Text="{Binding TwitchChatDisplayUrl}"
                                           AutomationProperties.Name="{Binding Dashboard_TwitchChatDisplay, Source={x:Static strings:Strings.Instance}}"/>
                                <ui:Button AutomationProperties.AutomationId="TwitchChat_CopyAddress" MinHeight="32" Padding="12,0"
                                           VerticalAlignment="Center" Command="{Binding CopyTwitchChatDisplayUrlCommand}"
                                           Content="{Binding Extras_CopyAddress, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:FlexLinePanel>
                        </StackPanel>
                        <!-- Shown while the plain address is off, which the
                             picture needs. -->
                        <TextBlock Text="{Binding Dashboard_TwitchChatDisplayOff, Source={x:Static strings:Strings.Instance}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ExtraSmall}">
                                    <Setter Property="Margin" Value="0,6,0,4"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TwitchChatDisplayUrl}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ═══ Remote Link (issue #138) ═══
                 First: whether it is serving, the paired PCs, and the PCs to
                 pair with and this PC's code. Under More: Auto-Reconnect, the
                 port, the pairing identity and connecting by address. -->
            <StackPanel x:Name="RemoteLinkPage" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ExtrasCrumb}" Click="Back_Click"
                            AutomationProperties.AutomationId="Extras_Back_RemoteLink"
                            Content="{Binding Extras_Title, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock Text="/" Style="{StaticResource ExtrasCrumbText}" Margin="4,0,4,0"/>
                    <TextBlock Text="{Binding Dashboard_RemoteLink, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtrasCrumbText}"/>
                </StackPanel>
                <controls:HeadRowPanel LeadingMinWidth="328" Gap="12" Margin="0,10,0,0">
                    <Grid Margin="0,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:ExtraBadge Glyph="&#xE969;" IsOn="{Binding EnableRemoteLink}"/>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="RemoteLinkTitle" AutomationProperties.HeadingLevel="Level1" Text="{Binding Dashboard_RemoteLink, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraTitle}"/>
                            <TextBlock Text="{Binding Dashboard_RemoteLinkDescription, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraLine}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <CheckBox Style="{StaticResource SwitchCheckBox}" controls:SwitchLook.ShowState="True"
                                  AutomationProperties.AutomationId="EnableRemoteLinkCheckBox"
                                  Content="{Binding Dashboard_EnableRemoteLink, Source={x:Static strings:Strings.Instance}}"
                                  IsChecked="{Binding EnableRemoteLink}"/>
                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="EnableRemoteLink" SettingLabel="{Binding Dashboard_EnableRemoteLink, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DashboardViewModel_EnableRemoteLink_1578" Margin="14,0,0,0"/>
                    </StackPanel>
                </controls:HeadRowPanel>

                <!-- Serving or not, and why not: a start that failed, an
                     identity that would not unlock, a peer out of reach. The
                     flame burns while the server runs, which the switch alone
                     does not promise (#175 phase 2 item 2). -->
                <Border x:Name="RemoteLinkStatusCard" Style="{StaticResource ExtraStatusCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:StatusFlame IsOn="{Binding EnableRemoteLink}" IsLive="{Binding IsRemoteLinkRunning}"
                                              VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock Grid.Column="1" common:LiveText.Polite="True" Text="{Binding RemoteLinkStatus}"
                                   Style="{StaticResource ExtraStatusText}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- The paired PCs: each one's line (flame, name over its state,
                     its actions) and whether it may change assignments. -->
                <Border x:Name="RemoteLinkPairedCard" Style="{StaticResource ExtraCard}">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,4">
                            <TextBlock Text="{Binding RemoteLink_PairedPeers, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraCardTitle}"
                                       ToolTip="{Binding RemoteLink_PairedPeersDescription, Source={x:Static strings:Strings.Instance}}"/>
                            <!-- The card head's quiet action, gone while nothing is paired. -->
                            <ui:Button Command="{Binding RemoteLink.RevokeAllPeersCommand}"
                                       Content="{Binding RemoteLink_RevokeAll, Source={x:Static strings:Strings.Instance}}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource ResetAllButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RemoteLink.TrustedPeers.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </DockPanel>
                        <TextBlock Text="{Binding Extras_RemoteLink_NoPaired, Source={x:Static strings:Strings.Instance}}" Margin="0,6,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ExtraStatusText}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RemoteLink.TrustedPeers.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding RemoteLink.TrustedPeers}">
                            <!-- Out of the screen-reader tree while empty: an empty
                                 list draws nothing and has no size, so collapsing it
                                 changes nothing on screen. -->
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl" BasedOn="{StaticResource {x:Type ItemsControl}}">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Style.Triggers>
                                        <Trigger Property="HasItems" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- A hairline over every PC but the first. -->
                                    <Border BorderBrush="{DynamicResource SteelLineSoftBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderThickness" Value="0,1,0,0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <controls:FlexLinePanel Margin="0,10,0,6" Gap="12" LineGap="8">
                                                <!-- Lit while the PC is connected. -->
                                                <controls:StatusFlame IsOn="{Binding IsOnline}" IsLive="{Binding IsOnline}" Width="16" Height="16" VerticalAlignment="Center"/>
                                                <StackPanel controls:FlexLinePanel.Basis="200" controls:FlexLinePanel.Grow="1" VerticalAlignment="Center">
                                                    <!-- Its machine and its key's fingerprint. -->
                                                    <StackPanel.ToolTip>
                                                        <TextBlock><Run Text="{Binding HostName, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding FingerprintDisplay, Mode=OneWay, StringFormat='  ·  {0}'}" FontFamily="{StaticResource TelemetryFontFamily}"/></TextBlock>
                                                    </StackPanel.ToolTip>
                                                    <!-- The name reads as text and is typed over in
                                                         place. An emptied name goes back to the PC's
                                                         own. Its reset lends the line none of its
                                                         height, so the line stays the board's. -->
                                                    <DockPanel KeyboardNavigation.TabNavigation="Local" LastChildFill="True" HorizontalAlignment="Left">
                                                        <reset:SettingResetButton TabIndex="1" DockPanel.Dock="Right" Margin="4,-6,0,-6" Command="{Binding ResetSettingCommand}" CommandParameter="Name" SettingLabel="{Binding Macro_Name, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_RemoteLinkTrustedPeer_Name_1678"/>
                                                        <TextBox x:Name="PeerNameBox" TabIndex="0" Style="{StaticResource PeerNameEdit}" MaxLength="40"
                                                                 Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                 AutomationProperties.Name="{Binding Macro_Name, Source={x:Static strings:Strings.Instance}}"
                                                                 KeyDown="PeerName_KeyDown"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding StateText}" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                </StackPanel>
                                                <!-- No Appearance=Primary (dark text on the accent
                                                     slab): Connect is the line's affirmative and
                                                     wears the shared ember accent instead. -->
                                                <ui:Button Style="{StaticResource EmberPrimaryButton}" Padding="14,0" VerticalAlignment="Center"
                                                           Command="{Binding ConnectCommand}"
                                                           Content="{Binding Dashboard_RemoteLinkConnectButton, Source={x:Static strings:Strings.Instance}}"
                                                           Visibility="{Binding CanConnect, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <Button Style="{StaticResource ExtraButton}" Command="{Binding AssignmentsCommand}"
                                                        Content="{Binding RemoteLink_AssignDevices, Source={x:Static strings:Strings.Instance}}"
                                                        Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <ui:Button Style="{StaticResource QuietButton}" Padding="14,0" VerticalAlignment="Center"
                                                           Tag="{Binding ElementName=PeerNameBox}" Click="PeerRename_Click"
                                                           Content="{Binding Common_Rename, Source={x:Static strings:Strings.Instance}}"/>
                                                <ui:Button Style="{StaticResource QuietButton}" Padding="14,0" VerticalAlignment="Center"
                                                           Command="{Binding RevokeCommand}"
                                                           Content="{Binding RemoteLink_Revoke, Source={x:Static strings:Strings.Instance}}"/>
                                            </controls:FlexLinePanel>
                                            <controls:SettingRow MinHeight="44">
                                                <TextBlock Text="{Binding RemoteLink_AllowAssignments, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                                           ToolTip="{Binding RemoteLink_AssignmentPermissionDescription, Source={x:Static strings:Strings.Instance}}"/>
                                                <CheckBox Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding AllowRemoteAssignments, Mode=TwoWay}"
                                                          Content="{Binding RemoteLink_AllowAssignments, Source={x:Static strings:Strings.Instance}}"
                                                          ToolTip="{Binding RemoteLink_AssignmentPermissionDescription, Source={x:Static strings:Strings.Instance}}"/>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="AllowRemoteAssignments" SettingLabel="{Binding RemoteLink_AllowAssignments, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_RemoteLinkTrustedPeer_AllowRemoteAssignments_1685"/>
                                            </controls:SettingRow>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- The PCs on this network to pair with, and this PC's code
                     (#294) for someone on another network, shown once it is
                     minted, with the network's verdict under it. -->
                <Border x:Name="RemoteLinkPairCard" Style="{StaticResource ExtraCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding Extras_RemoteLink_PairAnother, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraCardTitle}" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding RemoteLink.NearbyUnpaired}"
                                      Visibility="{Binding RemoteLink.HasNearbyUnpaired, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:FlexLinePanel Gap="12" LineGap="8" MinLineHeight="44">
                                        <StackPanel controls:FlexLinePanel.Basis="200" controls:FlexLinePanel.Grow="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding HostPort}" FontSize="13" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                        <ui:Button MinHeight="36" Padding="14,0" VerticalAlignment="Center"
                                                   Content="{Binding ButtonLabel}" IsEnabled="{Binding CanPair}"
                                                   Command="{Binding PairCommand}"/>
                                    </controls:FlexLinePanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Extras_RemoteLink_NoNearby, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraStatusText}" Margin="0,6,0,4"
                                   Visibility="{Binding RemoteLink.HasNearbyUnpaired, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                        <TextBlock Text="{Binding Extras_RemoteLink_PairHowTo, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraSmall}" Margin="0,0,0,8"/>
                        <controls:SettingRow MinHeight="44" Visibility="{Binding HasRemoteLinkMyCode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding Dashboard_RemoteLinkMyCode, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                       ToolTip="{Binding Dashboard_RemoteLinkMyCode_Hint, Source={x:Static strings:Strings.Instance}}"/>
                            <controls:FlexLinePanel controls:SettingRow.Fills="True" Gap="12" LineGap="8" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource ExtraAddress}" FontSize="14" Text="{Binding RemoteLinkMyCode, Mode=OneWay}"/>
                                <ui:Button MinHeight="32" Padding="12,0" VerticalAlignment="Center" Command="{Binding CopyRemoteLinkCodeCommand}"
                                           Content="{Binding Common_Copy, Source={x:Static strings:Strings.Instance}}"
                                           ToolTip="{Binding Dashboard_RemoteLinkMyCode_Hint, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:FlexLinePanel>
                        </controls:SettingRow>
                        <!-- The network's verdict (#294): a mobile hotspot or a CGNAT
                             cannot be punched, so it says so plainly instead of a
                             late generic failure. -->
                        <DockPanel Margin="0,4,0,4" Visibility="{Binding RemoteLinkNatWarning, Converter={StaticResource StringToVisibility}}">
                            <Path DockPanel.Dock="Left" FlowDirection="LeftToRight" Data="{StaticResource FlameOuterGeometry}" Width="16" Height="16"
                                  Stretch="Uniform" Fill="{DynamicResource WaitBrush}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                            <TextBlock Text="{Binding RemoteLinkNatWarning}" Style="{StaticResource ExtraWarnText}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <controls:FoldList Gap="0" Margin="0,16,0,0">
                    <controls:MoreRow x:Name="RemoteLinkMore" Style="{StaticResource MoreCardRow}" StateKey="Extras.RemoteLink.More"
                                      AutomationProperties.AutomationId="Extras_More_RemoteLink"
                                      Header="{Binding Common_More, Source={x:Static strings:Strings.Instance}}"
                                      Hint="{Binding Extras_More_RemoteLink, Source={x:Static strings:Strings.Instance}}">
                        <StackPanel>
                            <controls:SettingRow MinHeight="44">
                                <TextBlock Text="{Binding RemoteLink_AutoReconnect, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                <CheckBox Style="{StaticResource SwitchCheckBox}"
                                          Content="{Binding RemoteLink_AutoReconnect, Source={x:Static strings:Strings.Instance}}"
                                          IsChecked="{Binding AutoReconnect}"/>
                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="AutoReconnect" SettingLabel="{Binding RemoteLink_AutoReconnect, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DashboardViewModel_AutoReconnect_1581"/>
                            </controls:SettingRow>
                            <controls:SettingRow MinHeight="44">
                                <TextBlock Text="{Binding Dashboard_RemoteLinkPort, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                <ui:NumberBox Style="{StaticResource ExtraNumberBox}" Width="80"
                                              Value="{Binding RemoteLinkPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=1000}"
                                              Minimum="1024" Maximum="65535"/>
                                <reset:SettingResetButton Command="{Binding ResetRemoteLinkPortCommand}" SettingLabel="{Binding Dashboard_RemoteLinkPort, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:SettingRow>
                            <!-- How this PC's pairing identity is kept. -->
                            <controls:SettingRow MinHeight="44">
                                <TextBlock Text="{Binding RemoteLink_IdentityTitle, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                           ToolTip="{Binding RemoteLink_IdentityDescription, Source={x:Static strings:Strings.Instance}}"/>
                                <ComboBox MinWidth="260" MinHeight="34" VerticalAlignment="Center"
                                          ItemsSource="{Binding RemoteLink.IdentityProtectionModes}" DisplayMemberPath="Display"
                                          SelectedIndex="{Binding RemoteLink.IdentityProtectionModeIndex, Mode=TwoWay}"
                                          AutomationProperties.Name="{Binding RemoteLink_IdentityTitle, Source={x:Static strings:Strings.Instance}}"
                                          ToolTip="{Binding RemoteLink_IdentityDescription, Source={x:Static strings:Strings.Instance}}"/>
                                <reset:SettingResetButton Command="{Binding RemoteLink.ResetSettingCommand}" CommandParameter="IdentityProtectionModeIndex" SettingLabel="{Binding RemoteLink_IdentityTitle, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_SettingsViewModel_IdentityProtectionModeIndex_1638"/>
                            </controls:SettingRow>
                            <!-- What the chosen way means, at the control column (260
                                 and 12), clear of the reset column. -->
                            <TextBlock Text="{Binding RemoteLink.IdentityProtectionHint}" Style="{StaticResource ExtraSmall}" Margin="272,0,44,8"/>
                            <!-- Connect by address or by code, when discovery cannot
                                 see the PC. -->
                            <controls:SettingRow MinHeight="44">
                                <TextBlock Text="{Binding Dashboard_RemoteLinkConnect, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                <controls:FlexLinePanel controls:SettingRow.Fills="True" Gap="12" LineGap="8" VerticalAlignment="Center">
                                    <ui:TextBox Style="{StaticResource ExtraField}" Width="200" FontFamily="{StaticResource TelemetryFontFamily}"
                                                PlaceholderText="192.168.1.20:27500"
                                                Text="{Binding RemoteLinkConnectHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="{Binding Dashboard_RemoteLinkConnect, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button MinHeight="36" Padding="14,0" VerticalAlignment="Center" Command="{Binding ConnectToPeerCommand}"
                                               Content="{Binding Dashboard_RemoteLinkConnectButton, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:FlexLinePanel>
                            </controls:SettingRow>
                        </StackPanel>
                    </controls:MoreRow>
                </controls:FoldList>

                <TextBlock Text="{Binding Dashboard_RemoteLinkFooter, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraNote}"/>
            </StackPanel>

            <!-- ═══ Motion Server ═══
                 First: whether it is serving, and how an emulator reaches it.
                 Under More: the port. -->
            <StackPanel x:Name="MotionServerPage" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ExtrasCrumb}" Click="Back_Click"
                            AutomationProperties.AutomationId="Extras_Back_MotionServer"
                            Content="{Binding Extras_Title, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock Text="/" Style="{StaticResource ExtrasCrumbText}" Margin="4,0,4,0"/>
                    <TextBlock Text="{Binding Dashboard_MotionServer, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtrasCrumbText}"/>
                </StackPanel>
                <controls:HeadRowPanel LeadingMinWidth="328" Gap="12" Margin="0,10,0,0">
                    <Grid Margin="0,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:ExtraBadge Glyph="&#xE7AD;" IsOn="{Binding EnableDsuMotionServer}"/>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="MotionServerTitle" AutomationProperties.HeadingLevel="Level1" Text="{Binding Dashboard_MotionServer, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraTitle}"/>
                            <TextBlock Text="{Binding Extras_PageLine_MotionServer, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraLine}"
                                       ToolTip="{Binding Dashboard_DsuDescription, Source={x:Static strings:Strings.Instance}}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <CheckBox Style="{StaticResource SwitchCheckBox}" controls:SwitchLook.ShowState="True"
                                  Content="{Binding Dashboard_EnableDsu, Source={x:Static strings:Strings.Instance}}"
                                  IsChecked="{Binding EnableDsuMotionServer}"/>
                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="EnableDsuMotionServer" SettingLabel="{Binding Dashboard_EnableDsu, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DashboardViewModel_EnableDsuMotionServer_1896" Margin="14,0,0,0"/>
                    </StackPanel>
                </controls:HeadRowPanel>

                <!-- Serving = flame (#175 item 76), the server's running truth,
                     not the switch. -->
                <Border Style="{StaticResource ExtraStatusCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:StatusFlame IsOn="{Binding EnableDsuMotionServer}" IsLive="{Binding IsDsuServerRunning}"
                                              VerticalAlignment="Top" Margin="0,1,14,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <TextBlock common:LiveText.Polite="True" Text="{Binding DsuServerStatus}" Style="{StaticResource ExtraStatusText}"/>
                            <TextBlock Text="{Binding Extras_StatusHint_MotionServer, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraStatusHint}"
                                       ToolTip="{Binding Dashboard_DsuFooter, Source={x:Static strings:Strings.Instance}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <controls:FoldList Gap="0" Margin="0,16,0,0">
                    <controls:MoreRow x:Name="MotionServerMore" Style="{StaticResource MoreCardRow}" StateKey="Extras.MotionServer.More"
                                      AutomationProperties.AutomationId="Extras_More_MotionServer"
                                      Header="{Binding Common_More, Source={x:Static strings:Strings.Instance}}"
                                      Hint="{Binding Dashboard_Port, Source={x:Static strings:Strings.Instance}}">
                        <StackPanel>
                            <controls:SettingRow MinHeight="44">
                                <TextBlock Text="{Binding Dashboard_MotionServerPort, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                <ui:NumberBox Style="{StaticResource ExtraPortBox}"
                                              Value="{Binding DsuMotionServerPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=1000}"
                                              Minimum="1024" Maximum="65535"/>
                                <reset:SettingResetButton Command="{Binding ResetDsuPortCommand}" SettingLabel="{Binding Dashboard_MotionServerPort, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:SettingRow>
                        </StackPanel>
                    </controls:MoreRow>
                </controls:FoldList>
            </StackPanel>

            <!-- ═══ Game Mods (#529) ═══
                 The UDP server DSX game mods send to. EA86 is Segoe MDL2 Puzzle, a
                 piece added to a game. First: whether it is listening, in a status
                 line that wraps, since it names the program sending. Under More:
                 the port and the DSX.exe stand-in switch. -->
            <StackPanel x:Name="GameModsPage" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ExtrasCrumb}" Click="Back_Click"
                            AutomationProperties.AutomationId="Extras_Back_GameMods"
                            Content="{Binding Extras_Title, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock Text="/" Style="{StaticResource ExtrasCrumbText}" Margin="4,0,4,0"/>
                    <TextBlock Text="{Binding Dashboard_GameMods, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtrasCrumbText}"/>
                </StackPanel>
                <controls:HeadRowPanel LeadingMinWidth="328" Gap="12" Margin="0,10,0,0">
                    <Grid Margin="0,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:ExtraBadge Glyph="&#xEA86;" IsOn="{Binding EnableGameModServer}"/>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="GameModsTitle" AutomationProperties.HeadingLevel="Level1" Text="{Binding Dashboard_GameMods, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraTitle}"/>
                            <TextBlock Text="{Binding Extras_PageLine_GameMods, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraLine}"
                                       ToolTip="{Binding Dashboard_GameModsDescription, Source={x:Static strings:Strings.Instance}}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <CheckBox Style="{StaticResource SwitchCheckBox}" controls:SwitchLook.ShowState="True"
                                  Content="{Binding Dashboard_EnableGameMods, Source={x:Static strings:Strings.Instance}}"
                                  IsChecked="{Binding EnableGameModServer}"/>
                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="EnableGameModServer" SettingLabel="{Binding Dashboard_EnableGameMods, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DashboardViewModel_EnableGameModServer_2230" Margin="14,0,0,0"/>
                    </StackPanel>
                </controls:HeadRowPanel>

                <!-- Listening = flame, as on the Motion Server page: the server's
                     running truth, not the switch. -->
                <Border Style="{StaticResource ExtraStatusCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:StatusFlame IsOn="{Binding EnableGameModServer}" IsLive="{Binding IsGameModServerRunning}"
                                              VerticalAlignment="Top" Margin="0,1,14,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <TextBlock common:LiveText.Polite="True" Text="{Binding GameModServerStatus}" Style="{StaticResource ExtraStatusText}"/>
                            <TextBlock Text="{Binding Extras_StatusHint_GameMods, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraStatusHint}"
                                       ToolTip="{Binding Dashboard_GameModsFooter, Source={x:Static strings:Strings.Instance}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <controls:FoldList Gap="0" Margin="0,16,0,0">
                    <controls:MoreRow x:Name="GameModsMore" Style="{StaticResource MoreCardRow}" StateKey="Extras.GameMods.More"
                                      AutomationProperties.AutomationId="Extras_More_GameMods"
                                      Header="{Binding Common_More, Source={x:Static strings:Strings.Instance}}"
                                      Hint="{Binding Extras_More_GameMods, Source={x:Static strings:Strings.Instance}}">
                        <StackPanel>
                            <controls:SettingRow MinHeight="44">
                                <TextBlock Text="{Binding Dashboard_GameModPort, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                <ui:NumberBox Style="{StaticResource ExtraPortBox}"
                                              Value="{Binding GameModServerPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=1000}"
                                              Minimum="1024" Maximum="65535"/>
                                <reset:SettingResetButton Command="{Binding ResetGameModPortCommand}" SettingLabel="{Binding Dashboard_GameModPort, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:SettingRow>
                            <controls:SettingRow MinHeight="44">
                                <TextBlock Text="{Binding Dashboard_GameModStandIn, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                           ToolTip="{Binding Dashboard_GameModStandIn_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                <CheckBox Style="{StaticResource SwitchCheckBox}"
                                          Content="{Binding Dashboard_GameModStandIn, Source={x:Static strings:Strings.Instance}}"
                                          ToolTip="{Binding Dashboard_GameModStandIn_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                          IsChecked="{Binding GameModDsxStandIn}"/>
                                <TextBlock Text="{Binding Extras_GameMods_StandInHint, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraRowHint}"/>
                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="GameModDsxStandIn" SettingLabel="{Binding Dashboard_GameModStandIn, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DashboardViewModel_GameModDsxStandIn_2246"/>
                            </controls:SettingRow>
                        </StackPanel>
                    </controls:MoreRow>
                </controls:FoldList>
            </StackPanel>

            <!-- ═══ Overlays (menu #9 B-17, shift layer, profile switch) ═══
                 E700 is Segoe MDL2 GlobalNavButton, the canonical menu glyph. The
                 three overlays have a switch each and no single one, so the
                 page's switch is on while any of them is
                 (DashboardViewModel.OverlaysAnyEnabled). Each overlay's row
                 shows a drawing of it, its name and what it shows. -->
            <StackPanel x:Name="OverlaysPage" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ExtrasCrumb}" Click="Back_Click"
                            AutomationProperties.AutomationId="Extras_Back_Overlays"
                            Content="{Binding Extras_Title, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock Text="/" Style="{StaticResource ExtrasCrumbText}" Margin="4,0,4,0"/>
                    <TextBlock Text="{Binding Dashboard_Overlays, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtrasCrumbText}"/>
                </StackPanel>
                <controls:HeadRowPanel LeadingMinWidth="328" Gap="12" Margin="0,10,0,0">
                    <Grid Margin="0,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:ExtraBadge Glyph="&#xE700;" IsOn="{Binding OverlaysAnyEnabled}"/>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="OverlaysTitle" AutomationProperties.HeadingLevel="Level1" Text="{Binding Dashboard_Overlays, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraTitle}"/>
                            <TextBlock Text="{Binding Dashboard_OverlaysDescription, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraLine}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <CheckBox Style="{StaticResource SwitchCheckBox}" controls:SwitchLook.ShowState="True"
                                  AutomationProperties.AutomationId="OverlaysSwitch"
                                  Content="{Binding Dashboard_Overlays, Source={x:Static strings:Strings.Instance}}"
                                  IsChecked="{Binding OverlaysAnyEnabled}"/>
                        <reset:SettingResetButton Command="{Binding ResetOverlaysCommand}" SettingLabel="{Binding Dashboard_Overlays, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DashboardViewModel_OverlaysAnyEnabled" Margin="14,0,0,0"/>
                    </StackPanel>
                </controls:HeadRowPanel>

                <Border Style="{StaticResource ExtraCard}" Margin="0,20,0,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,4">
                            <TextBlock Text="{Binding Extras_Overlays_WhatShows, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraCardTitle}"/>
                            <ui:Button Command="{Binding ResetOverlaysCommand}" Style="{StaticResource ResetAllButton}"
                                       Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}"
                                       AutomationProperties.AutomationId="Extras_ResetAll_Overlays">
                                <ui:Button.ToolTip>
                                    <MultiBinding Converter="{StaticResource FormatTextConverter}">
                                        <Binding Path="Extras_Overlays_WhatShows" Source="{x:Static strings:Strings.Instance}"/>
                                        <Binding Path="Pad_ResetSection_Format" Source="{x:Static strings:Strings.Instance}"/>
                                    </MultiBinding>
                                </ui:Button.ToolTip>
                            </ui:Button>
                        </DockPanel>
                        <controls:SettingRow MinHeight="64">
                            <Border Style="{StaticResource OverlaysPreviewWell}">
                                <controls:DecorativeImage FlowDirection="LeftToRight" Source="{StaticResource OverlaysPreviewMenu}" Stretch="Uniform"/>
                            </Border>
                            <StackPanel controls:SettingRow.Fills="True" Margin="14,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Dashboard_MenuOverlay, Source={x:Static strings:Strings.Instance}}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           ToolTip="{Binding Dashboard_MenuOverlayDescription, Source={x:Static strings:Strings.Instance}}"/>
                                <TextBlock Text="{Binding Extras_Overlays_MenuHint, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraSmall}" Margin="0"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource SwitchCheckBox}"
                                      Content="{Binding Dashboard_MenuOverlay, Source={x:Static strings:Strings.Instance}}"
                                      ToolTip="{Binding Dashboard_MenuOverlayDescription, Source={x:Static strings:Strings.Instance}}"
                                      IsChecked="{Binding EnableMenuOverlay}"/>
                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="EnableMenuOverlay" SettingLabel="{Binding Dashboard_MenuOverlay, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DashboardViewModel_EnableMenuOverlay_2023" Margin="14,0,0,0"/>
                        </controls:SettingRow>
                        <controls:SettingRow MinHeight="64">
                            <Border Style="{StaticResource OverlaysPreviewWell}">
                                <controls:DecorativeImage FlowDirection="LeftToRight" Source="{StaticResource OverlaysPreviewShift}" Stretch="Uniform"/>
                            </Border>
                            <StackPanel controls:SettingRow.Fills="True" Margin="14,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Dashboard_ShiftLayerFlyout, Source={x:Static strings:Strings.Instance}}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{Binding Extras_Overlays_ShiftLayerHint, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraSmall}" Margin="0"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource SwitchCheckBox}"
                                      Content="{Binding Dashboard_ShiftLayerFlyout, Source={x:Static strings:Strings.Instance}}"
                                      IsChecked="{Binding EnableShiftLayerFlyout}"/>
                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="EnableShiftLayerFlyout" SettingLabel="{Binding Dashboard_ShiftLayerFlyout, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DashboardViewModel_EnableShiftLayerFlyout_2026" Margin="14,0,0,0"/>
                        </controls:SettingRow>
                        <controls:SettingRow MinHeight="64">
                            <Border Style="{StaticResource OverlaysPreviewWell}">
                                <controls:DecorativeImage FlowDirection="LeftToRight" Source="{StaticResource OverlaysPreviewProfile}" Stretch="Uniform"/>
                            </Border>
                            <StackPanel controls:SettingRow.Fills="True" Margin="14,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Dashboard_ProfileOverlay, Source={x:Static strings:Strings.Instance}}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{Binding Extras_Overlays_ProfileHint, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraSmall}" Margin="0"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource SwitchCheckBox}"
                                      Content="{Binding Dashboard_ProfileOverlay, Source={x:Static strings:Strings.Instance}}"
                                      IsChecked="{Binding EnableProfileOverlay}"/>
                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="EnableProfileOverlay" SettingLabel="{Binding Dashboard_ProfileOverlay, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DashboardViewModel_EnableProfileOverlay_2029" Margin="14,0,0,0"/>
                        </controls:SettingRow>
                    </StackPanel>
                </Border>

                <!-- One line of markup: a line break between runs would add a space. -->
                <TextBlock Style="{StaticResource ExtraNote}"><Run Text="{Binding Extras_Note_Overlays, Source={x:Static strings:Strings.Instance}, Converter={StaticResource BracketPartConverter}, ConverterParameter=0, Mode=OneWay}"/><Hyperlink Click="MenusLink_Click" AutomationProperties.AutomationId="Extras_Link_Overlays"><Run Text="{Binding Extras_Note_Overlays, Source={x:Static strings:Strings.Instance}, Converter={StaticResource BracketPartConverter}, ConverterParameter=1, Mode=OneWay}"/></Hyperlink><Run Text="{Binding Extras_Note_Overlays, Source={x:Static strings:Strings.Instance}, Converter={StaticResource BracketPartConverter}, ConverterParameter=2, Mode=OneWay}"/></TextBlock>
            </StackPanel>

            <!-- ═══ Touchpad Overlay ═══
                 Whether the overlay is showing, its opacity and its place. -->
            <StackPanel x:Name="TouchpadOverlayPage" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ExtrasCrumb}" Click="Back_Click"
                            AutomationProperties.AutomationId="Extras_Back_TouchpadOverlay"
                            Content="{Binding Extras_Title, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock Text="/" Style="{StaticResource ExtrasCrumbText}" Margin="4,0,4,0"/>
                    <TextBlock Text="{Binding Dashboard_TouchpadOverlay, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtrasCrumbText}"/>
                </StackPanel>
                <controls:HeadRowPanel LeadingMinWidth="328" Gap="12" Margin="0,10,0,0">
                    <Grid Margin="0,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:ExtraBadge Glyph="&#xEDA4;" IsOn="{Binding EnableTouchpadOverlay}"/>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TouchpadOverlayTitle" AutomationProperties.HeadingLevel="Level1" Text="{Binding Dashboard_TouchpadOverlay, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraTitle}"/>
                            <TextBlock Text="{Binding Dashboard_TouchpadOverlayDescription, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraLine}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <CheckBox Style="{StaticResource SwitchCheckBox}" controls:SwitchLook.ShowState="True"
                                  Content="{Binding Dashboard_EnableTouchpadOverlay, Source={x:Static strings:Strings.Instance}}"
                                  IsChecked="{Binding EnableTouchpadOverlay}"/>
                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="EnableTouchpadOverlay" SettingLabel="{Binding Dashboard_EnableTouchpadOverlay, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DashboardViewModel_EnableTouchpadOverlay_2045" Margin="14,0,0,0"/>
                    </StackPanel>
                </controls:HeadRowPanel>

                <!-- Showing = flame: the overlay window's running truth, which
                     drives the status too (#175 phase 2 item 2). -->
                <Border x:Name="TouchpadOverlayStatusCard" Style="{StaticResource ExtraStatusCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:StatusFlame IsOn="{Binding EnableTouchpadOverlay}" IsLive="{Binding IsTouchpadOverlayRunning}"
                                              VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock Grid.Column="1" common:LiveText.Polite="True" Text="{Binding TouchpadOverlayStatus}"
                                   Style="{StaticResource ExtraStatusText}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border x:Name="TouchpadOverlayLookCard" Style="{StaticResource ExtraCard}">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,4">
                            <TextBlock Text="{Binding Extras_TouchpadOverlay_LookAndPlace, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraCardTitle}"/>
                            <ui:Button Command="{Binding ResetTouchpadOverlayCardCommand}" Style="{StaticResource ResetAllButton}"
                                       Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}"
                                       AutomationProperties.AutomationId="Extras_ResetAll_TouchpadOverlay">
                                <ui:Button.ToolTip>
                                    <MultiBinding Converter="{StaticResource FormatTextConverter}">
                                        <Binding Path="Extras_TouchpadOverlay_LookAndPlace" Source="{x:Static strings:Strings.Instance}"/>
                                        <Binding Path="Pad_ResetSection_Format" Source="{x:Static strings:Strings.Instance}"/>
                                    </MultiBinding>
                                </ui:Button.ToolTip>
                            </ui:Button>
                        </DockPanel>
                        <!-- The value is typed in place, as the controller page's
                             rows take theirs. -->
                        <controls:SettingRow MinHeight="44">
                            <TextBlock Text="{Binding Dashboard_TouchpadOverlayOpacity, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                            <Slider Style="{StaticResource EmberSlider}" MaxWidth="240" VerticalAlignment="Center"
                                    Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                    Value="{Binding TouchpadOverlayOpacity, Mode=TwoWay}"/>
                            <TextBox Style="{StaticResource DzValueEdit}" FontSize="12"
                                     Text="{Binding TouchpadOverlayOpacityPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     AutomationProperties.Name="{Binding Dashboard_TouchpadOverlayOpacity, Source={x:Static strings:Strings.Instance}}"/>
                            <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                            <reset:SettingResetButton Command="{Binding ResetOpacityCommand}" SettingLabel="{Binding Dashboard_TouchpadOverlayOpacity, Source={x:Static strings:Strings.Instance}}"/>
                        </controls:SettingRow>
                        <controls:SettingRow MinHeight="44">
                            <TextBlock Text="{Binding Extras_PlaceOnScreen, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                            <Button Command="{Binding ResetTouchpadOverlayPositionCommand}" Style="{StaticResource ExtraButton}"
                                    Content="{Binding Dashboard_TouchpadOverlayResetPosition, Source={x:Static strings:Strings.Instance}}"/>
                            <TextBlock Text="{Binding Extras_TouchpadOverlay_DragHint, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraRowHint}" Margin="12,0,0,0"/>
                        </controls:SettingRow>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ═══ Screen Overlay (#560) ═══
                 One card per overlay, each with its switch, what it shows, its
                 opacity and its place. Each overlay has its own switch, so the
                 page has none: Add Overlay stands in its place. The catalog
                 tile's switch is on while any overlay is
                 (DashboardViewModel.ScreenOverlaysAnyEnabled). -->
            <StackPanel x:Name="ScreenOverlayPage" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ExtrasCrumb}" Click="Back_Click"
                            AutomationProperties.AutomationId="Extras_Back_ScreenOverlay"
                            Content="{Binding Extras_Title, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock Text="/" Style="{StaticResource ExtrasCrumbText}" Margin="4,0,4,0"/>
                    <TextBlock Text="{Binding Dashboard_ScreenOverlay, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtrasCrumbText}"/>
                </StackPanel>
                <controls:HeadRowPanel LeadingMinWidth="328" Gap="12" Margin="0,10,0,0">
                    <Grid Margin="0,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:ExtraBadge Glyph="&#xE7F4;" IsOn="{Binding ScreenOverlaysAnyEnabled}"/>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ScreenOverlayTitle" AutomationProperties.HeadingLevel="Level1" Text="{Binding Dashboard_ScreenOverlay, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraTitle}"/>
                            <TextBlock Text="{Binding Dashboard_ScreenOverlayDescription, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraLine}"/>
                        </StackPanel>
                    </Grid>
                    <ui:Button AutomationProperties.AutomationId="ScreenOverlay_Add" MinHeight="36" Padding="14,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                               Command="{Binding AddScreenOverlayCommand}" IsEnabled="{Binding CanAddScreenOverlay}"
                               Content="{Binding Dashboard_ScreenOverlayAdd, Source={x:Static strings:Strings.Instance}}">
                        <ui:Button.Icon>
                            <controls:DecorativeStrokeIcon Data="{StaticResource PlusLineGeometry}" Size="14" StrokeWidth="2"/>
                        </ui:Button.Icon>
                    </ui:Button>
                </controls:HeadRowPanel>

                <ItemsControl ItemsSource="{Binding ScreenOverlays}" IsTabStop="False" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ExtraCard}">
                                <StackPanel>
                                    <!-- The overlay's number and status, and its card's
                                         actions: Reset All outermost, Remove beside it
                                         while there are several. The head docks from its
                                         end, so Reset All is written first, and the two
                                         take their place in the Tab order by number: Remove,
                                         which stands first, then Reset All. -->
                                    <DockPanel KeyboardNavigation.TabNavigation="Local" LastChildFill="False" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource ExtraCardTitle}"/>
                                        <TextBlock common:LiveText.Polite="True" Text="{Binding Status}" FontSize="13" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <ui:Button TabIndex="1" Style="{StaticResource ResetAllButton}" Margin="12,0,0,0"
                                                   AutomationProperties.AutomationId="{Binding ResetAllId}" Command="{Binding ResetAllCommand}"
                                                   Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}">
                                            <ui:Button.ToolTip>
                                                <MultiBinding Converter="{StaticResource FormatTextConverter}">
                                                    <Binding Path="Title"/>
                                                    <Binding Path="Pad_ResetSection_Format" Source="{x:Static strings:Strings.Instance}"/>
                                                </MultiBinding>
                                            </ui:Button.ToolTip>
                                        </ui:Button>
                                        <ui:Button TabIndex="0" Style="{StaticResource ResetAllButton}" Margin="12,0,0,0"
                                                   AutomationProperties.AutomationId="{Binding RemoveId}" Command="{Binding RemoveCommand}"
                                                   Content="{Binding Common_Remove, Source={x:Static strings:Strings.Instance}}"
                                                   Visibility="{Binding OneOfSeveral, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </DockPanel>
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Text="{Binding Dashboard_EnableScreenOverlay, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <CheckBox Style="{StaticResource SwitchCheckBox}" AutomationProperties.AutomationId="{Binding EnableId}"
                                                  Content="{Binding Dashboard_EnableScreenOverlay, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding Enabled}"/>
                                        <reset:SettingResetButton Command="{Binding ResetEnabledCommand}" SettingLabel="{Binding Dashboard_EnableScreenOverlay, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Text="{Binding Extras_ScreenOverlay_Shows, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <TextBlock Text="{Binding ShowsText}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <Button AutomationProperties.AutomationId="{Binding ChooseId}" Style="{StaticResource ExtraButton}" Margin="12,0,0,0"
                                                Command="{Binding ChooseCommand}"
                                                Content="{Binding Dashboard_ScreenOverlayChoose, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Text="{Binding Dashboard_TouchpadOverlayOpacity, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <Slider Style="{StaticResource EmberSlider}" MaxWidth="240" VerticalAlignment="Center"
                                                AutomationProperties.AutomationId="{Binding OpacityId}"
                                                Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                                Value="{Binding Opacity, Mode=TwoWay}"/>
                                        <TextBox Style="{StaticResource DzValueEdit}" FontSize="12"
                                                 Text="{Binding OpacityPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 AutomationProperties.Name="{Binding Dashboard_TouchpadOverlayOpacity, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                        <reset:SettingResetButton Command="{Binding ResetOpacityCommand}" SettingLabel="{Binding Dashboard_TouchpadOverlayOpacity, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Text="{Binding Extras_PlaceOnScreen, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <Button AutomationProperties.AutomationId="{Binding ResetPositionId}" Style="{StaticResource ExtraButton}"
                                                Command="{Binding ResetPositionCommand}"
                                                Content="{Binding Dashboard_TouchpadOverlayResetPosition, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding Extras_ScreenOverlay_Footer, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource ExtraNote}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
