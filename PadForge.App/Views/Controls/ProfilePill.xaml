<UserControl x:Class="PadForge.Views.Controls.ProfilePill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:strings="clr-namespace:PadForge.Resources.Strings"
             xmlns:controls="clr-namespace:PadForge.Controls">
    <!-- The profile switcher in the title bar (#574): the word Profile, the
         active profile's name and a chevron, in one outlined box the height
         of the search box beside it. Its host's DataContext is not the one
         it reads, so code-behind rebinds it to MainViewModel.Settings on
         Loaded. That is the one SettingsViewModel whose ActiveProfileInfo
         every switch path (auto, shortcut cycle, Load button, delete or
         revert) already sets. A click opens the switcher, which MainWindow
         wires. Under the pointer the fill lifts one step. -->
    <controls:ClickBorder x:Name="PillBorder" Height="34" CornerRadius="8" BorderThickness="1"
            Padding="12,0,10,0" Cursor="Hand" Click="Pill_Click">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource SteelPillLineBrush}"/>
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SteelRaisedBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <!-- Read as "Active profile: <name>", the tooltip's words. -->
        <AutomationProperties.Name>
            <MultiBinding StringFormat="{}{0} {1}">
                <Binding Path="Profiles_ActiveProfile" Source="{x:Static strings:Strings.Instance}"/>
                <Binding Path="ActiveProfileInfo"/>
            </MultiBinding>
        </AutomationProperties.Name>
        <!-- The tooltip carries the whole name, which the box trims. -->
        <Border.ToolTip>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Profiles_ActiveProfile, Source={x:Static strings:Strings.Instance}}" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding ActiveProfileInfo}"/>
            </StackPanel>
        </Border.ToolTip>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding Main_ProfileLabel, Source={x:Static strings:Strings.Instance}}"
                       FontSize="14"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding ActiveProfileInfo}"
                       FontSize="14"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       MaxWidth="180" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
            <Path FlowDirection="LeftToRight" Data="M0,0 L5,5 L10,0" Width="10" Height="6" Stretch="Fill"
                  Stroke="{DynamicResource TextFillColorTertiaryBrush}" StrokeThickness="1.6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  VerticalAlignment="Center" Margin="8,1,0,0"/>
        </StackPanel>
    </controls:ClickBorder>
</UserControl>
