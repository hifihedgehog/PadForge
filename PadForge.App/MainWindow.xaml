<ui:FluentWindow x:Class="PadForge.MainWindow"
    FontFamily="{StaticResource BodyFontFamily}"
    FontSize="13"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:PadForge"
        xmlns:views="clr-namespace:PadForge.Views"
        xmlns:controls="clr-namespace:PadForge.Controls"
        xmlns:viewControls="clr-namespace:PadForge.Views.Controls"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Title="{Binding Title}"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        Stylus.IsPressAndHoldEnabled="False"
        Stylus.IsTapFeedbackEnabled="False"
        Stylus.IsTouchFeedbackEnabled="False"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        WindowStartupLocation="Manual">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- The ground (#574): one flat fill under everything, the page's
             color. Dark theme only. UpdateSteelLayer collapses it in Light,
             where the window's own backdrop shows. -->
        <Grid x:Name="SteelLayer" Grid.RowSpan="2" IsHitTestVisible="False">
            <Border Background="{DynamicResource SteelGroundBrush}"/>
        </Grid>

        <!-- The title bar (#574): the PadForge mark and name, the profile
             switcher, and the window's own buttons, on the window's own
             ground, the darkest step, with a hairline under it. While the
             engine runs a warm light lies across it, so the whole window
             says the engine is on. TitleBar provides native minimize,
             maximize and close with Snap Layout support. -->
        <Grid x:Name="AppBrandingBar" Grid.Row="0" Height="52">
            <Border Background="{DynamicResource SteelWindowBrush}"
                    BorderBrush="{DynamicResource SteelPaneLineBrush}" BorderThickness="0,0,0,1"
                    IsHitTestVisible="False"/>
            <Border x:Name="TitleWarmth" Background="{DynamicResource TitleWarmthBrush}" IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Opacity" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Dashboard.EngineStateKey}" Value="Running">
                                <Setter Property="Opacity" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <ui:TitleBar x:Name="AppTitleBar" Height="52" HorizontalContentAlignment="Stretch"
                         ButtonsForeground="{DynamicResource TextFillColorSecondaryBrush}"
                         CloseClicked="TitleBar_CloseClicked"
                         MaximizeClicked="TitleBar_MaximizeClicked"
                         ForceShutdown="False">
                <ui:TitleBar.Resources>
                    <!-- Minimize, maximize and close: 40 by 32, centered in
                         the 52 of the bar, 2 apart. wpf-ui draws them 44 by
                         30 against the bar's top edge, which leaves them
                         above the middle of a bar this tall. -->
                    <Style TargetType="ui:TitleBarButton" BasedOn="{StaticResource {x:Type ui:TitleBarButton}}">
                        <Setter Property="Width" Value="40"/>
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="Margin" Value="0,10,2,0"/>
                    </Style>
                </ui:TitleBar.Resources>
                <ui:TitleBar.Header>
                    <Border x:Name="AppBrandingBorder" Padding="16,0,12,0" Height="52"
                            Background="Transparent" MouseLeftButtonDown="BrandingBar_MouseDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:DecorativeImage FlowDirection="LeftToRight" Source="/Resources/PadForge-icon.png" Width="24" Height="24"
                                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                            <TextBlock Text="PadForge" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Border>
                </ui:TitleBar.Header>
                <ui:TitleBar.CenterContent>
                    <!-- Search (#574): the box the boards draw between the mark
                         and the profile pill. Only the box takes the pointer:
                         the bar on either side still drags the window, since
                         wpf-ui's title bar reads this element's own bounds in
                         its hit test (TitleBar.cs, WM_NCHITTEST). A click, or
                         Ctrl+K anywhere, opens Search. The key label's text and
                         the box's shortcut are set in code, in the language's
                         own Ctrl. -->
                    <controls:ClickBorder x:Name="TitleSearchBox" Style="{StaticResource TitleSearchBox}"
                                          Height="34" MaxWidth="560" Margin="16,0" HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          WindowChrome.IsHitTestVisibleInChrome="True"
                                          AutomationProperties.AutomationId="TitleSearchBox"
                                          AutomationProperties.Name="{Binding Search_Placeholder, Source={x:Static strings:Strings.Instance}}">
                        <DockPanel>
                            <controls:DecorativeStrokeIcon Data="{StaticResource SearchLineGeometry}" Size="16" StrokeWidth="1.8"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Border DockPanel.Dock="Right" Style="{StaticResource KeyChip}" Margin="10,0,0,0">
                                <TextBlock x:Name="TitleSearchShortcut" Style="{StaticResource KeyChipText}"/>
                            </Border>
                            <TextBlock Text="{Binding Search_Placeholder, Source={x:Static strings:Strings.Instance}}" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </controls:ClickBorder>
                </ui:TitleBar.CenterContent>
                <ui:TitleBar.TrailingContent>
                    <StackPanel Orientation="Horizontal">
                    <!-- The profile switcher (#574): the pill the status bar
                         carried, now beside the window's own buttons. A
                         click opens the switcher under it, and an applied
                         auto-switch flares it (both wired in code-behind).
                         It binds itself to MainViewModel.Settings once it
                         loads, so it needs nothing from this tree. wpf-ui's
                         title bar leaves the pointer to whatever sits in
                         TrailingContent (TitleBar.cs, the WM_NCHITTEST
                         branch), so the pill takes its own clicks, and it
                         is marked hit-testable in the chrome as the full
                         screen button beside it is. Its AutomationId is the
                         one it always had. -->
                    <viewControls:ProfilePill x:Name="TitleProfilePill"
                                              VerticalAlignment="Center" Margin="0,0,8,0"
                                              WindowChrome.IsHitTestVisibleInChrome="True"
                                              AutomationProperties.AutomationId="ProfilePillStatusBar"/>
                    <!-- Full screen: the fourth of the window's buttons. It
                         has the size, the place and the icon weight the
                         three beside it are given in the title bar's
                         resources below, so the four read as one row. -->
                    <controls:StateToggleButton x:Name="FullScreenBtn" AutomationProperties.Name="{Binding Main_FullScreen, Source={x:Static strings:Strings.Instance}}" Click="FullScreenBtn_Click" Width="40" Height="32"
                            Background="Transparent" BorderThickness="0" Padding="0"
                            VerticalAlignment="Top" Margin="0,10,2,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <!-- AncestorType, not ElementName: TrailingContent
                                                         is applied inside the TitleBar's template, so
                                                         an ElementName lookup crosses a template name
                                                         scope and resolves timing-dependently. It was
                                                         clean here and a startup BINDERR on a field
                                                         machine (#285 reporter's log, 2026-08-08). -->
                                                    <Setter TargetName="LayoutRoot" Property="Background"
                                                            Value="{Binding ButtonsBackground, RelativeSource={RelativeSource AncestorType=ui:TitleBar}}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <!-- Foreground is bound in code-behind with an
                             explicit Source. TrailingContent is re-parented
                             into the TitleBar template's own namescope, so
                             both FindAncestor and ElementName bindings
                             evaluated before the tree connects and logged a
                             BINDERR on every launch. -->
                        <controls:GlyphText x:Name="FullScreenIcon" Text="&#xE740;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"/>
                    </controls:StateToggleButton>
                    </StackPanel>
                </ui:TitleBar.TrailingContent>
            </ui:TitleBar>
        </Grid>

        <!-- ═══════════════════════════════════════════
             Navigation View (left pane) with content overlay
             ═══════════════════════════════════════════ -->
        <ui:NavigationView x:Name="NavView" Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False"
                           AlwaysShowHeader="False"
                           OpenPaneLength="264"
                           Template="{StaticResource PadNavigationViewTemplate}"
                           ItemTemplate="{StaticResource PadNavigationViewItemTemplate}">

            <ui:NavigationView.Resources>
                <!-- One sidebar row (#574): 40 tall with 2 between rows.
                     It rests in the secondary text color, and the selected
                     one comes forward in the primary color and a heavier
                     weight. The fill and the icon's color are the entry
                     template's (Resources/Shell.xaml). Code-built entries
                     take this style too. -->
                <Style TargetType="ui:NavigationViewItem">
                    <Setter Property="MinHeight" Value="40"/>
                    <Setter Property="Margin" Value="0,0,0,2"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <Style.Triggers>
                        <Trigger Property="IsActive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ui:NavigationView.Resources>

            <!-- MenuItems built programmatically in code-behind (BuildNavigationItems) -->

            <!-- Settings and About stand at the sidebar's foot, over the
                 engine's block (the sidebar's template holds the three
                 there, Resources/Shell.xaml). -->
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem x:Name="NavSettings" Content="{Binding Settings_Title, Source={x:Static strings:Strings.Instance}}" Tag="Settings" AutomationProperties.AutomationId="Nav_Settings" AutomationProperties.PositionInSet="1" AutomationProperties.SizeOfSet="2">
                    <ui:NavigationViewItem.Icon>
                        <controls:DecorativeStrokeIcon Data="{StaticResource NavSettingsGeometry}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavAbout" Content="{Binding About_Title, Source={x:Static strings:Strings.Instance}}" Tag="About" AutomationProperties.AutomationId="Nav_About" AutomationProperties.PositionInSet="2" AutomationProperties.SizeOfSet="2">
                    <ui:NavigationViewItem.Icon>
                        <controls:DecorativeStrokeIcon Data="{StaticResource NavAboutGeometry}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

            <!-- The engine's block (#574), at the sidebar's foot: the
                 flame in its ring, the state, how many of the controllers
                 are live, and the polling rate with its number set large.
                 While the engine runs the block has an ember edge, a warm
                 wash and a soft light around it, and the ring's own light
                 rises and falls slowly. Idle or stopping, the ring is
                 gold. Stopped, it is steel and nothing is lit. The
                 bindings read MainViewModel, which the constructor hands
                 the outer element by name. -->
            <ui:NavigationView.PaneFooter>
                <controls:Halo x:Name="EngineFootHalo" Margin="0,12,0,0" CornerRadius="12" Radius="27.5" Strength="0.06">
                    <controls:Halo.Style>
                        <Style TargetType="controls:Halo">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Dashboard.EngineStateKey}" Value="Running">
                                    <Setter Property="IsLit" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:Halo.Style>
                    <Border x:Name="EngineFoot" MinHeight="60" CornerRadius="12" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource SteelFootBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource SteelLineSoftBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Dashboard.EngineStateKey}" Value="Running">
                                        <Setter Property="BorderBrush" Value="{DynamicResource EmberRingSoftBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <!-- The warm wash, from the ring's side. -->
                            <Border CornerRadius="11" IsHitTestVisible="False">
                                <Border.Background>
                                    <RadialGradientBrush Center="0,0.5" GradientOrigin="0,0.5" RadiusX="0.75" RadiusY="1.1">
                                        <GradientStop Color="#29FF6B2C" Offset="0"/>
                                        <GradientStop Color="#00FF6B2C" Offset="1"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Dashboard.EngineStateKey}" Value="Running">
                                                <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Grid Margin="10,10,14,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <controls:Halo CornerRadius="19" Radius="17.5" Strength="0.275" Breathes="True" VerticalAlignment="Center">
                                    <controls:Halo.Style>
                                        <Style TargetType="controls:Halo">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Dashboard.EngineStateKey}" Value="Running">
                                                    <Setter Property="IsLit" Value="True"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:Halo.Style>
                                    <Border x:Name="EngineFootRing" Width="38" Height="38" CornerRadius="19" BorderThickness="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource SteelLineBrush}"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Dashboard.EngineStateKey}" Value="Running">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource EmberBrush}"/>
                                                        <Setter Property="Background" Value="{DynamicResource EmberTintBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Dashboard.EngineStateKey}" Value="Idle">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource WaitBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Dashboard.EngineStateKey}" Value="Stopping">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource WaitBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Path x:Name="EngineFootFlame" FlowDirection="LeftToRight" Data="{StaticResource FlameOuterGeometry}"
                                              Width="15" Height="15" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <!-- Stopped: the outline alone. Running:
                                                         ember. Idle or stopping: gold. -->
                                                    <Setter Property="Fill" Value="Transparent"/>
                                                    <Setter Property="Stroke" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <Setter Property="StrokeThickness" Value="1.2"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Dashboard.EngineStateKey}" Value="Running">
                                                            <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                                            <Setter Property="Stroke" Value="{x:Null}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Dashboard.EngineStateKey}" Value="Idle">
                                                            <Setter Property="Fill" Value="{DynamicResource WaitBrush}"/>
                                                            <Setter Property="Stroke" Value="{x:Null}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Dashboard.EngineStateKey}" Value="Stopping">
                                                            <Setter Property="Fill" Value="{DynamicResource WaitBrush}"/>
                                                            <Setter Property="Stroke" Value="{x:Null}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Border>
                                </controls:Halo>
                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="EngineFootState" Text="{Binding EngineStatusText}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               AutomationProperties.AutomationId="EngineFootState"/>
                                    <TextBlock x:Name="EngineFootLine" Text="{Binding Dashboard.LiveLine}"
                                               FontSize="12" Margin="0,1,0,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <!-- The rate: the number set large, the unit
                                     small, in the order the language's own
                                     format puts them. The runs sit on one
                                     line of markup, since a line break
                                     between runs would add a space. -->
                                <TextBlock x:Name="EngineFootRate" Grid.Column="2" VerticalAlignment="Center"
                                           FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11"
                                           AutomationProperties.Name="{Binding Dashboard.PollingFrequencyText, Mode=OneWay, TargetNullValue='', FallbackValue=''}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Dashboard.EngineStateKey}" Value="Running"><Setter Property="Foreground" Value="{DynamicResource ColdBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style><Run Text="{Binding Dashboard.PollingRateLead, Mode=OneWay}"/><Run Text="{Binding Dashboard.PollingRateNumber, Mode=OneWay}" FontSize="17" FontWeight="SemiBold"/><Run Text="{Binding Dashboard.PollingRateTail, Mode=OneWay}"/></TextBlock>
                            </Grid>
                        </Grid>
                    </Border>
                </controls:Halo>
            </ui:NavigationView.PaneFooter>

            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <!-- The message line (#574), where the status bar's
                         message was. It is here only while there is a
                         message: a plain one fades and clears after about
                         five seconds (MainWindow.SweepStatusMessage), and one
                         that reports a failure stays until the next. It is
                         drawn over the page's lower corner and takes no row
                         of its own, so a message that comes and goes never
                         moves the page. First among the children and raised
                         by its ZIndex, so the pages keep their order under
                         it. The pointer passes through it. -->
                    <Border x:Name="StatusMessageLine" Panel.ZIndex="10"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="16,0,16,12" Padding="12,6" CornerRadius="6" MaxWidth="720"
                            Background="{DynamicResource SteelRaisedBrush}"
                            BorderBrush="{DynamicResource SteelLineBrush}" BorderThickness="1"
                            IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock x:Name="StatusMessageText" AutomationProperties.LiveSetting="Polite"
                                   Text="{Binding StatusText}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <!-- Home's AutomationId is the one the Dashboard had, as
                         its sidebar entry's is still Nav_Dashboard: UI tools
                         pair Nav_<tag> with <tag>PageView, and #574 keeps
                         every id. -->
                    <views:HomePage x:Name="HomePageView" AutomationProperties.AutomationId="DashboardPageView" Visibility="Visible"/>
                    <views:PadPage x:Name="PadPageView" Visibility="Collapsed"/>
                    <views:DevicesPage x:Name="DevicesPageView" Visibility="Collapsed"/>
                    <views:ExtrasPage x:Name="ExtrasPageView" Visibility="Collapsed"/>
                    <views:SettingsPage x:Name="SettingsPageView" Visibility="Collapsed"/>
                    <views:ProfilesPage x:Name="ProfilesPageView" Visibility="Collapsed"/>
                    <views:AboutPage x:Name="AboutPageView" Visibility="Collapsed"/>
                    <!-- Add a Controller (#574): a dialog drawn over the page
                         area, as its board draws it, while the sidebar and the
                         title bar stay as they are. OpenAddController opens it.
                         It is under the message line, so a message still
                         shows over it. -->
                    <controls:ShellDialog x:Name="AddControllerHost" Panel.ZIndex="5" FrameMaxWidth="760"
                                          AutomationProperties.AutomationId="AddControllerDialog"
                                          AutomationProperties.Name="{Binding AddController_Title, Source={x:Static strings:Strings.Instance}}">
                        <views:AddControllerView x:Name="AddControllerView"/>
                    </controls:ShellDialog>
                    <!-- Search (#574): the same dialog frame, at Search's width.
                         A press on the dark ground closes it, as the board's
                         page area invites. OpenSearch opens it. -->
                    <controls:ShellDialog x:Name="SearchHost" Panel.ZIndex="5" FrameMaxWidth="660" ClosesOnGroundPress="True"
                                          AutomationProperties.AutomationId="SearchPanel"
                                          AutomationProperties.Name="{Binding Search_Title, Source={x:Static strings:Strings.Instance}}">
                        <views:SearchPanel x:Name="SearchPanelView"/>
                    </controls:ShellDialog>
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <!-- ═══════════════════════════════════════════
             Driver operation overlay
             ═══════════════════════════════════════════ -->
        <Grid x:Name="DriverOverlay"
              Grid.RowSpan="2"
              Visibility="Collapsed"
              Panel.ZIndex="1000">
            <Border Background="#80000000"/>
            <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    CornerRadius="8" Padding="32,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="280">
                <StackPanel HorizontalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True"
                                     Width="40" Height="40"
                                     Margin="0,0,0,16"/>
                    <!-- Headline role (#175 font sweep): the overlay's sole
                         16px line reads as its title, so it wears Display
                         like the shutdown/startup overlay titles. -->
                    <TextBlock x:Name="DriverOverlayText"
                               FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="16" HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════
             Shutdown overlay
             ═══════════════════════════════════════════ -->
        <Grid x:Name="ShutdownOverlay"
              Grid.RowSpan="2"
              Visibility="Collapsed"
              Panel.ZIndex="1001">
            <Border Background="#CC000000"/>
            <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    CornerRadius="8" Padding="32,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="280">
                <StackPanel HorizontalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True"
                                     Width="40" Height="40"
                                     Margin="0,0,0,16"/>
                    <TextBlock FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Text="{Binding Main_ShuttingDown, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock x:Name="ShutdownOverlayText"
                               FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,4" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════
             Startup overlay — shown while the orphan-sweep
             task (App.OrphanSweepTask) is still running at
             launch. Hidden automatically when the task
             completes.
             ═══════════════════════════════════════════ -->
        <Grid x:Name="StartupOverlay"
              Grid.RowSpan="2"
              Visibility="Collapsed"
              Panel.ZIndex="1001">
            <Border Background="#CC000000"/>
            <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    CornerRadius="8" Padding="32,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="320">
                <StackPanel HorizontalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True"
                                     Width="40" Height="40"
                                     Margin="0,0,0,16"/>
                    <TextBlock FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Text="{Binding Main_StartingUp, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,6,0,4" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Text="{Binding Main_CleaningPreviousSession, Source={x:Static strings:Strings.Instance}}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
