<ui:FluentWindow x:Class="PadForge.Views.RegisterNfcTagDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Title="{Binding Nfc_Title, Source={x:Static strings:Strings.Instance}}"
        Height="520" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Dialog head (#175 item 11): ExtendsContentIntoTitleBar strips the
             system title bar, so the localized Title never rendered anywhere.
             Ember tick + display-face title makes it visible. The X stands in
             for the caption close button WindowChrome no longer provides. -->
        <Border Padding="14"
                BorderBrush="{DynamicResource SteelLineSoftBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5"
                           Fill="{DynamicResource EmberBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontFamily="{StaticResource DisplayFontFamily}"
                           FontWeight="SemiBold" FontSize="15"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           TextTrimming="CharacterEllipsis"/>
                <ui:Button Grid.Column="2" Style="{StaticResource EmberIconButton}"
                           VerticalAlignment="Center" Click="CloseButton_Click"
                           ToolTip="{Binding Common_Close, Source={x:Static strings:Strings.Instance}}">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </ui:Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding Nfc_RegisterHeader, Source={x:Static strings:Strings.Instance}}" FontFamily="{StaticResource DisplayFontFamily}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1" x:Name="StatusText"
                       Text="{Binding Nfc_TapPrompt, Source={x:Static strings:Strings.Instance}}"
                       TextWrapping="Wrap" Margin="0,0,0,8"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{Binding Nfc_UidLabel, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="UidText" Text="{Binding Nfc_Waiting, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" FontFamily="{StaticResource TelemetryFontFamily}"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="{Binding Nfc_NameLabel, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="NameBox" Width="240" VerticalAlignment="Center" Margin="0,0,8,0"
                         KeyDown="NameBox_KeyDown"/>
                <!-- Register is the dialog's primary affirmative and wears
                     the ember accent (#175 dialog language). -->
                <Button x:Name="RegisterBtn" Content="{Binding Nfc_RegisterButton, Source={x:Static strings:Strings.Instance}}" Click="RegisterButton_Click"
                        MinWidth="90" IsEnabled="False"
                        Style="{StaticResource EmberAccentButton}"/>
            </StackPanel>

            <TextBlock Grid.Row="4" Text="{Binding Nfc_RegisteredTagsHeader, Source={x:Static strings:Strings.Instance}}" FontWeight="SemiBold" Margin="0,4,0,4"/>

            <ListBox Grid.Row="5" x:Name="TagListBox" MinHeight="100">
                <!-- The shared row chrome left the container's content
                     left-aligned, so the star column collapsed to text width
                     and Remove sat flush against the name (owner report).
                     Stretch pins the button to the row's right edge. -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource EmberSelectListItem}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="8,6"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Name}"/>
                                <TextBlock Text="{Binding Uid}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <!-- Remove deletes the registration immediately
                                 (no confirm), so it wears the shared
                                 destructive chrome. -->
                            <Button Grid.Column="1" Content="{Binding Common_Remove, Source={x:Static strings:Strings.Instance}}" Click="RemoveButton_Click"
                                    Style="{StaticResource EmberDestructiveButton}"
                                    Tag="{Binding Uid}" MinWidth="72" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Footer band (#175 dialog language): no committing verb lives
                 down here (Register sits beside the name field), so the
                 lone Close stays neutral. -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="{Binding Common_Close, Source={x:Static strings:Strings.Instance}}" MinWidth="90" IsCancel="True" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
