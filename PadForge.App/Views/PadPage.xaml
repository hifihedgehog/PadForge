                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <ui:Button Command="{Binding RightTriggerRouteActivatorRecordCommand}" Style="{StaticResource EmberIconButtonHot}" VerticalAlignment="Top">
                                        <controls:GlyphText Text="{Binding RightTriggerRouteActivatorRecordButtonIcon}" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource EmberBrush}"/>
                                        <ui:Button.ToolTip><TextBlock Text="{Binding RightTriggerRouteActivatorRecordButtonText}"/></ui:Button.ToolTip>
                                    </ui:Button>
                                    <ui:Button Command="{Binding ResetRightTriggerRouteActivatorCommand}" Style="{StaticResource ResetButton}" VerticalAlignment="Top"
                                            ToolTip="{Binding Pad_ResetTriggerRouteActivator, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>
                                <controls:SettingRow MinHeight="44">
                                    <TextBlock Text="{Binding Pad_TriggerRouting_ActivatorMode, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ComboBox SelectedValue="{Binding RightTriggerRouteActivatorMode, Mode=TwoWay}" SelectedValuePath="Tag" MinWidth="220">
                                        <ComboBoxItem Content="{Binding Settings_GyroAimEngageMode_Hold, Source={x:Static strings:Strings.Instance}}" Tag="Hold"/>
                                        <ComboBoxItem Content="{Binding Settings_GyroAimEngageMode_Toggle, Source={x:Static strings:Strings.Instance}}" Tag="Toggle"/>
                                        <ComboBoxItem Content="{Binding Settings_GyroAimEngageMode_ReleaseToEngage, Source={x:Static strings:Strings.Instance}}" Tag="ReleaseToEngage"/>
                                        <ComboBoxItem Content="{Binding Pad_TriggerRouting_ActivatorMode_AlwaysOn, Source={x:Static strings:Strings.Instance}}" Tag="AlwaysOn"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding ResetRightTriggerRouteActivatorModeCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTriggerRouteActivatorMode, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>
                            </StackPanel>
                        </controls:FoldCard>
                        </controls:FoldList>

                    </StackPanel>
                    </GroupBox>

            <!-- ══════════════════════════════════════
                 TAB 9: IMPULSE TRIGGERS
                 (visible when the selected mapped device exposes
                 SDL_PROP_JOYSTICK_CAP_TRIGGER_RUMBLE_BOOLEAN, as the
                 Xbox One / Elite / Series pads do).
                 ══════════════════════════════════════ -->
                    <GroupBox x:Name="TabImpulseTriggers" Visibility="Collapsed" Style="{StaticResource BareGroupBox}"
                              AutomationProperties.AutomationId="TabImpulseTriggers"
                              AutomationProperties.Name="{Binding Pad_ImpulseTriggers_Header, Source={x:Static strings:Strings.Instance}}">
                    <StackPanel>
                        <!-- A DSX game mod's trigger effects (#529), which
                             Translate Adaptive Trigger Vibrations plays here. -->
                        <TextBlock Text="{Binding GameModImpulseLine}" Visibility="{Binding GameModImpulseLine, Converter={StaticResource StringToVisibility}}"
                                   Foreground="{DynamicResource EmberBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- Impulse Triggers: the card follows Force Feedback's.
                             Overall Gain and the trigger motors' live activity
                             show first. More holds each trigger's gain and
                             test, the two switches, and Constant Trigger
                             Force as a switch with its two values under it
                             while it is on. Reset All resets the whole group,
                             the audio rumble under this card included. -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                    <Viewbox Width="18" Height="18" Stretch="Uniform"
                                             VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Grid Width="512" Height="512">
                                            <Path FlowDirection="LeftToRight" Fill="{DynamicResource EmberBrush}"
                                                  Data="{StaticResource ZackslyTriggerOuterBodyGeometry}"/>
                                            <Path FlowDirection="LeftToRight" Fill="{DynamicResource EmberBrush}"
                                                  Data="M445,180 L475,200 L445,220 L455,220 L485,200 L455,180 Z M445,280 L475,300 L445,320 L455,320 L485,300 L455,280 Z"/>
                                        </Grid>
                                    </Viewbox>
                                    <TextBlock Text="{Binding Pad_ImpulseTriggers_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"
                                               ToolTip="{Binding Pad_ImpulseTriggers_Subtitle, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Command="{Binding ResetImpulseAllCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}"
                                            ToolTip="{Binding Pad_ResetImpulseTriggers, Source={x:Static strings:Strings.Instance}}"/>
                                </DockPanel>

                                <!-- Overall gain -->
                                <controls:SettingRow MinHeight="44">
                                    <TextBlock Text="{Binding Pad_OverallGain, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding ImpulseOverallGain, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding ImpulseOverallGain, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetImpulseOverallGainCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetImpulseOverallGain, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <!-- Trigger motor activity, live: a bar for each
                                     trigger motor, ember for what reaches the
                                     device. The number is each bar's tooltip. -->
                                <controls:SettingRow MinHeight="44">
                                    <TextBlock Text="{Binding Pad_ImpulseTriggers_MotorActivity, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Grid controls:SettingRow.Fills="True" MaxWidth="420" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*" MinWidth="24"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*" MinWidth="24"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Pad_ImpulseTriggers_LeftTrigger, Source={x:Static strings:Strings.Instance}}"
                                                   FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Grid Grid.Column="1" VerticalAlignment="Center" Background="Transparent"
                                              ToolTip="{Binding DeviceLeftTriggerMotorDisplay, Mode=OneWay, StringFormat=P0}">
                                            <ProgressBar Value="{Binding DeviceLeftTriggerMotorDisplay, Mode=OneWay}"
                                                         Minimum="0" Maximum="1"
                                                         Style="{StaticResource ActivityBar}"
                                                         AutomationProperties.Name="{Binding Pad_ImpulseTriggers_LeftTrigger, Source={x:Static strings:Strings.Instance}}"/>
                                        </Grid>
                                        <TextBlock Grid.Column="2" Text="{Binding Pad_ImpulseTriggers_RightTrigger, Source={x:Static strings:Strings.Instance}}"
                                                   FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   VerticalAlignment="Center" Margin="10,0,10,0"/>
                                        <Grid Grid.Column="3" VerticalAlignment="Center" Background="Transparent"
                                              ToolTip="{Binding DeviceRightTriggerMotorDisplay, Mode=OneWay, StringFormat=P0}">
                                            <ProgressBar Value="{Binding DeviceRightTriggerMotorDisplay, Mode=OneWay}"
                                                         Minimum="0" Maximum="1"
                                                         Style="{StaticResource ActivityBar}"
                                                         AutomationProperties.Name="{Binding Pad_ImpulseTriggers_RightTrigger, Source={x:Static strings:Strings.Instance}}"/>
                                        </Grid>
                                    </Grid>
                                </controls:SettingRow>

                                <!-- More (#574): the settings fewer people change, opened in place. -->
                                <controls:MoreRow x:Name="ImpulseTriggersMore" StateKey="Pad.Rumble.ImpulseTriggers.More"
                                                  AutomationProperties.AutomationId="Pad_More_ImpulseTriggers"
                                                  Header="{Binding Common_More, Source={x:Static strings:Strings.Instance}}"
                                                  Hint="{Binding Pad_More_ImpulseTriggers, Source={x:Static strings:Strings.Instance}}">
                                    <StackPanel>
                                        <!-- Left trigger, with its test at the row's end -->
                                        <controls:SettingRow MinHeight="44">
                                            <TextBlock Text="{Binding Pad_ImpulseTriggers_LeftTrigger, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                            <Slider Value="{Binding ImpulseLeftStrength, Mode=TwoWay}"
                                                    Style="{StaticResource DzSlider}"/>
                                            <TextBox Text="{Binding ImpulseLeftStrength, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource DzValueEdit}"/>
                                            <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                            <ui:Button Command="{Binding ResetImpulseLeftCommand}" Style="{StaticResource ResetButton}"
                                                    ToolTip="{Binding Pad_ResetImpulseLeft, Source={x:Static strings:Strings.Instance}}"/>
                                            <Button Content="{Binding Pad_RumbleAudio_Test, Source={x:Static strings:Strings.Instance}}"
                                                    DockPanel.Dock="Right" Style="{StaticResource QuietPlainButton}"
                                                    MinHeight="30" Padding="10,0" FontSize="13" VerticalAlignment="Center"
                                                    AutomationProperties.AutomationId="Pad_TestLeftImpulseTrigger"
                                                    AutomationProperties.Name="{Binding Pad_ImpulseTriggers_TestLeftTrigger, Source={x:Static strings:Strings.Instance}}"
                                                    ToolTip="{Binding Pad_ImpulseTriggers_TestLeftTrigger, Source={x:Static strings:Strings.Instance}}"
                                                    Command="{Binding TestLeftImpulseTriggerCommand}"/>
                                        </controls:SettingRow>

                                        <!-- Right trigger -->
                                        <controls:SettingRow MinHeight="44">
                                            <TextBlock Text="{Binding Pad_ImpulseTriggers_RightTrigger, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                            <Slider Value="{Binding ImpulseRightStrength, Mode=TwoWay}"
                                                    Style="{StaticResource DzSlider}"/>
                                            <TextBox Text="{Binding ImpulseRightStrength, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource DzValueEdit}"/>
                                            <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                            <ui:Button Command="{Binding ResetImpulseRightCommand}" Style="{StaticResource ResetButton}"
                                                    ToolTip="{Binding Pad_ResetImpulseRight, Source={x:Static strings:Strings.Instance}}"/>
                                            <Button Content="{Binding Pad_RumbleAudio_Test, Source={x:Static strings:Strings.Instance}}"
                                                    DockPanel.Dock="Right" Style="{StaticResource QuietPlainButton}"
                                                    MinHeight="30" Padding="10,0" FontSize="13" VerticalAlignment="Center"
                                                    AutomationProperties.AutomationId="Pad_TestRightImpulseTrigger"
                                                    AutomationProperties.Name="{Binding Pad_ImpulseTriggers_TestRightTrigger, Source={x:Static strings:Strings.Instance}}"
                                                    ToolTip="{Binding Pad_ImpulseTriggers_TestRightTrigger, Source={x:Static strings:Strings.Instance}}"
                                                    Command="{Binding TestRightImpulseTriggerCommand}"/>
                                        </controls:SettingRow>

                                        <!-- Swap trigger motors -->
                                        <controls:SettingRow MinHeight="44">
                                            <TextBlock Text="{Binding Pad_ImpulseTriggers_SwapTriggers, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                            <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{Binding Pad_ImpulseTriggers_SwapTriggers, Source={x:Static strings:Strings.Instance}}"
                                                      IsChecked="{Binding ImpulseSwapTriggers, Mode=TwoWay}"/>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="ImpulseSwapTriggers" SettingLabel="{Binding Pad_ImpulseTriggers_SwapTriggers, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_PadViewModel_ImpulseSwapTriggers_10319"/>
                                        </controls:SettingRow>

                                        <!-- Selective adaptive-trigger translation (#271 item 3) -->
                                        <controls:SettingRow MinHeight="44">
                                            <TextBlock Text="{Binding Pad_ImpulseTriggers_AtTranslate, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                            <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{Binding Pad_ImpulseTriggers_AtTranslate, Source={x:Static strings:Strings.Instance}}"
                                                      ToolTip="{Binding Pad_ImpulseTriggers_AtTranslate_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                      IsChecked="{Binding AtVibrationToImpulse, Mode=TwoWay}"/>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="AtVibrationToImpulse" SettingLabel="{Binding Pad_ImpulseTriggers_AtTranslate, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_PadViewModel_AtVibrationToImpulse_10325"/>
                                        </controls:SettingRow>

                                        <!-- Constant Trigger Force: its switch, and the
                                             force on each trigger under it while it is
                                             on. What it does is the tooltip of the
                                             switch and its label. -->
                                        <StackPanel x:Name="ConstantTriggerForceRows">
                                            <controls:SettingRow MinHeight="44">
                                                <TextBlock Text="{Binding Pad_ConstantTriggerForce_Toggle, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                                           ToolTip="{Binding Pad_ConstantTriggerForce_Description, Source={x:Static strings:Strings.Instance}}"/>
                                                <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{Binding Pad_ConstantTriggerForce_Toggle, Source={x:Static strings:Strings.Instance}}"
                                                          ToolTip="{Binding Pad_ConstantTriggerForce_Description, Source={x:Static strings:Strings.Instance}}"
                                                          IsChecked="{Binding ConstantTriggerForceEnabled, Mode=TwoWay}"/>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="ConstantTriggerForceEnabled" SettingLabel="{Binding Pad_ConstantTriggerForce_Toggle, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_PadViewModel_ConstantTriggerForceEnabled_10404"/>
                                            </controls:SettingRow>
                                            <StackPanel Visibility="{Binding ConstantTriggerForceEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <controls:SettingRow MinHeight="44">
                                                    <TextBlock Text="{Binding Pad_ConstantTriggerForce_Left, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzSubLabel}"/>
                                                    <Slider Value="{Binding ConstantTriggerForceLeft, Mode=TwoWay}"
                                                            Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                                                            Style="{StaticResource DzSlider}"/>
                                                    <TextBox Text="{Binding ConstantTriggerForceLeft, Mode=TwoWay, StringFormat=F2, UpdateSourceTrigger=LostFocus}"
                                                             Style="{StaticResource DzValueEdit}"/>
                                                    <ui:Button Command="{Binding ResetConstantTriggerLeftCommand}" Style="{StaticResource ResetButton}"
                                                            ToolTip="{Binding Pad_ResetConstantTriggerLeft, Source={x:Static strings:Strings.Instance}}"/>
                                                </controls:SettingRow>
                                                <controls:SettingRow MinHeight="44">
                                                    <TextBlock Text="{Binding Pad_ConstantTriggerForce_Right, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzSubLabel}"/>
                                                    <Slider Value="{Binding ConstantTriggerForceRight, Mode=TwoWay}"
                                                            Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                                                            Style="{StaticResource DzSlider}"/>
                                                    <TextBox Text="{Binding ConstantTriggerForceRight, Mode=TwoWay, StringFormat=F2, UpdateSourceTrigger=LostFocus}"
                                                             Style="{StaticResource DzValueEdit}"/>
                                                    <ui:Button Command="{Binding ResetConstantTriggerRightCommand}" Style="{StaticResource ResetButton}"
                                                            ToolTip="{Binding Pad_ResetConstantTriggerRight, Source={x:Static strings:Strings.Instance}}"/>
                                                </controls:SettingRow>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </controls:MoreRow>
                            </StackPanel>
                        </Border>

                        <controls:FoldList>
                        <!-- ── Audio Bass Trigger Rumble section ── -->
                        <controls:FoldCard x:Name="AudioTriggerRumbleFoldCard" StateKey="Pad.Rumble.AudioTriggers"
                                           Header="{Binding Pad_AudioTriggerRumble_Header, Source={x:Static strings:Strings.Instance}}"
                                           Hint="{Binding Pad_AudioTriggerRumble_FoldHint, Source={x:Static strings:Strings.Instance}}"
                                           Description="{Binding Pad_AudioTriggerRumble_Description, Source={x:Static strings:Strings.Instance}}">
                            <controls:FoldCard.HeaderAction>
                                <ui:Button Command="{Binding ResetAudioTriggerRumbleAllCommand}" Style="{StaticResource ResetAllButton}"
                                        Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}"
                                        ToolTip="{Binding Pad_ResetAudioTriggerRumble, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:FoldCard.HeaderAction>
                            <controls:FoldCard.Summary>
                                <MultiBinding Converter="{StaticResource OnOffTextConverter}">
                                    <Binding Path="AudioRumbleTriggersEnabled"/>
                                    <Binding Path="Common_On" Source="{x:Static strings:Strings.Instance}"/>
                                    <Binding Path="Common_Off" Source="{x:Static strings:Strings.Instance}"/>
                                </MultiBinding>
                            </controls:FoldCard.Summary>
                            <StackPanel>

                                <controls:SettingRow MinHeight="44">
                                    <TextBlock Text="{Binding Pad_AudioTriggerRumble_Toggle, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <CheckBox Style="{StaticResource SwitchCheckBox}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_AudioTriggerRumble_Toggle, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding AudioRumbleTriggersEnabled, Mode=TwoWay}"/>
                                    <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="AudioRumbleTriggersEnabled" SettingLabel="{Binding Pad_AudioTriggerRumble_Toggle, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_PadViewModel_AudioRumbleTriggersEnabled_10447"/>
                                </controls:SettingRow>

                                <controls:SettingRow MinHeight="44" IsEnabled="{Binding AudioRumbleTriggersEnabled}">
                                    <TextBlock Text="{Binding Pad_AudioTriggerRumble_Sensitivity, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding AudioRumbleTriggersSensitivity, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"
                                            Minimum="1" Maximum="20" TickFrequency="0.1"/>
                                    <TextBox Text="{Binding AudioRumbleTriggersSensitivity, Mode=TwoWay, StringFormat=F1, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <ui:Button Command="{Binding ResetAudioTriggerSensitivityCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetAudioTriggerSensitivity, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <controls:SettingRow MinHeight="44" IsEnabled="{Binding AudioRumbleTriggersEnabled}">
                                    <TextBlock Text="{Binding Pad_AudioTriggerRumble_Cutoff, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding AudioRumbleTriggersCutoffHz, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"
                                            Minimum="20" Maximum="200" TickFrequency="1"/>
                                    <TextBox Text="{Binding AudioRumbleTriggersCutoffHz, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <ui:Button Command="{Binding ResetAudioTriggerCutoffCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetAudioTriggerCutoff, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <controls:SettingRow MinHeight="44" IsEnabled="{Binding AudioRumbleTriggersEnabled}">
                                    <TextBlock Text="{Binding Pad_AudioTriggerRumble_LeftTrigger, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding AudioRumbleLeftTrigger, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding AudioRumbleLeftTrigger, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetAudioLeftTriggerCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetAudioLeftTrigger, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <controls:SettingRow MinHeight="44" IsEnabled="{Binding AudioRumbleTriggersEnabled}">
                                    <TextBlock Text="{Binding Pad_AudioTriggerRumble_RightTrigger, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding AudioRumbleRightTrigger, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding AudioRumbleRightTrigger, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetAudioRightTriggerCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetAudioRightTrigger, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" IsEnabled="{Binding AudioRumbleTriggersEnabled}">
                                    <TextBlock Text="{Binding Pad_AudioTriggerRumble_Level, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ProgressBar Value="{Binding AudioRumbleTriggersLevelMeter, Mode=OneWay}"
                                                 Minimum="0" Maximum="1"
                                                 Width="320" Height="10" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource EmberHotBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </controls:FoldCard>
                        </controls:FoldList>
                    </StackPanel>
                    </GroupBox>

            <!-- ══════════════════════════════════════
                 TAB 6: ADAPTIVE TRIGGERS
                 (visible only for DualSense / DualSense Edge slots)
                 ══════════════════════════════════════ -->
                    <GroupBox x:Name="TabAdaptiveTriggers" Visibility="Collapsed" Style="{StaticResource BareGroupBox}"
                              AutomationProperties.AutomationId="TabAdaptiveTriggers"
                              AutomationProperties.Name="{Binding Pad_AdaptiveTriggers_Header, Source={x:Static strings:Strings.Instance}}">
                    <StackPanel>
                        <!-- A DSX game mod setting these triggers (#529), in the
                             ember of the Force Feedback tab's route line. -->
                        <TextBlock Text="{Binding GameModTriggersLine}" Visibility="{Binding GameModTriggersLine, Converter={StaticResource StringToVisibility}}"
                                   Foreground="{DynamicResource EmberBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- Adaptive Triggers: one card for the two triggers
                             (#574). Each trigger is a row with its effect, and
                             the effect's settings sit under it while it has
                             one. Reset All sets both triggers back. -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                    <Viewbox Width="18" Height="18" Stretch="Uniform"
                                             VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Grid Width="512" Height="512">
                                            <Path FlowDirection="LeftToRight" Fill="{DynamicResource EmberBrush}"
                                                  Data="{StaticResource ZackslyTriggerOuterBodyGeometry}"/>
                                            <Path FlowDirection="LeftToRight" Fill="{DynamicResource EmberBrush}"
                                                  Data="M445,180 L475,200 L445,220 L455,220 L485,200 L455,180 Z M445,280 L475,300 L445,320 L455,320 L485,300 L455,280 Z"/>
                                        </Grid>
                                    </Viewbox>
                                    <TextBlock Text="{Binding Pad_AdaptiveTriggers_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"
                                               ToolTip="{Binding Pad_AdaptiveTriggers_Subtitle, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Command="{Binding DeviceConfig.ResetAdaptiveTriggersCommand}" Style="{StaticResource ResetAllButton}"
                                               Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}">
                                        <ui:Button.ToolTip>
                                            <MultiBinding Converter="{StaticResource FormatTextConverter}">
                                                <Binding Path="Pad_AdaptiveTriggers_Header" Source="{x:Static strings:Strings.Instance}"/>
                                                <Binding Path="Pad_ResetSection_Format" Source="{x:Static strings:Strings.Instance}"/>
                                            </MultiBinding>
                                        </ui:Button.ToolTip>
                                    </ui:Button>
                                </DockPanel>

                                <!-- Left trigger: its effect, picked from the mode
                                     cards the drop-down opens, with the effect's
                                     live graph beside the box while it has one.
                                     The graph carries a cold marker at the
                                     physical trigger's pull. -->
                                <controls:SettingRow MinHeight="44">
                                    <TextBlock Text="{Binding Pad_LeftTrigger, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ComboBox x:Name="LeftTriggerModePicker" Style="{StaticResource AtModePicker}"
                                              SelectedValuePath="Tag"
                                              SelectedValue="{Binding DeviceConfig.LeftTriggerMode, Mode=TwoWay}"
                                              AutomationProperties.AutomationId="AT_LeftTriggerMode"
                                              AutomationProperties.Name="{Binding Pad_LeftTrigger, Source={x:Static strings:Strings.Instance}}"
                                              ToolTip="{Binding Pad_TriggerMode, Source={x:Static strings:Strings.Instance}}">
                                            <ComboBoxItem Tag="{x:Static vm:AdaptiveTriggerMode.Off}"
                                                          TextSearch.Text="{Binding Pad_AT_Off, Source={x:Static strings:Strings.Instance}, Mode=OneWay}"
                                                          AutomationProperties.Name="{Binding Pad_AT_Off, Source={x:Static strings:Strings.Instance}}"
                                                          ToolTip="{Binding Pad_AT_Off_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Pad_AT_Off, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource AtModeCardName}"/>
                                                    <viewControls:TriggerEffectGraph Height="40" Margin="0,6,0,0" IsCompact="True"
                                                        Mode="Off"
                                                        LiveInput="{Binding DeviceLeftTrigger}"
                                                        ShowLiveMarker="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem Tag="{x:Static vm:AdaptiveTriggerMode.Feedback}"
                                                          TextSearch.Text="{Binding Pad_AT_Feedback, Source={x:Static strings:Strings.Instance}, Mode=OneWay}"
                                                          AutomationProperties.Name="{Binding Pad_AT_Feedback, Source={x:Static strings:Strings.Instance}}"
                                                          ToolTip="{Binding Pad_AT_Feedback_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Pad_AT_Feedback, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource AtModeCardName}"/>
                                                    <viewControls:TriggerEffectGraph Height="40" Margin="0,6,0,0" IsCompact="True"
                                                        Mode="Feedback"
                                                        StartPosition="{Binding DeviceConfig.LeftStartPosition}"
                                                        EndPosition="{Binding DeviceConfig.LeftEndPosition}"
                                                        Strength="{Binding DeviceConfig.LeftStrength}"
                                                        Frequency="{Binding DeviceConfig.LeftFrequency}"
                                                        LiveInput="{Binding DeviceLeftTrigger}"
                                                        ShowLiveMarker="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem Tag="{x:Static vm:AdaptiveTriggerMode.Weapon}"
                                                          TextSearch.Text="{Binding Pad_AT_Weapon, Source={x:Static strings:Strings.Instance}, Mode=OneWay}"
                                                          AutomationProperties.Name="{Binding Pad_AT_Weapon, Source={x:Static strings:Strings.Instance}}"
                                                          ToolTip="{Binding Pad_AT_Weapon_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Pad_AT_Weapon, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource AtModeCardName}"/>
                                                    <viewControls:TriggerEffectGraph Height="40" Margin="0,6,0,0" IsCompact="True"
                                                        Mode="Weapon"
                                                        StartPosition="{Binding DeviceConfig.LeftStartPosition}"
                                                        EndPosition="{Binding DeviceConfig.LeftEndPosition}"
                                                        Strength="{Binding DeviceConfig.LeftStrength}"
                                                        Frequency="{Binding DeviceConfig.LeftFrequency}"
                                                        LiveInput="{Binding DeviceLeftTrigger}"
                                                        ShowLiveMarker="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"/>
                                                </StackPanel>
