<ui:FluentWindow x:Class="PadForge.MainWindow"
    FontFamily="{StaticResource BodyFontFamily}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:PadForge"
        xmlns:views="clr-namespace:PadForge.Views"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Title="{Binding Title}"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        Stylus.IsPressAndHoldEnabled="False"
        Stylus.IsTapFeedbackEnabled="False"
        Stylus.IsTouchFeedbackEnabled="False"
        WindowStartupLocation="Manual">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Ember steel ground (#175). Sits over the Mica backdrop and under
             all content: near-black steel with a faint ember wash top-right
             and a cold wash on the left. Dark theme only. UpdateSteelLayer
             collapses it in Light. -->
        <Grid x:Name="SteelLayer" Grid.RowSpan="3" IsHitTestVisible="False">
            <Border Background="#F20B0E14"/>
            <Border>
                <Border.Background>
                    <RadialGradientBrush GradientOrigin="0.78,0" Center="0.78,0" RadiusX="0.55" RadiusY="0.45">
                        <GradientStop Color="#12FF6B2C" Offset="0"/>
                        <GradientStop Color="#00FF6B2C" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Border>
                <Border.Background>
                    <RadialGradientBrush GradientOrigin="0.06,0.25" Center="0.06,0.25" RadiusX="0.5" RadiusY="0.4">
                        <GradientStop Color="#0C58B6E4" Offset="0"/>
                        <GradientStop Color="#0058B6E4" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <!-- App branding bar. Hamburger on left, PadForge icon + name.
             TitleBar provides native min/max/close with Snap Layout support. -->
        <Grid x:Name="AppBrandingBar" Grid.Row="0" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="PaneToggleBtn" Grid.Column="0" Click="PaneToggleBtn_Click"
                    Width="48" Height="48"
                    Background="Transparent"
                    BorderThickness="0" Padding="0"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
            </Button>
            <ui:TitleBar x:Name="AppTitleBar" Grid.Column="1"
                         CloseClicked="TitleBar_CloseClicked"
                         MaximizeClicked="TitleBar_MaximizeClicked"
                         ForceShutdown="False">
                <ui:TitleBar.Header>
                    <Border x:Name="AppBrandingBorder" Padding="12,0"
                            Background="Transparent" MouseLeftButtonDown="BrandingBar_MouseDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="/Resources/PadForge-icon.png" Width="20" Height="20"
                                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                            <TextBlock Text="PadForge" FontSize="12"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>
                </ui:TitleBar.Header>
                <ui:TitleBar.TrailingContent>
                    <Button x:Name="FullScreenBtn" Click="FullScreenBtn_Click" Width="44" Height="30"
                            Background="Transparent" BorderThickness="0" Padding="0"
                            VerticalAlignment="Top" Margin="0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="LayoutRoot" Property="Background"
                                                            Value="{Binding ButtonsBackground, ElementName=AppTitleBar}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <TextBlock x:Name="FullScreenIcon" Text="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{Binding ButtonsForeground, ElementName=AppTitleBar}"/>
                    </Button>
                </ui:TitleBar.TrailingContent>
            </ui:TitleBar>
        </Grid>

        <!-- ═══════════════════════════════════════════
             Navigation View (left pane) with content overlay
             ═══════════════════════════════════════════ -->
        <ui:NavigationView x:Name="NavView" Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False"
                           AlwaysShowHeader="False"
                           CompactPaneLength="48"
                           OpenPaneLength="223">

            <ui:NavigationView.Resources>
                <Style TargetType="ui:NavigationViewItem">
                    <Setter Property="Height" Value="48"/>
                    <Setter Property="FontSize" Value="14"/>
                    <!-- Rail rests in the steel-blue secondary; selection
                         brings the accent forward (#175). -->
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                </Style>
            </ui:NavigationView.Resources>

            <!-- MenuItems built programmatically in code-behind (BuildNavigationItems) -->

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItemSeparator/>
                <ui:NavigationViewItem x:Name="NavSettings" Content="{Binding Settings_Title, Source={x:Static strings:Strings.Instance}}" Tag="Settings">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavAbout" Content="{Binding About_Title, Source={x:Static strings:Strings.Instance}}" Tag="About">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE946;"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <views:DashboardPage x:Name="DashboardPageView" Visibility="Visible"/>
                    <views:PadPage x:Name="PadPageView" Visibility="Collapsed"/>
                    <views:DevicesPage x:Name="DevicesPageView" Visibility="Collapsed"/>
                    <views:SettingsPage x:Name="SettingsPageView" Visibility="Collapsed"/>
                    <views:ProfilesPage x:Name="ProfilesPageView" Visibility="Collapsed"/>
                    <views:AboutPage x:Name="AboutPageView" Visibility="Collapsed"/>
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <!-- ═══════════════════════════════════════════
             Status Bar
             ═══════════════════════════════════════════ -->
        <Border x:Name="StatusBarBorder" Grid.Row="2"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Instrument line (#175): live counts and rate in cold
                     telemetry mono, engine state as the flame. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="{Binding ConnectedDeviceCount, Mode=OneWay}"
                               FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12"
                               Foreground="{DynamicResource ColdBrush}"/>
                    <TextBlock Text="{Binding Main_DevicesSuffix, Source={x:Static strings:Strings.Instance}}"
                               FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Margin="16,0"
                           FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12"
                           Foreground="{DynamicResource ColdBrush}"
                           Text="{Binding PollingFrequency, StringFormat='{}{0:F0} Hz', Mode=OneWay}"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="16,0,0,0">
                    <Path Data="{StaticResource FlameOuterGeometry}"
                          Width="12" Height="12" Stretch="Uniform"
                          VerticalAlignment="Center" Margin="0,0,6,0">
                        <Path.Style>
                            <Style TargetType="Path">
                                <!-- Cold default: outline only. -->
                                <Setter Property="Fill" Value="Transparent"/>
                                <Setter Property="Stroke" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <Setter Property="StrokeThickness" Value="1.2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Dashboard.EngineStateKey}" Value="Running">
                                        <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                        <Setter Property="Stroke" Value="{x:Null}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Dashboard.EngineStateKey}" Value="Idle">
                                        <Setter Property="Fill" Value="#FFFFC107"/>
                                        <Setter Property="Stroke" Value="{x:Null}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Dashboard.EngineStateKey}" Value="Stopping">
                                        <Setter Property="Fill" Value="#FFFFC107"/>
                                        <Setter Property="Stroke" Value="{x:Null}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <TextBlock Text="{Binding EngineStatusText}"
                               FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Dashboard.EngineStateKey}" Value="Running">
                                        <Setter Property="Foreground" Value="{DynamicResource EmberHotBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════
             Driver operation overlay
             ═══════════════════════════════════════════ -->
        <Grid x:Name="DriverOverlay"
              Grid.RowSpan="3"
              Visibility="Collapsed"
              Panel.ZIndex="1000">
            <Border Background="#80000000"/>
            <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    CornerRadius="8" Padding="32,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="280">
                <StackPanel HorizontalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True"
                                     Width="40" Height="40"
                                     Margin="0,0,0,16"/>
                    <TextBlock x:Name="DriverOverlayText"
                               FontSize="16" HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════
             First-run welcome + spotlight tour (#175).
             Shown when the first-run marker file is absent; re-runnable
             from Settings. The dim layer swallows clicks; the highlight
             border and tip card are positioned in code-behind.
             ═══════════════════════════════════════════ -->
        <Grid x:Name="FirstRunOverlay"
              Grid.RowSpan="3"
              Visibility="Collapsed"
              Panel.ZIndex="900">
            <Border Background="#D9070A0E"/>

            <Border x:Name="WelcomePanel"
                    Background="{DynamicResource SteelCardBrush}"
                    BorderBrush="{DynamicResource SteelLineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="40,32"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="470">
                <StackPanel HorizontalAlignment="Center">
                    <Path Data="{StaticResource FlameOuterGeometry}"
                          Width="46" Height="46" Stretch="Uniform"
                          Fill="{DynamicResource EmberBrush}" HorizontalAlignment="Center">
                        <Path.Effect>
                            <DropShadowEffect Color="#FF6B2C" BlurRadius="26" ShadowDepth="0" Opacity="0.6"/>
                        </Path.Effect>
                    </Path>
                    <TextBlock Text="{Binding FirstRun_Title, Source={x:Static strings:Strings.Instance}}"
                               FontSize="24" FontWeight="SemiBold" Foreground="#E9EDF4"
                               HorizontalAlignment="Center" Margin="0,16,0,6"/>
                    <TextBlock Text="{Binding FirstRun_Body, Source={x:Static strings:Strings.Instance}}"
                               Foreground="#94A3BD" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="360"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                        <ui:Button Appearance="Primary"
                                   Content="{Binding FirstRun_Begin, Source={x:Static strings:Strings.Instance}}"
                                   Click="FirstRunBegin_Click"/>
                        <Button Content="{Binding FirstRun_Skip, Source={x:Static strings:Strings.Instance}}"
                                Margin="8,0,0,0" Click="FirstRunSkip_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Canvas x:Name="TourCanvas" Visibility="Collapsed">
                <Border x:Name="TourHighlight"
                        BorderBrush="{DynamicResource EmberBrush}" BorderThickness="2"
                        CornerRadius="8" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="#FF6B2C" BlurRadius="18" ShadowDepth="0" Opacity="0.5"/>
                    </Border.Effect>
                </Border>
                <Border x:Name="TourTip"
                        Background="{DynamicResource SteelRaisedBrush}"
                        BorderBrush="{DynamicResource SteelLineBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="16" Width="320">
                    <StackPanel>
                        <TextBlock x:Name="TourStepLabel"
                                   FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11"
                                   Foreground="{DynamicResource EmberHotBrush}"/>
                        <TextBlock x:Name="TourTitle" FontWeight="SemiBold" FontSize="15"
                                   Foreground="#E9EDF4" Margin="0,4,0,2"/>
                        <TextBlock x:Name="TourBody" TextWrapping="Wrap" FontSize="13"
                                   Foreground="#94A3BD"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <ui:Button x:Name="TourNextBtn" Appearance="Primary"
                                       Content="{Binding FirstRun_Next, Source={x:Static strings:Strings.Instance}}"
                                       Click="TourNext_Click"/>
                            <Button Content="{Binding FirstRun_Skip, Source={x:Static strings:Strings.Instance}}"
                                    Margin="8,0,0,0" Click="FirstRunSkip_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Canvas>
        </Grid>

        <!-- ═══════════════════════════════════════════
             Shutdown overlay
             ═══════════════════════════════════════════ -->
        <Grid x:Name="ShutdownOverlay"
              Grid.RowSpan="3"
              Visibility="Collapsed"
              Panel.ZIndex="1001">
            <Border Background="#CC000000"/>
            <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    CornerRadius="8" Padding="32,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="280">
                <StackPanel HorizontalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True"
                                     Width="40" Height="40"
                                     Margin="0,0,0,16"/>
                    <TextBlock FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Text="{Binding Main_ShuttingDown, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock x:Name="ShutdownOverlayText"
                               FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,4" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════
             Startup overlay — shown while the orphan-sweep
             task (App.OrphanSweepTask) is still running at
             launch. Hidden automatically when the task
             completes.
             ═══════════════════════════════════════════ -->
        <Grid x:Name="StartupOverlay"
              Grid.RowSpan="3"
              Visibility="Collapsed"
              Panel.ZIndex="1001">
            <Border Background="#CC000000"/>
            <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    CornerRadius="8" Padding="32,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="320">
                <StackPanel HorizontalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True"
                                     Width="40" Height="40"
                                     Margin="0,0,0,16"/>
                    <TextBlock FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Text="{Binding Main_StartingUp, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,6,0,4" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Text="{Binding Main_CleaningPreviousSession, Source={x:Static strings:Strings.Instance}}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
