<UserControl x:Class="PadForge.Views.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:strings="clr-namespace:PadForge.Resources.Strings"
             xmlns:common="clr-namespace:PadForge.Common"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="po">

    <UserControl.Resources>
        <!-- Hover glow (#175): hover color changes carry a hue-matched
             bloom. Every hover shift on this page is neutral steel, so the
             glow is the faint ember signature. Frozen shared static effect,
             set from triggers only, never animated. -->
        <DropShadowEffect x:Key="NeutralHoverGlow" po:Freeze="True" Color="#FF6B2C" ShadowDepth="0" BlurRadius="10" Opacity="0.30"/>
        <!-- Hover glow sweep (#175): stock-chrome classes bloom in the same
             moment their hover fill shifts. BasedOn the WPF-UI defaults so
             theme brushes survive. -->
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <!-- MinHeight mirrors the App.xaml implicit Button style (32px
                 grid), which this page-local implicit replaces. -->
            <Setter Property="MinHeight" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
            <!-- First four setters mirror the App.xaml implicit ComboBox
                 style, which this page-local implicit replaces. -->
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible"/>
            <Setter Property="MaxDropDownHeight" Value="200"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Padding="24,0">
        <StackPanel Margin="0,16,0,16">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Profiles_Title, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource TitleTextBlockStyle}" FontFamily="{StaticResource DisplayFontFamily}" FontWeight="650" FontSize="26"/>
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Profiles_Management, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource CardTitle}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Profiles_Description, Source={x:Static strings:Strings.Instance}}"
                               Style="{StaticResource CardDescription}" Margin="0,0,0,12"/>
                    <CheckBox Content="{Binding Profiles_AutoSwitch, Source={x:Static strings:Strings.Instance}}"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              IsChecked="{Binding EnableAutoProfileSwitching}" Margin="0,0,0,8"/>

                    <!-- Live foreground readout (#175 item 8): what the
                         monitor currently sees, fed at 1 s from the UI
                         timer. Rendered only while auto-switching is on
                         (the service does not track otherwise). Cold mono
                         filename. Flame + ember text while it matches a
                         profile. The FOREGROUND token is a locale-neutral
                         mono literal, like the status bar's "Hz". -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                Visibility="{Binding EnableAutoProfileSwitching, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="FOREGROUND"
                                   FontFamily="{StaticResource TelemetryFontFamily}"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColdMutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Path Data="{StaticResource FlameOuterGeometry}"
                              Fill="{DynamicResource EmberBrush}"
                              Width="11" Height="13" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,5,0"
                              Visibility="{Binding IsForegroundMatched, Converter={StaticResource BoolToVisibilityConverter}}">
                            <!-- Rendered only while matched, so the glow is static (#175 glow sweep). -->
                            <Path.Effect>
                                <DropShadowEffect Color="#FF6B2C" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                            </Path.Effect>
                        </Path>
                        <TextBlock Text="{Binding ForegroundExeName}"
                                   FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource ColdBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsForegroundMatched}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource EmberBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{Binding Profiles_ActiveProfile, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <!-- The active profile burns (#175): lit flame marks
                             which profile currently drives the forge. -->
                        <Path Data="{StaticResource FlameOuterGeometry}"
                              Fill="{DynamicResource EmberBrush}"
                              Width="11" Height="13" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,5,0">
                            <!-- Always lit, so the glow is static (#175 glow sweep). -->
                            <Path.Effect>
                                <DropShadowEffect Color="#FF6B2C" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                            </Path.Effect>
                        </Path>
                        <TextBlock Text="{Binding ActiveProfileInfo}" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Profile card grid (#175 item 8): the text list became
                         steel cards on a wrap grid. Same ListBox contract as
                         before (SelectedItem binding, double-click load). Only
                         the panel and the item visuals changed. The host Grid
                         doubles as the drop zone for .pfprofile imports and
                         carries the cold dashed cue while a valid drag is over. -->
                    <Grid Margin="0,0,0,8" AllowDrop="True"
                          DragEnter="ProfileList_DragEnter"
                          DragOver="ProfileList_DragOver"
                          DragLeave="ProfileList_DragLeave"
                          Drop="ProfileList_Drop">
                        <ListBox x:Name="ProfileListBox"
                                 ItemsSource="{Binding ProfileItems}"
                                 SelectedItem="{Binding SelectedProfile}"
                                 MinHeight="60" MaxHeight="420"
                                 AllowDrop="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="ProfileList_MouseDoubleClick">
                            <!-- Cards wrap at the card width. Horizontal scroll is
                                 disabled so the WrapPanel actually wraps. -->
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <!-- Inert container (user report 2026-07-05): the stock
                                 WPF-UI item template paints an accent slab and flips
                                 Foreground on selection. Those are template triggers,
                                 which outrank derived-style setters, so the container
                                 is retemplated to a bare ContentPresenter (Devices
                                 roster precedent). It stays hit-testable and
                                 selectable; selection reads as the ember glow AURA
                                 behind the card (the slot-card glow-host pattern,
                                 user report 2026-07-05: the aura, not the card,
                                 pulsates). Hover keeps the faint ember
                                 bloom; the active card's lit flame glow lives on a
                                 Path inside the ItemTemplate, a different element,
                                 so there is no Effect fight. -->
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- 8px item margin: aura room, same reason as the
                                         slot cards' clip fix. The glow HOST behind the
                                         card carries the ember effect and only its plain
                                         Opacity animates (slot-card pattern, never an
                                         Effect animation from triggers), so selection
                                         reads as a breathing aura around the card, not
                                         a shading change of the card itself. -->
                                    <Grid Margin="8">
                                        <!-- Opacity lives in the STYLE, not on the element:
                                             the launch-time selection arrives with the
                                             trigger already true, and EnterActions do not
                                             fire for initially-true conditions (user report
                                             2026-07-05: no aura until reselect). The plain
                                             IsSelected setter guarantees presence from the
                                             first frame; the storyboards layer the breathe
                                             on top for every real transition. -->
                                        <Border CornerRadius="8" IsHitTestVisible="False"
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#FF6B2C" BlurRadius="30" ShadowDepth="0" Opacity="0.55"/>
                                            </Border.Effect>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Opacity" Value="0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Opacity" Value="0.74"/>
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                                                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <MultiDataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <!-- Artifact breathe: 3.2s ease-in-out aura pulse. -->
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         From="0.55" To="1.0" Duration="0:0:1.6"
                                                                                         AutoReverse="True" RepeatBehavior="Forever">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <SineEase EasingMode="EaseInOut"/>
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </MultiDataTrigger.EnterActions>
                                                            <MultiDataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:1.2">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseIn"/>
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </MultiDataTrigger.ExitActions>
                                                        </MultiDataTrigger>
                                                        <!-- Reduced motion needs no extra trigger: the
                                                             IsSelected setter above holds the static
                                                             aura, and the breathe trigger never enters
                                                             while ClientAreaAnimation is off. -->
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <!-- Card root: steel rim, uniform size so the grid
                                             reads as a set. Hover lift (#175) is the
                                             element-level transform on the template root;
                                             the container style's glow stays on the
                                             ListBoxItem. Only the transform animates here.
                                             The active ember edge is static setters. -->
                                        <Border Width="250" Height="116"
                                                CornerRadius="8" BorderThickness="1" Padding="10,8">
                                        <Border.RenderTransform>
                                            <TranslateTransform/>
                                        </Border.RenderTransform>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <!-- Steel rim/fill live in the style, not on the
                                                     element, so the IsActive trigger setters can
                                                     override them (local values would win). -->
                                                <Setter Property="BorderBrush" Value="{DynamicResource SteelLineSoftBrush}"/>
                                                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                                                <!-- Rest state sits back (user report 2026-07-05):
                                                     unselected, inactive cards dim to 0.82 so the
                                                     selected and active ones carry the light. -->
                                                <Setter Property="Opacity" Value="0.82"/>
                                                <Style.Triggers>
                                                    <!-- Selection reads as the ember aura on the glow
                                                         host behind this card (user report 2026-07-05),
                                                         so the card itself only wakes to full opacity.
                                                         Declared before the IsActive trigger so ember
                                                         edge setters win when the selected card is
                                                         also the active one. -->
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Opacity" Value="1.0"/>
                                                    </DataTrigger>
                                                    <!-- Ember edge (#175): the card whose profile
                                                         currently drives the forge wears the ember
                                                         rim and tint wash. Static setters only. -->
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#66FF6B2C"/>
                                                        <Setter Property="Background" Value="{DynamicResource EmberTintBrush}"/>
                                                        <Setter Property="Opacity" Value="1.0"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                                     To="-2" Duration="0:0:0.13">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                                     To="0" Duration="0:0:0.25">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseIn"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <!-- Header: flame when active, locally-extracted
                                                 exe icon when the stored path still resolves,
                                                 then the profile name. -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- The active profile burns (#175): lit flame on the
                                                     card currently driving the forge. -->
                                                <Path Data="{StaticResource FlameOuterGeometry}"
                                                      Fill="{DynamicResource EmberBrush}"
                                                      Width="11" Height="13" Stretch="Uniform"
                                                      VerticalAlignment="Center" Margin="0,0,5,0"
                                                      Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <!-- Rendered only when active, so the glow is static (#175 glow sweep). -->
                                                    <Path.Effect>
                                                        <DropShadowEffect Color="#FF6B2C" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                                    </Path.Effect>
                                                </Path>
                                                <!-- Icon collapses when the converter yields null
                                                     (no executables, or the file is gone). -->
                                                <Image Grid.Column="1" Width="20" Height="20"
                                                       Margin="0,0,6,0" VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Source="{Binding FirstExecutablePath, Converter={StaticResource ExeIconConverter}}">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Style.Triggers>
                                                                <Trigger Property="Source" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <!-- Foreground pinned so no container state can
                                                     ever flow a flipped brush into the title. -->
                                                <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}"/>
                                            </Grid>
                                            <!-- Mono exe line: first executable, with the +N
                                                 multi-exe marker in its own non-trimming cell
                                                 so a long name cannot ellipsize it away. Full
                                                 list rides the tooltip. Hidden when none. -->
                                            <DockPanel Margin="0,2,0,0" ToolTip="{Binding Executables}"
                                                       Visibility="{Binding FirstExecutableName, Converter={StaticResource StringToVisibility}}">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ExtraExecutablesSuffix}"
                                                           FontFamily="{StaticResource TelemetryFontFamily}"
                                                           FontSize="11" Margin="4,0,0,0"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Visibility="{Binding ExtraExecutablesSuffix, Converter={StaticResource StringToVisibility}}"/>
                                                <TextBlock Text="{Binding FirstExecutableName}"
                                                           FontFamily="{StaticResource TelemetryFontFamily}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <!-- Slot-loadout chip strip: the five branded count
                                                 badges, unchanged from the old rows. Count
                                                 numerals are mono like every other readout. -->
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <!-- Xbox count badge -->
                                                <Border CornerRadius="8" Padding="7,2" Margin="0,0,4,0"
                                                        BorderThickness="1"
                                                        BorderBrush="{DynamicResource SteelLineSoftBrush}"
                                                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding XboxCount}" Value="0">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
