<Application x:Class="PadForge.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:uictrl="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
             xmlns:conv="clr-namespace:PadForge.Converters"
             xmlns:controls="clr-namespace:PadForge.Controls"
             xmlns:strings="clr-namespace:PadForge.Resources.Strings"
>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />

                <!-- Font faces (#175 typography): merged BEFORE
                     ControllerIcons.xaml so its StaticResource font
                     references (SectionTitle, HeaderTitle) resolve to
                     these faces instead of falling back to Segoe UI.
                     StaticResource only sees earlier siblings. -->
                <ResourceDictionary>
                    <!-- Telemetry text (#175 iteration 4): the platform face,
                         not a mono insert. Cascadia at 12px inside Segoe
                         lines read as pasted terminal text on real pixels.
                         Cold color carries the telemetry identity. -->
                    <FontFamily x:Key="TelemetryFontFamily">Cascadia Code, Consolas, Segoe UI</FontFamily>
                    <FontFamily x:Key="BodyFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
                    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
                </ResourceDictionary>

                <ResourceDictionary Source="/Resources/ControllerIcons.xaml"/>
                <ResourceDictionary Source="/Resources/Shell.xaml"/>

                <!-- Custom theme overrides -->
                <ResourceDictionary>
                    <!-- Ember identity tokens (#175).
                         Cold = the physical side: devices, sources, raw telemetry.
                         Ember = the virtual side: outputs, targets, anything live.
                         Steel = the ground the two sit on.
                         Green/gold/red stay health-only and are not defined here. -->
                    <SolidColorBrush x:Key="EmberBrush" Color="#FF6B2C"/>
                    <SolidColorBrush x:Key="EmberHotBrush" Color="#FF8A57"/>
                    <SolidColorBrush x:Key="EmberDeepBrush" Color="#C43D0C"/>
                    <SolidColorBrush x:Key="EmberTintBrush" Color="#1AFF6B2C"/>
                    <SolidColorBrush x:Key="ColdBrush" Color="#7CC7EA"/>
                    <SolidColorBrush x:Key="ColdDeepBrush" Color="#2E6A8F"/>
                    <SolidColorBrush x:Key="ColdTintBrush" Color="#1A7CC7EA"/>
                    <!-- Text-safe pairs (round-3 A4): dark defaults here,
                         EmberTheme.ApplyAccent swaps both per ground.
                         EmberTextBrush = raw-ember text that deepens on
                         white; ColdMutedBrush = secondary cold with the
                         62% dim baked in so consumers stay at Opacity 1. -->
                    <SolidColorBrush x:Key="EmberTextBrush" Color="#FF6B2C"/>
                    <SolidColorBrush x:Key="ColdMutedBrush" Color="#9E7CC7EA"/>
                    <SolidColorBrush x:Key="SteelGroundBrush" Color="#0A0E15"/>
                    <SolidColorBrush x:Key="SteelRaisedBrush" Color="#18202E"/>
                    <SolidColorBrush x:Key="SteelPressedBrush" Color="#161D2B"/>
                    <SolidColorBrush x:Key="SteelLineBrush" Color="#2A3546"/>
                    <!-- PadForge 6 surfaces (#574). The pane is the sidebar,
                         one step under the page ground, with its own
                         hairline. A field is where a value is typed. The
                         lifted fill is a raised control under the pointer.
                         EmberTheme.ApplyAccent sets all of these for the
                         active ground. -->
                    <SolidColorBrush x:Key="SteelPaneBrush" Color="#0A0E16"/>
                    <SolidColorBrush x:Key="SteelPaneLineBrush" Color="#161E2B"/>
                    <!-- The window's own ground, under the title bar: the
                         darkest step. The sidebar is one step up, the page
                         another and a card another. The title bar is warm
                         while the engine runs. A forging controller's pill
                         has a soft ember outline and wash, and a waiting
                         one a gold outline. -->
                    <SolidColorBrush x:Key="SteelWindowBrush" Color="#070A10"/>
                    <RadialGradientBrush x:Key="TitleWarmthBrush" Center="0.8,-1.5" GradientOrigin="0.8,-1.5" RadiusX="0.6" RadiusY="3.2">
                        <GradientStop Color="#66FF6B2C" Offset="0"/>
                        <GradientStop Color="#00FF6B2C" Offset="0.64"/>
                    </RadialGradientBrush>
                    <SolidColorBrush x:Key="EmberRingSoftBrush" Color="#73FF6B2C"/>
                    <SolidColorBrush x:Key="EmberWashBrush" Color="#0DFF6B2C"/>
                    <SolidColorBrush x:Key="WaitRingBrush" Color="#66F2B84B"/>
                    <!-- The edge of a forging card and of its state pill,
                         the fainter edge of an extra that is on, the gold
                         wash of a waiting pill, and the steel of a mark at
                         rest: a device's light, a stopped engine's ring. -->
                    <SolidColorBrush x:Key="EmberRingBrush" Color="#8CFF6B2C"/>
                    <!-- The type tile in a controller page's header: ember
                         running to deep ember, from its upper left. -->
                    <LinearGradientBrush x:Key="EmberTileBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF6B2C" Offset="0"/>
                        <GradientStop Color="#C43D0C" Offset="1"/>
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="EmberRingFaintBrush" Color="#4DFF6B2C"/>
                    <SolidColorBrush x:Key="WaitTintBrush" Color="#1AF2B84B"/>
                    <SolidColorBrush x:Key="SteelMarkBrush" Color="#3A475A"/>
                    <SolidColorBrush x:Key="SteelFieldBrush" Color="#0D131D"/>
                    <SolidColorBrush x:Key="SteelLiftBrush" Color="#212C3D"/>
                    <SolidColorBrush x:Key="SteelFootBrush" Color="#101722"/>
                    <!-- The page area behind a dialog drawn inside the window
                         (#574): one step under the page ground. -->
                    <SolidColorBrush x:Key="ShellDialogGroundBrush" Color="#06090E"/>
                    <SolidColorBrush x:Key="SteelPillLineBrush" Color="#263142"/>
                    <!-- The chosen segment of a segmented switch. -->
                    <SolidColorBrush x:Key="SteelSegmentBrush" Color="#263142"/>
                    <!-- A band across a card: the header of a group of rows,
                         one step under the card's own fill. -->
                    <SolidColorBrush x:Key="SteelBandBrush" Color="#0F1520"/>
                    <!-- A part card's tray of feature lines, and the well of
                         a live view with its hairline (the sections pass). -->
                    <SolidColorBrush x:Key="SteelTrayBrush" Color="#0D131D"/>
                    <SolidColorBrush x:Key="SteelWellBrush" Color="#0A0F17"/>
                    <SolidColorBrush x:Key="SteelWellLineBrush" Color="#161E2B"/>
                    <SolidColorBrush x:Key="SteelPaneHoverBrush" Color="#121925"/>
                    <!-- Inside a card: a full-width row under the pointer
                         (a More row, a folded part's line), a reset
                         button's glyph at rest, and the label of a setting
                         that belongs to the row above it. -->
                    <SolidColorBrush x:Key="SteelCardHoverBrush" Color="#161E2B"/>
                    <SolidColorBrush x:Key="QuietGlyphBrush" Color="#6B7890"/>
                    <SolidColorBrush x:Key="SubRowTextBrush" Color="#CFD7E3"/>
                    <!-- The words of the picked section in a controller's
                         header and of a segmented switch's chosen segment, a
                         step brighter than the text color. -->
                    <SolidColorBrush x:Key="SelectedTextBrush" Color="#FFFFFF"/>
                    <!-- The picked item of a list that stands on a card. -->
                    <SolidColorBrush x:Key="EmberCardPickBrush" Color="#24160D"/>
                    <!-- The ring on a control of the picture under the
                         pointer: the boards' ember at 60 percent. -->
                    <SolidColorBrush x:Key="EmberHoverRingBrush" Color="#99FF8A57"/>
                    <!-- An input pill of a macro's trigger: its edge and its words. -->
                    <SolidColorBrush x:Key="InputChipEdgeBrush" Color="#33506A"/>
                    <SolidColorBrush x:Key="InputChipTextBrush" Color="#CFE6F5"/>
                    <!-- Tinted grounds: the square behind a lit flame, a
                         running controller's edge, the selected controller
                         in the sidebar, and the band that offers a device. -->
                    <SolidColorBrush x:Key="EmberWellBrush" Color="#2A1509"/>
                    <SolidColorBrush x:Key="EmberEdgeBrush" Color="#4A2C1A"/>
                    <SolidColorBrush x:Key="EmberPickBrush" Color="#1D1611"/>
                    <SolidColorBrush x:Key="EmberInkBrush" Color="#160A03"/>
                    <SolidColorBrush x:Key="EmberLiftBrush" Color="#FF8450"/>
                    <SolidColorBrush x:Key="EmberPressBrush" Color="#E85F25"/>
                    <SolidColorBrush x:Key="DangerEdgeBrush" Color="#7A3A1A"/>
                    <SolidColorBrush x:Key="DangerInkBrush" Color="#FFB08A"/>
                    <!-- A link under the pointer (#574): the boards' a:hover. -->
                    <SolidColorBrush x:Key="LinkHoverBrush" Color="#FFB08A"/>
                    <SolidColorBrush x:Key="WaitWellBrush" Color="#17150F"/>
                    <SolidColorBrush x:Key="WaitEdgeBrush" Color="#3D3220"/>
                    <!-- Words in a wait box, and a wait tile's label (#574 dialogs). -->
                    <SolidColorBrush x:Key="WaitTextBrush" Color="#E8D9B5"/>
                    <SolidColorBrush x:Key="WaitMutedBrush" Color="#CDB98D"/>
                    <SolidColorBrush x:Key="DashLineBrush" Color="#344154"/>
                    <SolidColorBrush x:Key="SteelLineSoftBrush" Color="#1E2734"/>
                    <!-- The type chip of a controller's pill and card, and
                         the type bar's lit choice, code-built: a rounded
                         tile whose fill the code sets and no state swaps
                         away. -->
                    <Style x:Key="MiniTypeButtonActiveStyle" TargetType="Button">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <!-- Wait gold: the only sanctioned gold. Cooling flames,
                         awaiting-devices states, anything holding heat. -->
                    <SolidColorBrush x:Key="WaitBrush" Color="#F2B84B"/>

                    <!-- Flame glyph geometry (24x24 space). Material Design
                         Icons "fire" (Apache-2.0): licked outer silhouette
                         with an inner-tongue cutout (EvenOdd), so it reads
                         as fire at 12px instead of a droplet. Fill ember
                         when lit, gold when cooling, stroke-only when cold. -->
                    <Geometry x:Key="FlameOuterGeometry">M17.66 11.2C17.43 10.9 17.15 10.64 16.89 10.38C16.22 9.78 15.46 9.35 14.82 8.72C13.33 7.26 13 4.85 13.95 3C13 3.23 12.17 3.75 11.46 4.32C8.87 6.4 7.85 10.07 9.07 13.22C9.11 13.32 9.15 13.42 9.15 13.55C9.15 13.77 9 13.97 8.8 14.05C8.57 14.15 8.33 14.09 8.14 13.93C8.08 13.88 8.04 13.83 8 13.76C6.87 12.33 6.69 10.28 7.45 8.64C5.78 10 4.87 12.3 5 14.47C5.06 14.97 5.12 15.47 5.29 15.97C5.43 16.57 5.7 17.17 6 17.7C7.08 19.43 8.95 20.67 10.96 20.92C13.1 21.19 15.39 20.8 17.03 19.32C18.86 17.66 19.5 15 18.56 12.72L18.43 12.46C18.22 12 17.66 11.2 17.66 11.2M14.5 17.5C14.22 17.74 13.76 18 13.4 18.1C12.28 18.5 11.16 17.94 10.5 17.28C11.69 17 12.4 16.12 12.61 15.23C12.78 14.43 12.46 13.77 12.33 13C12.21 12.26 12.23 11.63 12.5 10.94C12.69 11.32 12.89 11.7 13.13 12C13.9 13 15.11 13.44 15.37 14.8C15.41 14.94 15.43 15.08 15.43 15.23C15.46 16.05 15.1 16.95 14.5 17.5Z</Geometry>
                    <!-- Liveness flame (#175): the universal serving/online
                         indicator. Unlit outline at rest; sites derive and
                         add one DataTrigger that fills it ember. -->
                    <Style x:Key="LivenessFlameBase" TargetType="Path">
                        <Setter Property="Data" Value="{StaticResource FlameOuterGeometry}"/>
                        <Setter Property="Width" Value="9"/>
                        <Setter Property="Height" Value="11"/>
                        <Setter Property="Stretch" Value="Uniform"/>
                        <Setter Property="Fill" Value="Transparent"/>
                        <Setter Property="Stroke" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <Setter Property="StrokeThickness" Value="1.1"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <!-- Corners (#574). Every control the PadForge 6 boards draw (a
                 field, a picker, a button, a number box) has corners of 6.
                 wpf-ui's controls read theirs from this key, which wpf-ui sets
                 to 4, and an entry of the application's own wins over the
                 merged dictionaries. The app's own templates (the fold parts,
                 the segments, the pills, the sidebar's rows) set their own. -->
            <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>

            <!--
                WPF UI's default ComboBox style sets ScrollViewer.VerticalScrollBarVisibility
                to Hidden, which suppresses the scrollbar entirely. Force it Visible so
                the scrollbar element is present in the template, and pair with the
                always-on DynamicScrollBar retemplate below so the track/thumb are
                actually rendered instead of fading in only on hover.

                BasedOn must target WPF UI's DefaultComboBoxStyle — basing off
                {x:Type ComboBox} falls back to the unthemed system style.
            -->
            <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible"/>
                <Setter Property="MaxDropDownHeight" Value="200"/>
                <!-- A closed picker is 34 tall, as the PadForge 6 boards draw
                     one (#574), with its words in the middle of the box.
                     wpf-ui sets a picker's content at the top, which left the
                     words 2 to 4 above center. The part a click opens the
                     list through is only as tall as the content, so the 6
                     above and below the words keep it over nearly the whole
                     box. -->
                <Setter Property="MinHeight" Value="34"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <!--
                Chrome unification (#175 control spec §1, route b): a plain
                Button is the PadForge 6 boards' button (#574), 36 tall with
                14 at its sides. Colors come from the EmberTheme key
                overrides, not from setters here.
            -->
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Padding" Value="14,0"/>
            </Style>

            <!--
                Plain ItemsControls stay out of the Tab order. Every Control
                is focusable by default, so Tab stopped on each list container
                (the Dashboard's slot list, an empty slot-badge row on the
                Devices page) and drew the focus ring around a list that does
                nothing with focus. The controls inside keep their own Tab
                stops. A style keyed by the type reaches only plain
                ItemsControls: ListBox, TabControl and the 3D view keep their
                keyboard behavior. A list with a style of its own sets this
                in that style.

                A list with nothing in it takes no room, and a peer says an
                element is on screen while it is visible: UI Automation
                listed an empty list as on screen with no rectangle. While a
                plain list is empty, whether it is on screen follows the
                room it takes.
            -->
            <Style TargetType="ItemsControl">
                <Setter Property="Focusable" Value="False"/>
                <Style.Triggers>
                    <Trigger Property="HasItems" Value="False">
                        <Setter Property="AutomationProperties.IsOffscreenBehavior" Value="FromClip"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
                Dialog typography (#175 font sweep): MainWindow sets
                BodyFontFamily on its root, but every FluentWindow dialog is
                a separate visual root that would otherwise fall back to
                plain Segoe UI. FluentWindow's constructor resolves its style
                through the typeof(FluentWindow) resource key (Wpf.Ui 4.3.0
                FluentWindow.cs), and the stock DefaultFluentWindowStyle sets
                no FontFamily, so this app-level implicit style hands Body to
                every dialog and lets all dialog text inherit it.
            -->
            <Style TargetType="uictrl:FluentWindow" BasedOn="{StaticResource DefaultFluentWindowStyle}">
                <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}"/>
            </Style>

            <!--
                PadUiButtonTemplate: byte-for-byte copy of Wpf.Ui 4.3.0's
                DefaultUiButtonStyle ControlTemplate (Controls/Button/
                Button.xaml:240-483) with ONE trigger corrected. Upstream's
                pressed MultiTrigger sets Foreground with no TargetName, so
                its TemplatedParent binding is evaluated against the
                ui:Button itself and climbs to the BUTTON'S templated
                parent. Any ui:Button instantiated from a DataTemplate (the
                mapping-row Record/Clear buttons, the palette color chips)
                therefore resolves against a ContentPresenter, which has no
                PressedForeground: a BindingExpression path error on every
                press, and the pressed text color never applies anywhere
                (outside a template the parent is null). Upstream's own
                sibling controls do this swap correctly with targeted
                setters (DropDownButton.xaml:95-96, SplitButton.xaml:177-178),
                which is the pattern the fix applies. Still broken at
                upstream main (ffebacd6), so the copy stays until a
                release carries the fix; on any WPF-UI package bump, re-diff
                this template against the new Button.xaml. One literal
                inlined: ControlIcon's Margin 0,0,8,0 is upstream's
                ButtonIconMargin (Button.xaml:18), whose key lives in the
                package dictionary the XamlResourceKeyTests guard cannot
                scan.
            -->
            <ControlTemplate x:Key="PadUiButtonTemplate" TargetType="{x:Type uictrl:Button}">
                <Border
                    x:Name="ContentBorder"
                    Width="{TemplateBinding Width}"
                    Height="{TemplateBinding Height}"
                    MinWidth="{TemplateBinding MinWidth}"
                    MinHeight="{TemplateBinding MinHeight}"
                    HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalAlignment}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <!--  The inset border is only used for appearances other than Secondary  -->
                    <Border
                        x:Name="InsetBorder"
                        Padding="{TemplateBinding Padding}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        BorderBrush="{Binding ElementName=ContentBorder, Path=BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter
                                x:Name="ControlIcon"
                                Grid.Column="0"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Icon}"
                                Focusable="False"
                                TextElement.FontSize="{TemplateBinding FontSize}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />

                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                </Border>
                <ControlTemplate.Triggers>
                    <!--  TRANSPARENT  -->
                    <Trigger Property="Appearance" Value="Transparent">
                        <Setter Property="Background" Value="Transparent" />
                    </Trigger>

                    <!--  PRIMARY  -->
                    <Trigger Property="Appearance" Value="Primary">
                        <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
                        <Setter Property="MouseOverBackground" Value="{DynamicResource AccentButtonBackgroundPointerOver}" />
                        <Setter Property="PressedBackground" Value="{DynamicResource AccentButtonBackgroundPressed}" />
                        <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
                        <Setter Property="PressedForeground" Value="{DynamicResource AccentButtonForegroundPointerOver}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />
                        <Setter Property="MouseOverBorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />
                        <Setter Property="PressedBorderBrush" Value="{DynamicResource ControlFillColorTransparentBrush}" />
                    </Trigger>

                    <!--  SECONDARY  -->
                    <Trigger Property="Appearance" Value="Secondary">
                        <Setter TargetName="InsetBorder" Property="BorderThickness" Value="0" />
                        <Setter TargetName="ContentBorder" Property="BorderThickness" Value="{Binding BorderThickness, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Trigger>

                    <!--  DARK  -->
                    <Trigger Property="Appearance" Value="Dark">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="{DynamicResource ControlStrongFillColorDark}" />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="MouseOverBackground">
                            <Setter.Value>
                                <SolidColorBrush Color="#62000000" />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="PressedBackground">
                            <Setter.Value>
                                <SolidColorBrush Color="#52000000" />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="PressedBorderBrush" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorLightPrimaryBrush}" />
                        <Setter Property="PressedForeground" Value="{DynamicResource TextFillColorLightSecondaryBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />
                        <Setter Property="MouseOverBorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />
                    </Trigger>

                    <!--  LIGHT  -->
                    <Trigger Property="Appearance" Value="Light">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="{DynamicResource ControlStrongFillColorLight}" />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="MouseOverBackground">
                            <Setter.Value>
                                <SolidColorBrush Color="#D3FFFFFF" />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="PressedBackground">
                            <Setter.Value>
                                <SolidColorBrush Color="#F3FFFFFF" />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDarkPrimaryBrush}" />
                        <Setter Property="PressedForeground" Value="{DynamicResource TextFillColorDarkSecondaryBrush}" />
                    </Trigger>

                    <!--  INFO  -->
                    <Trigger Property="Appearance" Value="Info">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="{DynamicResource PaletteLightBlueColor}" />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="MouseOverBackground">
                            <Setter.Value>
                                <SolidColorBrush Opacity="0.9" Color="{DynamicResource PaletteLightBlueColor}" />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="PressedBackground">
                            <Setter.Value>
                                <SolidColorBrush Opacity="0.7" Color="{DynamicResource PaletteLightBlueColor}" />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorLightPrimaryBrush}" />
                        <Setter Property="PressedBorderBrush" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />
                        <Setter Property="MouseOverBorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />
                    </Trigger>

                    <!--  DANGER  -->
                    <Trigger Property="Appearance" Value="Danger">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="{DynamicResource PaletteRedColor}" />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="MouseOverBackground">
                            <Setter.Value>
                                <SolidColorBrush Opacity="0.9" Color="{DynamicResource PaletteRedColor}" />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="PressedBackground">
                            <Setter.Value>
                                <SolidColorBrush Opacity="0.7" Color="{DynamicResource PaletteRedColor}" />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="PressedBorderBrush" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />
                        <Setter Property="MouseOverBorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />
                    </Trigger>

                    <!--  SUCCESS  -->
                    <Trigger Property="Appearance" Value="Success">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="{DynamicResource PaletteGreenColor}" />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="MouseOverBackground">
                            <Setter.Value>
                                <SolidColorBrush Opacity="0.9" Color="{DynamicResource PaletteGreenColor}" />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="PressedBackground">
                            <Setter.Value>
                                <SolidColorBrush Opacity="0.7" Color="{DynamicResource PaletteGreenColor}" />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="PressedBorderBrush" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />
                        <Setter Property="MouseOverBorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />
                    </Trigger>

                    <!--  CAUTION  -->
                    <Trigger Property="Appearance" Value="Caution">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="{DynamicResource PaletteOrangeColor}" />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="MouseOverBackground">
                            <Setter.Value>
                                <SolidColorBrush Opacity="0.9" Color="{DynamicResource PaletteOrangeColor}" />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="PressedBackground">
                            <Setter.Value>
                                <SolidColorBrush Opacity="0.7" Color="{DynamicResource PaletteOrangeColor}" />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="PressedBorderBrush" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />
                        <Setter Property="MouseOverBorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />
                    </Trigger>

                    <!--  SHARED TRIGGERS  -->
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True" />
                            <Condition Property="IsPressed" Value="False" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="ContentBorder" Property="Background" Value="{Binding MouseOverBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{Binding MouseOverBorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True" />
                            <Condition Property="IsPressed" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="ContentBorder" Property="Background" Value="{Binding PressedBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{Binding PressedBorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                        <!-- FIX (see the comment on PadUiButtonTemplate): TargetName added,
                             matching upstream's own DropDownButton.xaml:95-96 pattern. -->
                        <Setter TargetName="ContentPresenter" Property="TextElement.Foreground" Value="{Binding PressedForeground, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Setter TargetName="ControlIcon" Property="TextElement.Foreground" Value="{Binding PressedForeground, RelativeSource={RelativeSource TemplatedParent}}" />
                    </MultiTrigger>

                    <Trigger Property="Content" Value="{x:Null}">
                        <Setter TargetName="ControlIcon" Property="Margin" Value="0" />
                    </Trigger>
                    <Trigger Property="Content" Value="">
                        <Setter TargetName="ControlIcon" Property="Margin" Value="0" />
                    </Trigger>
                    <Trigger Property="Icon" Value="{x:Null}">
                        <Setter TargetName="ControlIcon" Property="Margin" Value="0" />
                        <Setter TargetName="ControlIcon" Property="Visibility" Value="Collapsed" />
                    </Trigger>

                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource ButtonBackgroundDisabled}" />
                        <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource ButtonBorderBrushDisabled}" />
                        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabled}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!--
                Applies the corrected template to every unstyled ui:Button.
                Named styles based on DefaultUiButtonStyle bypass this
                implicit style, so each of them repeats the Template setter
                (EmberIconButton, EmberPrimaryButton, HomePage's page
                implicit).
            -->
            <Style TargetType="uictrl:Button" BasedOn="{StaticResource DefaultUiButtonStyle}">
                <Setter Property="Template" Value="{StaticResource PadUiButtonTemplate}"/>
            </Style>

            <!--
                Icon micro-buttons (#175 control spec §3): 28x28 hit target,
                radius 6, transparent rest fill with a 1px ghost stroke so
                they read as targets at rest. Hover fills raised steel and
                lights a domain ring: cold for input-side actions (reset to
                default), ember (EmberIconButtonHot) for output-writing
                actions (record, erase binding, row delete). Must be
                uictrl:Button: plain Button's hover/pressed brushes are fixed
                DynamicResource keys inside the template triggers, while
                ui:Button exposes MouseOverBackground/MouseOverBorderBrush/
                PressedBackground as settable properties.
            -->
            <Style x:Key="EmberIconButton" TargetType="uictrl:Button" BasedOn="{StaticResource DefaultUiButtonStyle}">
                <Setter Property="Template" Value="{StaticResource PadUiButtonTemplate}"/>
                <Setter Property="Width" Value="28"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SteelLineSoftBrush}"/>
                <Setter Property="MouseOverBackground" Value="{DynamicResource SteelRaisedBrush}"/>
                <Setter Property="MouseOverBorderBrush" Value="{DynamicResource ColdBrush}"/>
                <Setter Property="PressedBackground" Value="{DynamicResource SteelPressedBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="4,0,0,0"/>
                <!-- #175 iteration 53 motion: hover ring stays on the
                     MouseOverBorderBrush property route (instant, template-
                     owned). Press feedback is a plain RenderTransform swap.
                     No storyboard, no Effect animation. Inherits into
                     EmberIconButtonHot via BasedOn. -->
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <!-- Disabled consistency (#175 final sweep): icon content
                         carries explicit domain colors that the template's
                         disabled foreground cannot reach, so dim the whole
                         control. Opacity, never Effect. -->
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!--
                Quiet reset (#574). Every setting keeps its reset button,
                which puts hundreds of them on the pad page alone. Drawn
                with the icon button's ghost ring and a bright glyph, they
                read louder than the settings they stand beside. A reset
                button rests with no ring and a dim glyph. Under the
                pointer it takes the raised fill and the full glyph, and
                keyboard focus adds a cold ring beside the app's focus
                visual. Press feedback is EmberIconButton's, unchanged.
                Every reset style in the app is based on this one.

                A PadForge 6 row puts its reset at the row's far right, so
                the style docks it right: in a row that is a DockPanel it
                goes to the end, and in any other panel the setter does
                nothing. It is 32 square with no margin, which costs a row
                the same 32 the icon button's 28 and its 4 of margin do.

                A reset in a row that rests (the row's switch is off) is
                disabled with its row. The button template then fills and
                rings it from two theme keys, which drew a box at the end
                of every resting row. The style shadows both keys with
                nothing, so a resting reset is its dimmed glyph alone.
            -->
            <Style x:Key="QuietResetButton" TargetType="uictrl:Button" BasedOn="{StaticResource EmberIconButton}">
                <Style.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent"/>
                </Style.Resources>
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="MouseOverBorderBrush" Value="Transparent"/>
                <Setter Property="DockPanel.Dock" Value="Right"/>
                <Setter Property="Foreground" Value="{DynamicResource QuietGlyphBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource ColdBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SettingResetButton" TargetType="uictrl:Button" BasedOn="{StaticResource QuietResetButton}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Content" Value="&#xE72C;"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}, TargetNullValue='', FallbackValue=''}"/>
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <controls:GlyphText Text="{Binding}" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Reset All is a reset button in words (#574): the reset
                 buttons' quiet rest state and fill under the pointer
                 (QuietResetButton), at its natural width so the localized
                 label fits. In a card's title row it docks right, as every
                 reset does in its row. The controller page, the Extras pages
                 and the Devices page share it. -->
            <!-- A page shows several Reset All buttons, one a card. Each
                 reads as its words and then its section, which its tooltip
                 names (Reset All, Left Thumbstick), so a screen reader
                 tells one from the next (ResetAllNameConverter). A button
                 of this look with other words reads those words. -->
            <conv:ResetAllNameConverter x:Key="ResetAllNameConverter"/>
            <Style x:Key="ResetAllButton" TargetType="uictrl:Button" BasedOn="{StaticResource QuietResetButton}">
                <Setter Property="AutomationProperties.Name">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource ResetAllNameConverter}">
                            <Binding Path="Content" RelativeSource="{RelativeSource Self}"/>
                            <Binding Path="ToolTip" RelativeSource="{RelativeSource Self}"/>
                            <Binding Path="Pad_ResetSection_Format" Source="{x:Static strings:Strings.Instance}"/>
                            <Binding Path="Pad_ResetAll" Source="{x:Static strings:Strings.Instance}"/>
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="MinHeight" Value="30"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Margin" Value="0"/>
            </Style>

            <Style x:Key="EmberIconButtonHot" TargetType="uictrl:Button" BasedOn="{StaticResource EmberIconButton}">
                <Setter Property="MouseOverBorderBrush" Value="{DynamicResource EmberBrush}"/>
            </Style>

            <!-- The X in a card's corner (#574, the world-class pass): no
                 edge and a mark in the secondary text color at rest, the
                 raised fill and the text's own color under the pointer. -->
            <Style x:Key="CardCloseButton" TargetType="uictrl:Button" BasedOn="{StaticResource EmberIconButton}">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="MouseOverBorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
                The buttons of PadForge 6 (#574), three beside the plain one.

                The main action of a surface is filled ember with dark text
                in a heavier weight: one per surface, the affirmative verb.
                EmberAccentButton is that look for a plain Button and
                EmberPrimaryButton for a uictrl:Button. Consumers must not
                set Appearance=Primary, whose style trigger would beat these
                setters. A plain Button's template reads its fills under the
                pointer and while pressed from fixed resource keys, so the
                plain style shadows those keys in its own resources. Its
                edge under the pointer comes from ControlElevationBorderBrush,
                the key its edge at rest has by default, so each plain style
                shadows that one with the edge it keeps there.

                An action that removes something is clear with a dark ember
                edge and pale ember text (EmberDestructiveButton).

                A quiet action has no fill and no edge until the pointer is
                on it (QuietButton for a uictrl:Button, QuietPlainButton for
                a plain Button). A quiet button that cannot be used has none
                either: both button templates fill and ring a disabled button
                from two theme keys, which drew a box around Duplicate and
                Remove under a macro's steps while no step was picked, and
                around a Bass Shakers tone's Test while the shakers were
                off. Both styles shadow the two keys with nothing, as a
                quiet reset's does.

                Dialog footer idiom (layout a style cannot carry): a
                right-aligned horizontal StackPanel, Margin 0,18,0,0,
                MinWidth 90 buttons with 8px gaps, Cancel or Close plain,
                the action in ember or as a danger. See ConfirmDialog.
            -->
            <Style x:Key="EmberAccentButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Style.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF8450"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E85F25"/>
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#160A03"/>
                    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#FF8450"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#E85F25"/>
                </Style.Resources>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Background" Value="{DynamicResource EmberBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource EmberBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource EmberInkBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="EmberPrimaryButton" TargetType="uictrl:Button" BasedOn="{StaticResource DefaultUiButtonStyle}">
                <Setter Property="Template" Value="{StaticResource PadUiButtonTemplate}"/>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Background" Value="{DynamicResource EmberBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource EmberBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource EmberInkBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="MouseOverBackground" Value="{DynamicResource EmberLiftBrush}"/>
                <Setter Property="MouseOverBorderBrush" Value="{DynamicResource EmberLiftBrush}"/>
                <Setter Property="PressedBackground" Value="{DynamicResource EmberPressBrush}"/>
                <Setter Property="PressedBorderBrush" Value="{DynamicResource EmberPressBrush}"/>
                <Setter Property="PressedForeground" Value="{DynamicResource EmberInkBrush}"/>
            </Style>
            <!-- The same call as an outline (#574): for a row of a list,
                 where a filled ember button on every row would be louder
                 than what the list is about. -->
            <Style x:Key="EmberOutlineButton" TargetType="uictrl:Button" BasedOn="{StaticResource DefaultUiButtonStyle}">
                <Setter Property="Template" Value="{StaticResource PadUiButtonTemplate}"/>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource EmberRingBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource EmberTextBrush}"/>
                <Setter Property="MouseOverBackground" Value="{DynamicResource EmberPickBrush}"/>
                <Setter Property="MouseOverBorderBrush" Value="{DynamicResource EmberBrush}"/>
                <Setter Property="PressedBackground" Value="{DynamicResource EmberPickBrush}"/>
                <Setter Property="PressedBorderBrush" Value="{DynamicResource EmberBrush}"/>
                <Setter Property="PressedForeground" Value="{DynamicResource EmberTextBrush}"/>
            </Style>

            <Style x:Key="EmberDestructiveButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Style.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#33FF6B2C"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#22FF6B2C"/>
                    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#7A3A1A"/>
                </Style.Resources>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource DangerEdgeBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource DangerInkBrush}"/>
            </Style>

            <Style x:Key="QuietButton" TargetType="uictrl:Button" BasedOn="{StaticResource DefaultUiButtonStyle}">
                <Style.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent"/>
                </Style.Resources>
                <Setter Property="Template" Value="{StaticResource PadUiButtonTemplate}"/>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Setter Property="MouseOverBackground" Value="{DynamicResource SteelRaisedBrush}"/>
                <Setter Property="MouseOverBorderBrush" Value="Transparent"/>
                <Setter Property="PressedBackground" Value="{DynamicResource SteelLiftBrush}"/>
                <Setter Property="PressedBorderBrush" Value="Transparent"/>
                <Setter Property="PressedForeground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="QuietPlainButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Style.Resources>
                    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent"/>
                </Style.Resources>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            </Style>

            <!--
                Styles shared by the pages of PadForge 6 (#574). They began
                on the controller page and moved here once another page
                needed them, so every page draws them one way.
            -->
            <!-- A link among a page's words (#574): underlined in the link
                 color at 13, lighter under the pointer. The way back at the
                 top of an extra's page and See All on Profiles. -->
            <Style x:Key="LinkButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource EmberHotBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <TextBlock x:Name="Label" Foreground="{TemplateBinding Foreground}" TextDecorations="Underline"
                                           LineHeight="18.85" LineStackingStrategy="BlockLineHeight"
                                           Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource LinkHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- An icon button in a card's head (#574): the quiet reset's size
                 with the glyph in the secondary text color. -->
            <Style x:Key="CardIconButton" TargetType="ui:Button" BasedOn="{StaticResource QuietResetButton}">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <!-- A list of a card: its items alone, with no scroll view of its
                 own, so the wheel over it scrolls the page. -->
            <Style x:Key="PartList" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- An item of such a list, as the Macros board draws it: 38 tall
                 with 12 at its sides and corners of 6. The picked one stands
                 on the ember fill in the text color at SemiBold. -->
            <Style x:Key="PartListItem" TargetType="ListBoxItem">
                <!-- An item is read by its name: with a template of its own it
                     would be read as its type. -->
                <Setter Property="AutomationProperties.Name" Value="{Binding Name, TargetNullValue=''}"/>
                <Setter Property="MinHeight" Value="38"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource SubRowTextBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" CornerRadius="6" Background="Transparent"
                                    Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SteelCardHoverBrush}"/>
                                </Trigger>
                                <!-- After the pointer's, so the picked item keeps
                                     its fill under the pointer. -->
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EmberCardPickBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- A small head inside a block, over a group of its rows: 12 SemiBold in
                 the quiet text color, as the board draws the heads of the lists' card. -->
            <Style x:Key="EditorSubHead" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <!-- An input of a macro's trigger, as the Macros board draws it: a pill
                 30 tall on the raised fill with a cold edge, 12 at its start, and
                 its remove 6 after its words. A name too long for the line is cut
                 short. -->
            <Style x:Key="InputChip" TargetType="Border">
                <Setter Property="MinHeight" Value="30"/>
                <Setter Property="CornerRadius" Value="15"/>
                <Setter Property="Padding" Value="12,0,6,0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource InputChipEdgeBrush}"/>
                <Setter Property="Background" Value="{DynamicResource SteelRaisedBrush}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource InputChipTextBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <!-- The quiet button under a list, as the board renders Add Action and Add
                 Cell: no fill, and its mark and word in the text color. Both dim while
                 it cannot be used: its content is a panel, which takes the button's own
                 color and not the one the button's template gives a disabled label. -->
            <Style x:Key="QuietTextButton" TargetType="ui:Button" BasedOn="{StaticResource QuietButton}">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Setter Property="Padding" Value="14,0"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- A record button, as the Macros board draws it: the ember dot, 7 across,
                 and the word Record, 36 tall with 12 at each side, 10 after the control
                 it records for. Its content is the glyph that says whether it records
                 (the view models' record and stop glyphs), and its face follows that:
                 while it records the dot is a square and the word is Stop. The glyph
                 is not drawn, so a button with this look carries a name of its own. -->
            <DataTemplate x:Key="RecordFace">
                <StackPanel Orientation="Horizontal">
                    <Rectangle x:Name="Mark" FlowDirection="LeftToRight" Width="7" Height="7" RadiusX="3.5" RadiusY="3.5"
                               Margin="0,0,8,0" VerticalAlignment="Center" Fill="{DynamicResource EmberBrush}"/>
                    <TextBlock x:Name="Word" Text="{Binding Common_Record, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"/>
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding}" Value="&#xE71A;">
                        <Setter TargetName="Mark" Property="RadiusX" Value="1"/>
                        <Setter TargetName="Mark" Property="RadiusY" Value="1"/>
                        <Setter TargetName="Word" Property="Text" Value="{Binding Common_Stop, Source={x:Static strings:Strings.Instance}}"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
            <Style x:Key="RecordButton" TargetType="ui:Button" BasedOn="{StaticResource DefaultUiButtonStyle}">
                <Setter Property="Template" Value="{StaticResource PadUiButtonTemplate}"/>
                <Setter Property="ContentTemplate" Value="{StaticResource RecordFace}"/>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="Margin" Value="10,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <!-- A quiet button that holds a state: no fill until the pointer is
                 on it, as QuietPlainButton, in the text color. -->
            <Style x:Key="QuietToggle" TargetType="ToggleButton">
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Face" Property="Background" Value="{DynamicResource SteelRaisedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- A chip, as the boards draw one (#574): a profile card's Built-in
                 and type counts, a starter's output, a community config's
                 controller. It is the controller page's quiet tag under the
                 name these pages know it by, so the two cannot drift apart
                 (ChipSteel, Resources/ControllerIcons.xaml). -->
            <Style x:Key="PillChip" TargetType="Border" BasedOn="{StaticResource ChipSteel}"/>

            <!--
                Ember-select list rows (user report 2026-07-05): the stock
                WPF-UI ListBoxItem template paints a solid accent slab on
                selection and flips Foreground to TextOnAccent, which lands
                dark text on the ember fill. Template triggers outrank
                derived-style setters (ProfilesPage container precedent), so
                the container is retemplated. Selection is the EmberTint
                wash + #66FF6B2C rim the identity chip and the AT mode cards
                wear, and the content keeps its own foregrounds (names stay
                primary, mono detail lines stay secondary/tertiary). Hover
                is the neutral subtle fill.
            -->
            <Style x:Key="EmberSelectListItem" TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="RowBd" CornerRadius="4" BorderThickness="1"
                                    Background="Transparent" BorderBrush="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                </Trigger>
                                <!-- Last-writer trigger order: selected wins the fill
                                     even while hovered, the glow stays. -->
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource EmberTintBrush}"/>
                                    <Setter TargetName="RowBd" Property="BorderBrush" Value="#66FF6B2C"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Form check boxes ride the implicit style.
                 A check box keeps the corners of 4 it has always had. At the
                 6 the other controls take (ControlCornerRadius) its 20 box
                 reads as a rounded pill, and the boards draw the browser's
                 own check box, which is squarer still. -->
            <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
                <Setter Property="Border.CornerRadius" Value="4"/>
            </Style>

            <!--
                Instrument bars (#175): the shared RAW/OUT telemetry bar used by
                the Triggers readout, FFB Motor Activity, and Impulse Triggers.
                WPF UI's ProgressBar template hardcodes CornerRadius 1.5/2, so
                these templates copy its determinate template (Wpf.Ui 4.3.0
                Controls/ProgressBar/ProgressBar.xaml) with radius 4/3. Raw fills
                flat cold-deep. Out fills the ember gradient with a static glow
                on the indicator (never animate Effect.Opacity from triggers).
            -->
            <ControlTemplate x:Key="InstrumentBarRawTemplate" TargetType="{x:Type ProgressBar}">
                <Grid SnapsToDevicePixels="True">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"/>
                    <Rectangle Name="PART_Track" Margin="1"/>
                    <Border
                        Name="PART_Indicator"
                        Margin="1"
                        HorizontalAlignment="Left"
                        Background="{TemplateBinding Foreground}"
                        CornerRadius="3"/>
                </Grid>
            </ControlTemplate>

            <ControlTemplate x:Key="InstrumentBarOutTemplate" TargetType="{x:Type ProgressBar}">
                <Grid SnapsToDevicePixels="True">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"/>
                    <Rectangle Name="PART_Track" Margin="1"/>
                    <Border
                        Name="PART_Indicator"
                        Margin="1"
                        HorizontalAlignment="Left"
                        Background="{TemplateBinding Foreground}"
                        CornerRadius="3">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF6B2C" BlurRadius="12" ShadowDepth="0" Opacity="0.55"/>
                        </Border.Effect>
                    </Border>
                </Grid>
            </ControlTemplate>

            <Style x:Key="InstrumentBarRaw" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                <Setter Property="Height" Value="8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="{DynamicResource SteelGroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SteelLineSoftBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ColdDeepBrush}"/>
                <Setter Property="Template" Value="{StaticResource InstrumentBarRawTemplate}"/>
            </Style>

            <Style x:Key="InstrumentBarOut" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                <Setter Property="Height" Value="8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="{DynamicResource SteelGroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SteelLineSoftBrush}"/>
                <Setter Property="Foreground">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#C43D0C" Offset="0"/>
                            <GradientStop Color="#FF6B2C" Offset="0.5"/>
                            <GradientStop Color="#FFA24D" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template" Value="{StaticResource InstrumentBarOutTemplate}"/>
            </Style>

            <!-- A live bar (#574): a track 6 tall, a field's fill inside a
                 hairline, filled in its Foreground, ember unless a page sets
                 another. A motor's bar on the controller page and a
                 trigger's on the Devices page. -->
            <Style x:Key="ActivityBar" TargetType="ProgressBar">
                <Setter Property="Height" Value="6"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Foreground" Value="{DynamicResource EmberBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border Background="{DynamicResource SteelFieldBrush}"
                                        BorderBrush="{DynamicResource SteelLineSoftBrush}" BorderThickness="1" CornerRadius="3"/>
                                <Rectangle x:Name="PART_Track" Margin="1"/>
                                <Border x:Name="PART_Indicator" Margin="1" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" CornerRadius="2"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                Ember value slider (round-3 A3): Wpf.Ui 4.3.0's Slider
                template has no decrease-side value-fill element (confirmed
                iteration 47-48), so resource keys cannot add one. This style
                retemplates the horizontal single-thumb slider with a Track
                whose decrease side fills flat ember, on the same
                recessed SteelGround tray + SteelLineSoft hairline the
                instrument bars use (both theme-paired). Thumb colors ride
                the SliderThumbBackground* keys: EmberTheme pins them ember
                on dark, and on light they fall back to the stock accent,
                which the ApplicationAccentColorManager already pins ember.
                Horizontal orientation only. Every consumer is horizontal.
                The two track buttons stretch by their own attributes:
                wpf-ui's implicit RepeatButton style aligns a button left
                and centers it, which sized the decrease side to its
                content, one pixel wide, so the fill was never seen.
            -->
            <Style x:Key="EmberSlider" TargetType="Slider">
                <Setter Property="MinHeight" Value="24"/>
                <Setter Property="IsMoveToPointEnabled" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid MinHeight="{TemplateBinding MinHeight}" Background="Transparent">
                                <Border Height="6"
                                        VerticalAlignment="Center"
                                        CornerRadius="3"
                                        Background="{DynamicResource SteelGroundBrush}"
                                        BorderBrush="{DynamicResource SteelLineSoftBrush}"
                                        BorderThickness="1"/>
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False" Focusable="False"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Grid Background="Transparent">
                                                        <Border Height="4"
                                                                Margin="1,0,0,0"
                                                                VerticalAlignment="Center"
                                                                CornerRadius="2"
                                                                Background="{DynamicResource EmberBrush}"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False" Focusable="False"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Grid Background="Transparent"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="14" Height="14" Focusable="False">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse x:Name="ThumbDot"
                                                             Fill="{DynamicResource SliderThumbBackground}"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbDot" Property="Fill"
                                                                    Value="{DynamicResource SliderThumbBackgroundPointerOver}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <!-- Disabled consistency (#175 final sweep): the retemplated
                     slider has no brush-key disabled path, so dim the whole
                     control like the icon buttons. -->
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.4"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
                The rows of a settings card (#574), on every page: a setting's
                label in a column 230 wide, its control, its value typed in
                place with its unit after it, and its reset at the row's far
                right. A page or a section whose board draws another label
                column shadows DzLabel in its own resources.
            -->
            <Style x:Key="DzLabel" TargetType="TextBlock">
                <Setter Property="Width" Value="230"/>
                <Setter Property="Margin" Value="0,0,12,0"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            </Style>
            <!-- A setting's value, typed in place. At rest it reads as plain
                 text in the mono face, the number and then its unit, as the
                 boards draw it. Under the pointer it takes the raised fill,
                 and with the keyboard's focus the field's fill and a cold
                 edge, so it shows where a value is typed. It is as wide as its
                 number, and never narrower than two digits: a single digit
                 stands at the right of that, against its unit. The template
                 adds no inset of its own: a TextBox lays its Padding around its
                 text itself, and a template that bound the same Padding again
                 cut a third digit off a boxed value. -->
            <Style x:Key="DzValueEdit" TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="MinWidth" Value="20"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Margin" Value="8,0,0,0"/>
                <Setter Property="Padding" Value="3,2,0,2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SteelRaisedBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SteelFieldBrush}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ColdBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- A unit reads as part of its row's phrase, so it takes the
                 label's color (owner, 2026-10-30). UnitTextTests pins it. It
                 follows its number at the value box's own inset, which is the
                 width of a space. -->
            <Style x:Key="DzPercent" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            </Style>

            <!--
                Always-visible DynamicScrollBar retemplate.
                WPF UI's shipped template starts PART_Border, PART_Track, and the line
                buttons at Opacity=0 and fades them in on IsMouseOver / IsInteracted
                (Fluent "passive scrollbar"). We want the track + thumb always visible,
                so copy the template with those opacities set to 1, the opacity
                storyboards stripped and no line buttons. The track is 6 wide and
                does not change under the pointer.
            -->
            <ControlTemplate x:Key="AlwaysVisibleDynamicVerticalScrollBar" TargetType="{x:Type uictrl:DynamicScrollBar}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition MaxHeight="14"/>
                        <RowDefinition Height="0.00001*"/>
                        <RowDefinition MaxHeight="14"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="PART_Border" Grid.RowSpan="3" Width="12"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource ScrollBarTrackFillPointerOver}"
                            CornerRadius="6" Opacity="1"/>
                    <Track x:Name="PART_Track" Grid.Row="1" Width="6"
                           IsDirectionReversed="True" Opacity="1">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Style="{DynamicResource DynamicScrollBarPageButton}"/>
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Margin="0" Padding="0" Style="{DynamicResource DynamicScrollBarThumb}"/>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Style="{DynamicResource DynamicScrollBarPageButton}"/>
                        </Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
            </ControlTemplate>

            <ControlTemplate x:Key="AlwaysVisibleDynamicHorizontalScrollBar" TargetType="{x:Type uictrl:DynamicScrollBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition MaxWidth="14"/>
                        <ColumnDefinition Width="0.00001*"/>
                        <ColumnDefinition MaxWidth="14"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PART_Border" Grid.ColumnSpan="3" Height="12"
                            VerticalAlignment="Center"
                            Background="{DynamicResource ScrollBarTrackFillPointerOver}"
                            CornerRadius="6" Opacity="1"/>
                    <Track x:Name="PART_Track" Grid.Column="1" Height="6"
                           Opacity="1">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{DynamicResource DynamicScrollBarPageButton}"/>
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Margin="0" Padding="0" Style="{DynamicResource DynamicScrollBarThumb}"/>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageRightCommand" Style="{DynamicResource DynamicScrollBarPageButton}"/>
                        </Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
            </ControlTemplate>

            <Style TargetType="{x:Type uictrl:DynamicScrollBar}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="Height" Value="14"/>
                        <Setter Property="Template" Value="{StaticResource AlwaysVisibleDynamicHorizontalScrollBar}"/>
                    </Trigger>
                    <Trigger Property="Orientation" Value="Vertical">
                        <Setter Property="Width" Value="14"/>
                        <Setter Property="Height" Value="Auto"/>
                        <Setter Property="Template" Value="{StaticResource AlwaysVisibleDynamicVerticalScrollBar}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
                Keyboard focus (#175 final sweep): Wpf.Ui's stock focus rect
                is a 1px neutral stroke (Resources/DefaultFocusVisualStyle.xaml,
                KeyboardFocusBorderColorBrush). Replace it with an ember ring
                on the same mechanism: every Wpf.Ui control binds
                DefaultControlFocusVisualStyle via DynamicResource, and the
                system FocusVisualStyleKey alias catches plain controls, so
                overriding both keys here retargets keyboard focus app-wide.
                EmberHotBrush is a theme pair (EmberTheme.ApplyAccent deepens
                it on light), so the ring holds contrast on both grounds.
                Focus visuals draw only on keyboard/tab focus, never on click.
            -->
            <Style x:Key="EmberFocusVisual">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Rectangle
                                Margin="-2"
                                RadiusX="6"
                                RadiusY="6"
                                SnapsToDevicePixels="True"
                                Stroke="{DynamicResource EmberHotBrush}"
                                StrokeThickness="1.5"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DefaultControlFocusVisualStyle" BasedOn="{StaticResource EmberFocusVisual}"/>
            <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" BasedOn="{StaticResource EmberFocusVisual}"/>

            <!--
                ToolTip typography (#175 final sweep): body face at the stock
                12px. The stock style justifies text, which rivers on short
                hint strings, so tooltips set left alignment. Surface colors
                stay on the ToolTipBackground/Foreground keys EmberTheme
                already pins to the flyout ground on dark.
            -->
            <Style TargetType="ToolTip" BasedOn="{StaticResource DefaultToolTipStyle}">
                <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}"/>
                <Setter Property="TextBlock.TextAlignment" Value="Left"/>
            </Style>

            <!--
                Text selection (#175 final sweep): the selection highlight is
                an ember tint instead of the stock system blue. SelectionBrush
                composites under the text at SelectionOpacity, so raw ember
                works on both grounds. Covers plain TextBox and uictrl:TextBox
                (each has its own default style key); keyed styles based
                directly on DefaultTextBoxStyle (PadPage DzValueEdit family)
                bypass this and keep stock selection.
            -->
            <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="SelectionBrush" Value="{DynamicResource EmberBrush}"/>
                <Setter Property="SelectionOpacity" Value="0.35"/>
            </Style>
            <Style TargetType="uictrl:TextBox" BasedOn="{StaticResource DefaultUiTextBoxStyle}">
                <Setter Property="SelectionBrush" Value="{DynamicResource EmberBrush}"/>
                <Setter Property="SelectionOpacity" Value="0.35"/>
            </Style>

            <!--
                EntranceFade (#175 final sweep): reusable 150ms ease-in for
                page-level content. Opacity 0 -> 1 with a 6px upward settle on
                Loaded, cubic ease-out, then holds. Opacity and a
                RenderTransform double only: no Effect animation, no layout
                churn. The style owns the TranslateTransform so the storyboard
                path always resolves (WPF clones the frozen setter transform
                for animation). Apply to a page or card root:
                Style="{StaticResource EntranceFade}". Replays whenever the
                element reloads (tab switches), which is the intent.
            -->
            <Style x:Key="EntranceFade" TargetType="FrameworkElement">
                <Setter Property="Opacity" Value="0"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform Y="6"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="Opacity"
                                    To="1" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                    To="0" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Style.Triggers>
            </Style>

            <!-- Global Converters -->
            <conv:DzShapeNameConverter x:Key="DzShapeNameConverter" />
            <conv:EqBandTypeNameConverter x:Key="EqBandTypeNameConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:HexToBrushConverter x:Key="HexToBrushConverter" />
            <conv:NormToCanvasConverter x:Key="NormToCanvasConverter" />
            <conv:SignedNormToCanvasConverter x:Key="SignedNormToCanvasConverter" />
            <conv:PercentToSizeConverter x:Key="PercentToSizeConverter" />
            <conv:CrossGeometryConverter x:Key="CrossGeometryConverter" />
            <conv:SlopedWedgeGeometryConverter x:Key="SlopedWedgeGeometryConverter" />
            <conv:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />
            <conv:OnOffTextConverter x:Key="OnOffTextConverter" />
            <conv:AnyOnConverter x:Key="AnyOnConverter" />
            <conv:FormatTextConverter x:Key="FormatTextConverter" />
            <conv:ShownNamesConverter x:Key="ShownNamesConverter" />
            <conv:BracketPartConverter x:Key="BracketPartConverter" />
            <conv:OptionTextConverter x:Key="OptionTextConverter" />
            <conv:IndexTextConverter x:Key="IndexTextConverter" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
            <conv:EnumIndexConverter x:Key="EnumIndexConverter" />
            <conv:EnumEqualityVisibilityConverter x:Key="EnumEqualityVisibilityConverter" />
            <conv:EnumEqualityConverter x:Key="EnumEqualityConverter" />
            <conv:BoolToTriggerShapeKindConverter x:Key="BoolToTriggerShapeKindConverter" />
            <conv:RgbToBrushConverter x:Key="RgbToBrushConverter" />
            <conv:IndexToLetterConverter x:Key="IndexToLetterConverter" />
            <conv:IndexLessThanVisibilityConverter x:Key="IndexLessThanVisibilityConverter" />
            <conv:OneBasedIndexConverter x:Key="OneBasedIndexConverter" />
            <conv:BytePercentConverter x:Key="BytePercentConverter" />
            <conv:LogScaleConverter x:Key="LogScaleConverter" />
            <conv:CultureLanguageConverter x:Key="CultureLanguageConverter" />

        </ResourceDictionary>
    </Application.Resources>

</Application>
