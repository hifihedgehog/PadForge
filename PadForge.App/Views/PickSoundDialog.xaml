<views:DialogWindow AutomationProperties.IsDialog="True" x:Class="PadForge.Views.PickSoundDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        xmlns:common="clr-namespace:PadForge.Common"
        xmlns:controls="clr-namespace:PadForge.Controls"
        xmlns:views="clr-namespace:PadForge.Views"
        BodyPadding="22,14,22,18"
        Title="{Binding PickSound_Title, Source={x:Static strings:Strings.Instance}}"
        Subtitle="{Binding PickSound_Subtitle, Source={x:Static strings:Strings.Instance}}">

    <!-- Pick a Sound (#574), as the Confirm board draws it: each sound with
         a Play button before its name and its package after it, the picked
         row SemiBold on the picked fill. A double click uses the sound at
         once. Browse Files leads the foot where the caller allows it. -->
    <views:DialogWindow.Resources>
        <!-- A row is read by its sound's name: with a template of its own
             it would be read as its type. The picked row's name is SemiBold. -->
        <Style x:Key="SoundRow" TargetType="ListBoxItem" BasedOn="{StaticResource DialogPickListItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name, TargetNullValue=''}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </views:DialogWindow.Resources>

    <views:DialogWindow.Foot>
        <controls:FlexLinePanel Style="{StaticResource DialogFootPanel}">
            <Button x:Name="BrowseButton" Style="{StaticResource DialogQuietButton}" Visibility="Collapsed"
                    Content="{Binding Macro_Sound_BrowseFiles, Source={x:Static strings:Strings.Instance}}"
                    Click="BrowseButton_Click"/>
            <Button Style="{StaticResource DialogButton}" IsCancel="True"
                    Content="{Binding Common_Cancel, Source={x:Static strings:Strings.Instance}}"/>
            <Button x:Name="OkButton" Style="{StaticResource DialogPrimaryButton}" IsDefault="True"
                    Content="{Binding PickSound_Use, Source={x:Static strings:Strings.Instance}}"
                    Click="OkButton_Click"/>
        </controls:FlexLinePanel>
    </views:DialogWindow.Foot>

    <Border Style="{StaticResource DialogList}" common:InitialFocus.First="True">
        <ListBox x:Name="SoundList" Style="{StaticResource DialogListBox}" MaxHeight="322" SelectionMode="Single"
                 ItemContainerStyle="{StaticResource SoundRow}"
                 MouseDoubleClick="SoundList_MouseDoubleClick"
                 AutomationProperties.Name="{Binding PickSound_Title, Source={x:Static strings:Strings.Instance}}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Play: the sound once, on the controller's speaker
                             or the PC's. It is named for its sound. -->
                        <ui:Button Style="{StaticResource DialogIconButton}" Click="Play_Click" Tag="{Binding}"
                                   ToolTip="{Binding PlayName}"
                                   AutomationProperties.Name="{Binding PlayName, TargetNullValue='', FallbackValue=''}">
                            <Path FlowDirection="LeftToRight" Data="M 4.1,2.6 L 4.1,11.4 L 11.1,7 Z" Width="14" Height="14"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ui:Button}}}"/>
                        </ui:Button>
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding Name}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Margin="12,0,0,0" Text="{Binding Package}" FontSize="13" FontWeight="Normal"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Border>
</views:DialogWindow>
