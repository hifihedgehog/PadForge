                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <!-- Player-identity idle floor (#191): the tab states
                             the default so an untouched pad showing a player
                             color reads as designed behavior, not a mystery. -->
                        <TextBlock x:Name="LightingPlayerIdleHint"
                                   Text="{Binding Pad_Lighting_PlayerIdle_Hint, Source={x:Static strings:Strings.Instance}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- Unified lightbar mode picker. Replaces the
                             v3.0 BaseColor + AudioLightbar split. The
                             single-color RGB sub-block is shared by
                             Static / Breathing / AudioPulse. The audio
                             3-color bands are shared by Thresholds /
                             Gradient / CrossFade. Period drives the
                             time-based animations. Palette + Smooth
                             belong to ColorCycle; Decay + Randomize +
                             palette belong to InputReactive.
                             Named so SyncTabVisibility can hide the whole
                             lightbar card when the Lighting tab is shown
                             for a guide-LED-only device (#209). -->
                        <Border x:Name="LightbarModeCard" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_Lighting_BaseColor, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding DeviceConfig.ResetLightbarAllCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetLightbar, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Lightbar preview (#175): the project's real 2D
                                     controller art instead of a hand-drawn silhouette.
                                     Base composite + lightbar strip PNGs are the
                                     Gamepad-Asset-Pack 2DModels assets (MIT, already
                                     credited in the csproj), composed at native base
                                     resolution inside this Viewbox. Strip positions were
                                     measured by alpha-masked template matching against
                                     the pack's own baked composites, so the lit shape is
                                     the art's shape: DualSense/Edge lights the ring
                                     wrapping the touchpad's flanks; a DualShock 4 lights
                                     the front strip plus the rear bar, chosen by
                                     SyncTabVisibility off the same PID gates that
                                     drive tab visibility (BuildLightbarPreview rebuilds
                                     only on family change). The bar previews the live
                                     LightbarRed/Green/Blue trio, the same properties the
                                     SV picker, sliders, hex box, and preset swatches
                                     write, so it tracks every drag. Presentation is
                                     entirely code-behind (SyncLightbarPreview, riding
                                     OnDeviceConfigChanged): animated modes mirror
                                     the physical bar over time via code-driven
                                     BeginAnimation on the lit group, its shared fill
                                     brush, and its DropShadowEffect bloom (the mini-card
                                     heat-ring pattern), gated on
                                     SystemParameters.ClientAreaAnimation. Never animated
                                     from style triggers. Mode = PlayerNumber (the #191
                                     default) previews the Sony player color for this
                                     slot's number under a locale-neutral GAME WRITES WIN
                                     token (DZ / PEAK radar-legend idiom) whose tooltip
                                     carries the localized Pad_Lighting_Subtitle sentence,
                                     since a game's write takes over and persists there.
                                     Mode = Off is the deliberate hard-off: the strips go
                                     dark, no token (PadForge reasserts black after any
                                     game write's grace). No live game-write flag reaches
                                     this view model (ownership is resolved per-packet
                                     inside UserEffectsDispatcher), so both are mode-only
                                     presentations. Palette and audio modes still preview
                                     the base trio because it is the only single-color
                                     truth the config holds. -->
                                <StackPanel Margin="0,0,0,12" HorizontalAlignment="Left">
                                    <Viewbox Width="260" HorizontalAlignment="Left">
                                        <Grid x:Name="LightbarPreviewHost"/>
                                    </Viewbox>
                                    <TextBlock Text="GAME WRITES WIN" HorizontalAlignment="Center" Margin="0,4,0,0"
                                               FontFamily="{StaticResource TelemetryFontFamily}" FontSize="10"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               ToolTip="{Binding Pad_Lighting_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                               Visibility="{Binding DeviceConfig.LightbarMode, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=PlayerNumber}"/>
                                </StackPanel>

                                <!-- Mode picker -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Pad_Lighting_Mode, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource DzLabel}"/>
                                    <!-- SelectedValue + Tag binding (rather than SelectedIndex
                                         + EnumIndexConverter): the LightbarMode enum has gaps
                                         (11..13 are legacy InputReactive values not exposed in
                                         this dropdown), so item index ≠ enum value. Tag-driven
                                         binding lets us reorder freely without breaking the
                                         enum mapping. Order is grouped by feel: simple time-
                                         based on a single color (Static/Breathing/Strobe),
                                         multi-color time-based (Rainbow/ColorCycle), battery
                                         indicator, then the audio-reactive cluster. -->
                                    <!-- Combo width standard: this card's two combos (mode
                                         picker + input-reactive overlay below) share 444.
                                         Measured, not guessed (tools/combomeasure): a real
                                         WPF-UI ComboBox with this card's implicit style
                                         (Padding 8,4) and the Body font sizes the widest
                                         option, the Spanish audio crossfade mode name, to
                                         435.33px across all 10 locales. 444 leaves about
                                         9px of slack. The popup sizes to its own option
                                         text. Re-measure if these strings change. -->
                                    <ComboBox SelectedValue="{Binding DeviceConfig.LightbarMode, Mode=TwoWay}"
                                              SelectedValuePath="Tag"
                                              Width="444" VerticalAlignment="Center">
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_PlayerNumber, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.PlayerNumber}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_Off, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.Off}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_Static, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.Static}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_Breathing, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.Breathing}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_Strobe, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.Strobe}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_Rainbow, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.Rainbow}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_ColorCycle, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.ColorCycle}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_Battery, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.Battery}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_AudioPulse, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.AudioPulse}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_AudioPulseRandom, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.AudioPulseRandom}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_AudioPulseRainbow, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.AudioPulseRainbow}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_AudioThresholds, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.AudioThresholds}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_AudioGradient, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.AudioGradient}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_AudioCrossFade, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.AudioCrossFade}"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding DeviceConfig.ResetLightbarModeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetLightbarMode, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- LightbarMode-dependent controls live directly under
                                     the mode dropdown so the user reads "I picked Mode X
                                     → here are X's settings" without the InputReactive
                                     dropdown breaking the visual flow. The InputReactive
                                     dropdown + its dependent Hold/Decay/Fixed-color block
                                     moves to the bottom of the card; palette stays in
                                     the middle since it's shared between ColorCycle (base
                                     mode) and InputReactive Cycle (overlay). -->

                                <!-- Period: Breathing / Rainbow / ColorCycle / AudioPulseRainbow / Strobe -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                            Visibility="{Binding DeviceConfig.LightbarMode, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=Breathing|Rainbow|ColorCycle|AudioPulseRainbow|Strobe}">
                                    <TextBlock Text="{Binding Pad_Lighting_Period, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding DeviceConfig.LightbarPeriodMs, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"
                                            Minimum="250" Maximum="10000" TickFrequency="250"/>
                                    <TextBox Text="{Binding DeviceConfig.LightbarPeriodMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding DeviceConfig.ResetLightbarPeriodCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetLightbarPeriod, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Brightness: Rainbow only (no per-color picker so the
                                     user has no other way to dim the effect). -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                            Visibility="{Binding DeviceConfig.LightbarMode, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=Rainbow}">
                                    <TextBlock Text="{Binding Pad_Lighting_RainbowBrightness, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding DeviceConfig.LightbarRainbowBrightness, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"
                                            Minimum="0" Maximum="100" TickFrequency="1"/>
                                    <TextBox Text="{Binding DeviceConfig.LightbarRainbowBrightness, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding DeviceConfig.ResetLightbarRainbowBrightnessCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetLightbarRainbowBrightness, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Smooth toggle (ColorCycle): blend or hop between palette colors -->
                                <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsChecked="{Binding DeviceConfig.LightbarColorCycleSmooth, Mode=TwoWay}"
                                          Content="{Binding Pad_Lighting_ColorCycleSmooth, Source={x:Static strings:Strings.Instance}}"
                                          Margin="0,0,0,8"
                                          Visibility="{Binding DeviceConfig.LightbarMode, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=ColorCycle}"/>

                                <!-- Palette (variable count) — Base instance.
                                     Visible only when LightbarMode = ColorCycle so the
                                     palette sits directly below the dropdown that
                                     reveals it. The InputReactive Cycle overlay has
                                     its own palette instance below the InputReactive
                                     dropdown (same data, different position) so the
                                     editor doesn't appear above the dropdown that
                                     summoned it. ShowPaletteForBase / ShowPaletteForOverlay
                                     are mutually exclusive — palette renders exactly
                                     once at any time. -->
                                <StackPanel Visibility="{Binding DeviceConfig.ShowPaletteForBase, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Pad_Lighting_PaletteHeader, Source={x:Static strings:Strings.Instance}}"
                                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding DeviceConfig.LightbarPalette}" Margin="0,0,0,8">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:LightbarPaletteEntry}">
                                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,8,8"
                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                                    <StackPanel>
                                                        <ui:Button Command="{Binding DataContext.DeviceConfig.RemovePaletteColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   CommandParameter="{Binding}"
                                                                   Style="{StaticResource EmberIconButtonHot}"
                                                                   HorizontalAlignment="Right" Margin="0,0,0,4"
                                                                   ToolTip="{Binding Pad_Lighting_RemoveColor, Source={x:Static strings:Strings.Instance}}">
                                                            <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                        </ui:Button>
                                                        <views:ColorPickerControl HorizontalAlignment="Left" Margin="0,0,0,8"
                                                            Red="{Binding R, Mode=TwoWay}"
                                                            Green="{Binding G, Mode=TwoWay}"
                                                            Blue="{Binding B, Mode=TwoWay}"/>
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Width="36" Height="28" CornerRadius="4"
                                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                                                <Border.Background>
                                                                    <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                                                        <Binding Path="R"/>
                                                                        <Binding Path="G"/>
                                                                        <Binding Path="B"/>
                                                                    </MultiBinding>
                                                                </Border.Background>
                                                            </Border>
                                                            <TextBox Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                     FontFamily="{StaticResource TelemetryFontFamily}" Padding="6,2"
                                                                     Text="{Binding Hex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                     ToolTip="{Binding Pad_Lighting_HexTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                        </Grid>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="R" Style="{StaticResource DzLabelTight}" Foreground="#FFD32F2F"/>
                                                            <Slider Value="{Binding R, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                            <TextBox Text="{Binding R, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="G" Style="{StaticResource DzLabelTight}" Foreground="#FF388E3C"/>
                                                            <Slider Value="{Binding G, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                            <TextBox Text="{Binding G, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="B" Style="{StaticResource DzLabelTight}" Foreground="#FF1976D2"/>
                                                            <Slider Value="{Binding B, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                            <TextBox Text="{Binding B, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Command="{Binding DeviceConfig.AddPaletteColorCommand}"
                                                Padding="10,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Pad_Lighting_AddColor, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DeviceConfig.ResetPaletteCommand}"
                                                Margin="8,0,0,0" Padding="10,4"
                                                ToolTip="{Binding Pad_Lighting_ResetPaletteTooltip, Source={x:Static strings:Strings.Instance}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Pad_Lighting_ResetPalette, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Audio sensitivity: every Audio* mode -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                            Visibility="{Binding DeviceConfig.LightbarMode, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=AudioPulse|AudioPulseRandom|AudioPulseRainbow|AudioThresholds|AudioGradient|AudioCrossFade}">
                                    <TextBlock Text="{Binding Pad_Lighting_AudioLightbar_Sensitivity, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding DeviceConfig.AudioLightbarSensitivity, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"
                                            Minimum="1" Maximum="20" TickFrequency="0.1"/>
                                    <TextBox Text="{Binding DeviceConfig.AudioLightbarSensitivity, Mode=TwoWay, StringFormat=F1, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <ui:Button Command="{Binding DeviceConfig.ResetAudioLightbarSensitivityCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetAudioLightbarSensitivity, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Audio band thresholds (settings) — moved out of the audio
                                     bands wrapper below so settings stay above colours. -->
                                <StackPanel Visibility="{Binding DeviceConfig.LightbarMode, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=AudioThresholds|AudioGradient|AudioCrossFade}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Pad_Lighting_AudioLightbar_LowToMid, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <Slider Value="{Binding DeviceConfig.AudioLowToMidPercent, Mode=TwoWay}"
                                                Style="{StaticResource DzSlider}"
                                                Minimum="0" Maximum="100" TickFrequency="1"/>
                                        <TextBox Text="{Binding DeviceConfig.AudioLowToMidPercent, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding DeviceConfig.ResetAudioLowToMidPercentCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetAudioLowToMidPercent, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Pad_Lighting_AudioLightbar_MidToHigh, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <Slider Value="{Binding DeviceConfig.AudioMidToHighPercent, Mode=TwoWay}"
                                                Style="{StaticResource DzSlider}"
                                                Minimum="0" Maximum="100" TickFrequency="1"/>
                                        <TextBox Text="{Binding DeviceConfig.AudioMidToHighPercent, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding DeviceConfig.ResetAudioMidToHighPercentCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetAudioMidToHighPercent, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Crossfade width (setting) — only meaningful in CrossFade mode -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                            Visibility="{Binding DeviceConfig.LightbarMode, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=AudioCrossFade}">
                                    <TextBlock Text="{Binding Pad_Lighting_AudioLightbar_CrossFadeWidth, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding DeviceConfig.AudioCrossFadePercent, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"
                                            Minimum="0" Maximum="50" TickFrequency="0.5"/>
                                    <TextBox Text="{Binding DeviceConfig.AudioCrossFadePercent, Mode=TwoWay, StringFormat=F1, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding DeviceConfig.ResetAudioCrossFadePercentCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetAudioCrossFadePercent, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Single colour: Static / Breathing / AudioPulse / Strobe base modes.
                                     Strobe square-waves between the configured RGB and
                                     black at LightbarPeriodMs cadence, so it uses the
                                     same base color as the static / breathing modes.
                                     The Input Reactive Fixed overlay has its own color
                                     picker below so users can pick a separate flash
                                     color independent of the base. -->
                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        Visibility="{Binding DeviceConfig.LightbarMode, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=Static|Breathing|AudioPulse|Strobe}">
                                    <StackPanel>
                                        <views:ColorPickerControl Margin="0,0,0,12"
                                            HorizontalAlignment="Left"
                                            Red="{Binding DeviceConfig.LightbarRed, Mode=TwoWay}"
                                            Green="{Binding DeviceConfig.LightbarGreen, Mode=TwoWay}"
                                            Blue="{Binding DeviceConfig.LightbarBlue, Mode=TwoWay}"/>
                                        <!-- Preset swatches (#175 competitor item 6): eight
                                             one-click colors writing the same LightbarRed/
                                             Green/Blue trio the picker binds. Border +
                                             Cursor=Hand + MouseLeftButtonDown follows the
                                             motor-bar click idiom (LeftMotor_Click). Tag
                                             carries RRGGBB like the FormulaPreset_Click
                                             buttons carry their formula. First chip is the
                                             reset-default PlayStation blue (0000FF), last
                                             is the Ember accent. The handler re-syncs the
                                             hex box because that box is code-behind-synced,
                                             not value-bound. -->
                                                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                                        <Border Width="24" Height="24" CornerRadius="6" Margin="0,0,6,0" Cursor="Hand"
                                                Background="{DynamicResource SteelRaisedBrush}"
                                                Tag="0000FF" ToolTip="#0000FF"
                                                MouseLeftButtonDown="LightbarSwatch_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SteelLineSoftBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ColdBrush}"/>
                                                            <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border CornerRadius="3" Margin="3" Background="#FF0000FF" IsHitTestVisible="False"/>
                                        </Border>
                                        <Border Width="24" Height="24" CornerRadius="6" Margin="0,0,6,0" Cursor="Hand"
                                                Background="{DynamicResource SteelRaisedBrush}"
                                                Tag="FF0000" ToolTip="#FF0000"
                                                MouseLeftButtonDown="LightbarSwatch_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SteelLineSoftBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ColdBrush}"/>
                                                            <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border CornerRadius="3" Margin="3" Background="#FFFF0000" IsHitTestVisible="False"/>
                                        </Border>
                                        <Border Width="24" Height="24" CornerRadius="6" Margin="0,0,6,0" Cursor="Hand"
                                                Background="{DynamicResource SteelRaisedBrush}"
                                                Tag="00FF00" ToolTip="#00FF00"
                                                MouseLeftButtonDown="LightbarSwatch_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SteelLineSoftBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ColdBrush}"/>
                                                            <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border CornerRadius="3" Margin="3" Background="#FF00FF00" IsHitTestVisible="False"/>
                                        </Border>
                                        <Border Width="24" Height="24" CornerRadius="6" Margin="0,0,6,0" Cursor="Hand"
                                                Background="{DynamicResource SteelRaisedBrush}"
                                                Tag="FF00FF" ToolTip="#FF00FF"
                                                MouseLeftButtonDown="LightbarSwatch_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SteelLineSoftBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ColdBrush}"/>
                                                            <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border CornerRadius="3" Margin="3" Background="#FFFF00FF" IsHitTestVisible="False"/>
                                        </Border>
                                        <Border Width="24" Height="24" CornerRadius="6" Margin="0,0,6,0" Cursor="Hand"
                                                Background="{DynamicResource SteelRaisedBrush}"
                                                Tag="FFBF00" ToolTip="#FFBF00"
                                                MouseLeftButtonDown="LightbarSwatch_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SteelLineSoftBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ColdBrush}"/>
                                                            <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border CornerRadius="3" Margin="3" Background="#FFFFBF00" IsHitTestVisible="False"/>
                                        </Border>
                                        <Border Width="24" Height="24" CornerRadius="6" Margin="0,0,6,0" Cursor="Hand"
                                                Background="{DynamicResource SteelRaisedBrush}"
                                                Tag="00FFFF" ToolTip="#00FFFF"
                                                MouseLeftButtonDown="LightbarSwatch_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SteelLineSoftBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ColdBrush}"/>
                                                            <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border CornerRadius="3" Margin="3" Background="#FF00FFFF" IsHitTestVisible="False"/>
                                        </Border>
                                        <Border Width="24" Height="24" CornerRadius="6" Margin="0,0,6,0" Cursor="Hand"
                                                Background="{DynamicResource SteelRaisedBrush}"
                                                Tag="FFFFFF" ToolTip="#FFFFFF"
                                                MouseLeftButtonDown="LightbarSwatch_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SteelLineSoftBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ColdBrush}"/>
                                                            <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border CornerRadius="3" Margin="3" Background="#FFFFFFFF" IsHitTestVisible="False"/>
                                        </Border>
                                        <Border Width="24" Height="24" CornerRadius="6" Margin="0,0,6,0" Cursor="Hand"
                                                Background="{DynamicResource SteelRaisedBrush}"
                                                Tag="FF6B2C" ToolTip="#FF6B2C"
                                                MouseLeftButtonDown="LightbarSwatch_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SteelLineSoftBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ColdBrush}"/>
                                                            <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border CornerRadius="3" Margin="3" Background="#FFFF6B2C" IsHitTestVisible="False"/>
                                        </Border>
                                        </StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="48" Height="36" CornerRadius="4"
                                                    HorizontalAlignment="Left"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                                        <Binding Path="DeviceConfig.LightbarRed" />
                                                        <Binding Path="DeviceConfig.LightbarGreen" />
                                                        <Binding Path="DeviceConfig.LightbarBlue" />
                                                    </MultiBinding>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Grid.Column="1" Text="{Binding Pad_Lighting_Hex, Source={x:Static strings:Strings.Instance}}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            <TextBox x:Name="LightbarHexBox" Grid.Column="2" Width="100"
                                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                                     FontFamily="{StaticResource TelemetryFontFamily}" Padding="6,4"
                                                     KeyDown="LightbarHexBox_KeyDown"
                                                     LostFocus="LightbarHexBox_LostFocus"
                                                     ToolTip="{Binding Pad_Lighting_HexTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="R" Style="{StaticResource DzLabelTight}" Foreground="#FFD32F2F"/>
                                            <Slider Value="{Binding DeviceConfig.LightbarRed, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                            <TextBox Text="{Binding DeviceConfig.LightbarRed, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                            <ui:Button Command="{Binding DeviceConfig.ResetLightbarRedCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarRed, Source={x:Static strings:Strings.Instance}}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="G" Style="{StaticResource DzLabelTight}" Foreground="#FF388E3C"/>
                                            <Slider Value="{Binding DeviceConfig.LightbarGreen, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                            <TextBox Text="{Binding DeviceConfig.LightbarGreen, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                            <ui:Button Command="{Binding DeviceConfig.ResetLightbarGreenCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarGreen, Source={x:Static strings:Strings.Instance}}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="B" Style="{StaticResource DzLabelTight}" Foreground="#FF1976D2"/>
                                            <Slider Value="{Binding DeviceConfig.LightbarBlue, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                            <TextBox Text="{Binding DeviceConfig.LightbarBlue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                            <ui:Button Command="{Binding DeviceConfig.ResetLightbarBlueCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarBlue, Source={x:Static strings:Strings.Instance}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Battery mode: Low / Full color pair. Lightbar lerps
                                     from Low (0%) to Full (100%) based on the live
                                     battery percent reported by the controller. Two
                                     side-by-side cards mirror the audio-bands layout
                                     so a user familiar with that pattern immediately
                                     understands the picker. Per-channel ResetButtonTight
                                     next to each R/G/B slider matches the Static base
                                     and audio-band pickers (no standalone "reset all
                                     three" button — there's no precedent for one). -->
                                <StackPanel Visibility="{Binding DeviceConfig.LightbarMode, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=Battery}">
                                    <Grid Margin="0,4,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- LOW (empty) color -->
                                        <Border Grid.Column="0" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Pad_Lighting_BatteryLowColor, Source={x:Static strings:Strings.Instance}}"
                                                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                <views:ColorPickerControl Margin="0,0,0,8"
                                                    HorizontalAlignment="Left"
                                                    Red="{Binding DeviceConfig.LightbarBatteryLowR, Mode=TwoWay}"
                                                    Green="{Binding DeviceConfig.LightbarBatteryLowG, Mode=TwoWay}"
                                                    Blue="{Binding DeviceConfig.LightbarBatteryLowB, Mode=TwoWay}"/>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="36" Height="28" CornerRadius="4"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                                        <Border.Background>
                                                            <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                                                <Binding Path="DeviceConfig.LightbarBatteryLowR" />
                                                                <Binding Path="DeviceConfig.LightbarBatteryLowG" />
                                                                <Binding Path="DeviceConfig.LightbarBatteryLowB" />
                                                            </MultiBinding>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="R" Style="{StaticResource DzLabelTight}" Foreground="#FFD32F2F"/>
                                                    <Slider Value="{Binding DeviceConfig.LightbarBatteryLowR, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding DeviceConfig.LightbarBatteryLowR, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <ui:Button Command="{Binding DeviceConfig.ResetLightbarBatteryLowRCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarRed, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="G" Style="{StaticResource DzLabelTight}" Foreground="#FF388E3C"/>
                                                    <Slider Value="{Binding DeviceConfig.LightbarBatteryLowG, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding DeviceConfig.LightbarBatteryLowG, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <ui:Button Command="{Binding DeviceConfig.ResetLightbarBatteryLowGCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarGreen, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="B" Style="{StaticResource DzLabelTight}" Foreground="#FF1976D2"/>
                                                    <Slider Value="{Binding DeviceConfig.LightbarBatteryLowB, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding DeviceConfig.LightbarBatteryLowB, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <ui:Button Command="{Binding DeviceConfig.ResetLightbarBatteryLowBCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarBlue, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- HIGH (full) color -->
                                        <Border Grid.Column="2" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Pad_Lighting_BatteryHighColor, Source={x:Static strings:Strings.Instance}}"
                                                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                <views:ColorPickerControl Margin="0,0,0,8"
                                                    HorizontalAlignment="Left"
                                                    Red="{Binding DeviceConfig.LightbarBatteryHighR, Mode=TwoWay}"
                                                    Green="{Binding DeviceConfig.LightbarBatteryHighG, Mode=TwoWay}"
                                                    Blue="{Binding DeviceConfig.LightbarBatteryHighB, Mode=TwoWay}"/>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="36" Height="28" CornerRadius="4"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                                        <Border.Background>
                                                            <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                                                <Binding Path="DeviceConfig.LightbarBatteryHighR" />
                                                                <Binding Path="DeviceConfig.LightbarBatteryHighG" />
                                                                <Binding Path="DeviceConfig.LightbarBatteryHighB" />
                                                            </MultiBinding>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="R" Style="{StaticResource DzLabelTight}" Foreground="#FFD32F2F"/>
                                                    <Slider Value="{Binding DeviceConfig.LightbarBatteryHighR, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding DeviceConfig.LightbarBatteryHighR, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <ui:Button Command="{Binding DeviceConfig.ResetLightbarBatteryHighRCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarRed, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="G" Style="{StaticResource DzLabelTight}" Foreground="#FF388E3C"/>
                                                    <Slider Value="{Binding DeviceConfig.LightbarBatteryHighG, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding DeviceConfig.LightbarBatteryHighG, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <ui:Button Command="{Binding DeviceConfig.ResetLightbarBatteryHighGCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarGreen, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="B" Style="{StaticResource DzLabelTight}" Foreground="#FF1976D2"/>
                                                    <Slider Value="{Binding DeviceConfig.LightbarBatteryHighB, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding DeviceConfig.LightbarBatteryHighB, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <ui:Button Command="{Binding DeviceConfig.ResetLightbarBatteryHighBCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarBlue, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>

                                <!-- Audio bands: 3 colors with thresholds, only visible
                                     when LightbarMode is AudioThresholds, AudioGradient,
                                     or AudioCrossFade. Lives inside the consolidated
                                     Lightbar border so the user has a single place
                                     to configure every effect mode. -->
                                <StackPanel Visibility="{Binding DeviceConfig.LightbarMode, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=AudioThresholds|AudioGradient|AudioCrossFade}">
                                    <Grid Margin="0,4,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- LOW (quiet) color -->
                                        <Border Grid.Column="0" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Pad_Lighting_AudioLightbar_LowColor, Source={x:Static strings:Strings.Instance}}"
                                                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                <views:ColorPickerControl Margin="0,0,0,8"
                                                    HorizontalAlignment="Left"
                                                    Red="{Binding DeviceConfig.AudioLowR, Mode=TwoWay}"
                                                    Green="{Binding DeviceConfig.AudioLowG, Mode=TwoWay}"
                                                    Blue="{Binding DeviceConfig.AudioLowB, Mode=TwoWay}"/>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="36" Height="28" CornerRadius="4"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                                        <Border.Background>
                                                            <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                                                <Binding Path="DeviceConfig.AudioLowR" />
                                                                <Binding Path="DeviceConfig.AudioLowG" />
                                                                <Binding Path="DeviceConfig.AudioLowB" />
                                                            </MultiBinding>
                                                        </Border.Background>
                                                    </Border>
                                                    <TextBox x:Name="AudioLowHexBox" Grid.Column="1" Tag="Low"
                                                             Margin="6,0,0,0" VerticalAlignment="Center"
                                                             FontFamily="{StaticResource TelemetryFontFamily}" Padding="6,2"
                                                             KeyDown="AudioHexBox_KeyDown"
                                                             LostFocus="AudioHexBox_LostFocus"
                                                             ToolTip="{Binding Pad_Lighting_HexTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="R" Style="{StaticResource DzLabelTight}" Foreground="#FFD32F2F"/>
                                                    <Slider Value="{Binding DeviceConfig.AudioLowR, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding DeviceConfig.AudioLowR, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <ui:Button Command="{Binding DeviceConfig.ResetAudioLowRCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetAudioLowR, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="G" Style="{StaticResource DzLabelTight}" Foreground="#FF388E3C"/>
                                                    <Slider Value="{Binding DeviceConfig.AudioLowG, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding DeviceConfig.AudioLowG, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <ui:Button Command="{Binding DeviceConfig.ResetAudioLowGCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetAudioLowG, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="B" Style="{StaticResource DzLabelTight}" Foreground="#FF1976D2"/>
                                                    <Slider Value="{Binding DeviceConfig.AudioLowB, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding DeviceConfig.AudioLowB, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <ui:Button Command="{Binding DeviceConfig.ResetAudioLowBCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetAudioLowB, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- MID (medium) color -->
                                        <Border Grid.Column="2" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Pad_Lighting_AudioLightbar_MidColor, Source={x:Static strings:Strings.Instance}}"
                                                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                <views:ColorPickerControl Margin="0,0,0,8"
                                                    HorizontalAlignment="Left"
                                                    Red="{Binding DeviceConfig.AudioMidR, Mode=TwoWay}"
                                                    Green="{Binding DeviceConfig.AudioMidG, Mode=TwoWay}"
                                                    Blue="{Binding DeviceConfig.AudioMidB, Mode=TwoWay}"/>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="36" Height="28" CornerRadius="4"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                                        <Border.Background>
                                                            <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                                                <Binding Path="DeviceConfig.AudioMidR" />
                                                                <Binding Path="DeviceConfig.AudioMidG" />
                                                                <Binding Path="DeviceConfig.AudioMidB" />
                                                            </MultiBinding>
                                                        </Border.Background>
                                                    </Border>
                                                    <TextBox x:Name="AudioMidHexBox" Grid.Column="1" Tag="Mid"
                                                             Margin="6,0,0,0" VerticalAlignment="Center"
                                                             FontFamily="{StaticResource TelemetryFontFamily}" Padding="6,2"
                                                             KeyDown="AudioHexBox_KeyDown"
                                                             LostFocus="AudioHexBox_LostFocus"
                                                             ToolTip="{Binding Pad_Lighting_HexTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="R" Style="{StaticResource DzLabelTight}" Foreground="#FFD32F2F"/>
                                                    <Slider Value="{Binding DeviceConfig.AudioMidR, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding DeviceConfig.AudioMidR, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <ui:Button Command="{Binding DeviceConfig.ResetAudioMidRCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetAudioMidR, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="G" Style="{StaticResource DzLabelTight}" Foreground="#FF388E3C"/>
                                                    <Slider Value="{Binding DeviceConfig.AudioMidG, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding DeviceConfig.AudioMidG, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <ui:Button Command="{Binding DeviceConfig.ResetAudioMidGCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetAudioMidG, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="B" Style="{StaticResource DzLabelTight}" Foreground="#FF1976D2"/>
                                                    <Slider Value="{Binding DeviceConfig.AudioMidB, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding DeviceConfig.AudioMidB, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <ui:Button Command="{Binding DeviceConfig.ResetAudioMidBCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetAudioMidB, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- HIGH (loud) color -->
                                        <Border Grid.Column="4" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Pad_Lighting_AudioLightbar_HighColor, Source={x:Static strings:Strings.Instance}}"
                                                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                <views:ColorPickerControl Margin="0,0,0,8"
                                                    HorizontalAlignment="Left"
                                                    Red="{Binding DeviceConfig.AudioHighR, Mode=TwoWay}"
                                                    Green="{Binding DeviceConfig.AudioHighG, Mode=TwoWay}"
                                                    Blue="{Binding DeviceConfig.AudioHighB, Mode=TwoWay}"/>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="36" Height="28" CornerRadius="4"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                                        <Border.Background>
                                                            <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                                                <Binding Path="DeviceConfig.AudioHighR" />
                                                                <Binding Path="DeviceConfig.AudioHighG" />
                                                                <Binding Path="DeviceConfig.AudioHighB" />
                                                            </MultiBinding>
                                                        </Border.Background>
                                                    </Border>
                                                    <TextBox x:Name="AudioHighHexBox" Grid.Column="1" Tag="High"
                                                             Margin="6,0,0,0" VerticalAlignment="Center"
                                                             FontFamily="{StaticResource TelemetryFontFamily}" Padding="6,2"
                                                             KeyDown="AudioHexBox_KeyDown"
                                                             LostFocus="AudioHexBox_LostFocus"
                                                             ToolTip="{Binding Pad_Lighting_HexTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="R" Style="{StaticResource DzLabelTight}" Foreground="#FFD32F2F"/>
                                                    <Slider Value="{Binding DeviceConfig.AudioHighR, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding DeviceConfig.AudioHighR, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <ui:Button Command="{Binding DeviceConfig.ResetAudioHighRCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetAudioHighR, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="G" Style="{StaticResource DzLabelTight}" Foreground="#FF388E3C"/>
                                                    <Slider Value="{Binding DeviceConfig.AudioHighG, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding DeviceConfig.AudioHighG, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <ui:Button Command="{Binding DeviceConfig.ResetAudioHighGCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetAudioHighG, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="B" Style="{StaticResource DzLabelTight}" Foreground="#FF1976D2"/>
                                                    <Slider Value="{Binding DeviceConfig.AudioHighB, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding DeviceConfig.AudioHighB, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <ui:Button Command="{Binding DeviceConfig.ResetAudioHighBCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetAudioHighB, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                </StackPanel>

                                <!-- Input Reactive overlay (v3.2+). Layered on top of the
                                     base mode above: a button-press flashes the chosen
                                     reactive color and decays back to the base. Off keeps
                                     the base mode untouched. Random rolls a hue per press,
                                     Cycle steps through the palette, Fixed flashes the
                                     base RGB color. Placed at the bottom of the lightbar
                                     card so the LightbarMode dropdown's mode-specific
                                     settings sit immediately under it without the
                                     InputReactive controls breaking up the visual flow. -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Pad_Lighting_InputReactive, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource DzLabel}"/>
                                    <ComboBox SelectedIndex="{Binding DeviceConfig.InputReactiveMode, Mode=TwoWay, Converter={StaticResource EnumIndexConverter}}"
                                              Width="444" VerticalAlignment="Center">
                                        <ComboBoxItem Content="{Binding Pad_Lighting_InputReactive_Off, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_InputReactive_Random, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_InputReactive_Cycle, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_InputReactive_Fixed, Source={x:Static strings:Strings.Instance}}"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding DeviceConfig.ResetInputReactiveModeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetInputReactive, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- InputReactive controls. Hold + Decay sliders show whenever
                                     the input-reactive overlay is enabled in any variant —
                                     Random / Cycle / Fixed. Hold may be 0 for instant fade;
                                     Decay may be 0 for clean on/off with no fade. Placed
                                     before the Fixed color picker so the timing controls
                                     (which apply to every variant) read ahead of the
                                     variant-specific color block. -->
                                <StackPanel Visibility="{Binding DeviceConfig.IsInputReactiveActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Pad_Lighting_InputHold, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <Slider Value="{Binding DeviceConfig.LightbarInputHoldMs, Mode=TwoWay}"
                                                Style="{StaticResource DzSlider}"
                                                Minimum="0" Maximum="5000" TickFrequency="50"/>
                                        <TextBox Text="{Binding DeviceConfig.LightbarInputHoldMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding DeviceConfig.ResetLightbarInputHoldCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetLightbarInputHold, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Pad_Lighting_InputDecay, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <Slider Value="{Binding DeviceConfig.LightbarInputDecayMs, Mode=TwoWay}"
                                                Style="{StaticResource DzSlider}"
                                                Minimum="0" Maximum="5000" TickFrequency="50"/>
                                        <TextBox Text="{Binding DeviceConfig.LightbarInputDecayMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding DeviceConfig.ResetLightbarInputDecayCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetLightbarInputDecay, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Palette (variable count) — Overlay instance.
                                     Visible only when InputReactive = Cycle AND
                                     LightbarMode != ColorCycle (so this never co-renders
                                     with the Base palette instance above). Same data,
                                     placed here so the palette sits directly below the
                                     InputReactive dropdown that revealed it. -->
                                <StackPanel Visibility="{Binding DeviceConfig.ShowPaletteForOverlay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Pad_Lighting_PaletteHeader, Source={x:Static strings:Strings.Instance}}"
                                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <!-- Bound to the InputReactive Cycle's OWN palette, separate from the
                                         ColorCycle palette above — editing one no longer touches the other. -->
                                    <ItemsControl ItemsSource="{Binding DeviceConfig.LightbarInputReactivePalette}" Margin="0,0,0,8">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:LightbarPaletteEntry}">
                                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,8,8"
                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                                    <StackPanel>
                                                        <ui:Button Command="{Binding DataContext.DeviceConfig.RemoveInputReactivePaletteColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   CommandParameter="{Binding}"
                                                                   Style="{StaticResource EmberIconButtonHot}"
                                                                   HorizontalAlignment="Right" Margin="0,0,0,4"
                                                                   ToolTip="{Binding Pad_Lighting_RemoveColor, Source={x:Static strings:Strings.Instance}}">
                                                            <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                        </ui:Button>
                                                        <views:ColorPickerControl HorizontalAlignment="Left" Margin="0,0,0,8"
                                                            Red="{Binding R, Mode=TwoWay}"
                                                            Green="{Binding G, Mode=TwoWay}"
                                                            Blue="{Binding B, Mode=TwoWay}"/>
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Width="36" Height="28" CornerRadius="4"
                                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                                                <Border.Background>
                                                                    <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                                                        <Binding Path="R"/>
                                                                        <Binding Path="G"/>
                                                                        <Binding Path="B"/>
                                                                    </MultiBinding>
                                                                </Border.Background>
                                                            </Border>
                                                            <TextBox Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                     FontFamily="{StaticResource TelemetryFontFamily}" Padding="6,2"
                                                                     Text="{Binding Hex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                     ToolTip="{Binding Pad_Lighting_HexTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                        </Grid>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="R" Style="{StaticResource DzLabelTight}" Foreground="#FFD32F2F"/>
                                                            <Slider Value="{Binding R, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                            <TextBox Text="{Binding R, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="G" Style="{StaticResource DzLabelTight}" Foreground="#FF388E3C"/>
                                                            <Slider Value="{Binding G, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                            <TextBox Text="{Binding G, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="B" Style="{StaticResource DzLabelTight}" Foreground="#FF1976D2"/>
                                                            <Slider Value="{Binding B, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                            <TextBox Text="{Binding B, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Command="{Binding DeviceConfig.AddInputReactivePaletteColorCommand}"
                                                Padding="10,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Pad_Lighting_AddColor, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DeviceConfig.ResetInputReactivePaletteCommand}"
                                                Margin="8,0,0,0" Padding="10,4"
                                                ToolTip="{Binding Pad_Lighting_ResetPaletteTooltip, Source={x:Static strings:Strings.Instance}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Pad_Lighting_ResetPalette, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Per-press flash color for the Fixed overlay variant.
                                     Independent of LightbarRed/Green/Blue (which drives
                                     the base mode color), so users can layer a base
                                     color with a different flash color. -->
                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        Visibility="{Binding DeviceConfig.IsInputReactiveFixed, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Pad_Lighting_InputReactive_FixedColor, Source={x:Static strings:Strings.Instance}}"
                                                   FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <views:ColorPickerControl Margin="0,0,0,12"
                                            HorizontalAlignment="Left"
                                            Red="{Binding DeviceConfig.InputReactiveR, Mode=TwoWay}"
                                            Green="{Binding DeviceConfig.InputReactiveG, Mode=TwoWay}"
                                            Blue="{Binding DeviceConfig.InputReactiveB, Mode=TwoWay}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="R" Style="{StaticResource DzLabelTight}" Foreground="#FFD32F2F"/>
                                            <Slider Value="{Binding DeviceConfig.InputReactiveR, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                            <TextBox Text="{Binding DeviceConfig.InputReactiveR, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                            <ui:Button Command="{Binding DeviceConfig.ResetInputReactiveRCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarRed, Source={x:Static strings:Strings.Instance}}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="G" Style="{StaticResource DzLabelTight}" Foreground="#FF388E3C"/>
                                            <Slider Value="{Binding DeviceConfig.InputReactiveG, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                            <TextBox Text="{Binding DeviceConfig.InputReactiveG, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                            <ui:Button Command="{Binding DeviceConfig.ResetInputReactiveGCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarGreen, Source={x:Static strings:Strings.Instance}}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="B" Style="{StaticResource DzLabelTight}" Foreground="#FF1976D2"/>
                                            <Slider Value="{Binding DeviceConfig.InputReactiveB, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                            <TextBox Text="{Binding DeviceConfig.InputReactiveB, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                            <ui:Button Command="{Binding DeviceConfig.ResetInputReactiveBCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarBlue, Source={x:Static strings:Strings.Instance}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Indicator LEDs — player number row + mic mute LED.
                             Grouped under one section because they share the
                             firmware's single brightness register (byte 42).
                             OpenRGB shows brightness as a property of every
                             mode (Direct / Mic Off / Mic Pulse) for the same
                             reason — there's only one register on the device.
                             DualSense / DualSense Edge only — DS4 has neither
                             player LEDs nor a mic LED, so the card is hidden
                             on DS4 slots via SyncTabVisibility. -->
                        <Border x:Name="IndicatorLedsCard" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xEF31;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_Lighting_IndicatorLeds, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding DeviceConfig.ResetIndicatorLedsAllCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetIndicatorLeds, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Pad_Lighting_IndicatorLeds_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}"/>

                                <!-- Shared brightness — physically writes byte 42
                                     ledBrightness, which the DS5 firmware uses
                                     for the player LED row. Mute LED has only
                                     mode (Off / Solid / Pulse) — no register. -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Pad_Lighting_LedBrightness, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <!-- Combo width standard: all four combos in this card
                                         share 340. Measured, not guessed: a real WPF-UI
                                         ComboBox rendered with this card's implicit style
                                         (BasedOn DefaultComboBoxStyle, Padding 8,4) and the
                                         Body font sizes the widest option, the Spanish
                                         player pattern "Numero de jugador (predeterminado)"
                                         WITH the 5-pip prefix, to 330.67px. 340 leaves
                                         about 9px of slack. Re-measure if these strings or
                                         the pip row change (tools/combomeasure). -->
                                    <ComboBox SelectedIndex="{Binding DeviceConfig.PlayerLedBrightness, Mode=TwoWay, Converter={StaticResource EnumIndexConverter}}"
                                              Width="340" VerticalAlignment="Center">
                                        <ComboBoxItem Content="{Binding Pad_Lighting_PlayerLed_Brightness_High, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_PlayerLed_Brightness_Medium, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_PlayerLed_Brightness_Low, Source={x:Static strings:Strings.Instance}}"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding DeviceConfig.ResetPlayerLedBrightnessCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetLedBrightness, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Player pattern. Every option renders its own 5-dot
                                     pip row (#175 competitor item 6): lit pips ember,
                                     unlit pips steel outlines, mirroring the wire
                                     patterns the synthesizer drives at byte 43
                                     (Ds5EffectSynthesizer.PlayerLedBits: Off=0x00,
                                     P1=0x04, P2=0x0A, P3=0x15, P4=0x1B, All=0x1F, bit N
                                     lighting LED N of the 5-LED strip below the
                                     touchpad). Pips live in each item's ContentTemplate
                                     rather than as element Content, so the closed
                                     combo's selection box instantiates its own copy of
                                     the template instead of stealing the popup item's
                                     visual. Content stays the localized string and the
                                     SelectedIndex + EnumIndexConverter contract is
                                     unchanged. -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Pad_Lighting_PlayerPattern, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <!-- SelectedValue + Tag binding (the LightbarMode combo's
                                         pattern): PlayerNumber (6) leads the list while Off (0)
                                         stays second, so item index no longer equals enum
                                         value and EnumIndexConverter can't apply. -->
                                    <ComboBox SelectedValue="{Binding DeviceConfig.PlayerLedMode, Mode=TwoWay}"
                                              SelectedValuePath="Tag"
                                              Width="340" VerticalAlignment="Center">
                                        <ComboBox.Resources>
                                            <Style x:Key="LedPipOn" TargetType="Ellipse">
                                                <Setter Property="Width" Value="6"/>
                                                <Setter Property="Height" Value="6"/>
                                                <Setter Property="Margin" Value="0,0,3,0"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                            </Style>
                                            <Style x:Key="LedPipOff" TargetType="Ellipse" BasedOn="{StaticResource LedPipOn}">
                                                <Setter Property="Fill" Value="Transparent"/>
                                                <Setter Property="Stroke" Value="{DynamicResource SteelLineBrush}"/>
                                                <Setter Property="StrokeThickness" Value="1"/>
                                            </Style>
                                            <!-- Auto pip: hollow like Off but ember-stroked, reading
                                                 as "lights up, pattern follows the player number". -->
                                            <Style x:Key="LedPipAuto" TargetType="Ellipse" BasedOn="{StaticResource LedPipOff}">
                                                <Setter Property="Stroke" Value="{DynamicResource EmberBrush}"/>
                                            </Style>
                                        </ComboBox.Resources>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_PlayerLed_PlayerNumber, Source={x:Static strings:Strings.Instance}}"
                                                      Tag="{x:Static vm:PlayerLedMode.PlayerNumber}">
                                            <ComboBoxItem.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <Ellipse Style="{StaticResource LedPipAuto}"/>
                                                            <Ellipse Style="{StaticResource LedPipAuto}"/>
                                                            <Ellipse Style="{StaticResource LedPipAuto}"/>
                                                            <Ellipse Style="{StaticResource LedPipAuto}"/>
                                                            <Ellipse Style="{StaticResource LedPipAuto}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBoxItem.ContentTemplate>
                                        </ComboBoxItem>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_PlayerLed_Off, Source={x:Static strings:Strings.Instance}}"
                                                      Tag="{x:Static vm:PlayerLedMode.Off}">
                                            <ComboBoxItem.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBoxItem.ContentTemplate>
                                        </ComboBoxItem>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_PlayerLed_P1, Source={x:Static strings:Strings.Instance}}"
                                                      Tag="{x:Static vm:PlayerLedMode.Player1}">
                                            <ComboBoxItem.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBoxItem.ContentTemplate>
                                        </ComboBoxItem>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_PlayerLed_P2, Source={x:Static strings:Strings.Instance}}"
                                                      Tag="{x:Static vm:PlayerLedMode.Player2}">
                                            <ComboBoxItem.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBoxItem.ContentTemplate>
                                        </ComboBoxItem>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_PlayerLed_P3, Source={x:Static strings:Strings.Instance}}"
                                                      Tag="{x:Static vm:PlayerLedMode.Player3}">
                                            <ComboBoxItem.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBoxItem.ContentTemplate>
                                        </ComboBoxItem>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_PlayerLed_P4, Source={x:Static strings:Strings.Instance}}"
                                                      Tag="{x:Static vm:PlayerLedMode.Player4}">
                                            <ComboBoxItem.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBoxItem.ContentTemplate>
                                        </ComboBoxItem>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_PlayerLed_All, Source={x:Static strings:Strings.Instance}}"
                                                      Tag="{x:Static vm:PlayerLedMode.All}">
                                            <ComboBoxItem.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBoxItem.ContentTemplate>
                                        </ComboBoxItem>
                                    </ComboBox>
                                    <ui:Button Command="{Binding DeviceConfig.ResetPlayerLedModeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetPlayerPattern, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Mute LED mode -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Pad_Lighting_MuteLedMode, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ComboBox SelectedIndex="{Binding DeviceConfig.MicLedMode, Mode=TwoWay, Converter={StaticResource EnumIndexConverter}}"
                                              Width="340" VerticalAlignment="Center">
                                        <ComboBoxItem Content="{Binding Pad_Lighting_MicLed_Off, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_MicLed_Solid, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_MicLed_Pulse, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_MicLed_FollowDevice, Source={x:Static strings:Strings.Instance}}"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding DeviceConfig.ResetMicLedModeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetMuteLedMode, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Audio endpoint picker, only visible when MicLed mode
                                     is FollowDeviceMute. Lists every active input + output
                                     endpoint (each prefixed [In] / [Out]); the synthesizer
                                     polls the picked endpoint's mute state at 4 Hz and
                                     drives the LED Solid (muted) or Off (unmuted). The
                                     DropDownOpened handler refreshes the list so unplug /
                                     replug between settings opens is reflected. -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            Visibility="{Binding DeviceConfig.IsMicLedFollowDevice, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Pad_Lighting_MicLed_FollowDevice_Picker, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ComboBox x:Name="MicLedDevicePicker"
                                              ItemsSource="{Binding DeviceConfig.MicLedAvailableDevices}"
                                              DisplayMemberPath="Display"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding DeviceConfig.MicLedFollowDeviceId, Mode=TwoWay}"
                                              DropDownOpened="MicLedDevicePicker_DropDownOpened"
                                              Width="340" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Guide Button LED (#209): the glowing Guide /
                             Home button on Xbox One-and-later pads (USB
                             only, via the \\.\XboxGIP GIP LED command),
                             the 2015 Steam Controller (SDL's process-global
                             home-LED hint, so every 2015 SC in the process
                             shares one brightness), and the Switch home LED
                             population (#226: Pro Controller, right Joy-Con,
                             combined pair, charging grip; per-device
                             SDL_SetJoystickLED, variable 4-bit intensity).
                             Shown by SyncTabVisibility when the selected
                             device is XInput-pathed, a 2015 Steam
                             Controller, or a Switch home-LED device; the
                             lightbar card and header hints hide when the
                             tab is up for a guide-LED-only device. -->
                        <Border x:Name="GuideLedCard" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_Lighting_GuideLed, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding DeviceConfig.ResetGuideLedAllCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetGuideLed, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Pad_Lighting_GuideLed_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}"/>

                                <!-- Mode. Sequential enum, so SelectedIndex +
                                     EnumIndexConverter like the brightness combo
                                     on the indicator-LEDs card. -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Pad_Lighting_Mode, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ComboBox SelectedIndex="{Binding DeviceConfig.GuideLedMode, Mode=TwoWay, Converter={StaticResource EnumIndexConverter}}"
                                              Width="340" VerticalAlignment="Center"
                                              ToolTip="{Binding Pad_Lighting_GuideLed_Mode_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                        <ComboBoxItem Content="{Binding Pad_Lighting_GuideLed_DeviceDefault, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_GuideLed_Fixed, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_GuideLed_Battery, Source={x:Static strings:Strings.Instance}}"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding DeviceConfig.ResetGuideLedModeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetGuideLedMode, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Brightness, Fixed mode only. Battery mode
                                     derives its level from the charge percent. -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding DeviceConfig.IsGuideLedFixed, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Pad_Lighting_GuideLed_Brightness, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding DeviceConfig.GuideLedBrightness, Mode=TwoWay}" Minimum="0" Maximum="100"
                                            Width="180" VerticalAlignment="Center"
                                            ToolTip="{Binding Pad_Lighting_GuideLed_Brightness_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding DeviceConfig.GuideLedBrightness, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="%" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    <ui:Button Command="{Binding DeviceConfig.ResetGuideLedBrightnessCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetGuideLedBrightness, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════════════════════════
                 TAB 8: GYRO
                 (visible when the selected mapped device has a gyroscope)
                 ══════════════════════════════════════ -->
            <TabItem>
                <ScrollViewer Padding="24,0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE7AD;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Pad_Gyro_Header, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource TitleTextBlockStyle}" FontFamily="{StaticResource DisplayFontFamily}" FontWeight="650" FontSize="26"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Pad_Gyro_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- ─── Motion Passthrough card ─── -->
                        <!-- Tab-wide scope toggle: whether this tab's tuning
                             reaches the virtual controller's motion passthrough
                             (gyro report + DSU), not only gyro-as-mapping-source.
                             Uses CardBorder's default bottom-12 margin so the
                             gap between this and the Calibration card matches
                             every other adjacent-card gap on the Pad page. -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_Gyro_Passthrough_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding ResetGyroApplyToPassthroughCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_Gyro_ResetPassthrough_All_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Gyro_ApplyToPassthrough, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding GyroApplyTuningToPassthrough, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,4,0"
                                              ToolTip="{Binding Pad_Gyro_ApplyToPassthrough_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Command="{Binding ResetGyroApplyToPassthroughCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroApplyToPassthrough, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ─── Motion Steering card (#94) — settings for the "Motion Lean"
                             INPUT (tilt deadzones + grip orientation, per assigned device).
                             Motion Lean itself is a normal input descriptor: the user maps
                             it to an axis from the input dropdown in Mappings, like any
                             gyro input. This card never targets or overrides an axis. -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Viewbox Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="{DynamicResource EmberBrush}" StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M5,12 A7,7 0 1 1 19,12 A7,7 0 1 1 5,12 Z M10.1,12 A1.9,1.9 0 1 1 13.9,12 A1.9,1.9 0 1 1 10.1,12 Z M10.1,12 L5,12 M13.9,12 L19,12 M12,13.9 L12,19"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding Pad_MotionSteer_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding ResetMotionSteerAllCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_MotionSteer_Reset_All, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Pad_MotionSteer_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}"/>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Pad_Steering_MotionInnerDz, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <Slider Value="{Binding MotionSteerInnerDz, Mode=TwoWay}" Minimum="0" Maximum="179" Style="{StaticResource DzSlider}"/>
                                        <TextBox Text="{Binding MotionSteerInnerDz, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="&#176;" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding ResetMotionSteerInnerCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_MotionInnerDz, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Pad_Steering_MotionOuterDz, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <Slider Value="{Binding MotionSteerOuterDz, Mode=TwoWay}" Minimum="0" Maximum="179" Style="{StaticResource DzSlider}"/>
                                        <TextBox Text="{Binding MotionSteerOuterDz, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="&#176;" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding ResetMotionSteerOuterCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_MotionOuterDz, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Pad_Steering_Orientation, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <ComboBox SelectedIndex="{Binding MotionSteerOrientIndex, Mode=TwoWay}" Width="200" VerticalAlignment="Center">
                                            <ComboBoxItem Content="{Binding Pad_Steering_Orient_Forward, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding Pad_Steering_Orient_Left, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding Pad_Steering_Orient_Right, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding Pad_Steering_Orient_Backward, Source={x:Static strings:Strings.Instance}}"/>
                                        </ComboBox>
                                        <ui:Button Command="{Binding ResetMotionSteerOrientCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_Orientation, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ─── Calibration card ─── -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xF272;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_Gyro_Calibration_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding ResetGyroCalibrationCardCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_Gyro_ResetCalibration_All_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="{Binding Settings_GyroCalibrate_Button, Source={x:Static strings:Strings.Instance}}"
                                            Command="{Binding GyroCalibrateCommand}"
                                            Padding="10,4" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroCalibrate_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Settings_GyroResetCalibration_Button, Source={x:Static strings:Strings.Instance}}"
                                            Command="{Binding GyroResetCalibrationCommand}"
                                            Padding="10,4" Margin="6,0,0,0" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroResetCalibration_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBlock Text="{Binding GyroCalibrationLabel}"
                                               FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- Live readouts. Calibrated gyro rate (deg/s) and
                                     raw accelerometer (g). Telemetry values at mono 12
                                     to match the FFB motor instrument values (#175
                                     typography). Axis labels spelled out (Pitch / Yaw /
                                     Roll) instead of single-letter abbreviations.
                                     Per-axis Width is wide enough to hold the longest
                                     realistic value without text truncation. -->
                                <!-- Cold telemetry (#175 iteration 30): raw sensor truth
                                     inside an inset instrument panel, matching the trigger
                                     and motor instruments. -->
                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4,0,0"
                                        HorizontalAlignment="Left">
                                <StackPanel>
                                <TextBlock Text="{Binding Instr_Raw, Source={x:Static strings:Strings.Instance}}"
                                           FontFamily="{StaticResource TelemetryFontFamily}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Settings_GyroLiveRate_Label, Source={x:Static strings:Strings.Instance}}"
                                               FontSize="14" Width="160" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding GyroLiveRatePitch, StringFormat={}Pitch {0:+0.0;-0.0;0.0}°/s}"
                                               Foreground="{DynamicResource ColdBrush}"
                                               FontFamily="{StaticResource TelemetryFontFamily}"
                                               FontSize="12" Width="120" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding GyroLiveRateYaw,   StringFormat={}Yaw {0:+0.0;-0.0;0.0}°/s}"
                                               Foreground="{DynamicResource ColdBrush}"
                                               FontFamily="{StaticResource TelemetryFontFamily}"
                                               FontSize="12" Width="112" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding GyroLiveRateRoll,  StringFormat={}Roll {0:+0.0;-0.0;0.0}°/s}"
                                               Foreground="{DynamicResource ColdBrush}"
                                               FontFamily="{StaticResource TelemetryFontFamily}"
                                               FontSize="12" Width="116" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Settings_GyroLiveAccel_Label, Source={x:Static strings:Strings.Instance}}"
                                               FontSize="14" Width="160" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AccelLiveX, StringFormat={}X {0:+0.00;-0.00;0.00}g}"
                                               Foreground="{DynamicResource ColdBrush}"
                                               FontFamily="{StaticResource TelemetryFontFamily}"
                                               FontSize="12" Width="120" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AccelLiveY, StringFormat={}Y {0:+0.00;-0.00;0.00}g}"
                                               Foreground="{DynamicResource ColdBrush}"
                                               FontFamily="{StaticResource TelemetryFontFamily}"
                                               FontSize="12" Width="112" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AccelLiveZ, StringFormat={}Z {0:+0.00;-0.00;0.00}g}"
                                               Foreground="{DynamicResource ColdBrush}"
                                               FontFamily="{StaticResource TelemetryFontFamily}"
                                               FontSize="12" Width="116" VerticalAlignment="Center"/>
                                </StackPanel>
                                </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ─── Sensitivity card ─── -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE9E9;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_Gyro_Sensitivity_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding ResetGyroSensitivityCardCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_Gyro_ResetSensitivity_All_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Settings_GyroSensitivityUnits, Source={x:Static strings:Strings.Instance}}"
                                               Width="270" VerticalAlignment="Center"
                                               ToolTip="{Binding Settings_GyroSensitivityUnits_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBox ItemsSource="{Binding GyroSensitivityUnitsOptions}"
                                              SelectedValue="{Binding GyroSensitivityUnits, Mode=TwoWay}"
                                              SelectedValuePath="Value" DisplayMemberPath="Display"
                                              Width="200" VerticalAlignment="Center"
                                              ToolTip="{Binding Settings_GyroSensitivityUnits_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Command="{Binding ResetGyroSensitivityUnitsCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroSensitivityUnits, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Player/World Space — Jibb's recommended default
                                     is Player Space; we keep Local as the conservative default
                                     so existing configs feel identical. -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Settings_GyroSpace, Source={x:Static strings:Strings.Instance}}"
                                               Width="270" VerticalAlignment="Center"
                                               ToolTip="{Binding Settings_GyroSpace_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBox ItemsSource="{Binding GyroSpaceOptions}"
                                              SelectedValue="{Binding GyroSpace, Mode=TwoWay}"
                                              SelectedValuePath="Value" DisplayMemberPath="Display"
                                              Width="200" VerticalAlignment="Center"
                                              ToolTip="{Binding Settings_GyroSpace_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Command="{Binding ResetGyroSpaceCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroSpace, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Settings_GyroSensitivityH, Source={x:Static strings:Strings.Instance}}"
                                               Width="270" VerticalAlignment="Center"
                                               ToolTip="{Binding Settings_GyroSensitivityH_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding GyroSensitivityH, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="0.1" Maximum="10" SmallChange="0.1" LargeChange="1"
                                            Width="200" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroSensitivityH_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding GyroSensitivityH, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                             Width="56" Margin="6,0,0,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="×" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <ui:Button Command="{Binding ResetGyroSensitivityHCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroSensitivityH, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBlock Text="{Binding GyroSensitivityH_DegPerTurn, StringFormat={}≈ {0:0}°/turn}"
                                               FontFamily="{StaticResource TelemetryFontFamily}"
                                               VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Settings_GyroSensitivityV, Source={x:Static strings:Strings.Instance}}"
                                               Width="270" VerticalAlignment="Center"
                                               ToolTip="{Binding Settings_GyroSensitivityV_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding GyroSensitivityV, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="0.1" Maximum="10" SmallChange="0.1" LargeChange="1"
                                            Width="200" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroSensitivityV_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding GyroSensitivityV, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                             Width="56" Margin="6,0,0,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="×" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <ui:Button Command="{Binding ResetGyroSensitivityVCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroSensitivityV, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBlock Text="{Binding GyroSensitivityV_DegPerTurn, StringFormat={}≈ {0:0}°/turn}"
                                               FontFamily="{StaticResource TelemetryFontFamily}"
                                               VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11"/>
                                </StackPanel>

                                <!-- Per-axis invert toggles. Independent from per-source
                                     Invert flags on the mapping table — Steam-style top-level
                                     convenience. -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Settings_GyroInvertPitch, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding GyroInvertPitch, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,4,0"
                                              ToolTip="{Binding Settings_GyroInvertPitch_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Command="{Binding ResetGyroInvertPitchCommand}" Style="{StaticResource ResetButton}" Margin="0,0,12,0"
                                            ToolTip="{Binding Pad_ResetGyroInvertPitch, Source={x:Static strings:Strings.Instance}}"/>
                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Settings_GyroInvertYawRoll, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding GyroInvertYawRoll, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,4,0"
                                              ToolTip="{Binding Settings_GyroInvertYawRoll_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Command="{Binding ResetGyroInvertYawRollCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroInvertYawRoll, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Real-world calibration. 0 = disabled. -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Settings_GyroRealWorldCalibration, Source={x:Static strings:Strings.Instance}}"
                                               Width="270" VerticalAlignment="Center"
                                               ToolTip="{Binding Settings_GyroRealWorldCalibration_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding GyroRealWorldCalibration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="0" Maximum="2" SmallChange="0.01" LargeChange="0.1"
                                            Width="200" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroRealWorldCalibration_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding GyroRealWorldCalibration, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                             Width="56" Margin="6,0,0,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="×" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <ui:Button Command="{Binding ResetGyroRealWorldCalibrationCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroRealWorldCalibration, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ─── Response shaping card ─── -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xF1CB;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_Gyro_Response_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding ResetGyroResponseCardCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_Gyro_ResetResponse_All_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Settings_GyroDeadZone, Source={x:Static strings:Strings.Instance}}"
                                               Width="270" VerticalAlignment="Center"
                                               ToolTip="{Binding Settings_GyroDeadZone_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding GyroDeadZoneDegPerSec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="0" Maximum="30" SmallChange="0.5" LargeChange="5"
                                            Width="200" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroDeadZone_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding GyroDeadZoneDegPerSec, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.0}}"
                                             Width="56" Margin="6,0,0,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="°/s" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <ui:Button Command="{Binding ResetGyroDeadZoneCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroDeadZone, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- dual-threshold smoothing (JSM-style).
                                     Tightening = full smoothing below this rate (drop hand tremor).
                                     Smoothing threshold = pass-through above this rate (fast turns).
                                     Between thresholds = linear ramp. -->
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Settings_GyroTightening, Source={x:Static strings:Strings.Instance}}"
                                               Width="270" VerticalAlignment="Center"
                                               ToolTip="{Binding Settings_GyroTightening_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding GyroTighteningThresholdDegPerSec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="0" Maximum="30" SmallChange="0.5" LargeChange="5"
                                            Width="200" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroTightening_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding GyroTighteningThresholdDegPerSec, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.0}}"
                                             Width="56" Margin="6,0,0,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="°/s" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <ui:Button Command="{Binding ResetGyroTighteningCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroTightening, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Settings_GyroSmoothingThreshold, Source={x:Static strings:Strings.Instance}}"
                                               Width="270" VerticalAlignment="Center"
                                               ToolTip="{Binding Settings_GyroSmoothingThreshold_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding GyroSmoothingThresholdDegPerSec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="0" Maximum="30" SmallChange="0.5" LargeChange="5"
                                            Width="200" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroSmoothingThreshold_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding GyroSmoothingThresholdDegPerSec, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.0}}"
                                             Width="56" Margin="6,0,0,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="°/s" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <ui:Button Command="{Binding ResetGyroSmoothingThresholdCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroSmoothingThreshold, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Settings_GyroSmoothingWindow, Source={x:Static strings:Strings.Instance}}"
                                               Width="270" VerticalAlignment="Center"
                                               ToolTip="{Binding Settings_GyroSmoothingWindow_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding GyroSmoothingWindowMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="10" Maximum="200" SmallChange="5" LargeChange="20"
                                            Width="200" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroSmoothingWindow_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding GyroSmoothingWindowMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}"
                                             Width="56" Margin="6,0,0,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="ms" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <ui:Button Command="{Binding ResetGyroSmoothingWindowCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroSmoothingWindow, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Settings_GyroAcceleration, Source={x:Static strings:Strings.Instance}}"
                                               Width="270" VerticalAlignment="Center"
                                               ToolTip="{Binding Settings_GyroAcceleration_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding GyroAcceleration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="0" Maximum="2" SmallChange="0.05" LargeChange="0.5"
                                            Width="200" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroAcceleration_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding GyroAcceleration, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                             Width="56" Margin="6,0,0,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetGyroAccelerationCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroAcceleration, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Settings_GyroOutputCurve, Source={x:Static strings:Strings.Instance}}"
                                               Width="270" VerticalAlignment="Center"
                                               ToolTip="{Binding Settings_GyroOutputCurve_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBox ItemsSource="{Binding GyroOutputCurveOptions}"
                                              SelectedValue="{Binding GyroOutputCurve, Mode=TwoWay}"
                                              SelectedValuePath="Value" DisplayMemberPath="Display"
                                              Width="200" VerticalAlignment="Center"
                                              ToolTip="{Binding Settings_GyroOutputCurve_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Command="{Binding ResetGyroOutputCurveCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroOutputCurve, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ─── Engage card ─── -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_Gyro_Engage_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding ResetGyroEngageCardCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_Gyro_ResetEngage_All_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Pad_Gyro_Engage_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Settings_GyroEasyAimThreshold, Source={x:Static strings:Strings.Instance}}"
                                               Width="270" VerticalAlignment="Center"
                                               ToolTip="{Binding Settings_GyroEasyAimThreshold_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding GyroEasyAimStickThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                                            Width="200" VerticalAlignment="Center" TickFrequency="5"
                                            ToolTip="{Binding Settings_GyroEasyAimThreshold_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding GyroEasyAimStickThreshold, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}"
                                             Width="56" Margin="6,0,0,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="%" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <ui:Button Command="{Binding ResetGyroEasyAimStickThresholdCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroEasyAimThreshold, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Engage stick side (#120). Which stick's
                                     deflection the threshold above gates on.
                                     Right (default) preserves existing profiles.
                                     Either gates on the larger of the two sticks. -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Settings_GyroEngageStickSide, Source={x:Static strings:Strings.Instance}}"
                                               Width="270" VerticalAlignment="Center"
                                               ToolTip="{Binding Settings_GyroEngageStickSide_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBox SelectedValue="{Binding GyroEngageStickSide, Mode=TwoWay}"
                                              SelectedValuePath="Tag"
                                              Width="260" VerticalAlignment="Center"
                                              ToolTip="{Binding Settings_GyroEngageStickSide_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                        <ComboBoxItem Content="{Binding Settings_GyroEngageStickSide_Right, Source={x:Static strings:Strings.Instance}}" Tag="Right"/>
                                        <ComboBoxItem Content="{Binding Settings_GyroEngageStickSide_Left, Source={x:Static strings:Strings.Instance}}" Tag="Left"/>
                                        <ComboBoxItem Content="{Binding Settings_GyroEngageStickSide_Either, Source={x:Static strings:Strings.Instance}}" Tag="Either"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding ResetGyroEngageStickSideCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroEngageStickSide, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Engage stick direction (#120). Which
                                     component of the stick(s) above the
                                     threshold gates on. Full (default,
                                     radial) preserves existing profiles. -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Settings_GyroEngageStickDirection, Source={x:Static strings:Strings.Instance}}"
                                               Width="270" VerticalAlignment="Center"
                                               ToolTip="{Binding Settings_GyroEngageStickDirection_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBox SelectedValue="{Binding GyroEngageStickDirection, Mode=TwoWay}"
                                              SelectedValuePath="Tag"
                                              Width="260" VerticalAlignment="Center"
                                              ToolTip="{Binding Settings_GyroEngageStickDirection_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                        <ComboBoxItem Content="{Binding Settings_GyroEngageStickDirection_Full, Source={x:Static strings:Strings.Instance}}" Tag="Full"/>
                                        <ComboBoxItem Content="{Binding Settings_GyroEngageStickDirection_X, Source={x:Static strings:Strings.Instance}}" Tag="X"/>
                                        <ComboBoxItem Content="{Binding Settings_GyroEngageStickDirection_Y, Source={x:Static strings:Strings.Instance}}" Tag="Y"/>
                                        <ComboBoxItem Content="{Binding Settings_GyroEngageStickDirection_XNeg, Source={x:Static strings:Strings.Instance}}" Tag="XNeg"/>
                                        <ComboBoxItem Content="{Binding Settings_GyroEngageStickDirection_XPos, Source={x:Static strings:Strings.Instance}}" Tag="XPos"/>
                                        <ComboBoxItem Content="{Binding Settings_GyroEngageStickDirection_YNeg, Source={x:Static strings:Strings.Instance}}" Tag="YNeg"/>
                                        <ComboBoxItem Content="{Binding Settings_GyroEngageStickDirection_YPos, Source={x:Static strings:Strings.Instance}}" Tag="YPos"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding ResetGyroEngageStickDirectionCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroEngageStickDirection, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Aim Engage button — cross-device picker that writes
                                     both the descriptor and owning device GUID atomically.
                                     ItemsSource is the slot's combined cross-device InputChoice
                                     list, populated by InputService.PopulateAvailableInputs.
                                     Subtitle under the picker shows the owning device, matching
                                     the mapping row pattern at PadPage.xaml:2785-2800. -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Settings_GyroAimEngageButton, Source={x:Static strings:Strings.Instance}}"
                                               Width="270" VerticalAlignment="Top" Margin="0,4,0,0"
                                               ToolTip="{Binding Settings_GyroAimEngageButton_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <StackPanel Orientation="Vertical">
                                        <ComboBox ItemsSource="{Binding SlotAvailableInputsView}"
                                                  SelectedItem="{Binding GyroAimEngageSelectedInput, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName"
                                                  MinWidth="260" Padding="4,2"
                                                  ToolTip="{Binding Settings_GyroAimEngageButton_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                  IsSynchronizedWithCurrentItem="False">
                                            <ComboBox.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,3,6,3">
                                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ComboBox.GroupStyle>
                                        </ComboBox>
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Margin="4,1,0,0"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding GyroAimEngageSelectedInput.DeviceLabel}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding GyroAimEngageSelectedInput}" Value="{x:Null}">
                                                            <Setter Property="Text" Value="{Binding Common_Unassigned, Source={x:Static strings:Strings.Instance}}"/>
                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <ui:Button Command="{Binding GyroAimEngageRecordCommand}"
                                               Style="{StaticResource EmberIconButtonHot}"
                                               VerticalAlignment="Top">
                                        <TextBlock Text="{Binding GyroAimEngageRecordButtonIcon}" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource EmberBrush}"/>
                                        <ui:Button.ToolTip>
                                            <TextBlock Text="{Binding GyroAimEngageRecordButtonText}"/>
                                        </ui:Button.ToolTip>
                                    </ui:Button>
                                    <ui:Button Command="{Binding ResetGyroAimEngageButtonCommand}" Style="{StaticResource ResetButton}"
                                            VerticalAlignment="Top"
                                            ToolTip="{Binding Pad_ResetGyroAimEngageButton, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <!-- Engage Mode — Hold (default) follows the
                                     button state directly; Toggle flips a
                                     sticky per-slot bit on each rising edge.
                                     Sibling to the engage-button row above so
                                     the two parameters of the same feature
                                     read as a pair. -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Settings_GyroAimEngageMode, Source={x:Static strings:Strings.Instance}}"
                                               Width="270" VerticalAlignment="Center"
                                               ToolTip="{Binding Settings_GyroAimEngageMode_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBox SelectedValue="{Binding GyroAimEngageMode, Mode=TwoWay}"
                                              SelectedValuePath="Tag"
                                              Width="260" VerticalAlignment="Center"
                                              ScrollViewer.VerticalScrollBarVisibility="Visible"
                                              ToolTip="{Binding Settings_GyroAimEngageMode_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                        <ComboBoxItem Content="{Binding Settings_GyroAimEngageMode_Hold, Source={x:Static strings:Strings.Instance}}" Tag="Hold"/>
                                        <ComboBoxItem Content="{Binding Settings_GyroAimEngageMode_Toggle, Source={x:Static strings:Strings.Instance}}" Tag="Toggle"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding ResetGyroAimEngageModeCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroAimEngageMode, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════════════════════════
                 TAB 9: IMPULSE TRIGGERS
                 (visible when the selected mapped device exposes
                 SDL_PROP_JOYSTICK_CAP_TRIGGER_RUMBLE_BOOLEAN —
                 Xbox One / Elite / Series).
                 ══════════════════════════════════════ -->
            <TabItem>
                <ScrollViewer Padding="24,0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Viewbox Width="24" Height="24" Stretch="Uniform"
                                     VerticalAlignment="Center" Margin="0,0,10,0">
                                <Grid Width="512" Height="512">
                                    <Path Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                          Data="{StaticResource ZackslyTriggerOuterBodyGeometry}"/>
                                    <Path Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                          Data="M445,180 L475,200 L445,220 L455,220 L485,200 L455,180 Z M445,280 L475,300 L445,320 L455,320 L485,300 L455,280 Z"/>
                                </Grid>
                            </Viewbox>
                            <TextBlock Text="{Binding Pad_ImpulseTriggers_Header, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource TitleTextBlockStyle}" FontFamily="{StaticResource DisplayFontFamily}" FontWeight="650" FontSize="26"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Pad_ImpulseTriggers_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Viewbox Width="18" Height="18" Stretch="Uniform"
                                             VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Grid Width="512" Height="512">
                                            <Path Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                                  Data="{StaticResource ZackslyTriggerOuterBodyGeometry}"/>
                                            <Path Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                                  Data="M445,180 L475,200 L445,220 L455,220 L485,200 L455,180 Z M445,280 L475,300 L445,320 L455,320 L485,300 L455,280 Z"/>
                                        </Grid>
                                    </Viewbox>
                                    <TextBlock Text="{Binding Pad_ImpulseTriggers_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding ResetImpulseAllCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetImpulseTriggers, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Overall gain -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Pad_OverallGain, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding ImpulseOverallGain, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding ImpulseOverallGain, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetImpulseOverallGainCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetImpulseOverallGain, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Left trigger -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Pad_ImpulseTriggers_LeftTrigger, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding ImpulseLeftStrength, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding ImpulseLeftStrength, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetImpulseLeftCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetImpulseLeft, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Right trigger -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Pad_ImpulseTriggers_RightTrigger, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding ImpulseRightStrength, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding ImpulseRightStrength, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetImpulseRightCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetImpulseRight, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Swap trigger motors -->
                                <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_ImpulseTriggers_SwapTriggers, Source={x:Static strings:Strings.Instance}}"
                                          IsChecked="{Binding ImpulseSwapTriggers, Mode=TwoWay}"
                                          Margin="0,0,0,12"/>

                                <!-- Test trigger buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button Content="{Binding Pad_ImpulseTriggers_TestLeftTrigger, Source={x:Static strings:Strings.Instance}}"
                                            Command="{Binding TestLeftImpulseTriggerCommand}"
                                            Padding="12,6" Margin="0,0,8,0"/>
                                    <Button Content="{Binding Pad_ImpulseTriggers_TestRightTrigger, Source={x:Static strings:Strings.Instance}}"
                                            Command="{Binding TestRightImpulseTriggerCommand}"
                                            Padding="12,6"/>
                                </StackPanel>

                                <!-- Live trigger motor display: inset instrument panel
                                     (#175 iteration 31, sibling of the FFB Motor Activity
                                     instrument). Motor drive is output-side, so ember. -->
                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,10"
                                                   Text="{Binding Pad_ImpulseTriggers_MotorActivity, Source={x:Static strings:Strings.Instance}}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                                                   Text="{Binding Pad_ImpulseTriggers_LeftTrigger, Source={x:Static strings:Strings.Instance}}"
                                                   Style="{StaticResource DzLabel}"/>
                                        <ProgressBar Grid.Row="1" Grid.Column="1" Margin="0,0,12,10"
                                                     Value="{Binding DeviceLeftTriggerMotorDisplay, Mode=OneWay}"
                                                     Minimum="0" Maximum="1" VerticalAlignment="Center"
                                                     Style="{StaticResource InstrumentBarOut}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,0,0,10"
                                                   Text="{Binding DeviceLeftTriggerMotorDisplay, Mode=OneWay, StringFormat=P0}"
                                                   FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12"
                                                   MinWidth="40" TextAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource EmberHotBrush}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"
                                                   Text="{Binding Pad_ImpulseTriggers_RightTrigger, Source={x:Static strings:Strings.Instance}}"
                                                   Style="{StaticResource DzLabel}"/>
                                        <ProgressBar Grid.Row="2" Grid.Column="1" Margin="0,0,12,0"
                                                     Value="{Binding DeviceRightTriggerMotorDisplay, Mode=OneWay}"
                                                     Minimum="0" Maximum="1" VerticalAlignment="Center"
                                                     Style="{StaticResource InstrumentBarOut}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2"
                                                   Text="{Binding DeviceRightTriggerMotorDisplay, Mode=OneWay, StringFormat=P0}"
                                                   FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12"
                                                   MinWidth="40" TextAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource EmberHotBrush}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ── Constant Trigger Force section ── -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xF0AD;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_ConstantTriggerForce_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding ResetConstantTriggerForceCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetConstantTriggerForce, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Pad_ConstantTriggerForce_Description, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}" Margin="0,0,0,12"/>

                                <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_ConstantTriggerForce_Toggle, Source={x:Static strings:Strings.Instance}}"
                                          IsChecked="{Binding ConstantTriggerForceEnabled, Mode=TwoWay}"
                                          Margin="0,0,0,12"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" IsEnabled="{Binding ConstantTriggerForceEnabled}">
                                    <TextBlock Text="{Binding Pad_ConstantTriggerForce_Left, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding ConstantTriggerForceLeft, Mode=TwoWay}"
                                            Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                                            Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding ConstantTriggerForceLeft, Mode=TwoWay, StringFormat=F2, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <ui:Button Command="{Binding ResetConstantTriggerLeftCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetConstantTriggerLeft, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" IsEnabled="{Binding ConstantTriggerForceEnabled}">
                                    <TextBlock Text="{Binding Pad_ConstantTriggerForce_Right, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding ConstantTriggerForceRight, Mode=TwoWay}"
                                            Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                                            Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding ConstantTriggerForceRight, Mode=TwoWay, StringFormat=F2, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <ui:Button Command="{Binding ResetConstantTriggerRightCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetConstantTriggerRight, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ── Audio Bass Trigger Rumble section ── -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_AudioTriggerRumble_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding ResetAudioTriggerRumbleAllCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetAudioTriggerRumble, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Pad_AudioTriggerRumble_Description, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}" Margin="0,0,0,12"/>

                                <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_AudioTriggerRumble_Toggle, Source={x:Static strings:Strings.Instance}}"
                                          IsChecked="{Binding AudioRumbleTriggersEnabled, Mode=TwoWay}"
                                          Margin="0,0,0,12"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" IsEnabled="{Binding AudioRumbleTriggersEnabled}">
                                    <TextBlock Text="{Binding Pad_AudioTriggerRumble_Sensitivity, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding AudioRumbleTriggersSensitivity, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"
                                            Minimum="1" Maximum="20" TickFrequency="0.1"/>
                                    <TextBox Text="{Binding AudioRumbleTriggersSensitivity, Mode=TwoWay, StringFormat=F1, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <ui:Button Command="{Binding ResetAudioTriggerSensitivityCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetAudioTriggerSensitivity, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" IsEnabled="{Binding AudioRumbleTriggersEnabled}">
                                    <TextBlock Text="{Binding Pad_AudioTriggerRumble_Cutoff, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding AudioRumbleTriggersCutoffHz, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"
                                            Minimum="20" Maximum="200" TickFrequency="1"/>
                                    <TextBox Text="{Binding AudioRumbleTriggersCutoffHz, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <ui:Button Command="{Binding ResetAudioTriggerCutoffCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetAudioTriggerCutoff, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" IsEnabled="{Binding AudioRumbleTriggersEnabled}">
                                    <TextBlock Text="{Binding Pad_AudioTriggerRumble_LeftTrigger, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding AudioRumbleLeftTrigger, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding AudioRumbleLeftTrigger, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetAudioLeftTriggerCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetAudioLeftTrigger, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" IsEnabled="{Binding AudioRumbleTriggersEnabled}">
                                    <TextBlock Text="{Binding Pad_AudioTriggerRumble_RightTrigger, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding AudioRumbleRightTrigger, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding AudioRumbleRightTrigger, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetAudioRightTriggerCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetAudioRightTrigger, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" IsEnabled="{Binding AudioRumbleTriggersEnabled}">
                                    <TextBlock Text="{Binding Pad_AudioTriggerRumble_Level, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ProgressBar Value="{Binding AudioRumbleTriggersLevelMeter, Mode=OneWay}"
                                                 Minimum="0" Maximum="1"
                                                 Width="320" Height="10" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource EmberHotBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════════════════════════════════
                 INDEX 10 — Touchpad tab (per-(device, pad)
                 gesture settings). Visibility on the tab
                 strip is gated by SyncTabVisibility based on
                 UserDevice.HasTouchpad of the currently
                 selected mapped device.
                 ═══════════════════════════════════════════ -->
            <TabItem>
                <ScrollViewer Padding="24,0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xEFA5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Pad_Touchpad_Header, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource TitleTextBlockStyle}" FontFamily="{StaticResource DisplayFontFamily}" FontWeight="650" FontSize="26"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Pad_Touchpad_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- Record / preview pad selector. Visible only on
                             multi-pad devices. Settings are per-device, so this
                             no longer pivots the cards below; it only targets
                             the gesture recorder and the live input preview. -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                                    Visibility="{Binding HasMultipleTouchpads, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Touchpad_RecordTargetLabel, Source={x:Static strings:Strings.Instance}}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding TouchpadIndexOptions}"
                                      SelectedItem="{Binding SelectedTouchpadIndex, Mode=TwoWay}"
                                      Width="120" VerticalAlignment="Center"
                                      ScrollViewer.VerticalScrollBarVisibility="Visible">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Pad index is stored 0-based; show it 1-based
                                             ("1"/"2") to match the previews and picker. The
                                             adjacent label is already the word "Touchpad", so
                                             the dropdown shows only the number. -->
                                        <TextBlock Text="{Binding Converter={StaticResource OneBasedIndexConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- ─── Joystick / D-pad output card ─── -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <!-- Segoe Fluent Icons F108 (LeftStick) silhouette with
                                         the "L" letter omitted. Path data extracted from
                                         the live font glyph; lives in ControllerIcons.xaml
                                         alongside the Zacksly stick / trigger geometries.
                                         Same Viewbox / Path / DynamicResource brush
                                         pattern used elsewhere on the page. -->
                                    <Viewbox Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Grid Width="512" Height="512">
                                            <Path Fill="{DynamicResource EmberBrush}"
                                                  Data="{StaticResource TouchpadStickIconGeometry}"/>
                                        </Grid>
                                    </Viewbox>
                                    <TextBlock Text="{Binding Pad_Touchpad_Stick_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding ResetTouchpadJoystickCardCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetTouchpadStick, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Pad_Touchpad_Stick_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Touchpad_StickEnabled, Source={x:Static strings:Strings.Instance}}"
                                              ToolTip="{Binding Pad_Touchpad_StickEnabled_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding TouchpadEnableJoystickOutput, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetTouchpadEnableJoystickOutputCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadStickEnabled, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <!-- Dependents obey the master toggle (#175 item 4),
                                     Constant Force idiom. Rows carry the Sticks DZ
                                     grammar (#175 item 15): slider + percent edit,
                                     0..1 setting units unchanged behind the
                                     FractionToPercentConverter. -->
                                <StackPanel IsEnabled="{Binding TouchpadEnableJoystickOutput}">
                                    <StackPanel Orientation="Horizontal" Margin="20,0,0,6">
                                        <TextBlock Text="{Binding Pad_Touchpad_StickMaxRadius, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <Slider Value="{Binding TouchpadJoystickMaxRadius, Mode=TwoWay, Converter={StaticResource FractionToPercentConverter}}"
                                                Style="{StaticResource DzSlider}" Minimum="5" Maximum="50"/>
                                        <TextBox Text="{Binding TouchpadJoystickMaxRadius, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource FractionToPercentConverter}, StringFormat={}{0:0.#}}"
                                                 Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding ResetTouchpadJoystickMaxRadiusCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_ResetTouchpadStickMaxRadius, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="20,0,0,8">
                                        <TextBlock Text="{Binding Pad_Touchpad_StickInnerDeadzone, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <Slider Value="{Binding TouchpadJoystickInnerDeadzone, Mode=TwoWay, Converter={StaticResource FractionToPercentConverter}}"
                                                Style="{StaticResource DzSlider}" Maximum="10"/>
                                        <TextBox Text="{Binding TouchpadJoystickInnerDeadzone, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource FractionToPercentConverter}, StringFormat={}{0:0.#}}"
                                                 Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding ResetTouchpadJoystickInnerDeadzoneCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_ResetTouchpadStickInnerDeadzone, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Touchpad_StickDPadMode_Label, Source={x:Static strings:Strings.Instance}}"
                                                   VerticalAlignment="Center" Width="270"/>
                                        <ComboBox SelectedValue="{Binding TouchpadJoystickDPadMode, Mode=TwoWay}"
                                                  SelectedValuePath="Tag"
                                                  Width="120" VerticalAlignment="Center"
                                                  ToolTip="{Binding Pad_Touchpad_StickDPadMode_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                  ScrollViewer.VerticalScrollBarVisibility="Visible">
                                            <ComboBoxItem Tag="Off" Content="{Binding Pad_Touchpad_StickDPadMode_Off, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Tag="FourWay" Content="{Binding Pad_Touchpad_StickDPadMode_FourWay, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Tag="EightWay" Content="{Binding Pad_Touchpad_StickDPadMode_EightWay, Source={x:Static strings:Strings.Instance}}"/>
                                        </ComboBox>
                                        <ui:Button Command="{Binding ResetTouchpadJoystickDPadModeCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_ResetTouchpadStickDPadMode, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                    <!-- Activation additionally obeys its own master:
                                         dead row while D-Pad Mode is Off (item 4). -->
                                    <StackPanel Orientation="Horizontal" Margin="20,0,0,6">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TouchpadJoystickDPadMode}" Value="Off">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding Pad_Touchpad_StickDPadActivationThreshold, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <Slider Value="{Binding TouchpadJoystickDPadActivationThreshold, Mode=TwoWay, Converter={StaticResource FractionToPercentConverter}}"
                                                Style="{StaticResource DzSlider}" Minimum="5" Maximum="50"/>
                                        <TextBox Text="{Binding TouchpadJoystickDPadActivationThreshold, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource FractionToPercentConverter}, StringFormat={}{0:0.#}}"
                                                 Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding ResetTouchpadJoystickDPadActivationThresholdCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_ResetTouchpadStickDPadActivationThreshold, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ─── Mouse Output card ─── -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE962;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_Touchpad_Mouse_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding ResetTouchpadMouseCardCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetTouchpadMouse, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Pad_Touchpad_Mouse_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}"/>

                                <!-- Sensitivity is a multiplier, not a fraction, so the
                                     slider rows keep native units with the × suffix
                                     (mapping-grid sensitivity idiom), #175 item 15. -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Pad_Touchpad_MouseSensitivityX, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding TouchpadMouseSensitivityX, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}" Minimum="0.05" Maximum="10" TickFrequency="0.05"
                                            ToolTip="{Binding Pad_Touchpad_MouseSensitivityX_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding TouchpadMouseSensitivityX, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                             Style="{StaticResource DzValueEdit}"
                                             ToolTip="{Binding Pad_Touchpad_MouseSensitivityX_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBlock Text="×" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetTouchpadMouseSensitivityXCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadMouseSensitivityX, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Pad_Touchpad_MouseSensitivityY, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding TouchpadMouseSensitivityY, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}" Minimum="0.05" Maximum="10" TickFrequency="0.05"
                                            ToolTip="{Binding Pad_Touchpad_MouseSensitivityY_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding TouchpadMouseSensitivityY, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                             Style="{StaticResource DzValueEdit}"
                                             ToolTip="{Binding Pad_Touchpad_MouseSensitivityY_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBlock Text="×" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetTouchpadMouseSensitivityYCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadMouseSensitivityY, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Touchpad_MouseInvertX, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding TouchpadMouseInvertX, Mode=TwoWay}"
                                              ToolTip="{Binding Pad_Touchpad_MouseInvertX_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                              VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetTouchpadMouseInvertXCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadMouseInvertX, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Touchpad_MouseInvertY, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding TouchpadMouseInvertY, Mode=TwoWay}"
                                              ToolTip="{Binding Pad_Touchpad_MouseInvertY_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                              VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetTouchpadMouseInvertYCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadMouseInvertY, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ─── Absolute Pointer card (#9 B-15) ───
                             Margin stretch for the "Touchpad N Pointer X/Y"
                             absolute cursor sources. 1.0 = Steam's 1:1
                             pad-to-screen mouse_region map; higher values
                             reach the screen edges before the pad bezel
                             (the Wii aim map's margin-stretch concept). -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE962;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_Touchpad_Pointer_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding ResetTouchpadPointerCardCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetTouchpadPointer, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Pad_Touchpad_Pointer_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Pad_Touchpad_PointerStretchX, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding TouchpadPointerStretchX, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}" Minimum="1" Maximum="3" TickFrequency="0.05"
                                            ToolTip="{Binding Pad_Touchpad_PointerStretchX_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding TouchpadPointerStretchX, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                             Style="{StaticResource DzValueEdit}"
                                             ToolTip="{Binding Pad_Touchpad_PointerStretchX_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBlock Text="×" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetTouchpadPointerStretchXCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadPointerStretchX, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Pad_Touchpad_PointerStretchY, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding TouchpadPointerStretchY, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}" Minimum="1" Maximum="3" TickFrequency="0.05"
                                            ToolTip="{Binding Pad_Touchpad_PointerStretchY_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding TouchpadPointerStretchY, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                             Style="{StaticResource DzValueEdit}"
                                             ToolTip="{Binding Pad_Touchpad_PointerStretchY_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBlock Text="×" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetTouchpadPointerStretchYCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadPointerStretchY, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ─── Synthetic Pressure card (discussion #239) ───
                             DS2/DS3-style pressure synthesis for pads whose
                             hardware reports a touch as pressure 1.0
                             (DualShock 4, DualSense, Steam Controller 2015):
                             mapping Pressure reads become no touch = 0,
                             touch = the configured level, pad click = 100%.
                             The two fields live on the per-device
                             DeviceSlotConfig (the Audio tab's mirror-row
                             pattern), so the bindings follow the selected
                             device through the DeviceConfig anchor. Rows
                             follow the Swipe Haptics card anatomy. -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xEDA4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_Touchpad_SyntheticPressure_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding ResetTouchpadSyntheticPressureCardCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetTouchpadSyntheticPressure, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Pad_Touchpad_SyntheticPressure_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Touchpad_SyntheticPressureEnabled, Source={x:Static strings:Strings.Instance}}"
                                              ToolTip="{Binding Pad_Touchpad_SyntheticPressureEnabled_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding DeviceConfig.TouchpadSyntheticPressure, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetTouchpadSyntheticPressureEnabledCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadSyntheticPressureEnabled, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <!-- Dependent obeys the master toggle (#175 item 4),
                                     Constant Force idiom. The level is already an
                                     int percent, so the row binds directly with no
                                     converter. -->
                                <StackPanel IsEnabled="{Binding DeviceConfig.TouchpadSyntheticPressure}">
                                    <StackPanel Orientation="Horizontal" Margin="20,0,0,6">
                                        <TextBlock Text="{Binding Pad_Touchpad_SyntheticTouchLevel, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <Slider Value="{Binding DeviceConfig.TouchpadSyntheticTouchPercent, Mode=TwoWay}"
                                                Style="{StaticResource DzSlider}" Maximum="100"
                                                ToolTip="{Binding Pad_Touchpad_SyntheticTouchLevel_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBox Text="{Binding DeviceConfig.TouchpadSyntheticTouchPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource DzValueEdit}"
                                                 ToolTip="{Binding Pad_Touchpad_SyntheticTouchLevel_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding ResetTouchpadSyntheticTouchPercentCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_ResetTouchpadSyntheticTouchLevel, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ─── Swipe Haptics card (discussion #219) ───
                             Steam-Input-style pulse ticks as the finger
                             travels the pad. Visible only when the selected
                             device's touchpad has a haptic lane PadForge
                             drives (Steam Controller family / Sony pads);
                             a Precision Touchpad or overlay would show a
                             dead toggle otherwise. Rows follow the Mouse
                             Output card anatomy; the intensity row uses the
                             Sticks DZ grammar (slider + percent edit) over
                             the 0..1 setting via FractionToPercentConverter. -->
                        <Border Style="{StaticResource CardBorder}"
                                Visibility="{Binding SelectedDeviceHasTouchpadPulse, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE877;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_Touchpad_SwipeHaptics_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding ResetTouchpadSwipeHapticsCardCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetTouchpadSwipeHaptics, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Pad_Touchpad_SwipeHaptics_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Touchpad_SwipeHapticsEnabled, Source={x:Static strings:Strings.Instance}}"
                                              ToolTip="{Binding Pad_Touchpad_SwipeHapticsEnabled_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding TouchpadSwipeHapticsEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetTouchpadSwipeHapticsEnabledCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadSwipeHapticsEnabled, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel IsEnabled="{Binding TouchpadSwipeHapticsEnabled}">
                                    <StackPanel Orientation="Horizontal" Margin="20,0,0,6">
                                        <TextBlock Text="{Binding Pad_Touchpad_SwipeHapticsIntensity, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <Slider Value="{Binding TouchpadSwipeHapticsIntensity, Mode=TwoWay, Converter={StaticResource FractionToPercentConverter}}"
                                                Style="{StaticResource DzSlider}" Minimum="5" Maximum="100"
