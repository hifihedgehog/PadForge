<UserControl x:Class="PadForge.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PadForge.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:strings="clr-namespace:PadForge.Resources.Strings"
             xmlns:common="clr-namespace:PadForge.Common">

    <UserControl.Resources>
        <!-- A credit's row as the board draws it (#574): a hairline over it,
             44 tall at least, 6 over and under its words. The name stands
             first, 200 wide, the description takes the rest, and the license
             chip closes the row, 12 between each. -->
        <Style x:Key="CreditRow" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SteelLineSoftBrush}"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="0,6"/>
        </Style>
        <Style x:Key="CreditName" TargetType="TextBlock">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style x:Key="CreditDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <!-- The chip's one line stands centered in its 22. -->
        <Style x:Key="CreditChip" TargetType="Border" BasedOn="{StaticResource PillChip}">
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
            </Style.Resources>
            <Setter Property="Margin" Value="12,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <!-- About (#574), top to bottom as the board draws it: PadForge with its
         version, its update state and four buttons, then the invitation, the
         overview, the credits and the license, each card headed by its own
         first line. -->
    <ScrollViewer AutomationProperties.Name="{Binding About_Title, Source={x:Static strings:Strings.Instance}}">
        <!-- The page reads in the column Settings reads in: every page's
             gutters and 1040 at most, at the page's start however wide the
             window, so a line of its prose stays one an eye can follow. The
             cap is the panel's own, since a grid's star column that stops at
             a MaxWidth takes a device pixel more. The PadForge card's line
             asks for all the width there is, so the column keeps its width
             whatever the credits search leaves in the list. -->
        <StackPanel x:Name="PageColumn" Margin="36,26,36,36" MaxWidth="1040" HorizontalAlignment="Left">

            <TextBlock x:Name="AboutTitle" AutomationProperties.HeadingLevel="Level1"
                       FontFamily="{StaticResource DisplayFontFamily}" FontSize="28" FontWeight="SemiBold"
                       LineHeight="40.6" LineStackingStrategy="BlockLineHeight"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       common:BidiText.Text="{Binding About_Title, Source={x:Static strings:Strings.Instance}}"/>

            <!-- PadForge: the mark, the name and version over the update state,
                 and the buttons, which start a line of their own on a narrow
                 card. The line under the name says "Up to date." after a check
                 found this build the newest, and the Updates card's sentence
                 while a check runs, has failed or has found an update, in ember
                 while one waits. -->
            <Border x:Name="PadForgeCard" Style="{StaticResource CardBorder}" Margin="0,20,0,16" Padding="20">
                <controls:FlexLinePanel Gap="20" LineGap="16">
                    <controls:DecorativeImage FlowDirection="LeftToRight" Source="/Resources/PadForge-icon.png"
                                              Width="60" Height="60" Stretch="Uniform" VerticalAlignment="Center"
                                              RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel controls:FlexLinePanel.Basis="240" controls:FlexLinePanel.Grow="1" VerticalAlignment="Center">
                        <TextBlock FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   ToolTip="{Binding ApplicationVersion}"
                                   AutomationProperties.AutomationId="About_Version"><Run Text="{Binding Common_PadForge, Source={x:Static strings:Strings.Instance}, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding VersionNumber, Mode=OneWay}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource ColdBrush}"/></TextBlock>
                        <TextBlock x:Name="AboutSubLine" FontSize="13" TextWrapping="Wrap"
                                   common:LiveText.Polite="True"
                                   common:BidiText.Text="{Binding AboutSubLine}"
                                   AutomationProperties.AutomationId="About_UpdateStatus">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource EmberTextBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <!-- The buttons wrap with 8 between them, across and down. -->
                    <controls:FlexLinePanel Gap="8" LineGap="8" VerticalAlignment="Center">
                        <ui:Button Padding="14,0" MinHeight="36" Click="Documentation_Click"
                                   Content="{Binding About_Documentation, Source={x:Static strings:Strings.Instance}}"
                                   AutomationProperties.AutomationId="About_Documentation"/>
                        <ui:Button Padding="14,0" MinHeight="36" Click="GitHub_Click"
                                   Content="{Binding About_GitHub, Source={x:Static strings:Strings.Instance}}"
                                   AutomationProperties.AutomationId="About_GitHub"/>
                        <ui:Button Padding="14,0" MinHeight="36" Command="{Binding OpenReleaseNotesCommand}"
                                   Content="{Binding Settings_ReleaseNotes, Source={x:Static strings:Strings.Instance}}"
                                   AutomationProperties.AutomationId="About_ReleaseNotes"/>
                        <ui:Button Padding="14,0" MinHeight="36" Command="{Binding CheckForUpdatesNowCommand}"
                                   Content="{Binding About_CheckForUpdates, Source={x:Static strings:Strings.Instance}}"
                                   AutomationProperties.AutomationId="About_CheckForUpdates"/>
                    </controls:FlexLinePanel>
                </controls:FlexLinePanel>
            </Border>

            <!-- An Invitation: the verse, its reference as written, the
                 doxology, and the invitation, whose ComeUntoChrist.org alone is
                 the link. The code-behind builds that line, so the split
                 follows the language. -->
            <Border Style="{StaticResource CardBorder}" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}"
                               common:BidiText.Text="{Binding About_Testimony, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock Margin="0,10,0,0" FontSize="14" FontStyle="Italic" TextWrapping="Wrap"
                               Foreground="{DynamicResource SubRowTextBrush}"
                               common:BidiText.Text="{Binding About_TestimonyScripture, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock Margin="0,6,0,0" FontSize="12" FontFamily="{StaticResource TelemetryFontFamily}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               common:BidiText.Text="{Binding About_TestimonyRef, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock Margin="0,12,0,0" FontSize="14" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               common:BidiText.Text="{Binding About_TestimonyDoxology, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock x:Name="InviteLine" Margin="0,6,0,0" FontSize="14" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Overview: what PadForge does, then the tagline, which credits
                 x360ce. -->
            <Border Style="{StaticResource CardBorder}" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}"
                               common:BidiText.Text="{Binding About_Overview, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock Margin="0,10,0,0" FontSize="14" TextWrapping="Wrap"
                               Foreground="{DynamicResource SubRowTextBrush}"
                               common:BidiText.Text="{Binding About_Description, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock Margin="0,10,0,0" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               common:BidiText.Text="{Binding About_Tagline, Source={x:Static strings:Strings.Instance}}"/>
                </StackPanel>
            </Border>

            <!-- Built With: the heading and the credits field on one line that
                 wraps, then a row per credit in English name order. Five rows
