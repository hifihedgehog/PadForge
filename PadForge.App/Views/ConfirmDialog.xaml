<views:DialogWindow AutomationProperties.IsDialog="True" x:Class="PadForge.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        xmlns:controls="clr-namespace:PadForge.Controls"
        xmlns:views="clr-namespace:PadForge.Views"
        BodyPadding="22,14,22,18">

    <!-- The shared confirm (#574), as the Confirm board draws it: the
         question is the title, what happens is the line under it, and the
         body holds only the thing at stake when the caller names one.
         Cancel holds the default, the cancel and the first focus, so Enter
         and Esc both land on the safe word, and the action fires on a
         deliberate click or Tab then Enter. The code-behind gives the
         action its word and, for a step forward, the ember look in place
         of the danger one. A notice has the one button. -->
    <views:DialogWindow.Foot>
        <controls:FlexLinePanel Style="{StaticResource DialogFootPanel}">
            <Button x:Name="CancelButton" Style="{StaticResource DialogButton}"
                    Content="{Binding Common_Cancel, Source={x:Static strings:Strings.Instance}}"
                    IsCancel="True" IsDefault="True"/>
            <Button x:Name="ActionButton" Style="{StaticResource DialogDangerButton}" Click="ActionButton_Click"/>
        </controls:FlexLinePanel>
    </views:DialogWindow.Foot>

    <!-- The thing at stake (a device, a controller, a file, the rows an
         update names), in the code face. Collapsed unless the caller
         passes one. -->
    <TextBlock x:Name="DetailText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="13"
               FontFamily="{DynamicResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}"/>
</views:DialogWindow>
