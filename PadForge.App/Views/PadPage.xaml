                                        <!-- Note (#475): a Motion row holding a source it cannot read, any
                                             other row holding a Motion source it cannot read, or a preset whose
                                             report carries no motion. -->
                                        <TextBlock Text="{Binding MotionRowNote}" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,0,6"
                                                   Visibility="{Binding ShowMotionRowNote, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                        <!-- Motion Pitch, Yaw and Roll settings (#475). Motion Mode on pitch and
                                             roll only, then the Speed or Angle settings and the deadzone, laid
                                             out like the Ramp panel. -->
                                        <StackPanel Orientation="Vertical" Margin="0,0,0,6"
                                                    Visibility="{Binding IsMotionAxisRow, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                                        Visibility="{Binding CanUseMotionAngle, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Pad_Mapping_MotionMode, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}"
                                                           FontSize="10"
                                                           FontFamily="{StaticResource TelemetryFontFamily}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Margin="0,0,8,0"/>
                                                <ComboBox ItemsSource="{Binding MotionResponseOptions}"
                                                          SelectedValue="{Binding MotionResponse, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          SelectedValuePath="Value"
                                                          MinWidth="200" Margin="0" Padding="4,2"
                                                          VerticalAlignment="Center"
                                                          ToolTip="{Binding Pad_Mapping_MotionMode_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                          PreviewKeyDown="MappingComboBox_PreviewKeyDown">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Vertical" Margin="0,2,0,2">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                                <TextBlock Text="{Binding Description}"
                                                                           FontSize="10"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           TextWrapping="Wrap"
                                                                           Visibility="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ComboBoxItem}}, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="MotionResponse" SettingLabel="{Binding Pad_Mapping_MotionMode, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MappingItem_MotionResponse_4614" Margin="4,0,8,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                            Visibility="{Binding ShowMotionSpeedSettings, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Mapping_MotionTopSpeed, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <Slider Value="{Binding MotionSpeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="1600" SmallChange="10" LargeChange="100" Width="90" VerticalAlignment="Center"
                                                            ToolTip="{Binding Pad_Mapping_MotionTopSpeed_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                    <TextBox Text="{Binding MotionSpeed, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="48" Margin="4,0,0,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="°/s" VerticalAlignment="Center" Margin="2,0,2,0"/>
                                                    <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="MotionSpeed" SettingLabel="{Binding Pad_Mapping_MotionTopSpeed, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MappingItem_MotionSpeed_4624" Margin="4,0,8,0"/>
                                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Mapping_MotionStartSpeed, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <Slider Value="{Binding MotionMinSpeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="1600" SmallChange="1" LargeChange="10" Width="80" VerticalAlignment="Center"
                                                            ToolTip="{Binding Pad_Mapping_MotionStartSpeed_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                    <TextBox Text="{Binding MotionMinSpeed, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="44" Margin="4,0,0,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="°/s" VerticalAlignment="Center" Margin="2,0,2,0"/>
                                                    <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="MotionMinSpeed" SettingLabel="{Binding Pad_Mapping_MotionStartSpeed, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MappingItem_MotionMinSpeed_4630" Margin="4,0,8,0"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                            Visibility="{Binding ShowMotionAngleSettings, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Mapping_MotionLeanAngle, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <Slider Value="{Binding MotionAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="90" SmallChange="1" LargeChange="5" Width="90" VerticalAlignment="Center"
                                                            ToolTip="{Binding Pad_Mapping_MotionLeanAngle_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                    <TextBox Text="{Binding MotionAngle, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="40" Margin="4,0,0,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="°" VerticalAlignment="Center" Margin="2,0,2,0"/>
                                                    <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="MotionAngle" SettingLabel="{Binding Pad_Mapping_MotionLeanAngle, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MappingItem_MotionAngle_4639" Margin="4,0,8,0"/>
                                                </StackPanel>
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Mapping_MotionDeadzone, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <Slider Value="{Binding MotionDeadzone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="90" SmallChange="1" LargeChange="5" Width="80" VerticalAlignment="Center"
                                                        ToolTip="{Binding Pad_Mapping_MotionDeadzone_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <TextBox Text="{Binding MotionDeadzone, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="36" Margin="4,0,0,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="%" VerticalAlignment="Center" Margin="2,0,2,0"/>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="MotionDeadzone" SettingLabel="{Binding Pad_Mapping_MotionDeadzone, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MappingItem_MotionDeadzone_4646" Margin="4,0,8,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Combine row. Visible only on multi-source rows.
                                             Bound to AvailableCombineModes which pairs the
                                             engine's name (MaxAbs / OR / XOR…) with a layman
                                             label + one-line description so non-STEM users
                                             aren't staring at acronyms. EnsureCombineModeDefault
                                             auto-picks MaxAbs/OR per target class on first
                                             multi-source transition. -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                                    Visibility="{Binding IsMultiSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding Pad_Combine_Label, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}"
                                                       FontSize="10"
                                                       FontFamily="{StaticResource TelemetryFontFamily}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Margin="0,0,8,0"/>
                                            <ComboBox ItemsSource="{Binding AvailableCombineModes}"
                                                      SelectedValue="{Binding CombineMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Value"
                                                      DisplayMemberPath="Name"
                                                      MinWidth="200" Margin="0" Padding="4,2"
                                                      VerticalAlignment="Center"
                                                      ToolTip="{Binding Pad_Combine_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                      PreviewKeyDown="MappingComboBox_PreviewKeyDown">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Vertical" Margin="0,2,0,2">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                            <!-- Description renders in the dropdown only (#175
                                                                 item 5): the selection box has no ComboBoxItem
                                                                 ancestor, so FindAncestor yields null and the
                                                                 closed face collapses to the one-line name.
                                                                 Plain converter binding, not a Style trigger
                                                                 (stack-overflow precedent, 2026-07-04). -->
                                                            <TextBlock Text="{Binding Description}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       TextWrapping="Wrap"
                                                                       Visibility="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ComboBoxItem}}, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="CombineMode" SettingLabel="{Binding Pad_Combine_Label, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}" AutomationProperties.AutomationId="Reset_MappingItem_CombineMode_4340"/>
                                        </StackPanel>


                                        <!-- Stick Trim settings (#155): only visible when the
                                             row is multi-source AND Stick Trim is the picked
                                             combine, the ShouldShowCustomExpression gating
                                             pattern. The row's LAST source is the trim stick.
                                             The earlier sources gate the trigger. -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                                    Visibility="{Binding ShouldShowTrimSettings, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Mapping_TrimDeadzone, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <Slider Value="{Binding TrimDeadzone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="95" SmallChange="1" LargeChange="5" Width="80" VerticalAlignment="Center"
                                                    ToolTip="{Binding Pad_Mapping_TrimDeadzone_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <TextBox Text="{Binding TrimDeadzone, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="36" Margin="4,0,0,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="%" VerticalAlignment="Center" Margin="1,0,2,0"/>
                                            <ui:Button Command="{Binding ResetTrimDeadzoneCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetTrimDeadzone, Source={x:Static strings:Strings.Instance}}" Margin="0,0,8,0"/>
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Mapping_TrimRate, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <Slider Value="{Binding TrimRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="1000" SmallChange="10" LargeChange="50" Width="80" VerticalAlignment="Center"
                                                    ToolTip="{Binding Pad_Mapping_TrimRate_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <TextBox Text="{Binding TrimRate, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="40" Margin="4,0,0,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="%/s" VerticalAlignment="Center" Margin="1,0,2,0"/>
                                            <ui:Button Command="{Binding ResetTrimRateCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetTrimRate, Source={x:Static strings:Strings.Instance}}" Margin="0,0,8,0"/>
                                            <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Mapping_TrimReset, Source={x:Static strings:Strings.Instance}}" IsChecked="{Binding TrimResetOnRelease, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,2,0"
                                                      ToolTip="{Binding Pad_Mapping_TrimReset_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ui:Button Command="{Binding ResetTrimResetOnReleaseCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetTrimResetOnRelease, Source={x:Static strings:Strings.Instance}}" Margin="0,0,8,0"/>
                                        </StackPanel>

                                        <!-- Custom formula editor: only visible when the row
                                             is multi-source AND Custom is the picked combine.
                                             Gating on ShouldShowCustomExpression instead of
                                             just IsCustomCombine means removing the last
                                             extra source also collapses the formula box,
                                             instead of leaving stale text on a single-source
                                             row. The italic placeholder shows an example
                                             until the user types something. -->
                                        <!-- Custom formula visual editor. Chip palette
                                             below a free-text formula box. Users who don't
                                             want to type can build a formula by clicking
                                             chips (each chip's Tag is inserted at the
                                             caret) or load a complete preset by clicking
                                             one of the named buttons. The Click handlers
                                             live in PadPage.xaml.cs and use VisualTreeHelper
                                             to find the named TextBox inside the same
                                             FormulaEditor StackPanel. That avoids the
                                             ComboBox-SelectedItem write-back hell that
                                             made the previous Quick fill dropdown unable
                                             to populate the formula on selection. -->
                                        <StackPanel x:Name="FormulaEditor" Orientation="Vertical" Margin="0,0,0,4"
                                                    Visibility="{Binding ShouldShowCustomExpression, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <DockPanel LastChildFill="True" Visibility="{Binding Visibility, ElementName=CustomFormulaBox}" VerticalAlignment="Center">
                                                <reset:SettingResetButton DockPanel.Dock="Right" Command="{Binding ResetSettingCommand}" CommandParameter="CombineExpression" Visibility="{Binding Visibility, ElementName=CustomFormulaBox}" SettingLabel="{Binding ResetLabel_Formula, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MappingItem_CombineExpression_4415"/>
                                                <TextBox x:Name="CustomFormulaBox"
                                                         Text="{Binding CombineExpression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         MinWidth="380" Padding="6,4"
                                                         FontFamily="{StaticResource TelemetryFontFamily}"
                                                         AllowDrop="True"
                                                         ToolTip="{Binding Pad_Formula_TextBox_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding CombineExpressionStatus}"
                                                       FontSize="10" FontFamily="{StaticResource TelemetryFontFamily}"
                                                       Margin="2,2,0,4"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#16C60C"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCombineExpressionWarning}" Value="True">
                                                                <Setter Property="Foreground" Value="#F2A33C"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCombineExpressionInvalid}" Value="True">
                                                                <Setter Property="Foreground" Value="#C42B1C"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Chip palette: variables, operators, numbers,
                                                 functions. Tag carries the literal text to
                                                 insert at the formula's caret. -->
                                            <TextBlock Text="{Binding Pad_Formula_Insert, Source={x:Static strings:Strings.Instance}}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Margin="2,4,0,2"/>
                                            <WrapPanel Margin="0,0,0,4" MaxWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                                <WrapPanel.Resources>
                                                    <Style x:Key="FormulaChipStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Padding" Value="6,2"/>
                                                        <Setter Property="Margin" Value="0,0,3,3"/>
                                                        <Setter Property="MinWidth" Value="28"/>
                                                        <Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}"/>
                                                        <Setter Property="FontSize" Value="11"/>
                                                        <!-- Drag-out support: PreviewMouseLeftButtonDown
                                                             records the start point, MouseMove past the
                                                             drag threshold starts the DragDrop with the
                                                             chip's Tag (the literal text to insert)
                                                             as the data payload. The formula TextBox
                                                             has AllowDrop=True. WPF's built-in text
                                                             drop behavior inserts at the drop point. -->
                                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="FormulaChip_PreviewMouseLeftButtonDown"/>
                                                        <EventSetter Event="PreviewMouseMove" Handler="FormulaChip_PreviewMouseMove"/>
                                                    </Style>
                                                </WrapPanel.Resources>
                                                <!-- Source variables. a-d cover most rows, and users with
                                                     more sources can type the rest. Tooltips bind to
                                                     the row's per-position friendly alias so users
                                                     see what `a/b/c/d` mean for THIS row. -->
                                                <!-- Variable chips: a..z. Each chip's Visibility tracks the
                                                     row's VariableCount (1 primary + ExtraSources) so the user
                                                     only sees letters that bind to a real source. -->
                                                <Button Content="a" Tag="a" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding VariableATooltip}" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=0}"/>
                                                <Button Content="b" Tag="b" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding VariableBTooltip}" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=1}"/>
                                                <Button Content="c" Tag="c" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding VariableCTooltip}" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=2}"/>
                                                <Button Content="d" Tag="d" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding VariableDTooltip}" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=3}"/>
                                                <Button Content="e" Tag="e" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=4}"/>
                                                <Button Content="f" Tag="f" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=5}"/>
                                                <Button Content="g" Tag="g" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=6}"/>
                                                <Button Content="h" Tag="h" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=7}"/>
                                                <Button Content="i" Tag="i" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=8}"/>
                                                <Button Content="j" Tag="j" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=9}"/>
                                                <Button Content="k" Tag="k" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=10}"/>
                                                <Button Content="l" Tag="l" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=11}"/>
                                                <Button Content="m" Tag="m" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=12}"/>
                                                <Button Content="n" Tag="n" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=13}"/>
                                                <Button Content="o" Tag="o" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=14}"/>
                                                <Button Content="p" Tag="p" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=15}"/>
                                                <Button Content="q" Tag="q" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=16}"/>
                                                <Button Content="r" Tag="r" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=17}"/>
                                                <Button Content="s" Tag="s" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=18}"/>
                                                <Button Content="t" Tag="t" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=19}"/>
                                                <Button Content="u" Tag="u" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=20}"/>
                                                <Button Content="v" Tag="v" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=21}"/>
                                                <Button Content="w" Tag="w" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=22}"/>
                                                <Button Content="x" Tag="x" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=23}"/>
                                                <Button Content="y" Tag="y" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=24}"/>
                                                <Button Content="z" Tag="z" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=25}"/>
                                                <!-- Touchpad-only "is touching" flags. Visible on
                                                     TouchpadX*/Y* rows. Resolve to 1.0 while the
                                                     paired finger is touching, 0.0 when lifted. Used
                                                     to write gated formulas like
                                                     `aD ? a : (bD ? b : 0.5)` so a stale finger
                                                     position can't pollute the combine. The flag
                                                     channel is only supplied by the touchpad-
                                                     passthrough evaluator. Referencing aD on a
                                                     non-touchpad row resolves to 0. -->
                                                <Button Content="aD" Tag="aD" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click"
                                                        common:BidiText.ToolTip="{Binding Pad_Formula_Chip_TouchpadFlag_A, Source={x:Static strings:Strings.Instance}}"
                                                        Visibility="{Binding IsTouchpadAxisTarget, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <Button Content="bD" Tag="bD" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click"
                                                        common:BidiText.ToolTip="{Binding Pad_Formula_Chip_TouchpadFlag_B, Source={x:Static strings:Strings.Instance}}"
                                                        Visibility="{Binding IsTouchpadAxisTarget, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <Button Content="cD" Tag="cD" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click"
                                                        common:BidiText.ToolTip="{Binding Pad_Formula_Chip_TouchpadFlag_C, Source={x:Static strings:Strings.Instance}}"
                                                        Visibility="{Binding IsTouchpadAxisTarget, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <Button Content="dD" Tag="dD" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click"
                                                        common:BidiText.ToolTip="{Binding Pad_Formula_Chip_TouchpadFlag_D, Source={x:Static strings:Strings.Instance}}"
                                                        Visibility="{Binding IsTouchpadAxisTarget, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <!-- Operators -->
                                                <Border Width="6"/>
                                                <Button Content="+" Tag=" + " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Add, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="−" Tag=" - " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Subtract, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="×" Tag=" * " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Multiply, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="÷" Tag=" / " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Divide, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="−A" Tag="-a" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_NegateA, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="(" Tag="(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_OpenGroup, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content=")" Tag=")" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_CloseGroup, Source={x:Static strings:Strings.Instance}}"/>
                                                <!-- Numbers -->
                                                <Border Width="6"/>
                                                <Button Content="0" Tag="0" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click"/>
                                                <Button Content="½" Tag="0.5" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Half, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="1" Tag="1" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click"/>
                                                <Button Content="2" Tag="2" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click"/>
                                                <!-- Comparisons (yield 0 / 1 for use in if-then-else or scaled by *) -->
                                                <Border Width="6"/>
                                                <Button Content="&lt;" Tag=" &lt; " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_LessThan, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="&gt;" Tag=" &gt; " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_GreaterThan, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="≤" Tag=" &lt;= " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_LessOrEqual, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="≥" Tag=" &gt;= " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_GreaterOrEqual, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="=" Tag=" == " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Equal, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="≠" Tag=" != " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_NotEqual, Source={x:Static strings:Strings.Instance}}"/>
                                                <!-- Logic + if-then-else -->
                                                <Border Width="6"/>
                                                <Button Content="and" Tag=" &amp;&amp; " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_BothConditions, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="or" Tag=" || " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_EitherCondition, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="not" Tag="!" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_FlipBool, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="if?" Tag=" ? " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_If, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="else:" Tag=" : " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Else, Source={x:Static strings:Strings.Instance}}"/>
                                                <!-- Functions -->
                                                <Border Width="6"/>
                                                <Button Content="abs" Tag="abs(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Abs, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="min" Tag="min(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Min, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="max" Tag="max(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Max, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="clamp" Tag="clamp(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Clamp, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="sign" Tag="sign(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Sign, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="lerp" Tag="lerp(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Lerp, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="round" Tag="round(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Round, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="sqrt" Tag="sqrt(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Sqrt, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="pow" Tag="pow(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Pow, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="hypot" Tag="hypot(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Hypot, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="deadzone" Tag="deadzone(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Deadzone, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="floor" Tag="floor(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Floor, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="ceil" Tag="ceil(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Ceil, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="sin" Tag="sin(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Sin, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="cos" Tag="cos(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Cos, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="tan" Tag="tan(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Tan, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="atan2" Tag="atan2(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Atan2, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="," Tag=", " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click"/>
                                            </WrapPanel>

                                            <!-- Preset buttons: load a complete formula
                                                 (replaces what's in the box). Each button's
                                                 Tag is the formula text. -->
                                            <TextBlock Text="{Binding Pad_Formula_StarterRecipes, Source={x:Static strings:Strings.Instance}}" FontSize="10"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Margin="2,2,0,2"/>
                                            <WrapPanel MaxWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                                <WrapPanel.Resources>
                                                    <Style x:Key="FormulaPresetStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Padding" Value="8,3"/>
                                                        <Setter Property="Margin" Value="0,0,4,3"/>
                                                        <Setter Property="FontSize" Value="11"/>
                                                    </Style>
                                                </WrapPanel.Resources>
                                                <Button Content="{Binding Pad_Formula_Preset_HalfScale_Name, Source={x:Static strings:Strings.Instance}}" Tag="a * 0.5"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Pad_Formula_Preset_HalfScale_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Pad_Formula_Preset_QuarterScale_Name, Source={x:Static strings:Strings.Instance}}" Tag="a * 0.25"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Pad_Formula_Preset_QuarterScale_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Pad_Formula_Preset_ReverseA_Name, Source={x:Static strings:Strings.Instance}}" Tag="-a"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Pad_Formula_Preset_ReverseA_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Pad_Formula_Preset_CapTo1_Name, Source={x:Static strings:Strings.Instance}}" Tag="clamp(a + b, -1, 1)"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Pad_Formula_Preset_CapTo1_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Pad_Formula_Preset_WeightedBlend_Name, Source={x:Static strings:Strings.Instance}}" Tag="a * 0.7 + b * 0.3"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Pad_Formula_Preset_WeightedBlend_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Pad_Formula_Preset_Difference_Name, Source={x:Static strings:Strings.Instance}}" Tag="a - b"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Pad_Formula_Preset_Difference_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Pad_Formula_Preset_AUnlessIdle_Name, Source={x:Static strings:Strings.Instance}}" Tag="a != 0 ? a : b"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Pad_Formula_Preset_AUnlessIdle_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Pad_Formula_Preset_ThresholdGate_Name, Source={x:Static strings:Strings.Instance}}" Tag="(a &gt; 0.5) ? 1 : 0"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Pad_Formula_Preset_ThresholdGate_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Pad_Formula_Preset_BothPressed_Name, Source={x:Static strings:Strings.Instance}}" Tag="(a &gt; 0) &amp;&amp; (b &gt; 0) ? 1 : 0"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Pad_Formula_Preset_BothPressed_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Pad_Formula_Preset_StrongerWins_Name, Source={x:Static strings:Strings.Instance}}" Tag="max(abs(a), abs(b)) * sign(a + b)"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Pad_Formula_Preset_StrongerWins_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <!-- Shared recipes from the macro custom-expression editor. Same
                                                     Macro_Expression_Recipe_* keys, already translated across all
                                                     10 locales. -->
                                                <Button Content="{Binding Macro_Expression_Recipe_Single, Source={x:Static strings:Strings.Instance}}" Tag="a"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Macro_Expression_Recipe_Single_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Macro_Expression_Recipe_Both, Source={x:Static strings:Strings.Instance}}" Tag="a &amp;&amp; b"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Macro_Expression_Recipe_Both_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Macro_Expression_Recipe_Either, Source={x:Static strings:Strings.Instance}}" Tag="a || b"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Macro_Expression_Recipe_Either_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Macro_Expression_Recipe_AButNotB, Source={x:Static strings:Strings.Instance}}" Tag="a &amp;&amp; !b"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Macro_Expression_Recipe_AButNotB_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Macro_Expression_Recipe_AxisOverHalf, Source={x:Static strings:Strings.Instance}}" Tag="abs(a) &gt; 0.5"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Macro_Expression_Recipe_AxisOverHalf_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- ExtraSources list. Each row has its own
                                             cascading Device/Input picker: the Device
                                             ComboBox lists every device assigned to the
                                             slot, and the Input ComboBox draws from the
                                             per-source AvailableInputs (which the parent
                                             MappingItem refreshes whenever the source's
                                             DeviceGuid changes). Empty Device =
                                             "use the slot's primary device". The parent
                                             falls the per-source AvailableInputs back to
                                             its own list in that case. -->
                                        <ItemsControl ItemsSource="{Binding ExtraSources}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- Extra source as a cold chip (#175 final
                                                         close-out): the sub-source row reads in
                                                         the src-chip language. Cold border and
                                                         wash, radius 8, kind glyph up front,
                                                         compact controls inside, remove ✕ at the
                                                         end. Controls stay inline (no per-source
                                                         focus state exists to collapse against). -->
                                                    <Border Background="#0D58B6E4" BorderThickness="1"
                                                            CornerRadius="8" Padding="7,3"
                                                            Margin="0,2,0,2" HorizontalAlignment="Left">
                                                        <Border.BorderBrush>
                                                            <SolidColorBrush Color="#3D58B6E4"/>
                                                        </Border.BorderBrush>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="↳" FontSize="14"
                                                                   Foreground="{DynamicResource ColdBrush}"
                                                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <!-- Kind selector. Schema/engine value ("Direct" / "Incremental" /
                                                             "InvertOnHold") round-trips via SelectedValue. The dropdown
                                                             shows the friendly display name from KindChoice.Name so the
                                                             user reads "Invert On Hold" instead of the camel-case identifier. -->
                                                        <!-- Instance binding, NOT x:Static: an x:Static ItemsSource is
                                                             evaluated once and never refreshes on a live language change. -->
                                                        <ComboBox ItemsSource="{Binding KindChoices}"
                                                                  SelectedValue="{Binding Kind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  SelectedValuePath="Value"
                                                                  DisplayMemberPath="Name"
                                                                  Width="150" Padding="4,2" Margin="0,0,6,0"
                                                                  VerticalAlignment="Center"
                                                                  ToolTip="{Binding Pad_Mapping_Kind_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                                  PreviewKeyDown="MappingComboBox_PreviewKeyDown"/>
                                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="Kind" SettingLabel="{Binding ResetLabel_SourceType, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MappingSourceItem_Kind_4734" Margin="4,0,8,0"/>
                                                        <!-- Direction badge: visible only when the parent target is
                                                             a bipolar stick axis AND this source is button-class.
                                                             Derived from per-source Invert flag. -->
                                                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                                CornerRadius="3" Padding="4,1" Margin="0,0,4,0"
                                                                VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding DataContext.IsBipolarAxisTarget,
                                                                                            RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True"/>
                                                                                <Condition Binding="{Binding IsButtonClassDescriptor}" Value="True"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding DirectionBadge}" FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        </Border>
                                                        <!-- Cross-device grouped picker. ItemsSource is the
                                                             parent MappingItem's full cross-device flat list.
                                                             GroupStyle headers identify which device each
                                                             input belongs to. Selecting an InputChoice writes
                                                             both the source's Descriptor and DeviceGuid in
                                                             one shot via the InputChoiceToSource attached
                                                             behavior. Hidden for Incremental. That kind reads
                                                             its inputs from the Up/Down pickers on the row
                                                             below, not from a single source descriptor. -->
                                                        <StackPanel Orientation="Vertical" Margin="0,0,4,0"
                                                                    Visibility="{Binding IsKindDescriptorless, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                                            <ComboBox ItemsSource="{Binding DataContext.AvailableInputsView,
                                                                        RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"
                                                                      SelectedItem="{Binding SelectedInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      DisplayMemberPath="DisplayName"
                                                                      MinWidth="240" Padding="4,2"
                                                                      ToolTip="{Binding Pad_Mapping_ExtraSourcePickerTooltip, Source={x:Static strings:Strings.Instance}}"
                                                                      BorderBrush="#4D58B6E4" Background="#0D58B6E4"
                                                                      PreviewKeyDown="MappingComboBox_PreviewKeyDown"
                                                                      IsSynchronizedWithCurrentItem="False"
                                                                      VirtualizingPanel.IsVirtualizing="True"
                                                                      VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                                                <ComboBox.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <VirtualizingStackPanel/>
                                                                    </ItemsPanelTemplate>
                                                                </ComboBox.ItemsPanel>
                                                                <ComboBox.GroupStyle>
                                                                    <GroupStyle>
                                                                        <GroupStyle.HeaderTemplate>
                                                                            <DataTemplate>
                                                                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                                                        Padding="6,3,6,3">
                                                                                    <TextBlock Text="{Binding Name}"
                                                                                               FontSize="11"
                                                                                               FontWeight="SemiBold"
                                                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                                               TextTrimming="CharacterEllipsis"/>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </GroupStyle.HeaderTemplate>
                                                                    </GroupStyle>
                                                                </ComboBox.GroupStyle>
                                                            </ComboBox>
                                                            <!-- Subtitle: assigned-device name when set,
                                                                 italic "Unassigned" when no descriptor. -->
                                                            <TextBlock FontSize="10"
                                                                       Foreground="{DynamicResource ColdMutedBrush}"
                                                                       Margin="4,1,0,0"
                                                                       TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="{Binding DeviceLabel}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Descriptor}" Value="">
                                                                                <Setter Property="Text" Value="{Binding Common_Unassigned, Source={x:Static strings:Strings.Instance}}"/>
                                                                                <Setter Property="FontStyle" Value="Italic"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <!-- InvertOnHold inline picker. Fits in the same slot
                                                             as the (hidden-for-InvertOnHold) source picker so
                                                             the whole row stays on one line. While the picked
                                                             modifier is held, the row's combined output is
                                                             sign-flipped. That's the B.3 reversible-throttle
                                                             shape (engine treats Kind=InvertOnHold sources as
                                                             row-level modifiers, see InputManager.Step3.
                                                             MappingSetEval.IsInvertOnHoldActive). -->
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,4,0"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding IsInvertOnHoldKind, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="⇋" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                       ToolTip="{Binding Pad_Mapping_Modifier_IconTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                            <StackPanel Orientation="Vertical" Margin="0,0,4,0">
                                                                <DockPanel LastChildFill="True">
                                                                    <reset:SettingResetButton DockPanel.Dock="Right" Command="{Binding ResetSettingCommand}" CommandParameter="ParamModifierInputChoice" SettingLabel="{Binding ResetLabel_ModifierInput, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MappingSourceItem_ParamModifierInputChoice_4848"/>
                                                                    <ComboBox ItemsSource="{Binding DataContext.ParamInputsView,
                                                                                RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"
                                                                              SelectedItem="{Binding ParamModifierInputChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              DisplayMemberPath="DisplayName"
                                                                              MinWidth="240" Padding="4,2"
                                                                              ToolTip="{Binding Pad_Mapping_Modifier_PickerTooltip, Source={x:Static strings:Strings.Instance}}"
                                                                              PreviewKeyDown="MappingComboBox_PreviewKeyDown"
                                                                              IsSynchronizedWithCurrentItem="False"
                                                                              VirtualizingPanel.IsVirtualizing="True"
                                                                              VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                                                              VirtualizingPanel.VirtualizationMode="Recycling">
                                                                        <ComboBox.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <VirtualizingStackPanel/>
                                                                            </ItemsPanelTemplate>
                                                                        </ComboBox.ItemsPanel>
                                                                        <ComboBox.GroupStyle>
                                                                            <GroupStyle>
                                                                                <GroupStyle.HeaderTemplate>
                                                                                    <DataTemplate>
                                                                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,3,6,3">
                                                                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                                        </Border>
                                                                                    </DataTemplate>
                                                                                </GroupStyle.HeaderTemplate>
                                                                            </GroupStyle>
                                                                        </ComboBox.GroupStyle>
                                                                    </ComboBox>
                                                                </DockPanel>
                                                                <TextBlock FontSize="10"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           Margin="4,1,0,0"
                                                                           TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="{Binding ParamModifierDeviceLabel}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ParamModifier}" Value="">
                                                                                    <Setter Property="Text" Value="{Binding Common_Unassigned, Source={x:Static strings:Strings.Instance}}"/>
                                                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <ui:Button Command="{Binding RecordParamModifierCommand}"
                                                                       Style="{StaticResource EmberIconButtonHot}"
                                                                       VerticalAlignment="Center">
                                                                <controls:GlyphText Text="{Binding RecordIconParamModifier}" FontFamily="Segoe MDL2 Assets"
                                                                           Foreground="{DynamicResource EmberBrush}"/>
                                                                <ui:Button.ToolTip>
                                                                    <TextBlock Text="{Binding RecordTextParamModifier}"/>
                                                                </ui:Button.ToolTip>
                                                            </ui:Button>
                                                        </StackPanel>
                                                        <!-- Record / Clear / Options / DeadZone, for the kinds that read
                                                             the Descriptor. An Incremental or Ramp source takes its inputs
                                                             from the Up / Down pickers and Record buttons on the row below,
                                                             and an Invert on Hold from its modifier picker. None of them
                                                             reads the Descriptor, HalfAxis or DeadZone, so those controls
                                                             would be noise there. Invert is hidden with them, and the
                                                             engine does apply it to a key source (SourceEvaluator), so a
                                                             source that takes Incremental or Ramp drops it
                                                             (MappingSourceItem.Kind). One saved with it keeps it and shows
                                                             the checkbox after this group. -->
                                                        <ui:Button Command="{Binding ToggleRecordCommand}"
                                                                   Style="{StaticResource EmberIconButtonHot}"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding IsKindDescriptorless, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                                            <controls:GlyphText Text="{Binding RecordButtonIcon}" FontFamily="Segoe MDL2 Assets"
                                                                       Foreground="{DynamicResource EmberBrush}"/>
                                                            <ui:Button.ToolTip>
                                                                <TextBlock Text="{Binding RecordButtonText}"/>
                                                            </ui:Button.ToolTip>
                                                        </ui:Button>
                                                        <ui:Button AutomationProperties.Name="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}" Command="{Binding ClearCommand}"
                                                                   Style="{StaticResource EmberIconButtonHot}"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding IsKindDescriptorless, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                                            <controls:GlyphText Text="&#xE75C;" FontFamily="Segoe MDL2 Assets"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                            <ui:Button.ToolTip>
                                                                <TextBlock Text="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}"/>
                                                            </ui:Button.ToolTip>
                                                        </ui:Button>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                                    Visibility="{Binding IsKindDescriptorless, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                                            <CheckBox Content="{Binding Pad_Invert, Source={x:Static strings:Strings.Instance}}"
                                                                      IsChecked="{Binding Invert, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      IsEnabled="{Binding IsInvertApplicable}"
                                                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11.5"
                                                                      Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="Invert" SettingLabel="{Binding Pad_Invert, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MappingSourceItem_Invert_4926" Margin="4,0,8,0"/>
                                                            <CheckBox Content="{Binding Pad_Half, Source={x:Static strings:Strings.Instance}}"
                                                                      IsChecked="{Binding HalfAxis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      IsEnabled="{Binding IsHalfAxisApplicable}"
                                                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11.5"
                                                                      Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="HalfAxis" SettingLabel="{Binding Pad_Half, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MappingSourceItem_HalfAxis_4931" Margin="4,0,8,0"/>
                                                            <CheckBox Content="{Binding Pad_Either, Source={x:Static strings:Strings.Instance}}"
                                                                      ToolTip="{Binding Pad_Either_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                                      IsChecked="{Binding Bidirectional, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      IsEnabled="{Binding HalfAxis}"
                                                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11.5"
                                                                      Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="Bidirectional" SettingLabel="{Binding Pad_Either, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MappingSourceItem_Bidirectional_4937" Margin="4,0,8,0"/>
                                                            <CheckBox Content="{Binding Pad_InvertOutput, Source={x:Static strings:Strings.Instance}}"
                                                                      ToolTip="{Binding Pad_InvertOutput_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                                      IsChecked="{Binding InvertOutput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      Visibility="{Binding IsInvertOutputApplicable, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11.5"
                                                                      Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <!-- Gated with the control it resets: an ungated reset left a lone button behind a hidden setting. -->
                                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="InvertOutput" SettingLabel="{Binding Pad_InvertOutput, Source={x:Static strings:Strings.Instance}}" Visibility="{Binding IsInvertOutputApplicable, Converter={StaticResource BoolToVisibilityConverter}}" AutomationProperties.AutomationId="Reset_MappingSourceItem_InvertOutput_4943"/>
                                                        </StackPanel>
                                                        <!-- An Incremental or Ramp source saved with Invert on. The
                                                             engine has turned its output around all along, so the flag
                                                             stays, and this is the control that turns it off. Unchecked,
                                                             it goes: the kind offers no Invert. Always enabled, since
                                                             Half and Either mean nothing to a key source. -->
                                                        <CheckBox Content="{Binding Pad_Invert, Source={x:Static strings:Strings.Instance}}"
                                                                  IsChecked="{Binding Invert, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Visibility="{Binding IsKeyInvertShown, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11.5"
                                                                  Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <!-- Per-source gyro sensitivity. Only renders for
                                                             gyro descriptors so non-gyro sources don't see a
                                                             knob that does nothing. Sits before the deadzone
                                                             to match the primary-source row's order. -->
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0"
                                                                    Visibility="{Binding IsGyroSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Mapping_GyroSensitivity, Source={x:Static strings:Strings.Instance}}"
                                                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <Slider Value="{Binding GyroSensitivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    Minimum="0.1" Maximum="10" SmallChange="0.1" LargeChange="1"
                                                                    Width="120" VerticalAlignment="Center"
                                                                    ToolTip="{Binding Mapping_GyroSensitivity_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                            <TextBox Text="{Binding GyroSensitivity, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                                                     Width="50" Margin="4,0,4,0" Padding="2,1"
                                                                     VerticalContentAlignment="Center"/>
                                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="×" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                            <ui:Button Command="{Binding ResetGyroSensitivityCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Common_Reset_Sensitivity, Source={x:Static strings:Strings.Instance}}"/>
                                                        </StackPanel>
                                                        <!-- Gyro Lean rows scale by the GENERIC per-source
                                                             Sensitivity (the field ReadGyroLean reads), not
                                                             GyroSensitivity. The gyro dial above is
                                                             rate-only (#292). Same visual, working field. -->
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0"
                                                                    Visibility="{Binding IsGyroLeanSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Mapping_GyroSensitivity, Source={x:Static strings:Strings.Instance}}"
                                                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <Slider Value="{Binding Sensitivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    Minimum="0.001" Maximum="5" SmallChange="0.1" LargeChange="1"
                                                                    Width="120" VerticalAlignment="Center"
                                                                    ToolTip="{Binding Mapping_LeanSensitivity_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                            <TextBox Text="{Binding Sensitivity, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00#}}"
                                                                     Width="50" Margin="4,0,4,0" Padding="2,1"
                                                                     VerticalContentAlignment="Center"/>
                                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="×" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                            <ui:Button Command="{Binding ResetSensitivityCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Common_Reset_Sensitivity, Source={x:Static strings:Strings.Instance}}"/>
                                                        </StackPanel>
                                                        <!-- Per-source acceleration: rate-dependent gain the
                                                             engine applies at the shared bipolar/unipolar seam.
                                                             Continuous sources only, MINUS the gravity-tilt
                                                             pairs (#292): their engine path never applies
                                                             ParamAccel, so the knob would be dead there. -->
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0"
                                                                    Visibility="{Binding IsParamAccelApplicable, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Mapping_Accel, Source={x:Static strings:Strings.Instance}}"
                                                                       VerticalAlignment="Center" Margin="0,0,4,0"
                                                                       ToolTip="{Binding Pad_Mapping_Accel_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                            <Slider Value="{Binding ParamAccel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    Minimum="0" Maximum="5" SmallChange="0.05" LargeChange="0.5"
                                                                    Width="90" VerticalAlignment="Center"
                                                                    ToolTip="{Binding Pad_Mapping_Accel_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                            <TextBox Text="{Binding ParamAccel, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                                                     Width="44" Margin="4,0,4,0" Padding="2,1"
                                                                     VerticalContentAlignment="Center"/>
                                                            <ui:Button Command="{Binding ResetParamAccelCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Common_Reset_Acceleration, Source={x:Static strings:Strings.Instance}}"/>
                                                        </StackPanel>
                                                        <!-- Per-source mouse cursor sensitivity (#107). Only
                                                             renders for "Mouse Position X/Y" descriptors. -->
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0"
                                                                    Visibility="{Binding IsMouseCursorSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Mapping_MouseCursorSensitivity, Source={x:Static strings:Strings.Instance}}"
