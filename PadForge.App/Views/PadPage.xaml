                                    </StackPanel>
                                </controls:MoreRow>
                            </StackPanel>
                        </Border>

                        <controls:FoldList Gap="12">
                        <!-- ─── Joystick / D-pad output card ─── -->
                        <controls:FoldCard x:Name="TouchpadStickFoldCard" StateKey="Pad.Touch.Stick"
                                           Header="{Binding Pad_Touchpad_Stick_Header, Source={x:Static strings:Strings.Instance}}"
                                           Hint="{Binding Pad_TouchpadStick_FoldHint, Source={x:Static strings:Strings.Instance}}"
                                           Description="{Binding Pad_Touchpad_Stick_Subtitle, Source={x:Static strings:Strings.Instance}}">
                            <controls:FoldCard.HeaderAction>
                                <ui:Button Command="{Binding ResetTouchpadJoystickCardCommand}" Style="{StaticResource ResetAllButton}"
                                        Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}"
                                        ToolTip="{Binding Pad_ResetTouchpadStick, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:FoldCard.HeaderAction>
                            <controls:FoldCard.Summary>
                                <MultiBinding Converter="{StaticResource OnOffTextConverter}">
                                    <Binding Path="TouchpadEnableJoystickOutput"/>
                                    <Binding Path="Common_On" Source="{x:Static strings:Strings.Instance}"/>
                                    <Binding Path="Common_Off" Source="{x:Static strings:Strings.Instance}"/>
                                </MultiBinding>
                            </controls:FoldCard.Summary>
                            <StackPanel>

                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Pad_Touchpad_StickEnabled, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <CheckBox Style="{StaticResource SwitchCheckBox}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Touchpad_StickEnabled, Source={x:Static strings:Strings.Instance}}"
                                              ToolTip="{Binding Pad_Touchpad_StickEnabled_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding TouchpadEnableJoystickOutput, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetTouchpadEnableJoystickOutputCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadStickEnabled, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>
                                <!-- Dependents obey the master toggle (#175 item 4),
                                     Constant Force idiom. Rows carry the Sticks DZ
                                     grammar (#175 item 15): slider + percent edit,
                                     0..1 setting units unchanged behind the
                                     FractionToPercentConverter. -->
                                <StackPanel IsEnabled="{Binding TouchpadEnableJoystickOutput}">
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <TextBlock Text="{Binding Pad_Touchpad_StickMaxRadius, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzSubLabel}"/>
                                        <Slider Value="{Binding TouchpadJoystickMaxRadius, Mode=TwoWay, Converter={StaticResource FractionToPercentConverter}}"
                                                Style="{StaticResource DzSlider}" Minimum="5" Maximum="50"/>
                                        <TextBox Text="{Binding TouchpadJoystickMaxRadius, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource FractionToPercentConverter}, StringFormat={}{0:0.#}}"
                                                 Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding ResetTouchpadJoystickMaxRadiusCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_ResetTouchpadStickMaxRadius, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <TextBlock Text="{Binding Pad_Touchpad_StickInnerDeadzone, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzSubLabel}"/>
                                        <Slider Value="{Binding TouchpadJoystickInnerDeadzone, Mode=TwoWay, Converter={StaticResource FractionToPercentConverter}}"
                                                Style="{StaticResource DzSlider}" Maximum="10"/>
                                        <TextBox Text="{Binding TouchpadJoystickInnerDeadzone, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource FractionToPercentConverter}, StringFormat={}{0:0.#}}"
                                                 Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding ResetTouchpadJoystickInnerDeadzoneCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_ResetTouchpadStickInnerDeadzone, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>

                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <TextBlock Text="{Binding Pad_Touchpad_StickDPadMode_Label, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                                  />
                                        <ComboBox SelectedValue="{Binding TouchpadJoystickDPadMode, Mode=TwoWay}"
                                                  SelectedValuePath="Tag"
                                                  MaxWidth="120" controls:SettingRow.Fills="True" VerticalAlignment="Center"
                                                  ToolTip="{Binding Pad_Touchpad_StickDPadMode_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                  ScrollViewer.VerticalScrollBarVisibility="Visible">
                                            <ComboBoxItem Tag="Off" Content="{Binding Pad_Touchpad_StickDPadMode_Off, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Tag="FourWay" Content="{Binding Pad_Touchpad_StickDPadMode_FourWay, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Tag="EightWay" Content="{Binding Pad_Touchpad_StickDPadMode_EightWay, Source={x:Static strings:Strings.Instance}}"/>
                                        </ComboBox>
                                        <ui:Button Command="{Binding ResetTouchpadJoystickDPadModeCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_ResetTouchpadStickDPadMode, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                    <!-- Activation additionally obeys its own master:
                                         dead row while D-Pad Mode is Off (item 4). -->
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <controls:SettingRow.Style>
                                            <Style TargetType="controls:SettingRow">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TouchpadJoystickDPadMode}" Value="Off">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:SettingRow.Style>
                                        <TextBlock Text="{Binding Pad_Touchpad_StickDPadActivationThreshold, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzSubLabel}"/>
                                        <Slider Value="{Binding TouchpadJoystickDPadActivationThreshold, Mode=TwoWay, Converter={StaticResource FractionToPercentConverter}}"
                                                Style="{StaticResource DzSlider}" Minimum="5" Maximum="50"/>
                                        <TextBox Text="{Binding TouchpadJoystickDPadActivationThreshold, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource FractionToPercentConverter}, StringFormat={}{0:0.#}}"
                                                 Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding ResetTouchpadJoystickDPadActivationThresholdCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_ResetTouchpadStickDPadActivationThreshold, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                </StackPanel>
                            </StackPanel>
                        </controls:FoldCard>

                        <!-- ─── Absolute Pointer card (#9 B-15) ───
                             The screen rectangle the "Touchpad N Pointer X/Y"
                             absolute cursor sources map onto. Size 1.0 with
                             center 0.5 is Steam's full-screen 1:1
                             mouse_region map. A smaller size confines the
                             cursor to part of the screen and the center
                             places that part. Size below 1.0 is the case an
                             earlier stretch-only knob could not express, so
                             imported regions were invisible AND uneditable. -->
                        <controls:FoldCard x:Name="TouchpadPointerFoldCard" StateKey="Pad.Touch.Pointer"
                                           Header="{Binding Pad_Touchpad_Pointer_Header, Source={x:Static strings:Strings.Instance}}"
                                           Hint="{Binding Pad_AbsolutePointer_FoldHint, Source={x:Static strings:Strings.Instance}}"
                                           Description="{Binding Pad_Touchpad_Pointer_Subtitle, Source={x:Static strings:Strings.Instance}}">
                            <controls:FoldCard.HeaderAction>
                                <ui:Button Command="{Binding ResetTouchpadPointerCardCommand}" Style="{StaticResource ResetAllButton}"
                                        Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}"
                                        ToolTip="{Binding Pad_ResetTouchpadPointer, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:FoldCard.HeaderAction>
                            <StackPanel>

                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Pad_Touchpad_PointerRegionSizeX, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding TouchpadPointerRegionSizeX, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}" Minimum="0.05" Maximum="3" TickFrequency="0.05"
                                            ToolTip="{Binding Pad_Touchpad_PointerRegionSizeX_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding TouchpadPointerRegionSizeX, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                             Style="{StaticResource DzValueEdit}"
                                             ToolTip="{Binding Pad_Touchpad_PointerRegionSizeX_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBlock Text="×" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetTouchpadPointerRegionSizeXCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadPointerRegionSizeX, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Pad_Touchpad_PointerRegionSizeY, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding TouchpadPointerRegionSizeY, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}" Minimum="0.05" Maximum="3" TickFrequency="0.05"
                                            ToolTip="{Binding Pad_Touchpad_PointerRegionSizeY_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding TouchpadPointerRegionSizeY, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                             Style="{StaticResource DzValueEdit}"
                                             ToolTip="{Binding Pad_Touchpad_PointerRegionSizeY_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBlock Text="×" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetTouchpadPointerRegionSizeYCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadPointerRegionSizeY, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Pad_Touchpad_PointerRegionCenterX, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding TouchpadPointerRegionCenterX, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}" Minimum="0" Maximum="1" TickFrequency="0.01"
                                            ToolTip="{Binding Pad_Touchpad_PointerRegionCenterX_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding TouchpadPointerRegionCenterX, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                             Style="{StaticResource DzValueEdit}"
                                             ToolTip="{Binding Pad_Touchpad_PointerRegionCenterX_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBlock Text="×" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetTouchpadPointerRegionCenterXCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadPointerRegionCenterX, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Pad_Touchpad_PointerRegionCenterY, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding TouchpadPointerRegionCenterY, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}" Minimum="0" Maximum="1" TickFrequency="0.01"
                                            ToolTip="{Binding Pad_Touchpad_PointerRegionCenterY_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding TouchpadPointerRegionCenterY, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                             Style="{StaticResource DzValueEdit}"
                                             ToolTip="{Binding Pad_Touchpad_PointerRegionCenterY_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBlock Text="×" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetTouchpadPointerRegionCenterYCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadPointerRegionCenterY, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>
                            </StackPanel>
                        </controls:FoldCard>

                        <!-- ─── Synthetic Pressure card (discussion #239) ───
                             DS2/DS3-style pressure synthesis for pads whose
                             hardware reports a touch as pressure 1.0
                             (DualShock 4, DualSense, Steam Controller 2015):
                             mapping Pressure reads become no touch = 0,
                             touch = the configured level, pad click = 100%.
                             The two fields live on the per-device
                             DeviceSlotConfig (the Audio tab's mirror-row
                             pattern), so the bindings follow the selected
                             device through the DeviceConfig anchor. Rows
                             follow the Swipe Haptics card anatomy. -->
                        <controls:FoldCard x:Name="SyntheticPressureFoldCard" StateKey="Pad.Touch.Pressure"
                                           Header="{Binding Pad_Touchpad_SyntheticPressure_Header, Source={x:Static strings:Strings.Instance}}"
                                           Hint="{Binding Pad_SyntheticPressure_FoldHint, Source={x:Static strings:Strings.Instance}}"
                                           Description="{Binding Pad_Touchpad_SyntheticPressure_Subtitle, Source={x:Static strings:Strings.Instance}}">
                            <controls:FoldCard.HeaderAction>
                                <ui:Button Command="{Binding ResetTouchpadSyntheticPressureCardCommand}" Style="{StaticResource ResetAllButton}"
                                        Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}"
                                        ToolTip="{Binding Pad_ResetTouchpadSyntheticPressure, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:FoldCard.HeaderAction>
                            <controls:FoldCard.Summary>
                                <MultiBinding Converter="{StaticResource OnOffTextConverter}">
                                    <Binding Path="DeviceConfig.TouchpadSyntheticPressure"/>
                                    <Binding Path="Common_On" Source="{x:Static strings:Strings.Instance}"/>
                                    <Binding Path="Common_Off" Source="{x:Static strings:Strings.Instance}"/>
                                </MultiBinding>
                            </controls:FoldCard.Summary>
                            <StackPanel>

                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Pad_Touchpad_SyntheticPressureEnabled, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <CheckBox Style="{StaticResource SwitchCheckBox}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Touchpad_SyntheticPressureEnabled, Source={x:Static strings:Strings.Instance}}"
                                              ToolTip="{Binding Pad_Touchpad_SyntheticPressureEnabled_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding DeviceConfig.TouchpadSyntheticPressure, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetTouchpadSyntheticPressureEnabledCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadSyntheticPressureEnabled, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>
                                <!-- Dependent obeys the master toggle (#175 item 4),
                                     Constant Force idiom. The level is already an
                                     int percent, so the row binds directly with no
                                     converter. -->
                                <StackPanel IsEnabled="{Binding DeviceConfig.TouchpadSyntheticPressure}">
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <TextBlock Text="{Binding Pad_Touchpad_SyntheticTouchLevel, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzSubLabel}"/>
                                        <Slider Value="{Binding DeviceConfig.TouchpadSyntheticTouchPercent, Mode=TwoWay}"
                                                Style="{StaticResource DzSlider}" Maximum="100"
                                                ToolTip="{Binding Pad_Touchpad_SyntheticTouchLevel_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBox Text="{Binding DeviceConfig.TouchpadSyntheticTouchPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource DzValueEdit}"
                                                 ToolTip="{Binding Pad_Touchpad_SyntheticTouchLevel_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding ResetTouchpadSyntheticTouchPercentCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_ResetTouchpadSyntheticTouchLevel, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                </StackPanel>
                            </StackPanel>
                        </controls:FoldCard>

                        <!-- ─── Swipe Haptics card (discussion #219) ───
                             Steam-Input-style pulse ticks as the finger
                             travels the pad. Visible only when the selected
                             device's touchpad has a haptic lane PadForge
                             drives (Steam Controller family / Sony pads).
                             A Precision Touchpad or overlay would show a
                             dead toggle otherwise. Rows follow the Mouse
                             Output card anatomy. The intensity row uses the
                             Sticks DZ grammar (slider + percent edit) over
                             the 0..1 setting via FractionToPercentConverter. -->
                        <controls:FoldCard x:Name="SwipeHapticsFoldCard" StateKey="Pad.Touch.SwipeHaptics" Visibility="{Binding SelectedDeviceHasTouchpadPulse, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Header="{Binding Pad_Touchpad_SwipeHaptics_Header, Source={x:Static strings:Strings.Instance}}"
                                           Hint="{Binding Pad_SwipeHaptics_FoldHint, Source={x:Static strings:Strings.Instance}}"
                                           Description="{Binding Pad_Touchpad_SwipeHaptics_Subtitle, Source={x:Static strings:Strings.Instance}}">
                            <controls:FoldCard.HeaderAction>
                                <ui:Button Command="{Binding ResetTouchpadSwipeHapticsCardCommand}" Style="{StaticResource ResetAllButton}"
                                        Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}"
                                        ToolTip="{Binding Pad_ResetTouchpadSwipeHaptics, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:FoldCard.HeaderAction>
                            <controls:FoldCard.Summary>
                                <MultiBinding Converter="{StaticResource OnOffTextConverter}">
                                    <Binding Path="TouchpadSwipeHapticsEnabled"/>
                                    <Binding Path="Common_On" Source="{x:Static strings:Strings.Instance}"/>
                                    <Binding Path="Common_Off" Source="{x:Static strings:Strings.Instance}"/>
                                </MultiBinding>
                            </controls:FoldCard.Summary>
                            <StackPanel>

                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Pad_Touchpad_SwipeHapticsEnabled, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <CheckBox Style="{StaticResource SwitchCheckBox}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Touchpad_SwipeHapticsEnabled, Source={x:Static strings:Strings.Instance}}"
                                              ToolTip="{Binding Pad_Touchpad_SwipeHapticsEnabled_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding TouchpadSwipeHapticsEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetTouchpadSwipeHapticsEnabledCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadSwipeHapticsEnabled, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>
                                <StackPanel IsEnabled="{Binding TouchpadSwipeHapticsEnabled}">
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <TextBlock Text="{Binding Pad_Touchpad_SwipeHapticsIntensity, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzSubLabel}"/>
                                        <Slider Value="{Binding TouchpadSwipeHapticsIntensity, Mode=TwoWay, Converter={StaticResource FractionToPercentConverter}}"
                                                Style="{StaticResource DzSlider}" Minimum="5" Maximum="100"
                                                ToolTip="{Binding Pad_Touchpad_SwipeHapticsIntensity_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBox Text="{Binding TouchpadSwipeHapticsIntensity, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource FractionToPercentConverter}, StringFormat={}{0:0.#}}"
                                                 Style="{StaticResource DzValueEdit}"
                                                 ToolTip="{Binding Pad_Touchpad_SwipeHapticsIntensity_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding ResetTouchpadSwipeHapticsIntensityCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_ResetTouchpadSwipeHapticsIntensity, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                </StackPanel>
                            </StackPanel>
                        </controls:FoldCard>

                        <!-- ─── Gesture Detection card ─── -->
                        <controls:FoldCard x:Name="GestureDetectionFoldCard" StateKey="Pad.Touch.Gestures"
                                           Header="{Binding Pad_Touchpad_Detection_Header, Source={x:Static strings:Strings.Instance}}"
                                           Hint="{Binding Pad_GestureDetection_FoldHint, Source={x:Static strings:Strings.Instance}}">
                            <controls:FoldCard.HeaderAction>
                                <ui:Button Command="{Binding ResetTouchpadDetectionCardCommand}" Style="{StaticResource ResetAllButton}"
                                        Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}"
                                        ToolTip="{Binding Pad_ResetTouchpadDetection, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:FoldCard.HeaderAction>
                            <controls:FoldCard.Summary>
                                <MultiBinding Converter="{StaticResource OnOffTextConverter}">
                                    <Binding Path="TouchpadGesturesEnabled"/>
                                    <Binding Path="Common_On" Source="{x:Static strings:Strings.Instance}"/>
                                    <Binding Path="Common_Off" Source="{x:Static strings:Strings.Instance}"/>
                                </MultiBinding>
                            </controls:FoldCard.Summary>
                            <StackPanel>
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Pad_Touchpad_GesturesEnabled, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <CheckBox Style="{StaticResource SwitchCheckBox}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Touchpad_GesturesEnabled, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding TouchpadGesturesEnabled, Mode=TwoWay}"
                                              ToolTip="{Binding Pad_Touchpad_GesturesEnabled_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                              VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetTouchpadGesturesEnabledCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadGesturesEnabled, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>
                                <!-- Mode + cooldown obey the enable toggle (#175 item 4),
                                     Constant Force idiom. -->
                                <StackPanel IsEnabled="{Binding TouchpadGesturesEnabled}">
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <TextBlock Text="{Binding Pad_Touchpad_Mode_Label, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                                  />
                                        <ComboBox SelectedValue="{Binding TouchpadGestureMode, Mode=TwoWay}"
                                                  SelectedValuePath="Tag"
                                                  MaxWidth="180" controls:SettingRow.Fills="True" VerticalAlignment="Center"
                                                  ToolTip="{Binding Pad_Touchpad_Mode_Tooltip, Source={x:Static strings:Strings.Instance}}"
