<views:DialogWindow AutomationProperties.IsDialog="True" x:Class="PadForge.Views.UninstallHIDMaestroDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        xmlns:controls="clr-namespace:PadForge.Controls"
        xmlns:common="clr-namespace:PadForge.Common"
        xmlns:views="clr-namespace:PadForge.Views"
        BodyPadding="22,14,22,18"
        Title="{Binding HIDMaestroUninstall_Title, Source={x:Static strings:Strings.Instance}}"
        Subtitle="{Binding HIDMaestroUninstall_Message, Source={x:Static strings:Strings.Instance}}">

    <!-- The removal of HIDMaestro from the PC (#518), as the Confirm board
         draws it: what HIDMaestro's own preview found, item by item, over a
         foot where Cancel holds the default and the first focus. The same
         window, with Close alone, lists what a removal could not take. -->
    <views:DialogWindow.Foot>
        <controls:FlexLinePanel Style="{StaticResource DialogFootPanel}">
            <Button x:Name="RefreshButton" Style="{StaticResource DialogQuietButton}"
                    Content="{Binding Common_Refresh, Source={x:Static strings:Strings.Instance}}"
                    Click="RefreshButton_Click"/>
            <Button x:Name="CancelButton" Style="{StaticResource DialogButton}"
                    Content="{Binding Common_Cancel, Source={x:Static strings:Strings.Instance}}"
                    IsCancel="True" IsDefault="True"/>
            <Button x:Name="ActionButton" Style="{StaticResource DialogDangerButton}" IsEnabled="False"
                    Content="{Binding Common_Uninstall, Source={x:Static strings:Strings.Instance}}"
                    Click="ActionButton_Click"/>
        </controls:FlexLinePanel>
    </views:DialogWindow.Foot>

    <StackPanel>
        <!-- While the preview reads the PC. -->
        <Border x:Name="BusyPanel" Style="{StaticResource DialogLiveBox}">
            <StackPanel Orientation="Horizontal">
                <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding HIDMaestroUninstall_Reading, Source={x:Static strings:Strings.Instance}}"
                           VerticalAlignment="Center" common:LiveText.Polite="True"/>
            </StackPanel>
        </Border>

        <!-- A removal that programs block, with those programs, or a preview
             that failed: the boards' wait box. -->
        <Border x:Name="NotePanel" Style="{StaticResource DialogWaitBox}" Margin="0,0,0,10" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="NoteText" TextWrapping="Wrap" common:LiveText.Polite="True"/>
                <ItemsControl x:Name="ProgramList" Margin="0,6,0,0" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13"
                                       FontFamily="{DynamicResource TelemetryFontFamily}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <!-- Nothing to remove: a plain line, with no box. -->
        <TextBlock x:Name="PlainNoteText" Margin="0,0,0,10" Visibility="Collapsed" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" common:LiveText.Polite="True"/>

        <!-- Each item HIDMaestro found: what it is over where it is, with why
             one stays or could not be read, and what becomes of it at the
             row's end. HIDMaestro writes these in English, as it writes its
             exception messages. -->
        <Border x:Name="EntryFrame" Style="{StaticResource DialogList}" Visibility="Collapsed">
            <ListBox x:Name="EntryList" Style="{StaticResource DialogListBox}" MaxHeight="300"
                     ItemContainerStyle="{StaticResource DialogListItemTall}"
                     ItemTemplate="{StaticResource DialogRemovalRow}"
                     AutomationProperties.Name="{Binding HIDMaestroUninstall_Title, Source={x:Static strings:Strings.Instance}}"/>
        </Border>

        <!-- usbip-win2 that its own installer put on the PC goes only when
             the user asks (HMUninstallOptions.IncludeUsbip). Changing it
             reads the PC again. Its tooltip says what else that touches. -->
        <StackPanel x:Name="UsbipPanel" Margin="0,12,0,0">
            <CheckBox x:Name="IncludeUsbipBox" MinHeight="36"
                      Content="{Binding HIDMaestroUninstall_IncludeUsbip, Source={x:Static strings:Strings.Instance}}"
                      ToolTip="{Binding HIDMaestroUninstall_IncludeUsbipDesc, Source={x:Static strings:Strings.Instance}}"
                      Checked="IncludeUsbipBox_Changed" Unchecked="IncludeUsbipBox_Changed"/>
        </StackPanel>
    </StackPanel>
</views:DialogWindow>
