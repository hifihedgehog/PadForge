<ui:FluentWindow x:Class="PadForge.MainWindow"
    FontFamily="{StaticResource BodyFontFamily}"
    FontSize="13"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:PadForge"
        xmlns:views="clr-namespace:PadForge.Views"
        xmlns:controls="clr-namespace:PadForge.Controls"
        xmlns:viewControls="clr-namespace:PadForge.Views.Controls"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Title="{Binding Title}"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        Stylus.IsPressAndHoldEnabled="False"
        Stylus.IsTapFeedbackEnabled="False"
        Stylus.IsTouchFeedbackEnabled="False"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        WindowStartupLocation="Manual">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- The ground (#574): one flat fill under everything, the page's
             color. Dark theme only. UpdateSteelLayer collapses it in Light,
             where the window's own backdrop shows. -->
        <Grid x:Name="SteelLayer" Grid.RowSpan="2" IsHitTestVisible="False">
            <Border Background="{DynamicResource SteelGroundBrush}"/>
        </Grid>

        <!-- The title bar (#574): the PadForge mark and name, the profile
             switcher, and the window's own buttons, on the pane's fill with
             a hairline under it. TitleBar provides native minimize,
             maximize and close with Snap Layout support. -->
        <Grid x:Name="AppBrandingBar" Grid.Row="0" Height="48">
            <Border Background="{DynamicResource SteelPaneBrush}"
                    BorderBrush="{DynamicResource SteelPaneLineBrush}" BorderThickness="0,0,0,1"
                    IsHitTestVisible="False"/>
            <ui:TitleBar x:Name="AppTitleBar" Height="48"
                         ButtonsForeground="{DynamicResource TextFillColorSecondaryBrush}"
                         CloseClicked="TitleBar_CloseClicked"
                         MaximizeClicked="TitleBar_MaximizeClicked"
                         ForceShutdown="False">
                <ui:TitleBar.Resources>
                    <!-- Minimize, maximize and close: 40 by 32, centered in
                         the 48 of the bar, 2 apart. wpf-ui draws them 44 by
                         30 against the bar's top edge, which leaves them
                         above the middle of a bar this tall. -->
                    <Style TargetType="ui:TitleBarButton" BasedOn="{StaticResource {x:Type ui:TitleBarButton}}">
                        <Setter Property="Width" Value="40"/>
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="Margin" Value="0,8,2,0"/>
                    </Style>
                </ui:TitleBar.Resources>
                <ui:TitleBar.Header>
                    <Border x:Name="AppBrandingBorder" Padding="14,0,12,0" Height="48"
                            Background="Transparent" MouseLeftButtonDown="BrandingBar_MouseDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:DecorativeImage FlowDirection="LeftToRight" Source="/Resources/PadForge-icon.png" Width="24" Height="24"
                                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                            <TextBlock Text="PadForge" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Border>
                </ui:TitleBar.Header>
                <ui:TitleBar.TrailingContent>
                    <StackPanel Orientation="Horizontal">
                    <!-- The profile switcher (#574): the pill the status bar
                         carried, now beside the window's own buttons. A
                         click opens the switcher under it, and an applied
                         auto-switch flares it (both wired in code-behind).
                         It binds itself to MainViewModel.Settings once it
                         loads, so it needs nothing from this tree. wpf-ui's
                         title bar leaves the pointer to whatever sits in
                         TrailingContent (TitleBar.cs, the WM_NCHITTEST
                         branch), so the pill takes its own clicks, and it
                         is marked hit-testable in the chrome as the full
                         screen button beside it is. Its AutomationId is the
                         one it always had. -->
                    <viewControls:ProfilePill x:Name="TitleProfilePill"
                                              VerticalAlignment="Center" Margin="0,0,8,0"
                                              WindowChrome.IsHitTestVisibleInChrome="True"
                                              AutomationProperties.AutomationId="ProfilePillStatusBar"/>
                    <!-- Full screen: the fourth of the window's buttons. It
                         has the size, the place and the icon weight the
                         three beside it are given in the title bar's
                         resources below, so the four read as one row. -->
                    <controls:StateToggleButton x:Name="FullScreenBtn" AutomationProperties.Name="{Binding Main_FullScreen, Source={x:Static strings:Strings.Instance}}" Click="FullScreenBtn_Click" Width="40" Height="32"
                            Background="Transparent" BorderThickness="0" Padding="0"
                            VerticalAlignment="Top" Margin="0,8,2,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <!-- AncestorType, not ElementName: TrailingContent
                                                         is applied inside the TitleBar's template, so
                                                         an ElementName lookup crosses a template name
                                                         scope and resolves timing-dependently. It was
                                                         clean here and a startup BINDERR on a field
                                                         machine (#285 reporter's log, 2026-08-08). -->
                                                    <Setter TargetName="LayoutRoot" Property="Background"
                                                            Value="{Binding ButtonsBackground, RelativeSource={RelativeSource AncestorType=ui:TitleBar}}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <!-- Foreground is bound in code-behind with an
                             explicit Source. TrailingContent is re-parented
                             into the TitleBar template's own namescope, so
                             both FindAncestor and ElementName bindings
                             evaluated before the tree connects and logged a
                             BINDERR on every launch. -->
                        <controls:GlyphText x:Name="FullScreenIcon" Text="&#xE740;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"/>
                    </controls:StateToggleButton>
                    </StackPanel>
                </ui:TitleBar.TrailingContent>
            </ui:TitleBar>
        </Grid>

        <!-- ═══════════════════════════════════════════
             Navigation View (left pane) with content overlay
             ═══════════════════════════════════════════ -->
        <ui:NavigationView x:Name="NavView" Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False"
                           AlwaysShowHeader="False"
                           OpenPaneLength="248"
                           Template="{StaticResource PadNavigationViewTemplate}"
                           ItemTemplate="{StaticResource PadNavigationViewItemTemplate}">

            <ui:NavigationView.Resources>
                <!-- One sidebar row (#574): 38 tall with 2 between rows.
                     It rests in the secondary text color, and the selected
                     one comes forward in the primary color and a heavier
                     weight. The fill and the icon's color are the entry
                     template's (Resources/Shell.xaml). Code-built entries
                     take this style too. -->
                <Style TargetType="ui:NavigationViewItem">
                    <Setter Property="MinHeight" Value="38"/>
                    <Setter Property="Margin" Value="0,0,0,2"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <Style.Triggers>
                        <Trigger Property="IsActive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ui:NavigationView.Resources>

            <!-- MenuItems built programmatically in code-behind (BuildNavigationItems) -->

            <!-- Settings and About follow the controllers under a hairline
                 (the sidebar's template draws the hairline and lays these
                 entries out right after the others, Resources/Shell.xaml). -->
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem x:Name="NavSettings" Content="{Binding Settings_Title, Source={x:Static strings:Strings.Instance}}" Tag="Settings" AutomationProperties.AutomationId="Nav_Settings" AutomationProperties.PositionInSet="1" AutomationProperties.SizeOfSet="2">
                    <ui:NavigationViewItem.Icon>
                        <controls:DecorativeStrokeIcon Data="{StaticResource NavSettingsGeometry}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavAbout" Content="{Binding About_Title, Source={x:Static strings:Strings.Instance}}" Tag="About" AutomationProperties.AutomationId="Nav_About" AutomationProperties.PositionInSet="2" AutomationProperties.SizeOfSet="2">
                    <ui:NavigationViewItem.Icon>
                        <controls:DecorativeStrokeIcon Data="{StaticResource NavAboutGeometry}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

            <!-- The engine's row (#574), last in the sidebar: the flame,
                 the state and the polling rate, which is the text Home's
                 engine card prints, in the language's own unit. The
                 bindings read MainViewModel, which the constructor hands
                 this element by name. -->
            <ui:NavigationView.PaneFooter>
                <Border x:Name="EngineFoot" Margin="0,12,0,0" MinHeight="40" Padding="12,0" CornerRadius="8"
                        Background="{DynamicResource SteelFootBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path x:Name="EngineFootFlame" FlowDirection="LeftToRight" Data="{StaticResource FlameOuterGeometry}"
                              Width="16" Height="16" Stretch="Uniform"
                              VerticalAlignment="Center">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <!-- Stopped: the outline alone. Running:
                                         ember. Idle or stopping: gold. -->
                                    <Setter Property="Fill" Value="Transparent"/>
                                    <Setter Property="Stroke" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <Setter Property="StrokeThickness" Value="1.2"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Dashboard.EngineStateKey}" Value="Running">
                                            <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                            <Setter Property="Stroke" Value="{x:Null}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Dashboard.EngineStateKey}" Value="Idle">
                                            <Setter Property="Fill" Value="{DynamicResource WaitBrush}"/>
                                            <Setter Property="Stroke" Value="{x:Null}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Dashboard.EngineStateKey}" Value="Stopping">
                                            <Setter Property="Fill" Value="{DynamicResource WaitBrush}"/>
                                            <Setter Property="Stroke" Value="{x:Null}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock x:Name="EngineFootState" Grid.Column="1" Text="{Binding EngineStatusText}"
                                   FontSize="13" Margin="10,0,8,0"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AutomationId="EngineFootState"/>
                        <TextBlock x:Name="EngineFootRate" Grid.Column="2" VerticalAlignment="Center"
                                   FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12"
                                   Foreground="{DynamicResource ColdBrush}"
                                   Text="{Binding Dashboard.PollingFrequencyText, Mode=OneWay}"/>
                    </Grid>
                </Border>
            </ui:NavigationView.PaneFooter>

            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <!-- The message line (#574), where the status bar's
                         message was. It is here only while there is a
                         message: a plain one fades and clears after about
                         five seconds (MainWindow.SweepStatusMessage), and one
                         that reports a failure stays until the next. It is
                         drawn over the page's lower corner and takes no row
                         of its own, so a message that comes and goes never
                         moves the page. First among the children and raised
                         by its ZIndex, so the pages keep their order under
                         it. The pointer passes through it. -->
                    <Border x:Name="StatusMessageLine" Panel.ZIndex="10"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="16,0,16,12" Padding="12,6" CornerRadius="6" MaxWidth="720"
                            Background="{DynamicResource SteelRaisedBrush}"
                            BorderBrush="{DynamicResource SteelLineBrush}" BorderThickness="1"
                            IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock x:Name="StatusMessageText" AutomationProperties.LiveSetting="Polite"
                                   Text="{Binding StatusText}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <!-- Home's AutomationId is the one the Dashboard had, as
                         its sidebar entry's is still Nav_Dashboard: UI tools
                         pair Nav_<tag> with <tag>PageView, and #574 keeps
                         every id. -->
                    <views:HomePage x:Name="HomePageView" AutomationProperties.AutomationId="DashboardPageView" Visibility="Visible"/>
                    <views:PadPage x:Name="PadPageView" Visibility="Collapsed"/>
                    <views:DevicesPage x:Name="DevicesPageView" Visibility="Collapsed"/>
                    <views:ExtrasPage x:Name="ExtrasPageView" Visibility="Collapsed"/>
                    <views:SettingsPage x:Name="SettingsPageView" Visibility="Collapsed"/>
                    <views:ProfilesPage x:Name="ProfilesPageView" Visibility="Collapsed"/>
                    <views:AboutPage x:Name="AboutPageView" Visibility="Collapsed"/>
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <!-- ═══════════════════════════════════════════
             Driver operation overlay
             ═══════════════════════════════════════════ -->
        <Grid x:Name="DriverOverlay"
              Grid.RowSpan="2"
              Visibility="Collapsed"
              Panel.ZIndex="1000">
            <Border Background="#80000000"/>
            <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    CornerRadius="8" Padding="32,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="280">
                <StackPanel HorizontalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True"
                                     Width="40" Height="40"
                                     Margin="0,0,0,16"/>
                    <!-- Headline role (#175 font sweep): the overlay's sole
                         16px line reads as its title, so it wears Display
                         like the shutdown/startup overlay titles. -->
                    <TextBlock x:Name="DriverOverlayText"
                               FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="16" HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════
             First-run welcome + spotlight tour (#175).
             Shown while the FirstRunTourCompleted setting is false, and
             re-runnable from Settings. A transparent click shield swallows
             clicks window-wide. Code-behind positions the highlight border
             and tip card.
             ═══════════════════════════════════════════ -->
        <Grid x:Name="FirstRunOverlay"
              Grid.RowSpan="2"
              Visibility="Collapsed"
              Panel.ZIndex="900"
              SizeChanged="FirstRunOverlay_SizeChanged">
            <!-- Click shield: transparent but hit-testable, so the tour
                 swallows clicks window-wide INCLUDING inside the spotlight
                 cutout below (the dimmer path does not hit-test there). -->
            <Border Background="Transparent"/>
            <!-- The dim is a path with the spotlight CUT OUT of it, so the
                 highlighted area renders at full brightness instead of
                 sitting under the scrim (Discord feedback 2026-08-19: the
                 old full-window dim left the very thing being pointed at
                 unreadable). The hole rect is positioned in code-behind
                 beside the ring; while the welcome panel is up the hole is
                 Empty and the dim covers everything, in both themes. -->
            <Path FlowDirection="LeftToRight" Fill="#D9070A0E">
                <Path.Data>
                    <CombinedGeometry GeometryCombineMode="Exclude">
                        <CombinedGeometry.Geometry1>
                            <RectangleGeometry x:Name="TourDimFull"/>
                        </CombinedGeometry.Geometry1>
                        <CombinedGeometry.Geometry2>
                            <RectangleGeometry x:Name="TourDimHole" RadiusX="8" RadiusY="8"/>
                        </CombinedGeometry.Geometry2>
                    </CombinedGeometry>
                </Path.Data>
            </Path>

            <Border x:Name="WelcomePanel"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="40,32"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="470">
                <StackPanel HorizontalAlignment="Center">
                    <Path FlowDirection="LeftToRight" Data="{StaticResource FlameOuterGeometry}"
                          Width="46" Height="46" Stretch="Uniform"
                          Fill="{DynamicResource EmberBrush}" HorizontalAlignment="Center">
                        <Path.Effect>
                            <DropShadowEffect Color="#FF6B2C" BlurRadius="26" ShadowDepth="0" Opacity="0.6"/>
                        </Path.Effect>
                    </Path>
                    <TextBlock Text="{Binding FirstRun_Title, Source={x:Static strings:Strings.Instance}}"
                               FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="24" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,16,0,6"/>
                    <TextBlock Text="{Binding FirstRun_Body, Source={x:Static strings:Strings.Instance}}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="360"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                        <!-- No Appearance=Primary: EmberPrimaryButton is the
                             app-wide accent look and its setters lose to the
                             Appearance style trigger (#175 dialog language). -->
                        <ui:Button Style="{StaticResource EmberPrimaryButton}"
                                   Content="{Binding FirstRun_Begin, Source={x:Static strings:Strings.Instance}}"
                                   Click="FirstRunBegin_Click"/>
                        <Button Content="{Binding FirstRun_Skip, Source={x:Static strings:Strings.Instance}}"
                                Margin="8,0,0,0" Click="FirstRunSkip_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Canvas x:Name="TourCanvas" Visibility="Collapsed">
                <Border x:Name="TourHighlight"
                        BorderBrush="{DynamicResource EmberBrush}" BorderThickness="2"
                        CornerRadius="8" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="#FF6B2C" BlurRadius="18" ShadowDepth="0" Opacity="0.5"/>
                    </Border.Effect>
                </Border>
                <Border x:Name="TourTip"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="16" Width="320">
                    <StackPanel>
                        <TextBlock x:Name="TourStepLabel"
                                   FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11"
                                   Foreground="{DynamicResource EmberHotBrush}"/>
                        <!-- CardTitle carries the Display face + 15/SemiBold
                             metrics this title already used (#175 font sweep). -->
                        <TextBlock x:Name="TourTitle" Style="{StaticResource CardTitle}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,2"/>
                        <TextBlock x:Name="TourBody" TextWrapping="Wrap" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <ui:Button x:Name="TourNextBtn"
                                       Style="{StaticResource EmberPrimaryButton}"
                                       Content="{Binding FirstRun_Next, Source={x:Static strings:Strings.Instance}}"
                                       Click="TourNext_Click"/>
                            <Button Content="{Binding FirstRun_Skip, Source={x:Static strings:Strings.Instance}}"
                                    Margin="8,0,0,0" Click="FirstRunSkip_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Canvas>
        </Grid>

        <!-- ═══════════════════════════════════════════
             Shutdown overlay
             ═══════════════════════════════════════════ -->
        <Grid x:Name="ShutdownOverlay"
              Grid.RowSpan="2"
              Visibility="Collapsed"
              Panel.ZIndex="1001">
            <Border Background="#CC000000"/>
            <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    CornerRadius="8" Padding="32,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="280">
                <StackPanel HorizontalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True"
                                     Width="40" Height="40"
                                     Margin="0,0,0,16"/>
                    <TextBlock FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Text="{Binding Main_ShuttingDown, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock x:Name="ShutdownOverlayText"
                               FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,4" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════
             Startup overlay — shown while the orphan-sweep
             task (App.OrphanSweepTask) is still running at
             launch. Hidden automatically when the task
             completes.
             ═══════════════════════════════════════════ -->
        <Grid x:Name="StartupOverlay"
              Grid.RowSpan="2"
              Visibility="Collapsed"
              Panel.ZIndex="1001">
            <Border Background="#CC000000"/>
            <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    CornerRadius="8" Padding="32,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="320">
                <StackPanel HorizontalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True"
                                     Width="40" Height="40"
                                     Margin="0,0,0,16"/>
                    <TextBlock FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Text="{Binding Main_StartingUp, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,6,0,4" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Text="{Binding Main_CleaningPreviousSession, Source={x:Static strings:Strings.Instance}}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
