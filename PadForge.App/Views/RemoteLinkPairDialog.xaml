<ui:FluentWindow x:Class="PadForge.Views.RemoteLinkPairDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Title="{Binding RemoteLink_PairTitle, Source={x:Static strings:Strings.Instance}}"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Dialog head (#175 item 11): ExtendsContentIntoTitleBar strips the
             system title bar, so the localized Title never rendered anywhere.
             Ember tick + display-face title makes it visible. The X stands in
             for the caption close button WindowChrome no longer provides.
             Closing without choosing routes through Reject. -->
        <Border Padding="14"
                BorderBrush="{DynamicResource SteelLineSoftBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5"
                           Fill="{DynamicResource EmberBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontFamily="{StaticResource DisplayFontFamily}"
                           FontWeight="SemiBold" FontSize="15"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           TextTrimming="CharacterEllipsis"/>
                <ui:Button Grid.Column="2" Style="{StaticResource EmberIconButton}"
                           VerticalAlignment="Center" Click="Reject_Click"
                           ToolTip="{Binding Common_Close, Source={x:Static strings:Strings.Instance}}">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </ui:Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding RemoteLink_PairPrompt, Source={x:Static strings:Strings.Instance}}"
                       TextWrapping="Wrap" Margin="0,0,0,16"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <!-- The SAS digits, compared out of band against the other screen -->
            <Border Grid.Row="1" CornerRadius="8" Padding="12,16" Margin="0,0,0,16"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <TextBlock x:Name="SasText" HorizontalAlignment="Center"
                           FontFamily="{StaticResource TelemetryFontFamily}" FontSize="40" FontWeight="SemiBold"/>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="{Binding RemoteLink_Identity, Source={x:Static strings:Strings.Instance}}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0"/>
                <TextBlock x:Name="IdentityText" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <ui:InfoBar Grid.Row="3" Severity="Warning" IsOpen="True" IsClosable="False"
                        Margin="0,0,0,12"
                        Message="{Binding RemoteLink_ConsentWarning, Source={x:Static strings:Strings.Instance}}"/>

            <CheckBox Grid.Row="4" x:Name="GamepadOnlyCheck" Margin="0,0,0,16"
                      Content="{Binding RemoteLink_GamepadOnly, Source={x:Static strings:Strings.Instance}}"/>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="PairButton" Appearance="Primary" MinWidth="96" Margin="0,0,8,0"
                           Content="{Binding RemoteLink_Pair, Source={x:Static strings:Strings.Instance}}"
                           Click="Pair_Click"/>
                <Button x:Name="RejectButton" MinWidth="96" IsCancel="True"
                        Content="{Binding RemoteLink_Reject, Source={x:Static strings:Strings.Instance}}"
                        Click="Reject_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
