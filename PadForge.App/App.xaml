<Application x:Class="PadForge.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:uictrl="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
             xmlns:conv="clr-namespace:PadForge.Converters"
>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/Resources/ControllerIcons.xaml"/>

                <!-- Custom theme overrides -->
                <ResourceDictionary>
                    <SolidColorBrush x:Key="RangeSliderThumbFill" Color="#F0F0F0"/>

                    <!-- Ember identity tokens (#175).
                         Cold = the physical side: devices, sources, raw telemetry.
                         Ember = the virtual side: outputs, targets, anything live.
                         Steel = the ground the two sit on.
                         Green/gold/red stay health-only and are not defined here. -->
                    <SolidColorBrush x:Key="EmberBrush" Color="#FF6B2C"/>
                    <SolidColorBrush x:Key="EmberHotBrush" Color="#FFA24D"/>
                    <SolidColorBrush x:Key="EmberDeepBrush" Color="#C43D0C"/>
                    <SolidColorBrush x:Key="EmberTintBrush" Color="#1AFF6B2C"/>
                    <SolidColorBrush x:Key="ColdBrush" Color="#58B6E4"/>
                    <SolidColorBrush x:Key="ColdDeepBrush" Color="#2E6A8F"/>
                    <SolidColorBrush x:Key="ColdTintBrush" Color="#1A58B6E4"/>
                    <SolidColorBrush x:Key="SteelGroundBrush" Color="#0B0E14"/>
                    <SolidColorBrush x:Key="SteelCardBrush" Color="#111623"/>
                    <SolidColorBrush x:Key="SteelRaisedBrush" Color="#1B2333"/>
                    <SolidColorBrush x:Key="SteelLineBrush" Color="#253049"/>
                    <SolidColorBrush x:Key="SteelLineSoftBrush" Color="#1C2536"/>

                    <!-- Flame glyph geometry (24x24 space). Material Design
                         Icons "fire" (Apache-2.0): licked outer silhouette
                         with an inner-tongue cutout (EvenOdd), so it reads
                         as fire at 12px instead of a droplet. Fill ember
                         when lit, gold when cooling, stroke-only when cold. -->
                    <Geometry x:Key="FlameOuterGeometry">M17.66 11.2C17.43 10.9 17.15 10.64 16.89 10.38C16.22 9.78 15.46 9.35 14.82 8.72C13.33 7.26 13 4.85 13.95 3C13 3.23 12.17 3.75 11.46 4.32C8.87 6.4 7.85 10.07 9.07 13.22C9.11 13.32 9.15 13.42 9.15 13.55C9.15 13.77 9 13.97 8.8 14.05C8.57 14.15 8.33 14.09 8.14 13.93C8.08 13.88 8.04 13.83 8 13.76C6.87 12.33 6.69 10.28 7.45 8.64C5.78 10 4.87 12.3 5 14.47C5.06 14.97 5.12 15.47 5.29 15.97C5.43 16.57 5.7 17.17 6 17.7C7.08 19.43 8.95 20.67 10.96 20.92C13.1 21.19 15.39 20.8 17.03 19.32C18.86 17.66 19.5 15 18.56 12.72L18.43 12.46C18.22 12 17.66 11.2 17.66 11.2M14.5 17.5C14.22 17.74 13.76 18 13.4 18.1C12.28 18.5 11.16 17.94 10.5 17.28C11.69 17 12.4 16.12 12.61 15.23C12.78 14.43 12.46 13.77 12.33 13C12.21 12.26 12.23 11.63 12.5 10.94C12.69 11.32 12.89 11.7 13.13 12C13.9 13 15.11 13.44 15.37 14.8C15.41 14.94 15.43 15.08 15.43 15.23C15.46 16.05 15.1 16.95 14.5 17.5Z</Geometry>

                    <!-- Telemetry text (#175 iteration 4): the platform face,
                         not a mono insert. Cascadia at 12px inside Segoe
                         lines read as pasted terminal text on real pixels.
                         Cold color carries the telemetry identity. -->
                    <FontFamily x:Key="TelemetryFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <!--
                WPF UI's default ComboBox style sets ScrollViewer.VerticalScrollBarVisibility
                to Hidden, which suppresses the scrollbar entirely. Force it Visible so
                the scrollbar element is present in the template, and pair with the
                always-on DynamicScrollBar retemplate below so the track/thumb are
                actually rendered instead of fading in only on hover.

                BasedOn must target WPF UI's DefaultComboBoxStyle — basing off
                {x:Type ComboBox} falls back to the unthemed system style.
            -->
            <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible"/>
                <Setter Property="MaxDropDownHeight" Value="200"/>
            </Style>

            <!--
                Always-visible DynamicScrollBar retemplate.
                WPF UI's shipped template starts PART_Border, PART_Track, and the line
                buttons at Opacity=0 and fades them in on IsMouseOver / IsInteracted
                (Fluent "passive scrollbar"). We want the track + thumb always visible,
                so copy the template with those opacities set to 1 and the opacity
                storyboards stripped. Width hover-expand (6→8) kept since it's cheap
                and matches Fluent feel.
            -->
            <ControlTemplate x:Key="AlwaysVisibleDynamicVerticalScrollBar" TargetType="{x:Type uictrl:DynamicScrollBar}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition MaxHeight="14"/>
                        <RowDefinition Height="0.00001*"/>
                        <RowDefinition MaxHeight="14"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="PART_Border" Grid.RowSpan="3" Width="12"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource ScrollBarTrackFillPointerOver}"
                            CornerRadius="6" Opacity="1"/>
                    <Track x:Name="PART_Track" Grid.Row="1" Width="6"
                           IsDirectionReversed="True" Opacity="1">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Style="{DynamicResource DynamicScrollBarPageButton}"/>
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Margin="0" Padding="0" Style="{DynamicResource DynamicScrollBarThumb}"/>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Style="{DynamicResource DynamicScrollBarPageButton}"/>
                        </Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
            </ControlTemplate>

            <ControlTemplate x:Key="AlwaysVisibleDynamicHorizontalScrollBar" TargetType="{x:Type uictrl:DynamicScrollBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition MaxWidth="14"/>
                        <ColumnDefinition Width="0.00001*"/>
                        <ColumnDefinition MaxWidth="14"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PART_Border" Grid.ColumnSpan="3" Height="12"
                            VerticalAlignment="Center"
                            Background="{DynamicResource ScrollBarTrackFillPointerOver}"
                            CornerRadius="6" Opacity="1"/>
                    <Track x:Name="PART_Track" Grid.Column="1" Height="6"
                           Opacity="1">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{DynamicResource DynamicScrollBarPageButton}"/>
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Margin="0" Padding="0" Style="{DynamicResource DynamicScrollBarThumb}"/>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageRightCommand" Style="{DynamicResource DynamicScrollBarPageButton}"/>
                        </Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
            </ControlTemplate>

            <Style TargetType="{x:Type uictrl:DynamicScrollBar}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="Height" Value="14"/>
                        <Setter Property="Template" Value="{StaticResource AlwaysVisibleDynamicHorizontalScrollBar}"/>
                    </Trigger>
                    <Trigger Property="Orientation" Value="Vertical">
                        <Setter Property="Width" Value="14"/>
                        <Setter Property="Height" Value="Auto"/>
                        <Setter Property="Template" Value="{StaticResource AlwaysVisibleDynamicVerticalScrollBar}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Global Converters -->
            <conv:BoolToColorConverter x:Key="BoolToColorConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:ShiftLayerVisibilityConverter x:Key="ShiftLayerVisibilityConverter" />
            <conv:HexToBrushConverter x:Key="HexToBrushConverter" />
            <conv:NormToCanvasConverter x:Key="NormToCanvasConverter" />
            <conv:SignedNormToCanvasConverter x:Key="SignedNormToCanvasConverter" />
            <conv:PercentToSizeConverter x:Key="PercentToSizeConverter" />
            <conv:CrossGeometryConverter x:Key="CrossGeometryConverter" />
            <conv:SlopedWedgeGeometryConverter x:Key="SlopedWedgeGeometryConverter" />
            <conv:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />
            <conv:NormToTriggerHeightConverter x:Key="NormToTriggerHeightConverter" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
            <conv:EnumIndexConverter x:Key="EnumIndexConverter" />
            <conv:EnumEqualityVisibilityConverter x:Key="EnumEqualityVisibilityConverter" />
            <conv:BoolToTriggerShapeKindConverter x:Key="BoolToTriggerShapeKindConverter" />
            <conv:RgbToBrushConverter x:Key="RgbToBrushConverter" />
            <conv:IndexToLetterConverter x:Key="IndexToLetterConverter" />
            <conv:IndexLessThanVisibilityConverter x:Key="IndexLessThanVisibilityConverter" />
            <conv:OneBasedIndexConverter x:Key="OneBasedIndexConverter" />

        </ResourceDictionary>
    </Application.Resources>

</Application>
