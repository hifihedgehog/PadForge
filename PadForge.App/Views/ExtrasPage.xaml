                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding Dashboard_DsuDescription, Source={x:Static strings:Strings.Instance}}"
                           Style="{StaticResource CardDescription}" Margin="0,0,0,12"/>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <!-- Serving = flame (#175 item 76); the green dot stays
                                 strictly health. Binds the server's running truth,
                                 not the enable checkbox (#175 phase 2 item 2). -->
                            <Path FlowDirection="LeftToRight" Data="{StaticResource FlameOuterGeometry}"
                                  Width="11" Height="11" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="0,0,6,0">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="Transparent"/>
                                        <Setter Property="Stroke" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <Setter Property="StrokeThickness" Value="1.1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDsuServerRunning}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                                <Setter Property="Stroke" Value="{x:Null}"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#FF6B2C" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock common:LiveText.Polite="True" Text="{Binding DsuServerStatus}" FontSize="12"
                                       FontFamily="{StaticResource TelemetryFontFamily}"
                                       Foreground="{DynamicResource ColdBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Dashboard_DsuFooter, Source={x:Static strings:Strings.Instance}}"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0"/>
                        <controls:MoreRow x:Name="MotionServerMore" StateKey="Extras.MotionServer.More"
                                          AutomationProperties.AutomationId="Extras_More_MotionServer"
                                          Header="{Binding Common_More, Source={x:Static strings:Strings.Instance}}"
                                          Hint="{Binding Dashboard_Port, Source={x:Static strings:Strings.Instance}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Dashboard_Port, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,8,0"/>
                                    <ui:NumberBox Value="{Binding DsuMotionServerPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=1000}"
                                                  Minimum="1024" Maximum="65535"
                                                  SpinButtonPlacementMode="Inline" Width="200"/>
                                    <reset:SettingResetButton Command="{Binding ResetDsuPortCommand}" SettingLabel="{Binding Dashboard_MotionServerPort, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </controls:MoreRow>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ═══ Game Mods (#529) ═══
                 The UDP server DSX game mods send to. EA86 is Segoe MDL2 Puzzle, a
                 piece added to a game. First: whether it is listening, in a status
                 line that wraps, since it names the program sending. Under More:
                 the port and the DSX.exe stand-in switch. -->
            <StackPanel x:Name="GameModsPage" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Style="{StaticResource ExtrasCrumb}" Click="Back_Click"
                            AutomationProperties.AutomationId="Extras_Back_GameMods"
                            Content="{Binding Extras_Title, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock Text="/" VerticalAlignment="Center" Margin="8,0,8,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="{Binding Dashboard_GameMods, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <reset:GlyphText Text="&#xEA86;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="GameModsTitle" AutomationProperties.HeadingLevel="Level1" Text="{Binding Dashboard_GameMods, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource TitleTextBlockStyle}" FontFamily="{StaticResource DisplayFontFamily}" FontWeight="650" FontSize="26" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Style="{StaticResource SwitchCheckBox}" controls:SwitchLook.ShowState="True"
                                  VerticalAlignment="Center" Content="{Binding Dashboard_EnableGameMods, Source={x:Static strings:Strings.Instance}}"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  IsChecked="{Binding EnableGameModServer}"/>
                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="EnableGameModServer" SettingLabel="{Binding Dashboard_EnableGameMods, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DashboardViewModel_EnableGameModServer_2230"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding Dashboard_GameModsDescription, Source={x:Static strings:Strings.Instance}}"
                           Style="{StaticResource CardDescription}" Margin="0,0,0,12"/>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <!-- Serving = flame, as on the Motion Server card: the
                                 server's running truth, not the switch. -->
                            <Path DockPanel.Dock="Left" FlowDirection="LeftToRight" Data="{StaticResource FlameOuterGeometry}"
                                  Width="11" Height="11" Stretch="Uniform"
                                  VerticalAlignment="Top" Margin="0,3,6,0">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="Transparent"/>
                                        <Setter Property="Stroke" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <Setter Property="StrokeThickness" Value="1.1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGameModServerRunning}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                                <Setter Property="Stroke" Value="{x:Null}"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#FF6B2C" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock common:LiveText.Polite="True" Text="{Binding GameModServerStatus}" FontSize="12"
                                       FontFamily="{StaticResource TelemetryFontFamily}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ColdBrush}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Dashboard_GameModsFooter, Source={x:Static strings:Strings.Instance}}" TextWrapping="Wrap"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0"/>
                        <controls:MoreRow x:Name="GameModsMore" StateKey="Extras.GameMods.More"
                                          AutomationProperties.AutomationId="Extras_More_GameMods"
                                          Header="{Binding Common_More, Source={x:Static strings:Strings.Instance}}"
                                          Hint="{Binding Extras_More_GameMods, Source={x:Static strings:Strings.Instance}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Dashboard_Port, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,8,0"/>
                                    <ui:NumberBox Value="{Binding GameModServerPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=1000}"
                                                  Minimum="1024" Maximum="65535"
                                                  SpinButtonPlacementMode="Inline" Width="200"/>
                                    <reset:SettingResetButton Command="{Binding ResetGameModPortCommand}" SettingLabel="{Binding Dashboard_GameModPort, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox VerticalAlignment="Center" Content="{Binding Dashboard_GameModStandIn, Source={x:Static strings:Strings.Instance}}"
                                              ToolTip="{Binding Dashboard_GameModStandIn_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              IsChecked="{Binding GameModDsxStandIn}"/>
                                    <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="GameModDsxStandIn" SettingLabel="{Binding Dashboard_GameModStandIn, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DashboardViewModel_GameModDsxStandIn_2246"/>
                                </StackPanel>
                            </StackPanel>
                        </controls:MoreRow>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ═══ Overlays (menu #9 B-17, shift layer, profile switch) ═══
                 E700 is Segoe MDL2 GlobalNavButton, the canonical menu glyph. The
                 three overlays have a switch each and no single one, so the
                 page's switch is on while any of them is
                 (DashboardViewModel.OverlaysAnyEnabled). -->
            <StackPanel x:Name="OverlaysPage" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Style="{StaticResource ExtrasCrumb}" Click="Back_Click"
                            AutomationProperties.AutomationId="Extras_Back_Overlays"
                            Content="{Binding Extras_Title, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock Text="/" VerticalAlignment="Center" Margin="8,0,8,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="{Binding Dashboard_Overlays, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <reset:GlyphText Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="OverlaysTitle" AutomationProperties.HeadingLevel="Level1" Text="{Binding Dashboard_Overlays, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource TitleTextBlockStyle}" FontFamily="{StaticResource DisplayFontFamily}" FontWeight="650" FontSize="26" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Style="{StaticResource SwitchCheckBox}" controls:SwitchLook.ShowState="True"
                                  VerticalAlignment="Center" AutomationProperties.AutomationId="OverlaysSwitch"
                                  Content="{Binding Dashboard_Overlays, Source={x:Static strings:Strings.Instance}}"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  IsChecked="{Binding OverlaysAnyEnabled}"/>
                        <reset:SettingResetButton Command="{Binding ResetOverlaysCommand}" SettingLabel="{Binding Dashboard_Overlays, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DashboardViewModel_OverlaysAnyEnabled" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding Dashboard_OverlaysDescription, Source={x:Static strings:Strings.Instance}}"
                           Style="{StaticResource CardDescription}" Margin="0,0,0,12"/>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <CheckBox VerticalAlignment="Center" Content="{Binding Dashboard_MenuOverlay, Source={x:Static strings:Strings.Instance}}"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      ToolTip="{Binding Dashboard_MenuOverlayDescription, Source={x:Static strings:Strings.Instance}}"
                                      IsChecked="{Binding EnableMenuOverlay}"/>
                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="EnableMenuOverlay" SettingLabel="{Binding Dashboard_MenuOverlay, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DashboardViewModel_EnableMenuOverlay_2023"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <CheckBox VerticalAlignment="Center" Content="{Binding Dashboard_ShiftLayerFlyout, Source={x:Static strings:Strings.Instance}}"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      IsChecked="{Binding EnableShiftLayerFlyout}"/>
                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="EnableShiftLayerFlyout" SettingLabel="{Binding Dashboard_ShiftLayerFlyout, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DashboardViewModel_EnableShiftLayerFlyout_2026"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox VerticalAlignment="Center" Content="{Binding Dashboard_ProfileOverlay, Source={x:Static strings:Strings.Instance}}"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      IsChecked="{Binding EnableProfileOverlay}"/>
                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="EnableProfileOverlay" SettingLabel="{Binding Dashboard_ProfileOverlay, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DashboardViewModel_EnableProfileOverlay_2029"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ═══ Touchpad Overlay ═══
                 Whether the overlay is showing, its opacity and its place. -->
            <StackPanel x:Name="TouchpadOverlayPage" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Style="{StaticResource ExtrasCrumb}" Click="Back_Click"
                            AutomationProperties.AutomationId="Extras_Back_TouchpadOverlay"
                            Content="{Binding Extras_Title, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock Text="/" VerticalAlignment="Center" Margin="8,0,8,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="{Binding Dashboard_TouchpadOverlay, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <reset:GlyphText Text="&#xEDA4;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="TouchpadOverlayTitle" AutomationProperties.HeadingLevel="Level1" Text="{Binding Dashboard_TouchpadOverlay, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource TitleTextBlockStyle}" FontFamily="{StaticResource DisplayFontFamily}" FontWeight="650" FontSize="26" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Style="{StaticResource SwitchCheckBox}" controls:SwitchLook.ShowState="True"
                                  VerticalAlignment="Center" Content="{Binding Dashboard_EnableTouchpadOverlay, Source={x:Static strings:Strings.Instance}}"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  IsChecked="{Binding EnableTouchpadOverlay}"/>
                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="EnableTouchpadOverlay" SettingLabel="{Binding Dashboard_EnableTouchpadOverlay, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DashboardViewModel_EnableTouchpadOverlay_2045"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding Dashboard_TouchpadOverlayDescription, Source={x:Static strings:Strings.Instance}}"
                           Style="{StaticResource CardDescription}" Margin="0,0,0,12"/>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <!-- Serving = flame (#175 item 76). Binds the overlay
                                 window's running truth, which already drives the
                                 status text (#175 phase 2 item 2). -->
                            <Path FlowDirection="LeftToRight" Data="{StaticResource FlameOuterGeometry}"
                                  Width="11" Height="11" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="0,0,6,0">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="Transparent"/>
                                        <Setter Property="Stroke" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <Setter Property="StrokeThickness" Value="1.1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTouchpadOverlayRunning}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                                <Setter Property="Stroke" Value="{x:Null}"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#FF6B2C" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock common:LiveText.Polite="True" Text="{Binding TouchpadOverlayStatus}" FontSize="12"
                                       FontFamily="{StaticResource TelemetryFontFamily}"
                                       Foreground="{DynamicResource ColdBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding Dashboard_TouchpadOverlayOpacity, Source={x:Static strings:Strings.Instance}}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" Width="80"/>
                            <Slider Value="{Binding TouchpadOverlayOpacity, Mode=TwoWay}"
                                    Minimum="0.0" Maximum="1.0"
                                    SmallChange="0.05" LargeChange="0.1"
                                    Width="160" VerticalAlignment="Center">
                                <!-- Hover glow (#175): the thumb flips ember-hot on hover
                                     (SliderThumbBackgroundPointerOver), so the bloom is
                                     ember. BasedOn the implicit style so the themed
                                     template survives. -->
                                <Slider.Style>
                                    <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                                    </Style>
                                </Slider.Style>
                            </Slider>
                            <!-- 200 like the port boxes: the focus-time clear X plus
                                 the inline spin buttons cramped the value at 130
                                 (same fix as the Menus tab's number boxes). -->
                            <ui:NumberBox Value="{Binding TouchpadOverlayOpacityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Minimum="0" Maximum="100"
                                          SpinButtonPlacementMode="Inline" Width="200"
                                          Margin="8,0,0,0"/>
                            <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <reset:SettingResetButton Command="{Binding ResetOpacityCommand}" SettingLabel="{Binding Dashboard_TouchpadOverlayOpacity, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Command="{Binding ResetTouchpadOverlayPositionCommand}"
                                    Content="{Binding Dashboard_TouchpadOverlayResetPosition, Source={x:Static strings:Strings.Instance}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ═══ Screen Overlay (#560) ═══
                 One group per overlay in one card, so they share one label column.
                 One overlay has no title of its own and reads like the Touchpad
                 Overlay's card. Each overlay has its own switch, so the page has
                 none. The catalog tile's switch is on while any overlay is
                 (DashboardViewModel.ScreenOverlaysAnyEnabled). -->
            <StackPanel x:Name="ScreenOverlayPage" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Style="{StaticResource ExtrasCrumb}" Click="Back_Click"
                            AutomationProperties.AutomationId="Extras_Back_ScreenOverlay"
                            Content="{Binding Extras_Title, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock Text="/" VerticalAlignment="Center" Margin="8,0,8,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="{Binding Dashboard_ScreenOverlay, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <reset:GlyphText Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="ScreenOverlayTitle" AutomationProperties.HeadingLevel="Level1" Text="{Binding Dashboard_ScreenOverlay, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource TitleTextBlockStyle}" FontFamily="{StaticResource DisplayFontFamily}" FontWeight="650" FontSize="26" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding Dashboard_ScreenOverlayDescription, Source={x:Static strings:Strings.Instance}}"
                           Style="{StaticResource CardDescription}" Margin="0,0,0,12"/>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,0">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding ScreenOverlays}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,8"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Visibility="{Binding OneOfSeveral, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <CheckBox VerticalAlignment="Center" Content="{Binding Dashboard_EnableScreenOverlay, Source={x:Static strings:Strings.Instance}}"
                                                      AutomationProperties.AutomationId="{Binding EnableId}"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                      IsChecked="{Binding Enabled}"/>
                                            <reset:SettingResetButton Command="{Binding ResetEnabledCommand}" SettingLabel="{Binding Dashboard_EnableScreenOverlay, Source={x:Static strings:Strings.Instance}}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Dashboard_TouchpadOverlayOpacity, Source={x:Static strings:Strings.Instance}}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" Width="80"/>
                                            <Slider Value="{Binding Opacity, Mode=TwoWay}"
                                                    AutomationProperties.AutomationId="{Binding OpacityId}"
                                                    Minimum="0.0" Maximum="1.0"
                                                    SmallChange="0.05" LargeChange="0.1"
                                                    Width="160" VerticalAlignment="Center">
                                                <Slider.Style>
                                                    <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                                                    </Style>
                                                </Slider.Style>
                                            </Slider>
                                            <ui:NumberBox Value="{Binding OpacityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Minimum="0" Maximum="100"
                                                          SpinButtonPlacementMode="Inline" Width="200"
                                                          Margin="8,0,0,0"/>
                                            <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <reset:SettingResetButton Command="{Binding ResetOpacityCommand}" SettingLabel="{Binding Dashboard_TouchpadOverlayOpacity, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Button Command="{Binding ChooseCommand}"
                                                    AutomationProperties.AutomationId="{Binding ChooseId}"
                                                    Margin="0,0,8,0"
                                                    Content="{Binding Dashboard_ScreenOverlayChoose, Source={x:Static strings:Strings.Instance}}"/>
                                            <Button Command="{Binding ResetPositionCommand}"
                                                    AutomationProperties.AutomationId="{Binding ResetPositionId}"
                                                    Margin="0,0,8,0"
                                                    Content="{Binding Dashboard_TouchpadOverlayResetPosition, Source={x:Static strings:Strings.Instance}}"/>
                                            <Button Command="{Binding RemoveCommand}"
                                                    AutomationProperties.AutomationId="{Binding RemoveId}"
                                                    Visibility="{Binding OneOfSeveral, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Content="{Binding Common_Remove, Source={x:Static strings:Strings.Instance}}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path FlowDirection="LeftToRight" Data="{StaticResource FlameOuterGeometry}"
                                                  Width="11" Height="11" Stretch="Uniform"
                                                  VerticalAlignment="Center" Margin="0,0,6,0">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="Transparent"/>
                                                        <Setter Property="Stroke" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                        <Setter Property="StrokeThickness" Value="1.1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                                                <Setter Property="Stroke" Value="{x:Null}"/>
                                                                <Setter Property="Effect">
                                                                    <Setter.Value>
                                                                        <DropShadowEffect Color="#FF6B2C" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock common:LiveText.Polite="True" Text="{Binding Status}" FontSize="12"
                                                       FontFamily="{StaticResource TelemetryFontFamily}"
                                                       Foreground="{DynamicResource ColdBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Command="{Binding AddScreenOverlayCommand}" HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="ScreenOverlay_Add"
                                IsEnabled="{Binding CanAddScreenOverlay}"
                                Content="{Binding Dashboard_ScreenOverlayAdd, Source={x:Static strings:Strings.Instance}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
