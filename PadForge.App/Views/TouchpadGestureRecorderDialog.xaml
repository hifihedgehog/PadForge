<views:DialogWindow AutomationProperties.IsDialog="True" x:Class="PadForge.Views.TouchpadGestureRecorderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        xmlns:common="clr-namespace:PadForge.Common"
        xmlns:controls="clr-namespace:PadForge.Controls"
        xmlns:reset="clr-namespace:PadForge.Controls"
        xmlns:views="clr-namespace:PadForge.Views"
        Title="{Binding Recorder_Title, Source={x:Static strings:Strings.Instance}}"
        Subtitle="{Binding Recorder_Subtitle, Source={x:Static strings:Strings.Instance}}">

    <!-- Record a Gesture (#574), as the Links board draws it: the stroke
         as it is drawn, then the gesture's name. With a touchpad to record
         from, the surface mirrors the fingers on it. With none, the
         surface itself is drawn on with the mouse, a pen or a finger.
         Clear leads the foot and starts the samples over. How many
         samples to take is under More. -->
    <views:DialogWindow.Foot>
        <controls:FlexLinePanel Style="{StaticResource DialogFootPanel}">
            <Button x:Name="TryAgainBtn" Style="{StaticResource DialogQuietButton}"
                    Content="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}"
                    Click="TryAgainBtn_Click"/>
            <Button Style="{StaticResource DialogButton}" IsCancel="True"
                    Content="{Binding Common_Cancel, Source={x:Static strings:Strings.Instance}}"/>
            <Button x:Name="SaveBtn" Style="{StaticResource DialogPrimaryButton}" IsEnabled="False"
                    Content="{Binding Common_Save, Source={x:Static strings:Strings.Instance}}"
                    Click="SaveBtn_Click"/>
        </controls:FlexLinePanel>
    </views:DialogWindow.Foot>

    <StackPanel common:InitialFocus.First="True">
        <!-- The drawing surface. The line in its corner says where the
             strokes come from, and takes no clicks. -->
        <Border CornerRadius="8" Height="220" BorderThickness="1"
                Background="{DynamicResource SteelFieldBrush}"
                BorderBrush="{DynamicResource SteelLineSoftBrush}">
            <Grid>
                <Canvas FlowDirection="LeftToRight" x:Name="DrawingCanvas"
                        Background="Transparent"
                        IsManipulationEnabled="True"
                        ClipToBounds="True"
                        TouchDown="DrawingCanvas_TouchDown"
                        TouchMove="DrawingCanvas_TouchMove"
                        TouchUp="DrawingCanvas_TouchUp"
                        MouseDown="DrawingCanvas_MouseDown"
                        MouseMove="DrawingCanvas_MouseMove"
                        MouseUp="DrawingCanvas_MouseUp"
                        StylusDown="DrawingCanvas_StylusDown"/>
                <TextBlock x:Name="DeviceLabel" Margin="10" FontSize="12" IsHitTestVisible="False"
                           HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </Grid>
        </Border>

        <!-- What to do next, and how many samples are taken. -->
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                       common:LiveText.Polite="True"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding Recorder_Waiting, Source={x:Static strings:Strings.Instance}}"/>
            <TextBlock x:Name="SamplesText" Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource DialogMonoNote}"/>
        </Grid>

        <controls:SettingRow MinHeight="44" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource DialogLabelNarrow}"
                       Text="{Binding Recorder_NameLabel, Source={x:Static strings:Strings.Instance}}"/>
            <ui:TextBox x:Name="NameBox" Style="{StaticResource DialogTextBox}" controls:SettingRow.Fills="True"
                        PlaceholderText="{Binding Recorder_NamePlaceholder, Source={x:Static strings:Strings.Instance}}"
                        AutomationProperties.Name="{Binding Recorder_NameLabel, Source={x:Static strings:Strings.Instance}}"
                        TextChanged="NameBox_TextChanged"/>
        </controls:SettingRow>
        <!-- Why the gesture cannot be saved yet. It takes no room while it
             says nothing. -->
        <TextBlock x:Name="ValidationText" common:LiveText.Polite="True" Margin="70,2,0,0" FontSize="13" TextWrapping="Wrap"
                   Foreground="{DynamicResource WaitBrush}" Visibility="Collapsed"/>

        <controls:MoreRow x:Name="GestureMore" Style="{StaticResource DialogMoreRow}"
                          Header="{Binding Common_More, Source={x:Static strings:Strings.Instance}}"
                          Hint="{Binding Recorder_MoreHint, Source={x:Static strings:Strings.Instance}}">
            <StackPanel>
                <controls:SettingRow MinHeight="44">
                    <TextBlock Style="{StaticResource DialogLabel}"
                               Text="{Binding Recorder_SampleCount_Label, Source={x:Static strings:Strings.Instance}}"/>
                    <ComboBox x:Name="SampleCountBox" Style="{StaticResource DialogSelect}" MinWidth="72" SelectedIndex="1"
                              SelectionChanged="SampleCountBox_SelectionChanged"
                              AutomationProperties.Name="{Binding Recorder_SampleCount_Label, Source={x:Static strings:Strings.Instance}}">
                        <ComboBoxItem Content="1"/>
                        <ComboBoxItem Content="3"/>
                        <ComboBoxItem Content="5"/>
                    </ComboBox>
                    <reset:SettingResetButton Click="ResetSampleCount_Click" Tag="" Visibility="{Binding Visibility, ElementName=SampleCountBox}" IsEnabled="{Binding IsEnabled, ElementName=SampleCountBox}" SettingLabel="{Binding Recorder_SampleCount_Label, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_?dialog_SampleCountBox_132"/>
                </controls:SettingRow>
                <TextBlock Style="{StaticResource DialogNote}"
                           Text="{Binding Recorder_SampleCount_Hint, Source={x:Static strings:Strings.Instance}}"/>
            </StackPanel>
        </controls:MoreRow>
    </StackPanel>
</views:DialogWindow>
