<views:DialogWindow AutomationProperties.IsDialog="True" x:Class="PadForge.Views.GetProfilesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        xmlns:controls="clr-namespace:PadForge.Controls"
        xmlns:views="clr-namespace:PadForge.Views"
        xmlns:common="clr-namespace:PadForge.Common"
        IsWide="True" ShowClose="True" ScrollsBody="False" SizeToContent="Manual" ResizeMode="CanResize"
        Width="680" Height="568" MinWidth="560" MinHeight="480"
        Title="{Binding GetProfiles_Title, Source={x:Static strings:Strings.Instance}}"
        Subtitle="{Binding GetProfiles_Intro, Source={x:Static strings:Strings.Instance}}">

    <!-- Get Profiles (#574): a starter profile, a community config or a file
         from another tool, in one window of three tabs. The window takes
         each tab's board size: the Dialogs board's on Starters and Import a
         File, the large board's on Community. -->

    <views:DialogWindow.Resources>
        <!-- A starter is read by its name: with a template of its own it
             would be read as its type. -->
        <Style x:Key="StarterItem" TargetType="ListBoxItem" BasedOn="{StaticResource DialogOptionItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name, TargetNullValue=''}"/>
        </Style>
    </views:DialogWindow.Resources>

    <views:DialogWindow.Foot>
        <controls:FlexLinePanel Style="{StaticResource DialogFootPanel}">
            <TextBlock Style="{StaticResource DialogFootNote}"
                       Text="{Binding GetProfiles_SaveHint, Source={x:Static strings:Strings.Instance}}"/>
            <Button x:Name="CancelButton" Style="{StaticResource DialogButton}" IsCancel="True" Click="Close_Click"
                    AutomationProperties.AutomationId="GetProfiles_Cancel"
                    Content="{Binding Common_Cancel, Source={x:Static strings:Strings.Instance}}"/>
            <!-- Community only: saves the config and loads it at once. -->
            <Button x:Name="SaveApplyButton" Style="{StaticResource DialogButton}" Click="SaveApply_Click" Visibility="Collapsed"
                    AutomationProperties.AutomationId="GetProfiles_SaveApply"
                    Content="{Binding Workshop_SaveAndApply, Source={x:Static strings:Strings.Instance}}"/>
            <!-- Starters and Community. -->
            <Button x:Name="SaveButton" Style="{StaticResource DialogPrimaryButton}" Click="Save_Click"
                    AutomationProperties.AutomationId="GetProfiles_Save"
                    Content="{Binding Workshop_SaveProfile, Source={x:Static strings:Strings.Instance}}"/>
            <!-- Import a File only: the Open dialog. -->
            <Button x:Name="ImportButton" Style="{StaticResource DialogPrimaryButton}" Click="Import_Click" Visibility="Collapsed"
                    AutomationProperties.AutomationId="GetProfiles_Import"
                    Content="{Binding Profiles_Import, Source={x:Static strings:Strings.Instance}}"/>
        </controls:FlexLinePanel>
    </views:DialogWindow.Foot>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- The three tabs, and on Community the search box beside them. -->
        <controls:FlexLinePanel Margin="24,16,24,0" Gap="16" LineGap="12">
            <Border Style="{StaticResource SegmentTrack}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="StartersTab" Style="{StaticResource DialogSegmentRadio}" GroupName="GetProfilesTab"
                                 Tag="Starters" Checked="Tab_Checked" AutomationProperties.AutomationId="GetProfiles_Starters"
                                 Content="{Binding GetProfiles_Starters, Source={x:Static strings:Strings.Instance}}"/>
                    <RadioButton x:Name="CommunityTab" Style="{StaticResource DialogSegmentRadio}" GroupName="GetProfilesTab"
                                 Tag="Community" Checked="Tab_Checked" AutomationProperties.AutomationId="GetProfiles_Community"
                                 Content="{Binding GetProfiles_Community, Source={x:Static strings:Strings.Instance}}"/>
                    <RadioButton x:Name="FileTab" Style="{StaticResource DialogSegmentRadio}" GroupName="GetProfilesTab"
                                 Tag="File" Checked="Tab_Checked" AutomationProperties.AutomationId="GetProfiles_File"
                                 Content="{Binding GetProfiles_File, Source={x:Static strings:Strings.Instance}}"/>
                </StackPanel>
            </Border>
            <Border x:Name="SearchField" controls:FlexLinePanel.Basis="260" controls:FlexLinePanel.Grow="1"
                    Height="36" CornerRadius="6" BorderThickness="1" Padding="10,0" Visibility="Collapsed"
                    BorderBrush="{DynamicResource SteelLineBrush}" Background="{DynamicResource SteelFieldBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <controls:DecorativeStrokeIcon Data="{StaticResource SearchLineGeometry}" Size="14" StrokeWidth="2"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Padding="0" FontSize="14"
                                 VerticalAlignment="Center" CaretBrush="{DynamicResource EmberBrush}"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 AutomationProperties.Name="{Binding Workshop_SearchPlaceholder, Source={x:Static strings:Strings.Instance}}"
                                 TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
                        <TextBlock x:Name="SearchPlaceholder" IsHitTestVisible="False" FontSize="14" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{Binding Workshop_SearchPlaceholder, Source={x:Static strings:Strings.Instance}}"/>
                    </Grid>
                </Grid>
            </Border>
        </controls:FlexLinePanel>

        <!-- Starters: the profiles that ship with PadForge, one per kind of
             game. A double click or Enter saves the picked one. -->
        <Grid x:Name="StartersBody" Grid.Row="1" Margin="12">
            <ListBox x:Name="StarterList" Background="Transparent" BorderThickness="0" Padding="0"
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource StarterItem}"
                     AutomationProperties.Name="{Binding GetProfiles_Starters, Source={x:Static strings:Strings.Instance}}"
                     MouseDoubleClick="StarterList_MouseDoubleClick" KeyDown="StarterList_KeyDown"
                     SelectionChanged="StarterList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <Border Style="{StaticResource DialogTag}" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding OutputLabel}" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Description}" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Community: the Steam Workshop's configs, as the large board draws them. -->
        <views:CommunityConfigsPanel x:Name="CommunityPanel" Grid.Row="1" Margin="24,16,24,16" Visibility="Collapsed"/>

        <!-- Import a File: the page's drop tile, filling the body. A click or
             Enter on it opens the Open dialog, as Import... does. -->
        <Grid x:Name="FileBody" Grid.Row="1" Margin="24,16,24,16" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <controls:ClickBorder x:Name="FileDropZone" CornerRadius="10" Cursor="Hand" AllowDrop="True" Click="FileDropZone_Click"
                                  DragEnter="FileDropZone_DragOver" DragOver="FileDropZone_DragOver" Drop="FileDropZone_Drop"
                                  AutomationProperties.AutomationId="GetProfiles_FileDrop"
                                  AutomationProperties.Name="{Binding Profiles_DropTile, Source={x:Static strings:Strings.Instance}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SteelCardHoverBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Rectangle RadiusX="10" RadiusY="10" Stroke="{DynamicResource DashLineBrush}"
                               StrokeThickness="1" StrokeDashArray="4 3" SnapsToDevicePixels="True"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                        <controls:DecorativeStrokeIcon Data="{StaticResource DownloadLineGeometry}" Size="22" StrokeWidth="1.7"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Profiles_DropTile, Source={x:Static strings:Strings.Instance}}"
                                   FontSize="14" Margin="0,8,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding Profiles_DropTileFormats, Source={x:Static strings:Strings.Instance}}"
                                   FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Grid>
            </controls:ClickBorder>
            <!-- Why a file was refused, in wait gold. -->
            <TextBlock x:Name="FileProblemText" Grid.Row="1" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap"
                       common:LiveText.Polite="True"
                       Foreground="{DynamicResource WaitBrush}" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</views:DialogWindow>
