                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PointerMode}" Value="FpsMouse">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:SettingRow.Style>
                                    <TextBlock Text="{Binding Pad_Pointer_FpsSpeed, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzSubLabel}"
                                               ToolTip="{Binding Pad_Pointer_FpsSpeed_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding PointerFpsSpeed, Mode=TwoWay}"
                                            Minimum="5" Maximum="100" MinWidth="60" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PointerFpsSpeed}" Style="{StaticResource DzValueText}"/>
                                    <ui:Button Command="{Binding ResetPointerFpsSpeedCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetPointerFpsSpeed, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <TextBlock Text="{Binding Pad_Pointer_ModeNote, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Pad_Pointer_TuningTitle, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding ResetPointerTuningCardCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetPointerTuning, Source={x:Static strings:Strings.Instance}}"/>
                                </DockPanel>

                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Pad_Pointer_SensorBar, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ComboBox MaxWidth="240" controls:SettingRow.Fills="True"
                                              SelectedIndex="{Binding IrSensorBarPos, Mode=TwoWay}"
                                              AutomationProperties.Name="{Binding Pad_Pointer_SensorBar, Source={x:Static strings:Strings.Instance}}">
                                        <ComboBoxItem Content="{Binding Pad_Pointer_SensorBar_Centered, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Pointer_SensorBar_Above, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Pointer_SensorBar_Below, Source={x:Static strings:Strings.Instance}}"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding ResetIrSensorBarPosCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetSensorBarPos, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Pad_Pointer_Compensation, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding IrSensorBarCompPercent, Mode=TwoWay}"
                                            AutomationProperties.Name="{Binding Pad_Pointer_Compensation, Source={x:Static strings:Strings.Instance}}"
                                            Minimum="0" Maximum="50" MinWidth="60" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding IrSensorBarCompPercent, StringFormat={}{0}%}" Style="{StaticResource DzValueText}"/>
                                    <ui:Button Command="{Binding ResetIrSensorBarCompCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetSensorBarComp, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Pad_Pointer_Smoothing, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding IrSmoothingPercent, Mode=TwoWay}"
                                            AutomationProperties.Name="{Binding Pad_Pointer_Smoothing, Source={x:Static strings:Strings.Instance}}"
                                            Minimum="0" Maximum="100" MinWidth="60" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding IrSmoothingPercent, StringFormat={}{0}%}" Style="{StaticResource DzValueText}"/>
                                    <ui:Button Command="{Binding ResetIrSmoothingCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetIrSmoothing, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </GroupBox>
                    </controls:TileGridPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ SECTION 4: Lights & Sound ═══
                 Lighting and audio. -->
            <TabItem>
                <ScrollViewer x:Name="LightsSectionScroll" AutomationProperties.Name="{Binding Pad_Section_Lights, Source={x:Static strings:Strings.Instance}}" Padding="32,0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <!-- This section's rows, as its board draws them (#574): a label
                             column 170 wide, a slider that takes the room its row has
                             (each row here grows it), and the value with its unit at the
                             right of a column 66 wide (each row here sets that), so the
                             sliders of a card end at one line. Cards stand 12 apart.
                             These shadow the page's styles for everything in this
                             section. -->
                        <Style x:Key="DzLabel" TargetType="TextBlock">
                            <Setter Property="Width" Value="170"/>
                            <Setter Property="Margin" Value="0,0,12,0"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </Style>
                        <Style x:Key="DzSubLabel" TargetType="TextBlock" BasedOn="{StaticResource DzLabel}">
                            <Setter Property="Width" Value="154"/>
                            <Setter Property="Margin" Value="16,0,12,0"/>
                            <Setter Property="Foreground" Value="{DynamicResource SubRowTextBrush}"/>
                        </Style>
                        <Style x:Key="DzSlider" TargetType="Slider" BasedOn="{StaticResource EmberSlider}">
                            <Setter Property="Minimum" Value="0"/>
                            <Setter Property="Maximum" Value="100"/>
                            <Setter Property="MinWidth" Value="60"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="IsSnapToTickEnabled" Value="True"/>
                            <Setter Property="TickFrequency" Value="0.1"/>
                        </Style>
                        <Style x:Key="CardBorder" TargetType="Border" BasedOn="{StaticResource CardBorder}">
                            <Setter Property="Margin" Value="0,0,0,12"/>
                        </Style>
                    </ScrollViewer.Resources>
                    <!-- The groups side by side while each has 420 to itself,
                         one under the other when the window is narrower, as
                         the board wraps them. The groups of a row share the
                         whole width. -->
                    <controls:TileGridPanel MinItemWidth="420" Gap="16" RowGap="24" FillRows="True" Margin="0,24,0,24">

            <!-- The groups below were tabs of the page and keep that
                 indentation. -->
            <!-- ══════════════════════════════════════
                 TAB 7: LIGHTING
                 (visible for DS4 / DualSense / DualSense Edge slots)
                 ══════════════════════════════════════ -->
                    <GroupBox x:Name="TabLighting" Visibility="Collapsed" Style="{StaticResource BareGroupBox}"
                              AutomationProperties.Name="{Binding Pad_Lighting_Header, Source={x:Static strings:Strings.Instance}}">
                    <StackPanel>
                        <!-- The group's label. Its tooltip holds what the group's
                             paragraphs said: the lightbar's two for a pad with a
                             lightbar (the second is the player-identity idle floor,
                             #191: an untouched pad showing a player color reads as
                             designed behavior), and the peripheral's for a mouse, a
                             keyboard or a vendor lighting row (#494). SyncTabVisibility
                             shows the ones that apply, and turns the tooltip off for a
                             device that has neither, where it would open empty. -->
                        <TextBlock x:Name="LightingGroupLabel" AutomationProperties.AutomationId="TabLighting" Text="{Binding Pad_Lighting_Header, Source={x:Static strings:Strings.Instance}}"
                                   Style="{StaticResource SectionTitle}" Margin="0,0,0,12" HorizontalAlignment="Left">
                            <TextBlock.ToolTip>
                                <ToolTip>
                                    <StackPanel MaxWidth="420">
                                        <TextBlock x:Name="LightingLightbarSubtitle" TextWrapping="Wrap"
                                                   Text="{Binding Pad_Lighting_Subtitle, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBlock x:Name="LightingPlayerIdleHint" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Text="{Binding Pad_Lighting_PlayerIdle_Hint, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBlock x:Name="PeripheralLightingSubtitle" TextWrapping="Wrap" Visibility="Collapsed"
                                                   Text="{Binding Pad_Lighting_PeripheralSubtitle, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                </ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <!-- A DSX game mod setting these lights (#529). -->
                        <TextBlock Text="{Binding GameModLightsLine}" Visibility="{Binding GameModLightsLine, Converter={StaticResource StringToVisibility}}"
                                   Foreground="{DynamicResource EmberBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- A mouse, keyboard or vendor lighting row (#494): this
                             slot's lighting reaches it through the cards below, the
                             way it reaches a DualSense. The route line names the path
                             and who rules a shared one, the Force Feedback group's
                             ember line. Shown and filled by SyncTabVisibility. -->
                        <StackPanel x:Name="PeripheralLightingPanel" Visibility="Collapsed">
                            <TextBlock x:Name="PeripheralLightingRoute" Visibility="Collapsed"
                                       Foreground="{DynamicResource EmberBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        </StackPanel>

                        <!-- Unified lightbar mode picker. Replaces the
                             v3.0 BaseColor + AudioLightbar split. The
                             single-color RGB sub-block is shared by
                             Static / Breathing / AudioPulse. The audio
                             3-color bands are shared by Thresholds /
                             Gradient / CrossFade. Period drives the
                             time-based animations. Palette + Smooth
                             belong to ColorCycle. Decay + Randomize +
                             palette belong to InputReactive.
                             Named so SyncTabVisibility can hide the whole
                             lightbar card when the Lighting tab is shown
                             for a guide-LED-only device (#209). -->
                        <Border x:Name="LightbarModeCard" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Pad_Lighting_BaseColor, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding DeviceConfig.ResetLightbarAllCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetLightbar, Source={x:Static strings:Strings.Instance}}"/>
                                </DockPanel>

                                <!-- Lightbar preview (#175): the project's real 2D
                                     controller art instead of a hand-drawn silhouette.
                                     Base composite, its trigger and stick layers at
                                     rest, and the lightbar strip PNGs are the
                                     Gamepad-Asset-Pack 2DModels assets (MIT, already
                                     credited in the csproj), composed at native base
                                     resolution inside this Viewbox. Strip positions were
                                     measured by alpha-masked template matching against
                                     the pack's own baked composites, so the lit shape is
                                     the art's shape: DualSense/Edge lights the ring
                                     wrapping the touchpad's flanks. A DualShock 4 lights
                                     the front strip plus the rear bar, chosen by
                                     SyncTabVisibility off the same PID gates that
                                     drive tab visibility (BuildLightbarPreview rebuilds
                                     only on family change). The bar previews the live
                                     LightbarRed/Green/Blue trio, the same properties the
                                     SV picker, sliders, hex box, and preset swatches
                                     write, so it tracks every drag. Presentation is
                                     entirely code-behind (SyncLightbarPreview, riding
                                     OnDeviceConfigChanged): animated modes mirror
                                     the physical bar over time via code-driven
                                     BeginAnimation on the lit group, its shared fill
                                     brush, and its DropShadowEffect bloom (the mini-card
                                     heat-ring pattern), gated on
                                     SystemParameters.ClientAreaAnimation. Never animated
                                     from style triggers. Mode = PlayerNumber (the #191
                                     default) previews the Sony player color for this
                                     slot's number under a locale-neutral GAME WRITES WIN
                                     token (DZ / PEAK radar-legend idiom) whose tooltip
                                     carries the localized Pad_Lighting_Subtitle sentence,
                                     since a game's write takes over and persists there.
                                     Mode = Off is the deliberate hard-off: the strips go
                                     dark, no token (PadForge reasserts black after any
                                     game write's grace). No live game-write flag reaches
                                     this view model (ownership is resolved per-packet
                                     inside UserEffectsDispatcher), so both are mode-only
                                     presentations. Palette and audio modes still preview
                                     the base trio because it is the only single-color
                                     truth the config holds. -->
                                <!-- Hidden for a mouse, keyboard or vendor row
                                     (#494): the art is a DualShock 4 or a DualSense. -->
                                <StackPanel x:Name="LightbarPreviewPanel" Margin="0,0,0,12" HorizontalAlignment="Left">
                                    <Viewbox Width="260" HorizontalAlignment="Left">
                                        <!-- The lightbar picture is built in code. Pinned here
                                             so the controller it shows does not mirror (#505). -->
                                        <Grid x:Name="LightbarPreviewHost" FlowDirection="LeftToRight"/>
                                    </Viewbox>
                                    <TextBlock Text="GAME WRITES WIN" HorizontalAlignment="Center" Margin="0,4,0,0"
                                               FontFamily="{StaticResource TelemetryFontFamily}" FontSize="10"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               ToolTip="{Binding Pad_Lighting_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                               Visibility="{Binding DeviceConfig.LightbarMode, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=PlayerNumber}"/>
                                </StackPanel>

                                <!-- Mode picker -->
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Pad_Lighting_Mode, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource DzLabel}"/>
                                    <!-- SelectedValue + Tag binding (rather than SelectedIndex
                                         + EnumIndexConverter): the LightbarMode enum has gaps
                                         (11..13 are legacy InputReactive values not exposed in
                                         this dropdown), so item index ≠ enum value. Tag-driven
                                         binding lets us reorder freely without breaking the
                                         enum mapping. Order is grouped by feel: simple time-
                                         based on a single color (Static/Breathing/Strobe),
                                         multi-color time-based (Rainbow/ColorCycle), battery
                                         indicator, then the audio-reactive cluster. -->
                                    <!-- Combo width standard: this card's two combos (mode
                                         picker + input-reactive overlay below) share 444.
                                         Measured, not guessed (tools/combomeasure): a real
                                         WPF-UI ComboBox with this card's implicit style
                                         (Padding 8,4) and the Body font sizes the widest
                                         option, the Spanish audio crossfade mode name, to
                                         435.33px across all 10 locales. 444 leaves about
                                         9px of slack. The popup sizes to its own option
                                         text. Re-measure if these strings change. -->
                                    <ComboBox SelectedValue="{Binding DeviceConfig.LightbarMode, Mode=TwoWay}"
                                              SelectedValuePath="Tag"
                                              AutomationProperties.AutomationId="LightingModeBox"
                                              MaxWidth="444" controls:SettingRow.Fills="True" VerticalAlignment="Center">
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_PlayerNumber, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.PlayerNumber}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_Off, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.Off}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_Static, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.Static}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_Breathing, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.Breathing}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_Strobe, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.Strobe}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_Rainbow, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.Rainbow}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_ColorCycle, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.ColorCycle}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_Battery, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.Battery}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_ScreenColor, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.ScreenColor}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_AudioPulse, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.AudioPulse}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_AudioPulseRandom, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.AudioPulseRandom}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_AudioPulseRainbow, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.AudioPulseRainbow}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_AudioThresholds, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.AudioThresholds}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_AudioGradient, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.AudioGradient}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_AudioCrossFade, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.AudioCrossFade}"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding DeviceConfig.ResetLightbarModeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetLightbarMode, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <!-- LightbarMode-dependent controls live directly under
                                     the mode dropdown so the user reads "I picked Mode X
                                     → here are X's settings" without the InputReactive
                                     dropdown breaking the visual flow. The InputReactive
                                     dropdown + its dependent Hold/Decay/Fixed-color block
                                     moves to the bottom of the card. Palette stays in
                                     the middle since it's shared between ColorCycle (base
                                     mode) and InputReactive Cycle (overlay). -->

                                <!-- Period: Breathing / Rainbow / ColorCycle / AudioPulseRainbow / Strobe -->
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44"
                                            Visibility="{Binding DeviceConfig.LightbarMode, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=Breathing|Rainbow|ColorCycle|AudioPulseRainbow|Strobe}">
                                    <TextBlock Text="{Binding Pad_Lighting_Period, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding DeviceConfig.LightbarPeriodMs, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"
                                            Minimum="250" Maximum="10000" TickFrequency="250"/>
                                    <TextBox Text="{Binding DeviceConfig.LightbarPeriodMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding DeviceConfig.ResetLightbarPeriodCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetLightbarPeriod, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <!-- Brightness: Rainbow only (no per-color picker so the
                                     user has no other way to dim the effect). -->
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44"
                                            Visibility="{Binding DeviceConfig.LightbarMode, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=Rainbow}">
                                    <TextBlock Text="{Binding Pad_Lighting_RainbowBrightness, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding DeviceConfig.LightbarRainbowBrightness, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"
                                            Minimum="0" Maximum="100" TickFrequency="1"/>
                                    <TextBox Text="{Binding DeviceConfig.LightbarRainbowBrightness, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding DeviceConfig.ResetLightbarRainbowBrightnessCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetLightbarRainbowBrightness, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <!-- Screen Color (#559): which part of which display, and what
                                     to do with its colors. Reads through one lease per display
                                     (ScreenColorSource), so these controls start nothing. -->
                                <StackPanel Visibility="{Binding DeviceConfig.LightbarMode, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=ScreenColor}">
                                    <TextBlock Text="{Binding Pad_Lighting_ScreenHint, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardDescription}"/>
                                    <TextBlock x:Name="ScreenColorStatus" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <TextBlock Text="{Binding Pad_Lighting_ScreenDisplay, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <ComboBox x:Name="ScreenColorDisplayBox" DisplayMemberPath="Label"
                                                  SelectionChanged="ScreenColorDisplayBox_SelectionChanged"
                                                  AutomationProperties.AutomationId="ScreenColorDisplayBox"
                                                  MaxWidth="444" controls:SettingRow.Fills="True" VerticalAlignment="Center"/>
                                        <ui:Button Command="{Binding DeviceConfig.ResetScreenColorDisplayCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetScreenColorDisplay, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <TextBlock Text="{Binding Pad_Lighting_ScreenArea, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <ComboBox SelectedValue="{Binding DeviceConfig.ScreenColorArea, Mode=TwoWay}" SelectedValuePath="Tag"
                                                  AutomationProperties.AutomationId="ScreenColorAreaBox"
                                                  MaxWidth="444" controls:SettingRow.Fills="True" VerticalAlignment="Center">
                                            <ComboBoxItem Content="{Binding Pad_Lighting_ScreenArea_WholeScreen, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:ScreenColorArea.WholeScreen}"/>
                                            <ComboBoxItem Content="{Binding Pad_Lighting_ScreenArea_TopLeft, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:ScreenColorArea.TopLeft}"/>
                                            <ComboBoxItem Content="{Binding Pad_Lighting_ScreenArea_Top, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:ScreenColorArea.Top}"/>
                                            <ComboBoxItem Content="{Binding Pad_Lighting_ScreenArea_TopRight, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:ScreenColorArea.TopRight}"/>
                                            <ComboBoxItem Content="{Binding Pad_Lighting_ScreenArea_Left, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:ScreenColorArea.Left}"/>
                                            <ComboBoxItem Content="{Binding Pad_Lighting_ScreenArea_Center, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:ScreenColorArea.Center}"/>
                                            <ComboBoxItem Content="{Binding Pad_Lighting_ScreenArea_Right, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:ScreenColorArea.Right}"/>
                                            <ComboBoxItem Content="{Binding Pad_Lighting_ScreenArea_BottomLeft, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:ScreenColorArea.BottomLeft}"/>
                                            <ComboBoxItem Content="{Binding Pad_Lighting_ScreenArea_Bottom, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:ScreenColorArea.Bottom}"/>
                                            <ComboBoxItem Content="{Binding Pad_Lighting_ScreenArea_BottomRight, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:ScreenColorArea.BottomRight}"/>
                                            <ComboBoxItem Content="{Binding Pad_Lighting_ScreenArea_Custom, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:ScreenColorArea.Custom}"/>
                                        </ComboBox>
                                        <ui:Button Command="{Binding DeviceConfig.ResetScreenColorAreaCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetScreenColorArea, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                    <StackPanel Visibility="{Binding DeviceConfig.ScreenColorArea, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=Custom}">
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <TextBlock Text="{Binding Pad_Lighting_ScreenLeft, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <Slider Value="{Binding DeviceConfig.ScreenColorLeft, Mode=TwoWay}"
                                                Style="{StaticResource DzSlider}"
                                                Minimum="0" Maximum="99" TickFrequency="1"/>
                                        <TextBox Text="{Binding DeviceConfig.ScreenColorLeft, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding DeviceConfig.ResetScreenColorLeftCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetScreenColorLeft, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <TextBlock Text="{Binding Pad_Lighting_ScreenTop, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <Slider Value="{Binding DeviceConfig.ScreenColorTop, Mode=TwoWay}"
                                                Style="{StaticResource DzSlider}"
                                                Minimum="0" Maximum="99" TickFrequency="1"/>
                                        <TextBox Text="{Binding DeviceConfig.ScreenColorTop, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding DeviceConfig.ResetScreenColorTopCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetScreenColorTop, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <TextBlock Text="{Binding Pad_Lighting_ScreenWidth, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <Slider Value="{Binding DeviceConfig.ScreenColorWidth, Mode=TwoWay}"
                                                Style="{StaticResource DzSlider}"
                                                Minimum="1" Maximum="100" TickFrequency="1"/>
                                        <TextBox Text="{Binding DeviceConfig.ScreenColorWidth, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding DeviceConfig.ResetScreenColorWidthCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetScreenColorWidth, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <TextBlock Text="{Binding Pad_Lighting_ScreenHeight, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <Slider Value="{Binding DeviceConfig.ScreenColorHeight, Mode=TwoWay}"
