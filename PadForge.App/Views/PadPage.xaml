                                             Style="{StaticResource DzValueEdit}"/>
                                    <ui:Button Command="{Binding ResetTouchpadMomentumMinLiftCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadMomentumMinLift, Source={x:Static strings:Strings.Instance}}"/>
