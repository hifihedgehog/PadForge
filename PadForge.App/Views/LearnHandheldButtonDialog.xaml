<views:DialogWindow AutomationProperties.IsDialog="True" x:Class="PadForge.Views.LearnHandheldButtonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        xmlns:common="clr-namespace:PadForge.Common"
        xmlns:controls="clr-namespace:PadForge.Controls"
        xmlns:views="clr-namespace:PadForge.Views"
        Title="{Binding Handheld_Title, Source={x:Static strings:Strings.Instance}}"
        Subtitle="{Binding Handheld_Intro, Source={x:Static strings:Strings.Instance}}">

    <!-- Hidden Buttons (#343, #574), as the Record board draws it: a live
         line that walks the three steps of a learn, the name to give what
         the press changed with Register beside it, and the buttons learned
         on this machine. A learn starts as the dialog opens, and Start
         Over runs it again. Export and Import pass a machine's learned set
         along as a file. -->
    <views:DialogWindow.Resources>
        <!-- A row is read by its button's name. What the button was learned
             from is its tooltip. -->
        <Style x:Key="LearnedItem" TargetType="ListBoxItem" BasedOn="{StaticResource DialogListItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name, TargetNullValue=''}"/>
            <Setter Property="ToolTip" Value="{Binding Description}"/>
        </Style>
    </views:DialogWindow.Resources>

    <views:DialogWindow.Foot>
        <controls:FlexLinePanel Style="{StaticResource DialogFootPanel}">
            <Button x:Name="StartBtn" Style="{StaticResource DialogQuietButton}"
                    Content="{Binding Handheld_StartOver, Source={x:Static strings:Strings.Instance}}"
                    Click="StartButton_Click"/>
            <Button Style="{StaticResource DialogQuietButton}" controls:FlexLinePanel.AtEnd="True"
                    Content="{Binding Handheld_Export, Source={x:Static strings:Strings.Instance}}"
                    Click="ExportButton_Click"/>
            <Button Style="{StaticResource DialogQuietButton}" controls:FlexLinePanel.AtEnd="True"
                    Content="{Binding Handheld_Import, Source={x:Static strings:Strings.Instance}}"
                    Click="ImportButton_Click"/>
            <Button Style="{StaticResource DialogButton}" IsCancel="True"
                    Content="{Binding Common_Close, Source={x:Static strings:Strings.Instance}}"/>
        </controls:FlexLinePanel>
    </views:DialogWindow.Foot>

    <StackPanel>
        <!-- The dot is ember while a learn runs and the wait color while
             none does. The line says what to do now, and its end says
             which step this is, then what the press changed. -->
        <Border Style="{StaticResource DialogLiveBox}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="LiveDot" Width="9" Height="9" VerticalAlignment="Center" Margin="3,0,4,0"
                         Fill="{DynamicResource WaitBrush}"/>
                <TextBlock x:Name="StatusText" Grid.Column="1" Margin="10,0" TextWrapping="Wrap" VerticalAlignment="Center"
                           common:LiveText.Polite="True"/>
                <TextBlock x:Name="ChordText" Grid.Column="2" FontSize="13" MaxWidth="230" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </Grid>
        </Border>

        <!-- The vendor's own tool keeps reacting to the same buttons until
             it is stopped. -->
        <Border x:Name="DaemonBox" Style="{StaticResource DialogWaitBox}" Margin="0,8,0,0" Visibility="Collapsed">
            <TextBlock x:Name="DaemonText" TextWrapping="Wrap" FontSize="13"/>
        </Border>

        <!-- When the press changed a report in more than one place, the
             place to keep. -->
        <controls:SettingRow x:Name="SourceRow" MinHeight="44" Margin="0,8,0,0" Visibility="Collapsed">
            <TextBlock Style="{StaticResource DialogLabelNarrow}"
                       Text="{Binding Handheld_SourceLabel, Source={x:Static strings:Strings.Instance}}"/>
            <ComboBox x:Name="CandidateBox" Style="{StaticResource DialogSelect}" controls:SettingRow.Fills="True"
                      DisplayMemberPath="Description"
                      AutomationProperties.Name="{Binding Handheld_SourceLabel, Source={x:Static strings:Strings.Instance}}"/>
        </controls:SettingRow>

        <controls:SettingRow MinHeight="44" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource DialogLabelNarrow}"
                       Text="{Binding Handheld_NameLabel, Source={x:Static strings:Strings.Instance}}"/>
            <ui:TextBox x:Name="NameBox" Style="{StaticResource DialogTextBox}" controls:SettingRow.Fills="True"
                        PlaceholderText="{Binding Handheld_NamePlaceholder, Source={x:Static strings:Strings.Instance}}"
                        AutomationProperties.Name="{Binding Handheld_NameLabel, Source={x:Static strings:Strings.Instance}}"
                        KeyDown="NameBox_KeyDown"/>
            <Button x:Name="RegisterBtn" Style="{StaticResource DialogPrimaryButton}" Margin="10,0,0,0" IsEnabled="False"
                    Content="{Binding Handheld_RegisterButton, Source={x:Static strings:Strings.Instance}}"
                    Click="RegisterButton_Click"/>
        </controls:SettingRow>

        <!-- The buttons learned on this machine, which the heading names. -->
        <TextBlock x:Name="ListHead" Style="{StaticResource DialogHead3}"/>
        <TextBlock x:Name="EmptyText" Style="{StaticResource DialogNote}"
                   Text="{Binding Handheld_NoneLearned, Source={x:Static strings:Strings.Instance}}"/>
        <Border x:Name="ListFrame" Style="{StaticResource DialogList}">
            <ListBox x:Name="ButtonListBox" Style="{StaticResource DialogListBox}" MaxHeight="240"
                     ItemContainerStyle="{StaticResource LearnedItem}"
                     AutomationProperties.Name="{Binding Text, ElementName=ListHead, TargetNullValue=''}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,12,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="1" Style="{StaticResource DialogSmallQuietButton}"
                                    Content="{Binding Common_Remove, Source={x:Static strings:Strings.Instance}}"
                                    Click="RemoveButton_Click" Tag="{Binding Button}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </StackPanel>
</views:DialogWindow>
