                                                    <TextBox Text="{Binding SteeringAngleRumbleDeadzone, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                    <ui:Button x:Name="SteeringAngleRumbleDeadzoneReset" Command="{Binding ResetSteeringAngleRumbleDeadzoneCommand}" Style="{StaticResource ResetButton}"
                                                               ToolTip="{Binding Pad_SteeringAngleRumble_ResetDeadzone, Source={x:Static strings:Strings.Instance}}"/>
                                                </controls:SettingRow>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Constant Force: its switch, and under it
                                             while it is on the grid to drag in and the
                                             two numbers the drag sets. -->
                                        <StackPanel x:Name="ConstantForceRows">
                                            <controls:SettingRow MinHeight="44">
                                                <TextBlock Text="{Binding Pad_ConstantForce_Toggle, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                                           ToolTip="{Binding Pad_ConstantForce_Description, Source={x:Static strings:Strings.Instance}}"/>
                                                <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{Binding Pad_ConstantForce_Toggle, Source={x:Static strings:Strings.Instance}}"
                                                          ToolTip="{Binding Pad_ConstantForce_Description, Source={x:Static strings:Strings.Instance}}"
                                                          IsChecked="{Binding ConstantForceEnabled, Mode=TwoWay}"/>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="ConstantForceEnabled" SettingLabel="{Binding Pad_ConstantForce_Toggle, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_PadViewModel_ConstantForceEnabled_7429"/>
                                            </controls:SettingRow>
                                            <StackPanel Visibility="{Binding ConstantForceEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" Margin="16,4,0,8">
                                                    <!-- Interactive grid -->
                                                    <Border x:Name="ConstantForcePadBorder"
                                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1" CornerRadius="8"
                                                            Padding="4" Width="212" Height="212"
                                                            Cursor="Cross"
                                                            ClipToBounds="True"
                                                            MouseLeftButtonDown="ConstantForcePad_MouseLeftButtonDown"
                                                            MouseMove="ConstantForcePad_MouseMove"
                                                            MouseLeftButtonUp="ConstantForcePad_MouseLeftButtonUp">
                                                        <Grid Width="200" Height="200">
                                                            <Ellipse Width="200" Height="200"
                                                                     Fill="{DynamicResource ControlFillColorDefaultBrush}"/>
                                                            <Line FlowDirection="LeftToRight" X1="50" Y1="0" X2="50" Y2="200" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeDashArray="2 4" StrokeThickness="0.5"/>
                                                            <Line FlowDirection="LeftToRight" X1="150" Y1="0" X2="150" Y2="200" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeDashArray="2 4" StrokeThickness="0.5"/>
                                                            <Line FlowDirection="LeftToRight" X1="0" Y1="50" X2="200" Y2="50" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeDashArray="2 4" StrokeThickness="0.5"/>
                                                            <Line FlowDirection="LeftToRight" X1="0" Y1="150" X2="200" Y2="150" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeDashArray="2 4" StrokeThickness="0.5"/>
                                                            <Line FlowDirection="LeftToRight" X1="100" Y1="0" X2="100" Y2="200" Stroke="{DynamicResource TextFillColorTertiaryBrush}" StrokeThickness="0.75"/>
                                                            <Line FlowDirection="LeftToRight" X1="0" Y1="100" X2="200" Y2="100" Stroke="{DynamicResource TextFillColorTertiaryBrush}" StrokeThickness="0.75"/>
                                                            <Canvas FlowDirection="LeftToRight">
                                                                <Ellipse Width="196" Height="196" Canvas.Left="2" Canvas.Top="2"
                                                                         Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                                         StrokeThickness="1.5" Fill="Transparent"/>
                                                                <!-- Force vector line from center to handle (signed [-1..+1] → canvas, dot size 0 = use raw position) -->
                                                                <Line Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="2"
                                                                      X1="100" Y1="100"
                                                                      X2="{Binding ConstantForceX, Converter={StaticResource SignedNormToCanvasConverter}, ConverterParameter='200,0'}"
                                                                      Y2="{Binding ConstantForceY, Converter={StaticResource SignedNormToCanvasConverter}, ConverterParameter='200,0'}"/>
                                                                <!-- Force handle dot -->
                                                                <Ellipse Width="13" Height="13"
                                                                         Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                                                         Stroke="{DynamicResource AccentFillColorSecondaryBrush}" StrokeThickness="1.5"
                                                                         Canvas.Left="{Binding ConstantForceX, Converter={StaticResource SignedNormToCanvasConverter}, ConverterParameter='200,13'}"
                                                                         Canvas.Top="{Binding ConstantForceY, Converter={StaticResource SignedNormToCanvasConverter}, ConverterParameter='200,13'}"/>
                                                            </Canvas>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{Binding Pad_ConstantForce_Position, Source={x:Static strings:Strings.Instance}}"
                                                               Style="{StaticResource CardDescription}" MaxWidth="240"
                                                               VerticalAlignment="Top" Margin="16,2,0,0"/>
                                                </StackPanel>
                                                <controls:SettingRow MinHeight="44">
                                                    <TextBlock Text="{Binding Pad_ConstantForce_X, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzSubLabel}"/>
                                                    <Slider Value="{Binding ConstantForceX, Mode=TwoWay}"
                                                            Minimum="-1" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                                                            Style="{StaticResource DzSlider}"/>
                                                    <TextBox Text="{Binding ConstantForceX, Mode=TwoWay, StringFormat=F2, UpdateSourceTrigger=LostFocus}"
                                                             Style="{StaticResource DzValueEdit}"/>
                                                    <ui:Button Command="{Binding ResetConstantForceXCommand}" Style="{StaticResource ResetButton}"
                                                            ToolTip="{Binding Pad_ResetConstantForceX, Source={x:Static strings:Strings.Instance}}"/>
                                                </controls:SettingRow>
                                                <controls:SettingRow MinHeight="44">
                                                    <TextBlock Text="{Binding Pad_ConstantForce_Y, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzSubLabel}"/>
                                                    <Slider Value="{Binding ConstantForceY, Mode=TwoWay}"
                                                            Minimum="-1" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                                                            Style="{StaticResource DzSlider}"/>
                                                    <TextBox Text="{Binding ConstantForceY, Mode=TwoWay, StringFormat=F2, UpdateSourceTrigger=LostFocus}"
                                                             Style="{StaticResource DzValueEdit}"/>
                                                    <ui:Button Command="{Binding ResetConstantForceYCommand}" Style="{StaticResource ResetButton}"
                                                            ToolTip="{Binding Pad_ResetConstantForceY, Source={x:Static strings:Strings.Instance}}"/>
                                                </controls:SettingRow>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </controls:MoreRow>
                            </StackPanel>
                        </Border>

                        <controls:FoldList>
                        <!-- ── Audio Bass Rumble section ── -->
                        <controls:FoldCard x:Name="AudioRumbleFoldCard" StateKey="Pad.Rumble.Audio"
                                           Header="{Binding Settings_AudioRumble, Source={x:Static strings:Strings.Instance}}"
                                           Hint="{Binding Pad_AudioRumble_FoldHint, Source={x:Static strings:Strings.Instance}}"
                                           Description="{Binding Settings_AudioRumbleDesc, Source={x:Static strings:Strings.Instance}}">
                            <controls:FoldCard.HeaderAction>
                                <ui:Button Command="{Binding ResetAudioRumbleAllCommand}" Style="{StaticResource ResetAllButton}"
