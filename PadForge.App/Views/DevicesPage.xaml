<UserControl x:Class="PadForge.Views.DevicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:common="clr-namespace:PadForge.Common"
             xmlns:local="clr-namespace:PadForge.Views"
             xmlns:strings="clr-namespace:PadForge.Resources.Strings"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="po"
             xmlns:reset="clr-namespace:PadForge.Controls"
             xmlns:controls="clr-namespace:PadForge.Controls"
             xmlns:vm="clr-namespace:PadForge.ViewModels"
             FontFamily="{StaticResource BodyFontFamily}">

    <UserControl.Resources>
        <!-- A raw cell (#175): a field's fill inside the control line, its
             edge cold while its button is held. -->
        <Style x:Key="RawCellBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SteelFieldBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SteelLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPressed}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ColdBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- NFC tag rows light on IsActive instead of IsPressed. Deliberately
             NOT BasedOn RawCellBorder: inheritance carried the base style's
             IsPressed trigger along, and NfcTagDisplayItem has no IsPressed,
             so every NFC row realization logged a BINDERR pair. Base setters
             are duplicated instead. -->
        <Style x:Key="RawCellBorderActive" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SteelFieldBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SteelLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ColdBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RawCellLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPressed}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource ColdBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The page's buttons (#574): the board's plain button, 36 tall
             with rounded corners, and Remove Device in the danger look. -->
        <Style x:Key="DeviceButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Border.CornerRadius" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DeviceRemoveButton" TargetType="Button" BasedOn="{StaticResource EmberDestructiveButton}">
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Border.CornerRadius" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- A setting's label in the panel. It takes the row's room and
             wraps, so the switch and the reset keep their places at the
             row's end, whatever the label's length in a language. -->
        <Style x:Key="DeviceRowLabel" TargetType="TextBlock">
            <Setter Property="controls:SettingRow.Fills" Value="True"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="LineHeight" Value="20.3"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style x:Key="DeviceNumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="60"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Border.CornerRadius" Value="8"/>
        </Style>
        <!-- The board's small text: 13 on its line height, 1.45 of the size,
             as all of the board's text runs. -->
        <Style x:Key="DeviceSmall" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="18.85"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        </Style>
        <!-- A heading of the list or the panel, on the same line height. -->
        <Style x:Key="DeviceSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="LineHeight" Value="18.85"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        </Style>
        <!-- A line about the device in the panel, and the same line as a
             warning in the text-safe ember. -->
        <Style x:Key="DeviceNotice" TargetType="TextBlock" BasedOn="{StaticResource DeviceSmall}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style x:Key="DeviceWarning" TargetType="TextBlock" BasedOn="{StaticResource DeviceNotice}">
            <Setter Property="Foreground" Value="{DynamicResource EmberTextBrush}"/>
        </Style>
        <!-- The Details card's rows: a gray key in a column 96 wide, then
             its value, which wraps. -->
        <Style x:Key="DetailKey" TargetType="TextBlock" BasedOn="{StaticResource DeviceSmall}">
            <Setter Property="DockPanel.Dock" Value="Left"/>
            <Setter Property="Width" Value="96"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock" BasedOn="{StaticResource DeviceSmall}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DetailMono" TargetType="TextBlock" BasedOn="{StaticResource DetailValue}">
            <Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}"/>
        </Style>
        <Style x:Key="RawSectionLabel" TargetType="TextBlock" BasedOn="{StaticResource DeviceSectionTitle}">
            <Setter Property="Margin" Value="0,8,0,6"/>
        </Style>

        <!-- A virtual controller under Used By. A click puts the device on
             the controller or takes it off. In use, the chip is ember with
             dark words. Not in use, it is a raised steel chip. -->
        <Style x:Key="UsedByChip" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource SteelRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SteelLineBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SubRowTextBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="13" BorderThickness="1" MinHeight="26" Padding="8,0,10,0"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SteelLiftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource EmberBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource EmberBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource EmberInkBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource EmberLiftBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource EmberLiftBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- New Controller after the chips: a dashed edge (a Border cannot
             dash, so a Rectangle draws it, as Home's Add Controller tile
             does) that fills under the pointer. The clear fill takes the
             click inside the edge. -->
        <Style x:Key="NewControllerChip" TargetType="Button">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid MinHeight="26">
                            <Rectangle x:Name="Edge" RadiusX="13" RadiusY="13" Fill="Transparent"
                                       Stroke="{DynamicResource DashLineBrush}" StrokeThickness="1" StrokeDashArray="4 3"
                                       SnapsToDevicePixels="True"/>
                            <ContentPresenter Margin="11,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Edge" Property="Fill" Value="{DynamicResource SteelRaisedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A device's row in the lists (the world-class pass): a hairline
             over it and a fill under the pointer. The selected device's
             row has an ember bar at its start and a warm wash that fades
             toward its end. A screen reader hears the device's name, its
             line and the controllers that use it. -->
        <Style x:Key="DeviceRowContainer" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding DeviceName, TargetNullValue='', FallbackValue=''}"/>
            <Setter Property="AutomationProperties.HelpText" Value="{Binding RowLine, TargetNullValue='', FallbackValue=''}"/>
            <Setter Property="AutomationProperties.ItemStatus" Value="{Binding RowStatus, TargetNullValue='', FallbackValue=''}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="{DynamicResource SteelPaneLineBrush}" BorderThickness="0,1,0,0"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="Wash" IsHitTestVisible="False" Opacity="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#21FF6B2C" Offset="0"/>
                                            <GradientStop Color="#00FF6B2C" Offset="0.62"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border x:Name="Bar" Width="3" CornerRadius="2" Margin="0,14,0,14" HorizontalAlignment="Left"
                                        IsHitTestVisible="False" Visibility="Collapsed"
                                        Background="{DynamicResource EmberBrush}"/>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SteelCardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                <Setter TargetName="Wash" Property="Opacity" Value="1"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A device's link, where it is a known fact: the Bluetooth mark
             and the word. It stands in the table's Link column, or after
             the device's type where the list is too narrow for the
             column. -->
        <DataTemplate x:Key="DeviceLinkFact" DataType="{x:Type vm:DeviceRowViewModel}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <controls:DecorativeStrokeIcon Data="{StaticResource BluetoothLineGeometry}" Size="13" StrokeWidth="2"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding LinkText}" Margin="7,0,0,0" FontSize="13" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </DataTemplate>
        <!-- A device's battery: the meter, the percentage, and Low at or
             under the level Settings names. In the Battery column, or
             after the type where the list is narrow. -->
        <DataTemplate x:Key="DeviceBatteryFact" DataType="{x:Type vm:DeviceRowViewModel}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <controls:BatteryMeter Percent="{Binding BatteryPercent}" Charging="{Binding BatteryCharging}" Low="{Binding BatteryLow}"/>
                <TextBlock Text="{Binding BatteryText}" Margin="7,0,0,0"
                           FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12.5" VerticalAlignment="Center"
                           AutomationProperties.Name="{Binding BatterySpoken, Mode=OneWay, TargetNullValue='', FallbackValue=''}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource ColdBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BatteryLow}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource WaitBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Pad_Battery_Low, Source={x:Static strings:Strings.Instance}}" Margin="7,0,0,0"
                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource WaitBrush}"
                           Visibility="{Binding BatteryLow, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>
        </DataTemplate>
        <!-- A row as the table draws it: the device's kind on a tile, its
             name and type, then three columns the table's head names. Link
             is how the device reaches this PC, where that is known. Battery
             is a meter of the level and the percentage, gold with the word
             Low at or under the level Settings names. Used By is a pill for
             each virtual controller that uses the device, or Use for a
             connected game controller nothing uses. A controller's row is
             taller, with its type under its name. Every other row is one
             line. Each of the three columns is as wide in every row of the
             card as its widest cell (the card is one shared scope), and a
             column no row fills takes no room. A name runs on into the
             columns its own row has nothing in. Where the list is too
             narrow for Link and Battery as columns (DevicesPage.IsWideTable),
             a row shows the two after its type and the table keeps Used By
             alone, so a name is never cut to a few letters. -->
        <DataTemplate x:Key="DeviceRowTemplate" DataType="{x:Type vm:DeviceRowViewModel}">
            <!-- The row is a Border with the three drag handlers:
                 DeviceCard_MouseDown wants a Border whose data is a row, and
                 the accessibility allowlist keys these handlers. A drag onto
                 a controller in the sidebar assigns the device. The Border
                 has no name, since the allowlist knows it by its handlers:
                 the grid inside is the row the triggers read. Under the
                 container's hairline a controller's row is the board's 64
                 and any other row its 48. -->
            <Border Background="Transparent" Padding="18,0,16,0"
                    PreviewMouseLeftButtonDown="DeviceCard_MouseDown"
                    PreviewMouseMove="DeviceCard_MouseMove"
                    PreviewMouseLeftButtonUp="DeviceCard_MouseUp">
                <Grid x:Name="Row" MinHeight="47">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="DeviceLink"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="DeviceBattery"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="DeviceUsedBy"/>
                    </Grid.ColumnDefinitions>
                    <!-- The kind, on a tile that lights while the device
                         sends input. Ember is for what is live, so the
                         picked row's tile stays steel. -->
                    <controls:Halo CornerRadius="10" Radius="17.5" Strength="0.2" IsLit="{Binding IsSending}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="Tile" Width="32" Height="32" CornerRadius="8" BorderThickness="1"
                                Background="{DynamicResource SteelFieldBrush}"
                                BorderBrush="{DynamicResource SteelLineSoftBrush}">
                            <controls:GlyphText x:Name="Glyph" Text="{Binding KindGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </controls:Halo>
                    <!-- One line: the name, then the type, then the link
                         and the battery where the list is narrow. The name
                         gives way first when the row is narrow, so the grid
                         is as wide as its parts need and no wider. -->
                    <Grid x:Name="OneLine" Grid.Column="1" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="OneLineName" Text="{Binding DeviceName}" FontSize="14" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceName}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding DeviceType}" Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <StackPanel x:Name="OneLineFacts" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource DeviceLinkFact}" Margin="12,0,0,0"
                                              Visibility="{Binding HasLink, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource DeviceBatteryFact}" Margin="12,0,0,0"
                                              Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>
                    <!-- Two lines, for a controller: the name over the type,
                         and after the type the link and the battery where
                         the list is narrow. -->
                    <StackPanel x:Name="TwoLines" Grid.Column="1" Margin="14,8,0,8" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="TwoLinesName" Text="{Binding DeviceName}" FontSize="14" FontWeight="SemiBold"
                                   LineHeight="20.3" LineStackingStrategy="BlockLineHeight"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceName}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource DeviceSmall}" Text="{Binding DeviceType}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <StackPanel x:Name="TwoLinesFacts" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource DeviceLinkFact}" Margin="12,0,0,0"
                                                  Visibility="{Binding HasLink, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource DeviceBatteryFact}" Margin="12,0,0,0"
                                                  Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <!-- Link: Bluetooth where that is known. -->
                    <ContentPresenter x:Name="LinkCell" Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource DeviceLinkFact}"
                                      Margin="14,0,0,0" MinWidth="104" VerticalAlignment="Center"
                                      Visibility="{Binding HasLink, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <!-- Battery: the meter, the percentage, and Low. -->
                    <ContentPresenter x:Name="BatteryCell" Grid.Column="3" Content="{Binding}" ContentTemplate="{StaticResource DeviceBatteryFact}"
                                      Margin="14,0,0,0" MinWidth="108" VerticalAlignment="Center"
                                      Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Grid Grid.Column="4" Margin="14,0,0,0" MinWidth="104" VerticalAlignment="Center">
                        <!-- A pill for each virtual controller that uses the
                             device, with the type's mark and its number within
                             the type, as the sidebar numbers it. Filled ember
                             says the device is in use now. On a row that is
                             not connected the pill is steel: the device is
                             the controller's, and nothing comes from it. -->
                        <ItemsControl ItemsSource="{Binding SlotBadges}" MaxWidth="260" HorizontalAlignment="Left"
                                      Focusable="False" IsTabStop="False"
                                      Visibility="{Binding IsAssigned, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Pill" MinHeight="26" Padding="8,0,10,0" CornerRadius="13" Margin="0,2,6,2" BorderThickness="1"
                                            Background="{DynamicResource EmberBrush}" BorderBrush="{DynamicResource EmberBrush}"
                                            TextElement.Foreground="{DynamicResource EmberInkBrush}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Grid Width="13" Height="13" VerticalAlignment="Center">
                                                <Path FlowDirection="LeftToRight" Data="{Binding TypeGeometry, Mode=OneWay}" Stretch="Uniform"
                                                      Fill="{Binding (TextElement.Foreground), ElementName=Pill}"/>
                                                <controls:GlyphText Text="{Binding TypeGlyph, Mode=OneWay}" FontFamily="Segoe MDL2 Assets"
                                                                    FontSize="12" Foreground="{Binding (TextElement.Foreground), ElementName=Pill}"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                    Visibility="{Binding TypeGlyph, Converter={StaticResource StringToVisibility}}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Label, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold"
                                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsOnline, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="False">
                                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SteelRaisedBrush}"/>
                                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource SteelLineBrush}"/>
                                            <Setter TargetName="Pill" Property="TextElement.Foreground" Value="{DynamicResource SubRowTextBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Use for a connected game controller nothing uses,
                             while a slot is free. It opens Add a Controller,
                             and the controller made there takes the device.
                             It is an outline in ember: the page's filled
                             ember is for a device in use. -->
                        <Border HorizontalAlignment="Left">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding OffersUse}" Value="True"/>
                                                <Condition Binding="{Binding DataContext.CanAddController, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ui:Button x:Name="UseItButton" Style="{StaticResource EmberOutlineButton}" MinHeight="28" Padding="14,0"
                                       FontSize="13" CornerRadius="8" Click="UseIt_Click"
                                       Content="{Binding Home_Offer_Use, Source={x:Static strings:Strings.Instance}}"
                                       AutomationProperties.AutomationId="Devices_UseIt"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsControllerRow}" Value="True">
                    <Setter TargetName="Row" Property="MinHeight" Value="63"/>
                    <Setter TargetName="Tile" Property="Width" Value="40"/>
                    <Setter TargetName="Tile" Property="Height" Value="40"/>
                    <Setter TargetName="Tile" Property="CornerRadius" Value="10"/>
                    <Setter TargetName="Glyph" Property="FontSize" Value="20"/>
                    <Setter TargetName="OneLine" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="TwoLines" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <!-- The name runs on into the columns the row has nothing
                     in: Link alone, or Link and Battery. -->
                <DataTrigger Binding="{Binding HasLink}" Value="False">
                    <Setter TargetName="OneLine" Property="Grid.ColumnSpan" Value="2"/>
                    <Setter TargetName="TwoLines" Property="Grid.ColumnSpan" Value="2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasLinkOrBattery}" Value="False">
                    <Setter TargetName="OneLine" Property="Grid.ColumnSpan" Value="3"/>
                    <Setter TargetName="TwoLines" Property="Grid.ColumnSpan" Value="3"/>
                </DataTrigger>
                <!-- A narrow list: the two facts after the type, and no
                     column of their own. -->
                <Trigger SourceName="Row" Property="local:DevicesPage.IsWideTable" Value="False">
                    <Setter TargetName="LinkCell" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="BatteryCell" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="OneLineFacts" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="TwoLinesFacts" Property="Visibility" Value="Visible"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                    <Setter TargetName="OneLineName" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <Setter TargetName="TwoLinesName" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSending}" Value="True">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource EmberRingBrush}"/>
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource EmberHotBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- A part of the connected list: its name and how many rows it
             shows, over its rows. The names are the Show segments' own, and
             a screen reader hears the part by its name. -->
        <Style x:Key="DeviceGroup" TargetType="GroupItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Devices_Filter_Other, Source={x:Static strings:Strings.Instance}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <StackPanel>
                            <Border BorderBrush="{DynamicResource SteelPaneLineBrush}" BorderThickness="0,1,0,0" Padding="18,14,18,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="GroupName" FontSize="14" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Text="{Binding Devices_Filter_Other, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBlock Text="{Binding ItemCount}" Margin="8,0,0,1" VerticalAlignment="Bottom"
                                               FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <ItemsPresenter/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Name}" Value="{x:Static vm:DeviceFilter.Controllers}">
                                <Setter TargetName="GroupName" Property="Text" Value="{Binding Devices_Filter_Controllers, Source={x:Static strings:Strings.Instance}}"/>
                                <Setter Property="AutomationProperties.Name" Value="{Binding Devices_Filter_Controllers, Source={x:Static strings:Strings.Instance}}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Name}" Value="{x:Static vm:DeviceFilter.KeyboardsMice}">
                                <Setter TargetName="GroupName" Property="Text" Value="{Binding Devices_Filter_KeyboardsMice, Source={x:Static strings:Strings.Instance}}"/>
                                <Setter Property="AutomationProperties.Name" Value="{Binding Devices_Filter_KeyboardsMice, Source={x:Static strings:Strings.Instance}}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A column's name at the table's head, and a tile's label in the
             panel: the boards' small label. -->
        <Style x:Key="DeviceLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- A fact about the device in the panel, on a tile of its own. -->
        <Style x:Key="DeviceTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SteelGroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SteelPaneLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>
        <!-- One of the three lists: its rows only, with no frame and no
             scroll of its own. The page scrolls the list card. A list over a
             view of its own follows the view's current item unless told
             not to, which picked each list's first row as it filled: the
             pick is the page's, set from the view model. -->
        <Style x:Key="DeviceList" TargetType="ListBox">
            <Setter Property="IsSynchronizedWithCurrentItem" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DeviceRowContainer}"/>
            <Setter Property="ItemTemplate" Value="{StaticResource DeviceRowTemplate}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        </Style>
    </UserControl.Resources>

    <!-- The Devices page (#574): the title and the filter row stay put, and
         under them the device table and the selected device's panel scroll
         on their own while the page is wide. Narrower than the two need,
         the panel stands under the table and the page scrolls whole
         (DevicesPage.ApplyLayout). -->
    <Grid x:Name="PageRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:FlexLinePanel x:Name="HeaderRow" Margin="36,26,36,0" Gap="16" LineGap="12">
            <StackPanel controls:FlexLinePanel.Basis="200" controls:FlexLinePanel.Grow="1" VerticalAlignment="Bottom">
                <TextBlock x:Name="DevicesTitle" AutomationProperties.HeadingLevel="Level1"
                           Text="{Binding Devices_Title, Source={x:Static strings:Strings.Instance}}"
                           FontFamily="{StaticResource DisplayFontFamily}" FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           LineHeight="40.6" LineStackingStrategy="BlockLineHeight"/>
                <TextBlock x:Name="DevicesSubtitle" Margin="0,2,0,0" Style="{StaticResource DeviceSmall}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource FormatTextConverter}">
                            <Binding Path="ConnectedTotal"/>
                            <Binding Path="Devices_ConnectedCount_Format" Source="{x:Static strings:Strings.Instance}"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
            <ui:Button x:Name="PairButton" VerticalAlignment="Bottom" MinHeight="36" Padding="14,0" CornerRadius="8"
                       Command="{Binding PairCommand}"
                       Content="{Binding Devices_Pair, Source={x:Static strings:Strings.Instance}}"
                       AutomationProperties.AutomationId="Devices_Pair">
                <ui:Button.Icon>
                    <controls:DecorativeSymbolIcon Symbol="Bluetooth24" FontSize="16"/>
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button x:Name="RefreshButton" VerticalAlignment="Bottom" MinWidth="38" MinHeight="36" Padding="10,0" CornerRadius="8"
                       Command="{Binding RefreshCommand}"
                       ToolTip="{Binding Common_Refresh, Source={x:Static strings:Strings.Instance}}"
                       AutomationProperties.AutomationId="Devices_Refresh">
                <controls:DecorativeSymbolIcon Symbol="ArrowClockwise24" FontSize="16"/>
            </ui:Button>
        </controls:FlexLinePanel>

        <!-- The search box and the Show segments. The box takes what the
             line leaves beside the segments, 320 at most, and the line
             wraps before the box is narrower than 220
             (DevicesPage.SearchWidth). -->
        <controls:FlexLinePanel x:Name="FilterRow" Grid.Row="1" Margin="36,16,36,16" Gap="14" LineGap="10"
                                SizeChanged="FilterRow_SizeChanged">
            <ui:TextBox x:Name="DeviceSearchBox" Width="320" VerticalAlignment="Center" MinHeight="36" Padding="10,0"
                        VerticalContentAlignment="Center"
                        AutomationProperties.AutomationId="Devices_Search"
                        AutomationProperties.Name="{Binding Devices_SearchPlaceholder, Source={x:Static strings:Strings.Instance}}"
                        PlaceholderText="{Binding Devices_SearchPlaceholder, Source={x:Static strings:Strings.Instance}}"
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <ui:TextBox.Style>
                    <Style TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
                        <Setter Property="Border.CornerRadius" Value="8"/>
                    </Style>
                </ui:TextBox.Style>
                <ui:TextBox.Icon>
                    <controls:DecorativeStrokeIcon Data="{StaticResource SearchLineGeometry}" Size="14" StrokeWidth="2"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </ui:TextBox.Icon>
            </ui:TextBox>
            <Border x:Name="ShowSegments" Style="{StaticResource SegmentTrack}" SizeChanged="FilterRow_SizeChanged">
                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="DeviceFilter" Style="{StaticResource SegmentRadio}" Tag="All" Checked="Filter_Checked"
                                 IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource EnumEqualityConverter}, ConverterParameter=All}"
                                 AutomationProperties.AutomationId="Devices_Filter_All">
                        <TextBlock Text="{Binding Devices_Filter_All, Source={x:Static strings:Strings.Instance}}"/>
                    </RadioButton>
                    <RadioButton GroupName="DeviceFilter" Style="{StaticResource SegmentRadio}" Tag="Controllers" Checked="Filter_Checked"
                                 IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource EnumEqualityConverter}, ConverterParameter=Controllers}"
                                 AutomationProperties.AutomationId="Devices_Filter_Controllers">
                        <TextBlock Text="{Binding Devices_Filter_Controllers, Source={x:Static strings:Strings.Instance}}"/>
                    </RadioButton>
                    <RadioButton GroupName="DeviceFilter" Style="{StaticResource SegmentRadio}" Tag="KeyboardsMice" Checked="Filter_Checked"
                                 IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource EnumEqualityConverter}, ConverterParameter=KeyboardsMice}"
                                 AutomationProperties.AutomationId="Devices_Filter_KeyboardsMice">
                        <TextBlock Text="{Binding Devices_Filter_KeyboardsMice, Source={x:Static strings:Strings.Instance}}"/>
                    </RadioButton>
                    <RadioButton GroupName="DeviceFilter" Style="{StaticResource SegmentRadio}" Tag="Other" Checked="Filter_Checked"
                                 IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource EnumEqualityConverter}, ConverterParameter=Other}"
                                 AutomationProperties.AutomationId="Devices_Filter_Other">
                        <TextBlock Text="{Binding Devices_Filter_Other, Source={x:Static strings:Strings.Instance}}"/>
                    </RadioButton>
                </StackPanel>
            </Border>
        </controls:FlexLinePanel>

        <!-- The body. A wpf-ui scroll bar lies over its content's right
             edge, so in the wide layout each bar sits in a padding and never
             on a card. A PassiveScrollViewer whose scroll is disabled passes
             the wheel on, so the stacked layout scrolls whole. -->
        <ScrollViewer x:Name="BodyScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                      AutomationProperties.Name="{Binding Devices_Title, Source={x:Static strings:Strings.Instance}}">
            <Grid x:Name="BodyGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="PanelColumn" Width="408"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ListRow" Height="*"/>
                    <RowDefinition x:Name="StackGapRow" Height="0"/>
                    <RowDefinition x:Name="PanelRow" Height="0"/>
                </Grid.RowDefinitions>

                <ui:PassiveScrollViewer x:Name="ListScroll" Padding="36,0,16,36" VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled"
                                        AutomationProperties.AutomationId="Devices_ListScroll"
                                        AutomationProperties.Name="{Binding Devices_Title, Source={x:Static strings:Strings.Instance}}">
                    <!-- The list card: a table of the devices connected
                         now, then a folded line for the other inputs and a
                         folded line for the ones PadForge remembers, each
                         hidden while it has no row. Each list shows its
                         rows through the segment and the search. -->
                    <Border x:Name="DeviceListCard" Style="{StaticResource CardBorder}" Padding="0" Margin="0" VerticalAlignment="Top"
                            SizeChanged="ListCard_SizeChanged">
                        <!-- One scope for the three lists' columns: Link,
                             Battery and Used By are as wide in every row as
                             the widest of them needs. -->
                        <StackPanel Grid.IsSharedSizeScope="True">
                            <!-- The table's head: what each column holds. Link
                                 and Battery are named while a row has one to
                                 show and the list is wide enough for the two
                                 as columns. Each row tells a screen reader
                                 its own facts, so the head is for the eye. -->
                            <Grid x:Name="ListHead" Margin="18,12,16,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="DeviceLink"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="DeviceBattery"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="DeviceUsedBy"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Margin="14,0,0,0" Style="{StaticResource DeviceLabel}"
                                           Text="{Binding Devices_Group_Connected, Source={x:Static strings:Strings.Instance}}"/>
                                <TextBlock Grid.Column="2" Margin="14,0,0,0" MinWidth="104"
                                           Text="{Binding Devices_Detail_Link, Source={x:Static strings:Strings.Instance}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource DeviceLabel}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ShowLinkColumn}" Value="True"/>
                                                        <Condition Binding="{Binding (local:DevicesPage.IsWideTable), RelativeSource={RelativeSource Self}}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="3" Margin="14,0,0,0" MinWidth="108"
                                           Text="{Binding Devices_Detail_Battery, Source={x:Static strings:Strings.Instance}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource DeviceLabel}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ShowBatteryColumn}" Value="True"/>
                                                        <Condition Binding="{Binding (local:DevicesPage.IsWideTable), RelativeSource={RelativeSource Self}}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="4" Margin="14,0,0,0" MinWidth="104" Style="{StaticResource DeviceLabel}"
                                           Text="{Binding Devices_UsedBy, Source={x:Static strings:Strings.Instance}}"/>
                            </Grid>
                            <TextBlock x:Name="NoMatchLine" Margin="18,0,16,12" Style="{StaticResource DeviceSmall}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{Binding Devices_NoMatch, Source={x:Static strings:Strings.Instance}}"
                                       Visibility="{Binding ShowNoMatch, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <!-- The connected devices in three parts,
                                 Controllers, Keyboards & Mice and Other, each
                                 under its name and its count. -->
                            <ListBox x:Name="ConnectedList" Style="{StaticResource DeviceList}" ItemsSource="{Binding ConnectedView}"
                                     SelectionChanged="DeviceList_SelectionChanged"
                                     AutomationProperties.AutomationId="Devices_List_Connected"
                                     AutomationProperties.Name="{Binding Devices_Group_Connected, Source={x:Static strings:Strings.Instance}}">
                                <ListBox.GroupStyle>
                                    <GroupStyle ContainerStyle="{StaticResource DeviceGroup}"/>
                                </ListBox.GroupStyle>
                            </ListBox>
                            <!-- A fold's rows take back the fold's padding, so
                                 they run the card's full width as the
                                 connected rows do. A fold's hairline lies over
                                 the top of its line, which is then the board's
                                 52. Its chevron stands under the rows' tiles
                                 and its title under their names. -->
                            <Grid Visibility="{Binding HasOtherInputs, Converter={StaticResource BoolToVisibilityConverter}}">
                                <controls:FoldCard x:Name="OtherInputsFold" StateKey="Devices.OtherInputs"
                                                   Padding="33,0,16,0" ChevronMargin="0,0,29,0" HeaderMinHeight="52"
                                                   AutomationProperties.AutomationId="Devices_Fold_OtherInputs"
                                                   Header="{Binding Devices_Group_OtherInputs, Source={x:Static strings:Strings.Instance}}"
                                                   Hint="{Binding OtherInputsHint}">
                                    <ListBox x:Name="OtherInputsList" Style="{StaticResource DeviceList}" Margin="-20,0,-12,-12"
                                             ItemsSource="{Binding OtherInputsView}" SelectionChanged="DeviceList_SelectionChanged"
                                             AutomationProperties.AutomationId="Devices_List_OtherInputs"
                                             AutomationProperties.Name="{Binding Devices_Group_OtherInputs, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:FoldCard>
                                <Border Height="1" VerticalAlignment="Top" IsHitTestVisible="False"
                                        Background="{DynamicResource SteelPaneLineBrush}"/>
                            </Grid>
                            <Grid Visibility="{Binding HasNotConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                                <controls:FoldCard x:Name="NotConnectedFold" StateKey="Devices.NotConnected"
                                                   Padding="33,0,16,0" ChevronMargin="0,0,29,0" HeaderMinHeight="52"
                                                   AutomationProperties.AutomationId="Devices_Fold_NotConnected"
                                                   Header="{Binding Devices_Group_NotConnected, Source={x:Static strings:Strings.Instance}}"
                                                   Hint="{Binding NotConnectedHint}">
                                    <ListBox x:Name="NotConnectedList" Style="{StaticResource DeviceList}" Margin="-20,0,-12,-12"
                                             ItemsSource="{Binding NotConnectedView}" SelectionChanged="DeviceList_SelectionChanged"
                                             AutomationProperties.AutomationId="Devices_List_NotConnected"
                                             AutomationProperties.Name="{Binding Devices_Group_NotConnected, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:FoldCard>
                                <Border Height="1" VerticalAlignment="Top" IsHitTestVisible="False"
                                        Background="{DynamicResource SteelPaneLineBrush}"/>
                            </Grid>
                            <Border BorderBrush="{DynamicResource SteelPaneLineBrush}" BorderThickness="0,1,0,0" Padding="18,12,16,12">
                                <TextBlock Style="{StaticResource DeviceSmall}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="{Binding Devices_DragAssignHint, Source={x:Static strings:Strings.Instance}}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </ui:PassiveScrollViewer>

                <ui:PassiveScrollViewer x:Name="PanelScroll" Grid.Column="1" Padding="0,0,36,36" VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled"
                                        AutomationProperties.AutomationId="Devices_PanelScroll"
                                        AutomationProperties.Name="{Binding SelectedDevice.DeviceName, TargetNullValue='', FallbackValue=''}">
                    <StackPanel x:Name="DevicePanel">
                        <Border x:Name="EmptyCard" Style="{StaticResource CardBorder}" Padding="20,18" Margin="0"
                                Visibility="{Binding HasSelectedDevice, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                            <TextBlock Style="{StaticResource DeviceSmall}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{Binding Devices_EmptyHint, Source={x:Static strings:Strings.Instance}}"/>
                        </Border>
                        <StackPanel x:Name="SelectedPanel"
                                    Visibility="{Binding HasSelectedDevice, Converter={StaticResource BoolToVisibilityConverter}}">

                            <!-- The device's own card: its picture on a
                                 stage, then its name and type, what PadForge
                                 says about it, its link and battery on
                                 tiles, and the virtual controllers that use
                                 it. -->
                            <Border x:Name="IdentityCard" Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,12">
                                <StackPanel>
                                    <!-- The stage: the device as a picture where
                                         PadForge has that controller's art, and
                                         its kind where it has none. It is lit
                                         from below in ember while a virtual
                                         controller uses the device, and the
                                         picture is gray while the device is not
                                         connected. The card's own corners round
                                         the stage's top. -->
                                    <Border x:Name="DeviceStage" Height="150" CornerRadius="11,11,0,0" ClipToBounds="True"
                                            Background="{DynamicResource SteelGroundBrush}"
                                            BorderBrush="{DynamicResource SteelPaneLineBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <!-- The light on the stage's floor. -->
                                            <Border x:Name="StageFloorLight" IsHitTestVisible="False">
                                                <Border.Background>
                                                    <RadialGradientBrush Center="0.5,1.08" GradientOrigin="0.5,1.08" RadiusX="0.64" RadiusY="0.62">
                                                        <GradientStop Color="#61FF6B2C" Offset="0"/>
                                                        <GradientStop Color="#00FF6B2C" Offset="0.72"/>
                                                    </RadialGradientBrush>
                                                </Border.Background>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Opacity" Value="0"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding SelectedDevice.IsOnline}" Value="True"/>
                                                                    <Condition Binding="{Binding SelectedDevice.IsAssigned}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Opacity" Value="1"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <!-- A soft cool light behind the
                                                 picture, so a dark controller
                                                 stands out on the dark stage. -->
                                            <Border IsHitTestVisible="False">
                                                <Border.Background>
                                                    <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.58" RadiusY="0.62">
                                                        <GradientStop Color="#2996AACD" Offset="0"/>
                                                        <GradientStop Color="#0096AACD" Offset="0.72"/>
                                                    </RadialGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <!-- The picture: gray under, its own
                                                 colors over while the device is
                                                 connected. A controller looks the
                                                 same in every language, so the
                                                 picture never mirrors. It fades in
                                                 when it arrives: a still of the 3D
                                                 model is made a moment after the
                                                 device is picked. -->
                                            <Grid x:Name="StagePicture" Width="206" Height="115" FlowDirection="LeftToRight"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  controls:Appear.When="{Binding SelectedPicture}">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Opacity" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedDevice.IsOnline}" Value="False">
                                                                <Setter Property="Opacity" Value="0.52"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <controls:DecorativeImage Source="{Binding SelectedPictureGray}" Stretch="Uniform"
                                                                          RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <controls:DecorativeImage Source="{Binding SelectedPicture}" Stretch="Uniform"
                                                                          RenderOptions.BitmapScalingMode="HighQuality">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Opacity" Value="1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedDevice.IsOnline}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </controls:DecorativeImage>
                                            </Grid>
                                            <!-- A device with no picture of its
                                                 own shows its kind. -->
                                            <controls:GlyphText x:Name="StageKind" Text="{Binding SelectedDevice.KindGlyph}"
                                                                FontFamily="Segoe MDL2 Assets" FontSize="60"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                Visibility="{Binding ShowSelectedKind, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <controls:GlyphText.Style>
                                                    <Style TargetType="{x:Type controls:GlyphText}">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedDevice.IsOnline}" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource SteelMarkBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:GlyphText.Style>
                                            </controls:GlyphText>
                                        </Grid>
                                    </Border>

                                    <!-- The device: its name, its type, what
                                         PadForge says about it, its link and
                                         its battery, and the virtual controllers
                                         that use it. Test Rumble identifies it,
                                         so a row that only takes output keeps
                                         it. -->
                                    <StackPanel Margin="20,16,20,18">
                                        <TextBlock x:Name="DeviceNameHeading" TextWrapping="Wrap"
                                                   FontFamily="{StaticResource DisplayFontFamily}" FontSize="20" FontWeight="SemiBold"
                                                   LineHeight="29" LineStackingStrategy="BlockLineHeight"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   AutomationProperties.HeadingLevel="Level2"
                                                   Text="{Binding SelectedDevice.DeviceName}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="DeviceTypeLine" Style="{StaticResource DeviceSmall}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="{Binding SelectedDevice.DeviceType}"/>
                                            <ui:Button Grid.Column="1" x:Name="TestRumbleButton" MinHeight="30" Padding="11,0" FontSize="13"
                                                       CornerRadius="8" Margin="10,0,0,0" VerticalAlignment="Center"
                                                       Click="IdentifyDevice_Click"
                                                       Content="{Binding Pad_TestRumble, Source={x:Static strings:Strings.Instance}}"
                                                       ToolTip="{Binding Devices_IdentifyTooltip, Source={x:Static strings:Strings.Instance}}"
                                                       Visibility="{Binding SelectedDevice.HasRumble, Converter={StaticResource BoolToVisibilityConverter}}"
                                                       AutomationProperties.AutomationId="Devices_TestRumble">
                                                <ui:Button.Icon>
                                                    <controls:DecorativeStrokeIcon Data="{StaticResource SectionRumbleGeometry}" Size="14" StrokeWidth="1.8"/>
                                                </ui:Button.Icon>
                                            </ui:Button>
                                        </Grid>

                                        <!-- Bliss-Box port (#469): the controller in the
                                             port and the adapter's firmware. -->
                                        <TextBlock Style="{StaticResource DeviceNotice}" Text="{Binding SelectedDevice.BlissBoxLine}"
                                                   Visibility="{Binding SelectedDevice.BlissBoxLine, Converter={StaticResource StringToVisibility}}"/>
                                        <!-- Keyboard screen (#519): what draws this screen. -->
                                        <TextBlock Style="{StaticResource DeviceNotice}" Text="{Binding SelectedDevice.KeyboardScreenLine}"
                                                   Visibility="{Binding SelectedDevice.KeyboardScreenLine, Converter={StaticResource StringToVisibility}}"/>
                                        <!-- Novint Falcon (#521): how this Falcon runs. -->
                                        <TextBlock Style="{StaticResource DeviceNotice}" Text="{Binding SelectedDevice.FalconLine}"
                                                   Visibility="{Binding SelectedDevice.FalconLine, Converter={StaticResource StringToVisibility}}"/>
                                        <!-- Analog keyboard (#468): a Razer keyboard waiting
                                             for Razer Synapse says so on its own panel. -->
                                        <TextBlock Style="{StaticResource DeviceWarning}" Text="{Binding SelectedDevice.AnalogKeyboardLine}"
                                                   Visibility="{Binding SelectedDevice.AnalogKeyboardLine, Converter={StaticResource StringToVisibility}}"/>
                                        <!-- Vendor daemon notice (#343): the vendor's own
                                             tool keeps reacting to these buttons until it
                                             is stopped. -->
                                        <TextBlock Style="{StaticResource DeviceWarning}" Text="{Binding SelectedDevice.HandheldDaemonWarning}"
                                                   Visibility="{Binding SelectedDevice.HasHandheldDaemonWarning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <!-- Flydigi Space Station notice (#395): the
                                             service and SDL's Flydigi driver both drive
                                             the pad's vendor interface, and the pad
                                             re-enumerated in a loop while the service
                                             could reach it. -->
                                        <TextBlock Style="{StaticResource DeviceWarning}" Text="{Binding SelectedDevice.FlydigiServiceWarning}"
                                                   Visibility="{Binding SelectedDevice.HasFlydigiServiceWarning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <!-- The head tracker's source (#355), the game
                                             telemetry line (#531) and the chat line
                                             (#555). Each is bound to its text, not to the
                                             row's type: a peer's shared row of the kind
                                             has no local device to ask, so its text is
                                             empty and the line takes no room. -->
                                        <TextBlock Style="{StaticResource DeviceNotice}" common:LiveText.Polite="True" Text="{Binding HeadTrackerStatus}"
                                                   Visibility="{Binding HeadTrackerStatus, Converter={StaticResource StringToVisibility}}"/>
                                        <TextBlock Style="{StaticResource DeviceNotice}" common:LiveText.Polite="True" Text="{Binding GameTelemetryStatus}"
                                                   Visibility="{Binding GameTelemetryStatus, Converter={StaticResource StringToVisibility}}"/>
                                        <TextBlock Style="{StaticResource DeviceNotice}" common:LiveText.Polite="True" Text="{Binding TwitchChatStatus}"
                                                   Visibility="{Binding TwitchChatStatus, Converter={StaticResource StringToVisibility}}"/>
                                        <!-- Game mods (#529): what a DSX game mod sets on
                                             this controller, and the button that ends it.
                                             Both show only while a mod reaches it. -->
                                        <TextBlock Style="{StaticResource DeviceNotice}" Text="{Binding SelectedDevice.GameModLine}"
                                                   Visibility="{Binding SelectedDevice.GameModLine, Converter={StaticResource StringToVisibility}}"/>
                                        <Button Content="{Binding Devices_ClearModEffects, Source={x:Static strings:Strings.Instance}}"
                                                Style="{StaticResource DeviceButton}" Margin="0,8,0,0" HorizontalAlignment="Left"
                                                Click="ClearModEffects_Click"
                                                ToolTip="{Binding Devices_ClearModEffects_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                Visibility="{Binding SelectedDevice.GameModLine, Converter={StaticResource StringToVisibility}}"/>

                                        <!-- The link and the battery, each on a tile,
                                             where the device has one to show. The
                                             battery's tile has a gold edge while the
                                             charge is low. -->
                                        <UniformGrid x:Name="DeviceTiles" Columns="2" Margin="-5,12,-5,0"
                                                     Visibility="{Binding SelectedDevice.HasLinkOrBattery, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border x:Name="LinkTile" Style="{StaticResource DeviceTile}"
                                                    Visibility="{Binding SelectedDevice.HasLink, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource DeviceLabel}"
                                                               Text="{Binding Devices_Detail_Link, Source={x:Static strings:Strings.Instance}}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <controls:DecorativeStrokeIcon Data="{StaticResource BluetoothLineGeometry}" Size="15" StrokeWidth="2"
                                                                                       Foreground="{DynamicResource ColdBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding SelectedDevice.LinkText}" Margin="8,0,0,0" FontSize="14" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="BatteryTile"
                                                    Visibility="{Binding SelectedDevice.HasBattery, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource DeviceTile}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedDevice.BatteryLow}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource WaitRingBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource DeviceLabel}"
                                                               Text="{Binding Devices_Detail_Battery, Source={x:Static strings:Strings.Instance}}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <controls:BatteryMeter Height="14" Percent="{Binding SelectedDevice.BatteryPercent}"
                                                                               Charging="{Binding SelectedDevice.BatteryCharging}" Low="{Binding SelectedDevice.BatteryLow}"
                                                                               Ground="{DynamicResource SteelGroundBrush}"/>
                                                        <TextBlock Text="{Binding SelectedDevice.BatteryText}" Margin="8,0,0,0"
                                                                   FontFamily="{StaticResource TelemetryFontFamily}" FontSize="16" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   AutomationProperties.Name="{Binding SelectedDevice.BatterySpoken, Mode=OneWay, TargetNullValue='', FallbackValue=''}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ColdBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedDevice.BatteryLow}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource WaitBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Pad_Battery_Low, Source={x:Static strings:Strings.Instance}}" Margin="8,0,0,0"
                                                                   FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource WaitBrush}"
                                                                   Visibility="{Binding SelectedDevice.BatteryLow, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <!-- Used By: the virtual controllers, each a chip
                                             that puts the device on it or takes it off,
                                             then New Controller while a slot is free.
                                             The label leads the chips on their line. The
                                             chips come from code (UsedByContainer), since
                                             a CollectionContainer is outside the tree. -->
                                        <ItemsControl x:Name="UsedByChips" Margin="0,14,0,-8" Focusable="False"
                                                      AutomationProperties.Name="{Binding Devices_UsedBy, Source={x:Static strings:Strings.Instance}}">
                                            <ItemsControl.ItemsSource>
                                                <CompositeCollection>
                                                    <TextBlock x:Name="UsedByLabel" Style="{StaticResource DeviceLabel}" Margin="0,0,10,8" MinHeight="26"
                                                               Padding="0,5,0,0"
                                                               Text="{Binding Devices_UsedBy, Source={x:Static strings:Strings.Instance}}"/>
                                                    <CollectionContainer x:Name="UsedByContainer"/>
                                                    <!-- The button stands in a holder: an item
                                                         that is its own container reads as a
                                                         data item with no way to invoke it, and
                                                         held, it reads as the button it is (as
                                                         Home's Add Controller tile does). -->
                                                    <Grid Visibility="{Binding CanAddController, Converter={StaticResource BoolToVisibilityConverter}}"
                                                          AutomationProperties.Name="{Binding Devices_UsedBy_New, Source={x:Static strings:Strings.Instance}}">
                                                        <Button x:Name="NewControllerChip" Style="{StaticResource NewControllerChip}" Margin="0,0,8,8"
                                                                Click="NewController_Click"
                                                                Content="{Binding Devices_UsedBy_New, Source={x:Static strings:Strings.Instance}}"
                                                                AutomationProperties.AutomationId="Devices_UsedBy_New"/>
                                                    </Grid>
                                                </CompositeCollection>
                                            </ItemsControl.ItemsSource>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.Resources>
                                                <!-- Typed rather than an ItemTemplate: the
                                                     CompositeCollection mixes the chips with
                                                     the label and a button, as Home's
                                                     controller cards mix with its Add
                                                     Controller tile. -->
                                                <DataTemplate DataType="{x:Type vm:SlotButtonItem}">
                                                    <ToggleButton Style="{StaticResource UsedByChip}" Margin="0,0,8,8"
                                                                  IsChecked="{Binding IsAssigned, Mode=OneWay}"
                                                                  Command="{Binding DataContext.ToggleSlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                  CommandParameter="{Binding PadIndex}"
                                                                  ToolTip="{Binding Devices_ToggleAssignment, Source={x:Static strings:Strings.Instance}}"
                                                                  AutomationProperties.Name="{Binding Label, TargetNullValue='', FallbackValue=''}"
                                                                  AutomationProperties.AutomationId="{Binding SlotNumber, StringFormat='Devices_UsedBy_{0}'}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Grid Width="13" Height="13" VerticalAlignment="Center">
                                                                <Path FlowDirection="LeftToRight" Data="{Binding TypeGeometry, Mode=OneWay}" Stretch="Uniform"
                                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                                <controls:GlyphText Text="{Binding TypeGlyph, Mode=OneWay}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                    Visibility="{Binding TypeGlyph, Converter={StaticResource StringToVisibility}}"/>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Label, Mode=OneWay}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </ToggleButton>
                                                </DataTemplate>
                                            </ItemsControl.Resources>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Test Inputs, before the settings: what the
                                 device sends is the first thing to check. A
                                 device in SDL's gamepad layout
                                 shows its sticks, triggers and held buttons,
                                 and its full readout opens under More. Every
                                 other device's card is its full readout
                                 (DevicesPage.PlaceRawView). A stick's dot
                                 moves in its ring's own square, as a raw
                                 position does in the controller page's stick
                                 picture: a full push along one axis puts the
                                 dot against the ring, and the corner of a
                                 square gate past it. -->
                            <Border x:Name="TestCard" Style="{StaticResource CardBorder}" Padding="20,14,12,12" Margin="0,0,0,12"
                                    Visibility="{Binding ShowTestCard, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" FontSize="15" Margin="0,0,0,4"
                                               LineHeight="21.75" LineStackingStrategy="BlockLineHeight"
                                               Text="{Binding Devices_RawInputState, Source={x:Static strings:Strings.Instance}}"/>
                                    <StackPanel x:Name="GamepadTest" Margin="0,8,8,4"
                                                Visibility="{Binding ShowGamepadTest, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <controls:FlexLinePanel Gap="16" LineGap="14">
                                        <!-- A ring is a drawing, which UI Automation
                                             does not see. Each stands in a picture that
                                             reads the stick's name and where the stick
                                             is, as the readout under More gives each
                                             axis: half is the middle, and Y grows down
                                             the page. A cross and a half-way ring mark
                                             the middle, and a line runs from it to the
                                             dot. -->
                                        <controls:NamedPicture VerticalAlignment="Center"
                                                               AutomationProperties.Name="{Binding Stick_LeftThumbstick, Source={x:Static strings:Strings.Instance}}">
                                            <AutomationProperties.HelpText>
                                                <MultiBinding StringFormat="X {0:P0}, Y {1:P0}">
                                                    <Binding Path="TestLeftX"/>
                                                    <Binding Path="TestLeftY"/>
                                                </MultiBinding>
                                            </AutomationProperties.HelpText>
                                        <Grid Width="84" Height="84" FlowDirection="LeftToRight" VerticalAlignment="Center">
                                            <Ellipse Width="80" Height="80" Fill="{DynamicResource SteelGroundBrush}"
                                                     Stroke="{DynamicResource SteelPillLineBrush}" StrokeThickness="1.5"/>
                                            <Path Width="80" Height="80" Stroke="{DynamicResource SteelLineSoftBrush}" StrokeThickness="1"
                                                  Data="M40,4 V76 M4,40 H76 M60,40 A20,20 0 1 1 20,40 A20,20 0 1 1 60,40"/>
                                            <Canvas Width="80" Height="80">
                                                <Line X1="40" Y1="40" Stroke="{DynamicResource ColdBrush}" StrokeThickness="1.5" Opacity="0.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      X2="{Binding TestLeftX, Converter={StaticResource NormToCanvasConverter}, ConverterParameter='80,0'}"
                                                      Y2="{Binding TestLeftY, Converter={StaticResource NormToCanvasConverter}, ConverterParameter='80,0'}"/>
                                                <Ellipse Width="12" Height="12" Fill="{DynamicResource ColdBrush}"
                                                         Canvas.Left="{Binding TestLeftX, Converter={StaticResource NormToCanvasConverter}, ConverterParameter='80,12'}"
                                                         Canvas.Top="{Binding TestLeftY, Converter={StaticResource NormToCanvasConverter}, ConverterParameter='80,12'}"/>
                                            </Canvas>
                                        </Grid>
                                        </controls:NamedPicture>
                                        <controls:NamedPicture VerticalAlignment="Center"
                                                               AutomationProperties.Name="{Binding Stick_RightThumbstick, Source={x:Static strings:Strings.Instance}}">
                                            <AutomationProperties.HelpText>
                                                <MultiBinding StringFormat="X {0:P0}, Y {1:P0}">
                                                    <Binding Path="TestRightX"/>
                                                    <Binding Path="TestRightY"/>
                                                </MultiBinding>
                                            </AutomationProperties.HelpText>
                                        <Grid Width="84" Height="84" FlowDirection="LeftToRight" VerticalAlignment="Center">
                                            <Ellipse Width="80" Height="80" Fill="{DynamicResource SteelGroundBrush}"
                                                     Stroke="{DynamicResource SteelPillLineBrush}" StrokeThickness="1.5"/>
                                            <Path Width="80" Height="80" Stroke="{DynamicResource SteelLineSoftBrush}" StrokeThickness="1"
                                                  Data="M40,4 V76 M4,40 H76 M60,40 A20,20 0 1 1 20,40 A20,20 0 1 1 60,40"/>
                                            <Canvas Width="80" Height="80">
                                                <Line X1="40" Y1="40" Stroke="{DynamicResource ColdBrush}" StrokeThickness="1.5" Opacity="0.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      X2="{Binding TestRightX, Converter={StaticResource NormToCanvasConverter}, ConverterParameter='80,0'}"
                                                      Y2="{Binding TestRightY, Converter={StaticResource NormToCanvasConverter}, ConverterParameter='80,0'}"/>
                                                <Ellipse Width="12" Height="12" Fill="{DynamicResource ColdBrush}"
                                                         Canvas.Left="{Binding TestRightX, Converter={StaticResource NormToCanvasConverter}, ConverterParameter='80,12'}"
                                                         Canvas.Top="{Binding TestRightY, Converter={StaticResource NormToCanvasConverter}, ConverterParameter='80,12'}"/>
                                            </Canvas>
                                        </Grid>
                                        </controls:NamedPicture>
                                        <!-- The triggers: a bar and how far each is
                                             pulled, in cold blue while it is pulled
                                             at all. -->
                                        <StackPanel controls:FlexLinePanel.Basis="130" controls:FlexLinePanel.Grow="1" VerticalAlignment="Center">
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="42"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="LT" Style="{StaticResource DeviceLabel}"/>
                                                <ProgressBar Grid.Column="1" Style="{StaticResource ActivityBar}" Foreground="{DynamicResource ColdBrush}"
                                                             Maximum="1" Value="{Binding TestLeftTrigger, Mode=OneWay}" VerticalAlignment="Center"
                                                             AutomationProperties.Name="{Binding Btn_LeftTrigger, Source={x:Static strings:Strings.Instance}}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding TestLeftTrigger, StringFormat={}{0:P0}}" TextAlignment="Right"
                                                           FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource ColdBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TestLeftTrigger}" Value="0">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="42"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="RT" Style="{StaticResource DeviceLabel}"/>
                                                <ProgressBar Grid.Column="1" Style="{StaticResource ActivityBar}" Foreground="{DynamicResource ColdBrush}"
                                                             Maximum="1" Value="{Binding TestRightTrigger, Mode=OneWay}" VerticalAlignment="Center"
                                                             AutomationProperties.Name="{Binding Btn_RightTrigger, Source={x:Static strings:Strings.Instance}}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding TestRightTrigger, StringFormat={}{0:P0}}" TextAlignment="Right"
                                                           FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource ColdBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TestRightTrigger}" Value="0">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </StackPanel>
                                        </controls:FlexLinePanel>
                                        <!-- The buttons held now, each on a chip, or
                                             the word None. The line's lead and tail
                                             are its format around the names. -->
                                        <WrapPanel x:Name="PressedLine" Margin="0,14,0,0">
                                            <TextBlock Style="{StaticResource DeviceLabel}" Margin="0,0,6,6" Text="{Binding TestPressedLead}"/>
                                            <ItemsControl ItemsSource="{Binding TestPressed}" Focusable="False" IsTabStop="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="8,2" CornerRadius="6" Margin="0,0,6,6" BorderThickness="1"
                                                                Background="{DynamicResource ColdTintBrush}" BorderBrush="{DynamicResource ColdMutedBrush}">
                                                            <TextBlock Text="{Binding}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12"
                                                                       Foreground="{DynamicResource ColdBrush}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Margin="0,0,6,6" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="{Binding Common_None, Source={x:Static strings:Strings.Instance}}"
                                                       Visibility="{Binding NothingPressed, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <TextBlock Style="{StaticResource DeviceLabel}" Margin="0,0,0,6" Text="{Binding TestPressedTail}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                    <Border x:Name="RawPlainHost">
                                        <!-- The full readout. PlaceRawView moves it
                                             under More for a gamepad, and its names
                                             stay the page's fields, so the dot
                                             updaters and the MIDI previews keep
                                             working wherever it stands. -->
                                        <StackPanel x:Name="RawFullView" Margin="0,6,8,0">
                                            <!-- Novint Falcon (#521): the handle as a dot in its
                                                 Left/Right and Up/Down square. In/Out and the four
                                                 buttons follow in the named axes and the grid. -->
                                            <StackPanel Visibility="{Binding IsFalconDevice, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Devices_FalconHandle, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource RawSectionLabel}"/>
                                                <Border x:Name="FalconPreviewBorder"
                                                        Background="{DynamicResource SteelFieldBrush}" BorderBrush="{DynamicResource SteelLineBrush}"
                                                        BorderThickness="1" CornerRadius="6"
                                                        Width="100" Height="100" HorizontalAlignment="Left" ClipToBounds="True"
                                                        SizeChanged="FalconPreviewBorder_SizeChanged">
                                                    <Canvas FlowDirection="LeftToRight">
                                                        <Ellipse x:Name="FalconDot" Width="14" Height="14" Fill="#CCFF6600"/>
                                                    </Canvas>
                                                </Border>
                                            </StackPanel>

                                            <!-- Axes label (joysticks/gamepads only) -->
                                            <TextBlock Text="{Binding Devices_Axes, Source={x:Static strings:Strings.Instance}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RawSectionLabel}">
                                                        <Setter Property="Visibility" Value="{Binding HasRawData, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsKeyboardDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMouseDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsTouchpadDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMidiDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsAnalogKeyboardDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsNfcDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMicrophoneDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsConsumerDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsHeadsetMotionDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ShowNamedButtons}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSystemMotionDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- Axes: progress bars (joysticks/gamepads only) -->
                                            <ItemsControl ItemsSource="{Binding RawAxes}" Margin="0,0,0,8">
                                                <ItemsControl.Style>
                                                    <Style TargetType="ItemsControl" BasedOn="{StaticResource {x:Type ItemsControl}}">
                                                        <Setter Property="Focusable" Value="False"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsKeyboardDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMouseDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsTouchpadDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMidiDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsAnalogKeyboardDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsNfcDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMicrophoneDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsConsumerDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsHeadsetMotionDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ShowNamedButtons}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSystemMotionDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.Style>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="56"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="52"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                            <!-- Cold (#175): the raw value on the shared live bar. -->
                                                            <ProgressBar Grid.Column="1" Minimum="0" Maximum="1"
                                                                         AutomationProperties.Name="{Binding Name, TargetNullValue='', FallbackValue=''}"
                                                                         Value="{Binding NormalizedValue, Mode=OneWay}"
                                                                         Style="{StaticResource ActivityBar}"
                                                                         Foreground="{DynamicResource ColdBrush}"
                                                                         Margin="4,0"/>
                                                            <TextBlock Grid.Column="2" FontSize="13" Foreground="{DynamicResource ColdBrush}"
                                                                       FontFamily="{StaticResource TelemetryFontFamily}" VerticalAlignment="Center"
                                                                       HorizontalAlignment="Right"
                                                                       Text="{Binding RawValue}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Buttons label and grid: shown for any device that exposes
                                                 button slots (gamepads, joysticks, touchpads with a
                                                 click button). Keyboards / mice have their own
                                                 dedicated visual previews instead. -->
                                            <TextBlock Text="{Binding Devices_Buttons, Source={x:Static strings:Strings.Instance}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RawSectionLabel}">
                                                        <Setter Property="Visibility" Value="{Binding HasRawData, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsKeyboardDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMouseDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMidiDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsAnalogKeyboardDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsNfcDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMicrophoneDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsConsumerDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsHeadsetMotionDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ShowNamedButtons}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSystemMotionDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsHeadTrackerDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding RawButtons}" Margin="0,0,0,8">
                                                <ItemsControl.Style>
                                                    <Style TargetType="ItemsControl" BasedOn="{StaticResource {x:Type ItemsControl}}">
                                                        <Setter Property="Focusable" Value="False"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsKeyboardDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMouseDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMidiDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsAnalogKeyboardDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsNfcDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMicrophoneDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsConsumerDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsHeadsetMotionDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ShowNamedButtons}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSystemMotionDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsHeadTrackerDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.Style>
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- ToolTip is object-typed, so a StringFormat on the
                                                             attribute form is IGNORED and the tooltip rendered the
                                                             bare number. Hosting a TextBlock puts the format on a
                                                             string target where it applies, and lets the word come
                                                             from resources instead of a hardcoded English literal
                                                             (round 34). -->
                                                        <Border Width="24" Height="24" CornerRadius="12" Margin="1"
                                                                Style="{StaticResource RawCellBorder}">
                                                            <Border.ToolTip>
                                                                <TextBlock>
                                                                    <Run Text="{Binding Pad_Shift_KindButton, Source={x:Static strings:Strings.Instance}, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding DisplayNumber, Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </Border.ToolTip>
                                                            <TextBlock Text="{Binding DisplayNumber}" FontSize="12"
                                                                       Style="{StaticResource RawCellLabel}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- NFC: named tag list (issue #150). Shown for NFC readers in
                                                 place of the numbered button grid. Each registered tag (and
                                                 "Any NFC Tag") lights up when its tag is tapped. -->
                                            <StackPanel Visibility="{Binding IsNfcDevice, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Nfc_Title, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource RawSectionLabel}"/>
                                                <ItemsControl ItemsSource="{Binding NfcTags}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="4" Margin="0,1" Padding="8,5"
                                                                    Style="{StaticResource RawCellBorderActive}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource ColdBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Uid}" FontFamily="{StaticResource TelemetryFontFamily}"
                                                                               FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"
                                                                               Margin="8,0,0,0"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- Consumer Control: named button chips (issue #168). Shown for
                                                 consumer collections in place of the numbered grid and the
                                                 empty axes section. Each canonical button ("Play/Pause",
                                                 "Voice Command", the OK button) lights while held. -->
                                            <StackPanel Visibility="{Binding IsConsumerDevice, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Devices_Buttons, Source={x:Static strings:Strings.Instance}}"
                                                           Style="{StaticResource RawSectionLabel}"/>
                                                <ItemsControl ItemsSource="{Binding ConsumerButtons}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="4" Margin="2" Padding="8,4"
                                                                    Style="{StaticResource RawCellBorder}">
                                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                                           Style="{StaticResource RawCellLabel}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- Analog keyboard (issue #468): a chip per key the keyboard has
                                                 reported since it was selected, lit while down, with its
                                                 depth as a bar and a percent. Replaces the axes and the
                                                 numbered grid, which an analog keyboard does not use. -->
                                            <StackPanel Visibility="{Binding IsAnalogKeyboardDevice, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Devices_AnalogKeys, Source={x:Static strings:Strings.Instance}}"
                                                           Style="{StaticResource RawSectionLabel}"/>
                                                <TextBlock Text="{Binding Devices_AnalogKeysHint, Source={x:Static strings:Strings.Instance}}"
                                                           FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Visibility="{Binding HasAnalogKeys, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                                <ItemsControl ItemsSource="{Binding AnalogKeys}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="4" Margin="2" Padding="6,4" Width="84"
                                                                    Style="{StaticResource RawCellBorder}">
                                                                <StackPanel>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                                   Style="{StaticResource RawCellLabel}" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding DepthText}" FontSize="12" Margin="4,0,0,0"
                                                                                   FontFamily="{StaticResource TelemetryFontFamily}" VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource ColdBrush}"/>
                                                                    </Grid>
                                                                    <ProgressBar Minimum="0" Maximum="1" Margin="0,3,0,0"
                                                                                 AutomationProperties.Name="{Binding Name, TargetNullValue='', FallbackValue=''}"
                                                                                 Value="{Binding Depth, Mode=OneWay}"
                                                                                 Style="{StaticResource ActivityBar}"
                                                                                 Foreground="{DynamicResource ColdBrush}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- DualShock 2 in a Bliss-Box port (issue #469): its twelve
                                                 pressure buttons as chips, the key depth chips' parts,
                                                 each with its pressure as a bar and a percent. The name
                                                 has the chip's first line to itself: German "Steuerkreuz
                                                 Rechts" is 116 DIP in Cascadia Code at 11 px, about 127
                                                 at 12, and with the percent beside it all four German
                                                 D-pad chips trimmed to the same "Steuerkreuz …". A chip
                                                 142 wide holds it inside its padding and its edge. -->
                                            <StackPanel Visibility="{Binding HasBlissBoxPressure, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Devices_BlissBoxPressure, Source={x:Static strings:Strings.Instance}}"
                                                           Style="{StaticResource RawSectionLabel}"/>
                                                <ItemsControl ItemsSource="{Binding BlissBoxPressure}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="4" Margin="2" Padding="6,4" Width="142"
                                                                    Style="{StaticResource RawCellBorder}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                               Style="{StaticResource RawCellLabel}"/>
                                                                    <Grid Margin="0,2,0,0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <ProgressBar Minimum="0" Maximum="1" VerticalAlignment="Center"
                                                                                     AutomationProperties.Name="{Binding Name, TargetNullValue='', FallbackValue=''}"
                                                                                     Value="{Binding Depth, Mode=OneWay}"
                                                                                     Style="{StaticResource ActivityBar}"
                                                                                     Foreground="{DynamicResource ColdBrush}"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding DepthText}" FontSize="12" Margin="6,0,0,0"
                                                                                   FontFamily="{StaticResource TelemetryFontFamily}" VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource ColdBrush}"/>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- Keyboard: visual QWERTY layout -->
                                            <TextBlock Text="{Binding Devices_Keyboard, Source={x:Static strings:Strings.Instance}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RawSectionLabel}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsKeyboardDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Viewbox Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,8"
                                                     StretchDirection="DownOnly">
                                                <Viewbox.Style>
                                                    <Style TargetType="Viewbox">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsKeyboardDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Viewbox.Style>
                                                <ItemsControl ItemsSource="{Binding KeyboardKeys}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas FlowDirection="LeftToRight" Width="556" Height="136"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="{Binding KeyWidth}" Height="{Binding KeyHeight}"
                                                                    CornerRadius="3"
                                                                    Style="{StaticResource RawCellBorder}"
                                                                    ToolTip="{Binding Label}">
                                                                <TextBlock Text="{Binding Label}" FontSize="8"
                                                                           Style="{StaticResource RawCellLabel}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="None"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Viewbox>

                                            <!-- Mouse: visual mouse graphic -->
                                            <TextBlock Text="{Binding Devices_Mouse, Source={x:Static strings:Strings.Instance}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RawSectionLabel}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Viewbox Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,8"
                                                     StretchDirection="DownOnly" MaxHeight="280">
                                                <Viewbox.Style>
                                                    <Style TargetType="Viewbox">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Viewbox.Style>
                                                <!-- A drawing of the mouse: it reads as one
                                                     picture with the label's word. -->
                                                <controls:NamedPicture AutomationProperties.Name="{Binding Devices_Mouse, Source={x:Static strings:Strings.Instance}}">
                                                    <local:MousePreviewControl/>
                                                </controls:NamedPicture>
                                            </Viewbox>

                                            <!-- MIDI: same piano + CC visual as the Pad page MIDI
                                                 preview, full 0-127 range (issue #128). Notes and
                                                 CCs are separate previews so their section titles
                                                 are normal-size headers OUTSIDE the scaling Viewbox.
                                                 BindInput is wired in code-behind on selection. -->
                                            <StackPanel Margin="0,0,0,8">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMidiDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <TextBlock Text="{Binding Preview_NoteOutputs, Source={x:Static strings:Strings.Instance}}"
                                                           Style="{StaticResource RawSectionLabel}"/>
                                                <local:MidiPreviewView x:Name="MidiNotesPreview" Height="230" Margin="0,0,0,12"
                                                                       AutomationProperties.Name="{Binding Preview_NoteOutputs, Source={x:Static strings:Strings.Instance}}"
                                                                       HorizontalAlignment="Stretch"/>

                                                <TextBlock Text="{Binding Preview_CCOutputs, Source={x:Static strings:Strings.Instance}}"
                                                           Style="{StaticResource RawSectionLabel}"/>
                                                <local:MidiPreviewView x:Name="MidiCcPreview" Height="230"
                                                                       AutomationProperties.Name="{Binding Preview_CCOutputs, Source={x:Static strings:Strings.Instance}}"
                                                                       HorizontalAlignment="Stretch"/>
                                            </StackPanel>

                                            <!-- POV Hats: compass indicators -->
                                            <TextBlock Text="{Binding Devices_DPadPOV, Source={x:Static strings:Strings.Instance}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RawSectionLabel}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RawPovs.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding RawPovs}" Margin="0,0,0,8">
                                                <!-- Wraps. Measured with tools/rowmeasure, four hats
                                                     need 321 against the 298 the pane leaves for
                                                     them, so a fourth hat ran past the edge. -->
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                                            <Canvas FlowDirection="LeftToRight" Width="36" Height="36">
                                                                <!-- Background circle -->
                                                                <Ellipse Width="36" Height="36"
                                                                         Fill="{DynamicResource SteelFieldBrush}" Stroke="{DynamicResource SteelLineBrush}"
                                                                         StrokeThickness="1"/>
                                                                <!-- Center dot -->
                                                                <Ellipse Width="4" Height="4" Canvas.Left="16" Canvas.Top="16"
                                                                         Fill="{DynamicResource SteelLineBrush}"/>
                                                                <!-- Direction indicator line -->
                                                                <Line X1="18" Y1="18" X2="18" Y2="5"
                                                                      Stroke="{DynamicResource ColdBrush}"
                                                                      StrokeThickness="2.5" StrokeEndLineCap="Round">
                                                                    <Line.Style>
                                                                        <Style TargetType="Line">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCentered}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Line.Style>
                                                                    <Line.RenderTransform>
                                                                        <RotateTransform Angle="{Binding AngleDegrees}"
                                                                                         CenterX="18" CenterY="18"/>
                                                                    </Line.RenderTransform>
                                                                </Line>
                                                            </Canvas>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                                                <TextBlock FontSize="12" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Devices_POV, Source={x:Static strings:Strings.Instance}}"/>
                                                                <TextBlock FontSize="12" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Index, Mode=OneWay}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Gyroscope -->
                                            <TextBlock Text="{Binding Devices_Gyroscope, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource RawSectionLabel}"
                                                       Visibility="{Binding HasGyroData, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Border Visibility="{Binding HasGyroData, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Background="{DynamicResource SteelFieldBrush}" BorderBrush="{DynamicResource SteelLineBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="X" FontSize="12" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                                        <TextBlock FontSize="13" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}" HorizontalAlignment="Center"
                                                                   Text="{Binding GyroX, StringFormat='{}{0:F3}'}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Y" FontSize="12" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                                        <TextBlock FontSize="13" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}" HorizontalAlignment="Center"
                                                                   Text="{Binding GyroY, StringFormat='{}{0:F3}'}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Z" FontSize="12" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                                        <TextBlock FontSize="13" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}" HorizontalAlignment="Center"
                                                                   Text="{Binding GyroZ, StringFormat='{}{0:F3}'}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Accelerometer -->
                                            <TextBlock Text="{Binding Devices_Accelerometer, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource RawSectionLabel}"
                                                       Visibility="{Binding HasAccelData, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Border Visibility="{Binding HasAccelData, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Background="{DynamicResource SteelFieldBrush}" BorderBrush="{DynamicResource SteelLineBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="X" FontSize="12" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                                        <TextBlock FontSize="13" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}" HorizontalAlignment="Center"
                                                                   Text="{Binding AccelX, StringFormat='{}{0:F3}'}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Y" FontSize="12" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                                        <TextBlock FontSize="13" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}" HorizontalAlignment="Center"
                                                                   Text="{Binding AccelY, StringFormat='{}{0:F3}'}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Z" FontSize="12" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                                        <TextBlock FontSize="13" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}" HorizontalAlignment="Center"
                                                                   Text="{Binding AccelZ, StringFormat='{}{0:F3}'}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Aux accelerometer (#199): the Nunchuk's own sensor /
                                                 the left Joy-Con of a combined pair. -->
                                            <TextBlock Text="{Binding Devices_AccelAux, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource RawSectionLabel}"
                                                       Visibility="{Binding HasAccelAuxData, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Border Visibility="{Binding HasAccelAuxData, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Background="{DynamicResource SteelFieldBrush}" BorderBrush="{DynamicResource SteelLineBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="X" FontSize="12" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                                        <TextBlock FontSize="13" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}" HorizontalAlignment="Center"
                                                                   Text="{Binding AccelAuxX, StringFormat='{}{0:F3}'}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Y" FontSize="12" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                                        <TextBlock FontSize="13" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}" HorizontalAlignment="Center"
                                                                   Text="{Binding AccelAuxY, StringFormat='{}{0:F3}'}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Z" FontSize="12" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                                        <TextBlock FontSize="13" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}" HorizontalAlignment="Center"
                                                                   Text="{Binding AccelAuxZ, StringFormat='{}{0:F3}'}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Aux gyro preview (#252): the left Joy-Con of a
                                                 combined pair. Sits beside the aux accel so the
                                                 two halves' readouts read together. -->
                                            <TextBlock Text="{Binding Devices_GyroAux, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource RawSectionLabel}"
                                                       Visibility="{Binding HasGyroAuxData, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Border Visibility="{Binding HasGyroAuxData, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Background="{DynamicResource SteelFieldBrush}" BorderBrush="{DynamicResource SteelLineBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="X" FontSize="12" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                                        <TextBlock FontSize="13" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}" HorizontalAlignment="Center"
                                                                   Text="{Binding GyroAuxX, StringFormat='{}{0:F3}'}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Y" FontSize="12" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                                        <TextBlock FontSize="13" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}" HorizontalAlignment="Center"
                                                                   Text="{Binding GyroAuxY, StringFormat='{}{0:F3}'}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Z" FontSize="12" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                                        <TextBlock FontSize="13" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}" HorizontalAlignment="Center"
                                                                   Text="{Binding GyroAuxZ, StringFormat='{}{0:F3}'}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Touchpad preview -->
                                            <TextBlock Text="{Binding TouchpadLabel}"
                                                       Style="{StaticResource RawSectionLabel}"
                                                       Visibility="{Binding HasTouchpadData, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Border x:Name="TouchpadPreviewBorder"
                                                    Visibility="{Binding HasTouchpadData, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Background="{DynamicResource SteelFieldBrush}" BorderBrush="{DynamicResource SteelLineBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6" Margin="0,0,0,8"
                                                    Height="100" ClipToBounds="True">
                                                <Canvas FlowDirection="LeftToRight">
                                                    <!-- Up to 5 touchpad contacts at once. An
                                                         SDL gamepad's touchpad reports 1 or 2,
                                                         and a Windows precision touchpad up to
                                                         5. Each dot's visibility binds to its
                                                         own TouchpadDownN flag, so the slots a
                                                         device does not report stay hidden. -->
                                                    <Ellipse x:Name="TouchpadDot0" Width="14" Height="14" Fill="#CCFF6600"
                                                             Visibility="{Binding TouchpadDown0, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <Ellipse x:Name="TouchpadDot1" Width="14" Height="14" Fill="#CC0066FF"
                                                             Visibility="{Binding TouchpadDown1, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <Ellipse x:Name="TouchpadDot2" Width="14" Height="14" Fill="#CC4CAF50"
                                                             Visibility="{Binding TouchpadDown2, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <Ellipse x:Name="TouchpadDot3" Width="14" Height="14" Fill="#CCBA68C8"
                                                             Visibility="{Binding TouchpadDown3, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <Ellipse x:Name="TouchpadDot4" Width="14" Height="14" Fill="#CCFFEB3B"
                                                             Visibility="{Binding TouchpadDown4, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </Canvas>
                                            </Border>

                                            <!-- The second touchpad, shown only for a device with more
                                                 than one (Steam Controller 2026, Steam Deck, the original
                                                 Steam Controller). -->
                                            <TextBlock Text="{Binding Touchpad2Label}"
                                                       Style="{StaticResource RawSectionLabel}"
                                                       Visibility="{Binding HasSecondTouchpadData, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Border x:Name="Touchpad2PreviewBorder"
                                                    Visibility="{Binding HasSecondTouchpadData, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Background="{DynamicResource SteelFieldBrush}" BorderBrush="{DynamicResource SteelLineBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6" Margin="0,0,0,8"
                                                    Height="100" ClipToBounds="True">
                                                <Canvas FlowDirection="LeftToRight">
                                                    <Ellipse x:Name="Pad2Dot0" Width="14" Height="14" Fill="#CCFF6600"
                                                             Visibility="{Binding Pad2Down0, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <Ellipse x:Name="Pad2Dot1" Width="14" Height="14" Fill="#CC0066FF"
                                                             Visibility="{Binding Pad2Down1, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <Ellipse x:Name="Pad2Dot2" Width="14" Height="14" Fill="#CC4CAF50"
                                                             Visibility="{Binding Pad2Down2, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <Ellipse x:Name="Pad2Dot3" Width="14" Height="14" Fill="#CCBA68C8"
                                                             Visibility="{Binding Pad2Down3, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <Ellipse x:Name="Pad2Dot4" Width="14" Height="14" Fill="#CCFFEB3B"
                                                             Visibility="{Binding Pad2Down4, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </Canvas>
                                            </Border>

                                            <!-- Named buttons, in the NFC tag list's shape: a handheld's
                                                 learned hidden buttons (issue #343), and the named rows
                                                 of G-keys, VR controllers, keyboard screens, telemetry
                                                 and chat. Each row lights while its button is down. Only
                                                 a handheld's list is its hidden buttons, and only an
                                                 empty handheld list says nothing is learned yet. -->
                                            <StackPanel Visibility="{Binding ShowNamedButtons, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Margin="0,0,0,8">
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource RawSectionLabel}">
                                                            <Setter Property="Text" Value="{Binding Devices_Buttons, Source={x:Static strings:Strings.Instance}}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHandheldDevice}" Value="True">
                                                                    <Setter Property="Text" Value="{Binding Handheld_Title, Source={x:Static strings:Strings.Instance}}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Handheld_NoneLearned, Source={x:Static strings:Strings.Instance}}" FontSize="13"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsHandheldDevice}" Value="True"/>
                                                                        <Condition Binding="{Binding HandheldButtons.Count}" Value="0"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ItemsControl ItemsSource="{Binding HandheldButtons}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="4" Margin="0,1" Padding="8,5"
                                                                    Style="{StaticResource RawCellBorderActive}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource ColdBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Uid}" FontFamily="{StaticResource TelemetryFontFamily}"
                                                                               FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"
                                                                               Margin="8,0,0,0" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- Voice Macros (issue #317): named phrase rows, the voice twin
                                                 of the NFC Tags section. Shown for devices that carry the
                                                 phrases: microphone rows and Bluetooth DualSense pads. Each
                                                 row lights while its phrase button pulses. -->
                                            <StackPanel Visibility="{Binding ShowVoicePhrases, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Voice_Title, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource RawSectionLabel}"/>
                                                <ItemsControl ItemsSource="{Binding VoicePhrases}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="4" Margin="0,1" Padding="8,5"
                                                                    Style="{StaticResource RawCellBorderActive}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource ColdBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Uid}" FontFamily="{StaticResource TelemetryFontFamily}"
                                                                               FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"
                                                                               Margin="8,0,0,0"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <controls:MoreRow x:Name="TestMore" StateKey="Devices.TestInputs.More"
                                                      AutomationProperties.AutomationId="Devices_More_TestInputs"
                                                      Header="{Binding Common_More, Source={x:Static strings:Strings.Instance}}"
                                                      Hint="{Binding Devices_More_TestInputs, Source={x:Static strings:Strings.Instance}}"
                                                      Visibility="{Binding ShowGamepadTest, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Border x:Name="RawMoreHost"/>
                                    </controls:MoreRow>
                                </StackPanel>
                            </Border>

                            <!-- The device's own settings, in rows, then the
                                 device's tools. Reset All puts back what the
                                 card shows. Force Raw Joystick Mode is the
                                 Details card's. -->
                            <Border x:Name="SettingsCard" Style="{StaticResource CardBorder}" Padding="20,14,12,10" Margin="0,0,0,12"
                                    Visibility="{Binding ShowSettingsCard, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                        <TextBlock Style="{StaticResource CardTitle}" FontSize="15"
                                                   LineHeight="21.75" LineStackingStrategy="BlockLineHeight"
                                                   Text="{Binding Devices_SettingsCard, Source={x:Static strings:Strings.Instance}}"/>
                                        <ui:Button x:Name="ResetAllSettingsButton" Style="{StaticResource ResetAllButton}" Margin="12,0,0,0"
                                                   Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}"
                                                   Command="{Binding ResetSettingsCardCommand}"
                                                   Visibility="{Binding HasResettableSettings, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   AutomationProperties.AutomationId="Devices_ResetAll">
                                            <ui:Button.ToolTip>
                                                <MultiBinding Converter="{StaticResource FormatTextConverter}">
                                                    <Binding Path="Devices_SettingsCard" Source="{x:Static strings:Strings.Instance}"/>
                                                    <Binding Path="Pad_ResetSection_Format" Source="{x:Static strings:Strings.Instance}"/>
                                                </MultiBinding>
                                            </ui:Button.ToolTip>
                                        </ui:Button>
                                    </DockPanel>

                                    <!-- Input hiding. Each switch's Content is its
                                         plain label: a switch draws none, and
                                         HidingToggle_Click tells Hide from Games
                                         by it. -->
                                    <StackPanel x:Name="HidingRows"
                                                Visibility="{Binding SelectedDevice.ShowInputHidingSection, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <controls:SettingRow MinHeight="44"
                                                             Visibility="{Binding SelectedDevice.ShowHidHideToggle, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Style="{StaticResource DeviceRowLabel}"
                                                       Text="{Binding Devices_HideFromGames, Source={x:Static strings:Strings.Instance}}"/>
                                            <CheckBox Style="{StaticResource SwitchCheckBox}" Margin="0,0,10,0"
                                                      Content="{Binding Devices_HideFromGames, Source={x:Static strings:Strings.Instance}}"
                                                      IsChecked="{Binding SelectedDevice.HidHideEnabled, Mode=TwoWay}"
                                                      IsEnabled="{Binding SelectedDevice.IsHidHideAvailable}"
                                                      Click="HidingToggle_Click"
                                                      ToolTipService.ShowOnDisabled="True">
                                                <CheckBox.ToolTip>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding Devices_HideTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedDevice.IsTabletDevice}" Value="True">
                                                                        <Setter Property="Text" Value="{Binding Tablet_HideHelp, Source={x:Static strings:Strings.Instance}}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding SelectedDevice.IsHidHideAvailable}" Value="False">
                                                                        <Setter Property="Text" Value="{Binding Devices_HideTooltipInstall, Source={x:Static strings:Strings.Instance}}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </CheckBox.ToolTip>
                                            </CheckBox>
                                            <reset:SettingResetButton Command="{Binding ResetSelectedDeviceSettingCommand}" CommandParameter="HidHideEnabled" IsEnabled="{Binding SelectedDevice.IsHidHideAvailable}" SettingLabel="{Binding Devices_HideFromGames, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DeviceRowViewModel_HidHideEnabled_1024"/>
                                        </controls:SettingRow>
                                        <TextBlock Text="{Binding SelectedDevice.TabletInputStatus}" Style="{StaticResource DeviceSmall}" TextWrapping="Wrap" Margin="0,0,0,8"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Visibility="{Binding SelectedDevice.ShowTabletCaptureStatus, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <controls:SettingRow MinHeight="44" Visibility="{Binding Visibility, ElementName=ResetInput1054}">
                                            <TextBlock Style="{StaticResource DeviceRowLabel}"
                                                       Text="{Binding Devices_ConsumeMapped, Source={x:Static strings:Strings.Instance}}"
                                                       ToolTip="{Binding Devices_ConsumeTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <CheckBox x:Name="ResetInput1054" Margin="0,0,10,0"
                                                      Content="{Binding Devices_ConsumeMapped, Source={x:Static strings:Strings.Instance}}"
                                                      IsChecked="{Binding SelectedDevice.ConsumeInputEnabled, Mode=TwoWay}"
                                                      Click="HidingToggle_Click"
                                                      ToolTip="{Binding Devices_ConsumeTooltip, Source={x:Static strings:Strings.Instance}}">
                                                <CheckBox.Style>
                                                    <Style TargetType="CheckBox" BasedOn="{StaticResource SwitchCheckBox}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedDevice.ShowConsumeToggle}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </CheckBox.Style>
                                            </CheckBox>
                                            <reset:SettingResetButton Command="{Binding ResetSelectedDeviceSettingCommand}" CommandParameter="ConsumeInputEnabled" SettingLabel="{Binding Devices_ConsumeMapped, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DeviceRowViewModel_ConsumeInputEnabled_1054" Visibility="{Binding Visibility, ElementName=ResetInput1054}"/>
                                        </controls:SettingRow>
                                        <!-- A keyboard's or mouse's driver switch (#549)
                                             hides the whole device from Windows, so it
                                             stands with the two switches. A switched
                                             device shows neither switch, and its
                                             restore keeps the rows for itself
                                             (DeviceRowViewModel.ShowsHidingDriverSwitch).
                                             A precision touchpad's switch stands here
                                             too, on its own row and on its mouse row,
                                             and gives the touchpad back to Windows
                                             rather than restoring a driver. The line
                                             takes no room while neither shows. -->
                                        <controls:FlexLinePanel Gap="8" LineGap="8" Margin="0,4,0,8">
                                            <controls:FlexLinePanel.Style>
                                                <Style TargetType="{x:Type controls:FlexLinePanel}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowHidingDriverBind}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ShowHidingDriverRestore}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:FlexLinePanel.Style>
                                            <Button Content="{Binding DriverBindText}" Style="{StaticResource DeviceButton}"
                                                    Click="DriverBind_Click"
                                                    Visibility="{Binding ShowHidingDriverBind, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Button Content="{Binding DriverRestoreText}" Style="{StaticResource DeviceButton}"
                                                    Click="DriverRestore_Click"
                                                    Visibility="{Binding ShowHidingDriverRestore, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </controls:FlexLinePanel>
                                        <!-- The touchpad capture's line, as a tablet's
                                             row shows its own, while the switch is on. -->
                                        <TextBlock Text="{Binding SelectedDevice.TouchpadInputStatus}" Style="{StaticResource DeviceSmall}" TextWrapping="Wrap" Margin="0,0,0,8"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Visibility="{Binding SelectedDevice.ShowTouchpadCaptureStatus, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>

                                    <!-- Power (#162, wireless controllers only).
                                         The rows show while either control does,
                                         each on its own gate: the idle countdown
                                         needs a disconnect target, and Quick Charge
                                         (#372) also shows on a Sony record the USB
                                         cable rebound to its wired path, which is
                                         not a disconnect target and is exactly when
                                         the feature fires. -->
                                    <StackPanel x:Name="PowerRows"
                                                Visibility="{Binding SelectedDevice.ShowPowerSection, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <!-- The label and the unit share a narrow row
                                             as the board's does, and each wraps
                                             (DevicesPage.IdleUnitWidth). -->
                                        <controls:SettingRow x:Name="IdleRow" MinHeight="44" SizeChanged="IdleRow_SizeChanged"
                                                             Binding.TargetUpdated="IdleRow_TextUpdated"
                                                             Visibility="{Binding SelectedDevice.ShowIdleDisconnect, Converter={StaticResource BoolToVisibilityConverter}}"
                                                             ToolTip="{Binding Devices_IdleDisconnectTooltip, Source={x:Static strings:Strings.Instance}}">
                                            <TextBlock x:Name="IdleLabel" Style="{StaticResource DeviceRowLabel}"
                                                       Text="{Binding Devices_IdleDisconnect, Source={x:Static strings:Strings.Instance}, NotifyOnTargetUpdated=True}"/>
                                            <TextBox x:Name="IdleDisconnectBox" Style="{StaticResource DeviceNumberBox}"
                                                     Text="{Binding SelectedDevice.IdleDisconnectMinutes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     LostFocus="IdleDisconnect_LostFocus"/>
                                            <TextBlock x:Name="IdleUnitText" Margin="10,0,10,0" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center"
                                                       LineHeight="20.3" LineStackingStrategy="BlockLineHeight"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       Text="{Binding Devices_IdleDisconnectMinutes, Source={x:Static strings:Strings.Instance}, NotifyOnTargetUpdated=True}"/>
                                            <reset:SettingResetButton Command="{Binding ResetSelectedDeviceSettingCommand}" CommandParameter="IdleDisconnectMinutes" SettingLabel="{Binding Devices_IdleDisconnect, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DeviceRowViewModel_IdleDisconnectMinutes_1094"/>
                                        </controls:SettingRow>
                                        <!-- Quick Charge (#372) on its own gate. Click,
                                             not Checked, so the persistence handler
                                             never fires on the binding's refresh when
                                             the selection changes (the #161 lesson). -->
                                        <StackPanel Visibility="{Binding SelectedDevice.ShowQuickCharge, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <controls:SettingRow MinHeight="44">
                                                <TextBlock Style="{StaticResource DeviceRowLabel}"
                                                           Text="{Binding Devices_QuickCharge, Source={x:Static strings:Strings.Instance}}"
                                                           ToolTip="{Binding Devices_QuickChargeTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <CheckBox Style="{StaticResource SwitchCheckBox}" Margin="0,0,10,0"
                                                          Content="{Binding Devices_QuickCharge, Source={x:Static strings:Strings.Instance}}"
                                                          IsChecked="{Binding SelectedDevice.QuickChargeEnabled, Mode=TwoWay}"
                                                          Click="QuickCharge_Click"
                                                          ToolTip="{Binding Devices_QuickChargeTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <reset:SettingResetButton Command="{Binding ResetSelectedDeviceSettingCommand}" CommandParameter="QuickChargeEnabled" SettingLabel="{Binding Devices_QuickCharge, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DeviceRowViewModel_QuickChargeEnabled_1108"/>
                                            </controls:SettingRow>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- A Bliss-Box port's arrows (#469). -->
                                    <controls:SettingRow MinHeight="44"
                                                         Visibility="{Binding SelectedDevice.ShowNativeArrows, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Style="{StaticResource DeviceRowLabel}"
                                                   Text="{Binding Devices_NativeArrows, Source={x:Static strings:Strings.Instance}}"
                                                   ToolTip="{Binding Devices_NativeArrowsTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <CheckBox Style="{StaticResource SwitchCheckBox}" Margin="0,0,10,0"
                                                  Content="{Binding Devices_NativeArrows, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding SelectedDevice.BlissBoxNativeArrows, Mode=TwoWay}"
                                                  Click="NativeArrows_Click"
                                                  ToolTip="{Binding Devices_NativeArrowsTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <reset:SettingResetButton Command="{Binding ResetSelectedDeviceSettingCommand}" CommandParameter="BlissBoxNativeArrows" SettingLabel="{Binding Devices_NativeArrows, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DeviceRowViewModel_BlissBoxNativeArrows_1005"/>
                                    </controls:SettingRow>

                                    <!-- A light gun's aim window (GunCon 2,
                                         hifihedgehog/SDL#33 Part 9, and a Wii Remote
                                         with an IR camera, #485): the beam counts at
                                         the picture's edges, or a remote's pointer
                                         counts, kept per device. Calibrate runs the
                                         four-target screen, which needs the gun
                                         connected to this PC. -->
                                    <StackPanel x:Name="GunRows"
                                                Visibility="{Binding SelectedDevice.ShowGunCalibration, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <controls:SettingRow MinHeight="44">
                                            <TextBlock Style="{StaticResource DeviceRowLabel}"
                                                       Text="{Binding Devices_GunCalibration, Source={x:Static strings:Strings.Instance}}"/>
                                            <ui:Button Content="{Binding Devices_GunCalibrate, Source={x:Static strings:Strings.Instance}}"
                                                       MinHeight="36" Padding="14,0" CornerRadius="6" Margin="0,0,10,0"
                                                       IsEnabled="{Binding SelectedDevice.CanCalibrateGun}"
                                                       ToolTip="{Binding SelectedDevice.GunCalibrateTooltip}"
                                                       ToolTipService.ShowOnDisabled="True"
                                                       Click="GunCalibrate_Click"/>
                                            <reset:SettingResetButton Command="{Binding ResetSelectedDeviceSettingCommand}" CommandParameter="GunCalibration" SettingLabel="{Binding Devices_GunCalibration, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DeviceRowViewModel_GunCalibration"/>
                                        </controls:SettingRow>
                                        <TextBlock Text="{Binding SelectedDevice.GunCalibrationStatus}" Style="{StaticResource DeviceSmall}" TextWrapping="Wrap" Margin="0,0,0,8"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- The device's tools, at the card's foot. The
                                         opt-in driver switch (hifihedgehog/SDL#33
                                         Part 15) of the Xbox 360 pads and receiver,
                                         the Intel base station, the Prodikeys and
                                         the TouchSense mice moves the device only on
                                         request, and moves it back. A pad in iCade
                                         mode (Part 16) pairs as a keyboard, and the
                                         pad's row, or the keyboard's while the pad is
                                         away, turns it back. A Namco USIO board
                                         (Part 14) serves Taiko and Tekken cabinets
                                         under one ID. A Bliss-Box port (#469) keeps
                                         Click before IsEnabled, and the Dreamcast
                                         Screen waits for a running job. -->
                                    <StackPanel x:Name="DeviceTools" Margin="0,8,0,4"
                                                Visibility="{Binding ShowDeviceTools, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <controls:FlexLinePanel Gap="8" LineGap="8">
                                            <Button Content="{Binding DriverBindText}" Style="{StaticResource DeviceButton}"
                                                    Click="DriverBind_Click"
                                                    Visibility="{Binding ShowDriverBind, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Button Content="{Binding Devices_DriverRestore, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DeviceButton}"
                                                    Click="DriverRestore_Click"
                                                    Visibility="{Binding ShowDriverRestore, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Button Content="{Binding Devices_ReadAsICade, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DeviceButton}"
                                                    Click="ReadAsICade_Click"
                                                    ToolTip="{Binding Devices_ReadAsICadeTooltip, Source={x:Static strings:Strings.Instance}}"
                                                    Visibility="{Binding SelectedDevice.ShowReadAsICade, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Button Content="{Binding Devices_ReadAsKeyboard, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DeviceButton}"
                                                    Click="ReadAsKeyboard_Click"
                                                    Visibility="{Binding SelectedDevice.ShowReadAsKeyboard, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Button Content="{Binding Devices_UsioTekken, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DeviceButton}"
                                                    Click="UsioTekken_Click"
                                                    ToolTip="{Binding Devices_UsioLayoutTooltip, Source={x:Static strings:Strings.Instance}}"
                                                    Visibility="{Binding SelectedDevice.ShowUsioTekken, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Button Content="{Binding Devices_UsioTaiko, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DeviceButton}"
                                                    Click="UsioTaiko_Click"
                                                    ToolTip="{Binding Devices_UsioLayoutTooltip, Source={x:Static strings:Strings.Instance}}"
                                                    Visibility="{Binding SelectedDevice.ShowUsioTaiko, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Button Content="{Binding Nfc_ManageButton, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DeviceButton}"
                                                    Click="RegisterNfcTag_Click"
                                                    Visibility="{Binding SelectedDevice.ShowRegisterNfcTag, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Button Content="{Binding Voice_ManageButton, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DeviceButton}"
                                                    Click="ManageVoicePhrases_Click"
                                                    Visibility="{Binding SelectedDevice.ShowManageVoicePhrases, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Button Content="{Binding TwitchChat_ManageButton, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DeviceButton}"
                                                    Click="ManageChatCommands_Click"
                                                    Visibility="{Binding SelectedDevice.ShowManageChatCommands, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Button Content="{Binding Handheld_ManageButton, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DeviceButton}"
                                                    Click="LearnHandheldButton_Click"
                                                    Visibility="{Binding SelectedDevice.ShowLearnHandheldButton, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Button Content="{Binding MapKeyLights_ManageButton, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DeviceButton}"
                                                    Click="MapKeyLights_Click"
                                                    Visibility="{Binding SelectedDevice.ShowMapKeyLights, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Button Content="{Binding Devices_BlissBoxPlayer, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DeviceButton}"
                                                    Click="BlissBoxPlayer_Click"
                                                    IsEnabled="{Binding SelectedDevice.BlissBoxIdle}"
                                                    ToolTip="{Binding Devices_BlissBoxPlayerTooltip, Source={x:Static strings:Strings.Instance}}"
                                                    Visibility="{Binding SelectedDevice.ShowBlissBoxPlayer, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Button Content="{Binding Devices_DreamcastScreen, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DeviceButton}"
                                                    Click="DreamcastScreen_Click"
                                                    IsEnabled="{Binding SelectedDevice.BlissBoxIdle}"
                                                    ToolTip="{Binding Devices_DreamcastScreenTooltip, Source={x:Static strings:Strings.Instance}}"
                                                    Visibility="{Binding SelectedDevice.ShowDreamcastScreen, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Button Content="{Binding Devices_PakBackup, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DeviceButton}"
                                                    Click="PakBackup_Click"
                                                    IsEnabled="{Binding SelectedDevice.BlissBoxIdle}"
                                                    ToolTip="{Binding Devices_PakBackupTooltip, Source={x:Static strings:Strings.Instance}}"
                                                    Visibility="{Binding SelectedDevice.ShowControllerPak, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Button Content="{Binding Devices_PakRestore, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DeviceButton}"
                                                    Click="PakRestore_Click"
                                                    IsEnabled="{Binding SelectedDevice.BlissBoxIdle}"
                                                    ToolTip="{Binding Devices_PakRestoreTooltip, Source={x:Static strings:Strings.Instance}}"
                                                    Visibility="{Binding SelectedDevice.ShowControllerPak, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Button Content="{Binding SelectedDevice.KeyboardScreenButtonText}" Style="{StaticResource DeviceButton}"
                                                    Click="KeyboardScreen_Click"
                                                    Visibility="{Binding SelectedDevice.ShowKeyboardScreen, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Button Content="{Binding Falcon_Calibrate, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DeviceButton}"
                                                    Click="FalconCalibrate_Click"
                                                    ToolTip="{Binding Falcon_Calibrate_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                    Visibility="{Binding SelectedDevice.ShowFalconCalibrate, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </controls:FlexLinePanel>
                                        <TextBlock common:LiveText.Polite="True" Text="{Binding SelectedDevice.FalconCalibrationStatus}"
                                                   Style="{StaticResource DeviceSmall}" TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Visibility="{Binding SelectedDevice.ShowFalconCalibrate, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Details, folded to one line at the panel's foot:
                                 the device's IDs, path and capabilities, Force
                                 Raw Joystick Mode, and the actions on the record.
                                 The values wrap, and a path wraps anywhere. -->
                            <controls:FoldList x:Name="DetailsCard" Gap="0">
                                <controls:FoldCard x:Name="DetailsFold" StateKey="Devices.Details"
                                                   AutomationProperties.AutomationId="Devices_Details"
                                                   Header="{Binding Devices_Dossier, Source={x:Static strings:Strings.Instance}}">
                                    <controls:FoldCard.Style>
                                        <Style TargetType="{x:Type controls:FoldCard}" BasedOn="{StaticResource {x:Type controls:FoldCard}}">
                                            <Setter Property="Hint" Value="{Binding Devices_Details_FoldHintShort, Source={x:Static strings:Strings.Instance}}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedDevice.ShowInputModeSection}" Value="True">
                                                    <Setter Property="Hint" Value="{Binding Devices_Details_FoldHint, Source={x:Static strings:Strings.Instance}}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:FoldCard.Style>
                                    <StackPanel Margin="0,4,0,2">
                                        <DockPanel Margin="0,5">
                                            <TextBlock Style="{StaticResource DetailKey}" Text="{Binding Devices_Detail_Product, Source={x:Static strings:Strings.Instance}}"/>
                                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedDevice.ProductName, Mode=OneWay}"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,5">
                                            <TextBlock Style="{StaticResource DetailKey}" Text="{Binding Devices_Detail_Type, Source={x:Static strings:Strings.Instance}}"/>
                                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedDevice.DeviceType, Mode=OneWay}"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,5">
                                            <TextBlock Style="{StaticResource DetailKey}" Text="{Binding Devices_Detail_Capabilities, Source={x:Static strings:Strings.Instance}}"/>
                                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedDevice.CapabilitiesSummary, Mode=OneWay}"/>
                                        </DockPanel>
                                        <!-- VID:PID, App GUID and SDL GUID are the
                                             same tokens in every language. -->
                                        <DockPanel Margin="0,5"
                                                   Visibility="{Binding SelectedDevice.HasVidPid, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Style="{StaticResource DetailKey}" Text="VID:PID"/>
                                            <TextBlock Style="{StaticResource DetailMono}"><Run
                                                Text="{Binding SelectedDevice.VendorIdHex, Mode=OneWay}"/><Run
                                                Text=":"/><Run
                                                Text="{Binding SelectedDevice.ProductIdHex, Mode=OneWay}"/></TextBlock>
                                        </DockPanel>
                                        <!-- A link is named only when it is Bluetooth:
                                             a path that is not may be USB, a receiver
                                             or a virtual source. -->
                                        <DockPanel Margin="0,5"
                                                   Visibility="{Binding SelectedDevice.IsBluetoothLink, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Style="{StaticResource DetailKey}" Text="{Binding Devices_Detail_Link, Source={x:Static strings:Strings.Instance}}"/>
                                            <!-- The Bluetooth mark, then the word. -->
                                            <TextBlock Style="{StaticResource DetailValue}"
                                                       AutomationProperties.Name="{Binding Pad_Transport_Bluetooth, Source={x:Static strings:Strings.Instance}}"><Run
                                                Text="&#xE702;" FontFamily="Segoe UI, Segoe MDL2 Assets" BaselineAlignment="Center"/><Run
                                                Text=" "/><Run
                                                Text="{Binding Pad_Transport_Bluetooth, Source={x:Static strings:Strings.Instance}, Mode=OneWay}"/></TextBlock>
                                        </DockPanel>
                                        <!-- The battery, for a device that reports
                                             one: a picture of its level, then the
                                             percentage, then charging when it is. -->
                                        <DockPanel Margin="0,5"
                                                   Visibility="{Binding SelectedDevice.HasBattery, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Style="{StaticResource DetailKey}" Text="{Binding Devices_Detail_Battery, Source={x:Static strings:Strings.Instance}}"/>
                                            <TextBlock Style="{StaticResource DetailValue}"
                                                       AutomationProperties.Name="{Binding SelectedDevice.BatteryLine, Mode=OneWay, TargetNullValue='', FallbackValue=''}"><Run
                                                Text="{Binding SelectedDevice.BatteryGlyph, Mode=OneWay}" FontFamily="Segoe UI, Segoe MDL2 Assets" BaselineAlignment="Center"/><Run
                                                Text="{Binding SelectedDevice.BatteryGap, Mode=OneWay}"/><Run
                                                Text="{Binding SelectedDevice.BatteryText, Mode=OneWay}" FontFamily="{StaticResource TelemetryFontFamily}"/><Run
                                                Text="{Binding SelectedDevice.LineTail, Mode=OneWay}"/></TextBlock>
                                        </DockPanel>
                                        <!-- The second path is a bridged device's
                                             connection path (the DualShock 3 over
                                             BthPS3 or WinUSB). It is empty whenever
                                             the first shows, so the two never both
                                             do. -->
                                        <DockPanel Margin="0,5"
                                                   Visibility="{Binding SelectedDevice.HidHideInstancePath, Converter={StaticResource StringToVisibility}}">
                                            <TextBlock Style="{StaticResource DetailKey}" Text="{Binding Devices_Detail_Path, Source={x:Static strings:Strings.Instance}}"/>
                                            <TextBlock Style="{StaticResource DetailMono}" Text="{Binding SelectedDevice.HidHideInstancePath, Mode=OneWay}"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,5"
                                                   Visibility="{Binding SelectedDevice.DossierConnectionPath, Converter={StaticResource StringToVisibility}}">
                                            <TextBlock Style="{StaticResource DetailKey}" Text="{Binding Devices_Detail_Path, Source={x:Static strings:Strings.Instance}}"/>
                                            <TextBlock Style="{StaticResource DetailMono}" Text="{Binding SelectedDevice.DossierConnectionPath, Mode=OneWay}"/>
                                        </DockPanel>
                                        <!-- Serial as SDL reports it (the Bluetooth
                                             address on most wireless pads), the
                                             firmware, or the revision a Bluetooth LE
                                             pad's Device Information service gives,
                                             and the product's own revision. Each hides
                                             when unreported. -->
                                        <DockPanel Margin="0,5"
                                                   Visibility="{Binding SelectedDevice.SerialNumber, Converter={StaticResource StringToVisibility}}">
                                            <TextBlock Style="{StaticResource DetailKey}" Text="{Binding Devices_Detail_Serial, Source={x:Static strings:Strings.Instance}}"/>
                                            <TextBlock Style="{StaticResource DetailMono}" Text="{Binding SelectedDevice.SerialNumber, Mode=OneWay}"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,5"
                                                   Visibility="{Binding SelectedDevice.FirmwareVersion, Converter={StaticResource StringToVisibility}}">
                                            <TextBlock Style="{StaticResource DetailKey}" Text="{Binding Devices_Detail_Firmware, Source={x:Static strings:Strings.Instance}}"/>
                                            <TextBlock Style="{StaticResource DetailMono}" Text="{Binding SelectedDevice.FirmwareVersion, Mode=OneWay}"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,5"
                                                   Visibility="{Binding SelectedDevice.ProductRevision, Converter={StaticResource StringToVisibility}}">
                                            <TextBlock Style="{StaticResource DetailKey}" Text="{Binding Devices_Detail_Revision, Source={x:Static strings:Strings.Instance}}"/>
                                            <TextBlock Style="{StaticResource DetailMono}" Text="{Binding SelectedDevice.ProductRevision, Mode=OneWay}"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,5">
                                            <TextBlock Style="{StaticResource DetailKey}" Text="App GUID"/>
                                            <TextBlock Style="{StaticResource DetailMono}" Text="{Binding SelectedDevice.InstanceGuid, Mode=OneWay}"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,5"
                                                   Visibility="{Binding SelectedDevice.SdlGuid, Converter={StaticResource StringToVisibility}}">
                                            <TextBlock Style="{StaticResource DetailKey}" Text="SDL GUID"/>
                                            <TextBlock Style="{StaticResource DetailMono}" Text="{Binding SelectedDevice.SdlGuid, Mode=OneWay}"/>
                                        </DockPanel>
                                        <!-- Force Raw Joystick Mode: a gamepad row that
                                             is no source of PadForge's own (a web pad, a
                                             Remote Link copy), and any row whose switch
                                             is on, so it can be turned off
                                             (ShowInputModeSection). -->
                                        <controls:SettingRow MinHeight="44" Margin="0,6,0,0"
                                                             Visibility="{Binding SelectedDevice.ShowInputModeSection, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Style="{StaticResource DeviceRowLabel}"
                                                       Text="{Binding Devices_ForceRaw, Source={x:Static strings:Strings.Instance}}"
                                                       ToolTip="{Binding Devices_ForceRawTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <CheckBox Style="{StaticResource SwitchCheckBox}" Margin="0,0,10,0"
                                                      Content="{Binding Devices_ForceRaw, Source={x:Static strings:Strings.Instance}}"
                                                      IsChecked="{Binding SelectedDevice.ForceRawJoystickMode, Mode=TwoWay}"
                                                      Click="HidingToggle_Click"
                                                      ToolTip="{Binding Devices_ForceRawTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <reset:SettingResetButton Command="{Binding ResetSelectedDeviceSettingCommand}" CommandParameter="ForceRawJoystickMode" SettingLabel="{Binding Devices_ForceRaw, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DeviceRowViewModel_ForceRawJoystickMode_1004"/>
                                        </controls:SettingRow>
                                        <!-- Submit Mapping shows for joysticks only.
                                             Remove Device forgets the device and its
                                             settings, after the shared confirm. -->
                                        <controls:FlexLinePanel Gap="8" LineGap="8" Margin="0,6,0,0">
                                            <Button Content="{Binding Devices_CopyDetails, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DeviceButton}"
                                                    Click="CopyDossier_Click"
                                                    AutomationProperties.AutomationId="Devices_CopyDetails"/>
                                            <Button Content="{Binding Devices_SubmitMapping, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DeviceButton}"
                                                    Click="SubmitMapping_Click"
                                                    Visibility="{Binding SelectedDevice.ShowSubmitMapping, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    AutomationProperties.AutomationId="Devices_SubmitMapping"/>
                                            <Button Content="{Binding Devices_RemoveConfirmTitle, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DeviceRemoveButton}"
                                                    Click="RemoveDevice_Click"
                                                    ToolTip="{Binding Devices_RemoveTooltip, Source={x:Static strings:Strings.Instance}}"
                                                    AutomationProperties.AutomationId="Devices_Remove"/>
                                        </controls:FlexLinePanel>
                                    </StackPanel>
                                </controls:FoldCard>
                            </controls:FoldList>
                        </StackPanel>
                    </StackPanel>
                </ui:PassiveScrollViewer>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
