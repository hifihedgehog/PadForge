<views:DialogWindow xmlns:common="clr-namespace:PadForge.Common" common:Reach.Class="UsersOwn" AutomationProperties.IsDialog="True" x:Class="PadForge.Views.AnswerPairDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        xmlns:controls="clr-namespace:PadForge.Controls"
        xmlns:views="clr-namespace:PadForge.Views"
        Width="420"
        Title="{Binding Answer_Pair_Title, Source={x:Static strings:Strings.Instance}}">

    <!-- Pair a Device… (#600), as the Assistants-Web board draws it: the QR
         code that opens the answer page paired, the line that says this
         window is hidden from screen capture, the page's address with the
         six digits typed in its place, and when the code stops working.
         The window is a top-level window of its own because Windows hides a
         whole window from capture (SetWindowDisplayAffinity), and it shows
         no code until Windows has hidden it. -->
    <views:DialogWindow.Foot>
        <controls:FlexLinePanel Style="{StaticResource DialogFootPanel}">
            <Button x:Name="CancelButton" Style="{StaticResource DialogButton}" IsCancel="True" IsDefault="True"
                    Content="{Binding Common_Cancel, Source={x:Static strings:Strings.Instance}}"
                    Click="Cancel_Click"/>
        </controls:FlexLinePanel>
    </views:DialogWindow.Foot>

    <StackPanel>
        <StackPanel x:Name="CodePanel" Visibility="Collapsed">
            <!-- The code's own white ground and quiet zone come with it
                 (WebControllerServer.RenderQr). Left to right in every
                 language, as the web controller's codes are: a mirrored QR
                 code does not scan. -->
            <Image x:Name="QrImage" FlowDirection="LeftToRight" Width="174" Height="174" HorizontalAlignment="Left" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   AutomationProperties.Name="{Binding Answer_Pair_Qr, Source={x:Static strings:Strings.Instance}}"/>
            <TextBlock Style="{StaticResource DialogNote}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="{Binding Answer_Pair_Hidden, Source={x:Static strings:Strings.Instance}}"/>
            <!-- The typed way in, hidden once five wrong codes close it. -->
            <StackPanel x:Name="TypedPanel">
                <TextBlock x:Name="OpenText" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="14"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <!-- The six digits spaced as the board draws them, one cell
                     each, as the request card shows a sign-in's code. -->
                <ItemsControl x:Name="CodeDigits" Margin="0,8,0,0" Focusable="False" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="30" FontWeight="SemiBold" Margin="0,0,6,0"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{DynamicResource LinkHoverBrush}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="UntilText" Style="{StaticResource DialogNote}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>
        <!-- Why no code shows: the address is starting, the page cannot
             open, Windows would not hide the window, the pairing ended, or
             the typed code closed while the QR code still works. -->
        <TextBlock x:Name="StateText" Style="{StaticResource DialogNote}" TextWrapping="Wrap" common:LiveText.Polite="True"
                   AutomationProperties.AutomationId="Answer_Pair_State"/>
    </StackPanel>
</views:DialogWindow>
