                                        <CheckBox Style="{StaticResource SwitchCheckBox}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsChecked="{Binding DeviceConfig.ScreenColorSpread, Mode=TwoWay}"
                                                  Content="{Binding Pad_Lighting_ScreenSpread, Source={x:Static strings:Strings.Instance}}"/>
