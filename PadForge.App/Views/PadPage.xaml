                                    <CheckBox Style="{StaticResource SwitchCheckBox}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsChecked="{Binding DeviceConfig.LightbarColorCycleSmooth, Mode=TwoWay}"
                                              Content="{Binding Pad_Lighting_ColorCycleSmooth, Source={x:Static strings:Strings.Instance}}"/>
                                    <reset:SettingResetButton Command="{Binding DeviceConfig.ResetLightbarColorCycleSmoothCommand}" SettingLabel="{Binding Pad_Lighting_ColorCycleSmooth, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DeviceSlotConfig_LightbarColorCycleSmooth_8401"/>
                                </controls:SettingRow>

                                <!-- Palette (variable count). Base instance.
                                     Visible only when LightbarMode = ColorCycle so the
                                     palette sits directly below the dropdown that
                                     reveals it. The InputReactive Cycle overlay has
                                     its own palette below the InputReactive dropdown,
                                     with its OWN colors, so the editor doesn't appear
                                     above the dropdown that summoned it. The two were
                                     briefly wired to one collection and editing either
                                     changed the other, which was never intended. ShowPaletteForBase / ShowPaletteForOverlay
                                     are mutually exclusive. Palette renders exactly
                                     once at any time. -->
                                <StackPanel Visibility="{Binding DeviceConfig.ShowPaletteForBase, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Pad_Lighting_PaletteHeader, Source={x:Static strings:Strings.Instance}}"
