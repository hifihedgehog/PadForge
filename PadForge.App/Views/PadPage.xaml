                        </DataGrid.RowDetailsTemplate>
                        <DataGrid.Columns>
                            <!-- Output chip (#175): the virtual side of the row
                                 reads ember. Source cells stay cold. -->
                            <DataGridTemplateColumn Header="{Binding Pad_HeaderOutput, Source={x:Static strings:Strings.Instance}}"
                                                    Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource EmberTintBrush}"
                                                BorderThickness="1" CornerRadius="8"
                                                Padding="10,6" Margin="2"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left">
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="#66FF6B2C"/>
                                            </Border.BorderBrush>
                                            <Grid>
                                                <!-- Chip flash (#175 item 33): the dst chip
                                                     glows when input flows through the row,
                                                     same 300ms/1200ms envelope as rowfire.
                                                     Gated on ClientAreaAnimation (item 98). -->
                                                <Border x:Name="ChipFlash" Background="#40FFA24D"
                                                        CornerRadius="7" Margin="-10,-6"
                                                        Opacity="0" IsHitTestVisible="False"/>
                                                <TextBlock Text="{Binding TargetLabel}"
                                                           FontWeight="SemiBold" FontSize="12.5"
                                                           Foreground="{DynamicResource EmberHotBrush}"/>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsInputActive}" Value="True"/>
                                                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="ChipFlash"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="1" Duration="0:0:0.3">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="ChipFlash"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="0" Duration="0:0:1.2">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseIn"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{Binding Pad_HeaderSource, Source={x:Static strings:Strings.Instance}}"
                                                Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical">
                                            <!-- Direct primary: the cross-device input picker fills the cell.
                                                 The Mode dropdown lives in the row-detail strip, not here, so
                                                 the cell holds only the mapping and never crowds the picker
                                                 (#111). The grouped view headers each device; SelectedItem
                                                 tags the row with the picked DeviceGuid + DeviceLabel. -->
                                            <ComboBox ItemsSource="{Binding AvailableInputsView}"
                                                      SelectedItem="{Binding SelectedInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Visibility="{Binding IsPrimaryDirect, Converter={StaticResource BoolToVisibilityConverter}}"
                                                      DisplayMemberPath="DisplayName"
                                                      Margin="0" Padding="4,2"
                                                      MinHeight="28"
                                                      HorizontalAlignment="Stretch"
                                                      Foreground="{DynamicResource ColdBrush}"
                                                      BorderBrush="#4D58B6E4" Background="#0D58B6E4"
                                                      PreviewKeyDown="MappingComboBox_PreviewKeyDown"
                                                      IsSynchronizedWithCurrentItem="False">
                                                <ComboBox.GroupStyle>
                                                    <GroupStyle>
                                                        <GroupStyle.HeaderTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                                        Padding="6,3,6,3" Margin="0,0,0,0">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </GroupStyle.HeaderTemplate>
                                                    </GroupStyle>
                                                </ComboBox.GroupStyle>
                                            </ComboBox>
                                            <!-- Phase 2C — primary source's device origin badge.
                                                 Visible when the row is bound to a per-VC
                                                 MappingSet primary and resolved to a
                                                 user-friendly device name. -->
                                            <!-- Source subtitle below the picker. Shows the device
                                                 the assigned input comes from when set; falls back
                                                 to italic "Unassigned" when nothing is mapped. The
                                                 Style sets Text via a Setter rather than a local
                                                 value so the DataTrigger's override actually wins. -->
                                            <TextBlock FontSize="10"
                                                       Foreground="{DynamicResource ColdMutedBrush}"
                                                       Margin="4,1,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding IsPrimaryDirect, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding PrimarySourceDeviceLabel}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SourceDescriptor}" Value="">
                                                                <Setter Property="Text" Value="{Binding Common_Unassigned, Source={x:Static strings:Strings.Instance}}"/>
                                                                <Setter Property="FontStyle" Value="Italic"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- Phase 2C — empty-direction hint + one-click
                                                 affordance. Surfaces when a bipolar stick-axis
                                                 row has only the positive direction mapped
                                                 (one button-class source, not inverted).
                                                 Clicking adds a second source mirroring the
                                                 primary with Invert=true. Disappears once a
                                                 second source exists. -->
                                            <Button Content="{Binding Pad_Mapping_AddOppositeDir, Source={x:Static strings:Strings.Instance}}"
                                                    Command="{Binding AddOppositeDirectionCommand}"
                                                    HorizontalAlignment="Left"
                                                    Padding="4,0"
                                                    Margin="4,1,0,0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontSize="10"
                                                    FontStyle="Italic"
                                                    Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                                    Cursor="Hand"
                                                    ToolTip="{Binding Pad_Mapping_AddOppositeDir_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                    Visibility="{Binding ShouldShowEmptyDirectionHint, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                            <!-- Primary kind inputs (#111), inline in the cell. Up/Down pickers
                                                 for Ramp / Incremental (both directions map right here), or the
                                                 modifier key for Invert On Hold. These are for manual edits. The
                                                 row's single Record button captures them (Up then Down, or the
                                                 modifier) so there is only one Record control. DataContext is the
                                                 row's PrimaryKindSource. The pickers bind the row's
                                                 AvailableInputsView via the DataGridRow ancestor. -->
                                            <StackPanel DataContext="{Binding PrimaryKindSource}"
                                                        Visibility="{Binding DataContext.IsPrimaryDirect, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                            Visibility="{Binding UsesUpDownKeys, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="↥" FontSize="13" VerticalAlignment="Center" Margin="0,0,2,0"
                                                               ToolTip="{Binding Pad_Mapping_Up_IconTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                    <StackPanel Orientation="Vertical">
                                                        <ComboBox ItemsSource="{Binding DataContext.AvailableInputsView, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"
                                                                  SelectedItem="{Binding ParamUpInputChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  DisplayMemberPath="DisplayName" MinWidth="150" MinHeight="28" Padding="4,2" VerticalAlignment="Center"
                                                                  ToolTip="{Binding Pad_Mapping_Up_PickerTooltip, Source={x:Static strings:Strings.Instance}}"
                                                                  PreviewKeyDown="MappingComboBox_PreviewKeyDown"
                                                                  IsSynchronizedWithCurrentItem="False">
                                                            <ComboBox.GroupStyle>
                                                                <GroupStyle>
                                                                    <GroupStyle.HeaderTemplate>
                                                                        <DataTemplate>
                                                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,3,6,3">
                                                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </GroupStyle.HeaderTemplate>
                                                                </GroupStyle>
                                                            </ComboBox.GroupStyle>
                                                        </ComboBox>
                                                        <TextBlock FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Margin="4,1,0,0" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding ParamUpDeviceLabel}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ParamUp}" Value="">
                                                                            <Setter Property="Text" Value="{Binding Common_Unassigned, Source={x:Static strings:Strings.Instance}}"/>
                                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                            Visibility="{Binding UsesUpDownKeys, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="↧" FontSize="13" VerticalAlignment="Center" Margin="0,0,2,0"
                                                               ToolTip="{Binding Pad_Mapping_Down_IconTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                    <StackPanel Orientation="Vertical">
                                                        <ComboBox ItemsSource="{Binding DataContext.AvailableInputsView, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"
                                                                  SelectedItem="{Binding ParamDownInputChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  DisplayMemberPath="DisplayName" MinWidth="150" MinHeight="28" Padding="4,2" VerticalAlignment="Center"
                                                                  ToolTip="{Binding Pad_Mapping_Down_PickerTooltip, Source={x:Static strings:Strings.Instance}}"
                                                                  PreviewKeyDown="MappingComboBox_PreviewKeyDown"
                                                                  IsSynchronizedWithCurrentItem="False">
                                                            <ComboBox.GroupStyle>
                                                                <GroupStyle>
                                                                    <GroupStyle.HeaderTemplate>
                                                                        <DataTemplate>
                                                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,3,6,3">
                                                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </GroupStyle.HeaderTemplate>
                                                                </GroupStyle>
                                                            </ComboBox.GroupStyle>
                                                        </ComboBox>
                                                        <TextBlock FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Margin="4,1,0,0" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding ParamDownDeviceLabel}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ParamDown}" Value="">
                                                                            <Setter Property="Text" Value="{Binding Common_Unassigned, Source={x:Static strings:Strings.Instance}}"/>
                                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                            Visibility="{Binding IsInvertOnHoldKind, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="⇋" FontSize="13" VerticalAlignment="Center" Margin="0,0,2,0"
                                                               ToolTip="{Binding Pad_Mapping_Modifier_IconTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                    <StackPanel Orientation="Vertical">
                                                        <ComboBox ItemsSource="{Binding DataContext.AvailableInputsView, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"
                                                                  SelectedItem="{Binding ParamModifierInputChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  DisplayMemberPath="DisplayName" MinWidth="150" MinHeight="28" Padding="4,2" VerticalAlignment="Center"
                                                                  ToolTip="{Binding Pad_Mapping_Modifier_PickerTooltip, Source={x:Static strings:Strings.Instance}}"
                                                                  PreviewKeyDown="MappingComboBox_PreviewKeyDown"
                                                                  IsSynchronizedWithCurrentItem="False">
                                                            <ComboBox.GroupStyle>
                                                                <GroupStyle>
                                                                    <GroupStyle.HeaderTemplate>
                                                                        <DataTemplate>
                                                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,3,6,3">
                                                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </GroupStyle.HeaderTemplate>
                                                                </GroupStyle>
                                                            </ComboBox.GroupStyle>
                                                        </ComboBox>
                                                        <TextBlock FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Margin="4,1,0,0" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding ParamModifierDeviceLabel}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ParamModifier}" Value="">
                                                                            <Setter Property="Text" Value="{Binding Common_Unassigned, Source={x:Static strings:Strings.Instance}}"/>
                                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Value: raw telemetry, cold mono (#175). -->
                            <DataGridTextColumn Header="{Binding Pad_HeaderValue, Source={x:Static strings:Strings.Instance}}"
                                                Binding="{Binding CurrentValueText, Mode=OneWay}"
                                                Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}"/>
                                        <Setter Property="FontSize" Value="11.5"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ColdBrush}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <!-- Record button -->
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:Button Command="{Binding ToggleRecordCommand}"
                                                   IsEnabled="{Binding IsRecordable}"
                                                   Style="{StaticResource EmberIconButtonHot}">
                                            <!-- Ember (#175): record is about to write a binding. -->
                                            <TextBlock Text="{Binding RecordButtonIcon}" FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{DynamicResource EmberBrush}"/>
                                            <ui:Button.ToolTip>
                                                <TextBlock Text="{Binding RecordButtonText}"/>
                                            </ui:Button.ToolTip>
                                        </ui:Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Clear button -->
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:Button Command="{Binding ClearCommand}"
                                                   Style="{StaticResource EmberIconButtonHot}">
                                            <TextBlock Text="&#xE75C;" FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <ui:Button.ToolTip>
                                                <TextBlock Text="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}"/>
                                            </ui:Button.ToolTip>
                                        </ui:Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Invert / Half-axis / Bidirectional / Do-not-inherit options.
                                 Width=Auto sizes to the widest cell + header. The
                                 always-visible checkboxes set the natural floor;
                                 the column expands when a row also shows NoInherit
                                 or the gyro sensitivity slider, and collapses when
                                 no such row exists. HorizontalAlignment=Left on the
                                 cell-template StackPanel keeps it from being
                                 measured against the cell's stretched arrange
                                 rectangle — without it, the WPF-UI DataGrid cell
                                 template feeds the StackPanel the column's stretched
                                 width during measurement, and the column inflates. -->
                            <DataGridTemplateColumn Header="{Binding Pad_HeaderOptions, Source={x:Static strings:Strings.Instance}}" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <CheckBox Content="{Binding Pad_Invert, Source={x:Static strings:Strings.Instance}}" IsChecked="{Binding IsInverted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding IsInvertApplicable}"
                                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11.5"
                                                      Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <CheckBox Content="{Binding Pad_Half, Source={x:Static strings:Strings.Instance}}" IsChecked="{Binding IsHalfAxis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding IsHalfAxisApplicable}"
                                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11.5"
                                                      Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <CheckBox Content="{Binding Pad_Either, Source={x:Static strings:Strings.Instance}}"
                                                      ToolTip="{Binding Pad_Either_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                      IsChecked="{Binding IsBidirectional, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding IsHalfAxis}"
                                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11.5"
                                                      Margin="0,0,6,0"
                                                      VerticalAlignment="Center"/>
                                            <!-- NoInherit toggle. Only meaningful when authoring
                                                 a shift layer whose activator has InheritUnmapped
                                                 enabled — replace-mode layers (the default) block
                                                 Base wholesale, making NoInherit a no-op. The
                                                 CheckBox is hidden outside that narrow case so
                                                 users don't see a useless tickbox. -->
                                            <CheckBox Content="{Binding Pad_Shift_NoInherit, Source={x:Static strings:Strings.Instance}}"
                                                      ToolTip="{Binding Pad_Shift_NoInherit_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                      IsChecked="{Binding NoInherit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11.5"
                                                      VerticalAlignment="Center"
                                                      Visibility="{Binding DataContext.IsActiveLayerInheriting, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <!-- Per-source gyro sensitivity for the primary source.
                                                 Mirrors the ExtraSource gyro-sensitivity row; only
                                                 renders for gyro descriptors so non-gyro primaries
                                                 don't see a knob that does nothing. -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0"
                                                        Visibility="{Binding IsGyroSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Mapping_GyroSensitivity, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <Slider Value="{Binding GyroSensitivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Minimum="0.1" Maximum="10" SmallChange="0.1" LargeChange="1"
                                                        Width="120" VerticalAlignment="Center"
                                                        ToolTip="{Binding Mapping_GyroSensitivity_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <TextBox Text="{Binding GyroSensitivity, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                                         Width="50" Margin="4,0,4,0" Padding="2,1"
                                                         VerticalContentAlignment="Center"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="×" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                <ui:Button Command="{Binding ResetGyroSensitivityCommand}" Style="{StaticResource ResetButton}"/>
                                            </StackPanel>
                                            <!-- Per-source mouse cursor sensitivity for the primary
                                                 source (#107). Renders only for "Mouse Position X/Y". -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0"
                                                        Visibility="{Binding IsMouseCursorSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Mapping_MouseCursorSensitivity, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <Slider Value="{Binding MouseCursorSensitivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Minimum="0.1" Maximum="5" SmallChange="0.1" LargeChange="0.5"
                                                        Width="120" VerticalAlignment="Center"
                                                        ToolTip="{Binding Mapping_MouseCursorSensitivity_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <TextBox Text="{Binding MouseCursorSensitivity, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                                         Width="50" Margin="4,0,4,0" Padding="2,1"
                                                         VerticalContentAlignment="Center"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="×" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                <ui:Button Command="{Binding ResetMouseCursorSensitivityCommand}" Style="{StaticResource ResetButton}"/>
                                            </StackPanel>
                                            <!-- Per-source IR pointer sensitivity (#146). Renders only for "IR Pointer X/Y". -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0"
                                                        Visibility="{Binding IsIrPointerSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Mapping_IrPointerSensitivity, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <Slider Value="{Binding IrPointerSensitivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Minimum="0.1" Maximum="5" SmallChange="0.1" LargeChange="0.5"
                                                        Width="120" VerticalAlignment="Center"
                                                        ToolTip="{Binding Mapping_IrPointerSensitivity_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <TextBox Text="{Binding IrPointerSensitivity, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                                         Width="50" Margin="4,0,4,0" Padding="2,1"
                                                         VerticalContentAlignment="Center"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="×" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                <ui:Button Command="{Binding ResetIrPointerSensitivityCommand}" Style="{StaticResource ResetButton}"/>
                                            </StackPanel>
                                            <!-- Per-source mouse-motion sensitivity (#154). Renders only for "Mouse Motion X/Y". -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0"
                                                        Visibility="{Binding IsMouseMotionSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Mapping_IrPointerSensitivity, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <Slider Value="{Binding IrPointerSensitivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Minimum="0.1" Maximum="5" SmallChange="0.1" LargeChange="0.5"
                                                        Width="120" VerticalAlignment="Center"
                                                        ToolTip="{Binding Mapping_MouseMotionSensitivity_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <TextBox Text="{Binding IrPointerSensitivity, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                                         Width="50" Margin="4,0,4,0" Padding="2,1"
                                                         VerticalContentAlignment="Center"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="×" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                <ui:Button Command="{Binding ResetIrPointerSensitivityCommand}" Style="{StaticResource ResetButton}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Deadzone (per-mapping axis activation threshold) -->
                            <DataGridTemplateColumn Header="{Binding Pad_HeaderDeadZone, Source={x:Static strings:Strings.Instance}}" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <!-- Collapse instead of dim (#175 item 5): the
                                                             Auto column sheds the dead cluster's width
                                                             on rows where deadzone never applies. -->
                                                        <DataTrigger Binding="{Binding IsDeadZoneApplicable}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Slider Style="{StaticResource DzSlider}" Width="120" Minimum="1"
                                                    Value="{Binding MappingDeadZone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    TickFrequency="1"/>
                                            <TextBox Text="{Binding MappingDeadZone, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource DzValueEdit}"/>
                                            <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                            <ui:Button Command="{Binding ResetDeadZoneCommand}" Style="{StaticResource ResetButton}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Simultaneous Opposite Cardinal Directions (SOCD)
                         card, discussion #240. Slot-tier: configures the
                         slot's virtual controller OUTPUT (MappingSet.SocdMode
                         / SocdPairs, applied by Step 5 right before submit),
                         never a device. Hidden on KeyboardMouse (the
                         KbmConfig twin card below) and MIDI slots. Gamepad
                         slots pick from the 15 named targets; Extended slots
                         enter raw button indices 0-127. -->
                    <Border Grid.Row="4" Style="{StaticResource CardBorder}" Margin="0,8,0,0"
                            Visibility="{Binding SocdCardVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Pad_Socd_Card_Header, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardTitle}"/>
                                <ui:Button Command="{Binding ResetSocdCardCommand}" Style="{StaticResource ResetAllButton}"
                                           Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                           ToolTip="{Binding Pad_Socd_ResetCard_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Pad_Socd_Card_Desc, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource CardDescription}"/>

                            <!-- Mode row -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding Pad_Socd_Mode_Label, Source={x:Static strings:Strings.Instance}}"
                                           Width="140" VerticalAlignment="Center"
                                           ToolTip="{Binding Pad_Socd_Mode_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                <ComboBox ItemsSource="{Binding AvailableSlotSocdModes}"
                                          SelectedValue="{Binding SocdMode, Mode=TwoWay}"
                                          SelectedValuePath="Value"
                                          MinWidth="170" VerticalAlignment="Center" Padding="4,2"
                                          ToolTip="{Binding Pad_Socd_Mode_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Vertical" Margin="0,2,0,2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap" MaxWidth="260"
                                                           Visibility="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ComboBoxItem}}, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ui:Button Command="{Binding ResetSocdModeCommand}" Style="{StaticResource ResetButton}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           ToolTip="{Binding Pad_Socd_ResetMode_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                            </StackPanel>

                            <!-- Pair rows: named pickers on Xbox / PlayStation
                                 slots, raw index boxes on Extended slots.
                                 Never a raw text box for a pickable target. -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{Binding Pad_Socd_Pairs_Label, Source={x:Static strings:Strings.Instance}}"
                                           Width="140" VerticalAlignment="Top" Margin="0,4,0,0"
                                           ToolTip="{Binding Pad_Socd_Pairs_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                <StackPanel Orientation="Vertical">
                                    <ItemsControl ItemsSource="{Binding SocdPairItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,8,6">
                                                    <!-- Gamepad variant: two named pickers -->
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExtended}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <ComboBox ItemsSource="{Binding ButtonOptions}"
                                                                  SelectedValue="{Binding TargetA, Mode=TwoWay}"
                                                                  SelectedValuePath="Value" DisplayMemberPath="Display"
                                                                  MinWidth="72" VerticalAlignment="Center" Padding="4,2"
                                                                  ToolTip="{Binding Pad_Socd_ButtonA_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                        <TextBlock Text="/" VerticalAlignment="Center" Margin="3,0"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                        <ComboBox ItemsSource="{Binding ButtonOptions}"
                                                                  SelectedValue="{Binding TargetB, Mode=TwoWay}"
                                                                  SelectedValuePath="Value" DisplayMemberPath="Display"
                                                                  MinWidth="72" VerticalAlignment="Center" Padding="4,2"
                                                                  ToolTip="{Binding Pad_Socd_ButtonB_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                    </StackPanel>
                                                    <!-- Extended variant: two raw index boxes (0-127) -->
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExtended}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBox Text="{Binding IndexA, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="48"
                                                                 VerticalContentAlignment="Center" Padding="2,1"
                                                                 ToolTip="{Binding Pad_Socd_IndexA_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                        <TextBlock Text="/" VerticalAlignment="Center" Margin="3,0"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                        <TextBox Text="{Binding IndexB, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="48"
                                                                 VerticalContentAlignment="Center" Padding="2,1"
                                                                 ToolTip="{Binding Pad_Socd_IndexB_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                    </StackPanel>
                                                    <ui:Button Style="{StaticResource EmberIconButtonHot}"
                                                               VerticalAlignment="Center" Margin="2,0,0,0"
                                                               Command="{Binding DataContext.RemoveSocdPairCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding}">
                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                        <ui:Button.ToolTip>
                                                            <TextBlock Text="{Binding Pad_Socd_RemovePair_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                        </ui:Button.ToolTip>
                                                    </ui:Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Command="{Binding AddSocdPairCommand}" HorizontalAlignment="Left" Padding="10,4"
                                            ToolTip="{Binding Pad_Socd_AddPair_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Pad_Socd_AddPair, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- KBM twin of the SOCD card, discussion #205: the
                         same card face, bound to the slot's KbmConfig
                         (opposing key pairs on the virtual keyboard
                         output, Snap Tap style). Replaced the config bar
                         that used to sit under the preview. Mutually
                         exclusive with the gamepad card above. -->
                    <Border Grid.Row="4" Style="{StaticResource CardBorder}" Margin="0,8,0,0"
                            Visibility="{Binding KbmSocdCardVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Pad_Socd_Card_Header, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardTitle}"/>
                                <ui:Button Command="{Binding KbmConfig.ResetSocdCommand}" Style="{StaticResource ResetAllButton}"
                                           Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                           ToolTip="{Binding Pad_Socd_ResetCard_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Pad_Kbm_Socd_Card_Desc, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource CardDescription}"/>

                            <!-- Mode row -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding Pad_Socd_Mode_Label, Source={x:Static strings:Strings.Instance}}"
                                           Width="140" VerticalAlignment="Center"
                                           ToolTip="{Binding Pad_Kbm_Socd_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                <ComboBox ItemsSource="{Binding KbmConfig.AvailableSocdModes}"
                                          SelectedValue="{Binding KbmConfig.SocdMode, Mode=TwoWay}"
                                          SelectedValuePath="Value"
                                          MinWidth="170" VerticalAlignment="Center" Padding="4,2"
                                          ToolTip="{Binding Pad_Kbm_Socd_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Vertical" Margin="0,2,0,2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap" MaxWidth="260"
                                                           Visibility="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ComboBoxItem}}, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ui:Button Command="{Binding KbmConfig.ResetSocdModeCommand}" Style="{StaticResource ResetButton}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           ToolTip="{Binding Pad_Socd_ResetMode_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                            </StackPanel>

                            <!-- Pair rows: two key pickers per pair, sourced
                                 from the same key set as the KBM mapping
                                 targets. Never a raw text box. -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{Binding Pad_Kbm_Socd_Pairs_Label, Source={x:Static strings:Strings.Instance}}"
                                           Width="140" VerticalAlignment="Top" Margin="0,4,0,0"
                                           ToolTip="{Binding Pad_Kbm_Socd_Pairs_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                <StackPanel Orientation="Vertical">
                                    <ItemsControl ItemsSource="{Binding KbmConfig.SocdPairItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,8,6">
                                                    <ComboBox ItemsSource="{Binding KeyOptions}"
                                                              SelectedValue="{Binding VkA, Mode=TwoWay}"
                                                              SelectedValuePath="Vk" DisplayMemberPath="Label"
                                                              MinWidth="72" VerticalAlignment="Center" Padding="4,2"
                                                              ToolTip="{Binding Pad_Kbm_Socd_KeyA_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                    <TextBlock Text="/" VerticalAlignment="Center" Margin="3,0"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <ComboBox ItemsSource="{Binding KeyOptions}"
                                                              SelectedValue="{Binding VkB, Mode=TwoWay}"
                                                              SelectedValuePath="Vk" DisplayMemberPath="Label"
                                                              MinWidth="72" VerticalAlignment="Center" Padding="4,2"
                                                              ToolTip="{Binding Pad_Kbm_Socd_KeyB_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                    <ui:Button Style="{StaticResource EmberIconButtonHot}"
                                                               VerticalAlignment="Center" Margin="2,0,0,0"
                                                               Command="{Binding DataContext.KbmConfig.RemoveSocdPairCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding}">
                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                        <ui:Button.ToolTip>
                                                            <TextBlock Text="{Binding Pad_Kbm_Socd_RemovePair_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                        </ui:Button.ToolTip>
                                                    </ui:Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Command="{Binding KbmConfig.AddSocdPairCommand}" HorizontalAlignment="Left" Padding="10,4"
                                            ToolTip="{Binding Pad_Kbm_Socd_AddPair_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Pad_Kbm_Socd_AddPair, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ─── TAB 3: Sticks (dynamic) ─── -->
            <TabItem>
                <ScrollViewer Padding="24,0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <viewControls:LabeledShapeIcon Shape="Stick" Width="24" Height="24"
                                                            VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Pad_Sticks_Header, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource TitleTextBlockStyle}" FontFamily="{StaticResource DisplayFontFamily}" FontWeight="650" FontSize="26"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Pad_Sticks_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <ItemsControl ItemsSource="{Binding StickConfigs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StickConfigItem}">
                                <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <viewControls:LabeledShapeIcon Shape="Stick" Label="{Binding IconLabel}"
                                                                       Width="18" Height="18"
                                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <!-- Inline mono subtitle (#175 close-out item 18):
                                             deadzone shape + DZ%. Display-only, reuses the
                                             shape names already bound to the shape combo.
                                             Lives as a Span inside the title TextBlock so the
                                             mono text shares the title's baseline (#175
                                             typography), like the artifact's h3 span. -->
                                        <!-- Shape name rides a plain converter binding: a
                                             Style with bound Setters/DataTriggers on a Run
                                             inside a template recursed to a stack overflow
                                             through the error dialog (dump-confirmed
                                             2026-07-04). Direct Run.Text bindings are safe. -->
                                        <TextBlock Style="{StaticResource CardTitle}"><Run
                                                Text="{Binding Title, Mode=OneWay}"/><Run
                                                Text="  "/><Span FontFamily="{StaticResource TelemetryFontFamily}" FontSize="10"
                                                FontWeight="Normal"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"><Run
                                                Text="{Binding DeadZoneShapeIndex, Mode=OneWay, Converter={StaticResource DzShapeNameConverter}}"/><Run
                                                Text=" "/><Run
                                                Text="{Binding DeadZoneX, Mode=OneWay, StringFormat={}{0:0}%}"/><Run
                                                Text=" / "/><Run
                                                Text="{Binding DeadZoneY, Mode=OneWay, StringFormat={}{0:0}%}"/></Span></TextBlock>
                                        <ui:Button Command="{Binding ResetAllCommand}" Style="{StaticResource ResetAllButton}"
                                                Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                                ToolTip="{Binding ResetAllToolTip}"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Sliders (left) -->
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <!-- ─── Center point ─── -->
                                            <TextBlock Text="{Binding Pad_Sticks_Section_CenterPoint, Source={x:Static strings:Strings.Instance}}"
                                                       Style="{StaticResource CardSubsectionTitle}"/>
                                            <Button Margin="0,0,0,8"
                                                    Click="CalibrateCenter_Click"
                                                    Padding="8,4" HorizontalAlignment="Left">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Content" Value="{Binding Pad_CalibrateCenter, Source={x:Static strings:Strings.Instance}}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCalibrating}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                <Setter Property="Content" Value="{Binding Pad_Sampling, Source={x:Static strings:Strings.Instance}}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_CenterOffsetX, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <Slider Value="{Binding CenterOffsetX, Mode=TwoWay}"
                                                        Style="{StaticResource OffsetSlider}"/>
                                                <TextBox Text="{Binding CenterOffsetX, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                <TextBox Text="{Binding CenterOffsetXDigit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzDigitEdit}"/>
                                                <ui:Button Command="{Binding ResetCenterOffsetXCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetCenterOffsetX, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_CenterOffsetY, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <Slider Value="{Binding CenterOffsetY, Mode=TwoWay}"
                                                        Style="{StaticResource OffsetSlider}"/>
                                                <TextBox Text="{Binding CenterOffsetY, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                <TextBox Text="{Binding CenterOffsetYDigit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzDigitEdit}"/>
                                                <ui:Button Command="{Binding ResetCenterOffsetYCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetCenterOffsetY, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                            <Separator Margin="0,8,0,8"/>
                                            <!-- ─── Deadzone ─── -->
                                            <TextBlock Text="{Binding Pad_Sticks_Section_DeadZone, Source={x:Static strings:Strings.Instance}}"
                                                       Style="{StaticResource CardSubsectionTitle}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_DeadZoneShape, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <ComboBox AutomationProperties.AutomationId="DeadZoneShapeCombo"
                                                          SelectedIndex="{Binding DeadZoneShapeIndex, Mode=TwoWay}"
                                                          Width="200" VerticalAlignment="Center">
                                                    <ComboBoxItem Content="{Binding Pad_DZScaledRadial, Source={x:Static strings:Strings.Instance}}"/>
                                                    <ComboBoxItem Content="{Binding Pad_DZRadial, Source={x:Static strings:Strings.Instance}}"/>
                                                    <ComboBoxItem Content="{Binding Pad_DZAxial, Source={x:Static strings:Strings.Instance}}"/>
                                                    <ComboBoxItem Content="{Binding Pad_DZHybrid, Source={x:Static strings:Strings.Instance}}"/>
                                                    <ComboBoxItem Content="{Binding Pad_DZSlopedScaledAxial, Source={x:Static strings:Strings.Instance}}"/>
                                                    <ComboBoxItem Content="{Binding Pad_DZSlopedAxial, Source={x:Static strings:Strings.Instance}}"/>
                                                </ComboBox>
                                                <ui:Button Command="{Binding ResetDeadZoneShapeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetDeadZoneShape, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_DeadZoneX, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <Slider Value="{Binding DeadZoneX, Mode=TwoWay}"
                                                        Style="{StaticResource DzSlider}"/>
                                                <TextBox Text="{Binding DeadZoneX, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                <TextBox Text="{Binding DeadZoneXDigit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzDigitEdit}"/>
                                                <ui:Button Command="{Binding ResetDeadZoneXCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetDeadZoneX, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_DeadZoneY, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <Slider Value="{Binding DeadZoneY, Mode=TwoWay}"
                                                        Style="{StaticResource DzSlider}"/>
                                                <TextBox Text="{Binding DeadZoneY, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                <TextBox Text="{Binding DeadZoneYDigit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzDigitEdit}"/>
                                                <ui:Button Command="{Binding ResetDeadZoneYCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetDeadZoneY, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_AntiDeadZoneX, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <Slider Value="{Binding AntiDeadZoneX, Mode=TwoWay}"
                                                        Style="{StaticResource DzSlider}"/>
                                                <TextBox Text="{Binding AntiDeadZoneX, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                <TextBox Text="{Binding AntiDeadZoneXDigit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzDigitEdit}"/>
                                                <ui:Button Command="{Binding ResetAntiDeadZoneXCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetAntiDeadZoneX, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_AntiDeadZoneY, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <Slider Value="{Binding AntiDeadZoneY, Mode=TwoWay}"
                                                        Style="{StaticResource DzSlider}"/>
                                                <TextBox Text="{Binding AntiDeadZoneY, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                <TextBox Text="{Binding AntiDeadZoneYDigit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzDigitEdit}"/>
                                                <ui:Button Command="{Binding ResetAntiDeadZoneYCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetAntiDeadZoneY, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_Linear, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <Slider Value="{Binding Linear, Mode=TwoWay}"
                                                        Style="{StaticResource DzSlider}"/>
                                                <TextBox Text="{Binding Linear, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                <ui:Button Command="{Binding ResetLinearCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetLinear, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                            <!-- Speed multiplier: pointer sticks ONLY (keyboard-and-mouse
                                                 stick 0 = mouse movement, stick 1 = scroll wheel). Those are
                                                 rate outputs, so a multiplier is the right instrument. It is
                                                 deliberately absent on a gamepad stick, where the deadzone
                                                 stage has already mapped full deflection to full scale and the
                                                 per-axis curves below own the shaping (owner ruling
                                                 2026-07-27). -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                                        Visibility="{Binding IsPointerStick, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Macro_Sensitivity, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <Slider Value="{Binding Sensitivity, Mode=TwoWay}"
                                                        Minimum="0.1" Maximum="5" SmallChange="0.1" LargeChange="0.5"
                                                        Style="{StaticResource DzSlider}"/>
                                                <TextBox Text="{Binding Sensitivity, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Text="&#215;" Style="{StaticResource DzPercent}"/>
                                                <ui:Button Command="{Binding ResetStickSensitivityCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Common_Reset, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                            <Separator Margin="0,8,0,8"/>
                                            <!-- ─── Sensitivity curves ─── -->
                                            <TextBlock Text="{Binding Pad_SensitivityCurves, Source={x:Static strings:Strings.Instance}}"
                                                       Style="{StaticResource CardSubsectionTitle}"/>
                                            <TextBlock Text="{Binding Pad_SensitivityCurveHint, Source={x:Static strings:Strings.Instance}}"
                                                       Style="{StaticResource CardDescription}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_SensitivityX, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <!-- Instance binding, NOT x:Static: an x:Static ItemsSource never
                                                     refreshes on a live language change. -->
                                                <ComboBox AutomationProperties.AutomationId="SensitivityXCombo"
                                                          Width="120"
                                                          ItemsSource="{Binding CurvePresetChoices}"
                                                          SelectedItem="{Binding PresetNameX, Mode=OneWay}"
                                                          SelectionChanged="StickPresetX_SelectionChanged"
                                                          Tag="{Binding}"/>
                                                <ui:Button Command="{Binding ResetSensitivityXCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetSensitivityX, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_SensitivityY, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <ComboBox Width="120"
                                                          ItemsSource="{Binding CurvePresetChoices}"
                                                          SelectedItem="{Binding PresetNameY, Mode=OneWay}"
                                                          SelectionChanged="StickPresetY_SelectionChanged"
                                                          Tag="{Binding}"/>
                                                <ui:Button Command="{Binding ResetSensitivityYCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetSensitivityY, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                            <!-- Full-width forge canvases (#175 competitor item 4):
                                                 the sensitivity curves grown to card width under the
                                                 X/Y preset dropdowns. Dashed steel reference diagonal,
                                                 ember drag readout, live RAW dot ride inside the
                                                 control. Same bindings as the radar-sidebar mini-plots
                                                 (which stay), so edits in either place round-trip
                                                 through the same curve strings. -->
                                            <TextBlock Text="{Binding Pad_XAxis, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}"
                                                       HorizontalAlignment="Left" Width="560" TextAlignment="Center"
                                                       FontFamily="{StaticResource TelemetryFontFamily}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       FontSize="10" Margin="0,4,0,2"/>
                                            <controls:CurveEditor
                                                CurveString="{Binding SensitivityCurveX, Mode=TwoWay}"
                                                DeadZone="{Binding DeadZoneX}"
                                                MaxRange="{Binding MaxRangeX}"
                                                MaxRangeNeg="{Binding MaxRangeXNeg}"
                                                LiveInput="{Binding LiveInputX}"
                                                IsSigned="True" IsFullWidth="True" ChartHeight="150" Width="560" HorizontalAlignment="Left"
                                                Margin="0,0,0,8"/>
                                            <TextBlock Text="{Binding Pad_YAxis, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}"
                                                       HorizontalAlignment="Left" Width="560" TextAlignment="Center"
                                                       FontFamily="{StaticResource TelemetryFontFamily}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       FontSize="10" Margin="0,0,0,2"/>
                                            <controls:CurveEditor
                                                CurveString="{Binding SensitivityCurveY, Mode=TwoWay}"
                                                DeadZone="{Binding DeadZoneY}"
                                                MaxRange="{Binding MaxRangeYNeg}"
                                                MaxRangeNeg="{Binding MaxRangeY}"
                                                LiveInput="{Binding LiveInputY}"
                                                IsSigned="True" IsFullWidth="True" ChartHeight="150" Width="560" HorizontalAlignment="Left"/>
                                            <Separator Margin="0,8,0,8"/>
                                            <!-- ─── Range ─── -->
                                            <TextBlock Text="{Binding Pad_Sticks_Section_Range, Source={x:Static strings:Strings.Instance}}"
                                                       Style="{StaticResource CardSubsectionTitle}"/>
                                            <!-- Which tool is which (user report 2026-07-06): the
                                                 measured 360-degree calibration and the four manual
                                                 cardinal caps sat side by side with nothing saying
                                                 why the calibration is the correction and the
                                                 sliders are the deliberate limiter. -->
                                            <TextBlock Text="{Binding Pad_Sticks_Section_Range_Hint, Source={x:Static strings:Strings.Instance}}"
                                                       Style="{StaticResource CardDescription}"/>
                                            <!-- Boundary calibration (#174): the outer-boundary
                                                 counterpart to the manual range sliders below. One
                                                 button (coverage-driven inline sweep, same idiom as
                                                 Calibrate center) plus a per-canon Reset. The measured
                                                 shape draws on the radar to the right. -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                                        Visibility="{Binding SupportsBoundaryCalibration, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Button Command="{Binding CalibrateBoundaryCommand}"
                                                        Content="{Binding BoundaryButtonText}"
                                                        Padding="8,4" HorizontalAlignment="Left"
                                                        ToolTip="{Binding Pad_Sticks_Boundary_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <ui:Button Command="{Binding ResetBoundaryCommand}"
                                                           Style="{StaticResource ResetButton}"
                                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                                           ToolTip="{Binding Pad_ResetStickBoundary, Source={x:Static strings:Strings.Instance}}"/>
                                                <TextBlock Text="{Binding BoundaryCircularityText}"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11"
                                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_MinRangeXLeft, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <Slider Value="{Binding MaxRangeXNeg, Mode=TwoWay}"
                                                        Minimum="1" Maximum="100"
                                                        Style="{StaticResource DzSlider}"/>
                                                <TextBox Text="{Binding MaxRangeXNeg, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                <TextBox Text="{Binding MaxRangeXNegDigit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzDigitEdit}"/>
                                                <ui:Button Command="{Binding ResetMaxRangeXNegCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetMinRangeX, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_MaxRangeXRight, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <Slider Value="{Binding MaxRangeX, Mode=TwoWay}"
                                                        Minimum="1" Maximum="100"
                                                        Style="{StaticResource DzSlider}"/>
                                                <TextBox Text="{Binding MaxRangeX, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                <TextBox Text="{Binding MaxRangeXDigit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzDigitEdit}"/>
                                                <ui:Button Command="{Binding ResetMaxRangeXCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetMaxRangeX, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_MinRangeYDown, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <Slider Value="{Binding MaxRangeY, Mode=TwoWay}"
                                                        Minimum="1" Maximum="100"
                                                        Style="{StaticResource DzSlider}"/>
                                                <TextBox Text="{Binding MaxRangeY, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                <TextBox Text="{Binding MaxRangeYDigit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzDigitEdit}"/>
                                                <ui:Button Command="{Binding ResetMaxRangeYCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetMinRangeY, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_MaxRangeYUp, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <Slider Value="{Binding MaxRangeYNeg, Mode=TwoWay}"
                                                        Minimum="1" Maximum="100"
                                                        Style="{StaticResource DzSlider}"/>
                                                <TextBox Text="{Binding MaxRangeYNeg, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                <TextBox Text="{Binding MaxRangeYNegDigit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzDigitEdit}"/>
                                                <ui:Button Command="{Binding ResetMaxRangeYNegCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetMaxRangeY, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Live preview (right): inset instrument panel (#175
                                             iteration 21, matching the trigger instrument). -->
                                        <Border Grid.Column="1" VerticalAlignment="Top"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel MinWidth="216">
                                            <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="8"
                                                    Padding="4" Width="212" Height="212"
                                                    ClipToBounds="True">
                                                <Grid Width="200" Height="200">
                                                    <!-- Radar ground (#175 artifact): near-black plot
                                                         with steel rings at 33/66/100%. -->
                                                    <Ellipse Width="200" Height="200" Fill="Transparent" Stroke="#FF253049" StrokeThickness="1"/>
                                                    <Ellipse Width="66" Height="66" Stroke="#FF1E2739" StrokeThickness="1" Fill="Transparent"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Ellipse Width="132" Height="132" Stroke="#FF1E2739" StrokeThickness="1" Fill="Transparent"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Line X1="100" Y1="6" X2="100" Y2="194" Stroke="#FF1E2739" StrokeThickness="1"/>
                                                    <Line X1="6" Y1="100" X2="194" Y2="100" Stroke="#FF1E2739" StrokeThickness="1"/>
                                                    <Canvas>
                                                        <!-- Measured boundary (#174): the reachable rim from the
                                                             last (or in-progress) sweep, in the ember grammar,
                                                             plotted in the same 200x200 space as the dots. The
                                                             outer ring above is the ideal-circle reference, so the
                                                             gap between them IS the calibration. Empty point
                                                             collection when uncalibrated draws nothing. -->
                                                        <Polygon Points="{Binding BoundaryPolygonPoints}"
                                                                 Stroke="{DynamicResource EmberBrush}" StrokeThickness="1.5"
                                                                 Fill="#14FF6B2C" IsHitTestVisible="False"/>
                                                        <!-- Legacy stock rings removed (#175 close-out item 25):
                                                             the radar keeps the #1E2739 rings + crosshair above;
                                                             below sit the DZ steel fill, the dashed ember DZ
                                                             circle, and the anti-DZ ember ring. -->
<!-- Dead zone geometry (#175, user direction 2026-07-04:
                                                             restore the old UI's per-shape overlays - each shape
                                                             draws its own dashed outline with shading, and the
                                                             components overlap). Two tiers in the ember palette:
                                                             fully dead = ashen fill + ember-deep dash; snapped to
                                                             axis (partial) = fainter fill + fainter dash. The old
                                                             always-on ellipse ring is gone: it painted a circle
                                                             over non-radial shapes. Converters are the proven
                                                             legacy pair. -->
                                                        <!-- Axial: cross arms - snapped to axis (partial tier). -->
                                                        <Path Fill="#18253049" Stroke="#5AC43D0C" StrokeThickness="1" StrokeDashArray="3 4"
                                                              IsHitTestVisible="False"
                                                              Visibility="{Binding IsAxialShape, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <Path.Data>
                                                                <MultiBinding Converter="{StaticResource CrossGeometryConverter}">
                                                                    <Binding Path="DeadZoneX"/>
                                                                    <Binding Path="DeadZoneY"/>
                                                                </MultiBinding>
                                                            </Path.Data>
                                                        </Path>
                                                        <!-- Axial: center rectangle - fully dead. -->
                                                        <Rectangle Fill="#2E253049" Stroke="#8CC43D0C" StrokeThickness="1" StrokeDashArray="3 4"
                                                                   IsHitTestVisible="False"
                                                                   Visibility="{Binding IsAxialShape, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <Rectangle.Width>
                                                                <Binding Path="DeadZoneX" Converter="{StaticResource PercentToSizeConverter}" ConverterParameter="200"/>
                                                            </Rectangle.Width>
                                                            <Rectangle.Height>
                                                                <Binding Path="DeadZoneY" Converter="{StaticResource PercentToSizeConverter}" ConverterParameter="200"/>
                                                            </Rectangle.Height>
                                                            <Rectangle.RenderTransform>
                                                                <TranslateTransform>
                                                                    <TranslateTransform.X>
                                                                        <Binding Path="DeadZoneX" Converter="{StaticResource PercentToSizeConverter}" ConverterParameter="-100"/>
                                                                    </TranslateTransform.X>
                                                                    <TranslateTransform.Y>
                                                                        <Binding Path="DeadZoneY" Converter="{StaticResource PercentToSizeConverter}" ConverterParameter="-100"/>
                                                                    </TranslateTransform.Y>
                                                                </TranslateTransform>
                                                            </Rectangle.RenderTransform>
                                                            <Canvas.Left>100</Canvas.Left>
                                                            <Canvas.Top>100</Canvas.Top>
                                                        </Rectangle>
                                                        <!-- Radial pair + Hybrid's radial stage: ellipse - fully dead. -->
                                                        <Ellipse Fill="#2E253049" Stroke="#8CC43D0C" StrokeThickness="1" StrokeDashArray="3 4"
                                                                 IsHitTestVisible="False">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsRadialShape}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsHybridShape}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                            <Ellipse.Width>
                                                                <Binding Path="DeadZoneX" Converter="{StaticResource PercentToSizeConverter}" ConverterParameter="200"/>
                                                            </Ellipse.Width>
                                                            <Ellipse.Height>
                                                                <Binding Path="DeadZoneY" Converter="{StaticResource PercentToSizeConverter}" ConverterParameter="200"/>
                                                            </Ellipse.Height>
                                                            <Ellipse.RenderTransform>
                                                                <TranslateTransform>
                                                                    <TranslateTransform.X>
                                                                        <Binding Path="DeadZoneX" Converter="{StaticResource PercentToSizeConverter}" ConverterParameter="-100"/>
                                                                    </TranslateTransform.X>
                                                                    <TranslateTransform.Y>
                                                                        <Binding Path="DeadZoneY" Converter="{StaticResource PercentToSizeConverter}" ConverterParameter="-100"/>
                                                                    </TranslateTransform.Y>
                                                                </TranslateTransform>
                                                            </Ellipse.RenderTransform>
                                                            <Canvas.Left>100</Canvas.Left>
                                                            <Canvas.Top>100</Canvas.Top>
                                                        </Ellipse>
                                                        <!-- Sloped pair + Hybrid: wedges - snapped to axis (partial tier). -->
                                                        <Path Fill="#18253049" Stroke="#5AC43D0C" StrokeThickness="1" StrokeDashArray="3 4"
                                                              IsHitTestVisible="False"
                                                              Visibility="{Binding HasSlopedWedges, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <Path.Data>
                                                                <MultiBinding Converter="{StaticResource SlopedWedgeGeometryConverter}">
                                                                    <Binding Path="DeadZoneX"/>
                                                                    <Binding Path="DeadZoneY"/>
                                                                </MultiBinding>
                                                            </Path.Data>
                                                        </Path>
                                                        <!-- Anti-deadzone ring (#175 competitor item 3): thin ember
                                                             circle at the output-floor radius, same percent-to-plot
                                                             mapping as the DZ ring (rx = AntiDeadZoneX%, ry =
                                                             AntiDeadZoneY%). Collapsed while both axes sit at 0. -->
                                                        <Ellipse Fill="Transparent" Stroke="#80FF6B2C" StrokeThickness="1"
                                                                 IsHitTestVisible="False">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding AntiDeadZoneX}" Value="0"/>
                                                                                <Condition Binding="{Binding AntiDeadZoneY}" Value="0"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                            <Ellipse.Width>
                                                                <Binding Path="AntiDeadZoneX" Converter="{StaticResource PercentToSizeConverter}" ConverterParameter="200"/>
                                                            </Ellipse.Width>
                                                            <Ellipse.Height>
                                                                <Binding Path="AntiDeadZoneY" Converter="{StaticResource PercentToSizeConverter}" ConverterParameter="200"/>
                                                            </Ellipse.Height>
                                                            <Ellipse.RenderTransform>
                                                                <TranslateTransform>
                                                                    <TranslateTransform.X>
                                                                        <Binding Path="AntiDeadZoneX" Converter="{StaticResource PercentToSizeConverter}" ConverterParameter="-100"/>
                                                                    </TranslateTransform.X>
                                                                    <TranslateTransform.Y>
                                                                        <Binding Path="AntiDeadZoneY" Converter="{StaticResource PercentToSizeConverter}" ConverterParameter="-100"/>
                                                                    </TranslateTransform.Y>
                                                                </TranslateTransform>
                                                            </Ellipse.RenderTransform>
                                                            <Canvas.Left>100</Canvas.Left>
                                                            <Canvas.Top>100</Canvas.Top>
                                                        </Ellipse>
                                                        <!-- Stick position dot -->
                                                        <!-- Two-stage (#175): raw hardware in cold under the
                                                             forged output in ember. Trail behavior draws the
                                                             artifact comet (46 fading dots per signal). Peak-hold
                                                             (#175 competitor item 3) rides the same canvas: an
                                                             ember rim tick at the max recorded OUT deflection,
                                                             decaying over ~3s, writing its % into PeakReadout. -->
                                                        <Canvas common:StickTrailBehavior.IsEnabled="True"
                                                                common:StickPeakHoldBehavior.IsEnabled="True"
                                                                common:StickPeakHoldBehavior.Readout="{Binding ElementName=PeakReadout}"
                                                                Width="200" Height="200"/>
                                                        <Ellipse Width="9" Height="9" Fill="#FF58B6E4"
                                                                 Stroke="#FF2E6A8F" StrokeThickness="1" Opacity="0.9"
                                                                 Canvas.Left="{Binding RawPosX, Converter={StaticResource NormToCanvasConverter}, ConverterParameter='200,9'}"
                                                                 Canvas.Top="{Binding RawPosY, Converter={StaticResource NormToCanvasConverter}, ConverterParameter='200,9'}">
                                                            <Ellipse.Effect>
                                                                <DropShadowEffect Color="#58B6E4" BlurRadius="9" ShadowDepth="0" Opacity="0.9"/>
                                                            </Ellipse.Effect>
                                                        </Ellipse>
                                                        <Ellipse Width="11" Height="11" Fill="{DynamicResource EmberHotBrush}"
                                                                 Stroke="{DynamicResource EmberDeepBrush}" StrokeThickness="1"
                                                                 Canvas.Left="{Binding LiveX, Converter={StaticResource NormToCanvasConverter}, ConverterParameter='200,11'}"
                                                                 Canvas.Top="{Binding LiveY, Converter={StaticResource NormToCanvasConverter}, ConverterParameter='200,11'}">
                                                            <Ellipse.Effect>
                                                                <DropShadowEffect Color="#FF8228" BlurRadius="12" ShadowDepth="0" Opacity="0.95"/>
                                                            </Ellipse.Effect>
                                                        </Ellipse>
                                                    </Canvas>
                                                </Grid>
                                            </Border>
                                            <!-- Radar legend + peak readout (#175 competitor item 3):
                                                 one quiet mono row aligned to the radar edges. Chips
                                                 follow the ChipCold / ChipEmber / steel tint grammar at
                                                 legend scale (mono 9px). RAW/OUT reuse the instrument
                                                 caption strings; DZ and PEAK are locale-neutral
                                                 telemetry tokens like the axis-unit formats in
                                                 StickConfigItem. PeakReadout's value text is written by
                                                 StickPeakHoldBehavior. -->
                                            <DockPanel Width="212" Margin="0,8,0,0" HorizontalAlignment="Center" LastChildFill="False">
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                    <Border Background="#1A58B6E4" BorderBrush="#5958B6E4" BorderThickness="1"
                                                            CornerRadius="8" Padding="6,1" Margin="0,0,4,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="5" Height="5" Fill="{DynamicResource ColdBrush}"
                                                                     VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBlock Text="{Binding Instr_Raw, Source={x:Static strings:Strings.Instance}}"
                                                                       FontFamily="{StaticResource TelemetryFontFamily}" FontSize="9"
                                                                       Foreground="{DynamicResource ColdBrush}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="#1AFF6B2C" BorderBrush="#66FF6B2C" BorderThickness="1"
                                                            CornerRadius="8" Padding="6,1" Margin="0,0,4,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="5" Height="5" Fill="{DynamicResource EmberHotBrush}"
                                                                     VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBlock Text="{Binding Instr_Out, Source={x:Static strings:Strings.Instance}}"
                                                                       FontFamily="{StaticResource TelemetryFontFamily}" FontSize="9"
                                                                       Foreground="{DynamicResource EmberHotBrush}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="Transparent" BorderBrush="{DynamicResource SteelLineBrush}" BorderThickness="1"
                                                            CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <!-- Swatch mirrors the plot: steel fill + ember edge. -->
                                                            <Rectangle Width="7" Height="5" RadiusX="1" RadiusY="1"
                                                                       Fill="#2E253049" Stroke="#8CC43D0C" StrokeThickness="1"
                                                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBlock Text="DZ"
                                                                       FontFamily="{StaticResource TelemetryFontFamily}" FontSize="9"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="PEAK"
                                                               FontFamily="{StaticResource TelemetryFontFamily}" FontSize="9"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock x:Name="PeakReadout" Text="0%"
                                                               FontFamily="{StaticResource TelemetryFontFamily}" FontSize="9"
                                                               Foreground="{DynamicResource EmberHotBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <!-- Readout (#175): RAW (pre-pipeline, cold) over OUT
                                                 (forged, ember), original number format. Fixed-width
                                                 grid so changing values never resize the instrument. -->
                                            <Grid HorizontalAlignment="Center" Margin="0,10,0,0" Width="300">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                           Text="{Binding Instr_Raw, Source={x:Static strings:Strings.Instance}}"
                                                           FontFamily="{StaticResource TelemetryFontFamily}"
                                                           FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1"
                                                           Text="{Binding InDisplay, Mode=OneWay}"
                                                           FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11.5"
                                                           Foreground="{DynamicResource ColdBrush}"/>
                                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,3,0,0"
                                                           Text="{Binding Instr_Out, Source={x:Static strings:Strings.Instance}}"
                                                           FontFamily="{StaticResource TelemetryFontFamily}"
                                                           FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,3,0,0"
                                                           Text="{Binding RawDisplay, Mode=OneWay}"
                                                           FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11.5"
                                                           Foreground="{DynamicResource EmberHotBrush}"/>
                                            </Grid>

                                            <!-- Per-axis sensitivity curve editors -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                                <!-- X axis curve editor -->
                                                <StackPanel Margin="0,0,4,0">
                                                    <!-- Instrument caption idiom (#175 typography): mono
                                                         10 tertiary, uppercase display-only via UpperConverter
                                                         (resource strings stay Title Case). -->
                                                    <TextBlock Text="{Binding Pad_XAxis, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}" HorizontalAlignment="Center"
                                                               FontFamily="{StaticResource TelemetryFontFamily}"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               FontSize="10" Margin="0,0,0,2"/>
                                                    <controls:CurveEditor
                                                        CurveString="{Binding SensitivityCurveX, Mode=TwoWay}"
                                                        DeadZone="{Binding DeadZoneX}"
                                                        MaxRange="{Binding MaxRangeX}"
                                                        MaxRangeNeg="{Binding MaxRangeXNeg}"
                                                        LiveInput="{Binding LiveInputX}"
                                                        IsSigned="True" ChartSize="96"/>
                                                </StackPanel>
                                                <!-- Y axis curve editor -->
                                                <StackPanel Margin="4,0,0,0">
                                                    <TextBlock Text="{Binding Pad_YAxis, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}" HorizontalAlignment="Center"
                                                               FontFamily="{StaticResource TelemetryFontFamily}"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               FontSize="10" Margin="0,0,0,2"/>
                                                    <controls:CurveEditor
                                                        CurveString="{Binding SensitivityCurveY, Mode=TwoWay}"
                                                        DeadZone="{Binding DeadZoneY}"
                                                        MaxRange="{Binding MaxRangeYNeg}"
                                                        MaxRangeNeg="{Binding MaxRangeY}"
                                                        LiveInput="{Binding LiveInputY}"
                                                        IsSigned="True" ChartSize="96"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- ═══ Steering (winding / 2D angle-to-axis / motion lean) #94 — divider-separated section like the rest of the card ═══ -->
                                    <Separator Margin="0,16,0,8"/>
                                    <StackPanel>
                                            <!-- ─── Steering ─── -->
                                            <TextBlock Text="{Binding Pad_Steering_Header, Source={x:Static strings:Strings.Instance}}"
                                                       Style="{StaticResource CardSubsectionTitle}"/>
                                            <TextBlock Text="{Binding Pad_Steering_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                                       Style="{StaticResource CardDescription}"/>

                                            <!-- Mode -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_Steering_Mode, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <ComboBox SelectedIndex="{Binding SteeringModeIndex, Mode=TwoWay}" Width="200" VerticalAlignment="Center">
                                                    <ComboBoxItem Content="{Binding Pad_Steering_Mode_Linear, Source={x:Static strings:Strings.Instance}}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Steering_Mode_Winding, Source={x:Static strings:Strings.Instance}}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Steering_Mode_AngleX, Source={x:Static strings:Strings.Instance}}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Steering_Mode_AngleY, Source={x:Static strings:Strings.Instance}}"/>
                                                </ComboBox>
                                                <ui:Button Command="{Binding ResetSteeringModeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_Mode, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>

                                            <!-- Winding parameters -->
                                            <StackPanel Visibility="{Binding IsWindingMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Pad_Steering_WindRange, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                    <Slider Value="{Binding WindRangeDeg, Mode=TwoWay}" Minimum="90" Maximum="2520" Style="{StaticResource DzSlider}"/>
                                                    <TextBox Text="{Binding WindRangeDeg, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                                    <TextBlock Text="&#176;" Style="{StaticResource DzPercent}"/>
                                                    <ui:Button Command="{Binding ResetWindRangeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_WindRange, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Pad_Steering_WindPower, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                    <Slider Value="{Binding WindPower, Mode=TwoWay}" Minimum="0" Maximum="4" Style="{StaticResource DzSlider}"/>
                                                    <TextBox Text="{Binding WindPower, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                                    <ui:Button Command="{Binding ResetWindPowerCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_WindPower, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Pad_Steering_WindUnwindRate, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                    <Slider Value="{Binding WindUnwindRate, Mode=TwoWay}" Minimum="0" Maximum="10000" Style="{StaticResource DzSlider}"/>
                                                    <TextBox Text="{Binding WindUnwindRate, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                                    <ui:Button Command="{Binding ResetWindUnwindRateCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_WindUnwindRate, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Angle-to-axis parameters -->
                                            <StackPanel Visibility="{Binding IsAngleMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Pad_Steering_AngleInnerDz, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                    <Slider Value="{Binding AngleInnerDz, Mode=TwoWay}" Minimum="0" Maximum="89" Style="{StaticResource DzSlider}"/>
                                                    <TextBox Text="{Binding AngleInnerDz, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                                    <TextBlock Text="&#176;" Style="{StaticResource DzPercent}"/>
                                                    <ui:Button Command="{Binding ResetAngleInnerDzCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_AngleInnerDz, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Pad_Steering_AngleOuterDz, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                    <Slider Value="{Binding AngleOuterDz, Mode=TwoWay}" Minimum="0" Maximum="89" Style="{StaticResource DzSlider}"/>
                                                    <TextBox Text="{Binding AngleOuterDz, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                                    <TextBlock Text="&#176;" Style="{StaticResource DzPercent}"/>
                                                    <ui:Button Command="{Binding ResetAngleOuterDzCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_AngleOuterDz, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                            </StackPanel>

                                        </StackPanel>

                                </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ═══ Steering at-lock feedback (#94) — per device, all opt-in.
                         Channels are shown only when the SELECTED assigned device can
                         do them (SyncTabVisibility gates each by capability). ═══ -->
                    <Border x:Name="LockFeedbackCard" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <!-- Steering wheel flanked by vibration waves: the wheel hits its
                                     lock and you feel the cue. -->
                                <Viewbox Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="{DynamicResource EmberBrush}" StrokeThickness="1.7"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M5,12 A7,7 0 1 1 19,12 A7,7 0 1 1 5,12 Z M10.1,12 A1.9,1.9 0 1 1 13.9,12 A1.9,1.9 0 1 1 10.1,12 Z M10.1,12 L5,12 M13.9,12 L19,12 M12,13.9 L12,19 M3.7,9.8 A2.9,2.9 0 0 0 3.7,14.2 M2,8.5 A4.6,4.6 0 0 0 2,15.5 M20.3,9.8 A2.9,2.9 0 0 1 20.3,14.2 M22,8.5 A4.6,4.6 0 0 1 22,15.5"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{Binding Pad_Steering_LockFeedback, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardTitle}"/>
                                <ui:Button Command="{Binding ResetSteeringLockAllCommand}" Style="{StaticResource ResetAllButton}"
                                        Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                        ToolTip="{Binding Pad_Steering_Reset_LockFeedback, Source={x:Static strings:Strings.Instance}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Pad_Steering_LockFeedback_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource CardDescription}"/>
                            <!-- Each channel is a checkbox + its own reset (off), so every row
                                 in the card has a reset like the sliders below. Visibility is
                                 gated per row by SyncTabVisibility to the device's capability. -->
                            <StackPanel x:Name="LockRumbleRow" Orientation="Horizontal" Margin="0,0,0,4">
                                <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsChecked="{Binding SteeringLockRumbleEnabled, Mode=TwoWay}" VerticalAlignment="Center"
                                          Content="{Binding Pad_Steering_Lock_Rumble, Source={x:Static strings:Strings.Instance}}"/>
                                <ui:Button Command="{Binding ResetSteeringLockRumbleCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_Rumble, Source={x:Static strings:Strings.Instance}}"/>
                            </StackPanel>
                            <StackPanel x:Name="LockTriggerVibRow" Orientation="Horizontal" Margin="0,0,0,4">
                                <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsChecked="{Binding SteeringLockTriggerVibEnabled, Mode=TwoWay}" VerticalAlignment="Center"
                                          Content="{Binding Pad_Steering_Lock_TriggerVib, Source={x:Static strings:Strings.Instance}}"/>
                                <ui:Button Command="{Binding ResetSteeringLockTriggerVibCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_TriggerVib, Source={x:Static strings:Strings.Instance}}"/>
                            </StackPanel>
                            <StackPanel x:Name="LockLightbarRow" Orientation="Horizontal" Margin="0,0,0,4">
                                <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsChecked="{Binding SteeringLockLightbarEnabled, Mode=TwoWay}" VerticalAlignment="Center"
                                          Content="{Binding Pad_Steering_Lock_Lightbar, Source={x:Static strings:Strings.Instance}}"/>
                                <ui:Button Command="{Binding ResetSteeringLockLightbarCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_Lightbar, Source={x:Static strings:Strings.Instance}}"/>
                            </StackPanel>
                            <StackPanel x:Name="LockResistanceRow" Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsChecked="{Binding SteeringLockATResistanceEnabled, Mode=TwoWay}" VerticalAlignment="Center"
                                          Content="{Binding Pad_Steering_Lock_ATResistance, Source={x:Static strings:Strings.Instance}}"/>
                                <ui:Button Command="{Binding ResetSteeringLockResistanceCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_ATResistance, Source={x:Static strings:Strings.Instance}}"/>
                            </StackPanel>
                            <!-- Pulse length — the rumble / trigger pulse duration. The lightbar has its
                                 own Hold + Decay below, so this no longer covers it. -->
                            <StackPanel x:Name="LockPulseSection">
                                <Separator Margin="0,8,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <TextBlock Text="{Binding Pad_Steering_Lock_PulseMs, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding SteeringLockPulseMs, Mode=TwoWay}" Minimum="0" Maximum="2000" Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding SteeringLockPulseMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="ms" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetSteeringLockPulseCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_PulseMs, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- Lightbar colour + fade — only meaningful on a device with a lightbar. -->
                            <StackPanel x:Name="LockLightbarSection">
                            <Separator Margin="0,8,0,8"/>
                            <!-- Color source: Base color (Fixed) / Random Hue / Palette Step — the three
                                 macro lightbar modes, with a palette dedicated to the steering lock. -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="{Binding Macro_LightbarColorSource_Label, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                <ComboBox SelectedValue="{Binding SteeringLockLightbarColorSource, Mode=TwoWay}" SelectedValuePath="Tag" Width="200" VerticalAlignment="Center">
                                    <ComboBoxItem Content="{Binding Macro_LightbarColorSource_Fixed, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroLightbarColorSource.Fixed}"/>
                                    <ComboBoxItem Content="{Binding Macro_LightbarColorSource_RandomHue, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroLightbarColorSource.RandomHue}"/>
                                    <ComboBoxItem Content="{Binding Macro_LightbarColorSource_PaletteStep, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroLightbarColorSource.PaletteStep}"/>
                                </ComboBox>
                            </StackPanel>
                            <!-- Fixed base color — full picker in a bounding box (matches every other
                                 colour picker): HSV box, swatch, hex field, RGB sliders + per-channel resets.
                                 Shown only for the Fixed source. -->
                            <StackPanel Visibility="{Binding IsSteeringLockLightbarFixedColorVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Steering_Lock_LightbarColor, Source={x:Static strings:Strings.Instance}}" Margin="0,0,0,4"/>
                            <Border BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8"
                                    HorizontalAlignment="Left"
                                    BorderBrush="{DynamicResource TextFillColorDisabledBrush}">
                                <StackPanel>
                                    <views:ColorPickerControl Margin="0,0,0,12" HorizontalAlignment="Left"
                                        Red="{Binding SteeringLockColorR, Mode=TwoWay}"
                                        Green="{Binding SteeringLockColorG, Mode=TwoWay}"
                                        Blue="{Binding SteeringLockColorB, Mode=TwoWay}"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="48" Height="36" CornerRadius="4" HorizontalAlignment="Left"
                                                BorderBrush="{DynamicResource TextFillColorDisabledBrush}" BorderThickness="1">
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                                    <Binding Path="SteeringLockColorR"/>
                                                    <Binding Path="SteeringLockColorG"/>
                                                    <Binding Path="SteeringLockColorB"/>
                                                </MultiBinding>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Grid.Column="1" Text="{Binding Pad_Lighting_Hex, Source={x:Static strings:Strings.Instance}}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <TextBox Grid.Column="2" Width="100" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                 FontFamily="{StaticResource TelemetryFontFamily}" Padding="6,4"
                                                 Text="{Binding SteeringLockLightbarColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="{Binding Pad_Lighting_HexTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="R" Style="{StaticResource DzLabelTight}" Foreground="#FFD32F2F"/>
                                        <Slider Value="{Binding SteeringLockColorR, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                        <TextBox Text="{Binding SteeringLockColorR, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                        <ui:Button Command="{Binding ResetSteeringLockColorRCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarRed, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="G" Style="{StaticResource DzLabelTight}" Foreground="#FF388E3C"/>
                                        <Slider Value="{Binding SteeringLockColorG, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                        <TextBox Text="{Binding SteeringLockColorG, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                        <ui:Button Command="{Binding ResetSteeringLockColorGCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarGreen, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                        <TextBlock Text="B" Style="{StaticResource DzLabelTight}" Foreground="#FF1976D2"/>
                                        <Slider Value="{Binding SteeringLockColorB, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                        <TextBox Text="{Binding SteeringLockColorB, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                        <ui:Button Command="{Binding ResetSteeringLockColorBCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarBlue, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            </StackPanel>
                            <!-- Dedicated palette — shown only for the Palette Step source. Its own colors,
                                 stepped through one per lock entry, used only by the steering lock. -->
                            <StackPanel Margin="0,0,0,8"
                                        Visibility="{Binding IsSteeringLockLightbarPaletteVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding Macro_LightbarPalette_Label, Source={x:Static strings:Strings.Instance}}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Pad_Steering_Lock_PaletteEmpty, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}"/>
                                <ItemsControl ItemsSource="{Binding SteeringLockLightbarPalette}" Margin="0,0,0,4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:LightbarPaletteEntry}">
                                            <Border BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,8,8"
                                                    BorderBrush="{DynamicResource TextFillColorDisabledBrush}">
                                                <StackPanel>
                                                    <ui:Button Command="{Binding DataContext.RemoveSteeringLockPaletteColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding}" Style="{StaticResource EmberIconButtonHot}"
                                                               HorizontalAlignment="Right" Margin="0,0,0,4"
                                                               ToolTip="{Binding Pad_Lighting_RemoveColor, Source={x:Static strings:Strings.Instance}}">
                                                        <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    </ui:Button>
                                                    <!-- Full picker, same gamut as every other color selector:
                                                         HSV box, swatch, hex field, RGB sliders + value fields. -->
                                                    <views:ColorPickerControl Margin="0,0,0,12" HorizontalAlignment="Left"
                                                        Red="{Binding R, Mode=TwoWay}" Green="{Binding G, Mode=TwoWay}" Blue="{Binding B, Mode=TwoWay}"/>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="64"/>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="48" Height="36" CornerRadius="4" HorizontalAlignment="Left"
                                                                BorderBrush="{DynamicResource TextFillColorDisabledBrush}" BorderThickness="1">
                                                            <Border.Background>
                                                                <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                                                    <Binding Path="R"/>
                                                                    <Binding Path="G"/>
                                                                    <Binding Path="B"/>
                                                                </MultiBinding>
                                                            </Border.Background>
                                                        </Border>
                                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Grid.Column="1" Text="{Binding Pad_Lighting_Hex, Source={x:Static strings:Strings.Instance}}"
                                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                        <TextBox Grid.Column="2" Width="100" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                 FontFamily="{StaticResource TelemetryFontFamily}" Padding="6,4"
                                                                 Text="{Binding Hex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                 ToolTip="{Binding Pad_Lighting_HexTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="R" Style="{StaticResource DzLabelTight}" Foreground="#FFD32F2F"/>
                                                        <Slider Value="{Binding R, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                        <TextBox Text="{Binding R, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="G" Style="{StaticResource DzLabelTight}" Foreground="#FF388E3C"/>
                                                        <Slider Value="{Binding G, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                        <TextBox Text="{Binding G, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                                        <TextBlock Text="B" Style="{StaticResource DzLabelTight}" Foreground="#FF1976D2"/>
                                                        <Slider Value="{Binding B, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                        <TextBox Text="{Binding B, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Command="{Binding AddSteeringLockPaletteColorCommand}" HorizontalAlignment="Left" Padding="10,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Pad_Lighting_AddColor, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <!-- Hold + Decay — the reactive pulse on lock: hold the color at full for
                                 Hold ms, then fade back over Decay ms (matches the macro lightbar). -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding Macro_LightbarHold_Label, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                <Slider Value="{Binding SteeringLockLightbarHoldMs, Mode=TwoWay}" Minimum="0" Maximum="2000" Style="{StaticResource DzSlider}"/>
                                <TextBox Text="{Binding SteeringLockLightbarHoldMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                <TextBlock Text="ms" Style="{StaticResource DzPercent}"/>
                                <ui:Button Command="{Binding ResetSteeringLockLightbarHoldCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_LightbarHold, Source={x:Static strings:Strings.Instance}}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <TextBlock Text="{Binding Macro_LightbarDecay_Label, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                <Slider Value="{Binding SteeringLockLightbarFadeMs, Mode=TwoWay}" Minimum="0" Maximum="5000" Style="{StaticResource DzSlider}"/>
                                <TextBox Text="{Binding SteeringLockLightbarFadeMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                <TextBlock Text="ms" Style="{StaticResource DzPercent}"/>
                                <ui:Button Command="{Binding ResetSteeringLockFadeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_LightbarFadeMs, Source={x:Static strings:Strings.Instance}}"/>
                            </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ─── Flick Stick card (#225): settings for the "Flick Stick"
                         INPUTS (Right / Left), per assigned device. Flick Stick is a
                         normal input descriptor: the user maps it to Mouse X from the
                         input dropdown in Mappings, on any layer (shift-layer hosting
                         is the headline use). This card never targets or overrides an
                         axis; it only tunes the flick math. Shown on keyboard/mouse
                         slots (the output is relative mouse movement). -->
                    <Border x:Name="FlickStickCard" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Pad_FlickStick_Header, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardTitle}"/>
                                <ui:Button Command="{Binding ResetFlickStickCardCommand}" Style="{StaticResource ResetAllButton}"
                                        Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                        ToolTip="{Binding Pad_FlickStick_Reset_All, Source={x:Static strings:Strings.Instance}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Pad_FlickStick_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource CardDescription}"/>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Settings_FlickCountsPer360, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Settings_FlickCountsPer360_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding FlickCountsPer360, Mode=TwoWay}" Minimum="100" Maximum="30000" Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding FlickCountsPer360, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                    <ui:Button Command="{Binding ResetFlickCountsPer360Command}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetFlickCountsPer360, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Settings_FlickTime, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Settings_FlickTime_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding FlickTime, Mode=TwoWay}" Minimum="0.01" Maximum="1" Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding FlickTime, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="s" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetFlickTimeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetFlickTime, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Settings_FlickThreshold, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Settings_FlickThreshold_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding FlickThreshold, Mode=TwoWay}" Minimum="0.1" Maximum="1" Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding FlickThreshold, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                    <ui:Button Command="{Binding ResetFlickThresholdCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetFlickThreshold, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Settings_FlickSnapMode, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Settings_FlickSnapMode_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBox SelectedValue="{Binding FlickSnapMode, Mode=TwoWay}" SelectedValuePath="Tag" Width="200" VerticalAlignment="Center">
                                        <ComboBoxItem Content="{Binding Settings_FlickSnapMode_None, Source={x:Static strings:Strings.Instance}}" Tag="None"/>
                                        <ComboBoxItem Content="{Binding Settings_FlickSnapMode_Forward, Source={x:Static strings:Strings.Instance}}" Tag="Forward"/>
                                        <ComboBoxItem Content="{Binding Settings_FlickSnapMode_Half, Source={x:Static strings:Strings.Instance}}" Tag="Half"/>
                                        <ComboBoxItem Content="{Binding Settings_FlickSnapMode_Four, Source={x:Static strings:Strings.Instance}}" Tag="Four"/>
                                        <ComboBoxItem Content="{Binding Settings_FlickSnapMode_Sixths, Source={x:Static strings:Strings.Instance}}" Tag="Sixths"/>
                                        <ComboBoxItem Content="{Binding Settings_FlickSnapMode_Eight, Source={x:Static strings:Strings.Instance}}" Tag="Eight"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding ResetFlickSnapModeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetFlickSnapMode, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Settings_FlickSnapStrength, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Settings_FlickSnapStrength_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding FlickSnapStrength, Mode=TwoWay}" Minimum="0" Maximum="1" Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding FlickSnapStrength, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                    <ui:Button Command="{Binding ResetFlickSnapStrengthCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetFlickSnapStrength, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Settings_FlickForwardDeadzone, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Settings_FlickForwardDeadzone_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding FlickForwardDeadzone, Mode=TwoWay}" Minimum="0" Maximum="180" Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding FlickForwardDeadzone, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="&#176;" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetFlickForwardDeadzoneCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetFlickForwardDeadzone, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Settings_FlickSmoothing, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Settings_FlickSmoothing_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding FlickSmoothing, Mode=TwoWay}" Minimum="-1" Maximum="0.5" Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding FlickSmoothing, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                    <ui:Button Command="{Binding ResetFlickSmoothingCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetFlickSmoothing, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <TextBlock Text="{Binding Settings_FlickOnEngage, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Settings_FlickOnEngage_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <CheckBox IsChecked="{Binding FlickOnEngage, Mode=TwoWay}" VerticalAlignment="Center"
                                              ToolTip="{Binding Settings_FlickOnEngage_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Command="{Binding ResetFlickOnEngageCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetFlickOnEngage, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ─── TAB 4: Triggers (dynamic) ─── -->
            <TabItem>
                <ScrollViewer Padding="24,0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <viewControls:LabeledShapeIcon Shape="TriggerLeft" Width="24" Height="24"
                                                            VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Pad_Triggers_Header, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource TitleTextBlockStyle}" FontFamily="{StaticResource DisplayFontFamily}" FontWeight="650" FontSize="26"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Pad_Triggers_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <ItemsControl ItemsSource="{Binding TriggerConfigs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TriggerConfigItem}">
                                <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <viewControls:LabeledShapeIcon
                                            Shape="{Binding IconRightSide, Converter={StaticResource BoolToTriggerShapeKindConverter}}"
                                            Label="{Binding IconLabel}"
                                            Width="18" Height="18"
                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <!-- Inline mono subtitle (#175 close-out item 18):
                                             curve preset + anti-deadzone %. Display-only.
                                             Span inside the title TextBlock so the mono text
                                             shares the title's baseline (#175 typography). -->
                                        <TextBlock Style="{StaticResource CardTitle}"><Run
                                                Text="{Binding Title, Mode=OneWay}"/><Run
                                                Text="  "/><Span FontFamily="{StaticResource TelemetryFontFamily}" FontSize="10"
                                                FontWeight="Normal"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"><Run
                                                Text="{Binding PresetName, Mode=OneWay}"/><Run
                                                Text=" / "/><Run
                                                Text="{Binding AntiDeadZone, Mode=OneWay, StringFormat={}{0:0}%}"/></Span></TextBlock>
                                        <ui:Button Command="{Binding ResetAllCommand}" Style="{StaticResource ResetAllButton}"
                                                Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                                ToolTip="{Binding ResetAllToolTip}"/>
                                    </StackPanel>

                                    <Grid>
                                        <!-- Sliders, full-width curve canvas, and live instrument
                                             (#175 competitor item 4: the old right-column 120px
                                             curve square moved down here at card width). -->
                                        <StackPanel>
                                            <!-- Range (dual-thumb: deadzone floor to max range ceiling) -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_Range, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <controls:RangeSlider
                                                    LowerValue="{Binding DeadZone, Mode=TwoWay}"
                                                    UpperValue="{Binding MaxRange, Mode=TwoWay}"
                                                    Minimum="0" Maximum="100"
                                                    Width="200" VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding DeadZone, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Text="—" VerticalAlignment="Center" Margin="2,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBox Text="{Binding MaxRange, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                <TextBox Text="{Binding DeadZoneDigit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzDigitEdit}"/>
                                                <TextBlock Text="—" VerticalAlignment="Center" Margin="2,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBox Text="{Binding MaxRangeDigit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzDigitEdit}"/>
                                                <ui:Button Command="{Binding ResetRangeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetRange, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_AntiDeadZone, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <Slider Value="{Binding AntiDeadZone, Mode=TwoWay}"
                                                        Style="{StaticResource DzSlider}"/>
                                                <TextBox Text="{Binding AntiDeadZone, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                <TextBox Text="{Binding AntiDeadZoneDigit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzDigitEdit}"/>
                                                <ui:Button Command="{Binding ResetAntiDeadZoneCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetAntiDeadZone, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>

                                            <Separator Margin="0,8,0,8"/>
                                            <!-- ─── Sensitivity curve ─── -->
                                            <TextBlock Text="{Binding Pad_SensitivityCurve, Source={x:Static strings:Strings.Instance}}"
                                                       Style="{StaticResource CardSubsectionTitle}"/>
                                            <TextBlock Text="{Binding Pad_SensitivityCurveHintShort, Source={x:Static strings:Strings.Instance}}"
                                                       Style="{StaticResource CardDescription}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_Preset_Label, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <!-- Instance binding, NOT x:Static (see the stick preset twin). -->
                                                <ComboBox AutomationProperties.AutomationId="TriggerPresetCombo"
                                                          Width="120"
                                                          ItemsSource="{Binding CurvePresetChoices}"
                                                          SelectedItem="{Binding PresetName, Mode=OneWay}"
                                                          SelectionChanged="TriggerPreset_SelectionChanged"
                                                          Tag="{Binding}"/>
                                                <ui:Button Command="{Binding ResetSensitivityCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetSensitivity, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>

                                            <!-- Full-width forge canvas (#175 competitor item 4):
                                                 the trigger curve at card width under the sensitivity
                                                 controls. Caption keeps the mono-10-tertiary
                                                 instrument idiom. -->
                                            <TextBlock Text="{Binding Pad_TriggerAxis, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}"
                                                       HorizontalAlignment="Stretch" TextAlignment="Center"
                                                       FontFamily="{StaticResource TelemetryFontFamily}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       FontSize="10" Margin="0,4,0,2"/>
                                            <!-- Stretches to card width (#175 item 16): full-width
                                                 mode already redraws on SizeChanged, so no fixed
                                                 Width cap. -->
                                            <controls:CurveEditor
                                                CurveString="{Binding SensitivityCurve, Mode=TwoWay}"
                                                DeadZone="{Binding DeadZone}"
                                                MaxRange="{Binding MaxRange}"
                                                LiveInput="{Binding LiveInputForCurve}"
                                                IsSigned="False" IsFullWidth="True" ChartHeight="150" HorizontalAlignment="Stretch"/>

                                            <!-- Two-stage live instrument (#175 iteration 20): full-width
                                                 RAW cold and OUT ember bars in their own inset panel, per
                                                 the artifact instruments mock. -->
                                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="8"
                                                    Padding="14,12" Margin="0,10,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <!-- Travel gauge column (#175 competitor item 4) -->
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding Instr_Raw, Source={x:Static strings:Strings.Instance}}"
                                                               FontFamily="{StaticResource TelemetryFontFamily}"
                                                               FontSize="11" Width="36"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,12,8"/>
                                                    <ProgressBar Grid.Column="1" Value="{Binding RawNorm, Mode=OneWay}"
                                                                 Minimum="0" Maximum="1"
                                                                 Style="{StaticResource InstrumentBarRaw}"
                                                                 Margin="0,0,0,8"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding RawDisplay, Mode=OneWay}"
                                                               FontFamily="{StaticResource TelemetryFontFamily}"
                                                               FontSize="12" Width="96" TextAlignment="Right"
                                                               Foreground="{DynamicResource ColdBrush}"
                                                               VerticalAlignment="Center" Margin="12,0,0,8"/>
                                                    <TextBlock Grid.Row="1" Text="{Binding Instr_Out, Source={x:Static strings:Strings.Instance}}"
                                                               FontFamily="{StaticResource TelemetryFontFamily}"
                                                               FontSize="11" Width="36"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <ProgressBar Grid.Row="1" Grid.Column="1" Value="{Binding LiveValue, Mode=OneWay}"
                                                                 Minimum="0" Maximum="1"
                                                                 Style="{StaticResource InstrumentBarOut}"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="2"
                                                               Text="{Binding OutDisplay, Mode=OneWay}"
                                                               FontFamily="{StaticResource TelemetryFontFamily}"
                                                               FontSize="12" Width="96" TextAlignment="Right"
                                                               Foreground="{DynamicResource EmberHotBrush}"
                                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                    <!-- Travel gauge (#175 competitor item 4): dotted
                                                         steel quarter-arc from rest to full pull,
                                                         steel tick stops at the range clamps, thin
                                                         cold needle at raw pull, ember sweep to the
                                                         post-curve output. Value-driven only. -->
                                                    <controls:TriggerTravelArc Grid.Column="3" Grid.RowSpan="2"
                                                        RawValue="{Binding RawNorm, Mode=OneWay}"
                                                        OutValue="{Binding LiveValue, Mode=OneWay}"
                                                        RangeMin="{Binding DeadZone, Mode=OneWay}"
                                                        RangeMax="{Binding MaxRange, Mode=OneWay}"
                                                        VerticalAlignment="Center" Margin="18,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ─── TAB 5: Force Feedback ─── -->
            <TabItem>
                <ScrollViewer Padding="24,0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE877;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Pad_ForceFeedback_Header, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource TitleTextBlockStyle}" FontFamily="{StaticResource DisplayFontFamily}" FontWeight="650" FontSize="26"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Pad_ForceFeedback_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- Force Feedback / Rumble / Haptics section -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE877;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Pad_ForceFeedbackRumble, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource CardTitle}"/>
                            <ui:Button Command="{Binding ResetForceAllCommand}" Style="{StaticResource ResetAllButton}"
                                    Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                    ToolTip="{Binding Pad_ResetForceFeedback, Source={x:Static strings:Strings.Instance}}"/>
                        </StackPanel>

                        <!-- Overall gain -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding Pad_OverallGain, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                            <Slider Value="{Binding ForceOverallGain, Mode=TwoWay}"
                                    Style="{StaticResource DzSlider}"/>
                            <TextBox Text="{Binding ForceOverallGain, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource DzValueEdit}"/>
                            <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                            <ui:Button Command="{Binding ResetOverallGainCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetOverallGain, Source={x:Static strings:Strings.Instance}}"/>
                        </StackPanel>

                        <!-- Left motor -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding Pad_LeftMotorLabel, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                            <Slider Value="{Binding LeftMotorStrength, Mode=TwoWay}"
                                    Style="{StaticResource DzSlider}"/>
                            <TextBox Text="{Binding LeftMotorStrength, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource DzValueEdit}"/>
                            <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                            <ui:Button Command="{Binding ResetLeftMotorCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetLeftMotor, Source={x:Static strings:Strings.Instance}}"/>
                        </StackPanel>

                        <!-- Right motor -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding Pad_RightMotorLabel, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                            <Slider Value="{Binding RightMotorStrength, Mode=TwoWay}"
                                    Style="{StaticResource DzSlider}"/>
                            <TextBox Text="{Binding RightMotorStrength, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource DzValueEdit}"/>
                            <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                            <ui:Button Command="{Binding ResetRightMotorCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetRightMotor, Source={x:Static strings:Strings.Instance}}"/>
                        </StackPanel>

                        <!-- Swap motors -->
                        <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_SwapMotors, Source={x:Static strings:Strings.Instance}}"
                                  IsChecked="{Binding SwapMotors, Mode=TwoWay}"
                                  Margin="0,0,0,12"/>

                        <!-- Test rumble -->
                        <Button Content="{Binding Pad_TestRumble, Source={x:Static strings:Strings.Instance}}"
                                Command="{Binding TestRumbleCommand}"
                                Padding="12,6" HorizontalAlignment="Left"
                                Margin="0,0,0,12"/>

                        <!-- Live motor display: inset instrument panel (#175
                             iteration 27, matching the trigger instrument).
                             Two-stage per item 52: RAW is what the game
                             commands on the virtual pad (LeftMotorDisplay,
                             cold), OUT is what the dispatcher delivers to
                             the selected device after swap/strength
                             (DeviceLeftMotorDisplay, ember). The gap between
                             the bars is the user's settings, live. -->
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Margin="0,0,0,10"
                                           Text="{Binding Pad_MotorActivity, Source={x:Static strings:Strings.Instance}}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <!-- Left motor: RAW over OUT -->
                                <TextBlock Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" VerticalAlignment="Center"
                                           Text="{Binding Pad_LeftMotorLabel, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource DzLabel}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,6"
                                           Text="{Binding Instr_Raw, Source={x:Static strings:Strings.Instance}}"
                                           FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11" Width="32"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <ProgressBar Grid.Row="1" Grid.Column="2" Margin="0,0,12,6"
                                             Value="{Binding LeftMotorDisplay, Mode=OneWay}"
                                             Minimum="0" Maximum="1" VerticalAlignment="Center"
                                             Style="{StaticResource InstrumentBarRaw}"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,0,0,6"
                                           Text="{Binding LeftMotorDisplay, Mode=OneWay, StringFormat=P0}"
                                           FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12"
                                           MinWidth="40" TextAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ColdBrush}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,10"
                                           Text="{Binding Instr_Out, Source={x:Static strings:Strings.Instance}}"
                                           FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11" Width="32"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <ProgressBar Grid.Row="2" Grid.Column="2" Margin="0,0,12,10"
                                             Value="{Binding DeviceLeftMotorDisplay, Mode=OneWay}"
                                             Minimum="0" Maximum="1" VerticalAlignment="Center"
                                             Style="{StaticResource InstrumentBarOut}"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Margin="0,0,0,10"
                                           Text="{Binding DeviceLeftMotorDisplay, Mode=OneWay, StringFormat=P0}"
                                           FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12"
                                           MinWidth="40" TextAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource EmberHotBrush}"/>
                                <!-- Right motor: RAW over OUT -->
                                <TextBlock Grid.Row="3" Grid.RowSpan="2" Grid.Column="0" VerticalAlignment="Center"
                                           Text="{Binding Pad_RightMotorLabel, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource DzLabel}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,6"
                                           Text="{Binding Instr_Raw, Source={x:Static strings:Strings.Instance}}"
                                           FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11" Width="32"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <ProgressBar Grid.Row="3" Grid.Column="2" Margin="0,0,12,6"
                                             Value="{Binding RightMotorDisplay, Mode=OneWay}"
                                             Minimum="0" Maximum="1" VerticalAlignment="Center"
                                             Style="{StaticResource InstrumentBarRaw}"/>
                                <TextBlock Grid.Row="3" Grid.Column="3" Margin="0,0,0,6"
                                           Text="{Binding RightMotorDisplay, Mode=OneWay, StringFormat=P0}"
                                           FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12"
                                           MinWidth="40" TextAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ColdBrush}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"
                                           Text="{Binding Instr_Out, Source={x:Static strings:Strings.Instance}}"
                                           FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11" Width="32"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <ProgressBar Grid.Row="4" Grid.Column="2" Margin="0,0,12,0"
                                             Value="{Binding DeviceRightMotorDisplay, Mode=OneWay}"
                                             Minimum="0" Maximum="1" VerticalAlignment="Center"
                                             Style="{StaticResource InstrumentBarOut}"/>
                                <TextBlock Grid.Row="4" Grid.Column="3"
                                           Text="{Binding DeviceRightMotorDisplay, Mode=OneWay, StringFormat=P0}"
                                           FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12"
                                           MinWidth="40" TextAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource EmberHotBrush}"/>
                            </Grid>
                        </Border>

                            </StackPanel>
                        </Border>

                        <!-- ── Constant Force section ── -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xF0AD;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_ConstantForce_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding ResetConstantForceCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetConstantForce, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Pad_ConstantForce_Description, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}" Margin="0,0,0,12"/>

                                <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_ConstantForce_Toggle, Source={x:Static strings:Strings.Instance}}"
                                          IsChecked="{Binding ConstantForceEnabled, Mode=TwoWay}"
                                          Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,8" IsEnabled="{Binding ConstantForceEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Interactive grid -->
                                    <Border x:Name="ConstantForcePadBorder" Grid.Column="0"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="8"
                                            Padding="4" Width="212" Height="212"
                                            Cursor="Cross"
                                            ClipToBounds="True"
                                            MouseLeftButtonDown="ConstantForcePad_MouseLeftButtonDown"
                                            MouseMove="ConstantForcePad_MouseMove"
                                            MouseLeftButtonUp="ConstantForcePad_MouseLeftButtonUp">
                                        <Grid Width="200" Height="200">
                                            <Ellipse Width="200" Height="200"
                                                     Fill="{DynamicResource ControlFillColorDefaultBrush}"/>
                                            <Line X1="50" Y1="0" X2="50" Y2="200" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeDashArray="2 4" StrokeThickness="0.5"/>
                                            <Line X1="150" Y1="0" X2="150" Y2="200" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeDashArray="2 4" StrokeThickness="0.5"/>
                                            <Line X1="0" Y1="50" X2="200" Y2="50" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeDashArray="2 4" StrokeThickness="0.5"/>
                                            <Line X1="0" Y1="150" X2="200" Y2="150" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeDashArray="2 4" StrokeThickness="0.5"/>
                                            <Line X1="100" Y1="0" X2="100" Y2="200" Stroke="{DynamicResource TextFillColorTertiaryBrush}" StrokeThickness="0.75"/>
                                            <Line X1="0" Y1="100" X2="200" Y2="100" Stroke="{DynamicResource TextFillColorTertiaryBrush}" StrokeThickness="0.75"/>
                                            <Canvas>
                                                <Ellipse Width="196" Height="196" Canvas.Left="2" Canvas.Top="2"
                                                         Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                         StrokeThickness="1.5" Fill="Transparent"/>
                                                <!-- Force vector line from center to handle (signed [-1..+1] → canvas, dot size 0 = use raw position) -->
                                                <Line Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="2"
                                                      X1="100" Y1="100"
                                                      X2="{Binding ConstantForceX, Converter={StaticResource SignedNormToCanvasConverter}, ConverterParameter='200,0'}"
                                                      Y2="{Binding ConstantForceY, Converter={StaticResource SignedNormToCanvasConverter}, ConverterParameter='200,0'}"/>
                                                <!-- Force handle dot -->
                                                <Ellipse Width="13" Height="13"
                                                         Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                                         Stroke="{DynamicResource AccentFillColorSecondaryBrush}" StrokeThickness="1.5"
                                                         Canvas.Left="{Binding ConstantForceX, Converter={StaticResource SignedNormToCanvasConverter}, ConverterParameter='200,13'}"
                                                         Canvas.Top="{Binding ConstantForceY, Converter={StaticResource SignedNormToCanvasConverter}, ConverterParameter='200,13'}"/>
                                            </Canvas>
                                        </Grid>
                                    </Border>

                                    <!-- Numeric readout + sliders -->
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Pad_ConstantForce_Position, Source={x:Static strings:Strings.Instance}}"
                                                   Style="{StaticResource CardDescription}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Pad_ConstantForce_X, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                            <Slider Value="{Binding ConstantForceX, Mode=TwoWay}"
                                                    Minimum="-1" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                                                    Style="{StaticResource DzSlider}"/>
                                            <TextBox Text="{Binding ConstantForceX, Mode=TwoWay, StringFormat=F2, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource DzValueEdit}"/>
                                            <ui:Button Command="{Binding ResetConstantForceXCommand}" Style="{StaticResource ResetButton}"
                                                    ToolTip="{Binding Pad_ResetConstantForceX, Source={x:Static strings:Strings.Instance}}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Pad_ConstantForce_Y, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                            <Slider Value="{Binding ConstantForceY, Mode=TwoWay}"
                                                    Minimum="-1" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                                                    Style="{StaticResource DzSlider}"/>
                                            <TextBox Text="{Binding ConstantForceY, Mode=TwoWay, StringFormat=F2, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource DzValueEdit}"/>
                                            <ui:Button Command="{Binding ResetConstantForceYCommand}" Style="{StaticResource ResetButton}"
                                                    ToolTip="{Binding Pad_ResetConstantForceY, Source={x:Static strings:Strings.Instance}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ── Audio Bass Rumble section ── -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Settings_AudioRumble, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource CardTitle}"/>
                            <ui:Button Command="{Binding ResetAudioRumbleAllCommand}" Style="{StaticResource ResetAllButton}"
                                    Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                    ToolTip="{Binding Pad_ResetAudioRumble, Source={x:Static strings:Strings.Instance}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Settings_AudioRumbleDesc, Source={x:Static strings:Strings.Instance}}"
                                   Style="{StaticResource CardDescription}" Margin="0,0,0,12"/>

                        <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Settings_AudioRumble_Enable, Source={x:Static strings:Strings.Instance}}"
                                  IsChecked="{Binding AudioRumbleEnabled, Mode=TwoWay}"
                                  Margin="0,0,0,12"/>

                        <!-- Sensitivity -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" IsEnabled="{Binding AudioRumbleEnabled}">
                            <TextBlock Text="{Binding Settings_AudioRumble_Sensitivity, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                            <Slider Value="{Binding AudioRumbleSensitivity, Mode=TwoWay}"
                                    Style="{StaticResource DzSlider}"
                                    Minimum="1" Maximum="20" TickFrequency="0.1"/>
                            <TextBox Text="{Binding AudioRumbleSensitivity, Mode=TwoWay, StringFormat=F1, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource DzValueEdit}"/>
                            <ui:Button Command="{Binding ResetAudioSensitivityCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetAudioSensitivity, Source={x:Static strings:Strings.Instance}}"/>
                        </StackPanel>

                        <!-- Bass Cutoff -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" IsEnabled="{Binding AudioRumbleEnabled}">
                            <TextBlock Text="{Binding Settings_AudioRumble_Cutoff, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                            <Slider Value="{Binding AudioRumbleCutoffHz, Mode=TwoWay}"
                                    Style="{StaticResource DzSlider}"
                                    Minimum="20" Maximum="200" TickFrequency="1"/>
                            <TextBox Text="{Binding AudioRumbleCutoffHz, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource DzValueEdit}"/>
                            <ui:Button Command="{Binding ResetAudioCutoffCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetAudioCutoff, Source={x:Static strings:Strings.Instance}}"/>
                        </StackPanel>

                        <!-- Left Motor -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" IsEnabled="{Binding AudioRumbleEnabled}">
                            <TextBlock Text="{Binding Settings_AudioRumble_LeftMotor, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                            <Slider Value="{Binding AudioRumbleLeftMotor, Mode=TwoWay}"
                                    Style="{StaticResource DzSlider}"/>
                            <TextBox Text="{Binding AudioRumbleLeftMotor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource DzValueEdit}"/>
                            <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                            <ui:Button Command="{Binding ResetAudioLeftMotorCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetAudioLeftMotor, Source={x:Static strings:Strings.Instance}}"/>
                        </StackPanel>

                        <!-- Right Motor -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" IsEnabled="{Binding AudioRumbleEnabled}">
                            <TextBlock Text="{Binding Settings_AudioRumble_RightMotor, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                            <Slider Value="{Binding AudioRumbleRightMotor, Mode=TwoWay}"
                                    Style="{StaticResource DzSlider}"/>
                            <TextBox Text="{Binding AudioRumbleRightMotor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource DzValueEdit}"/>
                            <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                            <ui:Button Command="{Binding ResetAudioRightMotorCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetAudioRightMotor, Source={x:Static strings:Strings.Instance}}"/>
                        </StackPanel>

                        <!-- Level meter -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" IsEnabled="{Binding AudioRumbleEnabled}">
                            <TextBlock Text="{Binding Settings_AudioRumble_Level, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                            <ProgressBar Value="{Binding AudioRumbleLevelMeter, Mode=OneWay}"
                                         Minimum="0" Maximum="1"
                                         Width="320" Height="10" VerticalAlignment="Center"
                                         Foreground="{DynamicResource EmberHotBrush}"/>
                        </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ── Trigger Routing section (issue #102): route main-motor rumble
                             into the trigger channel, per trigger, with a cross-device activator. -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_TriggerRouting_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding ResetTriggerRouteCardCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetTriggerRouting, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Pad_TriggerRouting_Description, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}" Margin="0,0,0,12"/>

                                <!-- ─── Left trigger ─── -->
                                <TextBlock Text="{Binding Pad_TriggerRouting_LeftTrigger, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardSubsectionTitle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Pad_TriggerRouting_Source, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ComboBox SelectedValue="{Binding LeftTriggerRouteSource, Mode=TwoWay}" SelectedValuePath="Tag" MinWidth="220">
                                        <ComboBoxItem Content="{Binding Pad_TriggerRouting_Source_None, Source={x:Static strings:Strings.Instance}}" Tag="None"/>
                                        <ComboBoxItem Content="{Binding Pad_TriggerRouting_Source_MainLeft, Source={x:Static strings:Strings.Instance}}" Tag="MainLeft"/>
                                        <ComboBoxItem Content="{Binding Pad_TriggerRouting_Source_MainRight, Source={x:Static strings:Strings.Instance}}" Tag="MainRight"/>
                                        <ComboBoxItem Content="{Binding Pad_TriggerRouting_Source_MaxOfBoth, Source={x:Static strings:Strings.Instance}}" Tag="MaxOfBoth"/>
                                        <ComboBoxItem Content="{Binding Pad_TriggerRouting_Source_SumOfBoth, Source={x:Static strings:Strings.Instance}}" Tag="SumOfBoth"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding ResetLeftTriggerRouteSourceCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTriggerRouteSource, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Pad_TriggerRouting_Mode, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ComboBox SelectedValue="{Binding LeftTriggerRouteMode, Mode=TwoWay}" SelectedValuePath="Tag" MinWidth="220">
                                        <ComboBoxItem Content="{Binding Pad_TriggerRouting_Mode_Off, Source={x:Static strings:Strings.Instance}}" Tag="Off"/>
                                        <ComboBoxItem Content="{Binding Pad_TriggerRouting_Mode_Duplicate, Source={x:Static strings:Strings.Instance}}" Tag="Duplicate"/>
                                        <ComboBoxItem Content="{Binding Pad_TriggerRouting_Mode_Redirect, Source={x:Static strings:Strings.Instance}}" Tag="Redirect"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding ResetLeftTriggerRouteModeCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTriggerRouteMode, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Pad_TriggerRouting_Scale, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding LeftTriggerRouteScale, Mode=TwoWay}" Minimum="0" Maximum="200"
                                            SmallChange="1" LargeChange="10" Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding LeftTriggerRouteScale, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="%" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <ui:Button Command="{Binding ResetLeftTriggerRouteScaleCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTriggerRouteScale, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Pad_TriggerRouting_Activator, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource DzLabel}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                    <StackPanel Orientation="Vertical">
                                        <ComboBox ItemsSource="{Binding SlotAvailableInputsView}"
                                                  SelectedItem="{Binding LeftTriggerRouteActivatorSelectedInput, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName" MinWidth="220" Padding="4,2"
                                                  IsSynchronizedWithCurrentItem="False">
                                            <ComboBox.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,3,6,3">
                                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ComboBox.GroupStyle>
                                        </ComboBox>
                                        <TextBlock FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="4,1,0,0" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding LeftTriggerRouteActivatorSelectedInput.DeviceLabel}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LeftTriggerRouteActivatorSelectedInput}" Value="{x:Null}">
                                                            <Setter Property="Text" Value="{Binding Common_Unassigned, Source={x:Static strings:Strings.Instance}}"/>
                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <ui:Button Command="{Binding LeftTriggerRouteActivatorRecordCommand}" Style="{StaticResource EmberIconButtonHot}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding LeftTriggerRouteActivatorRecordButtonIcon}" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource EmberBrush}"/>
                                        <ui:Button.ToolTip><TextBlock Text="{Binding LeftTriggerRouteActivatorRecordButtonText}"/></ui:Button.ToolTip>
                                    </ui:Button>
                                    <ui:Button Command="{Binding ResetLeftTriggerRouteActivatorCommand}" Style="{StaticResource ResetButton}" VerticalAlignment="Top"
                                            ToolTip="{Binding Pad_ResetTriggerRouteActivator, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Pad_TriggerRouting_ActivatorMode, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ComboBox SelectedValue="{Binding LeftTriggerRouteActivatorMode, Mode=TwoWay}" SelectedValuePath="Tag" MinWidth="220">
                                        <ComboBoxItem Content="{Binding Settings_GyroAimEngageMode_Hold, Source={x:Static strings:Strings.Instance}}" Tag="Hold"/>
                                        <ComboBoxItem Content="{Binding Settings_GyroAimEngageMode_Toggle, Source={x:Static strings:Strings.Instance}}" Tag="Toggle"/>
                                        <ComboBoxItem Content="{Binding Pad_TriggerRouting_ActivatorMode_AlwaysOn, Source={x:Static strings:Strings.Instance}}" Tag="AlwaysOn"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding ResetLeftTriggerRouteActivatorModeCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTriggerRouteActivatorMode, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- ─── Right trigger ─── -->
                                <TextBlock Text="{Binding Pad_TriggerRouting_RightTrigger, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardSubsectionTitle}" Margin="0,12,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Pad_TriggerRouting_Source, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ComboBox SelectedValue="{Binding RightTriggerRouteSource, Mode=TwoWay}" SelectedValuePath="Tag" MinWidth="220">
                                        <ComboBoxItem Content="{Binding Pad_TriggerRouting_Source_None, Source={x:Static strings:Strings.Instance}}" Tag="None"/>
                                        <ComboBoxItem Content="{Binding Pad_TriggerRouting_Source_MainLeft, Source={x:Static strings:Strings.Instance}}" Tag="MainLeft"/>
                                        <ComboBoxItem Content="{Binding Pad_TriggerRouting_Source_MainRight, Source={x:Static strings:Strings.Instance}}" Tag="MainRight"/>
                                        <ComboBoxItem Content="{Binding Pad_TriggerRouting_Source_MaxOfBoth, Source={x:Static strings:Strings.Instance}}" Tag="MaxOfBoth"/>
                                        <ComboBoxItem Content="{Binding Pad_TriggerRouting_Source_SumOfBoth, Source={x:Static strings:Strings.Instance}}" Tag="SumOfBoth"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding ResetRightTriggerRouteSourceCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTriggerRouteSource, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Pad_TriggerRouting_Mode, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ComboBox SelectedValue="{Binding RightTriggerRouteMode, Mode=TwoWay}" SelectedValuePath="Tag" MinWidth="220">
                                        <ComboBoxItem Content="{Binding Pad_TriggerRouting_Mode_Off, Source={x:Static strings:Strings.Instance}}" Tag="Off"/>
                                        <ComboBoxItem Content="{Binding Pad_TriggerRouting_Mode_Duplicate, Source={x:Static strings:Strings.Instance}}" Tag="Duplicate"/>
                                        <ComboBoxItem Content="{Binding Pad_TriggerRouting_Mode_Redirect, Source={x:Static strings:Strings.Instance}}" Tag="Redirect"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding ResetRightTriggerRouteModeCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTriggerRouteMode, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Pad_TriggerRouting_Scale, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding RightTriggerRouteScale, Mode=TwoWay}" Minimum="0" Maximum="200"
                                            SmallChange="1" LargeChange="10" Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding RightTriggerRouteScale, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="%" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <ui:Button Command="{Binding ResetRightTriggerRouteScaleCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTriggerRouteScale, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Pad_TriggerRouting_Activator, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource DzLabel}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                    <StackPanel Orientation="Vertical">
                                        <ComboBox ItemsSource="{Binding SlotAvailableInputsView}"
                                                  SelectedItem="{Binding RightTriggerRouteActivatorSelectedInput, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName" MinWidth="220" Padding="4,2"
                                                  IsSynchronizedWithCurrentItem="False">
                                            <ComboBox.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,3,6,3">
                                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ComboBox.GroupStyle>
                                        </ComboBox>
                                        <TextBlock FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="4,1,0,0" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding RightTriggerRouteActivatorSelectedInput.DeviceLabel}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RightTriggerRouteActivatorSelectedInput}" Value="{x:Null}">
                                                            <Setter Property="Text" Value="{Binding Common_Unassigned, Source={x:Static strings:Strings.Instance}}"/>
                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <ui:Button Command="{Binding RightTriggerRouteActivatorRecordCommand}" Style="{StaticResource EmberIconButtonHot}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding RightTriggerRouteActivatorRecordButtonIcon}" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource EmberBrush}"/>
                                        <ui:Button.ToolTip><TextBlock Text="{Binding RightTriggerRouteActivatorRecordButtonText}"/></ui:Button.ToolTip>
                                    </ui:Button>
                                    <ui:Button Command="{Binding ResetRightTriggerRouteActivatorCommand}" Style="{StaticResource ResetButton}" VerticalAlignment="Top"
                                            ToolTip="{Binding Pad_ResetTriggerRouteActivator, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Pad_TriggerRouting_ActivatorMode, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ComboBox SelectedValue="{Binding RightTriggerRouteActivatorMode, Mode=TwoWay}" SelectedValuePath="Tag" MinWidth="220">
                                        <ComboBoxItem Content="{Binding Settings_GyroAimEngageMode_Hold, Source={x:Static strings:Strings.Instance}}" Tag="Hold"/>
                                        <ComboBoxItem Content="{Binding Settings_GyroAimEngageMode_Toggle, Source={x:Static strings:Strings.Instance}}" Tag="Toggle"/>
                                        <ComboBoxItem Content="{Binding Pad_TriggerRouting_ActivatorMode_AlwaysOn, Source={x:Static strings:Strings.Instance}}" Tag="AlwaysOn"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding ResetRightTriggerRouteActivatorModeCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTriggerRouteActivatorMode, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════════════════════════
                 TAB 6: ADAPTIVE TRIGGERS
                 (visible only for DualSense / DualSense Edge slots)
                 ══════════════════════════════════════ -->
            <TabItem>
                <ScrollViewer Padding="24,0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Viewbox Width="24" Height="24" Stretch="Uniform"
                                     VerticalAlignment="Center" Margin="0,0,10,0">
                                <Grid Width="512" Height="512">
                                    <Path Fill="{DynamicResource EmberBrush}"
                                          Data="{StaticResource ZackslyTriggerOuterBodyGeometry}"/>
                                    <Path Fill="{DynamicResource EmberBrush}"
                                          Data="M445,180 L475,200 L445,220 L455,220 L485,200 L455,180 Z M445,280 L475,300 L445,320 L455,320 L485,300 L455,280 Z"/>
                                </Grid>
                            </Viewbox>
                            <TextBlock Text="{Binding Pad_AdaptiveTriggers_Header, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource TitleTextBlockStyle}" FontFamily="{StaticResource DisplayFontFamily}" FontWeight="650" FontSize="26"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Pad_AdaptiveTriggers_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- Left Trigger -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <viewControls:LabeledShapeIcon Shape="TriggerLeft" Label="L2"
                                                                   Width="18" Height="18"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_LeftTrigger, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding DeviceConfig.ResetLeftTriggerCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetLeftTrigger, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <!-- Mode cards (#175 competitor item 5): one steel card
                                     per mode, each carrying a live force-vs-travel
                                     sparkline that redraws as Start/End/Strength/
                                     Frequency change. Radio-like selection binds the
                                     same LeftTriggerMode property the old dropdown
                                     drove, via SelectedValue/Tag (Lighting-picker
                                     pattern). The selected card's sparkline carries a
                                     cold marker at the live physical trigger pull. -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Pad_TriggerMode, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ListBox Width="456" Background="Transparent" BorderThickness="0"
                                             Padding="0" VerticalAlignment="Center"
                                             SelectedValuePath="Tag"
                                             SelectionChanged="AtModeCards_SelectionChanged"
                                             SelectedValue="{Binding DeviceConfig.LeftTriggerMode, Mode=TwoWay}"
                                             ItemContainerStyle="{StaticResource AtModeCardContainer}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBoxItem Tag="{x:Static vm:AdaptiveTriggerMode.Off}"
                                                     ToolTip="{Binding Pad_AT_Off_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
