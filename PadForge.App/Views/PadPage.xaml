                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}"
                                            ToolTip="{Binding Pad_ResetWheel, Source={x:Static strings:Strings.Instance}}"/>
                                </DockPanel>

                                <!-- Rotation range. The wheel's hardware steering lock, not a force.
