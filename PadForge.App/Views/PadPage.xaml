                                        <ComboBox ItemsSource="{Binding SlotAvailableInputsView}"
                                                  SelectedItem="{Binding LeftTriggerRouteActivatorSelectedInput, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName" MinWidth="220" Padding="4,2">
                                            <ComboBox.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,3,6,3">
                                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ComboBox.GroupStyle>
                                        </ComboBox>
                                        <TextBlock FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="4,1,0,0" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding LeftTriggerRouteActivatorSelectedInput.DeviceLabel}"/>
