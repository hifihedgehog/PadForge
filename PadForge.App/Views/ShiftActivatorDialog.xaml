<views:DialogWindow AutomationProperties.IsDialog="True" x:Class="PadForge.Views.ShiftActivatorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        xmlns:common="clr-namespace:PadForge.Common"
        xmlns:controls="clr-namespace:PadForge.Controls"
        xmlns:reset="clr-namespace:PadForge.Controls"
        xmlns:views="clr-namespace:PadForge.Views"
        Title="{Binding Pad_Shift_DialogTitle, Source={x:Static strings:Strings.Instance}}">

    <!-- A shift layer (#574), as the Record board draws it: its name and
         icon, the input that turns it on, and what its unmapped controls
         do. The mode, the kind of input, the timing and the layer's color
         are under More, which opens by itself for a layer that uses one of
         them. The line under the title says what the chosen mode does, and
         the code-behind keeps it in step with the mode.

         The Base layer has a name, an icon and a color and nothing else, so
         its window (the code-behind's first constructor) shows the name row
         and the color with no More. -->
    <views:DialogWindow.Resources>
        <!-- A color channel's letter, in the code face as on the controller
             page's color rows. -->
        <Style x:Key="DzLabelTight" TargetType="TextBlock">
            <Setter Property="Width" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}"/>
        </Style>
        <Style x:Key="DzRgbSlider" TargetType="Slider" BasedOn="{StaticResource EmberSlider}">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="255"/>
            <Setter Property="MaxWidth" Value="280"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
        </Style>
        <Style x:Key="RowSlider" TargetType="Slider" BasedOn="{StaticResource EmberSlider}">
            <Setter Property="MaxWidth" Value="280"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
        </Style>
        <!-- The heading of a device's inputs in an input picker's list. -->
        <DataTemplate x:Key="InputGroupHead">
            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,3">
                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
        </DataTemplate>
        <!-- A mode or a kind of input: its name over a line on what it does
             in the open list, and its name alone in the closed box. -->
        <DataTemplate x:Key="PickClosed">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
        <DataTemplate x:Key="PickInList">
            <StackPanel Margin="0,2">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Description}" FontSize="13" TextWrapping="Wrap" MaxWidth="340"
                           HorizontalAlignment="Left"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </DataTemplate>
        <controls:PickTemplateSelector x:Key="PickLook" Closed="{StaticResource PickClosed}" List="{StaticResource PickInList}"/>
    </views:DialogWindow.Resources>

    <views:DialogWindow.Foot>
        <controls:FlexLinePanel Style="{StaticResource DialogFootPanel}">
            <!-- Shown for a layer that exists and is not Base. The caller
                 asks before it deletes. -->
            <Button x:Name="DeleteLayerButton" Style="{StaticResource DialogQuietButton}" Visibility="Collapsed"
                    Content="{Binding Pad_Shift_Delete, Source={x:Static strings:Strings.Instance}}"
                    Click="DeleteLayerButton_Click"/>
            <!-- What stops a save: no name, a name another layer has, or no
                 input. -->
            <TextBlock x:Name="HintText" Style="{StaticResource DialogFootNote}" Visibility="Collapsed"
                       Foreground="{DynamicResource WaitBrush}" common:LiveText.Polite="True"/>
            <Button Style="{StaticResource DialogButton}" IsCancel="True"
                    Content="{Binding Common_Cancel, Source={x:Static strings:Strings.Instance}}"/>
            <Button x:Name="SaveButton" Style="{StaticResource DialogPrimaryButton}" IsDefault="True"
                    Content="{Binding Common_Save, Source={x:Static strings:Strings.Instance}}"
                    Click="SaveButton_Click"/>
        </controls:FlexLinePanel>
    </views:DialogWindow.Foot>

    <StackPanel x:Name="BodyPanel">
        <!-- The name, with the layer's icon before it. The square button
             shows the icon (a picture, an emoji, or the shift arrow when
             none is set) and opens the shared icon picker (#471). -->
        <controls:SettingRow MinHeight="44">
            <TextBlock x:Name="NameLabel" Style="{StaticResource DialogLabel}"
                       Text="{Binding Pad_Shift_NameLabel, Source={x:Static strings:Strings.Instance}}"/>
            <Button x:Name="IconPickerButton" Style="{StaticResource DialogButton}" Width="36" Height="36" Padding="0"
                    Click="IconPickerButton_Click"
                    ToolTip="{Binding Pad_Shift_Icon_Tooltip, Source={x:Static strings:Strings.Instance}}"
                    AutomationProperties.Name="{Binding Pad_Shift_Icon_Tooltip, Source={x:Static strings:Strings.Instance}}">
                <Grid>
                    <TextBlock x:Name="IconPickerGlyph" Text="&#x21E7;"
                               FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <reset:DecorativeImage FlowDirection="LeftToRight" x:Name="IconPickerImage"
                                           Width="22" Height="22" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                </Grid>
            </Button>
            <ui:TextBox x:Name="LayerNameBox" Style="{StaticResource DialogTextBox}" Margin="10,0,0,0"
                        controls:SettingRow.Fills="True"
                        AutomationProperties.Name="{Binding Pad_Shift_LayerName, Source={x:Static strings:Strings.Instance}}"/>
        </controls:SettingRow>

        <!-- The input that turns the layer on. Its label follows the mode
             (Held With, Pressed With, Next Layer With), its picker reads
             as the board's chip, and the device the input is on is the
             picker's tooltip. A layer with no button of its own has no
             such row. -->
        <controls:SettingRow x:Name="InputRow" MinHeight="44">
            <TextBlock x:Name="InputLabel" Style="{StaticResource DialogLabel}"
                       Text="{Binding Pad_Shift_HeldWith, Source={x:Static strings:Strings.Instance}}"/>
            <Grid MaxWidth="240">
                <ComboBox x:Name="InputCombo" Style="{StaticResource DialogInputChipCombo}" HorizontalAlignment="Stretch"
                          DisplayMemberPath="DisplayName" ScrollViewer.VerticalScrollBarVisibility="Visible"
                          SelectionChanged="InputPicker_SelectionChanged"
                          AutomationProperties.Name="{Binding Text, ElementName=InputLabel, TargetNullValue=''}">
                    <ComboBox.GroupStyle>
                        <GroupStyle HeaderTemplate="{StaticResource InputGroupHead}"/>
                    </ComboBox.GroupStyle>
                </ComboBox>
                <TextBlock x:Name="InputPlaceholder" IsHitTestVisible="False" Margin="13,0,34,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="{Binding Pad_Shift_ChooseInput, Source={x:Static strings:Strings.Instance}}"/>
            </Grid>
            <ui:Button x:Name="InputRecordButton" Style="{StaticResource DialogRecordButton}" Content="&#xE7C8;"
                       Click="InputRecord_Click"
                       AutomationProperties.Name="{Binding Common_Record, Source={x:Static strings:Strings.Instance}}"/>
            <ui:Button x:Name="InputClearButton" Style="{StaticResource DialogClearButton}" Click="InputClear_Click"
                       ToolTip="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}"
                       AutomationProperties.Name="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}">
                <Path FlowDirection="LeftToRight" Data="M 4,4 L 12,12 M 12,4 L 4,12" Width="16" Height="16"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ui:Button}}}"
                      StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </ui:Button>
        </controls:SettingRow>

        <!-- The second input: the other half of a chord, or the input that
             steps a Cycle layer back. -->
        <controls:SettingRow x:Name="ChordSecondRow" MinHeight="44">
            <TextBlock x:Name="ChordLabel" Style="{StaticResource DialogLabel}"
                       Text="{Binding Pad_Shift_AndWith, Source={x:Static strings:Strings.Instance}}"/>
            <Grid MaxWidth="240">
                <ComboBox x:Name="ChordSecondCombo" Style="{StaticResource DialogInputChipCombo}" HorizontalAlignment="Stretch"
                          DisplayMemberPath="DisplayName" ScrollViewer.VerticalScrollBarVisibility="Visible"
                          SelectionChanged="InputPicker_SelectionChanged"
                          AutomationProperties.Name="{Binding Text, ElementName=ChordLabel, TargetNullValue=''}">
                    <ComboBox.GroupStyle>
                        <GroupStyle HeaderTemplate="{StaticResource InputGroupHead}"/>
                    </ComboBox.GroupStyle>
                </ComboBox>
                <TextBlock x:Name="ChordSecondPlaceholder" IsHitTestVisible="False" Margin="13,0,34,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="{Binding Pad_Shift_ChooseInput, Source={x:Static strings:Strings.Instance}}"/>
            </Grid>
            <ui:Button x:Name="ChordSecondRecordButton" Style="{StaticResource DialogRecordButton}" Content="&#xE7C8;"
                       Click="ChordSecondRecord_Click"
                       AutomationProperties.Name="{Binding Common_Record, Source={x:Static strings:Strings.Instance}}"/>
            <ui:Button x:Name="ChordSecondClearButton" Style="{StaticResource DialogClearButton}" Click="ChordSecondClear_Click"
                       ToolTip="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}"
                       AutomationProperties.Name="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}">
                <Path FlowDirection="LeftToRight" Data="M 4,4 L 12,12 M 12,4 L 4,12" Width="16" Height="16"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ui:Button}}}"
                      StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </ui:Button>
        </controls:SettingRow>

        <!-- How far an axis has to go to turn the layer on. -->
        <controls:SettingRow x:Name="AxisThresholdRow" MinHeight="44">
            <TextBlock x:Name="AxisThresholdLabel" Style="{StaticResource DialogLabel}"
                       Text="{Binding Pad_Shift_AxisThreshold, Source={x:Static strings:Strings.Instance}}"/>
            <Slider x:Name="AxisThresholdSlider" Style="{StaticResource RowSlider}" Minimum="0.05" Maximum="1.0" Value="0.5"
                    TickFrequency="0.05"
                    AutomationProperties.Name="{Binding Pad_Shift_AxisThreshold, Source={x:Static strings:Strings.Instance}}"/>
            <TextBox Style="{StaticResource DialogValueEdit}" MinWidth="34"
                     Text="{Binding ElementName=AxisThresholdSlider, Path=Value, StringFormat={}{0:F2}, UpdateSourceTrigger=LostFocus}"
                     AutomationProperties.Name="{Binding Pad_Shift_AxisThreshold, Source={x:Static strings:Strings.Instance}}"/>
            <reset:SettingResetButton Click="ResetSetting_Click" Tag="AxisThreshold" Visibility="{Binding Visibility, ElementName=AxisThresholdSlider}" IsEnabled="{Binding IsEnabled, ElementName=AxisThresholdSlider}" SettingLabel="{Binding Pad_Shift_AxisThreshold, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_?dialog_AxisThresholdSlider_384"/>
        </controls:SettingRow>

        <!-- What the layer does with a control it has no mapping for. Do
             Nothing is where a new layer starts: the layer replaces Base
             entirely. Fall Through to Base keeps the Base mapping of each
             such control. -->
        <controls:SettingRow x:Name="UnmappedRow" MinHeight="44">
            <TextBlock x:Name="UnmappedLabel" Style="{StaticResource DialogLabel}"
                       Text="{Binding Pad_Shift_UnmappedControls, Source={x:Static strings:Strings.Instance}}"/>
            <ComboBox x:Name="InheritUnmappedCombo" Style="{StaticResource DialogSelect}" MinWidth="200" SelectedIndex="1"
                      ToolTip="{Binding Pad_Shift_InheritUnmapped_Tooltip, Source={x:Static strings:Strings.Instance}}"
                      AutomationProperties.Name="{Binding Pad_Shift_UnmappedControls, Source={x:Static strings:Strings.Instance}}">
                <ComboBoxItem Content="{Binding Pad_Shift_FallThroughToBase, Source={x:Static strings:Strings.Instance}}"/>
                <ComboBoxItem Content="{Binding Pad_Shift_DoNothing, Source={x:Static strings:Strings.Instance}}"/>
            </ComboBox>
            <reset:SettingResetButton Click="ResetSetting_Click" Tag="InheritUnmapped" Visibility="{Binding Visibility, ElementName=InheritUnmappedCombo}" IsEnabled="{Binding IsEnabled, ElementName=InheritUnmappedCombo}" SettingLabel="{Binding Pad_Shift_UnmappedControls, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_?dialog_InheritUnmappedBox_433"/>
        </controls:SettingRow>

        <controls:MoreRow x:Name="ShiftMore" Style="{StaticResource DialogMoreRow}"
                          Header="{Binding Common_More, Source={x:Static strings:Strings.Instance}}"
                          Hint="{Binding Pad_Shift_MoreHint, Source={x:Static strings:Strings.Instance}}">
            <StackPanel x:Name="MorePanel">
                <!-- The mode: how the input turns the layer on and off. -->
                <controls:SettingRow x:Name="ModeRow" MinHeight="44">
                    <TextBlock x:Name="ModeLabel" Style="{StaticResource DialogLabel}"
                               Text="{Binding Pad_Shift_Mode, Source={x:Static strings:Strings.Instance}}"/>
                    <ComboBox x:Name="ModeCombo" Style="{StaticResource DialogSelect}" MinWidth="200" MaxWidth="300"
                              controls:SettingRow.Fills="True"
                              ScrollViewer.VerticalScrollBarVisibility="Visible" SelectedValuePath="Value"
                              ItemTemplateSelector="{StaticResource PickLook}"
                              SelectionChanged="ModeCombo_SelectionChanged"
                              AutomationProperties.Name="{Binding Pad_Shift_Mode, Source={x:Static strings:Strings.Instance}}"/>
                    <reset:SettingResetButton Click="ResetSetting_Click" Tag="Mode" Visibility="{Binding Visibility, ElementName=ModeCombo}" IsEnabled="{Binding IsEnabled, ElementName=ModeCombo}" SettingLabel="{Binding Pad_Shift_Mode, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_?dialog_ModeCombo_397"/>
                </controls:SettingRow>

                <!-- The kind of input: one button, two held together, or an
                     axis past a threshold. A Cycle layer steps by buttons
                     and a layer with no button has no input, so neither
                     shows this row. -->
                <controls:SettingRow x:Name="KindRow" MinHeight="44">
                    <TextBlock x:Name="KindLabel" Style="{StaticResource DialogLabel}"
                               Text="{Binding Pad_Shift_Kind, Source={x:Static strings:Strings.Instance}}"/>
                    <ComboBox x:Name="KindCombo" Style="{StaticResource DialogSelect}" MinWidth="200" MaxWidth="300"
                              controls:SettingRow.Fills="True"
                              ScrollViewer.VerticalScrollBarVisibility="Visible" SelectedValuePath="Value"
                              ItemTemplateSelector="{StaticResource PickLook}"
                              SelectionChanged="KindCombo_SelectionChanged"
                              AutomationProperties.Name="{Binding Pad_Shift_Kind, Source={x:Static strings:Strings.Instance}}"/>
                    <reset:SettingResetButton Click="ResetSetting_Click" Tag="Kind" Visibility="{Binding Visibility, ElementName=KindCombo}" IsEnabled="{Binding IsEnabled, ElementName=KindCombo}" SettingLabel="{Binding Pad_Shift_Kind, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_?dialog_KindCombo_225"/>
                </controls:SettingRow>

                <!-- v9 host-layer condition (#370 follow-up): the input
                     only counts while the chosen layer is active, decided
                     at the press and held for the whole press. Any Layer
                     (an empty mask) is how every activator behaved before.
                     A layer with no button has no input to gate. -->
                <controls:SettingRow x:Name="HostLayerRow" MinHeight="44">
                    <TextBlock Style="{StaticResource DialogLabel}"
                               Text="{Binding Pad_Shift_HostLayer, Source={x:Static strings:Strings.Instance}}"
                               ToolTip="{Binding Pad_Shift_HostLayer_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                    <ComboBox x:Name="HostLayerCombo" Style="{StaticResource DialogSelect}" MinWidth="200" MaxWidth="300"
                              controls:SettingRow.Fills="True"
                              DisplayMemberPath="DisplayName" SelectedValuePath="LayerMask"
                              ToolTip="{Binding Pad_Shift_HostLayer_Tooltip, Source={x:Static strings:Strings.Instance}}"
                              AutomationProperties.Name="{Binding Pad_Shift_HostLayer, Source={x:Static strings:Strings.Instance}}"/>
                    <reset:SettingResetButton Click="ResetSetting_Click" Tag="HostLayer" Visibility="{Binding Visibility, ElementName=HostLayerCombo}" IsEnabled="{Binding IsEnabled, ElementName=HostLayerCombo}" SettingLabel="{Binding Pad_Shift_HostLayer, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_?dialog_HostLayerCombo_425"/>
                </controls:SettingRow>

                <!-- A check box of these rows stands where a row's control
                     does: the label column is empty before it, since the
                     box carries its own words, and the box's own inset
                     stands for the gap. -->
                <!-- Fire on Release: the edge modes fire when the input is
                     let go and not when it is pressed (Steam's
                     release-hosted activators). Hold has a job for both
                     edges already and a layer with no button has neither,
                     so the code-behind hides the box for those. -->
                <controls:SettingRow MinHeight="44" Visibility="{Binding Visibility, ElementName=FireOnReleaseBox}">
                    <CheckBox x:Name="FireOnReleaseBox" Margin="150,0,0,0" VerticalAlignment="Center"
                              Content="{Binding Pad_Shift_FireOnRelease, Source={x:Static strings:Strings.Instance}}"
                              ToolTip="{Binding Pad_Shift_FireOnRelease_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                    <reset:SettingResetButton Click="ResetSetting_Click" Tag="FireOnRelease" Visibility="{Binding Visibility, ElementName=FireOnReleaseBox}" IsEnabled="{Binding IsEnabled, ElementName=FireOnReleaseBox}" SettingLabel="{Binding Pad_Shift_FireOnRelease, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_?dialog_FireOnReleaseBox_441"/>
                </controls:SettingRow>

                <!-- v2 PostponeMapping: checked, the input still drives any
                     row that uses it as a source, so one press both changes
                     the layer and fires the input's own mapping. Off, the
                     press is taken by the layer change alone. -->
                <controls:SettingRow MinHeight="44" Visibility="{Binding Visibility, ElementName=PostponeMappingBox}">
                    <CheckBox x:Name="PostponeMappingBox" Margin="150,0,0,0" VerticalAlignment="Center"
                              Content="{Binding Pad_Shift_PostponeMapping, Source={x:Static strings:Strings.Instance}}"
                              ToolTip="{Binding Pad_Shift_PostponeMapping_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                    <reset:SettingResetButton Click="ResetSetting_Click" Tag="PostponeMapping" Visibility="{Binding Visibility, ElementName=PostponeMappingBox}" IsEnabled="{Binding IsEnabled, ElementName=PostponeMappingBox}" SettingLabel="{Binding Pad_Shift_PostponeMapping, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_?dialog_PostponeMappingBox_449"/>
                </controls:SettingRow>

                <!-- A Cycle layer's stops: the layers to step through, in
                     the list's own order, then whether the ends meet and
                     whether Base is a stop (#119). The two inputs above
                     step forward and back. -->
                <StackPanel x:Name="CycleBlock">
                    <DockPanel>
                        <reset:SettingResetButton DockPanel.Dock="Right" Click="ResetSetting_Click" Tag="CycleLayers" SettingLabel="{Binding Pad_Shift_CycleLayers, Source={x:Static strings:Strings.Instance}}" IsEnabled="{Binding IsEnabled, ElementName=CycleLayersList}"/>
                        <TextBlock Style="{StaticResource DialogHead3}" VerticalAlignment="Center"
                                   Text="{Binding Pad_Shift_CycleLayers, Source={x:Static strings:Strings.Instance}}"/>
                    </DockPanel>
                    <Border Style="{StaticResource DialogList}">
                        <ListBox x:Name="CycleLayersList" Style="{StaticResource DialogListBox}" MaxHeight="160"
                                 ItemContainerStyle="{StaticResource DialogListItem}" SelectionMode="Multiple"
                                 AutomationProperties.Name="{Binding Pad_Shift_CycleLayers, Source={x:Static strings:Strings.Instance}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayName}"
                                              IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <controls:SettingRow MinHeight="44">
                        <CheckBox x:Name="CycleWrapBox" Margin="150,0,0,0" VerticalAlignment="Center" IsChecked="True"
                                  Content="{Binding Pad_Shift_CycleWrap, Source={x:Static strings:Strings.Instance}}"
                                  ToolTip="{Binding Pad_Shift_CycleWrap_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                        <reset:SettingResetButton Click="ResetSetting_Click" Tag="CycleWrap" Visibility="{Binding Visibility, ElementName=CycleWrapBox}" IsEnabled="{Binding IsEnabled, ElementName=CycleWrapBox}" SettingLabel="{Binding Pad_Shift_CycleWrap, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_?dialog_CycleWrapBox_467"/>
                    </controls:SettingRow>
                    <controls:SettingRow MinHeight="44">
                        <CheckBox x:Name="CycleIncludeBaseBox" Margin="150,0,0,0" VerticalAlignment="Center"
                                  Content="{Binding Pad_Shift_CycleIncludeBase, Source={x:Static strings:Strings.Instance}}"
                                  ToolTip="{Binding Pad_Shift_CycleIncludeBase_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                        <reset:SettingResetButton Click="ResetSetting_Click" Tag="CycleIncludeBase" Visibility="{Binding Visibility, ElementName=CycleIncludeBaseBox}" IsEnabled="{Binding IsEnabled, ElementName=CycleIncludeBaseBox}" SettingLabel="{Binding Pad_Shift_CycleIncludeBase, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_?dialog_CycleIncludeBaseBox_470"/>
                    </controls:SettingRow>
                </StackPanel>

                <!-- The delay. With an edge mode (Toggle, Latch, Sticky) a
                     delay above zero makes the switch a long press: it
                     fires once when the hold crosses the delay (#206). -->
                <controls:SettingRow x:Name="DelayRow" MinHeight="44">
                    <TextBlock Style="{StaticResource DialogLabel}"
                               Text="{Binding Pad_Shift_Delay, Source={x:Static strings:Strings.Instance}}"
                               ToolTip="{Binding Pad_Shift_Delay_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                    <Slider x:Name="DelaySlider" Style="{StaticResource RowSlider}" Minimum="0" Maximum="2000" Value="0"
                            TickFrequency="50"
                            ToolTip="{Binding Pad_Shift_Delay_Tooltip, Source={x:Static strings:Strings.Instance}}"
                            AutomationProperties.Name="{Binding Pad_Shift_Delay, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBox Style="{StaticResource DialogValueEdit}" MinWidth="34"
                             Text="{Binding ElementName=DelaySlider, Path=Value, StringFormat={}{0:F0}, UpdateSourceTrigger=LostFocus}"
                             AutomationProperties.Name="{Binding Pad_Shift_Delay, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock Style="{StaticResource DialogUnit}"
                               Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}"/>
                    <ui:Button Click="ResetDelay_Click" Style="{StaticResource QuietResetButton}" VerticalAlignment="Center"
                               ToolTip="{Binding Pad_ResetShiftDelay, Source={x:Static strings:Strings.Instance}}"
                               AutomationProperties.Name="{Binding Pad_ResetShiftDelay, Source={x:Static strings:Strings.Instance}}">
                        <reset:GlyphText Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                    </ui:Button>
                </controls:SettingRow>

                <!-- Auto-cancel, for a Toggle layer alone: the layer lets
                     go by itself after this long (#206). -->
                <controls:SettingRow x:Name="AutoCancelRow" MinHeight="44">
                    <TextBlock x:Name="AutoCancelLabel" Style="{StaticResource DialogLabel}"
                               Text="{Binding Pad_Shift_AutoCancel, Source={x:Static strings:Strings.Instance}}"
                               ToolTip="{Binding Pad_Shift_AutoCancel_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                    <Slider x:Name="AutoCancelSlider" Style="{StaticResource RowSlider}" Minimum="0" Maximum="30000" Value="0"
                            TickFrequency="500"
                            ToolTip="{Binding Pad_Shift_AutoCancel_Tooltip, Source={x:Static strings:Strings.Instance}}"
                            AutomationProperties.Name="{Binding Pad_Shift_AutoCancel, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBox Style="{StaticResource DialogValueEdit}" MinWidth="42"
                             Text="{Binding ElementName=AutoCancelSlider, Path=Value, StringFormat={}{0:F0}, UpdateSourceTrigger=LostFocus}"
                             AutomationProperties.Name="{Binding Pad_Shift_AutoCancel, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock Style="{StaticResource DialogUnit}"
                               Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}"/>
                    <ui:Button Click="ResetAutoCancel_Click" Style="{StaticResource QuietResetButton}" VerticalAlignment="Center"
                               ToolTip="{Binding Pad_ResetShiftAutoCancel, Source={x:Static strings:Strings.Instance}}"
                               AutomationProperties.Name="{Binding Pad_ResetShiftAutoCancel, Source={x:Static strings:Strings.Instance}}">
                        <reset:GlyphText Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                    </ui:Button>
                </controls:SettingRow>

                <!-- The layer's color, as the controller page's Lighting
                     section picks one: the hue and shade plate, a swatch
                     with its hex, and a slider per channel. The reset at
                     the heading's end takes the color away, so the layer's
                     tab has no tint and its flyout dot is the usual one.
                     A layer with no color shows an empty swatch and None
                     in the hex field, whatever the plate stands at. -->
                <StackPanel x:Name="ColorBlock">
                    <DockPanel>
                        <ui:Button x:Name="ClearColorButton" DockPanel.Dock="Right" Style="{StaticResource QuietResetButton}"
                                   VerticalAlignment="Center" Click="ClearColor_Click"
                                   ToolTip="{Binding Pad_ResetLayerColor, Source={x:Static strings:Strings.Instance}}"
                                   AutomationProperties.Name="{Binding Pad_ResetLayerColor, Source={x:Static strings:Strings.Instance}}">
                            <reset:GlyphText Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </ui:Button>
                        <TextBlock Style="{StaticResource DialogHead3}" VerticalAlignment="Center"
                                   Text="{Binding Pad_Shift_Color, Source={x:Static strings:Strings.Instance}}"/>
                    </DockPanel>
                    <views:ColorPickerControl x:Name="ColorPicker" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border x:Name="ColorPreviewSwatch" Width="48" Height="34" CornerRadius="6"
                                BorderBrush="{DynamicResource SteelLineBrush}" BorderThickness="1"
                                Background="{DynamicResource SteelFieldBrush}">
                            <Border x:Name="ColorPreviewFill" CornerRadius="5">
                                <Border.Background>
                                    <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                        <Binding ElementName="ColorPicker" Path="Red"/>
                                        <Binding ElementName="ColorPicker" Path="Green"/>
                                        <Binding ElementName="ColorPicker" Path="Blue"/>
                                    </MultiBinding>
                                </Border.Background>
                            </Border>
                        </Border>
                        <TextBlock Text="{Binding Pad_Lighting_Hex, Source={x:Static strings:Strings.Instance}}"
                                   VerticalAlignment="Center" Margin="12,0,10,0"/>
                        <ui:TextBox x:Name="ColorHexBox" Style="{StaticResource DialogTextBox}" Width="110"
                                    FontFamily="{StaticResource TelemetryFontFamily}"
                                    PlaceholderText="{Binding Common_None, Source={x:Static strings:Strings.Instance}}"
                                    KeyDown="ColorHexBox_KeyDown" LostFocus="ColorHexBox_LostFocus"
