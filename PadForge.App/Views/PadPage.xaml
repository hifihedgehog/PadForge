                                                  ToolTip="{Binding Menu_FunctionRow_Caption, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding FunctionRow, Mode=TwoWay}"/>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="FunctionRow" SettingLabel="{Binding Menu_FunctionRow, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MenuEditorItem_FunctionRow"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Menu_FunctionRow_Caption, Source={x:Static strings:Strings.Instance}}" Margin="28,0,0,10"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" FontSize="12"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <CheckBox VerticalAlignment="Center" Content="{Binding Menu_WordSuggestions, Source={x:Static strings:Strings.Instance}}"
                                                  ToolTip="{Binding Menu_WordSuggestions_Caption, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding Suggestions, Mode=TwoWay}"/>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="Suggestions" SettingLabel="{Binding Menu_WordSuggestions, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MenuEditorItem_Suggestions"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Menu_WordSuggestions_Caption, Source={x:Static strings:Strings.Instance}}" Margin="28,0,0,10"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" FontSize="12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="MenuKeyboardCardLabel"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding Menu_SymbolsPage, Source={x:Static strings:Strings.Instance}}"
                                                   ToolTip="{Binding Menu_SymbolsPage_Tip, Source={x:Static strings:Strings.Instance}}"
                                                   Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="240"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBox Width="360" Text="{Binding Symbols, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="{Binding Menu_SymbolsPage_Tip, Source={x:Static strings:Strings.Instance}}"
                                                     TextWrapping="Wrap" AcceptsReturn="False" MaxLength="400"/>
                                            <ui:Button Command="{Binding ResetSymbolsCommand}" Style="{StaticResource ResetButton}" Margin="6,0,0,0" VerticalAlignment="Top" ToolTip="{Binding Menu_Reset_Symbols, Source={x:Static strings:Strings.Instance}}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Overlay geometry card -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,4,0,12" Padding="12">
                                <!-- Own shared-size scope: this card's labels line up with each
                                     other, not with the wider editor rows outside it. -->
                                <StackPanel Grid.IsSharedSizeScope="True">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Dashboard_MenuOverlay, Source={x:Static strings:Strings.Instance}}"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <ui:Button Command="{Binding ResetGeometryCommand}" Style="{StaticResource ResetButton}" Margin="12,0,0,0" ToolTip="{Binding Menu_Reset_Geometry, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Menu_Keyboard_Overlay_Caption, Source={x:Static strings:Strings.Instance}}" Margin="0,0,0,8"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" FontSize="12"
                                               Visibility="{Binding IsKeyboard, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                                Visibility="{Binding IsCellMenu, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <CheckBox VerticalAlignment="Center" Content="{Binding Menu_ShowLabels, Source={x:Static strings:Strings.Instance}}"
                                                  ToolTip="{Binding Menu_ShowLabels_Tip, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding ShowLabels}"/>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="ShowLabels" SettingLabel="{Binding Menu_ShowLabels, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MenuEditorItem_ShowLabels_12924"/>
                                    </StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGeometryLabel"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding Menu_Position, Source={x:Static strings:Strings.Instance}}"
                                                   ToolTip="{Binding Menu_Position_Tip, Source={x:Static strings:Strings.Instance}}"
                                                   Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="240"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    ToolTip="{Binding Menu_Position_Tip, Source={x:Static strings:Strings.Instance}}">
                                            <ui:NumberBox Width="200" Minimum="0" Maximum="100" SmallChange="5"
                                                          Value="{Binding PosXPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="PosXPercent" SettingLabel="{Binding ResetLabel_PositionX, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MenuEditorItem_PosXPercent_12937" Margin="4,0,8,0"/>
                                            <ui:NumberBox Width="200" Minimum="0" Maximum="100" SmallChange="5" Margin="8,0,0,0"
                                                          Value="{Binding PosYPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="PosYPercent" SettingLabel="{Binding ResetLabel_PositionY, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MenuEditorItem_PosYPercent_12939"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGeometryLabel"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding Menu_Scale, Source={x:Static strings:Strings.Instance}}"
                                                   ToolTip="{Binding Menu_Scale_Tip, Source={x:Static strings:Strings.Instance}}"
                                                   Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="240"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <ui:NumberBox Width="200" Minimum="10" Maximum="400" SmallChange="10"
                                                          ToolTip="{Binding Menu_Scale_Tip, Source={x:Static strings:Strings.Instance}}"
                                                          Value="{Binding ScalePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="%" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="ScalePercent" SettingLabel="{Binding Menu_Scale, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MenuEditorItem_ScalePercent_12954"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGeometryLabel"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding Menu_Opacity, Source={x:Static strings:Strings.Instance}}"
                                                   ToolTip="{Binding Menu_Opacity_Tip, Source={x:Static strings:Strings.Instance}}"
                                                   Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="240"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <ui:NumberBox Width="200" Minimum="5" Maximum="100" SmallChange="5"
                                                          ToolTip="{Binding Menu_Opacity_Tip, Source={x:Static strings:Strings.Instance}}"
                                                          Value="{Binding OpacityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="%" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="OpacityPercent" SettingLabel="{Binding Menu_Opacity, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MenuEditorItem_OpacityPercent_12971"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Cell bindings -->
                            <TextBlock Text="{Binding Menu_CellBindings, Source={x:Static strings:Strings.Instance}}"
                                       FontWeight="SemiBold" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Visibility="{Binding IsCellMenu, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <!-- Cell rows share their own auto column for the "Center"/"Item N"
                                 header (Menu_CellCenter is a word, not a number, and is longer
                                 than 72px in several locales). The pickers keep their rhythm
                                 through MinWidth but can widen for long key / button names. -->
                            <ItemsControl ItemsSource="{Binding Cells}" Grid.IsSharedSizeScope="True"
                                          Visibility="{Binding IsCellMenu, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuCellHeader"/>
                                                <!-- Icon indicator and size live in their own shared
                                                     column (#413), so a row with an icon and a row
                                                     without keep their label and pickers aligned. -->
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuCellIconControls"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Header}" VerticalAlignment="Center"
                                                       Margin="0,0,8,0" TextWrapping="Wrap" MaxWidth="160"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <!-- Imported Steam icon indicator (translator v21): the
                                                 resolved local-Steam glyph, or the picture placeholder
                                                 when the art is not on this machine. Beside it the
                                                 per-cell size (#413, @brawler14801): a bar rather than
                                                 a number so neighboring cells compare by eye, gated on
                                                 HasIcon (not on the image resolving) so unavailable
                                                 art keeps its size editable, and reset to 100 with
                                                 the icon so no size sits on a cell that renders none. -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0"
                                                        Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <controls:DecorativeImage FlowDirection="LeftToRight" Width="16" Height="16" Margin="0,0,6,0"
                                                       VerticalAlignment="Center"
                                                       Source="{Binding IconImage}"
                                                       ToolTip="{Binding IconName}"
                                                       Visibility="{Binding IconImage, Converter={StaticResource NullToCollapsedConverter}}"/>
                                                <!-- An emoji icon (#471) is its own indicator. -->
                                                <TextBlock Text="{Binding IconName}" Width="16" Margin="0,0,6,0"
                                                           FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI"
                                                           FontSize="13" TextAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsGlyphIcon, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <controls:GlyphText Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14" Margin="0,0,6,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           ToolTip="{Binding IconName}"
                                                           Visibility="{Binding ShowIconGlyph, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <Slider Width="72" Minimum="25" Maximum="200"
                                                        SmallChange="5" LargeChange="25"
                                                        TickFrequency="25" IsSnapToTickEnabled="False"
                                                        VerticalAlignment="Center" Margin="0,0,6,0"
                                                        Value="{Binding IconScalePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        ToolTip="{Binding Menu_IconScale_Tip, Source={x:Static strings:Strings.Instance}}"
                                                        AutomationProperties.Name="{Binding Menu_IconScale, Source={x:Static strings:Strings.Instance}}"/>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="IconScalePercent" SettingLabel="{Binding Menu_IconScale, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MenuCellItem_IconScalePercent_13029" Margin="4,0,8,0"/>
                                                <TextBlock Width="42" VerticalAlignment="Center" TextAlignment="Right"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Text="{Binding IconScalePercent, StringFormat={}{0}%}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <!-- Pickers auto-size to their widest ITEM, one
                                                     width group per column, so rows stay in
                                                     column across selections AND long locales
                                                     never clip (fixed widths clipped Italian /
                                                     German option names). -->
                                                <TextBox Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Width="160"
                                                         ToolTip="{Binding Menu_CellLabel_Tip, Source={x:Static strings:Strings.Instance}}"/>
                                                <ComboBox MinWidth="140" Margin="8,0,0,0"
                                                          common:ComboBoxWidthBehavior.SizeToItems="True"
                                                          common:ComboBoxWidthBehavior.WidthGroup="MenuCellKindCombos"
                                                          ToolTip="{Binding Menu_BindingKind_Tip, Source={x:Static strings:Strings.Instance}}"
                                                          ItemsSource="{Binding BindingKindOptions}"
                                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                                          SelectedValue="{Binding BindingKind, Mode=TwoWay}"/>
                                                <ComboBox AutomationProperties.Name="{Binding Menu_Binding_Key, Source={x:Static strings:Strings.Instance}}" MinWidth="140" Margin="8,0,0,0"
                                                          common:ComboBoxWidthBehavior.SizeToItems="True"
                                                          common:ComboBoxWidthBehavior.WidthGroup="MenuCellKeyCombos"
                                                          ItemsSource="{Binding KeyOptions}"
                                                          DisplayMemberPath="Label" SelectedValuePath="Vk"
                                                          SelectedValue="{Binding SelectedKeyVk, Mode=TwoWay}"
                                                          Visibility="{Binding ShowKeyPicker, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <ComboBox AutomationProperties.Name="{Binding Menu_Binding_Button, Source={x:Static strings:Strings.Instance}}" MinWidth="140" Margin="8,0,0,0"
                                                          common:ComboBoxWidthBehavior.SizeToItems="True"
                                                          common:ComboBoxWidthBehavior.WidthGroup="MenuCellButtonCombos"
                                                          ItemsSource="{Binding ButtonOptions}"
                                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                                          SelectedValue="{Binding SelectedButtonFlag, Mode=TwoWay}"
                                                          Visibility="{Binding ShowButtonPicker, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <!-- #390 macro cells: the slot's macros, with the
                                                     stale-name marked entry per the never-lie rule. -->
                                                <ComboBox MinWidth="140" Margin="8,0,0,0"
                                                          common:ComboBoxWidthBehavior.SizeToItems="True"
                                                          common:ComboBoxWidthBehavior.WidthGroup="MenuCellMacroCombos"
                                                          ToolTip="{Binding Menu_MacroPicker_Tip, Source={x:Static strings:Strings.Instance}}"
                                                          ItemsSource="{Binding MacroOptions}"
                                                          DisplayMemberPath="Label" SelectedValuePath="Descriptor"
                                                          SelectedValue="{Binding SelectedMacroName, Mode=TwoWay}"
                                                          Visibility="{Binding ShowMacroPicker, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <!-- Cell icon: an emoji, a pack entry or an image
                                                     file, from the shared icon picker (#390, #471). -->
                                                <ui:Button AutomationProperties.Name="{Binding Menu_ChooseIcon_Tip, Source={x:Static strings:Strings.Instance}}" Click="MenuCellChooseIcon_Click" Margin="6,0,0,0"
                                                           ToolTip="{Binding Menu_ChooseIcon_Tip, Source={x:Static strings:Strings.Instance}}">
                                                    <controls:GlyphText Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                                </ui:Button>
                                                <ui:Button Command="{Binding ResetCellCommand}" Style="{StaticResource ResetButton}" Margin="6,0,0,0" ToolTip="{Binding Menu_Reset_Cell, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <controls:FoldList>
                            <!-- Icon Packages card (#390), the Sound Packages
                                 card's shape on the Menus tab. -->
                            <controls:FoldCard x:Name="IconPackagesFoldCard" StateKey="Pad.Menus.IconPackages" Visibility="{Binding IsCellMenu, Converter={StaticResource BoolToVisibilityConverter}}"
                                               Header="{Binding Pad_Menus_IconPackages_Header, Source={x:Static strings:Strings.Instance}}"
                                               Hint="{Binding Pad_IconPackages_FoldHint, Source={x:Static strings:Strings.Instance}}"
                                               Description="{Binding Pad_Menus_IconPackages_Desc, Source={x:Static strings:Strings.Instance}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="{Binding Pad_Menus_IconPackages_Add, Source={x:Static strings:Strings.Instance}}"
                                                Click="IconPackageAdd_Click" Padding="10,4"
                                                ToolTip="{Binding Pad_Menus_IconPackages_Add_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <Button Content="{Binding Pad_Menus_IconPackages_Create, Source={x:Static strings:Strings.Instance}}"
                                                Click="IconPackageCreate_Click" Padding="10,4" Margin="6,0,0,0"
                                                ToolTip="{Binding Pad_Menus_IconPackages_Create_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <Button Content="{Binding Common_Remove, Source={x:Static strings:Strings.Instance}}"
                                                Click="IconPackageRemove_Click" Padding="10,4" Margin="6,0,0,0"
                                                ToolTip="{Binding Pad_Menus_IconPackages_Remove_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="IconPackagesEmptyText"
                                               Text="{Binding Pad_Menus_IconPackages_Empty, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardDescription}"/>
                                    <ListBox x:Name="IconPackagesList" MaxHeight="170"
                                             ItemContainerStyle="{StaticResource EmberSelectListItem}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <controls:GlyphText Text="&#xEB9F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Path}" VerticalAlignment="Center"
                                                               Margin="10,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </controls:FoldCard>
                            </controls:FoldList>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
                    </controls:ContentTabControl>
                </Grid>
            </TabItem>
        </controls:ContentTabControl>
    </Grid>
</UserControl>
