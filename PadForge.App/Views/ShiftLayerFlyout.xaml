<Window common:Reach.Class="Free" x:Class="PadForge.Views.ShiftLayerFlyout" FontFamily="{DynamicResource BodyFontFamily}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:PadForge.Common"
        xmlns:controls="clr-namespace:PadForge.Controls"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Background="Transparent">

    <!--
        Win11 volume OSD replica — matches ProfileSwitchOverlay's pixel-
        measured chrome (bg #2D2E2E, border #141516, corner radius 8,
        layered shadow border + content border so ClearType survives).
        How long it stays is each layer's own Flyout choice (#581): while
        the layer is on, for two seconds, or not at all.
    -->
    <Grid ClipToBounds="True">
        <Grid x:Name="FlyoutPanel" Margin="10,10,10,14">
            <!-- Shadow layer: empty border with DropShadowEffect, behind content.
                 Keeping the effect OFF the content border preserves ClearType text. -->
            <Border x:Name="ShadowBorder"
                    CornerRadius="8"
                    Background="#2D2E2E">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="3"
                                      Direction="270" Opacity="0.30" Color="Black"/>
                </Border.Effect>
            </Border>

            <!-- Content layer: no Effect, so ClearType works and no gray bleed -->
            <Border x:Name="ContentBorder"
                    CornerRadius="8"
                    Background="#2D2E2E"
                    BorderBrush="#141516"
                    BorderThickness="1">
                <Grid Margin="16,13,16,13">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusIcon"
                                   Text="&#x21E7;"
                                   FontFamily="{x:Static common:TextFaces.Emoji}"
                                   FontSize="18"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   Foreground="White"/>

                        <!-- A picture icon (#471), in the glyph's spot and box. -->
                        <controls:DecorativeImage FlowDirection="LeftToRight" x:Name="StatusImage"
                               Width="20" Height="20"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Visibility="Collapsed"/>

                        <!-- One line. The code gives it the monitor's width as
                             its most, and a longer name ends in an ellipsis. -->
                        <TextBlock x:Name="LayerNameText"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="White"/>

                        <Ellipse x:Name="ColorDot"
                                 Width="10" Height="10"
                                 VerticalAlignment="Center"
                                 Fill="#888"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
