<views:DialogWindow AutomationProperties.IsDialog="True" x:Class="PadForge.Views.PairDeviceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        xmlns:common="clr-namespace:PadForge.Common"
        xmlns:controls="clr-namespace:PadForge.Controls"
        xmlns:reset="clr-namespace:PadForge.Controls"
        xmlns:views="clr-namespace:PadForge.Views"
        Title="{Binding WiiPair_Title, Source={x:Static strings:Strings.Instance}}">

    <!-- Pairing and adding controllers Windows cannot find by itself (#116,
         #277, #33, #574), as the Links board draws Pair a Wii Remote: what
         to do, a live line that says what PadForge is doing, and Cancel
         while it works. The Devices page has one button for five families
         of controller, so the family is the dialog's first row, and the
         code-behind titles the dialog for the family chosen. Pair, or Add
         for the two families that are named and not searched for, shows
         until a search runs and comes back when one ends with nothing
         paired. -->
    <views:DialogWindow.Resources>
        <!-- An added serial controller's row is read by its words. -->
        <Style x:Key="SerialRow" TargetType="ListBoxItem" BasedOn="{StaticResource DialogListItemLinks}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Display, TargetNullValue=''}"/>
        </Style>
    </views:DialogWindow.Resources>

    <views:DialogWindow.Foot>
        <controls:FlexLinePanel Style="{StaticResource DialogFootPanel}">
            <Button x:Name="DismissButton" Style="{StaticResource DialogButton}" IsCancel="True"
                    Content="{Binding Common_Cancel, Source={x:Static strings:Strings.Instance}}"
                    Click="Dismiss_Click"/>
            <Button x:Name="PairButton" Style="{StaticResource DialogPrimaryButton}"
                    Content="{Binding WiiPair_Pair, Source={x:Static strings:Strings.Instance}}"
                    Click="Pair_Click"/>
        </controls:FlexLinePanel>
    </views:DialogWindow.Foot>

    <StackPanel common:InitialFocus.First="True">
        <controls:SettingRow MinHeight="44">
            <TextBlock Style="{StaticResource DialogLabel}"
                       Text="{Binding WiiPair_Family, Source={x:Static strings:Strings.Instance}}"/>
            <ComboBox x:Name="FamilyCombo" Style="{StaticResource DialogSelect}" controls:SettingRow.Fills="True" SelectedIndex="0"
                      SelectionChanged="Family_SelectionChanged"
                      AutomationProperties.Name="{Binding WiiPair_Family, Source={x:Static strings:Strings.Instance}}">
                <ComboBoxItem Content="{Binding WiiPair_FamilyWii, Source={x:Static strings:Strings.Instance}}"/>
                <ComboBoxItem Content="{Binding WiiPair_FamilyDs3, Source={x:Static strings:Strings.Instance}}"/>
                <ComboBoxItem Content="{Binding MovePair_Family, Source={x:Static strings:Strings.Instance}}"/>
                <ComboBoxItem Content="{Binding SerialPair_Family, Source={x:Static strings:Strings.Instance}}"/>
                <ComboBoxItem Content="{Binding DjiPair_Family, Source={x:Static strings:Strings.Instance}}"/>
            </ComboBox>
            <reset:SettingResetButton Click="ResetSetting_Click" Tag="Family" Visibility="{Binding Visibility, ElementName=FamilyCombo}" IsEnabled="{Binding IsEnabled, ElementName=FamilyCombo}" SettingLabel="{Binding WiiPair_Family, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_?dialog_FamilyCombo_75"/>
        </controls:SettingRow>

        <!-- A Wii Remote is paired in two steps, which the board numbers. -->
        <StackPanel x:Name="WiiSteps" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="1."/>
                <TextBlock Grid.Column="1" TextWrapping="Wrap"
                           Text="{Binding WiiPair_Step1, Source={x:Static strings:Strings.Instance}}"/>
            </Grid>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="2."/>
                <TextBlock Grid.Column="1" TextWrapping="Wrap"
                           Text="{Binding WiiPair_Step2, Source={x:Static strings:Strings.Instance}}"/>
            </Grid>
        </StackPanel>

        <!-- The other families say what to do in one paragraph. -->
        <TextBlock x:Name="InstructionsText" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

        <!-- A Wii Remote paired for now only, by holding 1 and 2. -->
        <controls:SettingRow MinHeight="44" Margin="0,4,0,0" Visibility="{Binding Visibility, ElementName=TemporaryCheck}">
            <CheckBox x:Name="TemporaryCheck" VerticalAlignment="Center" Margin="-11,0,0,0"
                      Content="{Binding WiiPair_Temporary, Source={x:Static strings:Strings.Instance}}"/>
            <reset:SettingResetButton Click="ResetSetting_Click" Tag="Temporary" Visibility="{Binding Visibility, ElementName=TemporaryCheck}" IsEnabled="{Binding IsEnabled, ElementName=TemporaryCheck}" SettingLabel="{Binding WiiPair_Temporary, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_?dialog_TemporaryCheck_88"/>
        </controls:SettingRow>

        <!-- Serial controllers (#33): an adapter says nothing about the
             device behind it, so the user names the port and the
             controller. -->
        <StackPanel x:Name="SerialPickers" Visibility="Collapsed" Margin="0,4,0,0">
            <controls:SettingRow MinHeight="44">
                <TextBlock Style="{StaticResource DialogLabel}"
                           Text="{Binding SerialPair_Port, Source={x:Static strings:Strings.Instance}}"/>
                <ComboBox x:Name="PortCombo" Style="{StaticResource DialogSelect}" controls:SettingRow.Fills="True"
                          DropDownOpened="PortCombo_DropDownOpened"
                          AutomationProperties.Name="{Binding SerialPair_Port, Source={x:Static strings:Strings.Instance}}"/>
                <reset:SettingResetButton Click="ResetSetting_Click" Tag="SerialPort" IsEnabled="{Binding IsEnabled, ElementName=PortCombo}" SettingLabel="{Binding SerialPair_Port, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_?dialog_PortCombo"/>
            </controls:SettingRow>
            <controls:SettingRow MinHeight="44">
                <TextBlock Style="{StaticResource DialogLabel}"
                           Text="{Binding SerialPair_Controller, Source={x:Static strings:Strings.Instance}}"/>
                <ComboBox x:Name="ControllerCombo" Style="{StaticResource DialogSelect}" controls:SettingRow.Fills="True" SelectedIndex="0"
                          AutomationProperties.Name="{Binding SerialPair_Controller, Source={x:Static strings:Strings.Instance}}"/>
                <reset:SettingResetButton Click="ResetSetting_Click" Tag="SerialController" IsEnabled="{Binding IsEnabled, ElementName=ControllerCombo}" SettingLabel="{Binding SerialPair_Controller, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_?dialog_ControllerCombo"/>
            </controls:SettingRow>
        </StackPanel>

        <!-- DJI RC and RC 2 over the network (#33 Part 6): the remote
             serves its sticks on a TCP port, so the user names its
             address. -->
        <StackPanel x:Name="DjiPickers" Visibility="Collapsed" Margin="0,4,0,0">
            <controls:SettingRow MinHeight="44">
                <TextBlock Style="{StaticResource DialogLabel}"
                           Text="{Binding DjiPair_Address, Source={x:Static strings:Strings.Instance}}"/>
                <ui:TextBox x:Name="DjiAddressBox" Style="{StaticResource DialogTextBox}" controls:SettingRow.Fills="True"
                            AutomationProperties.Name="{Binding DjiPair_Address, Source={x:Static strings:Strings.Instance}}"/>
                <reset:SettingResetButton Click="ResetSetting_Click" Tag="DjiAddress" IsEnabled="{Binding IsEnabled, ElementName=DjiAddressBox}" SettingLabel="{Binding DjiPair_Address, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_?dialog_DjiAddressBox"/>
            </controls:SettingRow>
        </StackPanel>

        <!-- The live line, while there is something to say. The flame is
             the wait color while PadForge works and ember once a
             controller is paired or added. The step before a verdict stays
             over it: a failure's text says the failing step is shown
             above, and a bug report needs that step (discussion #283
             arrived with none). -->
        <Border x:Name="StatusPanel" Style="{StaticResource DialogLiveBox}" Margin="0,14,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Path x:Name="LiveFlame" FlowDirection="LeftToRight" Data="{StaticResource FlameOuterGeometry}"
                      Width="13" Height="16" Stretch="Uniform" VerticalAlignment="Center"
                      Fill="{DynamicResource WaitBrush}"/>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="LastStepText" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,2" Visibility="Collapsed"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" common:LiveText.Polite="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- The Wii Remotes a search has found so far. -->
        <StackPanel x:Name="FoundPanel" Visibility="Collapsed">
            <TextBlock Style="{StaticResource DialogHead3}"
                       Text="{Binding WiiPair_Found, Source={x:Static strings:Strings.Instance}}"/>
            <Border Style="{StaticResource DialogList}">
                <ListBox x:Name="FoundList" Style="{StaticResource DialogListBox}" MaxHeight="126"
                         ItemContainerStyle="{StaticResource DialogListItemLinks}"
                         AutomationProperties.Name="{Binding WiiPair_Found, Source={x:Static strings:Strings.Instance}}"/>
            </Border>
        </StackPanel>

        <!-- The serial controllers added so far, each with its Remove.
             Removing one closes its port. -->
        <StackPanel x:Name="SerialAddedPanel" Visibility="Collapsed">
            <TextBlock Style="{StaticResource DialogHead3}"
                       Text="{Binding SerialPair_Added, Source={x:Static strings:Strings.Instance}}"/>
            <Border Style="{StaticResource DialogList}">
                <ListBox x:Name="SerialAddedList" Style="{StaticResource DialogListBox}" MaxHeight="168"
                         ItemContainerStyle="{StaticResource SerialRow}"
                         AutomationProperties.Name="{Binding SerialPair_Added, Source={x:Static strings:Strings.Instance}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center" Margin="0,0,12,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Style="{StaticResource DialogSmallQuietButton}"
                                        Content="{Binding Common_Remove, Source={x:Static strings:Strings.Instance}}"
                                        Click="SerialRemove_Click" Tag="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </StackPanel>

        <!-- The DJI remotes added so far, each with its Remove. Removing
             one closes its link. -->
        <StackPanel x:Name="DjiAddedPanel" Visibility="Collapsed">
            <TextBlock Style="{StaticResource DialogHead3}"
                       Text="{Binding DjiPair_Added, Source={x:Static strings:Strings.Instance}}"/>
            <Border Style="{StaticResource DialogList}">
                <ListBox x:Name="DjiAddedList" Style="{StaticResource DialogListBox}" MaxHeight="168"
                         ItemContainerStyle="{StaticResource DialogListItemLinks}"
                         AutomationProperties.Name="{Binding DjiPair_Added, Source={x:Static strings:Strings.Instance}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="0,0,12,0"
                                           FontFamily="{DynamicResource TelemetryFontFamily}" FontSize="13"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Style="{StaticResource DialogSmallQuietButton}"
                                        Content="{Binding Common_Remove, Source={x:Static strings:Strings.Instance}}"
                                        Click="DjiRemove_Click" Tag="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </StackPanel>
    </StackPanel>
</views:DialogWindow>
