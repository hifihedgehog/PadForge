    <!-- Ember section header (#175): ember glyph + tightened title,
         one treatment for every page section. -->
    <Style x:Key="SectionGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource EmberBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,7,0"/>
    </Style>
    <!-- Artifact chips (#175): cold = physical fact, ember = virtual
         fact, ghost = neutral. Border carries the chip; the child text
         inherits the matching foreground. -->
    <Style x:Key="ChipCold" TargetType="Border">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="9,3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#5958B6E4"/>
        <Setter Property="Background" Value="#1A58B6E4"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ColdBrush}"/>
        <Setter Property="TextElement.FontSize" Value="12.5"/>
        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ChipEmber" TargetType="Border">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="9,3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#66FF6B2C"/>
        <Setter Property="Background" Value="#1AFF6B2C"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource EmberHotBrush}"/>
        <Setter Property="TextElement.FontSize" Value="12.5"/>
        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ChipGhost" TargetType="Border">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="9,3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
        <Setter Property="TextElement.FontSize" Value="12.5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <!-- 1px stroke (#175): without an edge, cards float as blobs on
             the steel ground. Iteration 53 adds a hover elevation: the
             stroke heats to steel-lift over 300ms and cools back over
             1200ms. ColorAnimation needs a local SolidColorBrush the
             style owns, so DynamicResource cannot theme the stroke.
             Round-3 A1 theme-scopes it instead through EmberThemeProbe
             (flipped by EmberTheme.ApplyAccent): a DataTrigger swaps the
             rest brush per ground, and per-ground hover MultiDataTriggers
             carry the heat/cool storyboards. Light rest matches the
             SteelLineBrush light value; dark values are unchanged. The
             theme trigger's zero-length animations stomp any color a
             completed hover storyboard still holds on the animation
             layer, so a live theme flip never leaves a stale stroke.
             The hover animations omit From so a mid-fade re-enter eases
             from the current color instead of snapping. -->
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush">
            <Setter.Value>
                <SolidColorBrush Color="#253049"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDark, Source={x:Static common:EmberThemeProbe.Instance}}"
                         Value="False">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation
                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                To="#C9CDD6"
                                Duration="0:0:0"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation
                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                To="#253049"
                                Duration="0:0:0"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
                <Setter Property="BorderBrush">
                    <Setter.Value>
                        <SolidColorBrush Color="#C9CDD6"/>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsDark, Source={x:Static common:EmberThemeProbe.Instance}}" Value="True"/>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <!-- Hover glow (#175): the stroke heats toward blue-steel,
                     so the glow is cold. Static Setter in the same trigger
                     as the color change; only the stroke color animates. -->
                <MultiDataTrigger.Setters>
                    <Setter Property="Effect" Value="{StaticResource ColdHoverGlow}"/>
                </MultiDataTrigger.Setters>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation
                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                To="#35507A"
                                Duration="0:0:0.3">
                                <ColorAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseOut"/>
                                </ColorAnimation.EasingFunction>
                            </ColorAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation
                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                To="#253049"
                                Duration="0:0:1.2">
                                <ColorAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseIn"/>
                                </ColorAnimation.EasingFunction>
                            </ColorAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsDark, Source={x:Static common:EmberThemeProbe.Instance}}" Value="False"/>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.Setters>
                    <Setter Property="Effect" Value="{StaticResource ColdHoverGlow}"/>
                </MultiDataTrigger.Setters>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation
                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                To="#AEB6C4"
                                Duration="0:0:0.3">
                                <ColorAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseOut"/>
                                </ColorAnimation.EasingFunction>
                            </ColorAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation
                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                To="#C9CDD6"
                                Duration="0:0:1.2">
                                <ColorAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseIn"/>
                                </ColorAnimation.EasingFunction>
                            </ColorAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Divider-separated SECTION title inside a card (e.g. the per-stick
         Steering / Sensitivity Curves sections). Card headers get their 8px
         title-to-description gap from the header StackPanel's margin; a bare
         section title has no wrapping panel, so the margin lives on the
         style — same rhythm, no number to copy from a neighbor. -->
    <Style x:Key="CardSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource CardTitle}">
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- The ONE formatting style for description text under a card title.
         Margin lives here so new cards inherit the canonical title-to-
         description rhythm without copying numbers from a neighbor. -->
    <Style x:Key="CardDescription" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

</ResourceDictionary>
