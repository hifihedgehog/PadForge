<UserControl x:Class="PadForge.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:common="clr-namespace:PadForge.Common"
             xmlns:strings="clr-namespace:PadForge.Resources.Strings">

    <UserControl.Resources>
        <!-- Type-switch button style: transparent bg, dark gray hover, rounded corners -->
        <Style x:Key="TypeSwitchButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Padding="24,0">
        <StackPanel Margin="0,16,0,16">

            <!-- Page header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="&#xF404;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Dashboard_Title, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource TitleTextBlockStyle}" FontFamily="{StaticResource DisplayFontFamily}" FontWeight="650" FontSize="26"/>
            </StackPanel>

            <!-- ═══ Input Engine ═══ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="&#xE9F5;" Style="{StaticResource SectionGlyph}"/>
                <TextBlock Text="{Binding Dashboard_InputEngine, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}" Style="{StaticResource SectionTitle}"/>
            </StackPanel>

            <Border x:Name="EngineCard" Padding="20" Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                        <Style.Triggers>
                            <!-- The forge glows while it burns (#175). -->
                            <DataTrigger Binding="{Binding EngineStateKey}" Value="Running">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF6B2C" BlurRadius="20" ShadowDepth="0" Opacity="0.16"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Engine flame toggle (#175): the forge is lit or it is
                         not. Ember = running, gold = idle or stopping (flash),
                         outline = stopped. -->
                    <Button Padding="2" MinWidth="0" MinHeight="0"
                            VerticalAlignment="Center" Cursor="Hand"
                            Background="Transparent" BorderThickness="0"
                            Click="EngineToggle_Click" Margin="0,0,8,0">
                        <Path Data="{StaticResource FlameOuterGeometry}"
                              Width="16" Height="16" Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="Transparent"/>
                                    <Setter Property="Stroke" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <Setter Property="StrokeThickness" Value="1.3"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EngineStateKey}" Value="Running">
                                            <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                            <Setter Property="Stroke" Value="{x:Null}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EngineStateKey}" Value="Idle">
                                            <Setter Property="Fill" Value="{DynamicResource WaitBrush}"/>
                                            <Setter Property="Stroke" Value="{x:Null}"/>
                                        </DataTrigger>
                                        <!-- Stopping: gold, flashing (mirrors the
                                             slot-card igniting flash style). -->
                                        <DataTrigger Binding="{Binding EngineStateKey}" Value="Stopping">
                                            <Setter Property="Fill" Value="{DynamicResource WaitBrush}"/>
                                            <Setter Property="Stroke" Value="{x:Null}"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="FlashGoldStoryboard">
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="Opacity"
                                                            From="1.0" To="0.15"
                                                            Duration="0:0:0.5"
                                                            AutoReverse="True"
                                                            RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="FlashGoldStoryboard"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>

                    <TextBlock Grid.Column="1" Text="{Binding EngineStatus}"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <Style.Triggers>
                                    <!-- Forging reads hot (#175). -->
                                    <DataTrigger Binding="{Binding EngineStateKey}" Value="Running">
                                        <Setter Property="Foreground" Value="{DynamicResource EmberHotBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="24,0"
                               Foreground="{DynamicResource ColdBrush}"
                               FontFamily="{StaticResource TelemetryFontFamily}"
                               Text="{Binding PollingFrequencyText, Mode=OneWay}"/>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource ColdBrush}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12" Text="{Binding OnlineDevices, Mode=OneWay}"/>
                        <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12" Text="/"/>
                        <TextBlock Foreground="{DynamicResource ColdBrush}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12" Text="{Binding TotalDevices, Mode=OneWay}"/>
                        <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12" Text="{Binding Dashboard_DevicesOnline, Source={x:Static strings:Strings.Instance}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ Virtual controller slot cards ═══ -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                <TextBlock Text="&#xE7FC;" Style="{StaticResource SectionGlyph}"/>
                <TextBlock Text="{Binding Dashboard_VirtualControllers, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}" Style="{StaticResource SectionTitle}"/>
            </StackPanel>

            <ItemsControl x:Name="SlotsItemsControl" ItemsSource="{Binding SlotSummaries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4">
                            <!-- Heat that rises fast and cools slow (#175 motion
                                 spec, overlay pattern): the glow host behind the
                                 card carries the effect, its plain Opacity
                                 animates. 300ms ease-out up, 1200ms ease-in down.
                                 One-shot storyboards, no Forever loops. -->
                            <Border CornerRadius="8" IsHitTestVisible="False" Opacity="0"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF6B2C" BlurRadius="30" ShadowDepth="0" Opacity="0.55"/>
                                </Border.Effect>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <!-- Heat requires fuel (#175): the enable glow
                                                 only ignites once devices are mapped. -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                                    <Condition Binding="{Binding HasMappedDevices}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.3">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:1.2">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseIn"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding IsVirtualControllerConnected}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <!-- Artifact breathe: 3.2s ease-in-out shadow pulse. -->
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="0.55" To="1.0" Duration="0:0:1.6"
                                                                             AutoReverse="True" RepeatBehavior="Forever">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <SineEase EasingMode="EaseInOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:1.2">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseIn"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        <Border Background="{DynamicResource CrucibleCardBrush}"
                                CornerRadius="8" Padding="10"
                                BorderThickness="2"
                                Width="252"
                                Cursor="Hand"
                                Tag="{Binding PadIndex}"
                                Loaded="SlotCard_Loaded">
                            <!-- Heat states (#175 pitch): cold = steel line,
                                 awaiting devices = faint warm rim, forging =
                                 ember rim. The glow host behind matches with
                                 its 0 / 0.5 / 1.0 opacity ladder. -->
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource SteelLineBrush}"/>
                                    <Style.Triggers>
                                        <!-- Pure cold: nothing mapped, card recedes. -->
                                        <DataTrigger Binding="{Binding HasMappedDevices}" Value="False">
                                            <Setter Property="Opacity" Value="0.72"/>
                                        </DataTrigger>
                                        <!-- Warm rim only once devices are mapped (#175). -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                                <Condition Binding="{Binding HasMappedDevices}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="BorderBrush" Value="#2EFF6B2C"/>
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding IsVirtualControllerConnected}" Value="True">
                                            <Setter Property="BorderBrush" Value="#8CFF6B2C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: [Flame] Slot N ... [X] -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                    <!-- Power button -->
                                    <Button Click="PowerToggle_Click" Tag="{Binding PadIndex}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource TypeSwitchButton}">
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="ToolTip" Value="{Binding Common_Disabled, Source={x:Static strings:Strings.Instance}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                        <Setter Property="ToolTip" Value="{Binding Main_Active, Source={x:Static strings:Strings.Instance}}"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                                            <Condition Binding="{Binding IsVirtualControllerConnected}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="ToolTip" Value="{Binding Main_AwaitingDevices, Source={x:Static strings:Strings.Instance}}"/>
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                                            <Condition Binding="{Binding DataContext.EngineStateKey, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Stopped"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="ToolTip" Value="{Binding Main_EngineStopped, Source={x:Static strings:Strings.Instance}}"/>
                                                    </MultiDataTrigger>
                                                    <!-- Initializing: override tooltip -->
                                                    <DataTrigger Binding="{Binding IsInitializing}" Value="True">
                                                        <Setter Property="ToolTip" Value="{Binding Main_Initializing, Source={x:Static strings:Strings.Instance}}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Path Data="{StaticResource FlameOuterGeometry}"
                                              Width="12" Height="12" Stretch="Uniform">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <!-- Default: cold outline (disabled) (#175) -->
                                                    <Setter Property="Fill" Value="Transparent"/>
                                                    <Setter Property="Stroke" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <Setter Property="StrokeThickness" Value="1.2"/>
                                                    <Style.Triggers>
                                                        <!-- Enabled + devices mapped: ember (forging).
                                                             Enabled-but-empty stays the cold outline (#175):
                                                             heat requires fuel. -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                                                <Condition Binding="{Binding HasMappedDevices}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                                            <Setter Property="Stroke" Value="{x:Null}"/>
                                                        </MultiDataTrigger>
                                                        <!-- Enabled + mapped but no live VC: gold (awaiting
                                                             devices). During the HM-inactivity grace period
                                                             the VC stays alive even with devices offline, so
                                                             the flame stays ember until the timeout actually
                                                             fires and tears the VC down. -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                                                <Condition Binding="{Binding HasMappedDevices}" Value="True"/>
                                                                <Condition Binding="{Binding IsVirtualControllerConnected}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Fill" Value="{DynamicResource WaitBrush}"/>
                                                            <Setter Property="Stroke" Value="{x:Null}"/>
                                                        </MultiDataTrigger>
                                                        <!-- Enabled + mapped but engine stopped: gold -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                                                <Condition Binding="{Binding HasMappedDevices}" Value="True"/>
                                                                <Condition Binding="{Binding DataContext.EngineStateKey, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Stopped"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Fill" Value="{DynamicResource WaitBrush}"/>
                                                            <Setter Property="Stroke" Value="{x:Null}"/>
                                                        </MultiDataTrigger>
                                                        <!-- Igniting: flashing ember -->
                                                        <DataTrigger Binding="{Binding IsInitializing}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                                            <Setter Property="Stroke" Value="{x:Null}"/>
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="FlashEmberStoryboard">
                                                                    <Storyboard>
                                                                        <DoubleAnimation
                                                                            Storyboard.TargetProperty="Opacity"
                                                                            From="1.0" To="0.15"
                                                                            Duration="0:0:0.5"
                                                                            AutoReverse="True"
                                                                            RepeatBehavior="Forever"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <StopStoryboard BeginStoryboardName="FlashEmberStoryboard"/>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Button>

                                    <!-- Slot title -->
                                    <TextBlock Text="{Binding Dashboard_Slot, Source={x:Static strings:Strings.Instance}}"
                                               FontWeight="SemiBold" FontSize="14"
                                               VerticalAlignment="Center" Margin="7,0,0,0"/>
                                    <TextBlock Text="{Binding SlotNumber}" VerticalAlignment="Center"
                                               FontWeight="SemiBold" FontSize="14"
                                               Margin="4,0,0,0"/>
                                </StackPanel>

                                <!-- Row 1: type segment + per-type instance (#175 iteration 2:
                                     its own row, so the title row breathes and the segment
                                     reads as a control, not clutter). -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                    <!-- Recessed seg track (#175): sits below the card, not on it. -->
                                    <Border Background="{DynamicResource SegTrackBrush}"
                                            BorderBrush="{DynamicResource SegTrackStrokeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6" Padding="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">

                                        <!-- Xbox type button -->
                                        <Button Click="XboxType_Click" Tag="{Binding PadIndex}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TypeSwitchButton}">
                                                    <Setter Property="Padding" Value="7,3"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <Setter Property="ToolTip" Value="{Binding ControllerType_Xbox, Source={x:Static strings:Strings.Instance}}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OutputType}" Value="Xbox">
                                                            <Setter Property="Foreground" Value="#FFFFF3E8"/>
                                                            <Setter Property="Background" Value="{DynamicResource EmberSegGradient}"/>
                                                        </DataTrigger>
                                                        <!-- Cold card (0 mapped): active tile falls back to steel. -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding OutputType}" Value="Xbox"/>
                                                                <Condition Binding="{Binding HasMappedDevices}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <Setter Property="Background" Value="{DynamicResource SteelRaisedBrush}"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Path Data="M16 5.425c-1.888-1.125-4.106-1.922-6.473-2.249l-0.092-0.010c-0.070-0.005-0.152-0.008-0.234-0.008-0.613 0-1.188 0.16-1.687 0.441l0.017-0.009c2.357-1.634 5.277-2.61 8.426-2.61 0.008 0 0.016 0 0.024 0h0.019c0.005 0 0.011 0 0.018 0 3.157 0 6.086 0.976 8.501 2.642l-0.050-0.033c-0.478-0.272-1.051-0.433-1.662-0.433-0.085 0-0.169 0.003-0.252 0.009l0.011-0.001c-2.459 0.336-4.677 1.13-6.648 2.297l0.082-0.045zM5.554 5.268c-0.041 0.014-0.077 0.032-0.11 0.054l0.002-0.001c-2.758 2.723-4.466 6.504-4.466 10.684 0 3.584 1.256 6.875 3.353 9.457l-0.022-0.028c-1.754-3.261 4.48-12.455 7.61-16.159-3.53-3.521-5.277-4.062-6.015-4.062-0.010-0-0.021-0.001-0.032-0.001-0.115 0-0.225 0.021-0.326 0.060l0.006-0.002zM20.083 9.275c3.129 3.706 9.367 12.908 7.605 16.161 2.075-2.554 3.332-5.845 3.332-9.43 0-4.181-1.709-7.962-4.467-10.684l-0.002-0.002c-0.029-0.021-0.063-0.039-0.1-0.052l-0.003-0.001c-0.1-0.036-0.216-0.056-0.336-0.056-0.005 0-0.011 0-0.016 0h0.001c-0.741-0-2.485 0.543-6.014 4.063zM6.114 27.306c2.627 2.306 6.093 3.714 9.888 3.714s7.261-1.407 9.905-3.728l-0.017 0.015c2.349-2.393-5.402-10.901-9.89-14.29-4.483 3.39-12.24 11.897-9.886 14.29z" Width="13" Height="13" Stretch="Uniform" Margin="2,1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>

                                        <!-- PlayStation type button -->
                                        <Button Margin="1,0,0,0"
                                                Click="DS4Type_Click" Tag="{Binding PadIndex}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TypeSwitchButton}">
                                                    <Setter Property="Padding" Value="7,3"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <Setter Property="ToolTip" Value="{Binding ControllerType_PlayStation, Source={x:Static strings:Strings.Instance}}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OutputType}" Value="PlayStation">
                                                            <Setter Property="Foreground" Value="#FFFFF3E8"/>
                                                            <Setter Property="Background" Value="{DynamicResource EmberSegGradient}"/>
                                                        </DataTrigger>
                                                        <!-- Cold card (0 mapped): active tile falls back to steel. -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding OutputType}" Value="PlayStation"/>
                                                                <Condition Binding="{Binding HasMappedDevices}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <Setter Property="Background" Value="{DynamicResource SteelRaisedBrush}"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Path Data="M3.262 24.248c-2.374-0.681-2.767-2.084-1.69-2.899 0.776-0.51 1.668-0.954 2.612-1.288l0.087-0.027 7.017-2.516v2.89l-5.030 1.839c-0.881 0.339-1.031 0.79-0.299 1.032 0.365 0.093 0.783 0.147 1.214 0.147 0.615 0 1.204-0.109 1.749-0.308l-0.035 0.011 2.422-0.882v2.592c-0.15 0.037-0.32 0.055-0.487 0.091-0.775 0.136-1.667 0.214-2.577 0.214-1.778 0-3.486-0.298-5.078-0.846l0.110 0.033zM18.049 24.544l7.868-2.843c0.893-0.322 1.032-0.781 0.307-1.022-0.363-0.089-0.779-0.14-1.208-0.14-0.622 0-1.22 0.108-1.774 0.305l0.037-0.011-5.255 1.874v-2.983l0.3-0.106c1.050-0.349 2.284-0.62 3.557-0.761l0.083-0.008c0.468-0.050 1.010-0.078 1.559-0.078 1.877 0 3.677 0.331 5.343 0.939l-0.108-0.035c2.309 0.751 2.549 1.839 1.969 2.589-0.559 0.557-1.235 0.998-1.988 1.282l-0.039 0.013-10.677 3.883v-2.869zM12.231 4.248v21.927l4.892 1.576v-18.39c0-0.862 0.38-1.438 0.992-1.238 0.795 0.225 0.95 1.017 0.95 1.881v7.342c3.050 1.491 5.451-0.003 5.451-3.939 0-4.045-1.407-5.842-5.546-7.282-1.785-0.648-4.040-1.294-6.347-1.805l-0.389-0.072z" Width="13" Height="13" Stretch="Uniform" Margin="2,1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>

                                        <!-- Extended (custom DI) type button -->
                                        <Button Margin="1,0,0,0"
                                                Click="ExtendedType_Click" Tag="{Binding PadIndex}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TypeSwitchButton}">
                                                    <Setter Property="Padding" Value="7,3"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <Setter Property="ToolTip" Value="{Binding ControllerType_Extended, Source={x:Static strings:Strings.Instance}}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OutputType}" Value="Extended">
                                                            <Setter Property="Foreground" Value="#FFFFF3E8"/>
                                                            <Setter Property="Background" Value="{DynamicResource EmberSegGradient}"/>
                                                        </DataTrigger>
                                                        <!-- Cold card (0 mapped): active tile falls back to steel. -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding OutputType}" Value="Extended"/>
                                                                <Condition Binding="{Binding HasMappedDevices}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <Setter Property="Background" Value="{DynamicResource SteelRaisedBrush}"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Path Data="M11.915 15H13V9.874A4.002 4.002 0 0 1 14 2a4 4 0 0 1 1 7.874V15h2a3 3 0 0 1 3 3v4H4v-4a3 3 0 0 1 3-3h.085A1.5 1.5 0 0 1 8.5 14h2a1.5 1.5 0 0 1 1.415 1z" Width="13" Height="13" Stretch="Uniform" Margin="2,1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>

                                        <!-- Keyboard+Mouse type button -->
                                        <Button Margin="1,0,0,0"
                                                Click="KeyboardMouseType_Click" Tag="{Binding PadIndex}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TypeSwitchButton}">
                                                    <Setter Property="Padding" Value="7,3"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <Setter Property="ToolTip" Value="{Binding ControllerType_KeyboardMouse, Source={x:Static strings:Strings.Instance}}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OutputType}" Value="KeyboardMouse">
                                                            <Setter Property="Foreground" Value="#FFFFF3E8"/>
                                                            <Setter Property="Background" Value="{DynamicResource EmberSegGradient}"/>
                                                        </DataTrigger>
                                                        <!-- Cold card (0 mapped): active tile falls back to steel. -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding OutputType}" Value="KeyboardMouse"/>
                                                                <Condition Binding="{Binding HasMappedDevices}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <Setter Property="Background" Value="{DynamicResource SteelRaisedBrush}"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="&#xE961;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="2,0"/>
                                        </Button>

                                        <!-- MIDI type button -->
                                        <Button Margin="1,0,0,0"
                                                Click="MidiType_Click" Tag="{Binding PadIndex}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TypeSwitchButton}">
                                                    <Setter Property="Padding" Value="7,3"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <Setter Property="ToolTip" Value="{Binding ControllerType_MIDI, Source={x:Static strings:Strings.Instance}}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OutputType}" Value="Midi">
                                                            <Setter Property="Foreground" Value="#FFFFF3E8"/>
                                                            <Setter Property="Background" Value="{DynamicResource EmberSegGradient}"/>
                                                        </DataTrigger>
                                                        <!-- Cold card (0 mapped): active tile falls back to steel. -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding OutputType}" Value="Midi"/>
                                                                <Condition Binding="{Binding HasMappedDevices}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <Setter Property="Background" Value="{DynamicResource SteelRaisedBrush}"/>
                                                        </MultiDataTrigger>
                                                        <DataTrigger Binding="{Binding DataContext.IsMidiServicesInstalled, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="False">
                                                            <Setter Property="Cursor" Value="No"/>
                                                            <Setter Property="ToolTip" Value="{Binding Main_MIDI_RequiresMidiServices, Source={x:Static strings:Strings.Instance}}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="2,0"/>
                                        </Button>
                                        <TextBlock Text="{Binding TypeInstanceLabel, StringFormat={}#{0}}"
                                                   FontFamily="{StaticResource TelemetryFontFamily}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   VerticalAlignment="Center" Margin="5,0,4,0"/>
                                    </StackPanel>
                                    </Border>

                                </StackPanel>

                                <!-- Delete button (upper-right corner) -->
                                <ui:Button Style="{StaticResource EmberIconButtonHot}"
                                           ToolTip="{Binding Main_DeleteVC, Source={x:Static strings:Strings.Instance}}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Click="DeleteSlot_Click" Tag="{Binding PadIndex}">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </ui:Button>

                                <!-- Row 2: Device name (compact). Cold: the
                                     physical device feeding this slot (#175). -->
                                <Border Grid.Row="2" ClipToBounds="True" Margin="0,8,0,0">
                                    <!-- Edge fade (#175 round 3): the marquee slides
                                         under ~12px transparency ramps instead of a
                                         hard guillotine at the card edge. -->
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00000000" Offset="0"/>
                                            <GradientStop Color="#FF000000" Offset="0.05"/>
                                            <GradientStop Color="#FF000000" Offset="0.95"/>
                                            <GradientStop Color="#00000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Empty state only: roster below owns the mapped case. -->
                                        <TextBlock Text="{Binding DeviceName}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ColdBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MappedDevices.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MappedDevices}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- Device roster (#175): name + dynamic battery glyph
                                             per mapped device, pipe separators, marquee when
                                             the roster outgrows the card. -->
                                        <ItemsControl ItemsSource="{Binding MappedDevices}"
                                                      AlternationCount="99"
                                                      common:MarqueeBehavior.IsEnabled="True">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="  |  " FontSize="12"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Name}" FontSize="12"
                                                                   Foreground="{DynamicResource ColdBrush}"/>
                                                        <TextBlock Text="{Binding BatteryGlyph}"
                                                                   FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                   Foreground="{DynamicResource ColdBrush}"
                                                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                                                   Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <TextBlock Text="{Binding BatteryText}"
                                                                   FontFamily="{StaticResource TelemetryFontFamily}" FontSize="10.5"
                                                                   Foreground="{DynamicResource ColdBrush}" Opacity="0.85"
                                                                   VerticalAlignment="Center" Margin="3,0,0,0"
                                                                   Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Row 3: Status -->
                                <StackPanel Grid.Row="3" Orientation="Horizontal"
                                            Margin="0,2,0,0">
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource WaitBrush}"/>
                                                    </DataTrigger>
                                                    <!-- Gold requires mappings (#175): enabled but
                                                         empty reads Cold in tertiary steel. -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                                            <Condition Binding="{Binding MappedDeviceCount}" Value="0"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    </MultiDataTrigger>
                                                    <DataTrigger Binding="{Binding IsVirtualControllerConnected}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource EmberHotBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding MappedDeviceCount, Mode=OneWay}"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Dashboard_Mapped, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ConnectedDeviceCount, Mode=OneWay}"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Dashboard_Connected, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Add Controller card -->
            <Border x:Name="AddControllerCard"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16" Margin="4,4,4,4"
                    Cursor="Hand" MouseLeftButtonUp="AddControllerCard_Click"
                    Visibility="{Binding ShowAddController, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="{Binding Main_AddController, Source={x:Static strings:Strings.Instance}}" FontSize="14"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- ═══ Services group (#175): everything below serves other
                 software. Status stays above the fold. ═══ -->
            <!-- Group header (#175 round 3): outranks the section titles
                 below it by one step (ember tick + larger mono). -->
            <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                <Rectangle Width="3" Height="12" RadiusX="1.5" RadiusY="1.5"
                           Fill="{DynamicResource EmberHotBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="ServicesHeader"
                           Text="{Binding Dashboard_Services, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}"
                           Style="{StaticResource SectionTitle}"
                           FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,6,0,0"/>

            <!-- ═══ Motion Server ═══ -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,12">
                <TextBlock Text="&#xE7AD;" Style="{StaticResource SectionGlyph}"/>
                <TextBlock Text="{Binding Dashboard_MotionServer, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}" Style="{StaticResource SectionTitle}"/>
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Dashboard_DsuDescription, Source={x:Static strings:Strings.Instance}}"
                               Style="{StaticResource CardDescription}" Margin="0,0,0,12"/>
                    <CheckBox Content="{Binding Dashboard_EnableDsu, Source={x:Static strings:Strings.Instance}}"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              IsChecked="{Binding EnableDsuMotionServer}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{Binding Dashboard_Port, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,8,0"/>
                        <ui:NumberBox Value="{Binding DsuMotionServerPort, Mode=TwoWay}"
                                      Minimum="1024" Maximum="65535"
                                      SpinButtonPlacementMode="Inline" Width="200"/>
                        <ui:Button Style="{StaticResource EmberIconButton}"
                                   Command="{Binding ResetDsuPortCommand}" VerticalAlignment="Center"
                                   ToolTip="{Binding Common_Reset, Source={x:Static strings:Strings.Instance}}">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </ui:Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Ellipse Width="8" Height="8"
                                 Fill="{Binding EnableDsuMotionServer, Converter={StaticResource BoolToColorConverter}, ConverterParameter=gray}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding DsuServerStatus}" FontSize="12"
                                   FontFamily="{StaticResource TelemetryFontFamily}"
                                   Foreground="{DynamicResource ColdBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Dashboard_DsuFooter, Source={x:Static strings:Strings.Instance}}"
                               FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- ═══ Web Controller ═══ -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,12">
                <TextBlock Text="&#xE774;" Style="{StaticResource SectionGlyph}"/>
                <TextBlock Text="{Binding Dashboard_WebController, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}" Style="{StaticResource SectionTitle}"/>
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Dashboard_WebDescription, Source={x:Static strings:Strings.Instance}}"
                               Style="{StaticResource CardDescription}" Margin="0,0,0,12"/>
                    <CheckBox AutomationProperties.AutomationId="EnableWebControllerCheckBox"
                              Content="{Binding Dashboard_EnableWeb, Source={x:Static strings:Strings.Instance}}"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              IsChecked="{Binding EnableWebController}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{Binding Dashboard_Port, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,8,0"/>
                        <ui:NumberBox Value="{Binding WebControllerPort, Mode=TwoWay}"
                                      Minimum="1024" Maximum="65535"
                                      SpinButtonPlacementMode="Inline" Width="200"/>
                        <ui:Button Style="{StaticResource EmberIconButton}"
                                   Command="{Binding ResetWebPortCommand}" VerticalAlignment="Center"
                                   ToolTip="{Binding Common_Reset, Source={x:Static strings:Strings.Instance}}">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </ui:Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Ellipse Width="8" Height="8"
                                 Fill="{Binding EnableWebController, Converter={StaticResource BoolToColorConverter}, ConverterParameter=gray}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding WebControllerStatus}" FontSize="12"
                                   FontFamily="{StaticResource TelemetryFontFamily}"
                                   Foreground="{DynamicResource ColdBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Dashboard_WebFooter, Source={x:Static strings:Strings.Instance}}"
                               FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Remote Link (issue #138) -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,12">
                <TextBlock Text="&#xE969;" Style="{StaticResource SectionGlyph}"/>
                <TextBlock Text="{Binding Dashboard_RemoteLink, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}" Style="{StaticResource SectionTitle}"/>
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Dashboard_RemoteLinkDescription, Source={x:Static strings:Strings.Instance}}"
                               Style="{StaticResource CardDescription}" Margin="0,0,0,12"/>

                    <!-- On / off + port + live status -->
                    <CheckBox AutomationProperties.AutomationId="EnableRemoteLinkCheckBox"
                              Content="{Binding Dashboard_EnableRemoteLink, Source={x:Static strings:Strings.Instance}}"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              IsChecked="{Binding EnableRemoteLink}" Margin="0,0,0,8"/>
                    <CheckBox Content="{Binding RemoteLink_AutoReconnect, Source={x:Static strings:Strings.Instance}}"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              IsChecked="{Binding AutoReconnect}" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{Binding Dashboard_Port, Source={x:Static strings:Strings.Instance}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ui:NumberBox Value="{Binding RemoteLinkPort, Mode=TwoWay}"
                                      Minimum="1024" Maximum="65535"
                                      SpinButtonPlacementMode="Inline" Width="200"/>
                        <ui:Button Style="{StaticResource EmberIconButton}"
                                   Command="{Binding ResetRemoteLinkPortCommand}" VerticalAlignment="Center"
                                   ToolTip="{Binding Common_Reset, Source={x:Static strings:Strings.Instance}}">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </ui:Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <Ellipse Width="8" Height="8"
                                 Fill="{Binding EnableRemoteLink, Converter={StaticResource BoolToColorConverter}, ConverterParameter=gray}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding RemoteLinkStatus}" FontSize="12"
                                   FontFamily="{StaticResource TelemetryFontFamily}"
                                   Foreground="{DynamicResource ColdBrush}"/>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,14,0,14"/>

                    <!-- Identity protection -->
                    <TextBlock Text="{Binding RemoteLink_IdentityTitle, Source={x:Static strings:Strings.Instance}}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding RemoteLink_IdentityDescription, Source={x:Static strings:Strings.Instance}}"
                               Style="{StaticResource CardDescription}"/>
                    <ComboBox Margin="0,10,0,8" Width="320" HorizontalAlignment="Left"
                              ItemsSource="{Binding RemoteLink.IdentityProtectionModes}"
                              SelectedIndex="{Binding RemoteLink.IdentityProtectionModeIndex, Mode=TwoWay}"/>
                    <TextBlock Text="{Binding RemoteLink.IdentityProtectionHint}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>

                    <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,14,0,14"/>

                    <!-- Paired PCs: online dot · editable name · revoke -->
                    <TextBlock Text="{Binding RemoteLink_PairedPeers, Source={x:Static strings:Strings.Instance}}"
                               FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding RemoteLink_PairedPeersDescription, Source={x:Static strings:Strings.Instance}}"
                               Style="{StaticResource CardDescription}"/>
                    <ItemsControl ItemsSource="{Binding RemoteLink.TrustedPeers}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                                             Margin="2,0,10,0" ToolTip="{Binding OnlineText}">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#806B6B6B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Fill" Value="#FF4CAF50"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <ui:TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                    PlaceholderText="{Binding RemoteLink_PeerNamePlaceholder, Source={x:Static strings:Strings.Instance}}" MaxLength="40"
                                                    HorizontalAlignment="Left" MinWidth="240"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="2,3,0,0" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding HostName, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text="{Binding FingerprintDisplay, Mode=OneWay, StringFormat='  ·  {0}'}" FontFamily="Consolas"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Content="{Binding Dashboard_RemoteLinkConnectButton, Source={x:Static strings:Strings.Instance}}"
                                                   Command="{Binding ConnectCommand}" Appearance="Primary" Margin="0,0,8,0"
                                                   Visibility="{Binding CanConnect, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <Button Content="{Binding RemoteLink_Revoke, Source={x:Static strings:Strings.Instance}}"
                                                Command="{Binding RevokeCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{Binding RemoteLink_RevokeAll, Source={x:Static strings:Strings.Instance}}"
                            Command="{Binding RemoteLink.RevokeAllPeersCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"/>

                    <!-- Nearby PCs not yet paired -->
                    <StackPanel Margin="0,14,0,0"
                                Visibility="{Binding RemoteLink.HasNearbyUnpaired, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding RemoteLink_NearbyTitle, Source={x:Static strings:Strings.Instance}}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding RemoteLink.NearbyUnpaired}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding HostPort}" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" VerticalAlignment="Center"
                                                   Content="{Binding ButtonLabel}" IsEnabled="{Binding CanPair}"
                                                   Command="{Binding PairCommand}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,14,0,14"/>

                    <!-- Connect by address (fallback when discovery can't see the PC) -->
                    <TextBlock Text="{Binding Dashboard_RemoteLinkConnect, Source={x:Static strings:Strings.Instance}}"
                               FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBox Text="{Binding RemoteLinkConnectHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="192.168.1.20:27500" Width="220" VerticalAlignment="Center"/>
                        <ui:Button Command="{Binding ConnectToPeerCommand}" Margin="8,0,0,0"
                                   Content="{Binding Dashboard_RemoteLinkConnectButton, Source={x:Static strings:Strings.Instance}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Dashboard_RemoteLinkFooter, Source={x:Static strings:Strings.Instance}}"
                               FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ═══ Touchpad Overlay ═══ -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,12">
                <TextBlock Text="&#xEDA4;" Style="{StaticResource SectionGlyph}"/>
                <TextBlock Text="{Binding Dashboard_TouchpadOverlay, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}" Style="{StaticResource SectionTitle}"/>
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Dashboard_TouchpadOverlayDescription, Source={x:Static strings:Strings.Instance}}"
                               Style="{StaticResource CardDescription}" Margin="0,0,0,12"/>
                    <CheckBox Content="{Binding Dashboard_EnableTouchpadOverlay, Source={x:Static strings:Strings.Instance}}"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              IsChecked="{Binding EnableTouchpadOverlay}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{Binding Dashboard_TouchpadOverlayOpacity, Source={x:Static strings:Strings.Instance}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" Width="80"/>
                        <Slider Value="{Binding TouchpadOverlayOpacity, Mode=TwoWay}"
                                Minimum="0.0" Maximum="1.0"
                                SmallChange="0.05" LargeChange="0.1"
                                Width="160" VerticalAlignment="Center"/>
                        <ui:NumberBox Value="{Binding TouchpadOverlayOpacityPercent, Mode=TwoWay}"
                                      Minimum="0" Maximum="100"
                                      SpinButtonPlacementMode="Inline" Width="130"
                                      Margin="8,0,0,0"/>
                        <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <ui:Button Style="{StaticResource EmberIconButton}"
                                   Command="{Binding ResetOpacityCommand}" VerticalAlignment="Center"
                                   ToolTip="{Binding Common_Reset, Source={x:Static strings:Strings.Instance}}">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </ui:Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Command="{Binding ResetTouchpadOverlayPositionCommand}"
                                Content="{Binding Dashboard_TouchpadOverlayResetPosition, Source={x:Static strings:Strings.Instance}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Ellipse Width="8" Height="8"
                                 Fill="{Binding EnableTouchpadOverlay, Converter={StaticResource BoolToColorConverter}, ConverterParameter=gray}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding TouchpadOverlayStatus}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══ Driver status ═══ -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,12">
                <TextBlock Text="&#xED5D;" Style="{StaticResource SectionGlyph}"/>
                <TextBlock Text="{Binding Dashboard_Drivers, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}" Style="{StaticResource SectionTitle}"/>
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xED1A;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="HidHide" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding HidHideStatusText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="MIDI Services" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding MidiServicesStatusText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,8,0,0"/>

                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
