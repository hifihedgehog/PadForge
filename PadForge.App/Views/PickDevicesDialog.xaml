<views:DialogWindow common:Reach.Class="UsersOwn" AutomationProperties.IsDialog="True" x:Class="PadForge.Views.PickDevicesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        xmlns:common="clr-namespace:PadForge.Common"
        xmlns:controls="clr-namespace:PadForge.Controls"
        xmlns:views="clr-namespace:PadForge.Views"
        Title="{Binding Reach_Pick_Title, Source={x:Static strings:Strings.Instance}}"
        Width="520">

    <!-- Pick Devices… (#600 DESIGN-2 N3): the devices a program held to its
         own devices may also drive and change. A device it added is always
         its own and is not listed. The user's alone: no program widens its
         own reach. -->
    <views:DialogWindow.Foot>
        <controls:FlexLinePanel Style="{StaticResource DialogFootPanel}">
            <Button Style="{StaticResource DialogButton}" IsCancel="True"
                    Content="{Binding Common_Cancel, Source={x:Static strings:Strings.Instance}}"/>
            <Button Style="{StaticResource DialogPrimaryButton}" IsDefault="True" Click="Ok_Click"
                    AutomationProperties.AutomationId="Reach_PickOk"
                    Content="{Binding Common_OK, Source={x:Static strings:Strings.Instance}}"/>
        </controls:FlexLinePanel>
    </views:DialogWindow.Foot>

    <StackPanel common:InitialFocus.First="True">
        <TextBlock x:Name="NoneText" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{Binding Reach_Pick_None, Source={x:Static strings:Strings.Instance}}"/>
        <ItemsControl x:Name="DeviceList" IsTabStop="False" AutomationProperties.AutomationId="Reach_PickList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Picked, Mode=TwoWay}" Margin="0,4,0,4"
                              AutomationProperties.Name="{Binding Name, TargetNullValue='', FallbackValue=''}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</views:DialogWindow>
