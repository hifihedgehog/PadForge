<Window x:Class="PadForge.Views.ShiftLayerFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Background="Transparent">

    <!--
        Win11 volume OSD replica — matches ProfileSwitchOverlay's pixel-
        measured chrome (bg #2D2E2E, border #141516, corner radius 8,
        layered shadow border + content border so ClearType survives).
        Stays visible while a shift layer is engaged on the user's
        currently-viewed slot; slides out when the slot returns to Base.
    -->
    <Grid ClipToBounds="True">
        <Grid x:Name="FlyoutPanel" Margin="10,10,10,14">
            <!-- Shadow layer: empty border with DropShadowEffect, behind content.
                 Keeping the effect OFF the content border preserves ClearType text. -->
            <Border x:Name="ShadowBorder"
                    CornerRadius="8"
                    Background="#2D2E2E">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="3"
                                      Direction="270" Opacity="0.30" Color="Black"/>
                </Border.Effect>
            </Border>

            <!-- Content layer: no Effect, so ClearType works and no gray bleed -->
            <Border x:Name="ContentBorder"
                    CornerRadius="8"
                    Background="#2D2E2E"
                    BorderBrush="#141516"
                    BorderThickness="1">
                <Grid Margin="16,13,16,13">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusIcon"
                                   Text="&#x21E7;"
                                   FontFamily="Segoe UI Symbol, Segoe UI"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   Foreground="White"/>

                        <TextBlock x:Name="LayerNameText"
                                   FontSize="14"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   Foreground="White"/>

                        <Ellipse x:Name="ColorDot"
                                 Width="10" Height="10"
                                 VerticalAlignment="Center"
                                 Fill="#888"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
