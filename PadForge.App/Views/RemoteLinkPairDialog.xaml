<views:DialogWindow AutomationProperties.IsDialog="True" x:Class="PadForge.Views.RemoteLinkPairDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        xmlns:controls="clr-namespace:PadForge.Controls"
        xmlns:reset="clr-namespace:PadForge.Controls"
        xmlns:views="clr-namespace:PadForge.Views"
        Title="{Binding RemoteLink_PairTitle, Source={x:Static strings:Strings.Instance}}"
        Subtitle="{Binding RemoteLink_PairPrompt, Source={x:Static strings:Strings.Instance}}">

    <!-- First-contact pairing with another PC (#138, #574), as the Links
         board draws it: the code to compare with the other screen, the
         other PC's identity, what a paired PC can do, and the two limits
         on it. Reject holds the default and the focus, so Enter and Esc
         both decline: Pair hands another PC this one's inputs, and takes a
         deliberate click. -->
    <views:DialogWindow.Foot>
        <controls:FlexLinePanel Style="{StaticResource DialogFootPanel}">
            <Button x:Name="RejectButton" Style="{StaticResource DialogButton}" IsCancel="True" IsDefault="True"
                    Content="{Binding RemoteLink_Reject, Source={x:Static strings:Strings.Instance}}"
                    Click="Reject_Click"/>
            <Button x:Name="PairButton" Style="{StaticResource DialogPrimaryButton}"
                    Content="{Binding RemoteLink_Pair, Source={x:Static strings:Strings.Instance}}"
                    Click="Pair_Click"/>
        </controls:FlexLinePanel>
    </views:DialogWindow.Foot>

    <StackPanel>
        <!-- The code, compared by eye with the other PC's screen. -->
        <Border Style="{StaticResource DialogCodeBox}">
            <TextBlock x:Name="SasText" HorizontalAlignment="Center"/>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource DialogNote}" Margin="0,0,6,0" VerticalAlignment="Center"
                       Text="{Binding RemoteLink_Identity, Source={x:Static strings:Strings.Instance}}"/>
            <TextBlock x:Name="IdentityText" Style="{StaticResource DialogMonoNote}"/>
        </StackPanel>

        <Border Style="{StaticResource DialogWaitBox}" Margin="0,12,0,0">
            <TextBlock TextWrapping="Wrap"
                       Text="{Binding RemoteLink_ConsentWarning, Source={x:Static strings:Strings.Instance}}"/>
        </Border>

        <!-- A check box of these rows stands at the row's edge: the app's
             check box keeps 11 before its mark, which is taken back. -->
        <controls:SettingRow MinHeight="36" Margin="0,10,0,0">
            <CheckBox x:Name="GamepadOnlyCheck" VerticalAlignment="Center" Margin="-11,0,0,0"
                      Content="{Binding RemoteLink_GamepadOnly, Source={x:Static strings:Strings.Instance}}"/>
            <reset:SettingResetButton Click="ResetSetting_Click" Tag="GamepadOnly" Visibility="{Binding Visibility, ElementName=GamepadOnlyCheck}" IsEnabled="{Binding IsEnabled, ElementName=GamepadOnlyCheck}" SettingLabel="{Binding RemoteLink_GamepadOnly, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_?dialog_GamepadOnlyCheck_93"/>
        </controls:SettingRow>
        <!-- Whether the other PC may choose which of this PC's controllers
             its shared devices drive. The line under the box says what
             that lets it do. -->
        <controls:SettingRow MinHeight="36">
            <CheckBox x:Name="AssignmentsCheck" VerticalAlignment="Center" Margin="-11,0,0,0"
                      Content="{Binding RemoteLink_AllowAssignments, Source={x:Static strings:Strings.Instance}}"/>
            <reset:SettingResetButton Click="ResetSetting_Click" Tag="AllowAssignments" Visibility="{Binding Visibility, ElementName=AssignmentsCheck}" IsEnabled="{Binding IsEnabled, ElementName=AssignmentsCheck}" SettingLabel="{Binding RemoteLink_AllowAssignments, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_?dialog_AssignmentsCheck_95"/>
        </controls:SettingRow>
        <TextBlock Style="{StaticResource DialogNote}" Margin="0,0,32,0"
                   Text="{Binding RemoteLink_AssignmentPermissionDescription, Source={x:Static strings:Strings.Instance}}"/>
    </StackPanel>
</views:DialogWindow>
