<UserControl x:Class="PadForge.Views.RemoteLinkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:strings="clr-namespace:PadForge.Resources.Strings">

    <UserControl.Resources>
        <Style x:Key="RlDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="Margin" Value="0,16,0,16"/>
        </Style>
        <Style x:Key="RlSection" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Padding="24,0">
        <StackPanel Margin="0,16,0,16">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Remote Link" Style="{StaticResource TitleTextBlockStyle}"/>
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{Binding Dashboard_RemoteLinkDescription, Source={x:Static strings:Strings.Instance}}"
                               Style="{StaticResource CardDescription}" Margin="0,0,0,12"/>

                    <!-- ── On / off + port + live status ── -->
                    <CheckBox AutomationProperties.AutomationId="EnableRemoteLinkCheckBox"
                              Content="{Binding Dashboard_EnableRemoteLink, Source={x:Static strings:Strings.Instance}}"
                              IsChecked="{Binding Dashboard.EnableRemoteLink}" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{Binding Dashboard_Port, Source={x:Static strings:Strings.Instance}}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ui:NumberBox Value="{Binding Dashboard.RemoteLinkPort, Mode=TwoWay}"
                                      Minimum="1024" Maximum="65535"
                                      SpinButtonPlacementMode="Inline" Width="200"/>
                        <Button Command="{Binding Dashboard.ResetRemoteLinkPortCommand}"
                                Padding="4,2" VerticalAlignment="Center" Margin="4,0,0,0" ToolTip="Reset">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <Ellipse Width="8" Height="8"
                                 Fill="{Binding Dashboard.EnableRemoteLink, Converter={StaticResource BoolToColorConverter}}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Dashboard.RemoteLinkStatus}" FontSize="12"/>
                    </StackPanel>

                    <Border Style="{StaticResource RlDivider}"/>

                    <!-- ── Identity protection ── -->
                    <TextBlock Text="Identity protection" Style="{StaticResource RlSection}"/>
                    <TextBlock Text="How this PC's pairing identity is stored. Choose a portable mode to carry your pairings on a thumb drive between machines."
                               Style="{StaticResource CardDescription}"/>
                    <ComboBox Margin="0,10,0,8" Width="320" HorizontalAlignment="Left"
                              ItemsSource="{Binding Settings.IdentityProtectionModes}"
                              SelectedIndex="{Binding Settings.IdentityProtectionModeIndex, Mode=TwoWay}"/>
                    <TextBlock Text="{Binding Settings.IdentityProtectionHint}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>

                    <Border Style="{StaticResource RlDivider}"/>

                    <!-- ── Paired PCs (online dot · editable name · revoke) ── -->
                    <TextBlock Text="{Binding RemoteLink_PairedPeers, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource RlSection}"/>
                    <TextBlock Text="{Binding RemoteLink_PairedPeersDescription, Source={x:Static strings:Strings.Instance}}"
                               Style="{StaticResource CardDescription}"/>
                    <ItemsControl ItemsSource="{Binding Settings.TrustedPeers}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                                             Margin="2,0,10,0" ToolTip="{Binding OnlineText}">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#806B6B6B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Fill" Value="#FF4CAF50"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <ui:TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                    PlaceholderText="Name this PC" MaxLength="40"
                                                    HorizontalAlignment="Left" MinWidth="240"/>
                                        <TextBlock Text="{Binding FingerprintDisplay}" FontSize="11"
                                                   FontFamily="Consolas" Opacity="0.6" Margin="2,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" VerticalAlignment="Center"
                                            Content="{Binding RemoteLink_Revoke, Source={x:Static strings:Strings.Instance}}"
                                            Command="{Binding RevokeCommand}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{Binding RemoteLink_RevokeAll, Source={x:Static strings:Strings.Instance}}"
                            Command="{Binding Settings.RevokeAllPeersCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"/>

                    <!-- ── Nearby (not paired) ── -->
                    <StackPanel Visibility="{Binding Settings.HasNearbyUnpaired, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Style="{StaticResource RlDivider}"/>
                        <TextBlock Text="Nearby PCs (not paired)" Style="{StaticResource RlSection}"/>
                        <ItemsControl ItemsSource="{Binding Settings.NearbyUnpaired}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding HostPort}" FontSize="11" FontFamily="Consolas" Opacity="0.6"/>
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" VerticalAlignment="Center"
                                                   Content="{Binding ButtonLabel}" IsEnabled="{Binding CanPair}"
                                                   Command="{Binding PairCommand}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border Style="{StaticResource RlDivider}"/>

                    <!-- ── Connect by address (fallback when discovery can't see the PC) ── -->
                    <TextBlock Text="{Binding Dashboard_RemoteLinkConnect, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource RlSection}"/>
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBox Text="{Binding Dashboard.RemoteLinkConnectHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="192.168.1.20:27500" Width="220" VerticalAlignment="Center"/>
                        <ui:Button Command="{Binding Dashboard.ConnectToPeerCommand}" Margin="8,0,0,0"
                                   Content="{Binding Dashboard_RemoteLinkConnectButton, Source={x:Static strings:Strings.Instance}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Dashboard_RemoteLinkFooter, Source={x:Static strings:Strings.Instance}}"
                               FontSize="12" Opacity="0.5" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
