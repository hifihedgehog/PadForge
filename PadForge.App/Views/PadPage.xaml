<UserControl x:Class="PadForge.Views.PadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PadForge.ViewModels"
             xmlns:controls="clr-namespace:PadForge.Controls"
             xmlns:views="clr-namespace:PadForge.Views"
             xmlns:viewControls="clr-namespace:PadForge.Views.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:strings="clr-namespace:PadForge.Resources.Strings"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             mc:Ignorable="d po"
             d:DataContext="{d:DesignInstance vm:PadViewModel}"
             d:DesignHeight="700" d:DesignWidth="900"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:common="clr-namespace:PadForge.Common"
             xmlns:input="clr-namespace:PadForge.Common.Input"
             xmlns:reset="clr-namespace:PadForge.Controls">

    <UserControl.Resources>
        <!-- EQ band types for the parametric EQ grid (#347). An enum the
             combo column binds by value, so a band keeps its type across a
             locale change rather than an index into a translated list. -->
        <ObjectDataProvider x:Key="EqBandTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="input:EqBandType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Touchpad stick rows (#175 item 15): settings persist as 0..1
             fractions, the DZ-row idiom displays percent. Two-way converter
             at the edit boundary, class lives in PadPage.xaml.cs. -->
        <views:FractionToPercentConverter x:Key="FractionToPercentConverter"/>

        <!-- A setting's row (#574), a SettingRow: its label in a column 230
             wide, its control, its value and unit, and its reset at the
             row's far right (the reset styles dock right, which the row
             reads). A slider is 280 wide with an ember fill up to its
             thumb, and narrows when the row has less room: it asks for the
             280 as a MaxWidth, which is what a SettingRow lets give way. -->
        <Style x:Key="DzLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="230"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <!-- A setting that belongs to the row above it: its label starts
             16 in and reads a step quieter, and its control still starts
             where every row's does. -->
        <Style x:Key="DzSubLabel" TargetType="TextBlock" BasedOn="{StaticResource DzLabel}">
            <Setter Property="Width" Value="214"/>
            <Setter Property="Margin" Value="16,0,12,0"/>
            <Setter Property="Foreground" Value="{DynamicResource SubRowTextBrush}"/>
        </Style>
        <Style x:Key="DzSlider" TargetType="Slider" BasedOn="{StaticResource EmberSlider}">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="MaxWidth" Value="280"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="0.1"/>
        </Style>
        <Style x:Key="OffsetSlider" TargetType="Slider" BasedOn="{StaticResource DzSlider}">
            <Setter Property="Minimum" Value="-100"/>
        </Style>
        <!-- A setting's value, typed in place. At rest it reads as plain
             text in the mono face, the number and then its unit, as the
             boards draw it. Under the pointer it takes the raised fill,
             and with the keyboard's focus the field's fill and a cold
             edge, so it shows where a value is typed. It is as wide as its
             number, and never narrower than two digits: a single digit
             stands at the right of that, against its unit. The template
             adds no inset of its own: a TextBox lays its Padding around its
             text itself, and a template that bound the same Padding again
             cut a third digit off a boxed value. -->
        <Style x:Key="DzValueEdit" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinWidth" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="3,2,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SteelRaisedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SteelFieldBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ColdBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DzDigitEdit" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="Width" Value="56"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="ToolTip" Value="{Binding Pad_RawAxisValue, Source={x:Static strings:Strings.Instance}}"/>
        </Style>
        <!-- A unit reads as part of its row's phrase, so it takes the
             label's color (owner, 2026-10-30). UnitTextTests pins it. It
             follows its number at the value box's own inset, which is the
             width of a space. -->
        <Style x:Key="DzPercent" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <!-- A motor's live bar (#574): a track 6 tall, a field's fill
             inside a hairline, with an ember fill for what reaches the
             device. Where a row also shows what the game commands, that is
             a bar with a cold fill and the ember one lies over it with no
             track of its own (ActivityBarOver), so the cold that shows
             past the ember is what the settings take off. -->
        <Style x:Key="ActivityBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource EmberBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{DynamicResource SteelFieldBrush}"
                                    BorderBrush="{DynamicResource SteelLineSoftBrush}" BorderThickness="1" CornerRadius="3"/>
                            <Rectangle x:Name="PART_Track" Margin="1"/>
                            <Border x:Name="PART_Indicator" Margin="1" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A mapping row's live value (#574): a track 4 tall, filled in
             ember to the value's share of the output's full scale. -->
        <Style x:Key="ValueMeter" TargetType="ProgressBar" BasedOn="{StaticResource ActivityBar}">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{DynamicResource SteelFieldBrush}"
                                    BorderBrush="{DynamicResource SteelLineSoftBrush}" BorderThickness="1" CornerRadius="2"/>
                            <Rectangle x:Name="PART_Track" Margin="1"/>
                            <Border x:Name="PART_Indicator" Margin="1" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="1"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A mapping row's own buttons (#574): Record, Clear and the
             chevron, 12 apart at the row's end. They are icon buttons of
             the quiet reset's size with the glyph in the text color, as
             the boards draw them. None is a Tab stop: the row is one. -->
        <Style x:Key="RowIconButton" TargetType="ui:Button" BasedOn="{StaticResource QuietResetButton}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="IsTabStop" Value="False"/>
        </Style>
        <Style x:Key="ActivityBarOver" TargetType="ProgressBar" BasedOn="{StaticResource ActivityBar}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Rectangle x:Name="PART_Track" Margin="1"/>
                            <Border x:Name="PART_Indicator" Margin="1" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--
            FontFamily / FontSize live on the child TextBlock so the symbol-
            font glyph renders inside the button without leaking through the
            visual tree to the tooltip. The tooltip then keeps its WPF UI
            themed font (Fluent / Segoe UI Variable). Mirrors the working
            pattern used by the mapping grid's record / clear buttons:
            symbol font scoped to a child TextBlock, not the Button itself.
        -->
        <Style x:Key="ResetButton" TargetType="ui:Button" BasedOn="{StaticResource QuietResetButton}">
            <Setter Property="Content" Value="&#xE72C;"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="{Binding Common_Reset, Source={x:Static strings:Strings.Instance}}"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <controls:GlyphText Text="{Binding}" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <!-- The quiet rest state and the fill under the pointer
                 (#574) are QuietResetButton's. -->
        </Style>
        <!-- Reset All is a reset button in words: the reset buttons' quiet
             rest state and fill under the pointer (QuietResetButton), at
             its natural width so the localized label fits. In a card's
             title row it docks right, as every reset does in its row. -->
        <Style x:Key="ResetAllButton" TargetType="ui:Button" BasedOn="{StaticResource QuietResetButton}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- Compact row styles for RGB sliders that need to fit under
             a 200×200 ColorPickerControl. Used in the lightbar base
             color and the three audio-threshold color blocks. -->
        <Style x:Key="DzLabelTight" TargetType="TextBlock">
            <Setter Property="Width" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <!-- Channel letters wear the telemetry mono face, matching the
                 Devices-page X/Y/Z axis tokens. -->
            <Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <!-- RGB rows ride the EmberSlider retemplate (user report,
             2026-07-04): the stock rail reads invisible on the picker
             panel ground, so the recessed steel tray + hairline makes
             the bar present at every value, with the ember fill as the
             level readout. Uniform across all four RGB slider sites. -->
        <Style x:Key="DzRgbSlider" TargetType="Slider" BasedOn="{StaticResource EmberSlider}">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="255"/>
            <Setter Property="Width" Value="148"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
        </Style>
        <Style x:Key="DzValueEditTight" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="Width" Value="48"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="2,1"/>
        </Style>
        <!-- Tight variant kept as an alias: EmberIconButton's fixed 28x28
             already gives the compact RGB rows their footprint. -->
        <Style x:Key="ResetButtonTight" TargetType="ui:Button" BasedOn="{StaticResource ResetButton}"/>

        <!-- Section strip button (#574): one of the six sections in the
             page's header, a RadioButton drawn as a text tab. Primary
             SemiBold text over a 2px ember underline while its section
             shows, secondary text otherwise, and hover brings the text up
             and hints the underline. SyncSectionSelection checks the one
             whose section holds the selected tab. Navigation rides Click,
             so a click on the checked section still goes to it, and
             Checked as well, since UI Automation's Select (a screen
             reader's, a script's) checks a radio button without clicking
             it. -->
        <Style x:Key="SectionStripButton" TargetType="RadioButton">
            <Setter Property="GroupName" Value="PadSection"/>
            <Setter Property="Margin" Value="0,0,26,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <ContentPresenter Margin="0,10,0,10" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                            <Rectangle x:Name="Underline" Height="2" RadiusX="1" RadiusY="1"
                                       VerticalAlignment="Bottom"
                                       Fill="{DynamicResource EmberBrush}" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Setter TargetName="Underline" Property="Opacity" Value="0.35"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Setter Property="TextBlock.FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Underline" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Part switch button (RadioButton styled as tab header). The
             Buttons section switches between Preview, Mappings and Output
             with it, and Macros & Menus between its two. Each strip names
             its own radio group on its buttons, so WPF never unchecks one
             strip's choice from the other. These were the page's slot-tier
             tabs before the six sections (#574). -->
        <Style x:Key="TabStripButton" TargetType="RadioButton">
            <Setter Property="Margin" Value="2,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <!-- Artifact .tier1 .tab.sel: ember-tint fill, warm
                             600-weight text, inset 2px bottom underline.
                             No outline. Hover carries the ember hover glow
                             (#175 hover-glow). -->
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
                            <Grid>
                                <ContentPresenter Margin="12,5,12,7" VerticalAlignment="Center"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}"/>
                                <Rectangle x:Name="Underline" Height="2" RadiusX="1" RadiusY="1"
                                           VerticalAlignment="Bottom" Margin="6,0,6,1"
                                           Fill="{DynamicResource EmberBrush}" Opacity="0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFF6B2C"/>
                                <Setter Property="Foreground" Value="{DynamicResource EmberHotBrush}"/>
                                <Setter Property="TextBlock.FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Underline" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FF6B2C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════ #175 hover-glow styles ═══════════════
             Where a whole class shares one hover treatment, the glow rides
             a BasedOn style (implicit for stock chrome) so WPF-UI theme
             brushes survive. Stock-chrome hover fills raised steel via the
             EmberTheme PointerOver keys, a brightness-only change, so those
             classes get the faint neutral ember. The plain Button, ComboBox,
             TextBox, and CheckBox classes plus the EmberIconButton family
             already carry their glow triggers in the App.xaml styles, so no
             page-level shadows for those here. -->

        <!-- A group that draws nothing of its own (#574). It gives a set of
             cards one name and one AutomationId for a screen reader and a UI
             script, which a panel cannot carry. -->
        <Style x:Key="BareGroupBox" TargetType="GroupBox">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shift-layer tab chips: stock RadioButton chrome. -->
        <Style x:Key="ShiftLayerTabChip" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
        </Style>

        <!-- Stock-chrome item containers, page-wide (no app-level glow for
             these two): Macros list, macro Actions list, sound packages
             list, and every mapping-picker dropdown item. -->
        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
        </Style>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        </Style>

        <!-- Adaptive-trigger mode picker (#574, on #175 competitor item
             5). Closed, it is a select that names the trigger's effect.
             Open, it shows the mode cards in three columns, each a steel
             tile with the effect's live graph. The selected card reads
             ember (a tint wash and the #66FF6B2C rim the output chips
             use), and the card the keyboard or the pointer is on takes
             the lifted fill. Selection round-trips through SelectedValue
             and Tag. The box shows the selected card's TextSearch.Text,
             its name, since the card itself is a picture too tall for a
             box. The box is told to fill the picker: wpf-ui's implicit
             ToggleButton style aligns a button left and centers it, which
             sized the box to its word. Nothing animates but the
             drop-down's fade. -->
        <Style x:Key="AtModeCard" TargetType="ComboBoxItem">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Width" Value="146"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="CardBd" CornerRadius="8" BorderThickness="1"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource SteelLineBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="CardBd" Property="Background" Value="{DynamicResource SteelLiftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBd" Property="Background" Value="{DynamicResource EmberTintBrush}"/>
                                <Setter TargetName="CardBd" Property="BorderBrush" Value="#66FF6B2C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AtModePicker" TargetType="ComboBox">
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource AtModeCard}"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Box" Focusable="False" ClickMode="Press" Cursor="Hand"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                          Padding="0" MinHeight="0" MinWidth="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" CornerRadius="6" BorderThickness="1"
                                                Background="{DynamicResource SteelRaisedBrush}"
                                                BorderBrush="{DynamicResource SteelLineBrush}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SteelLiftBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SelectedItem.(TextSearch.Text), RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center" Margin="10,0,8,0" TextTrimming="CharacterEllipsis"/>
                                    <Path Grid.Column="1" FlowDirection="LeftToRight" Data="M 1,3 L 5,7 L 9,3" Width="10" Height="10"
                                          Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1.4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade" VerticalOffset="4">
                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource SteelLineBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="5">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The graph beside a trigger's picker: there while the trigger
             has an effect. -->
        <Style x:Key="AtModeGraph" TargetType="viewControls:TriggerEffectGraph">
            <Style.Triggers>
                <Trigger Property="Mode" Value="{x:Static vm:AdaptiveTriggerMode.Off}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AtModeCardName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Device selector header -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Extended config bar (visible only for Extended slots) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Configuration tabs -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════
             ROW 0: the controller's header (#574).
             Line 1: what this controller is (type chip, type name and
             number, Preset), its power button with the state word, and
             the More menu.
             Line 2: the devices that drive it, a pill each, and Add
             Device.
             Then the assignment offer while there is one, and the six
             sections. Two tiers of up to fourteen tabs stood here.
             ═══════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="32,24,32,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
            <!-- C275: a WrapPanel, not a DockPanel. The Preset takes a
                 line of its own when the window is too narrow to hold it
                 beside the title, where a panel that cannot wrap gave the
                 last child whatever width was left, which was none.
                 Measured with tools/rowmeasure at the 900 window minimum
                 beside the sidebar, the line holds 588. The power button
                 takes up to 264 of it and the More button 42, which
                 leaves this column 282. The title needs up to 339 (Tamil)
                 beside its chip's 48, and the Preset up to 603 at its
                 combo's cap (Swahili), so the title trims and the
                 Preset's combo gives way before anything runs past the
                 edge. -->
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- The chip and the title stay on one line together. A
                     DockPanel hands the title the width the chip leaves, so
                     a title longer than that ends in an ellipsis. -->
                <DockPanel>
                <!-- Type chip: the slot's type as its Home card and its
                     sidebar entry draw it (SlotTypeIconMap), larger. It
                     states what the slot is and takes no click. -->
                <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="9" Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource EmberBrush}">
                    <Grid>
                        <Path FlowDirection="LeftToRight" Data="{Binding TypeGeometry, Mode=OneWay}" Width="20" Height="20"
                              Stretch="Uniform" Fill="{DynamicResource EmberInkBrush}"/>
                        <controls:GlyphText Text="{Binding TypeGlyph, Mode=OneWay}" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                            Foreground="{DynamicResource EmberInkBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding TypeGlyph, Converter={StaticResource StringToVisibility}}"/>
                    </Grid>
                </Border>

                <!-- The page's title: the type's name and which one of that
                     type this is, where "Slot N" and the identity chip
                     stood. Type name + instance token share ONE TextBlock so
                     they render on a single baseline (user report
                     2026-07-06: the mono #N sat low beside the body type
                     name when each was its own TextBlock centering its own
                     line box). The type name is one VM string, and the mono
                     #N is a Run on the same baseline, its leading space
                     giving the gap. -->
                <TextBlock x:Name="PadTitle" AutomationProperties.HeadingLevel="Level1" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FontFamily="{StaticResource BodyFontFamily}" FontWeight="SemiBold" FontSize="24"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"><Run Text="{Binding OutputTypeDisplayName, Mode=OneWay}"/><Run Text="{Binding TypeInstanceLabel, Mode=OneWay, StringFormat=' #{0}'}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="15" FontWeight="Normal" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></TextBlock>
                </DockPanel>

                <!-- The Preset (#574): its label, its picker as a box 34
                     tall, and its reset, in the header's first line.
                     Visibility is still driven by code-behind through the
                     same names. A Grid: the picker's column takes what the
                     label and the reset leave, so on a short line the
                     picker narrows and the reset stays in view, where a
                     horizontal stack let the three run past the edge. -->
                <Border x:Name="HMaestroProfileBar" Margin="20,0,0,0" VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Pad_Preset, Source={x:Static strings:Strings.Instance}}"
                                   FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="HMaestroProfileCombo" Grid.Column="1" VerticalAlignment="Center"
                                  MaxWidth="380" MinHeight="34"
                                  AutomationProperties.AutomationId="HMaestroProfileCombo"
                                  ItemsSource="{Binding AvailableProfiles}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding ProfileId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  PreviewKeyDown="ProfileCombo_PreviewKeyDown"/>
                        <reset:SettingResetButton Grid.Column="2" Command="{Binding ResetSettingCommand}" CommandParameter="ProfileId" Visibility="{Binding Visibility, ElementName=HMaestroProfileCombo}" SettingLabel="{Binding Pad_Preset, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_PadViewModel_ProfileId_490"/>

                        <!-- Keyboard + Mouse surfaces (#408, @Xaklse on
                             Discord). A Keyboard + Mouse slot has no
                             HIDMaestro profile, so this chip was empty for
                             it. Which halves the slot drives IS its preset,
                             the same choice as Xbox 360 against Elite, so it
                             belongs in this picker's place. Same properties
                             as the profile picker above, flat names only: it
                             shows one short label, never a description.
                             Exactly one of the two pickers is visible. -->
                        <ComboBox x:Name="KbmSurfacesCombo" Grid.Column="1" VerticalAlignment="Center"
                                  MaxWidth="380" MinHeight="34"
                                  AutomationProperties.AutomationId="KbmSurfacesCombo"
                                  IsSynchronizedWithCurrentItem="False"
                                  ItemsSource="{Binding KbmConfig.AvailableKbmSurfaces}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding KbmSurfaces, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="{Binding Pad_Kbm_Surfaces_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                  PreviewKeyDown="MappingComboBox_PreviewKeyDown"/>
                        <reset:SettingResetButton Grid.Column="2" Command="{Binding ResetSettingCommand}" CommandParameter="KbmSurfaces" Visibility="{Binding Visibility, ElementName=KbmSurfacesCombo}" SettingLabel="{Binding ResetLabel_InputSurfaces, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_PadViewModel_KbmSurfaces_531"/>
                    </Grid>
                </Border>

            </WrapPanel>

            <!-- Power button with the slot's state word. The switch and the
                 states are those of the flame on the slot's Home card: on
                 and off, cold with nothing mapped, gold while it waits for
                 devices or the engine, ember while the virtual controller
                 is up. Its data is the slot's summary, which MainWindow
                 hands the page (BindSlotState). The host starts with no
                 data of its own choosing: left to inherit, it would take the
                 page's view model, which has no SelectedSlotSummary, and
                 every binding below would fail against it until the
                 hand-over. -->
            <Border x:Name="SlotPowerHost" Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                    DataContext="{x:Null}">
                <controls:StateToggleButton x:Name="SlotPowerButton" DataContext="{Binding SelectedSlotSummary}"
                                            AutomationProperties.AutomationId="Pad_SlotPower"
                                            AutomationProperties.Name="{Binding Common_Enabled, Source={x:Static strings:Strings.Instance}}"
                                            IsOn="{Binding IsEnabled}" Click="SlotPower_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="MinHeight" Value="34"/>
                            <Setter Property="Padding" Value="10,0,12,0"/>
                            <Setter Property="Background" Value="{DynamicResource SteelRaisedBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource SteelLineBrush}"/>
                            <Setter Property="ToolTip" Value="{Binding Common_Disabled, Source={x:Static strings:Strings.Instance}}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                                CornerRadius="17" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <!-- The pill's ground follows the state word's
                                     color: raised steel while off or with
                                     nothing mapped, gold while it waits, ember
                                     while the virtual controller is up. -->
                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource WaitWellBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource WaitEdgeBrush}"/>
                                    <Setter Property="ToolTip" Value="{Binding Main_Active, Source={x:Static strings:Strings.Instance}}"/>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                        <Condition Binding="{Binding MappedDeviceCount}" Value="0"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource SteelRaisedBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource SteelLineBrush}"/>
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding IsVirtualControllerConnected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource EmberPickBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource EmberEdgeBrush}"/>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                        <Condition Binding="{Binding IsVirtualControllerConnected}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="ToolTip" Value="{Binding Main_AwaitingDevices, Source={x:Static strings:Strings.Instance}}"/>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                        <Condition Binding="{Binding DataContext.EngineStateKey, ElementName=SlotPowerHost}" Value="Stopped"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="ToolTip" Value="{Binding Main_EngineStopped, Source={x:Static strings:Strings.Instance}}"/>
                                </MultiDataTrigger>
                                <!-- Create failed: outranks awaiting-devices (a failed
                                     create with online devices is not waiting) -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                        <Condition Binding="{Binding IsCreateFailed}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="ToolTip" Value="{Binding Main_VcFailed, Source={x:Static strings:Strings.Instance}}"/>
                                </MultiDataTrigger>
                                <!-- Initializing: override tooltip -->
                                <DataTrigger Binding="{Binding IsInitializing}" Value="True">
                                    <Setter Property="ToolTip" Value="{Binding Main_Initializing, Source={x:Static strings:Strings.Instance}}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path FlowDirection="LeftToRight" Data="{StaticResource FlameOuterGeometry}"
                              Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <!-- Default: cold outline (disabled) (#175) -->
                                    <Setter Property="Fill" Value="Transparent"/>
                                    <Setter Property="Stroke" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <Setter Property="StrokeThickness" Value="1.2"/>
                                    <Style.Triggers>
                                        <!-- Enabled + devices mapped: ember (forging).
                                             Enabled-but-empty stays the cold outline (#175):
                                             heat requires fuel. -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                                <Condition Binding="{Binding HasMappedDevices}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                            <Setter Property="Stroke" Value="{x:Null}"/>
                                        </MultiDataTrigger>
                                        <!-- Enabled + mapped but no live VC: gold (awaiting
                                             devices). During the HM-inactivity grace period
                                             the VC stays alive even with devices offline, so
                                             the flame stays ember until the timeout actually
                                             fires and tears the VC down. -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                                <Condition Binding="{Binding HasMappedDevices}" Value="True"/>
                                                <Condition Binding="{Binding IsVirtualControllerConnected}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Fill" Value="{DynamicResource WaitBrush}"/>
                                            <Setter Property="Stroke" Value="{x:Null}"/>
                                        </MultiDataTrigger>
                                        <!-- Enabled + mapped but engine stopped: gold -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                                <Condition Binding="{Binding HasMappedDevices}" Value="True"/>
                                                <Condition Binding="{Binding DataContext.EngineStateKey, ElementName=SlotPowerHost}" Value="Stopped"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Fill" Value="{DynamicResource WaitBrush}"/>
                                            <Setter Property="Stroke" Value="{x:Null}"/>
                                        </MultiDataTrigger>
                                        <!-- Igniting: flashing ember -->
                                        <DataTrigger Binding="{Binding IsInitializing}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                            <Setter Property="Stroke" Value="{x:Null}"/>
                                        </DataTrigger>
                                        <!-- Reduced motion (#175 item 98): no flash loop,
                                             the flame holds steady ember instead. -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsInitializing}" Value="True"/>
                                                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="PadFlashEmberStoryboard">
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="Opacity"
                                                            From="1.0" To="0.15"
                                                            Duration="0:0:0.5"
                                                            AutoReverse="True"
                                                            RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="PadFlashEmberStoryboard"/>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <!-- The word is capped at 204, so the button never
                             takes more than 264 of the line. Measured with
                             tools/rowmeasure, that holds every state in
                             every language but "Virtual controller failed",
                             which trims in 18 of them, and the tooltip says
                             that state in full. -->
                        <TextBlock x:Name="SlotStateWord" common:LiveText.Polite="True" Text="{Binding StatusText}"
                                   MaxWidth="204" TextTrimming="CharacterEllipsis"
                                   FontSize="14" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource WaitBrush}"/>
                                        </DataTrigger>
                                        <!-- Gold requires mappings (#175): enabled but
                                             empty reads Cold in tertiary steel. -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                                <Condition Binding="{Binding MappedDeviceCount}" Value="0"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding IsVirtualControllerConnected}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource EmberHotBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </controls:StateToggleButton>
            </Border>

            <!-- More, under the dots: what acts on the whole controller.
                 Copy its mappings and settings, paste them, copy them from
                 another device, clear its mappings, delete it. Clear All
                 asks through the shared ConfirmDialog first (#175 item 1d). -->
            <Button x:Name="PadMoreButton" Grid.Column="2" Width="34" Height="34" MinHeight="0" Padding="0" Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    ToolTip="{Binding Common_More, Source={x:Static strings:Strings.Instance}}"
                    AutomationProperties.Name="{Binding Common_More, Source={x:Static strings:Strings.Instance}}"
                    AutomationProperties.AutomationId="Pad_More"
                    Click="MoreMenu_Click">
                <Path FlowDirection="LeftToRight" Width="18" Height="4" Stretch="Uniform"
                      Fill="{DynamicResource TextFillColorSecondaryBrush}"
                      Data="M0,2 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M7,2 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M14,2 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0"/>
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding Common_Copy, Source={x:Static strings:Strings.Instance}}" Command="{Binding CopySettingsCommand}"
                                  ToolTip="{Binding Pad_CopyTooltip, Source={x:Static strings:Strings.Instance}}"/>
                        <MenuItem Header="{Binding Common_Paste, Source={x:Static strings:Strings.Instance}}" Command="{Binding PasteSettingsCommand}"
                                  ToolTip="{Binding Pad_PasteTooltip, Source={x:Static strings:Strings.Instance}}"/>
                        <MenuItem Header="{Binding Pad_CopyFrom, Source={x:Static strings:Strings.Instance}}" Command="{Binding CopyFromCommand}"
                                  ToolTip="{Binding Pad_CopyFromTooltip, Source={x:Static strings:Strings.Instance}}"/>
                        <Separator/>
                        <MenuItem Header="{Binding Pad_ClearAll, Source={x:Static strings:Strings.Instance}}" Click="ClearAllMappings_Click"
                                  Foreground="{DynamicResource DangerInkBrush}"
                                  ToolTip="{Binding Pad_ClearMappings, Source={x:Static strings:Strings.Instance}}"/>
                        <MenuItem Header="{Binding Main_DeleteVC, Source={x:Static strings:Strings.Instance}}" Click="DeleteController_Click"
                                  Foreground="{DynamicResource DangerInkBrush}"
                                  AutomationProperties.AutomationId="Pad_DeleteController"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            </Grid>

            <!-- Line 2: the physical device that feeds this controller. -->
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">

                <TextBlock x:Name="DrivenByLabel" Text="{Binding Pad_DrivenBy, Source={x:Static strings:Strings.Instance}}"
                           FontSize="13"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>

                <!-- The devices that feed this controller, a pill for each:
                     its kind's glyph, its name, a Bluetooth mark and its
                     battery when it reports one, as the controller's Home
                     card lists them. The selected pill's device is the one
                     whose settings the page shows. It reads brighter and
                     filled, the others dimmer and clear, and a device that
                     is not connected is faint. A pill is a list item named
                     for its device, which is how a screen reader reads it
                     and how the screenshot script finds it. -->
                <ListBox x:Name="DrivenByList" ItemsSource="{Binding MappedDevices}"
                         SelectedItem="{Binding SelectedMappedDevice, Mode=TwoWay}"
                         AutomationProperties.AutomationId="Pad_DrivenByList"
                         AutomationProperties.LabeledBy="{Binding ElementName=DrivenByLabel}"
                         Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter/>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,2,8,2"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name, TargetNullValue='', FallbackValue=''}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Pill" MinHeight="28" MaxWidth="320" Padding="12,2" CornerRadius="14" BorderThickness="1"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource SteelPillLineBrush}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SteelRaisedBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <controls:GlyphText Text="{Binding TypeGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="220"
                                           VerticalAlignment="Center"/>
                                <controls:GlyphText Text="{Binding TransportGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    VerticalAlignment="Center" Margin="6,0,0,0"
                                                    Visibility="{Binding HasTransportGlyph, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <!-- Battery (issue #167), there when the device reports one. -->
                                <TextBlock Text="{Binding BatteryText}"
                                           FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Add Device opens the Devices page, where a device is
                     given to this controller. -->
                <ui:Button x:Name="AddDeviceButton" Margin="4,2,0,2" VerticalAlignment="Center"
                           MinHeight="28" Padding="8,0" FontSize="13"
                           Style="{StaticResource QuietButton}"
                           Click="AddDevice_Click"
                           Content="{Binding Pad_AddDevice, Source={x:Static strings:Strings.Instance}}"
                           AutomationProperties.AutomationId="Pad_AddDevice">
                    <ui:Button.Icon>
                        <controls:DecorativeStrokeIcon Data="{StaticResource PlusLineGeometry}" Size="14" StrokeWidth="2"/>
                    </ui:Button.Icon>
                </ui:Button>
            </WrapPanel>

            <!-- Assignment offer (Settings > Assignment Prompts). Shown
                 when a device connected while this page was open and one
                 of the two prompt settings applies. Ember band under the
                 Driven by line: the offer is about the slot, and Assign is
                 its primary affirmative. Not Now dismisses this device for
                 this slot for the session. Nothing happens without a click. -->
            <Border Margin="0,12,0,0" Padding="20,12,16,12" CornerRadius="10"
                    Background="{DynamicResource WaitWellBrush}"
                    BorderBrush="{DynamicResource WaitEdgeBrush}" BorderThickness="1"
                    Visibility="{Binding HasAssignOffer, Converter={StaticResource BoolToVisibilityConverter}}"
                    AutomationProperties.AutomationId="AssignOfferBanner">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- E8DE, an arrow into a container: "put this device in
                         this slot". E7FC shipped here first and is the app's
                         CATCH-ALL controller character (DeviceTypeGlyph's
                         fallback for every unrecognized row), so the prompt
                         wore the same face as a device it could not name. -->
                    <controls:GlyphText Text="&#xE8DE;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="{DynamicResource WaitBrush}"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding AssignOfferText}" FontSize="14"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:Button Grid.Column="2" Margin="16,0,4,0" Padding="14,0"
                               Style="{StaticResource EmberPrimaryButton}"
                               Command="{Binding AcceptAssignOfferCommand}"
                               Content="{Binding Pad_AssignOffer_Assign, Source={x:Static strings:Strings.Instance}}"
                               AutomationProperties.AutomationId="AssignOfferAccept"/>
                    <ui:Button Grid.Column="3" Padding="14,0"
                               Style="{StaticResource QuietButton}"
                               Command="{Binding DismissAssignOfferCommand}"
                               Content="{Binding Pad_AssignOffer_Dismiss, Source={x:Static strings:Strings.Instance}}"
                               AutomationProperties.AutomationId="AssignOfferDismiss"/>
                </Grid>
            </Border>

            <!-- The six sections. A section shows on the page while one of
                 its tabs has something for this controller and its selected
                 device (SyncSectionVisibility), so a controller with no
                 gyro, touchpad or pointer has no Motion & Touch. Tag is the
                 section's number (PadViewModel.Sections.cs). -->
            <Border Margin="0,16,0,0" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource SteelLineSoftBrush}">
                <WrapPanel x:Name="SectionStrip" Orientation="Horizontal">
                    <RadioButton x:Name="SectionButtons" Tag="0" Style="{StaticResource SectionStripButton}" Click="SectionBtn_Click" Checked="SectionBtn_Checked"
                                 IsChecked="True"
                                 AutomationProperties.AutomationId="Section_Buttons">
                        <TextBlock Text="{Binding Pad_Section_Buttons, Source={x:Static strings:Strings.Instance}}" FontSize="14"/>
                    </RadioButton>
                    <RadioButton x:Name="SectionSticks" Tag="1" Style="{StaticResource SectionStripButton}" Click="SectionBtn_Click" Checked="SectionBtn_Checked"
                                 AutomationProperties.AutomationId="Section_Sticks">
                        <TextBlock Text="{Binding Pad_Section_Sticks, Source={x:Static strings:Strings.Instance}}" FontSize="14"/>
                    </RadioButton>
                    <RadioButton x:Name="SectionRumble" Tag="2" Style="{StaticResource SectionStripButton}" Click="SectionBtn_Click" Checked="SectionBtn_Checked"
                                 AutomationProperties.AutomationId="Section_Rumble">
                        <TextBlock Text="{Binding Pad_Section_Rumble, Source={x:Static strings:Strings.Instance}}" FontSize="14"/>
                    </RadioButton>
                    <RadioButton x:Name="SectionMotion" Tag="3" Style="{StaticResource SectionStripButton}" Click="SectionBtn_Click" Checked="SectionBtn_Checked"
                                 AutomationProperties.AutomationId="Section_Motion">
                        <TextBlock Text="{Binding Pad_Section_Motion, Source={x:Static strings:Strings.Instance}}" FontSize="14"/>
                    </RadioButton>
                    <RadioButton x:Name="SectionLights" Tag="4" Style="{StaticResource SectionStripButton}" Click="SectionBtn_Click" Checked="SectionBtn_Checked"
                                 AutomationProperties.AutomationId="Section_Lights">
                        <TextBlock Text="{Binding Pad_Section_Lights, Source={x:Static strings:Strings.Instance}}" FontSize="14"/>
                    </RadioButton>
                    <RadioButton x:Name="SectionMacros" Tag="5" Style="{StaticResource SectionStripButton}" Click="SectionBtn_Click" Checked="SectionBtn_Checked"
                                 AutomationProperties.AutomationId="Section_Macros">
                        <TextBlock Text="{Binding Pad_Section_Macros, Source={x:Static strings:Strings.Instance}}" FontSize="14"/>
                    </RadioButton>
                </WrapPanel>
            </Border>
        </StackPanel>

        <!-- ══════════════════════════════════════
             ROW 1: HIDMAESTRO PROFILE PICKER BAR
             (visible for Xbox / PlayStation / Extended slots)
             ══════════════════════════════════════ -->


        <!-- ══════════════════════════════════════
             ROW 1: EXTENDED CONFIGURATION BAR
             (visible only when OutputType == Extended)
             ══════════════════════════════════════ -->
        <Border x:Name="ExtendedConfigBar" Grid.Row="1" Margin="4,4,4,0"
                Padding="10,8" CornerRadius="4"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource TextFillColorDisabledBrush}" BorderThickness="1"
                Visibility="Collapsed">
            <StackPanel>
                <!-- Row 1: Profile picker + Import-from-device -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Pad_Preset, Source={x:Static strings:Strings.Instance}}"
                               VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                    <ComboBox x:Name="ExtendedProfileCombo" Width="420" VerticalAlignment="Center"
                              ItemsSource="{Binding AvailableProfiles}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding ProfileId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              PreviewKeyDown="ProfileCombo_PreviewKeyDown"/>
                    <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="ProfileId" Visibility="{Binding Visibility, ElementName=ExtendedProfileCombo}" SettingLabel="{Binding Pad_Preset, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_PadViewModel_ProfileId_845" Margin="4,0,8,0"/>
                    <Button x:Name="ExtendedImportBtn"
                            Content="{Binding Pad_ExtendedImportFromDevice, Source={x:Static strings:Strings.Instance}}"
                            Margin="12,0,0,0" VerticalAlignment="Center"
                            Click="ExtendedImportBtn_Click"
                            ToolTip="{Binding Pad_ExtendedImportFromDeviceTooltip, Source={x:Static strings:Strings.Instance}}"/>
                    <Button x:Name="ExtendedCloneBtn"
                            Content="{Binding Pad_ExtendedCloneDevice, Source={x:Static strings:Strings.Instance}}"
                            Margin="8,0,0,0" VerticalAlignment="Center"
                            Click="ExtendedCloneBtn_Click"
                            ToolTip="{Binding Pad_ExtendedCloneDeviceTooltip, Source={x:Static strings:Strings.Instance}}"/>
                </StackPanel>

                <!-- Row 2: Master Customize toggle. Controls IsEnabled of rows 3+4 below.
                     When off, the VC uses the catalog profile as-is with no overrides. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" x:Name="ExtendedCustomizeChk"
                              VerticalAlignment="Center"
                              Content="{Binding Pad_ExtendedCustomize, Source={x:Static strings:Strings.Instance}}"
                              Checked="ExtendedCustomize_Toggled" Unchecked="ExtendedCustomize_Toggled"
                              ToolTip="{Binding Pad_ExtendedCustomizeTooltip, Source={x:Static strings:Strings.Instance}}"/>
                    <reset:SettingResetButton Click="ResetExtendedSetting_Click" Tag="Customize" Visibility="{Binding Visibility, ElementName=ExtendedCustomizeChk}" SettingLabel="{Binding Pad_ExtendedCustomize, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_PadViewModel_ExtendedCustomizeChk_865" Margin="4,0,8,0"/>
                    <ui:Button x:Name="ExtendedResetDefaultsBtn" Style="{StaticResource ResetButton}"
                            Click="ExtendedResetDefaults_Click"
                            IsEnabled="{Binding IsChecked, ElementName=ExtendedCustomizeChk}"
                            ToolTip="{Binding Pad_ExtendedResetDefaultsTooltip, Source={x:Static strings:Strings.Instance}}"/>
                </StackPanel>

                <!-- Row 3: Identity override (Product String / OEM / VID / PID) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                    <TextBlock Text="{Binding Pad_ExtendedProductString, Source={x:Static strings:Strings.Instance}}"
                               VerticalAlignment="Center" Margin="0,0,4,0" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               ToolTip="{Binding Pad_ExtendedProductStringTooltip, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBox x:Name="ExtendedProductStringBox" Width="280" VerticalAlignment="Center"
                             LostFocus="ExtendedOverride_Changed" KeyDown="ExtendedOverride_KeyDown" IsEnabled="{Binding IsChecked, ElementName=ExtendedCustomizeChk}"/>
                    <reset:SettingResetButton Click="ResetExtendedSetting_Click" Tag="ProductString" Visibility="{Binding Visibility, ElementName=ExtendedProductStringBox}" SettingLabel="{Binding Pad_ExtendedProductString, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_PadViewModel_ExtendedProductStringBox_880" Margin="4,0,8,0"/>

                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" x:Name="ExtendedOemOverrideChk" Margin="6,0,0,0"
                              VerticalAlignment="Center"
                              Content="{Binding Pad_ExtendedOemOverride, Source={x:Static strings:Strings.Instance}}"
                              Checked="ExtendedOemOverride_Toggled" Unchecked="ExtendedOemOverride_Toggled"
                              ToolTip="{Binding Pad_ExtendedOemOverrideTooltip, Source={x:Static strings:Strings.Instance}}" IsEnabled="{Binding IsChecked, ElementName=ExtendedCustomizeChk}"/>
                    <reset:SettingResetButton Click="ResetExtendedSetting_Click" Tag="OemNameOverride" Visibility="{Binding Visibility, ElementName=ExtendedOemOverrideChk}" SettingLabel="{Binding Pad_ExtendedOemOverride, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_PadViewModel_ExtendedOemOverrideChk_886" Margin="4,0,8,0"/>

                    <TextBlock Text="{Binding Pad_ExtendedVid, Source={x:Static strings:Strings.Instance}}"
                               VerticalAlignment="Center" Margin="12,0,4,0" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="ExtendedVidBox" Width="78" VerticalAlignment="Center"
                             TextAlignment="Center"
                             LostFocus="ExtendedOverride_Changed" KeyDown="ExtendedOverride_KeyDown" IsEnabled="{Binding IsChecked, ElementName=ExtendedCustomizeChk}"/>
                    <reset:SettingResetButton Click="ResetExtendedSetting_Click" Tag="VendorId" Visibility="{Binding Visibility, ElementName=ExtendedVidBox}" SettingLabel="{Binding Pad_ExtendedVid, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_PadViewModel_ExtendedVidBox_893" Margin="4,0,8,0"/>

                    <TextBlock Text="{Binding Pad_ExtendedPid, Source={x:Static strings:Strings.Instance}}"
                               VerticalAlignment="Center" Margin="12,0,4,0" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="ExtendedPidBox" Width="78" VerticalAlignment="Center"
                             TextAlignment="Center"
                             LostFocus="ExtendedOverride_Changed" KeyDown="ExtendedOverride_KeyDown" IsEnabled="{Binding IsChecked, ElementName=ExtendedCustomizeChk}"/>
                    <reset:SettingResetButton Click="ResetExtendedSetting_Click" Tag="ProductId" Visibility="{Binding Visibility, ElementName=ExtendedPidBox}" SettingLabel="{Binding Pad_ExtendedPid, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_PadViewModel_ExtendedPidBox_900"/>
                </StackPanel>

                <!-- Row 4: Layout override (Sticks / Triggers / POVs / Buttons) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                    <TextBlock Text="{Binding Pad_ExtendedSticks, Source={x:Static strings:Strings.Instance}}"
                               VerticalAlignment="Center" Margin="0,0,4,0" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="RawStickCountBox" Width="40" VerticalAlignment="Center"
                             AutomationProperties.AutomationId="RawStickCountBox"
                             TextAlignment="Center" Text="2"
                             LostFocus="ExtendedCustomValue_Changed" KeyDown="ExtendedCustomValue_KeyDown" IsEnabled="{Binding IsChecked, ElementName=ExtendedCustomizeChk}"/>
                    <reset:SettingResetButton Click="ResetExtendedSetting_Click" Tag="ThumbstickCount" Visibility="{Binding Visibility, ElementName=RawStickCountBox}" SettingLabel="{Binding Pad_ExtendedSticks, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_PadViewModel_RawStickCountBox_912" Margin="4,0,8,0"/>

                    <TextBlock Text="{Binding Pad_ExtendedTriggers, Source={x:Static strings:Strings.Instance}}"
                               VerticalAlignment="Center" Margin="10,0,4,0" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="ExtendedTriggerCountBox" Width="40" VerticalAlignment="Center"
                             AutomationProperties.AutomationId="ExtendedTriggerCountBox"
                             TextAlignment="Center" Text="2"
                             LostFocus="ExtendedCustomValue_Changed" KeyDown="ExtendedCustomValue_KeyDown" IsEnabled="{Binding IsChecked, ElementName=ExtendedCustomizeChk}"/>
                    <reset:SettingResetButton Click="ResetExtendedSetting_Click" Tag="TriggerCount" Visibility="{Binding Visibility, ElementName=ExtendedTriggerCountBox}" SettingLabel="{Binding Pad_ExtendedTriggers, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_PadViewModel_ExtendedTriggerCountBox_920" Margin="4,0,8,0"/>

                    <TextBlock Text="{Binding Pad_ExtendedPOVs, Source={x:Static strings:Strings.Instance}}"
                               VerticalAlignment="Center" Margin="10,0,4,0" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="RawPovCountBox" Width="40" VerticalAlignment="Center"
                             AutomationProperties.AutomationId="RawPovCountBox"
                             TextAlignment="Center" Text="1"
                             LostFocus="ExtendedCustomValue_Changed" KeyDown="ExtendedCustomValue_KeyDown" IsEnabled="{Binding IsChecked, ElementName=ExtendedCustomizeChk}"/>
                    <reset:SettingResetButton Click="ResetExtendedSetting_Click" Tag="PovCount" Visibility="{Binding Visibility, ElementName=RawPovCountBox}" SettingLabel="{Binding Pad_ExtendedPOVs, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_PadViewModel_RawPovCountBox_928" Margin="4,0,8,0"/>

                    <TextBlock Text="{Binding Pad_ExtendedButtons, Source={x:Static strings:Strings.Instance}}"
                               VerticalAlignment="Center" Margin="10,0,4,0" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="RawButtonCountBox" Width="72" VerticalAlignment="Center"
                             AutomationProperties.AutomationId="RawButtonCountBox"
                             TextAlignment="Center" Text="11"
                             LostFocus="ExtendedCustomValue_Changed" KeyDown="ExtendedCustomValue_KeyDown" IsEnabled="{Binding IsChecked, ElementName=ExtendedCustomizeChk}"/>
                    <reset:SettingResetButton Click="ResetExtendedSetting_Click" Tag="ButtonCount" Visibility="{Binding Visibility, ElementName=RawButtonCountBox}" SettingLabel="{Binding Pad_ExtendedButtons, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_PadViewModel_RawButtonCountBox_936" Margin="4,0,8,0"/>

                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" x:Name="ExtendedForceFeedbackChk" Margin="14,0,0,0"
                              VerticalAlignment="Center"
                              Content="{Binding Pad_ExtendedForceFeedback, Source={x:Static strings:Strings.Instance}}"
                              IsChecked="{Binding ExtendedConfig.ForceFeedbackEnabled, Mode=TwoWay}" IsEnabled="{Binding IsChecked, ElementName=ExtendedCustomizeChk}"/>
                    <reset:SettingResetButton Click="ResetExtendedSetting_Click" Tag="ForceFeedbackEnabled" Visibility="{Binding Visibility, ElementName=ExtendedForceFeedbackChk}" SettingLabel="{Binding Pad_ExtendedForceFeedback, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_ExtendedSlotConfig_ForceFeedbackEnabled_941"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════
             ROW 1 (alt): MIDI CONFIGURATION BAR
             (visible only when OutputType == Midi)
             ══════════════════════════════════════ -->
        <Border x:Name="MidiConfigBar" Grid.Row="1" Margin="4,4,4,0"
                Padding="10,6" CornerRadius="4"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource TextFillColorDisabledBrush}" BorderThickness="1"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Pad_MidiChannel, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           common:BidiText.ToolTip="{Binding Pad_MidiChannelTooltip, Source={x:Static strings:Strings.Instance}}"/>
                <TextBox x:Name="MidiChannelBox" Width="40" VerticalAlignment="Center"
                         TextAlignment="Center" Text="1"
                         LostFocus="MidiConfig_Changed" KeyDown="MidiConfig_KeyDown"/>
                <reset:SettingResetButton Click="ResetMidiSetting_Click" Tag="Channel" Visibility="{Binding Visibility, ElementName=MidiChannelBox}" SettingLabel="{Binding Pad_MidiChannel, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_PadViewModel_MidiChannelBox_961" Margin="4,0,8,0"/>

                <TextBlock Text="{Binding Pad_MidiCCCount, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="12,0,4,0" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           ToolTip="{Binding Pad_MidiCCCountTooltip, Source={x:Static strings:Strings.Instance}}"/>
                <TextBox x:Name="MidiCcCountBox" Width="54" VerticalAlignment="Center"
                         TextAlignment="Center" Text="6"
                         LostFocus="MidiConfig_Changed" KeyDown="MidiConfig_KeyDown"/>
                <reset:SettingResetButton Click="ResetMidiSetting_Click" Tag="CcCount" Visibility="{Binding Visibility, ElementName=MidiCcCountBox}" SettingLabel="{Binding Pad_MidiCCCount, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_PadViewModel_MidiCcCountBox_968" Margin="4,0,8,0"/>

                <TextBlock Text="{Binding Pad_MidiStartCC, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="12,0,4,0" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           common:BidiText.ToolTip="{Binding Pad_MidiStartCCTooltip, Source={x:Static strings:Strings.Instance}}"/>
                <TextBox x:Name="MidiStartCcBox" Width="54" VerticalAlignment="Center"
                         TextAlignment="Center" Text="1"
                         LostFocus="MidiConfig_Changed" KeyDown="MidiConfig_KeyDown"/>
                <reset:SettingResetButton Click="ResetMidiSetting_Click" Tag="StartCc" Visibility="{Binding Visibility, ElementName=MidiStartCcBox}" SettingLabel="{Binding Pad_MidiStartCC, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_PadViewModel_MidiStartCcBox_975" Margin="4,0,8,0"/>

                <TextBlock Text="{Binding Pad_MidiNoteCount, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="12,0,4,0" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           ToolTip="{Binding Pad_MidiNoteCountTooltip, Source={x:Static strings:Strings.Instance}}"/>
                <TextBox x:Name="MidiNoteCountBox" Width="54" VerticalAlignment="Center"
                         TextAlignment="Center" Text="11"
                         LostFocus="MidiConfig_Changed" KeyDown="MidiConfig_KeyDown"/>
                <reset:SettingResetButton Click="ResetMidiSetting_Click" Tag="NoteCount" Visibility="{Binding Visibility, ElementName=MidiNoteCountBox}" SettingLabel="{Binding Pad_MidiNoteCount, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_PadViewModel_MidiNoteCountBox_982" Margin="4,0,8,0"/>

                <TextBlock Text="{Binding Pad_MidiStartNote, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="12,0,4,0" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           ToolTip="{Binding Pad_MidiStartNoteTooltip, Source={x:Static strings:Strings.Instance}}"/>
                <TextBox x:Name="MidiStartNoteBox" Width="54" VerticalAlignment="Center"
                         TextAlignment="Center" Text="60"
                         LostFocus="MidiConfig_Changed" KeyDown="MidiConfig_KeyDown"/>
                <reset:SettingResetButton Click="ResetMidiSetting_Click" Tag="StartNote" Visibility="{Binding Visibility, ElementName=MidiStartNoteBox}" SettingLabel="{Binding Pad_MidiStartNote, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_PadViewModel_MidiStartNoteBox_989" Margin="4,0,8,0"/>

                <TextBlock Text="{Binding Pad_MidiVelocity, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="12,0,4,0" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           ToolTip="{Binding Pad_MidiVelocityTooltip, Source={x:Static strings:Strings.Instance}}"/>
                <TextBox x:Name="MidiVelocityBox" Width="54" VerticalAlignment="Center"
                         TextAlignment="Center" Text="127"
                         LostFocus="MidiConfig_Changed" KeyDown="MidiConfig_KeyDown"/>
                <reset:SettingResetButton Click="ResetMidiSetting_Click" Tag="Velocity" Visibility="{Binding Visibility, ElementName=MidiVelocityBox}" SettingLabel="{Binding Pad_MidiVelocity, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_PadViewModel_MidiVelocityBox_996"/>

                <!-- The legacy MIDI API cannot create the slot's own port, so
                     the slot sends to an existing one picked here. Hidden
                     under Windows MIDI Services, which ignores the pick. -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsLegacyMidi, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding Pad_MidiOutputPort, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="12,0,4,0" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               ToolTip="{Binding Pad_MidiOutputPortTooltip, Source={x:Static strings:Strings.Instance}}"/>
                    <ComboBox x:Name="MidiOutputPortBox" MinWidth="180" MaxWidth="260" VerticalAlignment="Center"
                              ToolTip="{Binding Pad_MidiOutputPortTooltip, Source={x:Static strings:Strings.Instance}}"
                              DropDownOpened="MidiOutputPortBox_DropDownOpened"
                              SelectionChanged="MidiOutputPortBox_SelectionChanged"
                              AutomationProperties.AutomationId="MidiOutputPortBox"/>
                    <reset:SettingResetButton Click="ResetMidiSetting_Click" Tag="OutputPort" SettingLabel="{Binding Pad_MidiOutputPort, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_PadViewModel_MidiOutputPortBox" Margin="4,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════
             ROW 1 (alt): KEYBOARD + MOUSE DEVICE BAR
             (visible only when OutputType == KeyboardMouse)
             The keyboard and the mouse the slot sends through: Windows
             input, or a keyboard or mouse model from HIDMaestro 1.12.0 that
             programs see as hardware. Each half's picker shows while the
             surface mode drives that half, with what the model can send
             beside it.
             ══════════════════════════════════════ -->
        <Border x:Name="KbmDeviceBar" Grid.Row="1" Margin="4,4,4,0"
                Padding="10,6" CornerRadius="4"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource TextFillColorDisabledBrush}" BorderThickness="1"
                Visibility="Collapsed">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="0,2,16,2"
                            Visibility="{Binding KbmKeyboardDeviceVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding DeviceType_Keyboard, Source={x:Static strings:Strings.Instance}}"
                               VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ComboBox x:Name="KbmKeyboardDeviceCombo" MinWidth="220" MaxWidth="360" VerticalAlignment="Center"
                              AutomationProperties.AutomationId="KbmKeyboardDeviceCombo"
                              IsSynchronizedWithCurrentItem="False"
                              ItemsSource="{Binding KbmConfig.AvailableKeyboardDevices}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding KbmKeyboardDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="{Binding Pad_Kbm_Device_Keyboard_Tooltip, Source={x:Static strings:Strings.Instance}}"
                              PreviewKeyDown="MappingComboBox_PreviewKeyDown"/>
                    <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="KbmKeyboardDevice" SettingLabel="{Binding DeviceType_Keyboard, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_PadViewModel_KbmKeyboardDevice" Margin="4,0,8,0"/>
                    <ItemsControl ItemsSource="{Binding KbmKeyboardCapabilities}" VerticalAlignment="Center" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ChipGhost}" Padding="7,1" Margin="0,0,4,0">
                                    <TextBlock Text="{Binding}" FontSize="11.5"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,2"
                            Visibility="{Binding KbmMouseDeviceVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding DeviceType_Mouse, Source={x:Static strings:Strings.Instance}}"
                               VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ComboBox x:Name="KbmMouseDeviceCombo" MinWidth="220" MaxWidth="360" VerticalAlignment="Center"
                              AutomationProperties.AutomationId="KbmMouseDeviceCombo"
                              IsSynchronizedWithCurrentItem="False"
                              ItemsSource="{Binding KbmConfig.AvailableMouseDevices}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding KbmMouseDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="{Binding Pad_Kbm_Device_Mouse_Tooltip, Source={x:Static strings:Strings.Instance}}"
                              PreviewKeyDown="MappingComboBox_PreviewKeyDown"/>
                    <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="KbmMouseDevice" SettingLabel="{Binding DeviceType_Mouse, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_PadViewModel_KbmMouseDevice" Margin="4,0,8,0"/>
                    <ItemsControl ItemsSource="{Binding KbmMouseCapabilities}" VerticalAlignment="Center" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ChipGhost}" Padding="7,1" Margin="0,0,4,0">
                                    <TextBlock Text="{Binding}" FontSize="11.5"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ═══════════════════════════════════════════
             ROW 2: the selected section (#574).
             Six sections, in the header's order. Buttons and Macros &
             Menus show one part at a time under a part switch, since
             the preview, the mapping table, the macro editor and the
             menu editor each fill the page. The other four stack what
             were tabs of their own as groups in one scrolling column,
             and a group shows while the selected device has that part
             (SyncTabVisibility). The selected tab still has its old
             number, 0 to 17, in SelectedConfigTab, and
             PadViewModel.Sections.cs maps a tab to its section.
             ═══════════════════════════════════════════ -->
        <controls:ContentTabControl Grid.Row="2"
                    PreviewKeyDown="ConfigTabControl_PreviewKeyDown"
                    SelectedIndex="{Binding SelectedSection, Mode=OneWay}">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                      ContentSource="SelectedContent"/>
                </ControlTemplate>
            </TabControl.Template>

            <!-- ═══ SECTION 0: Buttons ═══
                 What each button and control of the controller does. Two
                 views of one table (#574): the picture of the controller,
                 with the picked control's rows and the output cards under
                 it, or the list of every row. The blocks below were tabs of
                 the page and keep that indentation. -->
            <TabItem>
                <Grid Margin="0,20,0,0" x:Name="MappingsTabRoot"
                      PreviewKeyDown="MappingsTabRoot_PreviewKeyDown">
                    <Grid.RowDefinitions>
                        <!-- The top row and the list's chips stay put. Under
                             them the view's own content has the rest. -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- The card's head (#574): the top row, which stays put
                         over the view. Its leading part wraps at a narrow
                         window: the Picture and List switch, the layer
                         chips, Add Layer in the list and the hint over the
                         picture. Its trailing part is the list's tools and
                         Map All, at the row's end. When the trailing part
                         leaves the leading one less than the switch needs,
                         the two stand one under the other. -->
                    <Border Grid.Row="0" x:Name="ButtonsCardHead" Margin="32,0,32,0" Padding="16,12"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="10,10,0,0">
                    <controls:HeadRowPanel x:Name="ButtonsTopRow" LeadingMinWidth="220" Gap="8">
                    <WrapPanel x:Name="ButtonsTopLeft" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource SegmentTrack}" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                        <!-- [Picture] and [List]. These are the Preview and
                             Mappings parts' own radio buttons, with their Tag,
                             handlers and AutomationId, so SelectedConfigTab's
                             numbering and everything that selects them by id
                             keep working. Tab 17, Output, shows the picture:
                             its two cards sit under it. -->
                        <RadioButton x:Name="TabController" Tag="0" GroupName="PadButtonsPart" Style="{StaticResource SegmentRadio}" Click="TabBtn_Click" Checked="TabBtn_Checked"
                                     IsChecked="True"
                                     AutomationProperties.AutomationId="TabController">
                            <TextBlock Text="{Binding Pad_View_Picture, Source={x:Static strings:Strings.Instance}}"/>
                        </RadioButton>

                        <!-- Per-VC scope (Issue #61 multi-source): the table
                             sources from any device assigned to this VC,
                             whichever one is selected. -->
                        <RadioButton x:Name="TabMappings" Tag="2" GroupName="PadButtonsPart" Style="{StaticResource SegmentRadio}" Click="TabBtn_Click" Checked="TabBtn_Checked"
                                     AutomationProperties.AutomationId="MappingsTab">
                            <TextBlock Text="{Binding Pad_View_List, Source={x:Static strings:Strings.Instance}}"/>
                        </RadioButton>

                        </StackPanel>
                        </Border>

                        <!-- The layer chips. Hidden when only Base exists, so a
                             slot without shift layers shows none. One
                             RadioButton per entry in PadViewModel.LayerTabs.
                             Right-click opens the per-chip context menu. -->
                    <Border x:Name="ShiftLayerTrack" Style="{StaticResource SegmentTrack}" Margin="0,0,12,0"
                            Visibility="{Binding HasShiftLayers, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl x:Name="ShiftLayerTabStrip"
                                  ItemsSource="{Binding LayerTabs}"
                                  VerticalAlignment="Center">
                        <!-- WrapPanel so layers with many activators flow
                             to a second row when the window narrows
                             instead of clipping off the right edge. -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="ShiftLayerTabs"
                                             Style="{StaticResource SegmentRadio}"
                                             IsChecked="{Binding IsActive, Mode=TwoWay}"
                                             Click="ShiftLayerTab_Click"
                                             Tag="{Binding LayerMask}">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Per-layer color dot. Hidden on the Base
                                             tab. Visible (gray default or authored
                                             color) for every shift layer. -->
                                        <Ellipse Width="8" Height="8"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding Color, Converter={StaticResource HexToBrushConverter}}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBase}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding LayerName}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <!-- Per-tab context menu, shown on every
                                         tab including Base (round seven, R7:
                                         an older comment here claimed the
                                         first three were disabled for Base,
                                         which nothing implemented). On the
                                         Base tab: Configure opens the
                                         base-appearance dialog, Rename edits
                                         a legacy activator's display name if
                                         one exists, and Delete removes only
                                         a legacy "Base"-masked activator,
                                         never base rows or macros
                                         (ExecuteLayerDelete heals). Copy /
                                         Paste / Clear work against Base rows
                                         as always. -->
                                    <RadioButton.ContextMenu>
                                        <ContextMenu>
                                            <ContextMenu.Resources>
                                                <!-- #175 hover-glow: item hover is the stock
                                                     subtle-fill steel highlight. StaticResource
                                                     resolves lexically, so the page-level glow
                                                     effect is reachable from the popup. -->
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                </Style>
                                            </ContextMenu.Resources>
                                            <MenuItem Header="{Binding Pad_Shift_Configure, Source={x:Static strings:Strings.Instance}}"
                                                      Click="ShiftLayer_Configure_Click"
                                                      Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="{Binding Pad_Shift_Rename, Source={x:Static strings:Strings.Instance}}"
                                                      Click="ShiftLayer_Rename_Click"
                                                      Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <Separator/>
                                            <MenuItem Header="{Binding Pad_Shift_Copy, Source={x:Static strings:Strings.Instance}}"
                                                      Click="ShiftLayer_Copy_Click"
                                                      Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="{Binding Pad_Shift_Paste, Source={x:Static strings:Strings.Instance}}"
                                                      Click="ShiftLayer_Paste_Click"
                                                      Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="{Binding Pad_Shift_Clear, Source={x:Static strings:Strings.Instance}}"
                                                      Click="ShiftLayer_Clear_Click"
                                                      Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <Separator/>
                                            <MenuItem Header="{Binding Pad_Shift_Delete, Source={x:Static strings:Strings.Instance}}"
                                                      Click="ShiftLayer_Delete_Click"
                                                      Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        </ContextMenu>
                                    </RadioButton.ContextMenu>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Border>

                        <!-- Add Layer, with the list: a new layer's rows are
                             edited there. -->
                        <ui:Button x:Name="AddShiftLayerButton" Style="{StaticResource QuietButton}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Content="{Binding Pad_Shift_AddLayer, Source={x:Static strings:Strings.Instance}}"
                                   MinHeight="34" Padding="10,0" Margin="0,0,12,0" VerticalAlignment="Center"
                                   ToolTip="{Binding Pad_Shift_AddLayer_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                   Click="AddShiftLayer_Click"
                                   Visibility="{Binding IsButtonsListView, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <!-- How to map a control, over the picture. -->
                        <TextBlock x:Name="PictureHint" Text="{Binding Pad_PictureHint, Source={x:Static strings:Strings.Instance}}"
                                   FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="4,4,0,4"
                                   Visibility="{Binding IsButtonsPictureView, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </WrapPanel>

                    <WrapPanel x:Name="ButtonsTopRight" Orientation="Horizontal" VerticalAlignment="Top">
                        <!-- The list's own tools. They narrow and edit the whole
                             table, so they show with it. -->
                        <StackPanel x:Name="ListTools" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsButtonsListView, Converter={StaticResource BoolToVisibilityConverter}}">
                        <!-- Picker filter (#322, discussion #302): one search
                             box and one device-visibility popup filtering the
                             slot's SHARED choice view, so every picker on the
                             tab reflects them when opened. A view filter
                             changes what a dropdown OFFERS, never what a
                             row's binding holds. Ctrl+F focuses the box
                             (code-behind on the tab root). -->
                        <ui:TextBox x:Name="MappingFilterSearchBox" MinWidth="200" Margin="0"
                                    VerticalAlignment="Center"
                                    PlaceholderText="{Binding Mapping_FilterSearch_Placeholder, Source={x:Static strings:Strings.Instance}}"
                                    Text="{Binding MappingInputSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <ToggleButton AutomationProperties.Name="{Binding Mapping_FilterDevices_Tooltip, Source={x:Static strings:Strings.Instance}}" x:Name="MappingDeviceFilterToggle" Margin="4,0,0,0" Padding="8,4"
                                      VerticalAlignment="Center"
                                      ToolTip="{Binding Mapping_FilterDevices_Tooltip, Source={x:Static strings:Strings.Instance}}">
                            <controls:DecorativeSymbolIcon Symbol="Filter24"/>
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsChecked, ElementName=MappingDeviceFilterToggle}"
                               PlacementTarget="{Binding ElementName=MappingDeviceFilterToggle}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="{DynamicResource SteelGroundBrush}"
                                    BorderBrush="{DynamicResource SteelLineBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="10" MinWidth="220">
                                <StackPanel>
                                    <TextBlock Text="{Binding Mapping_FilterDevices_Header, Source={x:Static strings:Strings.Instance}}"
                                               FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding PickerDeviceFilterEntries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsShown, Mode=TwoWay}"
                                                          Margin="0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- Keyboard / mouse scope (#408, @Xaklse on Discord).
                             Sits with the search box and the device funnel
                             because it is the same kind of thing: a view
                             control over the table, session-only, ANDed with
                             the search. Distinct from the slot's Surfaces
                             mode, which is persistent output configuration.
                             KbmSurfaceScopeVisible keeps it to a Keyboard +
                             Mouse slot driving BOTH halves: under a
                             single-surface mode a scope can only show
                             everything or nothing. -->
                        <ComboBox x:Name="MappingSurfaceScopeBox" Margin="4,0,0,0" MinWidth="110"
                                  VerticalAlignment="Center" Padding="6,2"
                                  IsSynchronizedWithCurrentItem="False"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding MappingSurfaceScope, Mode=TwoWay}"
                                  ToolTip="{Binding Pad_Mapping_Scope_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                  Visibility="{Binding KbmSurfaceScopeVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ComboBoxItem Tag="All" Content="{Binding Pad_Mapping_Scope_All, Source={x:Static strings:Strings.Instance}}"/>
                            <ComboBoxItem Tag="Mouse" Content="{Binding Pad_Mapping_Scope_Mouse, Source={x:Static strings:Strings.Instance}}"/>
                            <ComboBoxItem Tag="Keyboard" Content="{Binding Pad_Mapping_Scope_Keyboard, Source={x:Static strings:Strings.Instance}}"/>
                        </ComboBox>
                        </StackPanel>


                        <!-- Map All, in both views. -->
                        <Button Content="{Binding MapAllButtonText}"
                                MinHeight="36" Padding="14,0" Margin="12,0,0,0" VerticalAlignment="Center"
                                ToolTip="{Binding MapAllButtonTooltip}"
                                Click="MapAllToggle_Click"/>

                    </WrapPanel>
                    </controls:HeadRowPanel>
                    </Border>


                    <!-- The list's second row: the pipeline chips, and the count
                         of rows drawn as one line at its end. -->
                    <Grid Grid.Row="1" x:Name="ListChipsRow" Margin="32,0,32,0"
                          Visibility="{Binding IsButtonsListView, Converter={StaticResource BoolToVisibilityConverter}}">
                    <!-- The card's sides, behind the chips. -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,1,0"/>
                    <!-- Pipeline heat chips (#175 item 10): one chip per
                         transform pipeline currently rewiring this slot's
                         input. CURVE / GYRO / SHIFT / INV / DZ are mono
                         locale-neutral tokens (DZ / PEAK / DIRECT
                         precedent). A chip renders only while its pipeline
                         carries configuration. The flame inside fills ember
                         while an owning row's live value is active this
                         frame (rowfire lane, no extra timer). Click scrolls
                         the grid to the owning row. Repeat clicks cycle
                         when several rows own the pipeline. SHIFT cycles
                         the layer tabs instead. Tooltips list the real
                         configured rows. -->
                    <WrapPanel Orientation="Horizontal" Margin="16,10,16,0"
                               Visibility="{Binding HasAnyPipelineChips, Converter={StaticResource BoolToVisibilityConverter}}">
                        <WrapPanel.Resources>
                            <!-- Shared chip skeleton: ChipEmber grammar plus
                                 the clickable hover bloom. Static effect from
                                 a trigger, never animated. -->
                            <Style x:Key="PipelineChip" TargetType="Border" BasedOn="{StaticResource ChipEmber}">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Margin" Value="0,0,6,4"/>
                                <Setter Property="Padding" Value="8,2"/>
                            </Style>
                            <Style x:Key="PipelineChipToken" TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}"/>
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                            <!-- Structured tooltip line (user report 2026-07-05:
                                 the chip tooltip ran the whole listing as one
                                 long line). Three lanes on one template, toggled
                                 by the row flags: a device header (only when
                                 several controllers feed the set), the mono
                                 "OUTPUT ← source" mapping line with a shared-
                                 size output column, or the "+N" overflow tail.
                                 Rows come from PadViewModel.BuildPipelineTipRows
                                 on the 1 s config lane. -->
                            <DataTemplate x:Key="PipelineTipRowTemplate">
                                <Grid>
                                    <TextBlock x:Name="TipHeader" Visibility="Collapsed"
                                               Text="{Binding Text}"
                                               FontFamily="{StaticResource TelemetryFontFamily}"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,6,0,2"/>
                                    <Grid x:Name="TipLine" Margin="0,1,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="PipelineTipOutput"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Output}"
                                                   FontFamily="{StaticResource TelemetryFontFamily}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource EmberHotBrush}"/>
                                        <TextBlock Grid.Column="1" Text="←" Margin="8,0,8,0"
                                                   FontFamily="{StaticResource TelemetryFontFamily}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                                   FontFamily="{StaticResource TelemetryFontFamily}"
                                                   FontSize="11"
                                                   MaxWidth="300" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                        <Setter TargetName="TipHeader" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="TipLine" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsTail}" Value="True">
                                        <Setter TargetName="TipHeader" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="TipHeader" Property="FontWeight" Value="Normal"/>
                                        <Setter TargetName="TipHeader" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <Setter TargetName="TipLine" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </WrapPanel.Resources>

                        <!-- CURVE: any curve-bearing output with a non-linear
                             sensitivity curve. -->
                        <controls:ClickBorder Style="{StaticResource PipelineChip}" Tag="Curve"
                                Visibility="{Binding PipelineCurveActive, Converter={StaticResource BoolToVisibilityConverter}}" Click="PipelineChip_Click">
                            <Border.ToolTip>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <Path FlowDirection="LeftToRight" Style="{StaticResource LivenessFlameBase}" Margin="0,0,5,0"/>
                                        <TextBlock Text="CURVE" Style="{StaticResource PipelineChipToken}"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding PipelineCurveTipRows}"
                                                  ItemTemplate="{StaticResource PipelineTipRowTemplate}"
                                                  Grid.IsSharedSizeScope="True"/>
                                </StackPanel>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <Path FlowDirection="LeftToRight" Margin="0,0,5,0">
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource LivenessFlameBase}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PipelineCurveLive}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                                    <Setter Property="Stroke" Value="{x:Null}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#FF6B2C" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="CURVE" Style="{StaticResource PipelineChipToken}"/>
                            </StackPanel>
                        </controls:ClickBorder>

                        <!-- GYRO: rows fed by a Gyro axis source. -->
                        <controls:ClickBorder Style="{StaticResource PipelineChip}" Tag="Gyro"
                                Visibility="{Binding PipelineGyroActive, Converter={StaticResource BoolToVisibilityConverter}}" Click="PipelineChip_Click">
                            <Border.ToolTip>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <Path FlowDirection="LeftToRight" Style="{StaticResource LivenessFlameBase}" Margin="0,0,5,0"/>
                                        <TextBlock Text="GYRO" Style="{StaticResource PipelineChipToken}"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding PipelineGyroTipRows}"
                                                  ItemTemplate="{StaticResource PipelineTipRowTemplate}"
                                                  Grid.IsSharedSizeScope="True"/>
                                </StackPanel>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <Path FlowDirection="LeftToRight" Margin="0,0,5,0">
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource LivenessFlameBase}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PipelineGyroLive}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                                    <Setter Property="Stroke" Value="{x:Null}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#FF6B2C" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="GYRO" Style="{StaticResource PipelineChipToken}"/>
                            </StackPanel>
                        </controls:ClickBorder>

                        <!-- SHIFT: slot has layers beyond Base. Flames while
                             the engine holds a non-Base layer engaged. -->
                        <controls:ClickBorder Style="{StaticResource PipelineChip}" Tag="Shift"
                                Visibility="{Binding PipelineShiftActive, Converter={StaticResource BoolToVisibilityConverter}}" Click="PipelineChip_Click">
                            <Border.ToolTip>
                                <TextBlock Text="{Binding PipelineShiftSummary}"
                                           FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11"/>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <Path FlowDirection="LeftToRight" Margin="0,0,5,0">
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource LivenessFlameBase}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PipelineShiftLive}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                                    <Setter Property="Stroke" Value="{x:Null}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#FF6B2C" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="SHIFT" Style="{StaticResource PipelineChipToken}"/>
                            </StackPanel>
                        </controls:ClickBorder>

                        <!-- INV: rows with the invert transform on. -->
                        <controls:ClickBorder Style="{StaticResource PipelineChip}" Tag="Invert"
                                Visibility="{Binding PipelineInvertActive, Converter={StaticResource BoolToVisibilityConverter}}" Click="PipelineChip_Click">
                            <Border.ToolTip>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <Path FlowDirection="LeftToRight" Style="{StaticResource LivenessFlameBase}" Margin="0,0,5,0"/>
                                        <TextBlock Text="INV" Style="{StaticResource PipelineChipToken}"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding PipelineInvertTipRows}"
                                                  ItemTemplate="{StaticResource PipelineTipRowTemplate}"
                                                  Grid.IsSharedSizeScope="True"/>
                                </StackPanel>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <Path FlowDirection="LeftToRight" Margin="0,0,5,0">
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource LivenessFlameBase}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PipelineInvertLive}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                                    <Setter Property="Stroke" Value="{x:Null}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#FF6B2C" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="INV" Style="{StaticResource PipelineChipToken}"/>
                            </StackPanel>
                        </controls:ClickBorder>

                        <!-- DZ: rows with a per-mapping deadzone off its
                             50% default. -->
                        <controls:ClickBorder Style="{StaticResource PipelineChip}" Tag="DeadZone"
                                Visibility="{Binding PipelineDeadZoneActive, Converter={StaticResource BoolToVisibilityConverter}}" Click="PipelineChip_Click">
                            <Border.ToolTip>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <Path FlowDirection="LeftToRight" Style="{StaticResource LivenessFlameBase}" Margin="0,0,5,0"/>
                                        <TextBlock Text="DZ" Style="{StaticResource PipelineChipToken}"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding PipelineDeadZoneTipRows}"
                                                  ItemTemplate="{StaticResource PipelineTipRowTemplate}"
                                                  Grid.IsSharedSizeScope="True"/>
                                </StackPanel>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <Path FlowDirection="LeftToRight" Margin="0,0,5,0">
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource LivenessFlameBase}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PipelineDeadZoneLive}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                                    <Setter Property="Stroke" Value="{x:Null}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#FF6B2C" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="DZ" Style="{StaticResource PipelineChipToken}"/>
                            </StackPanel>
                        </controls:ClickBorder>
                    </WrapPanel>

                    <!-- Direct-row compression readout (#175 telemetry board):
                         mono tertiary count of rows currently rendered as
                         compact one-liners. DIRECT is a locale-neutral
                         telemetry token like the radar legend's DZ / PEAK.
                         Hidden when no row is compact. -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="8,10,16,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DirectMappingCount}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding DirectMappingCount}"
                                   FontFamily="{StaticResource TelemetryFontFamily}" FontSize="10"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="DIRECT"
                                   FontFamily="{StaticResource TelemetryFontFamily}" FontSize="10"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    </Grid>

                    <!-- The view's own content. The picture's view is a page that
                         scrolls: the picture keeps its height, and the picked
                         control's rows and the output cards sit under it, so
                         opening a row or a card never squeezes the controller
                         out of its picture. The list does not scroll the
                         page: its table fills it and scrolls its own rows.
                         The page's code sets which, and the heights of the
                         picture's row and the table's row (SyncButtonsLayout). -->
                    <ScrollViewer Grid.Row="2" x:Name="ButtonsScroll" AutomationProperties.Name="{Binding Pad_Section_Buttons, Source={x:Static strings:Strings.Instance}}"
                                  VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                  Padding="32,0"
                                  SizeChanged="ButtonsRoot_SizeChanged">
                    <Grid x:Name="ButtonsPage" Margin="0,0,0,24">
                        <Grid.RowDefinitions>
                            <!-- The picture, the line under it, the table, the
                                 output cards. -->
                            <RowDefinition x:Name="ButtonsPictureRow" Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition x:Name="ButtonsTableRow" Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <!-- Nothing sits in this row. In the picture's
                                 view the page's code gives it what the
                                 viewport has left under the cards, so the
                                 rows above keep their own heights. Without
                                 it the grid hands the leftover pixels to
                                 those rows, one each, and to other rows once
                                 a card opens: the line under the picture
                                 moved a pixel and the first card two. -->
                            <RowDefinition x:Name="ButtonsFillRow" Height="Auto"/>
                        </Grid.RowDefinitions>

                    <!-- The card's body (#574), drawn behind the picture and
                         the table: its sides, its foot and its lower
                         corners. The head is the top row over this page. -->
                    <Border Grid.Row="0" Grid.RowSpan="3" x:Name="ButtonsCardBody"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,1,1"
                            CornerRadius="0,0,10,10"/>

                    <!-- The picture. A header-less tab control with an empty
                         second item: in the list the picture leaves the visual
                         tree, as it did when Preview was a tab of its own, so
                         the 3D view draws nothing while it is not on the
                         page. -->
                    <controls:ContentTabControl Grid.Row="0"
                                SelectedIndex="{Binding ButtonsViewIndex, Mode=OneWay}">
                        <TabControl.Template>
                            <ControlTemplate TargetType="TabControl">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"/>
                            </ControlTemplate>
                        </TabControl.Template>
                        <TabItem>
                            <!-- The page's ground under the picture, as the
                                 board has it, inside the card's sides, with
                                 a hairline under it. With nothing picked no
                                 table follows: the picture is the card's
                                 foot then, and takes its lower corners. -->
                            <Border x:Name="PictureGround" Margin="1,0,1,0" Background="{DynamicResource SteelGroundBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=MappingDataGrid}" Value="False">
                                                <Setter Property="CornerRadius" Value="0,0,9,9"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            <Grid>
                    <!-- Ember stage floor (#175): one continuous surface
                         under the model, so the glow never seams. -->
                    <Border IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush GradientOrigin="0.5,0.82" Center="0.5,0.82" RadiusX="0.55" RadiusY="0.45">
                                <GradientStop Color="#20FF6B2C" Offset="0"/>
                                <GradientStop Color="#00FF6B2C" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- ══════════════════════════════════════
                         CONTROLLER MODEL (2D / 3D)
                         ══════════════════════════════════════ -->
                    <Grid AutomationProperties.AutomationId="ControllerModelHost">
                        <views:ControllerModelView x:Name="ControllerModel3D" />
                        <views:ControllerModel2DView x:Name="ControllerModel2D" Visibility="Collapsed" />
                        <views:ControllerSchematicView x:Name="ControllerSchematic" Visibility="Collapsed" />
                        <views:MidiPreviewView x:Name="MidiPreview" Visibility="Collapsed" />
                        <views:KBMPreviewView x:Name="KBMPreview" Visibility="Collapsed" />
                        <views:VRPreviewView x:Name="VRPreview" Visibility="Collapsed" />

                        <!-- A Valve slot's touch sensors (HIDMaestro 1.12.0): the
                             stick tops on the Deck and the 2026 pad, the grips on
                             the 2026 pad. The art has no place to click them, so
                             each is a capsule that lights while its output is on
                             and records its row on a click. Collapsed on every
                             other slot. -->
                        <views:TouchSensorStrip x:Name="TouchSensors"
                                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                                Margin="0,8,0,0" />

                        <!-- 2D/3D toggle button (top-left to avoid overlap with 3D Reset View) -->
                        <Button AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}, TargetNullValue='', FallbackValue=''}" x:Name="ViewModeToggle"
                                AutomationProperties.AutomationId="ViewModeToggle"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="8,8,0,0" Padding="6,4"
                                Click="ViewModeToggle_Click" ToolTip="{Binding Pad_SwitchTo2D, Source={x:Static strings:Strings.Instance}}">
                            <controls:GlyphText x:Name="ViewModeIcon" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Text="&#xE8B9;"/>
                        </Button>
                    </Grid>

                    <!-- While a recording waits for an input: which control,
                         and Stop. It lies over the picture's foot, so the
                         picture keeps its size when a recording starts. The
                         list has no such bar: a row shows its own recording
                         state. -->
                    <Border x:Name="PictureLine" VerticalAlignment="Bottom" MinHeight="44" Padding="20,6,12,6"
                            Background="{DynamicResource EmberWellBrush}"
                            BorderBrush="{DynamicResource EmberEdgeBrush}" BorderThickness="0,1,0,0"
                            Visibility="{Binding IsListening, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DockPanel LastChildFill="True">
                            <Button x:Name="ListeningStopButton" DockPanel.Dock="Right" MinHeight="30" Padding="14,0" Margin="10,0,0,0" VerticalAlignment="Center"
                                    Content="{Binding Common_Stop, Source={x:Static strings:Strings.Instance}}"
                                    AutomationProperties.AutomationId="Pad_ListeningStop"
                                    Click="ListeningStop_Click"/>
                            <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center"
                                     FlowDirection="LeftToRight"
                                     Fill="{DynamicResource EmberBrush}"/>
                            <TextBlock x:Name="PictureLineText" Text="{Binding PictureLineText}" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="Pad_PictureLine"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>
                            </Grid>
                            </Border>
                        </TabItem>
                        <TabItem/>
                    </controls:ContentTabControl>

                    <!-- Inline rename popup, anchored at runtime to the
                         clicked shift-layer tab. Single-field input + Save
                         + Cancel. Much lighter than reopening the full
                         Configure dialog when the user just wants to fix
                         the name. -->
                    <Popup x:Name="RenameLayerPopup"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           StaysOpen="False">
                        <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                                  Direction="270" Opacity="0.30" Color="Black"/>
                            </Border.Effect>
                            <StackPanel Orientation="Vertical" MinWidth="240">
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Shift_LayerName, Source={x:Static strings:Strings.Instance}}"
                                           Margin="0,0,0,4"/>
                                <TextBox x:Name="RenameLayerBox"
                                         Margin="0,0,0,8"
                                         KeyDown="RenameLayerBox_KeyDown"/>
                                <TextBlock x:Name="RenameLayerHint"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,6"
                                           Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <!-- Save is the popup's primary affirmative and wears
                                         the ember accent (#175 dialog language). The old
                                         inline TextOnAccent-on-accent pair went dark text
                                         on ember (user report 2026-07-05). -->
                                    <Button Content="{Binding Common_Save, Source={x:Static strings:Strings.Instance}}"
                                            MinWidth="72" Margin="0,0,6,0"
                                            IsDefault="True"
                                            Click="RenameLayerSave_Click"
                                            Style="{StaticResource EmberAccentButton}"/>
                                    <Button Content="{Binding Common_Cancel, Source={x:Static strings:Strings.Instance}}"
                                            MinWidth="72"
                                            IsCancel="True"
                                            Click="RenameLayerCancel_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- Mapping DataGrid. It fills the card (#574), so a row is
                         the card's width: a closed row's line ends with its
                         buttons at the card's edge, and an open row's cells
                         stand at its start with the room after them empty.
                         Every column is Auto and sized by the page's code
                         (AutoFitFlexibleColumns), so none takes the room that
                         is left. The table has no column headings: a closed
                         row needs none, and an open row's cells name
                         themselves. It has no grid lines of its own either:
                         a row draws the hairline over itself, since the
                         table's lines belong to a row's cells and a closed
                         row hides them. The 1 over the table lays the first
                         hairline on the line under the head or the picture. -->
                    <DataGrid AutomationProperties.Name="{Binding Pad_Mappings, Source={x:Static strings:Strings.Instance}}" Grid.Row="2"
                              x:Name="MappingDataGrid"
                              Margin="1,-1,1,1"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                              HorizontalAlignment="Stretch"
                              MinRowHeight="39"
                              ItemsSource="{Binding Mappings}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              SelectionMode="Single"
                              HeadersVisibility="None"
                              GridLinesVisibility="None"
                              IsReadOnly="True"
                              VerticalScrollBarVisibility="Visible"
                              Grid.IsSharedSizeScope="True"
                              SelectionChanged="MappingDataGrid_SelectionChanged"
                              PreviewMouseWheel="MappingDataGrid_PreviewMouseWheel"
                              Loaded="MappingDataGrid_Loaded">
                        <!-- No rows, no table: under the picture before a control is
                             picked, and in the list when the search matches
                             nothing. -->
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Style.Triggers>
                                    <Trigger Property="HasItems" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <!-- The list's groups (#574), as the List board draws them:
                             a band for each kind of output with its name and how
                             many outputs it holds, then its rows. The band folds
                             the group. The view model groups the rows by category
                             in a gamepad's list only (PadViewModel.ListIsGrouped),
                             so the rows under the picture stand under no band.
                             A group is an Expander: GroupItem looks for one in
                             its template to learn whether its rows show, which
                             keeps the rows virtualized while the table is
                             grouped, and its peer tells a screen reader whether
                             the group is open. The page's code keeps each one in
                             step with the state the view model holds by category
                             (ListGroup_Synced, ListGroup_Toggled), since the
                             table builds its groups again whenever its rows
                             change. -->
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <Expander IsExpanded="True" Focusable="False"
                                                              AutomationProperties.Name="{Binding Text, ElementName=ListGroupTitle, TargetNullValue=''}"
                                                              Loaded="ListGroup_Synced" DataContextChanged="ListGroup_ContextChanged"
                                                              Expanded="ListGroup_Toggled" Collapsed="ListGroup_Toggled">
                                                        <Expander.Template>
                                                            <ControlTemplate TargetType="Expander">
                                                                <StackPanel>
                                                                    <ToggleButton x:Name="Band" Cursor="Hand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                                                  AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}"
                                                                                  Content="{TemplateBinding Header}">
                                                                        <ToggleButton.Template>
                                                                            <ControlTemplate TargetType="ToggleButton">
                                                                                <Border MinHeight="36" Padding="16,0"
                                                                                        Background="{DynamicResource SteelBandBrush}"
                                                                                        BorderBrush="{DynamicResource SteelLineSoftBrush}" BorderThickness="0,1,0,0">
                                                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </ToggleButton.Template>
                                                                    </ToggleButton>
                                                                    <ContentPresenter x:Name="Rows" Visibility="Collapsed"/>
                                                                </StackPanel>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsExpanded" Value="True">
                                                                        <Setter TargetName="Rows" Property="Visibility" Value="Visible"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Expander.Template>
                                                        <Expander.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <!-- Down while the group is open, sideways
                                                                     while it is closed, as a folded part's is. -->
                                                                <Path FlowDirection="LeftToRight" Data="M 3.5,5.25 L 7,8.75 L 10.5,5.25" Width="14" Height="14"
                                                                      Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1.2"
                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                                      VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                                    <Path.Style>
                                                                        <Style TargetType="Path">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type Expander}}}" Value="False">
                                                                                    <Setter Property="RenderTransform">
                                                                                        <Setter.Value>
                                                                                            <RotateTransform Angle="-90"/>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Path.Style>
                                                                </Path>
                                                                <!-- The category's name: its place in
                                                                     MappingCategory picks one of the names. -->
                                                                <TextBlock x:Name="ListGroupTitle" FontFamily="{StaticResource BodyFontFamily}" FontSize="13" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           VerticalAlignment="Center" Margin="10,0,0,0">
                                                                    <TextBlock.Text>
                                                                        <MultiBinding Converter="{StaticResource IndexTextConverter}">
                                                                            <Binding Path="Name"/>
                                                                            <Binding Path="Preview_Buttons" Source="{x:Static strings:Strings.Instance}"/>
                                                                            <Binding Path="Preview_DPad" Source="{x:Static strings:Strings.Instance}"/>
                                                                            <Binding Path="Pad_Triggers" Source="{x:Static strings:Strings.Instance}"/>
                                                                            <Binding Path="Menu_Host_LeftStick" Source="{x:Static strings:Strings.Instance}"/>
                                                                            <Binding Path="Menu_Host_RightStick" Source="{x:Static strings:Strings.Instance}"/>
                                                                            <Binding Path="Pad_Touchpad" Source="{x:Static strings:Strings.Instance}"/>
                                                                            <Binding Path="Pad_Gyro_Passthrough_Header" Source="{x:Static strings:Strings.Instance}"/>
                                                                        </MultiBinding>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding ItemCount}" FontFamily="{StaticResource BodyFontFamily}" FontSize="13"
                                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                            </StackPanel>
                                                        </Expander.Header>
                                                        <ItemsPresenter/>
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <!-- The look of every cell. Each template column bases a cell
                             style on it that names its cells for screen readers, which
                             would otherwise read WPF's "Item: ..., Column Display
                             Index: N" (DataGridCellItemAutomationPeer.GetNameCore). -->
                        <DataGrid.Resources>
                            <Style x:Key="MappingCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <!-- HorizontalContentAlignment used to be Stretch here.
                                     That made every cell hand its child the full column
                                     width during arrange, which (combined with the
                                     CellsPanel's measure pass) inflated the Auto Options
                                     column to absorb the leftover horizontal slack of
                                     the row. Switched to Left so cells size and align
                                     to their content's actual DesiredSize. Columns
                                     that need horizontal fill (the Source ComboBox)
                                     set Stretch on their own template root. -->
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Style.Triggers>
                                    <!-- The base DataGridCell paints #FFF0F0F0 (the classic
                                         Windows control gray) on IsSelected, which is the
                                         searing white on a selected row in dark mode. Keep
                                         selected cells transparent so the row's subtle ember
                                         wash shows through uniformly, and hold the text light. -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <!-- Ember close-out item 8: mono eyebrow column headers
                             (spec 235-244). Attached directly here, NOT as an
                             implicit page-level style (that broke once with a
                             white bar). Uppercase is display-only via
                             UpperConverter. Resource strings stay Title Case. -->
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}"/>
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource SteelLineSoftBrush}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <!-- The 12 after the text keeps two headings apart
                                     where a column is no wider than its own
                                     heading: under the picture the Output
                                     column held one short chip, and OUTPUT ran
                                     into SOURCE. -->
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource UpperConverter}}" Margin="0,0,12,0"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <!-- #175 hover-glow: stock header hover is a
                                     neutral fill change. -->
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <StaticResource ResourceKey="MappingCellStyle"/>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="Transparent"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <!-- Each row is a Tab stop for keyboard and screen
                                     reader users. WPF makes a DataGridRow unfocusable,
                                     and a closed row hides the cells that could take
                                     focus, so Tab skipped the whole table. On a row the
                                     keys a slot maps do nothing (#61), and a click leaves
                                     focus to the window, which clears it. -->
                                <Setter Property="Focusable" Value="True"/>
                                <!-- A closed row has its cells collapsed, so a click
                                     never reaches a DataGridCell and WPF's own
                                     selection logic won't fire. The handler selects
                                     the row, which opens it. Enter/Space on a focused
                                     row toggles it open and closed. -->
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="MappingRow_PreviewMouseLeftButtonDown"/>
                                <EventSetter Event="PreviewKeyDown" Handler="MappingRow_PreviewKeyDown"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <!-- The row draws the hairline over itself.
                                             Rowfire (#175 artifact .mrow::after): the
                                             underline lives at the row line's bottom
                                             edge, above the details presenter, exactly
                                             where the pitch draws it. -->
                                        <ControlTemplate TargetType="DataGridRow">
                                            <Border x:Name="DGR_Border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{DynamicResource SteelPaneLineBrush}" BorderThickness="0,1,0,0"
                                                    SnapsToDevicePixels="True">
                                                <SelectiveScrollingGrid>
                                                    <SelectiveScrollingGrid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </SelectiveScrollingGrid.RowDefinitions>
                                                    <DataGridCellsPresenter x:Name="CellsHost"
                                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                    <!-- A closed row's line (#574), as the List board
                                                         draws it: the output's name, what drives it,
                                                         a meter of its live value, then Record, Clear
                                                         and the chevron that opens the row. Every row
                                                         that is not selected shows it, so a whole
                                                         config reads on one screen (#175 telemetry
                                                         board). A click on the line opens the row.
                                                         The meter is the liveness cue, and Rowfire
                                                         below still animates on a closed row.
                                                         A row fed by more than one source adds a "+N"
                                                         tail and the combine token (#175 phase two
                                                         item 10). The name is a shared-size column
                                                         (scope = the DataGrid) so the lines read as an
                                                         aligned board, same construction as the
                                                         pipeline-tip listing's shared output column.
                                                         The line is as wide as the table's viewport and
                                                         holds still when the table scrolls sideways. A
                                                         row is as wide as the table's columns, which an
                                                         open row's cells can make wider than the card,
                                                         and a line of that width put its buttons past
                                                         the card's edge. -->
                                                    <Border x:Name="CompactLine" Visibility="Collapsed" HorizontalAlignment="Left"
                                                            Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}"
                                                            SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical">
                                                    <Grid MinHeight="38" Margin="16,0,8,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" MinWidth="212" SharedSizeGroup="CompactRowOutput"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- The output's name. Its column is as wide as the widest
                                                             name of the table and never under 200 and the 12 after
                                                             it, so the rows read as one board. -->
                                                        <TextBlock Text="{Binding TargetLabel}"
                                                                   FontFamily="{StaticResource BodyFontFamily}" FontSize="14"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                        <!-- What drives it: the source as a chip, the device that
                                                             feeds it beside the chip (user report 2026-07-04: "Button A
                                                             from which device?!"), then the fan-in tail. The three
                                                             stand together at the column's start. When the row is
                                                             narrow the device's name gives way: the tail is docked
                                                             first, so it keeps its width, and the name is the last
                                                             child and takes what is left. -->
                                                        <DockPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                            <Border x:Name="SourceChip" DockPanel.Dock="Left" MinHeight="26" Padding="10,0" CornerRadius="6" BorderThickness="1"
                                                                    Background="{DynamicResource SteelRaisedBrush}"
                                                                    BorderBrush="{DynamicResource SteelPillLineBrush}">
                                                                <TextBlock x:Name="SourceChipText" Text="{Binding SourceDisplayText, Mode=OneWay}"
                                                                           FontFamily="{StaticResource BodyFontFamily}" FontSize="14"
                                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <!-- Fan-in tail: "+N" for the extra sources feeding
                                                                     this output. Collapses on a row with none. -->
                                                                <TextBlock FontFamily="{StaticResource TelemetryFontFamily}"
                                                                           FontSize="12" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource ColdBrush}"
                                                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                                                           Text="{Binding ExtraSources.Count, Mode=OneWay, StringFormat={}+{0}}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ExtraSources.Count}" Value="0">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <!-- Combine token chip: the engine's locale-neutral
                                                                     mode value (MaxAbs / OR / XOR), display-uppercased.
                                                                     Cold chip family: combining is a source-side
                                                                     affair. Hidden alongside the +N tail, and when the
                                                                     mode is still the implicit-default empty sentinel. -->
                                                                <Border CornerRadius="3" BorderThickness="1"
                                                                        Padding="5,1" Margin="8,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        Background="#0D58B6E4"
                                                                        ToolTip="{Binding Pad_CombineChip_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                                                    <Border.BorderBrush>
                                                                        <SolidColorBrush Color="#3D58B6E4"/>
                                                                    </Border.BorderBrush>
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ExtraSources.Count}" Value="0">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding CombineMode}" Value="">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding CombineModeDisplayName, Converter={StaticResource UpperConverter}}"
                                                                               FontFamily="{StaticResource TelemetryFontFamily}"
                                                                               FontSize="9.5"
                                                                               Foreground="{DynamicResource ColdBrush}"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding PrimarySourceDeviceLabel}"
                                                                       FontFamily="{StaticResource BodyFontFamily}" FontSize="13"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                       VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding PrimarySourceDeviceLabel}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </DockPanel>
                                                        <!-- The value meter, then the row's own buttons. They act on
                                                             the row and leave it closed, and are no Tab stops: the
                                                             row is one, and Enter or Space on it opens the editor,
                                                             which has Record and Clear of its own. -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ProgressBar Style="{StaticResource ValueMeter}" Width="96" Margin="12,0,0,0"
                                                                         Value="{Binding LiveLevel, Mode=OneWay}"
                                                                         AutomationProperties.Name="{Binding Pad_HeaderValue, Source={x:Static strings:Strings.Instance}}"/>
                                                            <ui:Button Command="{Binding ToggleRecordCommand}" IsEnabled="{Binding IsRecordable}"
                                                                       Style="{StaticResource RowIconButton}"
                                                                       AutomationProperties.Name="{Binding RecordButtonText, TargetNullValue=''}">
                                                                <controls:GlyphText Text="{Binding RecordButtonIcon}" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                                                <ui:Button.ToolTip>
                                                                    <TextBlock Text="{Binding RecordButtonText}"/>
                                                                </ui:Button.ToolTip>
                                                            </ui:Button>
                                                            <ui:Button Command="{Binding ClearCommand}"
                                                                       Style="{StaticResource RowIconButton}"
                                                                       AutomationProperties.Name="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}"
                                                                       ToolTip="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}">
                                                                <Path FlowDirection="LeftToRight" Data="M 4,4 L 12,12 M 12,4 L 4,12" Width="16" Height="16"
                                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ui:Button}}}"
                                                                      StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                            </ui:Button>
                                                            <ui:Button Click="MappingRowOpen_Click"
                                                                       Style="{StaticResource RowIconButton}"
                                                                       AutomationProperties.Name="{Binding Pad_HeaderOptions, Source={x:Static strings:Strings.Instance}}"
                                                                       ToolTip="{Binding Pad_HeaderOptions, Source={x:Static strings:Strings.Instance}}">
                                                                <Path FlowDirection="LeftToRight" Data="M 1,3 L 5,7 L 9,3" Width="10" Height="10"
                                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ui:Button}}}"
                                                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                            </ui:Button>
                                                        </StackPanel>
                                                    </Grid>
                                                    </Border>
                                                    <Rectangle x:Name="Rowfire" Height="1.5"
                                                               VerticalAlignment="Bottom"
                                                               Margin="8,0,8,0" Opacity="0"
                                                               IsHitTestVisible="False">
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                                                <GradientStop Color="#8058B6E4" Offset="0"/>
                                                                <GradientStop Color="#99FF6B2C" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                    <DataGridDetailsPresenter Grid.Row="1"
                                                        Visibility="{TemplateBinding DetailsVisibility}"/>
                                                </SelectiveScrollingGrid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!-- A row that is not open is its one line (#574): the
                                                     cells give way to it until the row is selected, which
                                                     opens the editor and the details under it. Only plain
                                                     rows and fan-in rows had a line, and a row with an
                                                     option set stood open at all times.
                                                     IsRowSelected mirrors the table's selection (set in
                                                     SelectionChanged). Discussion #348: a selected row stays
                                                     open whatever its sources become, so the cells under an
                                                     open details strip never collapse. The IsExpandedOverride
                                                     condition keeps the column fit honest: it opens every
                                                     row off-frame through that flag to measure its cells. -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsRowSelected}" Value="False"/>
                                                        <Condition Binding="{Binding IsExpandedOverride}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="CellsHost" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="CompactLine" Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                                <!-- A row nothing drives says so in a quiet chip. -->
                                                <DataTrigger Binding="{Binding IsMapped}" Value="False">
                                                    <Setter TargetName="SourceChip" Property="Background" Value="Transparent"/>
                                                    <Setter TargetName="SourceChipText" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                </DataTrigger>
                                                <!-- Reduced motion (#175 item 98): rowfire only
                                                     animates when the OS animation preference
                                                     (ClientAreaAnimation) is on. -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsInputActive}" Value="True"/>
                                                        <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Rowfire"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 To="1" Duration="0:0:0.3">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.EnterActions>
                                                    <MultiDataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Rowfire"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 To="0" Duration="0:0:1.2">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseIn"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <!-- The open row lies on the card's lifted fill, as the
                                         board's does. The stock selection fill reads
                                         near-white in dark mode. The recording triggers
                                         sit after this one so an armed row reads ember
                                         when both hold (#30). -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SteelCardHoverBrush}"/>
                                    </Trigger>
                                    <!-- Reduced motion (#175 item 98): the looping arm-flash
                                         only runs when ClientAreaAnimation is on. Otherwise
                                         the armed row holds a static ember tint.
                                         The pulse holds the ember tint via the setter and
                                         breathes the row's Opacity, a single-step path. The
                                         old (Background).(Color) complex path crashed when a
                                         recording row re-realized under virtualization: the
                                         trigger is already true mid-instantiation, before the
                                         row's Background is an animatable local brush (same
                                         class as the forge-bar and v4.0.0 launch crashes). -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsRecording}" Value="True"/>
                                            <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="#48FF6B2C"/>
                                        <MultiDataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="RecordFlash">
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="Opacity"
                                                        From="1.0" To="0.55"
                                                        Duration="0:0:0.4" AutoReverse="True"
                                                        RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </MultiDataTrigger.EnterActions>
                                        <MultiDataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="RecordFlash"/>
                                        </MultiDataTrigger.ExitActions>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsRecording}" Value="True"/>
                                            <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="#30FF6B2C"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.RowDetailsVisibilityMode>VisibleWhenSelected</DataGrid.RowDetailsVisibilityMode>
                        <DataGrid.RowDetailsTemplate>
                            <!-- Issue #61 multi-source: per-row details
                                 visible when the row is selected. Shows
                                 the row's combine mode, the list of
                                 ExtraSources (sources beyond the primary
                                 single-source), and a + Add source link
                                 to append a new source. -->
                            <DataTemplate>
                                <!-- Subpanel look (#175 artifact .subpanel): 2px cold left
                                     rail, faint cold wash, rounded on the free right side
                                     only (radius 0,8,8,0). rgba(88,182,228,0.03) = #0858B6E4. -->
                                <Border Padding="20,4,8,8"
                                        BorderThickness="2,0,0,0"
                                        CornerRadius="0,8,8,0"
                                        Background="#0858B6E4">
                                    <Border.Style>
                                        <!-- Rail tints to the active layer's authored
                                             color (#175). Cold when the layer has none.
                                             Converter's gray fallback never shows: the
                                             empty-string trigger wins first. -->
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush"
                                                    Value="{Binding DataContext.ActiveLayerColor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource HexToBrushConverter}}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.ActiveLayerColor, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="">
                                                    <Setter Property="BorderBrush" Value="#3D58B6E4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Vertical">
                                        <!-- Primary mode + kind tuning (#111). The Mode dropdown lives here
                                             in the detail strip so the Source cell holds only the mapping and
                                             never crowds the input picker. Set it to Direct (or hit the row's
                                             Clear) to drop the kind. The Ramp / Incremental sliders below are
                                             gated by kind. DataContext is the row's PrimaryKindSource. -->
                                        <StackPanel DataContext="{Binding PrimaryKindSource}" Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Pad_Mapping_PrimaryMode, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                                           FontFamily="{StaticResource TelemetryFontFamily}"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="10"/>
                                                <ComboBox ItemsSource="{Binding DataContext.PrimaryKindOptions, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"
                                                          SelectedValue="{Binding Kind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          SelectedValuePath="Value" DisplayMemberPath="Name"
                                                          MinWidth="130" Padding="4,2" VerticalAlignment="Center"
                                                          ToolTip="{Binding Pad_Mapping_Kind_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                          PreviewKeyDown="MappingComboBox_PreviewKeyDown"/>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="Kind" SettingLabel="{Binding ResetLabel_SourceType, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MappingSourceItem_Kind_4282"/>
                                                <!-- A primary Incremental or Ramp source saved with Invert on: the
                                                     checkbox an extra source shows for one (IsKeyInvertShown), and
                                                     the control that turns the flag off. It is the kind holder's
                                                     own Invert, which the engine applies and the save writes back.
                                                     The Invert in the row's Options column is the row's flag, which
                                                     the save leaves out of a key-kind primary. -->
                                                <CheckBox Content="{Binding Pad_Invert, Source={x:Static strings:Strings.Instance}}"
                                                          IsChecked="{Binding Invert, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Visibility="{Binding IsKeyInvertShown, Converter={StaticResource BoolToVisibilityConverter}}"
                                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                          Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        Visibility="{Binding IsRampedKind, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Mapping_Ramp_Attack, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <Slider Value="{Binding ParamAttackTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="5" SmallChange="0.05" LargeChange="0.25" Width="80" VerticalAlignment="Center"
                                                        ToolTip="{Binding Pad_Mapping_Ramp_Attack_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
