<views:DialogWindow AutomationProperties.IsDialog="True" x:Class="PadForge.Views.KeyboardScreenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        xmlns:controls="clr-namespace:PadForge.Controls"
        xmlns:reset="clr-namespace:PadForge.Controls"
        xmlns:common="clr-namespace:PadForge.Common"
        xmlns:views="clr-namespace:PadForge.Views"
        Width="700"
        Subtitle="{Binding KeyboardScreen_Subtitle, Source={x:Static strings:Strings.Instance}}">

    <!-- What one keyboard screen or one Screen Overlay shows (#519, #560,
         #574), as the Dialogs-Screens board draws it: the screen as it will
         look at the left, and at the right what it shows, a line that says
         what that is, and the settings the choice adds. A chosen picture
         adds Choose Picture, and on an overlay its zoom, and the pan once
         the picture is larger than the screen. Lightbar Color adds the slot
         an overlay follows. The title is the screen's name, set in code. -->
    <views:DialogWindow.Resources>
        <!-- A row's label: the board's 90 column, 10 before the control. -->
        <Style x:Key="ScreenLabel" TargetType="TextBlock" BasedOn="{StaticResource DialogLabel}">
            <Setter Property="Width" Value="90"/>
        </Style>
        <!-- A number, as the board draws one: 72 wide with its digits at
             the right. -->
        <Style x:Key="ScreenNumber" TargetType="ui:TextBox" BasedOn="{StaticResource DialogTextBox}">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </views:DialogWindow.Resources>

    <views:DialogWindow.Foot>
        <controls:FlexLinePanel Style="{StaticResource DialogFootPanel}">
            <Button Style="{StaticResource DialogButton}" IsCancel="True"
                    Content="{Binding Common_Cancel, Source={x:Static strings:Strings.Instance}}"/>
            <Button x:Name="SaveButton" Style="{StaticResource DialogPrimaryButton}" IsDefault="True" Click="SaveButton_Click"
                    Content="{Binding Common_Save, Source={x:Static strings:Strings.Instance}}"/>
        </controls:FlexLinePanel>
    </views:DialogWindow.Foot>

    <Grid common:InitialFocus.First="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- The screen as it will look, at its own shape in the board's 300
             by 190 box. The code sizes the picture to fit with 6 of the box
             showing at its nearest sides. -->
        <Border x:Name="PreviewFrame" Width="300" Height="190" HorizontalAlignment="Left" VerticalAlignment="Top"
                CornerRadius="8" Background="#FF000000" BorderBrush="{DynamicResource SteelPillLineBrush}" BorderThickness="1">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="PreviewImage" FlowDirection="LeftToRight" Stretch="Uniform"
                       AutomationProperties.Name="{Binding Pad_Tab_Preview, Source={x:Static strings:Strings.Instance}}"/>
                <!-- The Screen Overlay, drawn as its window draws it. -->
                <views:ScreenOverlayContentView x:Name="OverlayPreview" Visibility="Collapsed"
                                                AutomationProperties.Name="{Binding Pad_Tab_Preview, Source={x:Static strings:Strings.Instance}}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Column="2">
            <!-- The picker is as wide as its longest choice, and no wider
                 than the row has room for. -->
            <controls:SettingRow MinHeight="44">
                <TextBlock Style="{StaticResource ScreenLabel}"
                           Text="{Binding DreamcastScreen_Mode_Label, Source={x:Static strings:Strings.Instance}}"/>
                <ComboBox x:Name="ModeBox" Style="{StaticResource DialogSelect}" MaxWidth="200" DisplayMemberPath="Name"
                          common:ComboBoxWidthBehavior.SizeToItems="True" SelectionChanged="ModeBox_SelectionChanged"
                          AutomationProperties.Name="{Binding DreamcastScreen_Mode_Label, Source={x:Static strings:Strings.Instance}}"/>
                <reset:SettingResetButton Click="ResetMode_Click" Tag="" Visibility="{Binding Visibility, ElementName=ModeBox}" IsEnabled="{Binding IsEnabled, ElementName=ModeBox}" SettingLabel="{Binding DreamcastScreen_Mode_Label, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_?dialog_KeyboardScreenModeBox_13110"/>
            </controls:SettingRow>
            <TextBlock x:Name="HintText" Style="{StaticResource DialogNote}" Margin="0,4,0,8"/>

            <controls:SettingRow x:Name="PictureRow" MinHeight="44" Visibility="Collapsed">
                <Button x:Name="ChoosePictureButton" Style="{StaticResource DialogButton}"
                        Content="{Binding DreamcastScreen_ChoosePicture, Source={x:Static strings:Strings.Instance}}"
                        Click="ChoosePicture_Click"/>
                <reset:SettingResetButton Click="ResetPicture_Click" Visibility="{Binding Visibility, ElementName=ChoosePictureButton}" SettingLabel="{Binding DreamcastScreen_Mode_Picture, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_?dialog_KeyboardScreenPicture_13111"/>
            </controls:SettingRow>
            <!-- The active profile's own picture. Its button names the
                 profile, in words the code sets. -->
            <StackPanel x:Name="ProfilePicturePanel" Visibility="Collapsed">
                <Button x:Name="ChooseProfilePictureButton" Style="{StaticResource DialogButton}" HorizontalAlignment="Left"
                        MaxWidth="330" Margin="0,4,0,4" Click="ChooseProfilePicture_Click"/>
                <Button x:Name="RemoveProfilePictureButton" Style="{StaticResource DialogButton}" HorizontalAlignment="Left"
                        Margin="0,4,0,4" Click="RemoveProfilePicture_Click"
                        Content="{Binding DreamcastScreen_RemoveProfilePicture, Source={x:Static strings:Strings.Instance}}"/>
            </StackPanel>

            <!-- Which slot's lightbar the Screen Overlay follows. A keyboard
                 screen follows the slots its Devices row feeds, and an
                 overlay has no row. -->
            <controls:SettingRow x:Name="LightbarSlotRow" MinHeight="44" Visibility="Collapsed">
                <TextBlock Style="{StaticResource ScreenLabel}"
                           Text="{Binding Dashboard_Slot, Source={x:Static strings:Strings.Instance}}"/>
                <ComboBox x:Name="LightbarSlotBox" Style="{StaticResource DialogSelect}" MaxWidth="200" DisplayMemberPath="Name"
                          common:ComboBoxWidthBehavior.SizeToItems="True" SelectionChanged="LightbarSlotBox_SelectionChanged"
                          AutomationProperties.AutomationId="ScreenOverlay_LightbarSlotBox"
                          AutomationProperties.Name="{Binding Dashboard_Slot, Source={x:Static strings:Strings.Instance}}"/>
                <reset:SettingResetButton Click="ResetLightbarSlot_Click" SettingLabel="{Binding Dashboard_Slot, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_?dialog_KeyboardScreenLightbarSlot_55711"/>
            </controls:SettingRow>
            <!-- The zoom makes an overlay's picture larger than its window. -->
            <controls:SettingRow x:Name="ZoomRow" MinHeight="44" Visibility="Collapsed">
                <TextBlock Style="{StaticResource ScreenLabel}"
                           Text="{Binding KeyboardScreen_Zoom_Label, Source={x:Static strings:Strings.Instance}}"/>
                <ui:TextBox x:Name="ZoomBox" Style="{StaticResource ScreenNumber}" LostFocus="ZoomBox_LostFocus"
                            AutomationProperties.AutomationId="ScreenOverlay_ZoomBox"
                            AutomationProperties.Name="{Binding KeyboardScreen_Zoom_Label, Source={x:Static strings:Strings.Instance}}"/>
                <TextBlock Style="{StaticResource DialogUnit}" Margin="6,0,0,0" Text="%"/>
                <reset:SettingResetButton Click="ResetZoom_Click" SettingLabel="{Binding KeyboardScreen_Zoom_Label, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_?dialog_KeyboardScreenZoom_55710"/>
            </controls:SettingRow>
            <!-- Where the screen's window sits on a picture larger than the
                 screen, in the picture's pixels. The Pan macro moves it too. -->
            <controls:SettingRow x:Name="PanRow" MinHeight="44" Visibility="Collapsed">
                <!-- The X stands at the end of the label's column, so the
                     first box starts where the rows above start theirs. -->
                <TextBlock Style="{StaticResource ScreenLabel}" Width="75"
                           Text="{Binding KeyboardScreen_Pan_Label, Source={x:Static strings:Strings.Instance}}"/>
                <TextBlock VerticalAlignment="Center" Width="9" Margin="0,0,6,0" TextAlignment="Right" Text="X"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                <ui:TextBox x:Name="PanXBox" Style="{StaticResource ScreenNumber}" LostFocus="PanBox_LostFocus"
                            AutomationProperties.Name="{Binding KeyboardScreen_PanX, Source={x:Static strings:Strings.Instance}}"/>
                <TextBlock VerticalAlignment="Center" Margin="12,0,6,0" Text="Y"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                <ui:TextBox x:Name="PanYBox" Style="{StaticResource ScreenNumber}" LostFocus="PanBox_LostFocus"
                            AutomationProperties.Name="{Binding KeyboardScreen_PanY, Source={x:Static strings:Strings.Instance}}"/>
                <reset:SettingResetButton Click="ResetPan_Click" SettingLabel="{Binding KeyboardScreen_Pan_Label, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_?dialog_KeyboardScreenPan_13112"/>
            </controls:SettingRow>
        </StackPanel>
    </Grid>
</views:DialogWindow>
