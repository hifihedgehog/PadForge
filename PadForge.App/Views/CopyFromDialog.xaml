<views:DialogWindow AutomationProperties.IsDialog="True" x:Class="PadForge.Views.CopyFromDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        xmlns:common="clr-namespace:PadForge.Common"
        xmlns:controls="clr-namespace:PadForge.Controls"
        xmlns:views="clr-namespace:PadForge.Views"
        BodyPadding="22,14,22,18"
        Title="{Binding CopyFrom_Title, Source={x:Static strings:Strings.Instance}}">

    <!-- Copy From (#574), as the Confirm board draws it: the line under the
         title says what is replaced or added on which controller, and each
         row is a controller to copy from, named as its page names it over
         the device that drives it. The first row is picked on open, and a
         double click copies at once. -->
    <views:DialogWindow.Resources>
        <!-- A row is read by its two lines: with a template of its own it
             would be read as its type. -->
        <Style x:Key="CopyFromRow" TargetType="ListBoxItem" BasedOn="{StaticResource DialogRadioListItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding ReadName, TargetNullValue=''}"/>
        </Style>
    </views:DialogWindow.Resources>

    <views:DialogWindow.Foot>
        <controls:FlexLinePanel Style="{StaticResource DialogFootPanel}">
            <Button Style="{StaticResource DialogButton}" IsCancel="True" Click="CancelButton_Click"
                    Content="{Binding Common_Cancel, Source={x:Static strings:Strings.Instance}}"/>
            <Button x:Name="CopyButton" Style="{StaticResource DialogPrimaryButton}" IsDefault="True" Click="OkButton_Click"
                    Content="{Binding Common_Copy, Source={x:Static strings:Strings.Instance}}"/>
        </controls:FlexLinePanel>
    </views:DialogWindow.Foot>

    <Border Style="{StaticResource DialogList}" common:InitialFocus.First="True">
        <ListBox x:Name="DeviceList" Style="{StaticResource DialogListBox}" MaxHeight="322" SelectionMode="Single"
                 ItemContainerStyle="{StaticResource CopyFromRow}"
                 MouseDoubleClick="DeviceList_MouseDoubleClick"
                 AutomationProperties.Name="{Binding CopyFrom_Title, Source={x:Static strings:Strings.Instance}}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" FontSize="13" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Detail}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Border>
</views:DialogWindow>
