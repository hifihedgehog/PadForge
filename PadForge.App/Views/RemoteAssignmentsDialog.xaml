<ui:FluentWindow x:Class="PadForge.Views.RemoteAssignmentsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:strings="clr-namespace:PadForge.Resources.Strings"
    Width="620" MinWidth="480" Height="500" MinHeight="360"
    WindowStartupLocation="CenterOwner" WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border x:Name="DialogHeader" Padding="14" Background="Transparent"
                BorderBrush="{DynamicResource SteelLineSoftBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5"
                           Fill="{DynamicResource EmberBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="DialogTitleText" Grid.Column="1"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontFamily="{DynamicResource DisplayFontFamily}" FontWeight="SemiBold" FontSize="15"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
                <ui:Button x:Name="HeaderCloseButton" Grid.Column="2"
                           Style="{DynamicResource EmberIconButton}" VerticalAlignment="Center"
                           Click="CloseClicked" ToolTip="{Binding Common_Close, Source={x:Static strings:Strings.Instance}}">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </ui:Button>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding RemoteLink_AssignmentDescription, Source={x:Static strings:Strings.Instance}}"
                       TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <ComboBox x:Name="DevicesBox" Grid.Row="1" DisplayMemberPath="Name"
                      HorizontalAlignment="Stretch" SelectionChanged="DeviceChanged"/>
            <TextBlock x:Name="ProfileText" Grid.Row="2" Margin="0,12,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,8,0,8" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="SlotsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding Assigned, Mode=OneWay}"
                                      IsEnabled="{Binding Enabled}" Margin="0,8,0,0" Click="AssignmentClicked"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="RefreshButton" Content="{Binding Common_Refresh, Source={x:Static strings:Strings.Instance}}"
                        Click="RefreshClicked" Margin="0,0,8,0" MinWidth="90"/>
                <Button Content="{Binding Common_Close, Source={x:Static strings:Strings.Instance}}"
                        Click="CloseClicked" MinWidth="90"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
