<ui:FluentWindow x:Class="PadForge.Views.BlissBoxPlayerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Width="440" SizeToContent="Height"
        MinHeight="170"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <!-- A Bliss-Box port's player number (issue #469), the confirm dialog's
         chrome with the number to choose above its footer. -->
    <Grid Margin="20,18,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5"
                       Fill="{DynamicResource EmberBrush}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock FontFamily="{StaticResource DisplayFontFamily}"
                       FontWeight="SemiBold" FontSize="15"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       VerticalAlignment="Center"
                       Text="{Binding BlissBoxPlayer_Title, Source={x:Static strings:Strings.Instance}}"/>
        </StackPanel>

        <TextBlock Grid.Row="1" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{Binding BlissBoxPlayer_Message, Source={x:Static strings:Strings.Instance}}"/>

        <TextBlock Grid.Row="2" x:Name="DetailText" Margin="0,8,0,0" TextWrapping="Wrap"
                   FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12"
                   Foreground="{DynamicResource ColdBrush}"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding BlissBoxPlayer_Label, Source={x:Static strings:Strings.Instance}}"/>
            <ComboBox x:Name="PlayerBox" MinWidth="80">
                <ComboBoxItem Content="1" Tag="1"/>
                <ComboBoxItem Content="2" Tag="2"/>
                <ComboBoxItem Content="3" Tag="3"/>
                <ComboBoxItem Content="4" Tag="4"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" MinWidth="90" Margin="0,0,8,0"
                    Content="{Binding Common_Cancel, Source={x:Static strings:Strings.Instance}}"
                    IsCancel="True" IsDefault="True"/>
            <Button x:Name="ActionButton" MinWidth="90"
                    Style="{StaticResource EmberDestructiveButton}"
                    Content="{Binding BlissBoxPlayer_Action, Source={x:Static strings:Strings.Instance}}"
                    Click="ActionButton_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
