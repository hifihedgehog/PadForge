                                                </controls:SettingRow>
                                                <controls:SettingRow MinHeight="44">
                                                    <TextBlock Text="{Binding Pad_SteeringAngleRumble_Deadzone, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzSubLabel}"/>
