                    <GroupBox x:Name="TabBassShakers" Visibility="{Binding RumbleAudioTabVisible, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource BareGroupBox}"
                              AutomationProperties.AutomationId="BassShakersTab"
                              AutomationProperties.Name="{Binding Pad_RumbleAudio_Header, Source={x:Static strings:Strings.Instance}}">
                    <StackPanel>

                        <!-- Bass Shakers: the switch that routes rumble to an audio
                             output, with what that does in a line beside it, and
                             the rest under More. Which controllers it works with
                             is the title's tooltip, through BidiText: its
                             brackets broke in a right-to-left language. -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                    <controls:GlyphText Text="&#xE7F5;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_RumbleAudio_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"
                                               common:BidiText.ToolTip="{Binding Pad_RumbleAudio_Card_Desc, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Command="{Binding ResetRumbleAudioAllCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}"
                                            ToolTip="{Binding Pad_RumbleAudio_ResetCard_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                </DockPanel>

                                <!-- Enable row. First enable authors the config with the
                                     four default voices. Disable keeps every setting. -->
                                <controls:SettingRow MinHeight="44">
                                    <TextBlock Text="{Binding Pad_RumbleAudio_Enable, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <CheckBox Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding RumbleAudioEnabled, Mode=TwoWay}"
                                              Content="{Binding Pad_RumbleAudio_Enable, Source={x:Static strings:Strings.Instance}}"
                                              ToolTip="{Binding Pad_RumbleAudio_Enable_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBlock controls:SettingRow.Fills="True"
                                               Text="{Binding Pad_RumbleAudio_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                               FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,6,12,6"/>
                                    <ui:Button Command="{Binding ResetRumbleAudioEnabledCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_RumbleAudio_ResetEnable, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <!-- More (#574): the settings fewer people change, opened in place. -->
                                <controls:MoreRow x:Name="BassShakersMore" StateKey="Pad.Rumble.BassShakers.More"
                                                  AutomationProperties.AutomationId="Pad_More_BassShakers"
                                                  Header="{Binding Common_More, Source={x:Static strings:Strings.Instance}}"
                                                  Hint="{Binding Pad_More_BassShakers, Source={x:Static strings:Strings.Instance}}">
                                    <StackPanel>
                                <StackPanel>
                                    <!-- Output Device row. "" = system default. A configured
                                         endpoint that disappears FAILS CLOSED (status line
                                         below warns, selection is preserved). -->
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Text="{Binding Pad_RumbleAudio_OutputDevice, Source={x:Static strings:Strings.Instance}}"
                                                   Style="{StaticResource DzLabel}"
                                                   ToolTip="{Binding Pad_RumbleAudio_OutputDevice_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <!-- SelectedValuePath/DisplayMemberPath MUST precede the
                                             ItemsSource/SelectedValue bindings: XAML applies
                                             attributes in order, and a SelectedValue that attaches
                                             before SelectedValuePath is set fails to resolve and
                                             never retries (the mirror-source picker documents it). -->
                                        <ComboBox SelectedValuePath="Id" DisplayMemberPath="Name"
                                                  ItemsSource="{Binding RumbleAudioEndpointOptions}"
                                                  SelectedValue="{Binding RumbleAudioEndpointId, Mode=TwoWay}"
                                                  MinWidth="260" MaxWidth="380"
                                                  DropDownOpened="RumbleAudioEndpoint_DropDownOpened"
                                                  ToolTip="{Binding Pad_RumbleAudio_OutputDevice_Tooltip, Source={x:Static strings:Strings.Instance}}" IsEnabled="{Binding DataContext.RumbleAudioEnabled, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                                        <ui:Button Command="{Binding ResetRumbleAudioEndpointCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_RumbleAudio_ResetOutputDevice, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                    <!-- Live endpoint status, driven by the code-behind meter
                                         timer from RumbleAudioService.GetSlotStatus. -->
                                    <TextBlock x:Name="BassShakerStatusText" FontSize="12" TextWrapping="Wrap"
                                               Margin="242,0,0,2"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Pad_RumbleAudio_BluetoothHint, Source={x:Static strings:Strings.Instance}}"
                                               FontSize="12" TextWrapping="Wrap" Margin="242,0,0,8"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>

                                    <!-- Channel Mode row -->
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Text="{Binding Pad_RumbleAudio_ChannelMode, Source={x:Static strings:Strings.Instance}}"
                                                   Style="{StaticResource DzLabel}"
                                                   ToolTip="{Binding Pad_RumbleAudio_ChannelMode_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBox SelectedValuePath="Tag"
                                                  SelectedValue="{Binding RumbleAudioChannelMode, Mode=TwoWay}"
                                                  MinWidth="260"
                                                  ToolTip="{Binding Pad_RumbleAudio_ChannelMode_Tooltip, Source={x:Static strings:Strings.Instance}}" IsEnabled="{Binding DataContext.RumbleAudioEnabled, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                            <ComboBoxItem Content="{Binding Pad_RumbleAudio_Mode_Mono, Source={x:Static strings:Strings.Instance}}" Tag=""/>
                                            <ComboBoxItem Content="{Binding Pad_RumbleAudio_Mode_Stereo, Source={x:Static strings:Strings.Instance}}" Tag="Stereo"/>
                                        </ComboBox>
                                        <ui:Button Command="{Binding ResetRumbleAudioChannelModeCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_RumbleAudio_ResetChannelMode, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>

                                    <!-- Master Gain row -->
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Text="{Binding Pad_RumbleAudio_MasterGain, Source={x:Static strings:Strings.Instance}}"
                                                   Style="{StaticResource DzLabel}"
                                                   ToolTip="{Binding Pad_RumbleAudio_MasterGain_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <Slider Value="{Binding RumbleAudioMasterGain, Mode=TwoWay}" Minimum="0" Maximum="100"
                                                Style="{StaticResource DzSlider}" TickFrequency="1" IsEnabled="{Binding DataContext.RumbleAudioEnabled, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                                        <TextBox Text="{Binding RumbleAudioMasterGain, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource DzValueEdit}" IsEnabled="{Binding DataContext.RumbleAudioEnabled, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                                        <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding ResetRumbleAudioMasterGainCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_RumbleAudio_ResetMasterGain, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>

                                    <!-- The four fixed voice rows (low, high, trigger left,
                                         trigger right): enable + carrier frequency + gain +
                                         live meter + per-row Test and Reset. -->
                                    <ItemsControl ItemsSource="{Binding RumbleAudioVoices}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <controls:SettingRow MinHeight="44">
                                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                              Content="{Binding Label}"
                                                              Width="242" VerticalAlignment="Center"
                                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                              ToolTip="{Binding Pad_RumbleAudio_VoiceEnable_Tooltip, Source={x:Static strings:Strings.Instance}}" IsEnabled="{Binding DataContext.RumbleAudioEnabled, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                                                    <Slider Value="{Binding FrequencyHz, Mode=TwoWay}" Minimum="20" Maximum="120"
                                                            Style="{StaticResource EmberSlider}"
                                                            Width="140" VerticalAlignment="Center"
                                                            IsSnapToTickEnabled="True" TickFrequency="1"
                                                            ToolTip="{Binding Pad_RumbleAudio_Frequency_Tooltip, Source={x:Static strings:Strings.Instance}}" IsEnabled="{Binding DataContext.RumbleAudioEnabled, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                                                    <TextBox Text="{Binding FrequencyHz, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             Style="{StaticResource DzValueEdit}"
                                                             ToolTip="{Binding Pad_RumbleAudio_Frequency_Tooltip, Source={x:Static strings:Strings.Instance}}" IsEnabled="{Binding DataContext.RumbleAudioEnabled, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                                                    <TextBlock Text="Hz" Style="{StaticResource DzPercent}"/>
                                                    <Slider Value="{Binding GainPercent, Mode=TwoWay}" Minimum="0" Maximum="100"
                                                            Style="{StaticResource EmberSlider}"
                                                            Width="140" VerticalAlignment="Center" Margin="12,0,0,0"
                                                            IsSnapToTickEnabled="True" TickFrequency="1"
                                                            ToolTip="{Binding Pad_RumbleAudio_Gain_Tooltip, Source={x:Static strings:Strings.Instance}}" IsEnabled="{Binding DataContext.RumbleAudioEnabled, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                                                    <TextBox Text="{Binding GainPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             Style="{StaticResource DzValueEdit}"
                                                             ToolTip="{Binding Pad_RumbleAudio_Gain_Tooltip, Source={x:Static strings:Strings.Instance}}" IsEnabled="{Binding DataContext.RumbleAudioEnabled, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                    <ProgressBar Value="{Binding MeterLevel, Mode=OneWay}"
                                                                 Minimum="0" Maximum="100"
                                                                 Width="80" Height="8" VerticalAlignment="Center" Margin="12,0,0,0"
                                                                 Foreground="{DynamicResource EmberHotBrush}"/>
                                                    <Button Content="{Binding Pad_RumbleAudio_Test, Source={x:Static strings:Strings.Instance}}"
                                                            Command="{Binding TestCommand}" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                                            ToolTip="{Binding Pad_RumbleAudio_Test_Tooltip, Source={x:Static strings:Strings.Instance}}" IsEnabled="{Binding DataContext.RumbleAudioEnabled, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                                                    <ui:Button Command="{Binding ResetCommand}" Style="{StaticResource ResetButton}"
                                                            ToolTip="{Binding ResetTooltip}"/>
                                                </controls:SettingRow>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Test buttons row -->
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="{Binding Pad_RumbleAudio_Sweep, Source={x:Static strings:Strings.Instance}}"
                                                Command="{Binding RumbleAudioSweepCommand}" Padding="10,4" VerticalAlignment="Center"
                                                ToolTip="{Binding Pad_RumbleAudio_Sweep_Tooltip, Source={x:Static strings:Strings.Instance}}" IsEnabled="{Binding DataContext.RumbleAudioEnabled, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                                        <Button Content="{Binding Pad_RumbleAudio_StopTest, Source={x:Static strings:Strings.Instance}}"
                                                Command="{Binding RumbleAudioStopTestCommand}" Padding="10,4" Margin="6,0,0,0" VerticalAlignment="Center"
                                                ToolTip="{Binding Pad_RumbleAudio_StopTest_Tooltip, Source={x:Static strings:Strings.Instance}}" IsEnabled="{Binding DataContext.RumbleAudioEnabled, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                                    </StackPanel>
                                </StackPanel>
                                    </StackPanel>
                                </controls:MoreRow>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ SECTION 3: Motion & Touch ═══
                 Gyro, touchpad and pointer. -->
            <TabItem>
                <ScrollViewer x:Name="MotionSectionScroll" AutomationProperties.Name="{Binding Pad_Section_Motion, Source={x:Static strings:Strings.Instance}}" Padding="32,0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <!-- This section's rows, as its board draws them (#574): a label
                             column 170 wide, a slider that takes the room its row has
                             (each row here grows it), and the value with its unit at the
                             right of a column 66 wide (each row here sets that), so the
                             sliders of a card end at one line. Cards stand 12 apart.
                             These shadow the page's styles for everything in this
                             section. -->
                        <Style x:Key="DzLabel" TargetType="TextBlock">
                            <Setter Property="Width" Value="170"/>
                            <Setter Property="Margin" Value="0,0,12,0"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </Style>
                        <Style x:Key="DzSubLabel" TargetType="TextBlock" BasedOn="{StaticResource DzLabel}">
                            <Setter Property="Width" Value="154"/>
                            <Setter Property="Margin" Value="16,0,12,0"/>
                            <Setter Property="Foreground" Value="{DynamicResource SubRowTextBrush}"/>
                        </Style>
                        <Style x:Key="DzSlider" TargetType="Slider" BasedOn="{StaticResource EmberSlider}">
                            <Setter Property="Minimum" Value="0"/>
                            <Setter Property="Maximum" Value="100"/>
                            <Setter Property="MinWidth" Value="60"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="IsSnapToTickEnabled" Value="True"/>
                            <Setter Property="TickFrequency" Value="0.1"/>
                        </Style>
                        <!-- A reading that changes many times a second. -->
                        <Style x:Key="LiveReading" TargetType="TextBlock">
                            <Setter Property="Width" Value="120"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Foreground" Value="{DynamicResource ColdBrush}"/>
                        </Style>
                        <!-- A slider's value where it is read and not typed: the
                             value box's face, size and inset. -->
                        <Style x:Key="DzValueText" TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="12,0,0,0"/>
                        </Style>
                        <Style x:Key="CardBorder" TargetType="Border" BasedOn="{StaticResource CardBorder}">
                            <Setter Property="Margin" Value="0,0,0,12"/>
                        </Style>
                    </ScrollViewer.Resources>
                    <!-- The groups side by side while each has 420 to itself,
                         one under the other when the window is narrower, as
                         the board wraps them. The groups of a row share the
                         whole width, so two stand at half of it each and a
                         controller with one group gives it all of it. -->
                    <controls:TileGridPanel MinItemWidth="420" Gap="16" RowGap="24" FillRows="True" Margin="0,24,0,24">

            <!-- The groups below were tabs of the page and keep that
                 indentation. -->
            <!-- ══════════════════════════════════════
                 TAB 8: GYRO
                 (visible when the selected mapped device has a gyroscope or an accelerometer)
                 ══════════════════════════════════════ -->
                    <GroupBox x:Name="TabGyro" Visibility="Collapsed" Style="{StaticResource BareGroupBox}"
                              AutomationProperties.Name="{Binding Pad_Gyro_Header, Source={x:Static strings:Strings.Instance}}">
                    <StackPanel>
                        <TextBlock AutomationProperties.AutomationId="TabGyro" Text="{Binding Pad_Gyro_Header, Source={x:Static strings:Strings.Instance}}"
                                   Style="{StaticResource SectionTitle}" Margin="0,0,0,12" HorizontalAlignment="Left"
                                   ToolTip="{Binding Pad_Gyro_Subtitle, Source={x:Static strings:Strings.Instance}}"/>

                        <!-- ─── Calibration card ─── -->
                        <Border x:Name="GyroCalibrationCard" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Pad_Gyro_Calibration_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding ResetGyroCalibrationCardCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_Gyro_ResetCalibration_All_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                </DockPanel>
                                <!-- Calibrate, the way back, and when it was last done, on one
                                     line that wraps (#574). -->
                                <WrapPanel MinHeight="44">
                                    <Button Content="{Binding Settings_GyroCalibrate_Button, Source={x:Static strings:Strings.Instance}}"
                                            Command="{Binding GyroCalibrateCommand}"
                                            MinHeight="36" Padding="14,0" Margin="0,4,10,4" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroCalibrate_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Content="{Binding Settings_GyroResetCalibration_Button, Source={x:Static strings:Strings.Instance}}"
                                            Command="{Binding GyroResetCalibrationCommand}"
                                            Style="{StaticResource ResetAllButton}" MinHeight="36" Padding="14,0" FontSize="14"
                                            Margin="0,4,10,4" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroResetCalibration_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBlock Text="{Binding GyroCalibrationLabel}"
                                               FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,4" VerticalAlignment="Center"/>
                                </WrapPanel>
                                <!-- More (#574): the live readings, to watch the drift settle.
                                     The gyro's calibrated rate in degrees a second and the
                                     accelerometer in g, in the cold telemetry color. Each reading
                                     has a width that holds its longest value, so a changing digit
                                     moves nothing. -->
                                <controls:MoreRow x:Name="GyroCalibrationMore" StateKey="Pad.Motion.Calibration.More"
                                                  AutomationProperties.AutomationId="Pad_More_GyroCalibration"
                                                  Header="{Binding Common_More, Source={x:Static strings:Strings.Instance}}"
                                                  Hint="{Binding Settings_GyroLiveRate_Label, Source={x:Static strings:Strings.Instance}}">
                                    <StackPanel>
                                        <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                            <TextBlock Text="{Binding Settings_GyroLiveRate_Label, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                            <WrapPanel controls:SettingRow.Fills="True" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GyroLiveRatePitch, StringFormat={}Pitch {0:+0.0;-0.0;0.0}°/s}" Style="{StaticResource LiveReading}"/>
                                                <TextBlock Text="{Binding GyroLiveRateYaw, StringFormat={}Yaw {0:+0.0;-0.0;0.0}°/s}" Style="{StaticResource LiveReading}"/>
                                                <TextBlock Text="{Binding GyroLiveRateRoll, StringFormat={}Roll {0:+0.0;-0.0;0.0}°/s}" Style="{StaticResource LiveReading}"/>
                                            </WrapPanel>
                                        </controls:SettingRow>
                                        <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                            <TextBlock Text="{Binding Settings_GyroLiveAccel_Label, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                            <WrapPanel controls:SettingRow.Fills="True" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AccelLiveX, StringFormat={}X {0:+0.00;-0.00;0.00}g}" Style="{StaticResource LiveReading}"/>
                                                <TextBlock Text="{Binding AccelLiveY, StringFormat={}Y {0:+0.00;-0.00;0.00}g}" Style="{StaticResource LiveReading}"/>
                                                <TextBlock Text="{Binding AccelLiveZ, StringFormat={}Z {0:+0.00;-0.00;0.00}g}" Style="{StaticResource LiveReading}"/>
                                            </WrapPanel>
                                        </controls:SettingRow>
                                    </StackPanel>
                                </controls:MoreRow>
                            </StackPanel>
                        </Border>

                        <!-- ─── Sensitivity card ─── -->
                        <Border x:Name="GyroSensitivityCard" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Pad_Gyro_Sensitivity_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding ResetGyroSensitivityCardCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_Gyro_ResetSensitivity_All_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                </DockPanel>

                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Settings_GyroSensitivityH, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Settings_GyroSensitivityH_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding GyroSensitivityH, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="0.1" Maximum="10" SmallChange="0.1" LargeChange="1"
                                            MinWidth="60" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroSensitivityH_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding GyroSensitivityH, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="×" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetGyroSensitivityHCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroSensitivityH, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBlock Text="{Binding GyroSensitivityH_DegPerTurn, StringFormat={}≈ {0:0}°/turn}"
                                               FontFamily="{StaticResource TelemetryFontFamily}"
                                               VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                                </controls:SettingRow>

                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Settings_GyroSensitivityV, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Settings_GyroSensitivityV_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding GyroSensitivityV, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="0.1" Maximum="10" SmallChange="0.1" LargeChange="1"
                                            MinWidth="60" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroSensitivityV_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding GyroSensitivityV, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="×" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetGyroSensitivityVCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroSensitivityV, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBlock Text="{Binding GyroSensitivityV_DegPerTurn, StringFormat={}≈ {0:0}°/turn}"
                                               FontFamily="{StaticResource TelemetryFontFamily}"
                                               VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                                </controls:SettingRow>

                                <!-- More (#574): the settings fewer people change, opened in place. -->
                                <controls:MoreRow x:Name="GyroSensitivityMore" StateKey="Pad.Motion.Sensitivity.More"
                                                  AutomationProperties.AutomationId="Pad_More_GyroSensitivity"
                                                  Header="{Binding Common_More, Source={x:Static strings:Strings.Instance}}"
                                                  Hint="{Binding Pad_More_GyroSensitivity, Source={x:Static strings:Strings.Instance}}">
                                    <StackPanel>
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Settings_GyroSensitivityUnits, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Settings_GyroSensitivityUnits_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBox ItemsSource="{Binding GyroSensitivityUnitsOptions}"
                                              SelectedValue="{Binding GyroSensitivityUnits, Mode=TwoWay}"
                                              SelectedValuePath="Value" DisplayMemberPath="Display"
                                              MaxWidth="200" controls:SettingRow.Fills="True" VerticalAlignment="Center"
                                              ToolTip="{Binding Settings_GyroSensitivityUnits_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Command="{Binding ResetGyroSensitivityUnitsCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroSensitivityUnits, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <!-- Player/World Space. Jibb's recommended default
                                     is Player Space. We keep Local as the conservative default
                                     so existing configs feel identical. -->
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Settings_GyroSpace, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Settings_GyroSpace_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBox ItemsSource="{Binding GyroSpaceOptions}"
                                              SelectedValue="{Binding GyroSpace, Mode=TwoWay}"
                                              SelectedValuePath="Value" DisplayMemberPath="Display"
                                              MaxWidth="200" controls:SettingRow.Fills="True" VerticalAlignment="Center"
                                              ToolTip="{Binding Settings_GyroSpace_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Command="{Binding ResetGyroSpaceCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroSpace, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <!-- Per-axis invert toggles. Independent from per-source
                                     Invert flags on the mapping table. Steam-style top-level
                                     convenience. -->
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Settings_GyroInvertPitch, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <CheckBox Style="{StaticResource SwitchCheckBox}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Settings_GyroInvertPitch, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding GyroInvertPitch, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              ToolTip="{Binding Settings_GyroInvertPitch_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Command="{Binding ResetGyroInvertPitchCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroInvertPitch, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Settings_GyroInvertYaw, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <CheckBox Style="{StaticResource SwitchCheckBox}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Settings_GyroInvertYaw, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding GyroInvertYaw, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              ToolTip="{Binding Settings_GyroInvertYaw_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Command="{Binding ResetGyroInvertYawCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroInvertYaw, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Settings_GyroInvertRoll, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <CheckBox Style="{StaticResource SwitchCheckBox}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Settings_GyroInvertRoll, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding GyroInvertRoll, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              ToolTip="{Binding Settings_GyroInvertRoll_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Command="{Binding ResetGyroInvertRollCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroInvertRoll, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <!-- Real-world calibration. 0 = disabled. -->
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Settings_GyroRealWorldCalibration, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Settings_GyroRealWorldCalibration_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding GyroRealWorldCalibration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="0" Maximum="2" SmallChange="0.01" LargeChange="0.1"
                                            MinWidth="60" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroRealWorldCalibration_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding GyroRealWorldCalibration, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="×" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetGyroRealWorldCalibrationCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroRealWorldCalibration, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>
                                    </StackPanel>
                                </controls:MoreRow>
                            </StackPanel>
                        </Border>

                        <controls:FoldList Gap="12">
                        <!-- ─── Grip (#392) ─── -->
                        <!-- How the controller is held. Pointing is the frame the
                             driver delivers. Sideways (face up), Wii Wheel (face
                             toward the player), and Upright rotate the body gyro,
                             accelerometer, and gravity together, so a Wii Remote
                             held like a wheel reads as a flat pad to mappings and
                             to the virtual controller's motion. Shown
                             for any motion device, gyro or accelerometer alone.
                             Its line ends with the grip that is set. -->
                        <controls:FoldCard x:Name="GyroGripCard" StateKey="Pad.Motion.Grip"
                                           Header="{Binding Pad_Gyro_Grip_Header, Source={x:Static strings:Strings.Instance}}"
                                           Hint="{Binding Pad_Gyro_Grip_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                           Description="{Binding Pad_Gyro_Grip_Subtitle, Source={x:Static strings:Strings.Instance}}">
                            <controls:FoldCard.Summary>
                                <MultiBinding Converter="{StaticResource OptionTextConverter}">
                                    <Binding Path="MotionGrip"/>
                                    <Binding Path="MotionGripOptions"/>
                                    <Binding Path="Pad_Gyro_Grip_Header" Source="{x:Static strings:Strings.Instance}"/>
                                </MultiBinding>
                            </controls:FoldCard.Summary>
                            <StackPanel>
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Settings_MotionGrip, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Settings_MotionGrip_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBox ItemsSource="{Binding MotionGripOptions}"
                                              SelectedValue="{Binding MotionGrip, Mode=TwoWay}"
                                              SelectedValuePath="Value" DisplayMemberPath="Display"
                                              MaxWidth="260" controls:SettingRow.Fills="True" VerticalAlignment="Center"
                                              ToolTip="{Binding Settings_MotionGrip_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Command="{Binding ResetMotionGripCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetMotionGrip, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>
                            </StackPanel>
                        </controls:FoldCard>

                        <!-- ─── Engage card ─── -->
                        <controls:FoldCard x:Name="GyroEngageCard" StateKey="Pad.Motion.Engage"
                                           Header="{Binding Pad_Gyro_Engage_Header, Source={x:Static strings:Strings.Instance}}"
                                           Hint="{Binding Pad_GyroEngage_FoldHint, Source={x:Static strings:Strings.Instance}}"
                                           Description="{Binding Pad_Gyro_Engage_Subtitle, Source={x:Static strings:Strings.Instance}}">
                            <controls:FoldCard.HeaderAction>
                                <ui:Button Command="{Binding ResetGyroEngageCardCommand}" Style="{StaticResource ResetAllButton}"
                                        Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}"
                                        ToolTip="{Binding Pad_Gyro_ResetEngage_All_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:FoldCard.HeaderAction>
                            <StackPanel>
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Settings_GyroEasyAimThreshold, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Settings_GyroEasyAimThreshold_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding GyroEasyAimStickThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                                            MinWidth="60" VerticalAlignment="Center" TickFrequency="5"
                                            ToolTip="{Binding Settings_GyroEasyAimThreshold_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding GyroEasyAimStickThreshold, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetGyroEasyAimStickThresholdCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroEasyAimThreshold, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <!-- Engage stick side (#120). Which stick's
                                     deflection the threshold above gates on.
                                     Right (default) preserves existing profiles.
                                     Either gates on the larger of the two sticks. -->
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Settings_GyroEngageStickSide, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Settings_GyroEngageStickSide_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBox SelectedValue="{Binding GyroEngageStickSide, Mode=TwoWay}"
                                              SelectedValuePath="Tag"
                                              MaxWidth="260" controls:SettingRow.Fills="True" VerticalAlignment="Center"
                                              ToolTip="{Binding Settings_GyroEngageStickSide_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                        <ComboBoxItem Content="{Binding Settings_GyroEngageStickSide_Right, Source={x:Static strings:Strings.Instance}}" Tag="Right"/>
                                        <ComboBoxItem Content="{Binding Settings_GyroEngageStickSide_Left, Source={x:Static strings:Strings.Instance}}" Tag="Left"/>
                                        <ComboBoxItem Content="{Binding Settings_GyroEngageStickSide_Either, Source={x:Static strings:Strings.Instance}}" Tag="Either"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding ResetGyroEngageStickSideCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroEngageStickSide, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <!-- Engage stick direction (#120). Which
                                     component of the stick(s) above the
                                     threshold gates on. Full (default,
                                     radial) preserves existing profiles. -->
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Settings_GyroEngageStickDirection, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Settings_GyroEngageStickDirection_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBox SelectedValue="{Binding GyroEngageStickDirection, Mode=TwoWay}"
                                              SelectedValuePath="Tag"
                                              MaxWidth="260" controls:SettingRow.Fills="True" VerticalAlignment="Center"
                                              ToolTip="{Binding Settings_GyroEngageStickDirection_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                        <ComboBoxItem Content="{Binding Settings_GyroEngageStickDirection_Full, Source={x:Static strings:Strings.Instance}}" Tag="Full"/>
                                        <ComboBoxItem Content="{Binding Settings_GyroEngageStickDirection_X, Source={x:Static strings:Strings.Instance}}" Tag="X"/>
                                        <ComboBoxItem Content="{Binding Settings_GyroEngageStickDirection_Y, Source={x:Static strings:Strings.Instance}}" Tag="Y"/>
                                        <ComboBoxItem Content="{Binding Settings_GyroEngageStickDirection_XNeg, Source={x:Static strings:Strings.Instance}}" Tag="XNeg"/>
                                        <ComboBoxItem Content="{Binding Settings_GyroEngageStickDirection_XPos, Source={x:Static strings:Strings.Instance}}" Tag="XPos"/>
                                        <ComboBoxItem Content="{Binding Settings_GyroEngageStickDirection_YNeg, Source={x:Static strings:Strings.Instance}}" Tag="YNeg"/>
                                        <ComboBoxItem Content="{Binding Settings_GyroEngageStickDirection_YPos, Source={x:Static strings:Strings.Instance}}" Tag="YPos"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding ResetGyroEngageStickDirectionCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroEngageStickDirection, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <!-- Aim Engage button. Cross-device picker that writes
                                     both the descriptor and owning device GUID atomically.
                                     ItemsSource is the slot's combined cross-device InputChoice
                                     list, populated by InputService.PopulateAvailableInputs.
                                     Subtitle under the picker shows the owning device, matching
                                     the mapping row pattern at PadPage.xaml:2785-2800. -->
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Settings_GyroAimEngageButton, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               VerticalAlignment="Top" Margin="0,4,12,0"
                                               ToolTip="{Binding Settings_GyroAimEngageButton_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <StackPanel Orientation="Vertical" MaxWidth="260" controls:SettingRow.Fills="True">
                                        <ComboBox ItemsSource="{Binding SlotAvailableInputsView}"
                                                  SelectedItem="{Binding GyroAimEngageSelectedInput, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName"
                                                  Padding="4,2"
                                                  ToolTip="{Binding Settings_GyroAimEngageButton_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                  IsSynchronizedWithCurrentItem="False">
                                            <ComboBox.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,3,6,3">
                                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ComboBox.GroupStyle>
                                        </ComboBox>
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Margin="4,1,0,0"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding GyroAimEngageSelectedInput.DeviceLabel}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding GyroAimEngageSelectedInput}" Value="{x:Null}">
                                                            <Setter Property="Text" Value="{Binding Common_Unassigned, Source={x:Static strings:Strings.Instance}}"/>
                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <ui:Button Command="{Binding GyroAimEngageRecordCommand}"
                                               Style="{StaticResource EmberIconButtonHot}"
                                               VerticalAlignment="Top">
                                        <controls:GlyphText Text="{Binding GyroAimEngageRecordButtonIcon}" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource EmberBrush}"/>
                                        <ui:Button.ToolTip>
                                            <TextBlock Text="{Binding GyroAimEngageRecordButtonText}"/>
                                        </ui:Button.ToolTip>
                                    </ui:Button>
                                    <ui:Button Command="{Binding ResetGyroAimEngageButtonCommand}" Style="{StaticResource ResetButton}"
                                            VerticalAlignment="Top"
                                            ToolTip="{Binding Pad_ResetGyroAimEngageButton, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>
                                <!-- Engage Mode. Hold (default) follows the
                                     button state directly. Toggle flips a
                                     sticky per-slot bit on each rising edge.
                                     Sibling to the engage-button row above so
                                     the two parameters of the same feature
                                     read as a pair. -->
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Settings_GyroAimEngageMode, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Settings_GyroAimEngageMode_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBox SelectedValue="{Binding GyroAimEngageMode, Mode=TwoWay}"
                                              SelectedValuePath="Tag"
                                              MaxWidth="260" controls:SettingRow.Fills="True" VerticalAlignment="Center"
                                              ScrollViewer.VerticalScrollBarVisibility="Visible"
                                              ToolTip="{Binding Settings_GyroAimEngageMode_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                        <ComboBoxItem Content="{Binding Settings_GyroAimEngageMode_Hold, Source={x:Static strings:Strings.Instance}}" Tag="Hold"/>
                                        <ComboBoxItem Content="{Binding Settings_GyroAimEngageMode_Toggle, Source={x:Static strings:Strings.Instance}}" Tag="Toggle"/>
                                        <ComboBoxItem Content="{Binding Settings_GyroAimEngageMode_ReleaseToEngage, Source={x:Static strings:Strings.Instance}}" Tag="ReleaseToEngage"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding ResetGyroAimEngageModeCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroAimEngageMode, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>
                            </StackPanel>
                        </controls:FoldCard>

                        <!-- ─── Response shaping card ─── -->
                        <controls:FoldCard x:Name="GyroResponseCard" StateKey="Pad.Motion.Response"
                                           Header="{Binding Pad_Gyro_Response_Header, Source={x:Static strings:Strings.Instance}}"
                                           Hint="{Binding Pad_GyroResponse_FoldHint, Source={x:Static strings:Strings.Instance}}">
                            <controls:FoldCard.HeaderAction>
                                <ui:Button Command="{Binding ResetGyroResponseCardCommand}" Style="{StaticResource ResetAllButton}"
                                        Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}"
                                        ToolTip="{Binding Pad_Gyro_ResetResponse_All_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:FoldCard.HeaderAction>
                            <StackPanel>

                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Settings_GyroDeadZone, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Settings_GyroDeadZone_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding GyroDeadZoneDegPerSec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="0" Maximum="30" SmallChange="0.5" LargeChange="5"
                                            MinWidth="60" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroDeadZone_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding GyroDeadZoneDegPerSec, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.0}}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="°/s" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetGyroDeadZoneCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroDeadZone, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <!-- dual-threshold smoothing (JSM-style).
                                     Tightening = full smoothing below this rate (drop hand tremor).
                                     Smoothing threshold = pass-through above this rate (fast turns).
                                     Between thresholds = linear ramp. -->
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Settings_GyroTightening, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Settings_GyroTightening_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding GyroTighteningThresholdDegPerSec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="0" Maximum="30" SmallChange="0.5" LargeChange="5"
                                            MinWidth="60" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroTightening_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding GyroTighteningThresholdDegPerSec, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.0}}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="°/s" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetGyroTighteningCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroTightening, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Settings_GyroSmoothingThreshold, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Settings_GyroSmoothingThreshold_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding GyroSmoothingThresholdDegPerSec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="0" Maximum="30" SmallChange="0.5" LargeChange="5"
                                            MinWidth="60" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroSmoothingThreshold_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding GyroSmoothingThresholdDegPerSec, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.0}}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="°/s" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetGyroSmoothingThresholdCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroSmoothingThreshold, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Settings_GyroSmoothingWindow, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Settings_GyroSmoothingWindow_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding GyroSmoothingWindowMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="10" Maximum="200" SmallChange="5" LargeChange="20"
                                            MinWidth="60" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroSmoothingWindow_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding GyroSmoothingWindowMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="ms" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetGyroSmoothingWindowCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroSmoothingWindow, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Settings_GyroAcceleration, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Settings_GyroAcceleration_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding GyroAcceleration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="0" Maximum="5" SmallChange="0.05" LargeChange="0.5"
                                            MinWidth="60" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroAcceleration_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding GyroAcceleration, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <ui:Button Command="{Binding ResetGyroAccelerationCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroAcceleration, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Settings_GyroOutputCurve, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Settings_GyroOutputCurve_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBox ItemsSource="{Binding GyroOutputCurveOptions}"
                                              SelectedValue="{Binding GyroOutputCurve, Mode=TwoWay}"
                                              SelectedValuePath="Value" DisplayMemberPath="Display"
                                              MaxWidth="200" controls:SettingRow.Fills="True" VerticalAlignment="Center"
                                              ToolTip="{Binding Settings_GyroOutputCurve_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Command="{Binding ResetGyroOutputCurveCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroOutputCurve, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>
                            </StackPanel>
                        </controls:FoldCard>

                        <!-- ─── Motion Steering card (#94). Settings for the "Motion Lean"
                             INPUT (tilt deadzones + grip orientation, per assigned device).
                             Motion Lean itself is a normal input descriptor: the user maps
                             it to an axis from the input dropdown in Mappings, like any
                             gyro input. This card never targets or overrides an axis. -->
                        <controls:FoldCard x:Name="MotionSteeringFoldCard" StateKey="Pad.Motion.Steering"
                                           Header="{Binding Pad_MotionSteer_Header, Source={x:Static strings:Strings.Instance}}"
                                           Hint="{Binding Pad_MotionSteering_FoldHint, Source={x:Static strings:Strings.Instance}}"
                                           Description="{Binding Pad_MotionSteer_Subtitle, Source={x:Static strings:Strings.Instance}}">
                            <controls:FoldCard.HeaderAction>
                                <ui:Button Command="{Binding ResetMotionSteerAllCommand}" Style="{StaticResource ResetAllButton}"
                                        Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}"
                                        ToolTip="{Binding Pad_MotionSteer_Reset_All, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:FoldCard.HeaderAction>
                            <controls:FoldCard.Summary>
                                <MultiBinding Converter="{StaticResource FormatTextConverter}">
                                    <Binding Path="MotionSteerInnerDz"/>
                                    <Binding Path="MotionSteerOuterDz"/>
                                    <Binding Path="Pad_DegreeRange_Format" Source="{x:Static strings:Strings.Instance}"/>
                                </MultiBinding>
                            </controls:FoldCard.Summary>
                            <StackPanel>
                                <StackPanel>
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <TextBlock Text="{Binding Pad_Steering_MotionInnerDz, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <Slider Value="{Binding MotionSteerInnerDz, Mode=TwoWay}" Minimum="0" Maximum="179" Style="{StaticResource DzSlider}"/>
                                        <TextBox Text="{Binding MotionSteerInnerDz, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="&#176;" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding ResetMotionSteerInnerCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_MotionInnerDz, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <TextBlock Text="{Binding Pad_Steering_MotionOuterDz, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <Slider Value="{Binding MotionSteerOuterDz, Mode=TwoWay}" Minimum="0" Maximum="179" Style="{StaticResource DzSlider}"/>
                                        <TextBox Text="{Binding MotionSteerOuterDz, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="&#176;" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding ResetMotionSteerOuterCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_MotionOuterDz, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <TextBlock Text="{Binding Pad_Steering_Orientation, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <ComboBox SelectedIndex="{Binding MotionSteerOrientIndex, Mode=TwoWay}" MaxWidth="200" controls:SettingRow.Fills="True" VerticalAlignment="Center">
                                            <ComboBoxItem Content="{Binding Pad_Steering_Orient_Forward, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding Pad_Steering_Orient_Left, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding Pad_Steering_Orient_Right, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding Pad_Steering_Orient_Backward, Source={x:Static strings:Strings.Instance}}"/>
                                        </ComboBox>
                                        <ui:Button Command="{Binding ResetMotionSteerOrientCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_Orientation, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                </StackPanel>
                            </StackPanel>
                        </controls:FoldCard>

                        <!-- ─── Gyro Tilt card (#292): settings for the "Gyro Tilt
                             X/Y" INPUTS (degree-ranged gravity tilt, per assigned
                             device). Like Motion Steering, this card never targets
                             an axis. The inputs are picked on mapping rows. The
                             per-source curve/anti-deadzone knobs on the row apply
                             on top, and Gyro Recenter re-zeroes the resting grip. -->
                        <controls:FoldCard x:Name="GyroTiltFoldCard" StateKey="Pad.Motion.Tilt"
                                           Header="{Binding Pad_GyroTilt_Header, Source={x:Static strings:Strings.Instance}}"
                                           Hint="{Binding Pad_GyroTilt_FoldHint, Source={x:Static strings:Strings.Instance}}"
                                           Summary="{Binding GyroTiltRangeDeg, StringFormat={}{0:0}°}"
                                           Description="{Binding Pad_GyroTilt_Subtitle, Source={x:Static strings:Strings.Instance}}">
                            <controls:FoldCard.HeaderAction>
                                <ui:Button Command="{Binding ResetGyroTiltAllCommand}" Style="{StaticResource ResetAllButton}"
                                        Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}"
                                        ToolTip="{Binding Pad_GyroTilt_Reset_All, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:FoldCard.HeaderAction>
                            <StackPanel>
                                <StackPanel>
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <TextBlock Text="{Binding Pad_GyroTilt_Range, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                                   ToolTip="{Binding Pad_GyroTilt_Range_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <Slider Value="{Binding GyroTiltRangeDeg, Mode=TwoWay}" Minimum="1" Maximum="90" Style="{StaticResource DzSlider}"
                                                ToolTip="{Binding Pad_GyroTilt_Range_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBox Text="{Binding GyroTiltRangeDeg, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="&#176;" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding ResetGyroTiltRangeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_GyroTilt_Reset_Range, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <TextBlock Text="{Binding Pad_GyroTilt_Deadzone, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                                   ToolTip="{Binding Pad_GyroTilt_Deadzone_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <!-- The model's ceiling, which sits just under the
                                             range's own cap. A lower one here clamped a
                                             stored value back on realization. -->
                                        <Slider Value="{Binding GyroTiltInnerDz, Mode=TwoWay}" Minimum="0" Maximum="89" Style="{StaticResource DzSlider}"
                                                ToolTip="{Binding Pad_GyroTilt_Deadzone_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBox Text="{Binding GyroTiltInnerDz, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="&#176;" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding ResetGyroTiltInnerCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_GyroTilt_Reset_Deadzone, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                </StackPanel>
                            </StackPanel>
                        </controls:FoldCard>

                        <!-- ─── Motion Passthrough card ─── -->
                        <!-- Tab-wide scope toggle: whether this tab's tuning
                             reaches the virtual controller's motion passthrough
                             (gyro report + DSU) as well as gyro-as-mapping-source.
                             Uses CardBorder's default bottom-12 margin so the
                             gap between this and the Calibration card matches
                             every other adjacent-card gap on the Pad page. -->
                        <controls:FoldCard x:Name="GyroPassthroughCard" StateKey="Pad.Motion.Passthrough"
                                           Header="{Binding Pad_Gyro_Passthrough_Header, Source={x:Static strings:Strings.Instance}}"
                                           Hint="{Binding Pad_Gyro_ApplyToPassthrough, Source={x:Static strings:Strings.Instance}}">
                            <controls:FoldCard.HeaderAction>
                                <ui:Button Command="{Binding ResetGyroApplyToPassthroughCommand}" Style="{StaticResource ResetAllButton}"
                                        Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}"
                                        ToolTip="{Binding Pad_Gyro_ResetPassthrough_All_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:FoldCard.HeaderAction>
                            <controls:FoldCard.Summary>
                                <MultiBinding Converter="{StaticResource OnOffTextConverter}">
                                    <Binding Path="GyroApplyTuningToPassthrough"/>
                                    <Binding Path="Common_On" Source="{x:Static strings:Strings.Instance}"/>
                                    <Binding Path="Common_Off" Source="{x:Static strings:Strings.Instance}"/>
                                </MultiBinding>
                            </controls:FoldCard.Summary>
                            <StackPanel>
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Pad_Gyro_ApplyToPassthrough, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <CheckBox Style="{StaticResource SwitchCheckBox}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Gyro_ApplyToPassthrough, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding GyroApplyTuningToPassthrough, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,4,0"
                                              ToolTip="{Binding Pad_Gyro_ApplyToPassthrough_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Command="{Binding ResetGyroApplyToPassthroughCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroApplyToPassthrough, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>
                            </StackPanel>
                        </controls:FoldCard>

                        <!-- ─── Pitch and Roll Simulation card (#472). A DualShock 3's
                             gyro measures yaw only, so this fills pitch and roll
                             from the accelerometer. Shown only for a device that
                             lacks gyro axes its accelerometer can supply.
                             Visibility set in SyncTabVisibility. ─── -->
                        <controls:FoldCard x:Name="GyroSimulationCard" StateKey="Pad.Motion.Simulation" Visibility="Collapsed"
                                           Header="{Binding Pad_Gyro_Simulation_Header, Source={x:Static strings:Strings.Instance}}"
                                           Hint="{Binding Pad_GyroSimulation_FoldHint, Source={x:Static strings:Strings.Instance}}"
                                           Description="{Binding Pad_Gyro_Simulation_Description, Source={x:Static strings:Strings.Instance}}">
                            <controls:FoldCard.HeaderAction>
                                <ui:Button Command="{Binding ResetGyroSimulationCardCommand}" Style="{StaticResource ResetAllButton}"
                                        Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}"
                                        ToolTip="{Binding Pad_Gyro_ResetSimulation_All_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:FoldCard.HeaderAction>
                            <controls:FoldCard.Summary>
                                <MultiBinding Converter="{StaticResource OnOffTextConverter}">
                                    <Binding Path="GyroSimulation"/>
                                    <Binding Path="Common_On" Source="{x:Static strings:Strings.Instance}"/>
                                    <Binding Path="Common_Off" Source="{x:Static strings:Strings.Instance}"/>
                                </MultiBinding>
                            </controls:FoldCard.Summary>
                            <StackPanel>
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Settings_GyroSimulation, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <CheckBox Style="{StaticResource SwitchCheckBox}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Settings_GyroSimulation, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding GyroSimulation, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,4,0"
                                              ToolTip="{Binding Settings_GyroSimulation_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Command="{Binding ResetGyroSimulationCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroSimulation, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Settings_GyroSimulationSmoothing, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Settings_GyroSimulationSmoothing_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding GyroSimulationSmoothingMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="20" Maximum="250" SmallChange="5" LargeChange="20"
                                            MinWidth="60" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroSimulationSmoothing_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding GyroSimulationSmoothingMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="ms" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetGyroSimulationSmoothingCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroSimulationSmoothing, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>
                            </StackPanel>
                        </controls:FoldCard>

                        <!-- ─── Compass-anchored yaw (#271 item 5), Switch 2
                             magnetometer devices only. Visibility set in
                             SyncTabVisibility. ─── -->
                        <controls:FoldCard x:Name="CompassYawCard" StateKey="Pad.Motion.Compass" Visibility="Collapsed"
                                           Header="{Binding Pad_Gyro_Compass_Header, Source={x:Static strings:Strings.Instance}}"
                                           Hint="{Binding Pad_Compass_FoldHint, Source={x:Static strings:Strings.Instance}}"
                                           Description="{Binding Pad_Gyro_Compass_Description, Source={x:Static strings:Strings.Instance}}">
                            <controls:FoldCard.Summary>
                                <MultiBinding Converter="{StaticResource OnOffTextConverter}">
                                    <Binding Path="GyroCompassYaw"/>
                                    <Binding Path="Common_On" Source="{x:Static strings:Strings.Instance}"/>
                                    <Binding Path="Common_Off" Source="{x:Static strings:Strings.Instance}"/>
                                </MultiBinding>
                            </controls:FoldCard.Summary>
                            <StackPanel>
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Settings_GyroCompassYaw, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <CheckBox Style="{StaticResource SwitchCheckBox}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Settings_GyroCompassYaw, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding GyroCompassYaw, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,4,0"
                                              ToolTip="{Binding Settings_GyroCompassYaw_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Command="{Binding ResetGyroCompassYawCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroCompassYaw, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Command="{Binding MagCalibrateCommand}" Padding="12,6">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Content" Value="{Binding Pad_Gyro_MagCalibrate, Source={x:Static strings:Strings.Instance}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MagCalibrating}" Value="True">
                                                        <Setter Property="Content" Value="{Binding Pad_Gyro_MagCalibrate_Stop, Source={x:Static strings:Strings.Instance}}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </controls:FoldCard>
                        </controls:FoldList>
                    </StackPanel>
                    </GroupBox>

            <!-- ═══════════════════════════════════════════
                 INDEX 10. Touchpad tab (per-(device, pad)
                 gesture settings). Visibility on the tab
                 strip is gated by SyncTabVisibility based on
                 UserDevice.HasTouchpad of the currently
                 selected mapped device.
                 ═══════════════════════════════════════════ -->
                    <GroupBox x:Name="TabTouchpad" Visibility="Collapsed" Style="{StaticResource BareGroupBox}"
                              AutomationProperties.Name="{Binding Pad_Touchpad_Header, Source={x:Static strings:Strings.Instance}}">
                    <StackPanel>
                        <TextBlock AutomationProperties.AutomationId="TabTouchpad" Text="{Binding Pad_Touchpad_Header, Source={x:Static strings:Strings.Instance}}"
                                   Style="{StaticResource SectionTitle}" Margin="0,0,0,12" HorizontalAlignment="Left"
                                   ToolTip="{Binding Pad_Touchpad_Subtitle, Source={x:Static strings:Strings.Instance}}"/>

                        <!-- Touchpad selector. Visible only on multi-pad
                             devices. Settings are per (device, pad), so this
                             pivots EVERY card below as well as aiming the
                             gesture recorder and the live input preview. -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                                    Visibility="{Binding HasMultipleTouchpads, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Touchpad_SelectedTouchpad, Source={x:Static strings:Strings.Instance}}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                       ToolTip="{Binding Pad_Touchpad_SelectedTouchpad_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                            <ComboBox ItemsSource="{Binding TouchpadIndexOptions}"
                                      SelectedItem="{Binding SelectedTouchpadIndex, Mode=TwoWay}"
                                      Width="120" VerticalAlignment="Center"
                                      ToolTip="{Binding Pad_Touchpad_SelectedTouchpad_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                      ScrollViewer.VerticalScrollBarVisibility="Visible">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Pad index is stored 0-based. Show it 1-based
                                             ("1"/"2") to match the previews and picker. The
                                             adjacent label is already the word "Touchpad", so
                                             the dropdown shows only the number. -->
                                        <TextBlock Text="{Binding Converter={StaticResource OneBasedIndexConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- ─── Mouse Output card ─── -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Pad_Touchpad_Mouse_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"
                                               ToolTip="{Binding Pad_Touchpad_Mouse_Subtitle, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Command="{Binding ResetTouchpadMouseCardCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetTouchpadMouse, Source={x:Static strings:Strings.Instance}}"/>
                                </DockPanel>

                                <!-- Sensitivity is a multiplier, not a fraction, so the
                                     slider rows keep native units with the × suffix
                                     (mapping-grid sensitivity idiom), #175 item 15. -->
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Pad_Touchpad_MouseSensitivityX, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding TouchpadMouseSensitivityX, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}" Minimum="0.05" Maximum="10" TickFrequency="0.05"
                                            ToolTip="{Binding Pad_Touchpad_MouseSensitivityX_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding TouchpadMouseSensitivityX, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                             Style="{StaticResource DzValueEdit}"
                                             ToolTip="{Binding Pad_Touchpad_MouseSensitivityX_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBlock Text="×" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetTouchpadMouseSensitivityXCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadMouseSensitivityX, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Pad_Touchpad_MouseSensitivityY, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding TouchpadMouseSensitivityY, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}" Minimum="0.05" Maximum="10" TickFrequency="0.05"
                                            ToolTip="{Binding Pad_Touchpad_MouseSensitivityY_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding TouchpadMouseSensitivityY, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                             Style="{StaticResource DzValueEdit}"
                                             ToolTip="{Binding Pad_Touchpad_MouseSensitivityY_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBlock Text="×" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetTouchpadMouseSensitivityYCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadMouseSensitivityY, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Pad_Touchpad_MouseJitterReduction, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <CheckBox Style="{StaticResource SwitchCheckBox}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Touchpad_MouseJitterReduction, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding TouchpadMouseJitterReduction, Mode=TwoWay}"
                                              ToolTip="{Binding Pad_Touchpad_MouseJitterReduction_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                              VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetTouchpadMouseJitterReductionCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadMouseJitterReduction, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <!-- More (#574): the settings fewer people change, opened in place. -->
                                <controls:MoreRow x:Name="TouchpadMouseMore" StateKey="Pad.Touch.Mouse.More"
                                                  AutomationProperties.AutomationId="Pad_More_TouchpadMouse"
                                                  Header="{Binding Common_More, Source={x:Static strings:Strings.Instance}}"
                                                  Hint="{Binding Pad_More_TouchpadMouse, Source={x:Static strings:Strings.Instance}}">
                                    <StackPanel>
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Pad_Touchpad_MouseInvertX, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <CheckBox Style="{StaticResource SwitchCheckBox}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Touchpad_MouseInvertX, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding TouchpadMouseInvertX, Mode=TwoWay}"
                                              ToolTip="{Binding Pad_Touchpad_MouseInvertX_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                              VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetTouchpadMouseInvertXCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadMouseInvertX, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Pad_Touchpad_MouseInvertY, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <CheckBox Style="{StaticResource SwitchCheckBox}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Touchpad_MouseInvertY, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding TouchpadMouseInvertY, Mode=TwoWay}"
                                              ToolTip="{Binding Pad_Touchpad_MouseInvertY_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                              VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetTouchpadMouseInvertYCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadMouseInvertY, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Pad_Touchpad_MouseMomentum, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <CheckBox Style="{StaticResource SwitchCheckBox}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Touchpad_MouseMomentum, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding TouchpadMouseMomentum, Mode=TwoWay}"
                                              ToolTip="{Binding Pad_Touchpad_MouseMomentum_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                              VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetTouchpadMouseMomentumCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadMouseMomentum, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Pad_Touchpad_PointerResponse, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Pad_Touchpad_PointerResponse_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBox SelectedValue="{Binding TouchpadPointerResponse, Mode=TwoWay}" SelectedValuePath="Tag"
                                              MinWidth="150" VerticalAlignment="Center"
                                              ToolTip="{Binding Pad_Touchpad_PointerResponse_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                        <ComboBoxItem Tag="Simple" Content="{Binding Pad_Touchpad_PointerResponse_Simple, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Tag="Trackpad" Content="{Binding Pad_Touchpad_PointerResponse_Trackpad, Source={x:Static strings:Strings.Instance}}"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding ResetTouchpadPointerResponseCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadPointerResponse, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44"
                                            Visibility="{Binding TouchpadPointerResponseIsTrackpad, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Pad_Touchpad_TrackpadThreshold, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Pad_Touchpad_TrackpadThreshold_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding TouchpadTrackpadThreshold, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}" Minimum="20" Maximum="600" TickFrequency="10"
                                            ToolTip="{Binding Pad_Touchpad_TrackpadThreshold_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding TouchpadTrackpadThreshold, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F0}"
                                             Style="{StaticResource DzValueEdit}"
                                             ToolTip="{Binding Pad_Touchpad_TrackpadThreshold_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Command="{Binding ResetTouchpadTrackpadThresholdCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadTrackpadThreshold, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44"
                                            Visibility="{Binding TouchpadPointerResponseIsTrackpad, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Pad_Touchpad_TrackpadPadWidth, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Pad_Touchpad_TrackpadPadWidth_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding TouchpadTrackpadPadWidthMm, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}" Minimum="20" Maximum="150" TickFrequency="1"
                                            ToolTip="{Binding Pad_Touchpad_TrackpadPadWidth_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding TouchpadTrackpadPadWidthMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F0}"
                                             Style="{StaticResource DzValueEdit}"
                                             ToolTip="{Binding Pad_Touchpad_TrackpadPadWidth_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Command="{Binding ResetTouchpadTrackpadPadWidthCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadTrackpadPadWidth, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44"
                                            Visibility="{Binding TouchpadPointerResponseIsSimple, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Pad_Touchpad_MouseAcceleration, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Pad_Touchpad_MouseAcceleration_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding TouchpadMouseAcceleration, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}" Minimum="0" Maximum="5" TickFrequency="0.1"
                                            ToolTip="{Binding Pad_Touchpad_MouseAcceleration_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding TouchpadMouseAcceleration, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                             Style="{StaticResource DzValueEdit}"
                                             ToolTip="{Binding Pad_Touchpad_MouseAcceleration_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Command="{Binding ResetTouchpadMouseAccelerationCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadMouseAcceleration, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44"
                                            IsEnabled="{Binding TouchpadMouseMomentum}">
                                    <TextBlock Text="{Binding Pad_Touchpad_MouseMomentumDecay, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding TouchpadMouseMomentumDecay, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}" Minimum="0.80" Maximum="1.00" TickFrequency="0.01"
                                            ToolTip="{Binding Pad_Touchpad_MouseMomentumDecay_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding TouchpadMouseMomentumDecay, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                             Style="{StaticResource DzValueEdit}"
                                             ToolTip="{Binding Pad_Touchpad_MouseMomentumDecay_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Command="{Binding ResetTouchpadMouseMomentumDecayCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadMouseMomentumDecay, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44"
                                            IsEnabled="{Binding TouchpadMouseMomentum}">
                                    <TextBlock Text="{Binding Pad_Touchpad_MomentumFlingGain, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Pad_Touchpad_MomentumFlingGain_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding TouchpadMomentumFlingGain, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}" Minimum="0.1" Maximum="5" TickFrequency="0.1"
                                            ToolTip="{Binding Pad_Touchpad_MomentumFlingGain_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding TouchpadMomentumFlingGain, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <ui:Button Command="{Binding ResetTouchpadMomentumFlingGainCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadMomentumFlingGain, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44"
                                            IsEnabled="{Binding TouchpadMouseMomentum}">
                                    <TextBlock Text="{Binding Pad_Touchpad_MomentumMinLift, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Pad_Touchpad_MomentumMinLift_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding TouchpadMomentumMinLift, Mode=TwoWay}"
