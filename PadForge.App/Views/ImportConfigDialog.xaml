<views:DialogWindow AutomationProperties.IsDialog="True" x:Class="PadForge.Views.ImportConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        xmlns:controls="clr-namespace:PadForge.Controls"
        xmlns:views="clr-namespace:PadForge.Views"
        IsWide="True" ShowClose="True"
        Title="{Binding Import_DialogTitle, Source={x:Static strings:Strings.Instance}}">

    <!-- Import Profile (#561, #574), as the Dialogs board draws it: what
         the file is and the profile it becomes, how much of it came
         across, the bindings that need a look with the reason for each,
         and the ones that came across as they were. Nothing the file names
         runs before Import, and the note names every program its buttons
         or its load will start. The code-behind writes the line under the
         title, sets each count's tile and fills the two lists. -->
    <views:DialogWindow.Subtitle>
        <TextBlock x:Name="SourceText" TextWrapping="Wrap"/>
    </views:DialogWindow.Subtitle>

    <views:DialogWindow.Foot>
        <controls:FlexLinePanel Style="{StaticResource DialogFootPanel}">
            <Button x:Name="CancelButton" Style="{StaticResource DialogButton}" IsCancel="True"
                    Content="{Binding Common_Cancel, Source={x:Static strings:Strings.Instance}}"/>
            <Button x:Name="ImportButton" Style="{StaticResource DialogPrimaryButton}"
                    Content="{Binding Import_Confirm, Source={x:Static strings:Strings.Instance}}"
                    Click="Import_Click"/>
        </controls:FlexLinePanel>
    </views:DialogWindow.Foot>

    <StackPanel x:Name="BodyPanel">
        <!-- Three counts, each in a tile. A zero is quiet, and a count of
             bindings that did not come across whole takes the wait look. -->
        <Grid Margin="24,16,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="StatCleanTile" Style="{StaticResource DialogStatTile}">
                <StackPanel>
                    <TextBlock x:Name="StatCleanNum" Text="0" FontSize="20" FontFamily="{DynamicResource TelemetryFontFamily}"/>
                    <TextBlock x:Name="StatCleanLabel" Style="{StaticResource DialogNote}"
                               Text="{Binding Workshop_StatClean, Source={x:Static strings:Strings.Instance}}"/>
                </StackPanel>
            </Border>
            <Border x:Name="StatPartialTile" Grid.Column="2" Style="{StaticResource DialogStatTile}">
                <StackPanel>
                    <TextBlock x:Name="StatPartialNum" Text="0" FontSize="20" FontFamily="{DynamicResource TelemetryFontFamily}"/>
                    <TextBlock x:Name="StatPartialLabel" Style="{StaticResource DialogNote}"
                               Text="{Binding Workshop_StatPartial, Source={x:Static strings:Strings.Instance}}"/>
                </StackPanel>
            </Border>
            <Border x:Name="StatSkippedTile" Grid.Column="4" Style="{StaticResource DialogStatTile}">
                <StackPanel>
                    <TextBlock x:Name="StatSkippedNum" Text="0" FontSize="20" FontFamily="{DynamicResource TelemetryFontFamily}"/>
                    <TextBlock x:Name="StatSkippedLabel" Style="{StaticResource DialogNote}"
                               Text="{Binding Workshop_StatSkipped, Source={x:Static strings:Strings.Instance}}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- What came across with a difference, or did not: each in a box
             of its own, its name over the reason in full. -->
        <StackPanel x:Name="NeedsLookBlock" Margin="24,16,24,0">
            <TextBlock x:Name="NeedsLookHead" Style="{StaticResource DialogHead3}" Margin="0"
                       Foreground="{DynamicResource WaitBrush}"
                       Text="{Binding Import_NeedsALook, Source={x:Static strings:Strings.Instance}}"/>
            <ItemsControl x:Name="NeedsLookList" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DialogWaitBox}" Margin="0,8,0,0" Padding="14,12">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                    <Run Text="{Binding Source, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{Binding Arrow, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><Run Text=" "/><Run Text="{Binding Target, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </TextBlock>
                                <TextBlock Margin="0,2,0,0" FontSize="13" TextWrapping="Wrap" Text="{Binding Detail}"
                                           Foreground="{DynamicResource SubRowTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- What came across as it was, two to a line: the file's name
             for the binding in the code face, then what it became. The
             grid runs 24 past its block so its two columns stand 24
             apart with the second one's end at the block's. -->
        <StackPanel x:Name="CleanBlock" Margin="24,16,24,4">
            <TextBlock x:Name="CleanHead" Style="{StaticResource DialogHead3}" Margin="0"
                       Text="{Binding Import_ImportedCleanly, Source={x:Static strings:Strings.Instance}}"/>
            <ItemsControl x:Name="CleanList" Margin="0,6,-24,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5,24,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Source}" FontSize="13" MaxWidth="150" TextWrapping="Wrap"
                                       FontFamily="{DynamicResource TelemetryFontFamily}"
                                       Foreground="{DynamicResource ColdBrush}"/>
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding Target}" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- What loading the profile will do and need: the programs it
             starts, the devices it takes. -->
        <TextBlock x:Name="NoteText" Style="{StaticResource DialogNote}" Margin="24,10,24,16"/>
    </StackPanel>
</views:DialogWindow>
