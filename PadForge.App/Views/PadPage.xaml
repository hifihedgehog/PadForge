                                                    <TextBox Text="{Binding DeviceConfig.LightbarBatteryHighR, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <ui:Button Command="{Binding DeviceConfig.ResetLightbarBatteryHighRCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarRed, Source={x:Static strings:Strings.Instance}}"/>
                                                </controls:SettingRow>
                                                <controls:SettingRow MinHeight="44">
                                                    <TextBlock Text="G" Style="{StaticResource DzLabelTight}" Foreground="#FF388E3C"/>
                                                    <Slider Value="{Binding DeviceConfig.LightbarBatteryHighG, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding DeviceConfig.LightbarBatteryHighG, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <ui:Button Command="{Binding DeviceConfig.ResetLightbarBatteryHighGCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarGreen, Source={x:Static strings:Strings.Instance}}"/>
                                                </controls:SettingRow>
                                                <controls:SettingRow MinHeight="44">
                                                    <TextBlock Text="B" Style="{StaticResource DzLabelTight}" Foreground="#FF1976D2"/>
                                                    <Slider Value="{Binding DeviceConfig.LightbarBatteryHighB, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding DeviceConfig.LightbarBatteryHighB, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <ui:Button Command="{Binding DeviceConfig.ResetLightbarBatteryHighBCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarBlue, Source={x:Static strings:Strings.Instance}}"/>
                                                </controls:SettingRow>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- Audio bands: 3 colors with thresholds, only visible
                                     when LightbarMode is AudioThresholds, AudioGradient,
                                     or AudioCrossFade. Lives inside the consolidated
                                     Lightbar border so the user has a single place
                                     to configure every effect mode. -->
                                <StackPanel Visibility="{Binding DeviceConfig.LightbarMode, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=AudioThresholds|AudioGradient|AudioCrossFade}">
                                    <!-- The blocks stand side by side while the card has the room
                                         and wrap when it does not (#574). -->
                                    <WrapPanel Margin="0,4,0,0">

                                        <!-- LOW (quiet) color -->
                                        <Border Margin="0,0,8,8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Pad_Lighting_AudioLightbar_LowColor, Source={x:Static strings:Strings.Instance}}"
                                                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                <views:ColorPickerControl Margin="0,0,0,8"
                                                    HorizontalAlignment="Left"
                                                    Red="{Binding DeviceConfig.AudioLowR, Mode=TwoWay}"
                                                    Green="{Binding DeviceConfig.AudioLowG, Mode=TwoWay}"
                                                    Blue="{Binding DeviceConfig.AudioLowB, Mode=TwoWay}"/>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="36" Height="28" CornerRadius="4"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                                        <Border.Background>
                                                            <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                                                <Binding Path="DeviceConfig.AudioLowR" />
                                                                <Binding Path="DeviceConfig.AudioLowG" />
                                                                <Binding Path="DeviceConfig.AudioLowB" />
                                                            </MultiBinding>
                                                        </Border.Background>
                                                    </Border>
                                                    <DockPanel LastChildFill="True" Visibility="{Binding Visibility, ElementName=AudioLowHexBox}" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <reset:SettingResetButton DockPanel.Dock="Right" Click="ResetAudioColor_Click" Tag="low" Visibility="{Binding Visibility, ElementName=AudioLowHexBox}" SettingLabel="{Binding ResetLabel_LowColor, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_PadViewModel_AudioLowHexBox_8930"/>
                                                        <TextBox x:Name="AudioLowHexBox" Tag="Low"
                                                                 FontFamily="{StaticResource TelemetryFontFamily}" Padding="6,2"
                                                                 KeyDown="AudioHexBox_KeyDown"
                                                                 LostFocus="AudioHexBox_LostFocus"
                                                                 ToolTip="{Binding Pad_Lighting_HexTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                    </DockPanel>
                                                </Grid>
                                                <controls:SettingRow MinHeight="44">
                                                    <TextBlock Text="R" Style="{StaticResource DzLabelTight}" Foreground="#FFD32F2F"/>
                                                    <Slider Value="{Binding DeviceConfig.AudioLowR, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding DeviceConfig.AudioLowR, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <ui:Button Command="{Binding DeviceConfig.ResetAudioLowRCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetAudioLowR, Source={x:Static strings:Strings.Instance}}"/>
                                                </controls:SettingRow>
                                                <controls:SettingRow MinHeight="44">
                                                    <TextBlock Text="G" Style="{StaticResource DzLabelTight}" Foreground="#FF388E3C"/>
                                                    <Slider Value="{Binding DeviceConfig.AudioLowG, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding DeviceConfig.AudioLowG, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <ui:Button Command="{Binding DeviceConfig.ResetAudioLowGCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetAudioLowG, Source={x:Static strings:Strings.Instance}}"/>
                                                </controls:SettingRow>
                                                <controls:SettingRow MinHeight="44">
                                                    <TextBlock Text="B" Style="{StaticResource DzLabelTight}" Foreground="#FF1976D2"/>
                                                    <Slider Value="{Binding DeviceConfig.AudioLowB, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding DeviceConfig.AudioLowB, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <ui:Button Command="{Binding DeviceConfig.ResetAudioLowBCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetAudioLowB, Source={x:Static strings:Strings.Instance}}"/>
                                                </controls:SettingRow>
                                            </StackPanel>
                                        </Border>

                                        <!-- MID (medium) color -->
                                        <Border Margin="0,0,8,8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Pad_Lighting_AudioLightbar_MidColor, Source={x:Static strings:Strings.Instance}}"
                                                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                <views:ColorPickerControl Margin="0,0,0,8"
                                                    HorizontalAlignment="Left"
                                                    Red="{Binding DeviceConfig.AudioMidR, Mode=TwoWay}"
                                                    Green="{Binding DeviceConfig.AudioMidG, Mode=TwoWay}"
                                                    Blue="{Binding DeviceConfig.AudioMidB, Mode=TwoWay}"/>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="36" Height="28" CornerRadius="4"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                                        <Border.Background>
                                                            <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                                                <Binding Path="DeviceConfig.AudioMidR" />
                                                                <Binding Path="DeviceConfig.AudioMidG" />
                                                                <Binding Path="DeviceConfig.AudioMidB" />
                                                            </MultiBinding>
                                                        </Border.Background>
                                                    </Border>
                                                    <DockPanel LastChildFill="True" Visibility="{Binding Visibility, ElementName=AudioMidHexBox}" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <reset:SettingResetButton DockPanel.Dock="Right" Click="ResetAudioColor_Click" Tag="mid" Visibility="{Binding Visibility, ElementName=AudioMidHexBox}" SettingLabel="{Binding ResetLabel_MidColor, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_PadViewModel_AudioMidHexBox_8984"/>
                                                        <TextBox x:Name="AudioMidHexBox" Tag="Mid"
                                                                 FontFamily="{StaticResource TelemetryFontFamily}" Padding="6,2"
                                                                 KeyDown="AudioHexBox_KeyDown"
                                                                 LostFocus="AudioHexBox_LostFocus"
                                                                 ToolTip="{Binding Pad_Lighting_HexTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                    </DockPanel>
                                                </Grid>
                                                <controls:SettingRow MinHeight="44">
                                                    <TextBlock Text="R" Style="{StaticResource DzLabelTight}" Foreground="#FFD32F2F"/>
                                                    <Slider Value="{Binding DeviceConfig.AudioMidR, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding DeviceConfig.AudioMidR, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <ui:Button Command="{Binding DeviceConfig.ResetAudioMidRCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetAudioMidR, Source={x:Static strings:Strings.Instance}}"/>
                                                </controls:SettingRow>
                                                <controls:SettingRow MinHeight="44">
                                                    <TextBlock Text="G" Style="{StaticResource DzLabelTight}" Foreground="#FF388E3C"/>
                                                    <Slider Value="{Binding DeviceConfig.AudioMidG, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding DeviceConfig.AudioMidG, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <ui:Button Command="{Binding DeviceConfig.ResetAudioMidGCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetAudioMidG, Source={x:Static strings:Strings.Instance}}"/>
                                                </controls:SettingRow>
                                                <controls:SettingRow MinHeight="44">
                                                    <TextBlock Text="B" Style="{StaticResource DzLabelTight}" Foreground="#FF1976D2"/>
                                                    <Slider Value="{Binding DeviceConfig.AudioMidB, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding DeviceConfig.AudioMidB, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <ui:Button Command="{Binding DeviceConfig.ResetAudioMidBCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetAudioMidB, Source={x:Static strings:Strings.Instance}}"/>
                                                </controls:SettingRow>
                                            </StackPanel>
                                        </Border>

                                        <!-- HIGH (loud) color -->
                                        <Border Margin="0,0,8,8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Pad_Lighting_AudioLightbar_HighColor, Source={x:Static strings:Strings.Instance}}"
                                                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                <views:ColorPickerControl Margin="0,0,0,8"
                                                    HorizontalAlignment="Left"
                                                    Red="{Binding DeviceConfig.AudioHighR, Mode=TwoWay}"
                                                    Green="{Binding DeviceConfig.AudioHighG, Mode=TwoWay}"
                                                    Blue="{Binding DeviceConfig.AudioHighB, Mode=TwoWay}"/>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="36" Height="28" CornerRadius="4"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                                        <Border.Background>
                                                            <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                                                <Binding Path="DeviceConfig.AudioHighR" />
                                                                <Binding Path="DeviceConfig.AudioHighG" />
                                                                <Binding Path="DeviceConfig.AudioHighB" />
                                                            </MultiBinding>
                                                        </Border.Background>
                                                    </Border>
                                                    <DockPanel LastChildFill="True" Visibility="{Binding Visibility, ElementName=AudioHighHexBox}" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <reset:SettingResetButton DockPanel.Dock="Right" Click="ResetAudioColor_Click" Tag="high" Visibility="{Binding Visibility, ElementName=AudioHighHexBox}" SettingLabel="{Binding ResetLabel_HighColor, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_PadViewModel_AudioHighHexBox_9038"/>
                                                        <TextBox x:Name="AudioHighHexBox" Tag="High"
                                                                 FontFamily="{StaticResource TelemetryFontFamily}" Padding="6,2"
                                                                 KeyDown="AudioHexBox_KeyDown"
                                                                 LostFocus="AudioHexBox_LostFocus"
                                                                 ToolTip="{Binding Pad_Lighting_HexTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                    </DockPanel>
                                                </Grid>
                                                <controls:SettingRow MinHeight="44">
                                                    <TextBlock Text="R" Style="{StaticResource DzLabelTight}" Foreground="#FFD32F2F"/>
                                                    <Slider Value="{Binding DeviceConfig.AudioHighR, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding DeviceConfig.AudioHighR, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <ui:Button Command="{Binding DeviceConfig.ResetAudioHighRCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetAudioHighR, Source={x:Static strings:Strings.Instance}}"/>
                                                </controls:SettingRow>
                                                <controls:SettingRow MinHeight="44">
                                                    <TextBlock Text="G" Style="{StaticResource DzLabelTight}" Foreground="#FF388E3C"/>
                                                    <Slider Value="{Binding DeviceConfig.AudioHighG, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding DeviceConfig.AudioHighG, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <ui:Button Command="{Binding DeviceConfig.ResetAudioHighGCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetAudioHighG, Source={x:Static strings:Strings.Instance}}"/>
                                                </controls:SettingRow>
                                                <controls:SettingRow MinHeight="44">
                                                    <TextBlock Text="B" Style="{StaticResource DzLabelTight}" Foreground="#FF1976D2"/>
                                                    <Slider Value="{Binding DeviceConfig.AudioHighB, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding DeviceConfig.AudioHighB, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <ui:Button Command="{Binding DeviceConfig.ResetAudioHighBCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetAudioHighB, Source={x:Static strings:Strings.Instance}}"/>
                                                </controls:SettingRow>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>

                                </StackPanel>

                                <!-- Input Reactive overlay (v3.2+). Layered on top of the
                                     base mode above: a button-press flashes the chosen
                                     reactive color and decays back to the base. Off keeps
                                     the base mode untouched. Random rolls a hue per press,
                                     Cycle steps through the palette, Fixed flashes its
                                     OWN configured color, independent of the base RGB
                                     (its picker is below). Placed at the bottom of the lightbar
                                     card so the LightbarMode dropdown's mode-specific
                                     settings sit immediately under it without the
                                     InputReactive controls breaking up the visual flow.
                                     Always in view, as the board has it (#574): with
                                     the overlay off it is this one row. -->
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Pad_Lighting_InputReactive, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource DzLabel}"/>
                                    <ComboBox SelectedIndex="{Binding DeviceConfig.InputReactiveMode, Mode=TwoWay, Converter={StaticResource EnumIndexConverter}}"
                                              MaxWidth="444" controls:SettingRow.Fills="True" VerticalAlignment="Center">
                                        <ComboBoxItem Content="{Binding Pad_Lighting_InputReactive_Off, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_InputReactive_Random, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_InputReactive_Cycle, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_InputReactive_Fixed, Source={x:Static strings:Strings.Instance}}"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding DeviceConfig.ResetInputReactiveModeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetInputReactive, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <!-- InputReactive controls. Hold + Decay sliders show whenever
                                     the input-reactive overlay is enabled in any variant
                                     (Random / Cycle / Fixed). Hold may be 0 for instant fade.
                                     Decay may be 0 for clean on/off with no fade. Placed
                                     before the Fixed color picker so the timing controls
                                     (which apply to every variant) read ahead of the
                                     variant-specific color block. -->
                                <StackPanel Visibility="{Binding DeviceConfig.IsInputReactiveActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <TextBlock Text="{Binding Pad_Lighting_InputHold, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <Slider Value="{Binding DeviceConfig.LightbarInputHoldMs, Mode=TwoWay}"
                                                Style="{StaticResource DzSlider}"
                                                Minimum="0" Maximum="5000" TickFrequency="50"/>
                                        <TextBox Text="{Binding DeviceConfig.LightbarInputHoldMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding DeviceConfig.ResetLightbarInputHoldCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetLightbarInputHold, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <TextBlock Text="{Binding Pad_Lighting_InputDecay, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <Slider Value="{Binding DeviceConfig.LightbarInputDecayMs, Mode=TwoWay}"
                                                Style="{StaticResource DzSlider}"
                                                Minimum="0" Maximum="5000" TickFrequency="50"/>
                                        <TextBox Text="{Binding DeviceConfig.LightbarInputDecayMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding DeviceConfig.ResetLightbarInputDecayCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetLightbarInputDecay, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                </StackPanel>

                                <!-- Palette (variable count). Overlay instance.
                                     Visible only when InputReactive = Cycle AND
                                     LightbarMode != ColorCycle (so this never co-renders
                                     with the Base palette instance above). Its own
                                     colors, placed here so the palette sits directly
                                     below the InputReactive dropdown that revealed it. -->
                                <StackPanel Visibility="{Binding DeviceConfig.ShowPaletteForOverlay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Pad_Lighting_PaletteHeader, Source={x:Static strings:Strings.Instance}}"
                                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <!-- Bound to the InputReactive Cycle's OWN palette, separate from the
                                         ColorCycle palette above. Editing one no longer touches the other. -->
                                    <ItemsControl ItemsSource="{Binding DeviceConfig.LightbarInputReactivePalette}" Margin="0,0,0,8">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:LightbarPaletteEntry}">
                                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,8,8"
                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                                    <StackPanel>
                                                        <ui:Button Command="{Binding DataContext.DeviceConfig.RemoveInputReactivePaletteColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   CommandParameter="{Binding}"
                                                                   Style="{StaticResource EmberIconButtonHot}"
                                                                   HorizontalAlignment="Right" Margin="0,0,0,4"
                                                                   ToolTip="{Binding Pad_Lighting_RemoveColor, Source={x:Static strings:Strings.Instance}}">
                                                            <controls:GlyphText Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                        </ui:Button>
                                                        <views:ColorPickerControl HorizontalAlignment="Left" Margin="0,0,0,8"
                                                            Red="{Binding R, Mode=TwoWay}"
                                                            Green="{Binding G, Mode=TwoWay}"
                                                            Blue="{Binding B, Mode=TwoWay}"/>
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Width="36" Height="28" CornerRadius="4"
                                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                                                <Border.Background>
                                                                    <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                                                        <Binding Path="R"/>
                                                                        <Binding Path="G"/>
                                                                        <Binding Path="B"/>
                                                                    </MultiBinding>
                                                                </Border.Background>
                                                            </Border>
                                                            <TextBox Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                     FontFamily="{StaticResource TelemetryFontFamily}" Padding="6,2"
                                                                     Text="{Binding Hex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                     ToolTip="{Binding Pad_Lighting_HexTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                        </Grid>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="R" Style="{StaticResource DzLabelTight}" Foreground="#FFD32F2F"/>
                                                            <Slider Value="{Binding R, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                            <TextBox Text="{Binding R, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="G" Style="{StaticResource DzLabelTight}" Foreground="#FF388E3C"/>
                                                            <Slider Value="{Binding G, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                            <TextBox Text="{Binding G, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="B" Style="{StaticResource DzLabelTight}" Foreground="#FF1976D2"/>
                                                            <Slider Value="{Binding B, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                            <TextBox Text="{Binding B, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Command="{Binding DeviceConfig.AddInputReactivePaletteColorCommand}"
                                                Padding="10,4">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:GlyphText Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Pad_Lighting_AddColor, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DeviceConfig.ResetInputReactivePaletteCommand}"
                                                Margin="8,0,0,0" Padding="10,4"
                                                ToolTip="{Binding Pad_Lighting_ResetPaletteTooltip, Source={x:Static strings:Strings.Instance}}">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:GlyphText Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Pad_Lighting_ResetPalette, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Per-press flash color for the Fixed overlay variant.
                                     Independent of LightbarRed/Green/Blue (which drives
                                     the base mode color), so users can layer a base
                                     color with a different flash color. -->
                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        Visibility="{Binding DeviceConfig.IsInputReactiveFixed, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Pad_Lighting_InputReactive_FixedColor, Source={x:Static strings:Strings.Instance}}"
                                                   FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <views:ColorPickerControl Margin="0,0,0,12"
                                            HorizontalAlignment="Left"
                                            Red="{Binding DeviceConfig.InputReactiveR, Mode=TwoWay}"
                                            Green="{Binding DeviceConfig.InputReactiveG, Mode=TwoWay}"
                                            Blue="{Binding DeviceConfig.InputReactiveB, Mode=TwoWay}"/>
                                        <controls:SettingRow MinHeight="44">
                                            <TextBlock Text="R" Style="{StaticResource DzLabelTight}" Foreground="#FFD32F2F"/>
                                            <Slider Value="{Binding DeviceConfig.InputReactiveR, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                            <TextBox Text="{Binding DeviceConfig.InputReactiveR, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                            <ui:Button Command="{Binding DeviceConfig.ResetInputReactiveRCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarRed, Source={x:Static strings:Strings.Instance}}"/>
                                        </controls:SettingRow>
                                        <controls:SettingRow MinHeight="44">
                                            <TextBlock Text="G" Style="{StaticResource DzLabelTight}" Foreground="#FF388E3C"/>
                                            <Slider Value="{Binding DeviceConfig.InputReactiveG, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                            <TextBox Text="{Binding DeviceConfig.InputReactiveG, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                            <ui:Button Command="{Binding DeviceConfig.ResetInputReactiveGCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarGreen, Source={x:Static strings:Strings.Instance}}"/>
                                        </controls:SettingRow>
                                        <controls:SettingRow MinHeight="44">
                                            <TextBlock Text="B" Style="{StaticResource DzLabelTight}" Foreground="#FF1976D2"/>
                                            <Slider Value="{Binding DeviceConfig.InputReactiveB, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                            <TextBox Text="{Binding DeviceConfig.InputReactiveB, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                            <ui:Button Command="{Binding DeviceConfig.ResetInputReactiveBCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarBlue, Source={x:Static strings:Strings.Instance}}"/>
                                        </controls:SettingRow>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- LED Strips (#557): how many LEDs each strip of a device has,
                             for a device that drives strips of a length only its user knows
                             (LightMap.Strips: ASUS Aura headers, Cooler Master's ARGB
                             controllers, the Razer ARGB controller, GaiZhongGai's hubs). A
                             row per strip, as the Lighting Hold row is laid out: the label
                             column is 210, the box the app's proven NumberBox width of 200
                             (Dashboard port boxes), and a reset for the row. Above Key
                             Colors, since a count changes the lights that card shows. -->
                        <Border x:Name="LedStripsCard" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Pad_Lighting_LedStrips, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"
                                               ToolTip="{Binding Pad_Lighting_LedStrips_Description, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Command="{Binding DeviceConfig.ResetLedStripCountsCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_Lighting_LedStrips_ResetAll, Source={x:Static strings:Strings.Instance}}"/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding LedStrips.Rows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource DzLabel}"/>
                                                <ui:NumberBox MaxWidth="200" controls:SettingRow.Fills="True" Minimum="0" Maximum="{Binding Maximum}" SmallChange="1" VerticalAlignment="Center"
                                                              Value="{Binding Leds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              ToolTip="{Binding Pad_Lighting_LedStrips_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                              AutomationProperties.Name="{Binding Label, TargetNullValue=''}"/>
                                                <reset:SettingResetButton Command="{Binding ResetCountCommand}" SettingLabel="{Binding Label}" AutomationProperties.AutomationId="Reset_DeviceSlotConfig_LedStripCount"/>
                                            </controls:SettingRow>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Key Colors, Zone Colors for a device whose lights
                             are zones (#557): the selected device's lights
                             one by one, per shift layer, written into the
                             device's config for this controller
                             (DeviceSlotConfig.KeyLighting through
                             PadViewModel.KeyColors) the way the Lightbar card
                             writes its mode. Shown by SyncTabVisibility for a
                             lit mouse, keyboard or vendor row whose path
                             knows its lights one by one (PeripheralLightMaps).
                             The layer chips are the Mappings tab's shift
                             layer chips with a pick of their own, so the
                             layer being colored never moves the layer being
                             mapped. The picture is built in code
                             (KeyLightsView), as the Keyboard + Mouse preview
                             is. Both color blocks are the Lightbar card's
                             single-color block: picker, swatches, hex box,
                             R/G/B rows. A color change reaches the selected
                             lights at once, and Apply Color gives lights
                             picked later the color as it stands. -->
                        <Border x:Name="KeyColorsCard" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                            <Border.Resources>
                                <!-- The Lightbar card's swatch, one style for the eight. -->
                                <Style x:Key="KeyColorSwatch" TargetType="controls:ClickBorder">
                                    <Setter Property="Width" Value="24"/>
                                    <Setter Property="Height" Value="24"/>
                                    <Setter Property="CornerRadius" Value="6"/>
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="ClickMode" Value="Press"/>
                                    <Setter Property="Background" Value="{DynamicResource SteelRaisedBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource SteelLineSoftBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource ColdBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style x:Key="KeyColorButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Padding" Value="10,4"/>
                                    <Setter Property="Margin" Value="0,0,6,6"/>
                                </Style>
                            </Border.Resources>
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding KeyColors.Title}" Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding DeviceConfig.ResetKeyLightingCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_Lighting_KeyColors_ResetAll_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                </DockPanel>
                                <TextBlock Text="{Binding KeyColors.Description}" Style="{StaticResource CardDescription}"/>

                                <!-- The layer being colored. -->
                                <ItemsControl ItemsSource="{Binding KeyColors.Layers}" Margin="0,0,0,8"
                                              Visibility="{Binding KeyColors.HasLayers, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:KeyColorLayerItem}">
                                            <RadioButton GroupName="KeyColorLayers"
                                                         Style="{StaticResource ShiftLayerTabChip}"
                                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                         Margin="0,0,4,4"
                                                         Padding="10,4"
                                                         Click="KeyColorLayer_Click"
                                                         Tag="{Binding LayerMask}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                                             Fill="{Binding Color, Converter={StaticResource HexToBrushConverter}}">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsBase}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding LayerName}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- What the layer's other lights show. A shift
                                     layer starts on the Base layer's colors. -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Pad_Lighting_KeyColors_Others, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource DzLabel}"/>
                                    <ComboBox ItemsSource="{Binding KeyColors.BackgroundChoices}"
                                              DisplayMemberPath="Label" SelectedValuePath="Rule"
                                              SelectedValue="{Binding KeyColors.BackgroundRule, Mode=TwoWay}"
                                              Width="340" VerticalAlignment="Center"
                                              ToolTip="{Binding Pad_Lighting_KeyColors_Others_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                              AutomationProperties.Name="{Binding Pad_Lighting_KeyColors_Others, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12"
                                        HorizontalAlignment="Left"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        Visibility="{Binding KeyColors.BackgroundIsColor, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <views:ColorPickerControl Margin="0,0,0,12" HorizontalAlignment="Left"
                                            Red="{Binding KeyColors.BackgroundRed, Mode=TwoWay}"
                                            Green="{Binding KeyColors.BackgroundGreen, Mode=TwoWay}"
                                            Blue="{Binding KeyColors.BackgroundBlue, Mode=TwoWay}"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="48" Height="36" CornerRadius="4" HorizontalAlignment="Left"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                                        <Binding Path="KeyColors.BackgroundRed"/>
                                                        <Binding Path="KeyColors.BackgroundGreen"/>
                                                        <Binding Path="KeyColors.BackgroundBlue"/>
                                                    </MultiBinding>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Grid.Column="1" Text="{Binding Pad_Lighting_Hex, Source={x:Static strings:Strings.Instance}}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            <TextBox Grid.Column="2" Width="100" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                     FontFamily="{StaticResource TelemetryFontFamily}" Padding="6,4"
                                                     Text="{Binding KeyColors.BackgroundHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     KeyDown="KeyColorsHexBox_KeyDown"
                                                     ToolTip="{Binding Pad_Lighting_HexTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="R" Style="{StaticResource DzLabelTight}" Foreground="#FFD32F2F"/>
                                            <Slider Value="{Binding KeyColors.BackgroundRed, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                            <TextBox Text="{Binding KeyColors.BackgroundRed, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="G" Style="{StaticResource DzLabelTight}" Foreground="#FF388E3C"/>
                                            <Slider Value="{Binding KeyColors.BackgroundGreen, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                            <TextBox Text="{Binding KeyColors.BackgroundGreen, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="B" Style="{StaticResource DzLabelTight}" Foreground="#FF1976D2"/>
                                            <Slider Value="{Binding KeyColors.BackgroundBlue, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                            <TextBox Text="{Binding KeyColors.BackgroundBlue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- The picture, built in code. -->
                                <views:KeyLightsView Source="{Binding KeyColors}" HorizontalAlignment="Left" Margin="0,0,0,4"
                                                     AutomationProperties.Name="{Binding KeyColors.Title, TargetNullValue=''}"/>
                                <TextBlock Text="{Binding Pad_Lighting_KeyColors_PickHint, Source={x:Static strings:Strings.Instance}}"
                                           Foreground="{DynamicResource EmberBrush}" TextWrapping="Wrap" Margin="0,0,0,4"
                                           Visibility="{Binding KeyColors.PickByPressing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding KeyColors.SelectionSummary}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,0,8"/>

                                <!-- Selecting. -->
                                <WrapPanel Margin="0,0,0,6">
                                    <Button Style="{StaticResource KeyColorButton}" Command="{Binding KeyColors.SelectAllKeysCommand}"
                                            Content="{Binding Pad_Lighting_KeyColors_SelectAllKeys, Source={x:Static strings:Strings.Instance}}"
                                            Visibility="{Binding KeyColors.HasKeys, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Button Style="{StaticResource KeyColorButton}" Command="{Binding KeyColors.SelectNumberRowCommand}"
                                            Content="{Binding Pad_Lighting_KeyColors_SelectNumberRow, Source={x:Static strings:Strings.Instance}}"
                                            Visibility="{Binding KeyColors.HasKeys, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Button Style="{StaticResource KeyColorButton}" Command="{Binding KeyColors.SelectFunctionKeysCommand}"
                                            Content="{Binding Pad_Lighting_KeyColors_SelectFunctionKeys, Source={x:Static strings:Strings.Instance}}"
                                            Visibility="{Binding KeyColors.HasKeys, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Button Style="{StaticResource KeyColorButton}" Command="{Binding KeyColors.SelectNumberPadCommand}"
                                            Content="{Binding Pad_Lighting_KeyColors_SelectNumberPad, Source={x:Static strings:Strings.Instance}}"
                                            Visibility="{Binding KeyColors.HasKeys, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Button Style="{StaticResource KeyColorButton}" Command="{Binding KeyColors.SelectArrowsCommand}"
                                            Content="{Binding Pad_Lighting_KeyColors_SelectArrows, Source={x:Static strings:Strings.Instance}}"
                                            Visibility="{Binding KeyColors.HasKeys, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Button Style="{StaticResource KeyColorButton}" Command="{Binding KeyColors.SelectWasdCommand}"
                                            Content="{Binding Pad_Lighting_KeyColors_SelectWasd, Source={x:Static strings:Strings.Instance}}"
                                            Visibility="{Binding KeyColors.HasKeys, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Button Style="{StaticResource KeyColorButton}" Command="{Binding KeyColors.SelectEdgeCommand}"
                                            Content="{Binding Pad_Lighting_KeyColors_Edge, Source={x:Static strings:Strings.Instance}}"
                                            Visibility="{Binding KeyColors.HasEdge, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Button Style="{StaticResource KeyColorButton}" Command="{Binding KeyColors.SelectLogoCommand}"
                                            Content="{Binding Pad_Lighting_KeyColors_Logo, Source={x:Static strings:Strings.Instance}}"
                                            Visibility="{Binding KeyColors.HasLogo, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Button Style="{StaticResource KeyColorButton}" Command="{Binding KeyColors.SelectAllLightsCommand}"
                                            Content="{Binding Pad_Lighting_KeyColors_SelectAllLights, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Style="{StaticResource KeyColorButton}" Command="{Binding KeyColors.ClearSelectionCommand}"
                                            Content="{Binding Pad_Lighting_KeyColors_ClearSelection, Source={x:Static strings:Strings.Instance}}"/>
                                    <ToggleButton Padding="10,4" Margin="0,0,6,6"
                                                  IsChecked="{Binding KeyColors.PickByPressing, Mode=TwoWay}"
                                                  Content="{Binding Pad_Lighting_KeyColors_PickByPressing, Source={x:Static strings:Strings.Instance}}"
                                                  ToolTip="{Binding Pad_Lighting_KeyColors_PickByPressing_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                  Visibility="{Binding KeyColors.HasKeys, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </WrapPanel>

                                <!-- The color the selection takes. -->
                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                    <StackPanel>
                                        <views:ColorPickerControl Margin="0,0,0,12" HorizontalAlignment="Left"
                                            Red="{Binding KeyColors.PaintRed, Mode=TwoWay}"
                                            Green="{Binding KeyColors.PaintGreen, Mode=TwoWay}"
                                            Blue="{Binding KeyColors.PaintBlue, Mode=TwoWay}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                                            <controls:ClickBorder Style="{StaticResource KeyColorSwatch}" Tag="0000FF" ToolTip="#0000FF" Click="KeyColorSwatch_Click">
                                                <Border CornerRadius="3" Margin="3" Background="#FF0000FF" IsHitTestVisible="False"/>
                                            </controls:ClickBorder>
                                            <controls:ClickBorder Style="{StaticResource KeyColorSwatch}" Tag="FF0000" ToolTip="#FF0000" Click="KeyColorSwatch_Click">
                                                <Border CornerRadius="3" Margin="3" Background="#FFFF0000" IsHitTestVisible="False"/>
                                            </controls:ClickBorder>
                                            <controls:ClickBorder Style="{StaticResource KeyColorSwatch}" Tag="00FF00" ToolTip="#00FF00" Click="KeyColorSwatch_Click">
                                                <Border CornerRadius="3" Margin="3" Background="#FF00FF00" IsHitTestVisible="False"/>
                                            </controls:ClickBorder>
                                            <controls:ClickBorder Style="{StaticResource KeyColorSwatch}" Tag="FF00FF" ToolTip="#FF00FF" Click="KeyColorSwatch_Click">
                                                <Border CornerRadius="3" Margin="3" Background="#FFFF00FF" IsHitTestVisible="False"/>
                                            </controls:ClickBorder>
                                            <controls:ClickBorder Style="{StaticResource KeyColorSwatch}" Tag="FFBF00" ToolTip="#FFBF00" Click="KeyColorSwatch_Click">
                                                <Border CornerRadius="3" Margin="3" Background="#FFFFBF00" IsHitTestVisible="False"/>
                                            </controls:ClickBorder>
                                            <controls:ClickBorder Style="{StaticResource KeyColorSwatch}" Tag="00FFFF" ToolTip="#00FFFF" Click="KeyColorSwatch_Click">
                                                <Border CornerRadius="3" Margin="3" Background="#FF00FFFF" IsHitTestVisible="False"/>
                                            </controls:ClickBorder>
                                            <controls:ClickBorder Style="{StaticResource KeyColorSwatch}" Tag="FFFFFF" ToolTip="#FFFFFF" Click="KeyColorSwatch_Click">
                                                <Border CornerRadius="3" Margin="3" Background="#FFFFFFFF" IsHitTestVisible="False"/>
                                            </controls:ClickBorder>
                                            <controls:ClickBorder Style="{StaticResource KeyColorSwatch}" Tag="FF6B2C" ToolTip="#FF6B2C" Click="KeyColorSwatch_Click">
                                                <Border CornerRadius="3" Margin="3" Background="#FFFF6B2C" IsHitTestVisible="False"/>
                                            </controls:ClickBorder>
                                        </StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="48" Height="36" CornerRadius="4" HorizontalAlignment="Left"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                                        <Binding Path="KeyColors.PaintRed"/>
                                                        <Binding Path="KeyColors.PaintGreen"/>
                                                        <Binding Path="KeyColors.PaintBlue"/>
                                                    </MultiBinding>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Grid.Column="1" Text="{Binding Pad_Lighting_Hex, Source={x:Static strings:Strings.Instance}}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            <TextBox Grid.Column="2" Width="100" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                     FontFamily="{StaticResource TelemetryFontFamily}" Padding="6,4"
                                                     Text="{Binding KeyColors.PaintHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     KeyDown="KeyColorsHexBox_KeyDown"
                                                     ToolTip="{Binding Pad_Lighting_HexTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="R" Style="{StaticResource DzLabelTight}" Foreground="#FFD32F2F"/>
                                            <Slider Value="{Binding KeyColors.PaintRed, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                            <TextBox Text="{Binding KeyColors.PaintRed, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="G" Style="{StaticResource DzLabelTight}" Foreground="#FF388E3C"/>
                                            <Slider Value="{Binding KeyColors.PaintGreen, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                            <TextBox Text="{Binding KeyColors.PaintGreen, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="B" Style="{StaticResource DzLabelTight}" Foreground="#FF1976D2"/>
                                            <Slider Value="{Binding KeyColors.PaintBlue, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                            <TextBox Text="{Binding KeyColors.PaintBlue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Coloring. -->
                                <WrapPanel>
                                    <Button Style="{StaticResource KeyColorButton}" Command="{Binding KeyColors.ApplyColorCommand}"
                                            IsEnabled="{Binding KeyColors.HasSelection}"
                                            ToolTip="{Binding Pad_Lighting_KeyColors_ApplyColor_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:GlyphText Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Pad_Lighting_KeyColors_ApplyColor, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource KeyColorButton}" Command="{Binding KeyColors.ClearSelectedColorsCommand}"
                                            IsEnabled="{Binding KeyColors.HasSelection}"
                                            ToolTip="{Binding Pad_Lighting_KeyColors_RemoveColor_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:GlyphText Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Pad_Lighting_KeyColors_RemoveColor, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource KeyColorButton}" Command="{Binding KeyColors.ClearLayerCommand}"
                                            ToolTip="{Binding Pad_Lighting_KeyColors_ClearLayer_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:GlyphText Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Pad_Lighting_KeyColors_ClearLayer, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <controls:FoldList Gap="12">
                        <!-- Indicator LEDs. Player number row + mic mute LED.
                             Grouped under one section because they share the
                             firmware's single brightness register (byte 42).
                             OpenRGB shows brightness as a property of every
                             mode (Direct / Mic Off / Mic Pulse) for the same
                             reason. There's only one register on the device.
                             DualSense / DualSense Edge only. DS4 has neither
                             player LEDs nor a mic LED, so the card is hidden
                             on DS4 slots via SyncTabVisibility. -->
                        <controls:FoldCard x:Name="IndicatorLedsCard" StateKey="Pad.Lights.Indicators"
                                           Header="{Binding Pad_Lighting_IndicatorLeds, Source={x:Static strings:Strings.Instance}}"
                                           Hint="{Binding Pad_IndicatorLeds_FoldHint, Source={x:Static strings:Strings.Instance}}"
                                           Description="{Binding Pad_Lighting_IndicatorLeds_Subtitle, Source={x:Static strings:Strings.Instance}}">
                            <controls:FoldCard.HeaderAction>
                                <ui:Button Command="{Binding DeviceConfig.ResetIndicatorLedsAllCommand}" Style="{StaticResource ResetAllButton}"
                                        Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}"
                                        ToolTip="{Binding Pad_ResetIndicatorLeds, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:FoldCard.HeaderAction>
                            <!-- The line ends with the brightness that is set, by
                                 the name its picker shows. The names are in the
                                 picker's order. -->
                            <controls:FoldCard.Summary>
                                <MultiBinding Converter="{StaticResource IndexTextConverter}">
                                    <Binding Path="DeviceConfig.PlayerLedBrightness"/>
                                    <Binding Path="Pad_Lighting_PlayerLed_Brightness_High" Source="{x:Static strings:Strings.Instance}"/>
                                    <Binding Path="Pad_Lighting_PlayerLed_Brightness_Medium" Source="{x:Static strings:Strings.Instance}"/>
                                    <Binding Path="Pad_Lighting_PlayerLed_Brightness_Low" Source="{x:Static strings:Strings.Instance}"/>
                                </MultiBinding>
                            </controls:FoldCard.Summary>
                            <StackPanel>

                                <!-- Shared brightness. Physically writes byte 42
                                     ledBrightness, which the DS5 firmware uses
                                     for the player LED row. Mute LED has only
                                     mode (Off / Solid / Pulse). No register. -->
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Pad_Lighting_LedBrightness, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <!-- Combo width standard: all four combos in this card
                                         share 340. Measured, not guessed: a real WPF-UI
                                         ComboBox rendered with this card's implicit style
                                         (BasedOn DefaultComboBoxStyle, Padding 8,4) and the
                                         Body font sizes the widest option, the Spanish
                                         player pattern "Numero de jugador (predeterminado)"
                                         WITH the 5-pip prefix, to 330.67px. 340 leaves
                                         about 9px of slack. Re-measure if these strings or
                                         the pip row change (tools/combomeasure). -->
                                    <ComboBox SelectedIndex="{Binding DeviceConfig.PlayerLedBrightness, Mode=TwoWay, Converter={StaticResource EnumIndexConverter}}"
                                              MaxWidth="340" controls:SettingRow.Fills="True" VerticalAlignment="Center">
                                        <ComboBoxItem Content="{Binding Pad_Lighting_PlayerLed_Brightness_High, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_PlayerLed_Brightness_Medium, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_PlayerLed_Brightness_Low, Source={x:Static strings:Strings.Instance}}"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding DeviceConfig.ResetPlayerLedBrightnessCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetLedBrightness, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <!-- Player pattern. Every option renders its own 5-dot
                                     pip row (#175 competitor item 6): lit pips ember,
                                     unlit pips steel outlines, mirroring the wire
                                     patterns the synthesizer drives at byte 43
                                     (Ds5EffectSynthesizer.PlayerLedBits: Off=0x00,
                                     P1=0x04, P2=0x0A, P3=0x15, P4=0x1B, All=0x1F, bit N
                                     lighting LED N of the 5-LED strip below the
                                     touchpad). Pips live in each item's ContentTemplate
                                     rather than as element Content, so the closed
                                     combo's selection box instantiates its own copy of
                                     the template instead of stealing the popup item's
                                     visual. Content stays the localized string. -->
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Pad_Lighting_PlayerPattern, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <!-- SelectedValue + Tag binding (the LightbarMode combo's
                                         pattern): PlayerNumber (6) leads the list while Off (0)
                                         stays second, so item index no longer equals enum
                                         value and EnumIndexConverter can't apply. -->
                                    <ComboBox SelectedValue="{Binding DeviceConfig.PlayerLedMode, Mode=TwoWay}"
                                              SelectedValuePath="Tag"
                                              MaxWidth="340" controls:SettingRow.Fills="True" VerticalAlignment="Center">
                                        <ComboBox.Resources>
                                            <Style x:Key="LedPipOn" TargetType="Ellipse">
                                                <Setter Property="Width" Value="6"/>
                                                <Setter Property="Height" Value="6"/>
                                                <Setter Property="Margin" Value="0,0,3,0"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                            </Style>
                                            <Style x:Key="LedPipOff" TargetType="Ellipse" BasedOn="{StaticResource LedPipOn}">
                                                <Setter Property="Fill" Value="Transparent"/>
                                                <Setter Property="Stroke" Value="{DynamicResource SteelLineBrush}"/>
                                                <Setter Property="StrokeThickness" Value="1"/>
                                            </Style>
                                            <!-- Auto pip: hollow like Off but ember-stroked, reading
                                                 as "lights up, pattern follows the player number". -->
                                            <Style x:Key="LedPipAuto" TargetType="Ellipse" BasedOn="{StaticResource LedPipOff}">
                                                <Setter Property="Stroke" Value="{DynamicResource EmberBrush}"/>
                                            </Style>
                                        </ComboBox.Resources>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_PlayerLed_PlayerNumber, Source={x:Static strings:Strings.Instance}}"
                                                      Tag="{x:Static vm:PlayerLedMode.PlayerNumber}">
                                            <ComboBoxItem.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <Ellipse Style="{StaticResource LedPipAuto}"/>
                                                            <Ellipse Style="{StaticResource LedPipAuto}"/>
                                                            <Ellipse Style="{StaticResource LedPipAuto}"/>
                                                            <Ellipse Style="{StaticResource LedPipAuto}"/>
                                                            <Ellipse Style="{StaticResource LedPipAuto}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBoxItem.ContentTemplate>
                                        </ComboBoxItem>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_PlayerLed_Off, Source={x:Static strings:Strings.Instance}}"
                                                      Tag="{x:Static vm:PlayerLedMode.Off}">
                                            <ComboBoxItem.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBoxItem.ContentTemplate>
                                        </ComboBoxItem>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_PlayerLed_P1, Source={x:Static strings:Strings.Instance}}"
                                                      Tag="{x:Static vm:PlayerLedMode.Player1}">
                                            <ComboBoxItem.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBoxItem.ContentTemplate>
                                        </ComboBoxItem>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_PlayerLed_P2, Source={x:Static strings:Strings.Instance}}"
                                                      Tag="{x:Static vm:PlayerLedMode.Player2}">
                                            <ComboBoxItem.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBoxItem.ContentTemplate>
                                        </ComboBoxItem>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_PlayerLed_P3, Source={x:Static strings:Strings.Instance}}"
                                                      Tag="{x:Static vm:PlayerLedMode.Player3}">
                                            <ComboBoxItem.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBoxItem.ContentTemplate>
                                        </ComboBoxItem>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_PlayerLed_P4, Source={x:Static strings:Strings.Instance}}"
                                                      Tag="{x:Static vm:PlayerLedMode.Player4}">
                                            <ComboBoxItem.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBoxItem.ContentTemplate>
                                        </ComboBoxItem>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_PlayerLed_All, Source={x:Static strings:Strings.Instance}}"
                                                      Tag="{x:Static vm:PlayerLedMode.All}">
                                            <ComboBoxItem.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBoxItem.ContentTemplate>
                                        </ComboBoxItem>
                                        <!-- Battery: a bar filling from the left, one pip
                                             per fifth of the charge
                                             (Ds5EffectSynthesizer.BatteryPips). The label is
                                             the Guide light's Battery Level string. -->
                                        <ComboBoxItem Content="{Binding Pad_Lighting_GuideLed_Battery, Source={x:Static strings:Strings.Instance}}"
                                                      Tag="{x:Static vm:PlayerLedMode.Battery}">
                                            <ComboBoxItem.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                            <Ellipse Style="{StaticResource LedPipOn}"/>
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                            <Ellipse Style="{StaticResource LedPipOff}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBoxItem.ContentTemplate>
                                        </ComboBoxItem>
                                    </ComboBox>
                                    <ui:Button Command="{Binding DeviceConfig.ResetPlayerLedModeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetPlayerPattern, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <!-- Mute LED mode -->
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Pad_Lighting_MuteLedMode, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ComboBox SelectedIndex="{Binding DeviceConfig.MicLedMode, Mode=TwoWay, Converter={StaticResource EnumIndexConverter}}"
                                              MaxWidth="340" controls:SettingRow.Fills="True" VerticalAlignment="Center">
                                        <ComboBoxItem Content="{Binding Pad_Lighting_MicLed_Off, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_MicLed_Solid, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_MicLed_Pulse, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_MicLed_FollowDevice, Source={x:Static strings:Strings.Instance}}"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding DeviceConfig.ResetMicLedModeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetMuteLedMode, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <!-- Audio endpoint picker, only visible when MicLed mode
                                     is FollowDeviceMute. Lists every active input + output
                                     endpoint (each prefixed [In] / [Out]). The synthesizer
                                     polls the picked endpoint's mute state at 4 Hz and
                                     drives the LED Solid (muted) or Off (unmuted). The
                                     DropDownOpened handler refreshes the list so unplug /
                                     replug between settings opens is reflected. -->
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44"
                                            Visibility="{Binding DeviceConfig.IsMicLedFollowDevice, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Pad_Lighting_MicLed_FollowDevice_Picker, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ComboBox x:Name="MicLedDevicePicker"
                                              ItemsSource="{Binding DeviceConfig.MicLedAvailableDevices}"
                                              DisplayMemberPath="Display"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding DeviceConfig.MicLedFollowDeviceId, Mode=TwoWay}"
                                              DropDownOpened="MicLedDevicePicker_DropDownOpened"
                                              MaxWidth="340" controls:SettingRow.Fills="True" VerticalAlignment="Center"/>
                                    <reset:SettingResetButton Command="{Binding DeviceConfig.ResetSettingCommand}" CommandParameter="MicLedFollowDeviceId" Visibility="{Binding Visibility, ElementName=MicLedDevicePicker}" SettingLabel="{Binding Pad_Lighting_MicLed_FollowDevice_Picker, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DeviceSlotConfig_MicLedFollowDeviceId_9489"/>
                                </controls:SettingRow>
                            </StackPanel>
                        </controls:FoldCard>

                        <!-- Lighting Control (#494, #557): whether this slot
                             lights a mouse or keyboard row at all, and how
                             firmly. The switch is per (slot, device) and
                             starts off, so assigning a keyboard for its keys
                             never repaints it. A vendor row or a unit row has
                             no card: lighting is all it carries. A card of its
                             own, as every setting on the tab sits in one: the
                             Lighting Hold row's label column, measured below,
                             is not the Lightbar card's. Shown by
                             SyncTabVisibility with the switch. -->
                        <controls:FoldCard x:Name="PeripheralLightingCard" StateKey="Pad.Lights.Control" Visibility="Collapsed"
                                           Header="{Binding Pad_Lighting_ControlCard, Source={x:Static strings:Strings.Instance}}"
                                           Hint="{Binding Pad_LightingControl_FoldHint, Source={x:Static strings:Strings.Instance}}">
                            <controls:FoldCard.Summary>
                                <MultiBinding Converter="{StaticResource OnOffTextConverter}">
                                    <Binding Path="DeviceConfig.PeripheralLightingEnabled"/>
                                    <Binding Path="Common_On" Source="{x:Static strings:Strings.Instance}"/>
                                    <Binding Path="Common_Off" Source="{x:Static strings:Strings.Instance}"/>
                                </MultiBinding>
                            </controls:FoldCard.Summary>
                            <StackPanel>
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44" x:Name="PeripheralLightingControlRow">
                                    <TextBlock Text="{Binding Pad_Lighting_ControlDevice, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <CheckBox Style="{StaticResource SwitchCheckBox}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              IsChecked="{Binding DeviceConfig.PeripheralLightingEnabled, Mode=TwoWay}"
                                              Content="{Binding Pad_Lighting_ControlDevice, Source={x:Static strings:Strings.Instance}}"
                                              ToolTip="{Binding Pad_Lighting_ControlDevice_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <reset:SettingResetButton Command="{Binding DeviceConfig.ResetPeripheralLightingEnabledCommand}" SettingLabel="{Binding Pad_Lighting_ControlDevice, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DeviceSlotConfig_PeripheralLightingEnabled"/>
                                </controls:SettingRow>
                                <!-- Lighting Hold (#494): how firmly this slot may
                                     hold the device while it lights it, for a
                                     Logitech device whose own power saving or saved
                                     profile takes the color away. Per (slot, device)
                                     like the switch above, and at its first option
                                     until this tab says more. Shown for a device
                                     that offers a hold, with the last option only
                                     where the device offers that one, and with the
                                     tooltip that stops before that option where it
                                     does not (SyncTabVisibility). A vendor row or a
                                     unit row never shows it.
                                     Widths, measured (tools/combomeasure): the
                                     widest option is the Spanish last one at
                                     525.33px, so 534 leaves about 9px of slack, as
                                     the Base Color card's pickers have. The label
                                     takes the page's label column, 230 wide, so the
                                     picker starts where every row's control starts.
                                     The widest label is the Spanish one at 158px.
                                     Re-measure if these strings change.
                                     Typing a letter selects nothing here: it would
                                     select the last option where that one is out
                                     of the list. -->
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44" x:Name="PeripheralClaimLevelRow" Visibility="Collapsed">
                                    <TextBlock Text="{Binding Pad_Lighting_ClaimLevel, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource DzLabel}"/>
                                    <ComboBox x:Name="PeripheralClaimLevelPicker"
                                              SelectedIndex="{Binding DeviceConfig.PeripheralClaimLevel, Mode=TwoWay, Converter={StaticResource EnumIndexConverter}}"
                                              MaxWidth="534" controls:SettingRow.Fills="True" VerticalAlignment="Center" IsTextSearchEnabled="False"
                                              ToolTip="{Binding Pad_Lighting_ClaimLevel_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                              AutomationProperties.AutomationId="PeripheralClaimLevelCombo"
                                              AutomationProperties.Name="{Binding Pad_Lighting_ClaimLevel, Source={x:Static strings:Strings.Instance}}">
                                        <ComboBoxItem AutomationProperties.AutomationId="PeripheralClaimLevelColorsItem" Content="{Binding Pad_Lighting_ClaimLevel_Colors, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem AutomationProperties.AutomationId="PeripheralClaimLevelPowerItem" Content="{Binding Pad_Lighting_ClaimLevel_Power, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem x:Name="PeripheralClaimLevelHostModeItem" AutomationProperties.AutomationId="PeripheralClaimLevelHostModeItem" Content="{Binding Pad_Lighting_ClaimLevel_HostMode, Source={x:Static strings:Strings.Instance}}"/>
                                    </ComboBox>
                                    <reset:SettingResetButton Command="{Binding DeviceConfig.ResetPeripheralClaimLevelCommand}" SettingLabel="{Binding Pad_Lighting_ClaimLevel, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_DeviceSlotConfig_PeripheralClaimLevel"/>
                                </controls:SettingRow>
                            </StackPanel>
                        </controls:FoldCard>

                        <!-- Guide Button LED (#209): the glowing Guide /
                             Home button on Xbox One-and-later pads (USB
                             only, via the \\.\XboxGIP GIP LED command),
                             the 2015 Steam Controller (SDL's process-global
                             home-LED hint, so every 2015 SC in the process
                             shares one brightness), and the Switch home LED
                             population (#226: Pro Controller, right Joy-Con,
                             combined pair, charging grip, each through per-device
                             SDL_SetJoystickLED at variable 4-bit intensity).
                             Shown by SyncTabVisibility when the selected
                             device is XInput-pathed, a 2015 Steam
                             Controller, or a Switch home-LED device. The
                             lightbar card and header hints hide when the
                             tab is up for a guide-LED-only device. -->
                        <controls:FoldCard x:Name="GuideLedCard" StateKey="Pad.Lights.Guide" Visibility="Collapsed"
                                           Header="{Binding Pad_Lighting_GuideLed, Source={x:Static strings:Strings.Instance}}"
                                           Hint="{Binding Pad_GuideLed_FoldHint, Source={x:Static strings:Strings.Instance}}"
                                           Description="{Binding Pad_Lighting_GuideLed_Subtitle, Source={x:Static strings:Strings.Instance}}">
                            <controls:FoldCard.HeaderAction>
                                <ui:Button Command="{Binding DeviceConfig.ResetGuideLedAllCommand}" Style="{StaticResource ResetAllButton}"
                                        Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}"
                                        ToolTip="{Binding Pad_ResetGuideLed, Source={x:Static strings:Strings.Instance}}"/>
                            </controls:FoldCard.HeaderAction>
                            <StackPanel>

                                <!-- Mode. Sequential enum, so SelectedIndex +
                                     EnumIndexConverter like the brightness combo
                                     on the indicator-LEDs card. -->
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Pad_Lighting_Mode, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ComboBox SelectedIndex="{Binding DeviceConfig.GuideLedMode, Mode=TwoWay, Converter={StaticResource EnumIndexConverter}}"
                                              MaxWidth="340" controls:SettingRow.Fills="True" VerticalAlignment="Center"
                                              ToolTip="{Binding Pad_Lighting_GuideLed_Mode_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                        <ComboBoxItem Content="{Binding Pad_Lighting_GuideLed_DeviceDefault, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_GuideLed_Fixed, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_GuideLed_Battery, Source={x:Static strings:Strings.Instance}}"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding DeviceConfig.ResetGuideLedModeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetGuideLedMode, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <!-- Brightness, Fixed mode only. Battery mode
                                     derives its level from the charge percent. -->
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44"
                                            Visibility="{Binding DeviceConfig.IsGuideLedFixed, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Pad_Lighting_GuideLed_Brightness, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding DeviceConfig.GuideLedBrightness, Mode=TwoWay}" Minimum="0" Maximum="100"
                                            MinWidth="60" VerticalAlignment="Center"
                                            ToolTip="{Binding Pad_Lighting_GuideLed_Brightness_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding DeviceConfig.GuideLedBrightness, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding DeviceConfig.ResetGuideLedBrightnessCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetGuideLedBrightness, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>
                            </StackPanel>
                        </controls:FoldCard>
                        </controls:FoldList>

                    </StackPanel>
                    </GroupBox>

            <!-- === TAB 12: Audio (slot-level, issue #83) === -->
                    <GroupBox x:Name="TabAudio" Visibility="Collapsed" Style="{StaticResource BareGroupBox}"
                              AutomationProperties.Name="{Binding Pad_Audio_Header, Source={x:Static strings:Strings.Instance}}">
                    <StackPanel>
                        <TextBlock AutomationProperties.AutomationId="TabAudio" Text="{Binding Pad_Audio_Header, Source={x:Static strings:Strings.Instance}}"
                                   Style="{StaticResource SectionTitle}" Margin="0,0,0,12" HorizontalAlignment="Left"
                                   ToolTip="{Binding Pad_Audio_Subtitle, Source={x:Static strings:Strings.Instance}}"/>

                        <!-- Sound Output card -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Pad_Audio_Output_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"
                                               ToolTip="{Binding Pad_Audio_Output_Desc, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Command="{Binding ResetSoundOutputAllCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_Audio_Reset_All, Source={x:Static strings:Strings.Instance}}"/>
                                </DockPanel>

                                <TextBlock Text="{Binding Pad_Audio_NoSpeaker, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}"
                                           Visibility="{Binding SelectedDeviceHasNoSpeaker, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                    <TextBlock Text="{Binding Pad_Audio_MasterVolume, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding SoundMasterVolume, Mode=TwoWay}" Minimum="0" Maximum="100" Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding SoundMasterVolume, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetSoundMasterVolumeCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_Audio_Reset_MasterVolume, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <!-- Per assigned device, by convention: this toggle (and the
                                     speaker routing of macro sounds) follows the device selected
                                     in the assigned-devices dropdown. No output picker. -->
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44"
                                            Visibility="{Binding SelectedDeviceHasSpeaker, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Pad_Audio_Mirror, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}" Width="290"/>
                                    <CheckBox Style="{StaticResource SwitchCheckBox}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsChecked="{Binding DeviceConfig.AudioPassthroughEnabled, Mode=TwoWay}"
                                              Content="{Binding Pad_Audio_Mirror, Source={x:Static strings:Strings.Instance}}"
                                              ToolTip="{Binding Pad_Audio_Mirror_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                              VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetAudioMirrorCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetAudioMirror, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <!-- More (#574): the settings fewer people change, opened in place. -->
                                <controls:MoreRow x:Name="SoundOutputMore" StateKey="Pad.Sound.Output.More"
                                                  AutomationProperties.AutomationId="Pad_More_SoundOutput"
                                                  Header="{Binding Common_More, Source={x:Static strings:Strings.Instance}}"
                                                  Hint="{Binding Pad_More_SoundOutput, Source={x:Static strings:Strings.Instance}}">
                                    <StackPanel>
                                <!-- Mirror SOURCE: which playback device feeds the mirror.
                                     "" = system default. Lets games that send specific
                                     sounds to a separate playback device target the pad. -->
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44"
                                            Visibility="{Binding SelectedDeviceHasSpeaker, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Pad_Audio_MirrorSource_Label, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzSubLabel}"
                                              />
                                    <!-- SelectedValuePath/DisplayMemberPath MUST precede the
                                         ItemsSource/SelectedValue bindings: XAML applies
                                         attributes in order, and a SelectedValue that attaches
                                         before SelectedValuePath is set fails to resolve and
                                         never retries. The closed box renders blank. -->
                                    <ComboBox SelectedValuePath="Id" DisplayMemberPath="Name"
                                              ItemsSource="{Binding MirrorSourceOptions}"
                                              SelectedValue="{Binding SelectedMirrorSourceId, Mode=TwoWay}"
                                              MaxWidth="380" controls:SettingRow.Fills="True"
                                              DropDownOpened="MirrorSource_DropDownOpened"
                                              IsEnabled="{Binding DeviceConfig.AudioPassthroughEnabled}"
                                              ToolTip="{Binding Pad_Audio_MirrorSource_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Command="{Binding ResetMirrorSourceCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetMirrorSource, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <!-- Mirror ENGAGE gate (#185), haptic-tone devices only: a
                                     resonant actuator buzzing with music is intrusive in a
                                     way a real speaker is not. Always / While an input is
                                     held / While the game rumbles, with a release delay so
                                     the tone does not clip off the instant the source drops. -->
                                <StackPanel Margin="0,0,0,8"
                                            Visibility="{Binding SelectedDeviceHasHapticTones, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <TextBlock Text="{Binding Pad_Audio_Engage_Label, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzSubLabel}"
                                                  />
                                        <ComboBox SelectedValuePath="Tag"
                                                  SelectedValue="{Binding DeviceConfig.AudioMirrorEngageMode, Mode=TwoWay}"
                                                  MaxWidth="260" controls:SettingRow.Fills="True"
                                                  IsEnabled="{Binding DeviceConfig.AudioPassthroughEnabled}"
                                                  ToolTip="{Binding Pad_Audio_Engage_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                            <ComboBoxItem Content="{Binding Pad_Audio_Engage_Always, Source={x:Static strings:Strings.Instance}}" Tag="Always"/>
                                            <ComboBoxItem Content="{Binding Pad_Audio_Engage_Input, Source={x:Static strings:Strings.Instance}}" Tag="Input"/>
                                            <ComboBoxItem Content="{Binding Pad_Audio_Engage_Rumble, Source={x:Static strings:Strings.Instance}}" Tag="Rumble"/>
                                        </ComboBox>
                                        <ui:Button Command="{Binding ResetMirrorEngageModeCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_ResetMirrorEngageMode, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                    <!-- Engage input picker, Input mode only. Same grouped
                                         cross-device list + device-label subtitle as the
                                         gyro Aim Engage picker. -->
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <controls:SettingRow.Style>
                                            <Style TargetType="controls:SettingRow">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DeviceConfig.AudioMirrorEngageMode}" Value="Input">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:SettingRow.Style>
                                        <TextBlock Text="{Binding Pad_Audio_EngageInput_Label, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzSubLabel}"
                                                   VerticalAlignment="Top" Margin="16,4,12,0"/>
                                        <StackPanel Orientation="Vertical">
                                            <ComboBox ItemsSource="{Binding SlotAvailableInputsView}"
                                                      SelectedItem="{Binding MirrorEngageSelectedInput, Mode=TwoWay}"
                                                      DisplayMemberPath="DisplayName"
                                                      MinWidth="260" Padding="4,2"
                                                      IsEnabled="{Binding DeviceConfig.AudioPassthroughEnabled}"
                                                      IsSynchronizedWithCurrentItem="False">
                                                <ComboBox.GroupStyle>
                                                    <GroupStyle>
                                                        <GroupStyle.HeaderTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,3,6,3">
                                                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </GroupStyle.HeaderTemplate>
                                                    </GroupStyle>
                                                </ComboBox.GroupStyle>
                                            </ComboBox>
                                            <TextBlock FontSize="10"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Margin="4,1,0,0"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding MirrorEngageSelectedInput.DeviceLabel}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MirrorEngageSelectedInput}" Value="{x:Null}">
                                                                <Setter Property="Text" Value="{Binding Common_Unassigned, Source={x:Static strings:Strings.Instance}}"/>
                                                                <Setter Property="FontStyle" Value="Italic"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <ui:Button Command="{Binding MirrorEngageRecordCommand}"
                                                   Style="{StaticResource EmberIconButtonHot}"
                                                   VerticalAlignment="Top">
                                            <controls:GlyphText Text="{Binding MirrorEngageRecordButtonIcon}" FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{DynamicResource EmberBrush}"/>
                                            <ui:Button.ToolTip>
                                                <TextBlock Text="{Binding MirrorEngageRecordButtonText}"/>
                                            </ui:Button.ToolTip>
                                        </ui:Button>
                                        <ui:Button Command="{Binding ResetMirrorEngageInputCommand}" Style="{StaticResource ResetButton}"
                                                VerticalAlignment="Top"
                                                ToolTip="{Binding Pad_ResetMirrorEngageInput, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                    <!-- Release delay, any gated mode. -->
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <controls:SettingRow.Style>
                                            <Style TargetType="controls:SettingRow">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DeviceConfig.AudioMirrorEngageMode}" Value="Always">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:SettingRow.Style>
                                        <TextBlock Text="{Binding Pad_Audio_EngageRelease_Label, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzSubLabel}"
                                                   ToolTip="{Binding Pad_Audio_EngageRelease_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBox Text="{Binding DeviceConfig.AudioMirrorEngageReleaseMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Width="64" VerticalAlignment="Center"
                                                 IsEnabled="{Binding DeviceConfig.AudioPassthroughEnabled}"/>
                                        <TextBlock Text="ms" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding ResetMirrorEngageReleaseMsCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_ResetMirrorEngageRelease, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                </StackPanel>

                                <!-- High-tone filter (#202), haptic-tone devices only: the
                                     sink reduces everything it plays (mirror, macro sounds,
                                     Test) to one pitch per tick, so beeps above the limit
                                     can be cut, or folded down an octave at a time keeping
                                     their pitch class. Independent of the mirror toggle:
                                     macro sounds are filtered too, so no IsEnabled gate. -->
                                <StackPanel Margin="0,0,0,8"
                                            Visibility="{Binding SelectedDeviceHasHapticTones, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <TextBlock Text="{Binding Pad_Audio_ToneFilter_Label, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                                  />
                                        <ComboBox SelectedValuePath="Tag"
                                                  SelectedValue="{Binding DeviceConfig.AudioToneFilterMode, Mode=TwoWay}"
                                                  MaxWidth="260" controls:SettingRow.Fills="True"
                                                  ToolTip="{Binding Pad_Audio_ToneFilter_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                            <ComboBoxItem Content="{Binding Pad_Audio_ToneFilter_Off, Source={x:Static strings:Strings.Instance}}" Tag="Off"/>
                                            <ComboBoxItem Content="{Binding Pad_Audio_ToneFilter_Cut, Source={x:Static strings:Strings.Instance}}" Tag="Cut"/>
                                            <ComboBoxItem Content="{Binding Pad_Audio_ToneFilter_Fold, Source={x:Static strings:Strings.Instance}}" Tag="Fold"/>
                                        </ComboBox>
                                        <ui:Button Command="{Binding ResetToneFilterModeCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_ResetToneFilterMode, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                    <!-- Limit, hidden while Off. Wider range than the bass
                                         cutoff's 20-200 by design: midtones stay in the
                                         default pass band, 800 keeps engine and shot
                                         rumble, folds or cuts only beeps above. -->
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <controls:SettingRow.Style>
                                            <Style TargetType="controls:SettingRow">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DeviceConfig.AudioToneFilterMode}" Value="Off">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:SettingRow.Style>
                                        <TextBlock Text="{Binding Pad_Audio_ToneLimit_Label, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                                   ToolTip="{Binding Pad_Audio_ToneLimit_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <Slider Value="{Binding DeviceConfig.AudioToneLimitHz, Mode=TwoWay}" Minimum="100" Maximum="1300"
                                                Style="{StaticResource DzSlider}"/>
                                        <TextBox Text="{Binding DeviceConfig.AudioToneLimitHz, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="Hz" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding ResetToneLimitHzCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_ResetToneLimit, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                    <!-- Persona haptics on the actuators (#271 item 1):
                                         when a game drives this slot's virtual DualSense
                                         with authored haptic audio, render it here through
                                         the tone chain. -->
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <TextBlock Text="{Binding Pad_Audio_PersonaHaptics_Label, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <CheckBox Style="{StaticResource SwitchCheckBox}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                  Content="{Binding Pad_Audio_PersonaHaptics_Label, Source={x:Static strings:Strings.Instance}}"
                                                  ToolTip="{Binding Pad_Audio_PersonaHaptics_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding DeviceConfig.AudioPersonaHapticsEnabled, Mode=TwoWay}"/>
                                        <ui:Button Command="{Binding ResetPersonaHapticsCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_ResetPersonaHaptics, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44"
                                                Visibility="{Binding DeviceConfig.AudioPersonaHapticsEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Pad_Audio_PersonaHapticsGain_Label, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <Slider Value="{Binding DeviceConfig.AudioPersonaHapticsGain, Mode=TwoWay}" Minimum="25" Maximum="300"
                                                Style="{StaticResource DzSlider}"/>
                                        <TextBox Text="{Binding DeviceConfig.AudioPersonaHapticsGain, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding ResetPersonaHapticsGainCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_ResetPersonaHapticsGain, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                    <!-- #381: Steam Controller 2026 PCM low-pass. Only
                                         the PCM-capable transports (wired / dongle) show
                                         it. The stream keeps actuator content below this
                                         cutoff so the pads move instead of singing. -->
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44"
                                                Visibility="{Binding SelectedDeviceIsTritonPcm, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Pad_Audio_TritonLowPass_Label, Source={x:Static strings:Strings.Instance}}"
                                                   ToolTip="{Binding Pad_Audio_TritonLowPass_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                   Style="{StaticResource DzLabel}"/>
                                        <Slider Value="{Binding DeviceConfig.AudioTritonLowPassHz, Mode=TwoWay}" Minimum="60" Maximum="1000"
                                                Style="{StaticResource DzSlider}"/>
                                        <TextBox Text="{Binding DeviceConfig.AudioTritonLowPassHz, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="Hz" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding ResetTritonLowPassCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_ResetTritonLowPass, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                </StackPanel>

                                <!-- Headphone jack hardware volume (DualSense / Edge, and a
                                     DualShock 4 over Bluetooth, which writes the same level
                                     into its split L/R bytes, #528). Sits directly under
                                     Master Volume as its hardware sibling. The value is
                                     written into the pad's firmware register, so it holds
                                     with no app in the loop. HeadphoneVolumeUp/Down macro
                                     actions step this same setting. -->
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44"
                                            Visibility="{Binding SelectedDeviceHasHeadphoneJack, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Pad_Audio_HeadphoneVolume, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Pad_Audio_HeadphoneVolume_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding DeviceConfig.HeadphoneVolume, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"
                                            Minimum="0" Maximum="100" TickFrequency="1"/>
                                    <TextBox Text="{Binding DeviceConfig.HeadphoneVolume, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding DeviceConfig.ResetHeadphoneVolumeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetHeadphoneVolume, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <!-- Audio buffer length (#314, reported by vlue-c on
                                     discussion #311). The packet 0x11 header byte governing
                                     the Bluetooth transport that carries speaker audio,
                                     haptics AND microphone capture, so it is not a speaker
                                     knob. 48 is the shipped default (c571aae9). 16 is the
                                     floor the reference enforces
                                     (DS5Dongle src/config.cpp:99). Advanced and optional.
                                     The byte goes into the DS5 Bluetooth packet 0x11 header
                                     and nowhere else, so the gate carries the TRANSPORT as
                                     well as the model. Gating it on the jack rows alone
                                     (4.3.2 docs sweep) still left the slider showing on a
                                     USB DualSense, where nothing reads it. -->
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44"
                                            Visibility="{Binding SelectedDeviceHasDs5AudioBuffer, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Pad_Audio_BufferLength, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                               ToolTip="{Binding Pad_Audio_BufferLength_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding DeviceConfig.Ds5AudioBufferLength, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"
                                            ToolTip="{Binding Pad_Audio_BufferLength_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                            Minimum="16" Maximum="255" TickFrequency="1"/>
                                    <TextBox Text="{Binding DeviceConfig.Ds5AudioBufferLength, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <ui:Button Command="{Binding DeviceConfig.ResetDs5AudioBufferLengthCommand}" Style="{StaticResource ResetButton}"
                                               ToolTip="{Binding Pad_Audio_Reset_BufferLength, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <!-- Output path (byte 7 bits 4-5, OutputPathSelect). Enum
                                     values 1-4 map to firmware paths 0-3. Automatic writes
                                     nothing and keeps the #83 macro-speaker behavior. An
                                     explicit choice here OWNS the byte: the macro-speaker
                                     block yields its path half and keeps volume only.
                                     A DualShock 4 over Bluetooth takes the same list (#528):
                                     its stream targets the speaker or the headphone jack, so
                                     Headphones + Speaker collapses for it, and the collapsed
                                     item keeps its index so the stored enum keeps its meaning.
                                     A DualShock 4 on USB takes the list too (#546): feature
                                     report 0xE0 routes its USB audio, and it plays both. -->
                                <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44"
                                            Visibility="{Binding SelectedDeviceHasOutputPath, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Pad_Audio_OutputPath, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ComboBox SelectedIndex="{Binding DeviceConfig.AudioOutputPath, Mode=TwoWay, Converter={StaticResource EnumIndexConverter}}"
                                              MaxWidth="340" controls:SettingRow.Fills="True" VerticalAlignment="Center"
                                              ToolTip="{Binding Pad_Audio_OutputPath_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                        <ComboBoxItem Content="{Binding Pad_Audio_OutputPath_Auto, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Audio_OutputPath_Stereo, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Audio_OutputPath_Mono, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Audio_OutputPath_Both, Source={x:Static strings:Strings.Instance}}"
                                                      Visibility="{Binding SelectedDeviceHasHeadsetAndSpeakerPath, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Audio_OutputPath_SpeakerOnly, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Audio_OutputPath_FollowJack, Source={x:Static strings:Strings.Instance}}"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding DeviceConfig.ResetAudioOutputPathCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetOutputPath, Source={x:Static strings:Strings.Instance}}"/>
                                </controls:SettingRow>

                                <!-- Audio DSP chain (#347). Crossfeed, parametric EQ and
                                     the limiter, applied to everything this sink plays
                                     (mirror, macro sounds, persona) BEFORE the transport
                                     encodes it. Sits directly under Output Path because
                                     the resolved path is what decides whether crossfeed
                                     runs at all: it needs a genuinely stereo route, and
                                     the speaker paths carry a mono downmix. -->
                                <!-- Gated on the DSP chain's REAL reach, not on having a
                                     speaker: the chain runs on AudioPassthroughService sinks,
                                     which exist for the Sony pads only. The Wii speaker and
                                     the haptic-tone lanes never see it, and showing these
                                     cards there was three cards that did nothing. -->
                                <Separator Margin="0,10,0,10"
                                           Visibility="{Binding SelectedDeviceHasDspChain, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <StackPanel Visibility="{Binding SelectedDeviceHasDspChain, Converter={StaticResource BoolToVisibilityConverter}}">

                                    <!-- Crossfeed -->
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <TextBlock Text="{Binding Pad_Audio_Crossfeed, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                                   ToolTip="{Binding Pad_Audio_Crossfeed_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBox SelectedIndex="{Binding DeviceConfig.AudioCrossfeedLevel, Mode=TwoWay}"
                                                  MaxWidth="340" controls:SettingRow.Fills="True" VerticalAlignment="Center"
                                                  ToolTip="{Binding Pad_Audio_Crossfeed_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                            <!-- The spec suffix is deliberately NOT localized:
                                                 "Jan Meier" and "C. Moy" are people's names and
                                                 the numbers are the cutoff and feed libbs2b
                                                 actually stores for that level. An audiophile
                                                 recognizes the pair on sight, and translating
                                                 either would only obscure it. -->
                                            <ComboBoxItem Content="{Binding Pad_Audio_Crossfeed_Off, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Pad_Audio_Crossfeed_Low, Source={x:Static strings:Strings.Instance}}"/>
                                                    <TextBlock Text="  360 Hz &#183; 6.0 dB" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Pad_Audio_Crossfeed_Middle, Source={x:Static strings:Strings.Instance}}"/>
                                                    <TextBlock Text="  500 Hz &#183; 4.5 dB" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Pad_Audio_Crossfeed_High, Source={x:Static strings:Strings.Instance}}"/>
                                                    <TextBlock Text="  700 Hz &#183; 3.0 dB" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Pad_Audio_Crossfeed_LowEasy, Source={x:Static strings:Strings.Instance}}"/>
                                                    <TextBlock Text="  360 Hz &#183; 8.4 dB" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Pad_Audio_Crossfeed_MiddleEasy, Source={x:Static strings:Strings.Instance}}"/>
                                                    <TextBlock Text="  500 Hz &#183; 7.2 dB" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Pad_Audio_Crossfeed_HighEasy, Source={x:Static strings:Strings.Instance}}"/>
                                                    <TextBlock Text="  C. Moy &#183; 700 Hz &#183; 6.0 dB" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Jan Meier"/>
                                                    <TextBlock Text="  650 Hz &#183; 9.5 dB" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="bs2b default"/>
                                                    <TextBlock Text="  700 Hz &#183; 4.5 dB" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem Content="{Binding Pad_Audio_Crossfeed_Custom, Source={x:Static strings:Strings.Instance}}"/>
                                        </ComboBox>
                                        <ui:Button Command="{Binding ResetCrossfeedCommand}" Style="{StaticResource ResetButton}"
                                                   ToolTip="{Binding Pad_Audio_Reset_Crossfeed, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>

                                    <!-- The two knobs a level actually IS. libbs2b stores a
                                         level as a cutoff plus a feed and exposes
                                         bs2b_set_level_fcut and bs2b_set_level_feed to set
                                         them independently, with the six classic presets
                                         marked obsolete in their favor. Shown only at
                                         Custom, because at every preset the pair comes from
                                         the preset and editing it would be a lie. -->
                                    <StackPanel Visibility="{Binding DeviceConfig.AudioCrossfeedIsCustom, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                            <TextBlock Text="{Binding Pad_Audio_CrossfeedCut, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                                       ToolTip="{Binding Pad_Audio_CrossfeedCut_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <Slider Value="{Binding DeviceConfig.AudioCrossfeedCutHz, Mode=TwoWay}" Minimum="300" Maximum="2000"
                                                    Style="{StaticResource DzSlider}"/>
                                            <TextBox Text="{Binding DeviceConfig.AudioCrossfeedCutHz, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource DzValueEdit}"/>
                                            <TextBlock Text="Hz" Style="{StaticResource DzPercent}"/>
                                            <ui:Button Command="{Binding ResetCrossfeedCutCommand}" Style="{StaticResource ResetButton}"
                                                       ToolTip="{Binding Pad_Audio_Reset_CrossfeedCut, Source={x:Static strings:Strings.Instance}}"/>
                                        </controls:SettingRow>
                                        <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                            <TextBlock Text="{Binding Pad_Audio_CrossfeedFeed, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                                       ToolTip="{Binding Pad_Audio_CrossfeedFeed_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <Slider Value="{Binding DeviceConfig.AudioCrossfeedFeedDb, Mode=TwoWay}" Minimum="1" Maximum="15"
                                                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                    Style="{StaticResource DzSlider}"/>
                                            <TextBox Text="{Binding DeviceConfig.AudioCrossfeedFeedDb, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.0}"
                                                     Style="{StaticResource DzValueEdit}"/>
                                            <TextBlock Text="dB" Style="{StaticResource DzPercent}"/>
                                            <ui:Button Command="{Binding ResetCrossfeedFeedCommand}" Style="{StaticResource ResetButton}"
                                                       ToolTip="{Binding Pad_Audio_Reset_CrossfeedFeed, Source={x:Static strings:Strings.Instance}}"/>
                                        </controls:SettingRow>
                                    </StackPanel>

                                    <!-- Parametric EQ -->
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <TextBlock Text="{Binding Pad_Audio_Eq, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <CheckBox Style="{StaticResource SwitchCheckBox}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                  Content="{Binding Pad_Audio_Eq, Source={x:Static strings:Strings.Instance}}"
                                                  ToolTip="{Binding Pad_Audio_Eq_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding DeviceConfig.AudioEqEnabled, Mode=TwoWay}"/>
                                        <ui:Button Command="{Binding ResetEqCommand}" Style="{StaticResource ResetButton}"
                                                   ToolTip="{Binding Pad_Audio_Reset_Eq, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                    <StackPanel Visibility="{Binding DeviceConfig.AudioEqEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                            <TextBlock Text="{Binding Pad_Audio_EqPreamp, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                                       ToolTip="{Binding Pad_Audio_EqPreamp_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <Slider Value="{Binding DeviceConfig.AudioEqPreampDb, Mode=TwoWay}" Minimum="-30" Maximum="12"
                                                    Style="{StaticResource DzSlider}"/>
                                            <TextBox Text="{Binding DeviceConfig.AudioEqPreampDb, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.#}"
                                                     Style="{StaticResource DzValueEdit}"/>
                                            <TextBlock Text="dB" Style="{StaticResource DzPercent}"/>
                                            <ui:Button Command="{Binding ResetEqPreampCommand}" Style="{StaticResource ResetButton}"
                                                       ToolTip="{Binding Pad_Audio_Reset_EqPreamp, Source={x:Static strings:Strings.Instance}}"/>
                                        </controls:SettingRow>
                                        <!-- The curve. Drag a handle to move a band's
                                             frequency and gain, wheel over it for Q. -->
                                        <controls:EqCurveControl Bands="{Binding EqBands}" Height="190" Margin="0,0,0,8"
                                                                 ToolTip="{Binding Pad_Audio_EqCurve_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <!-- Numeric rows under the curve. Always-live
                                             controls rather than a DataGrid: a grid needs a
                                             double click to enter edit mode, which reads as
                                             "it will not let me edit anything". -->
                                        <Grid Margin="0,0,0,2">
                                            <!-- MEASURED with tools/rowmeasure.
                                                 Every column carries a 28 by 28
                                                 reset plus its 4 margin, which the
                                                 original numbers predate: the
                                                 checkbox column needed 74 against
                                                 42, and the three editors 103, 96
                                                 and 98 against 96, 88 and 78. A
                                                 grid does not clip, so the resets
                                                 drew over their neighbors. The type
                                                 picker measures 89 against its 150
                                                 and is left alone. Header and rows
                                                 below must stay identical. -->
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="78"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="108"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="102"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Pad_Audio_EqCol_On, Source={x:Static strings:Strings.Instance}}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Pad_Audio_EqCol_Type, Source={x:Static strings:Strings.Instance}}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Pad_Audio_EqCol_Freq, Source={x:Static strings:Strings.Instance}}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Pad_Audio_EqCol_Gain, Source={x:Static strings:Strings.Instance}}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Pad_Audio_EqCol_Q, Source={x:Static strings:Strings.Instance}}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding EqBands}" Margin="0,0,0,6">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1,0,1">
                                                        <!-- Identical to the header
                                                             grid above. They are two
                                                             grids, not one, so a
                                                             width changed in one and
                                                             not the other silently
                                                             misaligns every heading. -->
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="78"/>
                                                            <ColumnDefinition Width="150"/>
                                                            <ColumnDefinition Width="108"/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="102"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <controls:SettingRow MinHeight="44" Grid.Column="0" VerticalAlignment="Center">
                                                            <CheckBox AutomationProperties.Name="{Binding Common_Enabled, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="Enabled" SettingLabel="{Binding Common_Enabled, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_EqBandVm_Enabled_11933"/>
                                                        </controls:SettingRow>
                                                        <!-- The picker binds the enum values, so it needs an
                                                             ItemTemplate to show anything but ToString(): without
                                                             one it rendered "LowShelf" and "HighPass" verbatim, in
                                                             every locale. -->
                                                        <DockPanel LastChildFill="True" Grid.Column="1" Margin="0,0,6,0">
                                                            <reset:SettingResetButton DockPanel.Dock="Right" Command="{Binding ResetSettingCommand}" CommandParameter="Type" SettingLabel="{Binding Pad_Audio_EqCol_Type, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_EqBandVm_Type_11940"/>
                                                            <ComboBox
                                                                      ItemsSource="{Binding Source={StaticResource EqBandTypeValues}}"
                                                                      SelectedItem="{Binding Type, Mode=TwoWay}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Converter={StaticResource EqBandTypeNameConverter}}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </DockPanel>
                                                        <DockPanel LastChildFill="True" Grid.Column="2" Margin="0,0,6,0">
                                                            <reset:SettingResetButton DockPanel.Dock="Right" Command="{Binding ResetSettingCommand}" CommandParameter="FrequencyHz" SettingLabel="{Binding Pad_AT_Frequency, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_EqBandVm_FrequencyHz_11948"/>
                                                            <TextBox
                                                                     Text="{Binding FrequencyHz, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.##}"/>
                                                        </DockPanel>
                                                        <DockPanel LastChildFill="True" Grid.Column="3" Margin="0,0,6,0">
                                                            <reset:SettingResetButton DockPanel.Dock="Right" Command="{Binding ResetSettingCommand}" CommandParameter="GainDb" SettingLabel="{Binding Pad_Audio_EqCol_Gain, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_EqBandVm_GainDb_11950"/>
                                                            <TextBox
                                                                     Text="{Binding GainDb, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.##}"/>
                                                        </DockPanel>
                                                        <DockPanel LastChildFill="True" Grid.Column="4" Margin="0,0,6,0">
                                                            <reset:SettingResetButton DockPanel.Dock="Right" Command="{Binding ResetSettingCommand}" CommandParameter="Q" SettingLabel="{Binding Pad_Audio_EqCol_Q, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_EqBandVm_Q_11952"/>
                                                            <TextBox
                                                                     Text="{Binding Q, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.###}"/>
                                                        </DockPanel>
                                                        <ui:Button AutomationProperties.Name="{Binding Pad_Audio_EqRemove, Source={x:Static strings:Strings.Instance}}" Grid.Column="5" HorizontalAlignment="Left" Padding="6,2"
                                                                   Command="{Binding DataContext.RemoveEqBandCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                   CommandParameter="{Binding}"
                                                                   ToolTip="{Binding Pad_Audio_EqRemove, Source={x:Static strings:Strings.Instance}}">
                                                            <controls:DecorativeSymbolIcon Symbol="Delete24"/>
                                                        </ui:Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{Binding Pad_Audio_EqAdd, Source={x:Static strings:Strings.Instance}}"
                                                    Command="{Binding AddEqBandCommand}" Padding="10,4" VerticalAlignment="Center"/>
                                            <!-- File first, because it is the gesture autoeq.app
                                                 actually produces: its parametric export is a
                                                 download, not copyable text. The clipboard button
                                                 stays for profiles that do arrive as text. -->
                                            <Button Content="{Binding Pad_Audio_EqImportFile, Source={x:Static strings:Strings.Instance}}"
                                                    Command="{Binding ImportAutoEqFileCommand}" Padding="10,4" Margin="6,0,0,0" VerticalAlignment="Center"
                                                    ToolTip="{Binding Pad_Audio_EqImportFile_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <Button Content="{Binding Pad_Audio_EqImport, Source={x:Static strings:Strings.Instance}}"
                                                    Command="{Binding ImportAutoEqCommand}" Padding="10,4" Margin="6,0,0,0" VerticalAlignment="Center"
                                                    ToolTip="{Binding Pad_Audio_EqImport_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <Button Content="{Binding Pad_Audio_EqClear, Source={x:Static strings:Strings.Instance}}"
                                                    Command="{Binding ClearEqBandsCommand}" Padding="10,4" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <!-- What the last import did. An import that finds nothing
                                             declines to touch a tuned EQ, which is right, and has
                                             to say so, which it did not: AutoEq publishes three
                                             formats and only two carry filter lines, so a silent
                                             no-op reads as a broken button. -->
                                        <TextBlock Text="{Binding EqImportStatus}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"
                                                   Visibility="{Binding HasEqImportStatus, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <!-- The steps, in the page, because the source of these
                                             profiles is a web app whose export is not named the
                                             way this feature is. -->
                                        <TextBlock Text="{Binding Pad_Audio_EqHowTo, Source={x:Static strings:Strings.Instance}}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0" MaxWidth="620" HorizontalAlignment="Left"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11"/>
                                    </StackPanel>

                                    <!-- Limiter -->
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <TextBlock Text="{Binding Pad_Audio_Limiter, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <CheckBox Style="{StaticResource SwitchCheckBox}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                  Content="{Binding Pad_Audio_Limiter, Source={x:Static strings:Strings.Instance}}"
                                                  ToolTip="{Binding Pad_Audio_Limiter_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding DeviceConfig.AudioLimiterEnabled, Mode=TwoWay}"/>
                                        <ui:Button Command="{Binding ResetLimiterCommand}" Style="{StaticResource ResetButton}"
                                                   ToolTip="{Binding Pad_Audio_Reset_Limiter, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44"
                                                Visibility="{Binding DeviceConfig.AudioLimiterEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Pad_Audio_LimiterCeiling, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                                   ToolTip="{Binding Pad_Audio_LimiterCeiling_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <Slider Value="{Binding DeviceConfig.AudioLimiterCeiling, Mode=TwoWay}" Minimum="5" Maximum="100"
                                                Style="{StaticResource DzSlider}"/>
                                        <TextBox Text="{Binding DeviceConfig.AudioLimiterCeiling, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding ResetLimiterCeilingCommand}" Style="{StaticResource ResetButton}"
                                                   ToolTip="{Binding Pad_Audio_Reset_LimiterCeiling, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding Pad_Audio_Test, Source={x:Static strings:Strings.Instance}}"
                                            Command="{Binding SoundTestCommand}" Padding="10,4" VerticalAlignment="Center"
                                            ToolTip="{Binding Pad_Audio_Test_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Audio_StopAll, Source={x:Static strings:Strings.Instance}}"
                                            Command="{Binding SoundStopAllCommand}" Padding="10,4" Margin="6,0,0,0" VerticalAlignment="Center"
                                            ToolTip="{Binding Pad_Audio_StopAll_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                    </StackPanel>
                                </controls:MoreRow>
                            </StackPanel>
                        </Border>

                        <!-- Sound Macros hub card -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Pad_Audio_Macros_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"
                                               ToolTip="{Binding Pad_Audio_Macros_Desc, Source={x:Static strings:Strings.Instance}}"/>
                                </DockPanel>
                                <Button Content="{Binding Pad_Audio_NewSoundMacro, Source={x:Static strings:Strings.Instance}}"
                                        Command="{Binding AddSoundMacroCommand}" MinHeight="36" Padding="14,0" HorizontalAlignment="Left"
                                        Margin="0,4,0,8"/>
                                <TextBlock Text="{Binding Pad_Audio_NoSoundMacros, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}"
                                           Visibility="{Binding HasNoSoundMacros, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <ItemsControl ItemsSource="{Binding SoundMacros}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="SoundMacroRow_Click" HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left" Margin="0,0,0,4" Padding="8,5"
                                                    ToolTip="{Binding Pad_Audio_OpenMacro_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:GlyphText Text="&#xEC4F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding SoundFilesSummary}" VerticalAlignment="Center"
                                                               Margin="10,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <controls:FoldList Gap="12">
                        <!-- Sound Packages card -->
                        <controls:FoldCard x:Name="SoundPackagesFoldCard" StateKey="Pad.Sound.Packages"
                                           Header="{Binding Pad_Audio_Packages_Header, Source={x:Static strings:Strings.Instance}}"
                                           Hint="{Binding Pad_SoundPackages_FoldHint, Source={x:Static strings:Strings.Instance}}"
                                           Description="{Binding Pad_Audio_Packages_Desc, Source={x:Static strings:Strings.Instance}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="{Binding Pad_Audio_Packages_Add, Source={x:Static strings:Strings.Instance}}"
                                            Click="PackageAdd_Click" Padding="10,4"
                                            ToolTip="{Binding Pad_Audio_Packages_Add_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Audio_Packages_Create, Source={x:Static strings:Strings.Instance}}"
                                            Click="PackageCreate_Click" Padding="10,4" Margin="6,0,0,0"
                                            ToolTip="{Binding Pad_Audio_Packages_Create_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Common_Remove, Source={x:Static strings:Strings.Instance}}"
                                            Click="PackageRemove_Click" Padding="10,4" Margin="6,0,0,0"
                                            ToolTip="{Binding Pad_Audio_Packages_Remove_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <TextBlock x:Name="SoundPackagesEmptyText"
                                           Text="{Binding Pad_Audio_Packages_Empty, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}"/>
                                <ListBox x:Name="SoundPackagesList" MaxHeight="170"
                                         ItemContainerStyle="{StaticResource EmberSelectListItem}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <controls:GlyphText Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Path}" VerticalAlignment="Center"
                                                           Margin="10,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </controls:FoldCard>
                        </controls:FoldList>
                    </StackPanel>
                    </GroupBox>
                    </controls:TileGridPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ SECTION 5: Macros & Menus ═══ -->
            <TabItem>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Padding="10,2,10,0">
                    <WrapPanel Orientation="Horizontal">
                        <!-- [Macros] -->
                        <RadioButton x:Name="TabMacros" Tag="1" GroupName="PadMacrosPart" Style="{StaticResource TabStripButton}" Click="TabBtn_Click" Checked="TabBtn_Checked"
                                     IsChecked="True"
                                     AutomationProperties.AutomationId="MacrosTab">
                            <TextBlock Text="{Binding Pad_Macros, Source={x:Static strings:Strings.Instance}}" FontSize="13"/>
                        </RadioButton>

                        <!-- [Menus] (#9 B-17). Menus live on the slot's MappingSet like
                             the mapping table and macros. -->
                        <RadioButton x:Name="TabMenus" Tag="15" GroupName="PadMacrosPart" Style="{StaticResource TabStripButton}" Click="TabBtn_Click" Checked="TabBtn_Checked"
                                     AutomationProperties.AutomationId="MenusTab">
                            <TextBlock Text="{Binding Pad_Menus, Source={x:Static strings:Strings.Instance}}" FontSize="13"/>
                        </RadioButton>
                    </WrapPanel>
                    </Border>
                    <controls:ContentTabControl Grid.Row="1"
                                SelectedIndex="{Binding MacrosPartIndex, Mode=OneWay}">
                        <TabControl.Template>
                            <ControlTemplate TargetType="TabControl">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"/>
                            </ControlTemplate>
                        </TabControl.Template>

            <!-- The parts below were tabs of the page and keep that
                 indentation. -->
            <!-- ─── TAB 1: Macros (slot-level) ─── -->
            <TabItem>
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Macro list -->
                    <DockPanel Grid.Column="0">
                        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button AutomationProperties.AutomationId="MacroAddButton" Content="{Binding Common_Add, Source={x:Static strings:Strings.Instance}}" Command="{Binding AddMacroCommand}"
                                    Padding="8,4" Margin="0,0,4,4"/>
                            <Button AutomationProperties.AutomationId="MacroRemoveButton" Content="{Binding Common_Remove, Source={x:Static strings:Strings.Instance}}" Command="{Binding RemoveMacroCommand}"
                                    Padding="8,4" Margin="0,0,4,4"/>
                            <Button Content="{Binding Common_Duplicate, Source={x:Static strings:Strings.Instance}}" Command="{Binding DuplicateMacroCommand}"
                                    Padding="8,4" Margin="0,0,4,4"/>
                            <Button Content="{Binding Common_Copy, Source={x:Static strings:Strings.Instance}}" Command="{Binding CopyMacroCommand}"
                                    Padding="8,4" Margin="0,0,4,4"/>
                            <Button Content="{Binding Common_Paste, Source={x:Static strings:Strings.Instance}}" Command="{Binding PasteMacroCommand}"
                                    Padding="8,4" Margin="0,0,4,4"/>
                            <Button Content="{Binding Pad_CopyFrom, Source={x:Static strings:Strings.Instance}}" Command="{Binding CopyMacroFromCommand}"
                                    Padding="8,4" Margin="0,0,0,4"
                                    ToolTip="{Binding Pad_CopyFromTooltip, Source={x:Static strings:Strings.Instance}}"/>
                        </WrapPanel>

                        <ListBox AutomationProperties.Name="{Binding Pad_Macros, Source={x:Static strings:Strings.Instance}}" ItemsSource="{Binding Macros}"
                                 SelectedItem="{Binding SelectedMacro, Mode=TwoWay}"
                                 TextSearch.TextPath="Name"
                                 ItemContainerStyle="{StaticResource EmberSelectListItem}">
                            <!-- #254 A-1: the scope dot marks layer-scoped
                                 macros so scope is visible without selecting
                                 each one, the layer-tab dot's sibling. -->
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{DynamicResource TextFillColorTertiaryBrush}"
                                                 Visibility="{Binding HasLayerScope, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <GridSplitter AutomationProperties.Name="{Binding Common_ResizePanes, Source={x:Static strings:Strings.Instance}}" Grid.Column="1" Width="4" Margin="4,0"
                                  HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                  ResizeBehavior="PreviousAndNext"/>

                    <!-- Empty state (#175): cold guidance instead of a bare wall. -->
                    <Grid Grid.Column="2">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedMacro}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path FlowDirection="LeftToRight" Data="{StaticResource FlameOuterGeometry}" Width="34" Height="34" Stretch="Uniform"
                                  Fill="Transparent" StrokeThickness="1.2"
                                  Stroke="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Macro_EmptyHint, Source={x:Static strings:Strings.Instance}}"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300"/>
                        </StackPanel>
                    </Grid>

                    <!-- Macro editor (shows when a macro is selected). Horizontal
                         scroll DISABLED: Auto handed infinite width to the whole
                         column, so nothing (action chips, wrapping text) could ever
                         wrap and the h-scrollbar engaged on any wide row. Disabled
                         constrains the content to the viewport so it wraps instead. -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="8"
                                  DataContext="{Binding SelectedMacro}"
                                  Visibility="{Binding DataContext.HasSelectedMacro,
                                      RelativeSource={RelativeSource AncestorType=TabItem},
                                      Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <!-- Macro name -->
                            <TextBlock Text="{Binding Macro_Name, Source={x:Static strings:Strings.Instance}}" FontWeight="SemiBold" Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,12"/>

                            <!-- Enabled -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <CheckBox VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Common_Enabled, Source={x:Static strings:Strings.Instance}}" IsChecked="{Binding IsEnabled, Mode=TwoWay}"/>
                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="IsEnabled" SettingLabel="{Binding Common_Enabled, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroItem_IsEnabled_1284"/>
                            </StackPanel>

                            <!-- Trigger mode -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="3" CornerRadius="1.5" Margin="0,2,7,2"
                                        Background="{DynamicResource EmberBrush}"/>
                                <TextBlock Text="{Binding Macro_Trigger, Source={x:Static strings:Strings.Instance}}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Fire, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                           Width="80" Margin="0,0,8,0"/>
                                <ComboBox SelectedValue="{Binding TriggerMode, Mode=TwoWay}"
                                          SelectedValuePath="Tag" MinWidth="120">
                                    <ComboBoxItem Content="{Binding Macro_OnPress, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerMode.OnPress}"/>
                                    <ComboBoxItem Content="{Binding Macro_SinglePress, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerMode.SinglePress}"
                                                  ToolTip="{Binding Macro_SinglePress_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBoxItem Content="{Binding Macro_OnRelease, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerMode.OnRelease}"/>
                                    <ComboBoxItem Content="{Binding Macro_WhileHeld, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerMode.WhileHeld}"/>
                                    <ComboBoxItem Content="{Binding Macro_HoldForMs, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerMode.HoldForMs}"
                                                  ToolTip="{Binding Macro_HoldForMs_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBoxItem Content="{Binding Macro_ShortPress, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerMode.ShortPress}"
                                                  ToolTip="{Binding Macro_ShortPress_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBoxItem Content="{Binding Macro_DoublePress, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerMode.DoublePress}"
                                                  ToolTip="{Binding Macro_DoublePress_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBoxItem Content="{Binding Macro_TriplePress, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerMode.TriplePress}"
                                                  ToolTip="{Binding Macro_TriplePress_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBoxItem Content="{Binding Macro_Toggle, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerMode.Toggle}"
                                                  ToolTip="{Binding Macro_Toggle_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBoxItem Content="{Binding Macro_Turbo, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerMode.Turbo}"
                                                  ToolTip="{Binding Macro_Turbo_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBoxItem Content="{Binding Macro_Always, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerMode.Always}"/>
                                    <ComboBoxItem Content="{Binding Macro_CustomExpression, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerMode.CustomExpression}"/>
                                </ComboBox>
                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="TriggerMode" SettingLabel="{Binding Macro_Fire, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroItem_TriggerMode_1297"/>
                            </StackPanel>

                            <!-- Macro layer scope (#254 A-1). Visible only when the slot
                                 has shift layers, the same gate the Mappings strip uses.
                                 "" = Any layer (the ungated default), "Base" and each
                                 layer scope the macro exactly like a mapping row. -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <!-- Visible when the slot HAS layers, or when this
                                     macro already carries a scope (audit C3): an
                                     imported or copied mask must stay visible and
                                     clearable even on a slot with no layers. -->
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.HasShiftLayers, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ShowsLayerRow}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Layer, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                           Width="80" Margin="0,0,8,0"
                                           ToolTip="{Binding Macro_Layer_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                <ComboBox MinWidth="160"
                                          ItemsSource="{Binding DataContext.MacroLayerChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedValue="{Binding LayerMask, Mode=TwoWay}"
                                          SelectedValuePath="LayerMask"
                                          DisplayMemberPath="LayerName"
                                          ToolTip="{Binding Macro_Layer_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="LayerMask" SettingLabel="{Binding Macro_Layer, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroItem_LayerMask_1350"/>
                            </StackPanel>

                            <!-- Hold-threshold row (issue #9 wave 1b, B-8b). Visible only in
                                 On Hold mode: the macro fires once the trigger combo has been
                                 held this long. A shorter tap does nothing. -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                        Visibility="{Binding ShowsHoldTimeRow, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_TriggerHoldMs_Label, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                           Width="80" Margin="0,0,8,0"
                                           ToolTip="{Binding HoldTimeToolTip}"/>
                                <TextBox Text="{Binding TriggerHoldMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="80"
                                         ToolTip="{Binding HoldTimeToolTip}"/>
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <ui:Button Command="{Binding ResetTriggerHoldMsCommand}" Style="{StaticResource ResetButton}" Margin="8,0,0,0" ToolTip="{Binding Macro_Reset_HoldTime, Source={x:Static strings:Strings.Instance}}"/>
                            </StackPanel>

                            <!-- Press-window row (translator v17, shared with Triple
                                 Press per #238). Visible in Double Press and Triple
                                 Press modes: the macro fires when the trigger chains
                                 its presses within this window. The tooltip follows
                                 the active mode via TriggerPressWindowToolTip. -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                        Visibility="{Binding IsDoublePressMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_TriggerDoublePressMs_Label, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                           Width="80" Margin="0,0,8,0"
                                           ToolTip="{Binding TriggerPressWindowToolTip}"/>
                                <TextBox Text="{Binding TriggerDoublePressMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="80"
                                         ToolTip="{Binding TriggerPressWindowToolTip}"/>
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <ui:Button Command="{Binding ResetTriggerDoublePressMsCommand}" Style="{StaticResource ResetButton}" Margin="8,0,0,0" ToolTip="{Binding Macro_Reset_PressWindow, Source={x:Static strings:Strings.Instance}}"/>
                            </StackPanel>

                            <!-- Inline interval row (#238): visible in Turbo and Toggle,
                                 binding the SAME RepeatDelayMs the Repeat section edits.
                                 Both modes force until-release repeats in the engine, so
                                 the interval is their only live repeat setting (the turbo
                                 rate, or the while-latched pacing) and the dead Repeat
                                 section hides for them below. -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                        Visibility="{Binding ShowsInlineIntervalRow, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_RepeatInterval_Label, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                           Width="80" Margin="0,0,8,0"
                                           ToolTip="{Binding InlineIntervalToolTip}"/>
                                <TextBox Text="{Binding RepeatDelayMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="80"
                                         ToolTip="{Binding InlineIntervalToolTip}"/>
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <ui:Button Command="{Binding ResetRepeatDelayMsCommand}" Style="{StaticResource ResetButton}" Margin="8,0,0,0" ToolTip="{Binding Macro_Reset_Interval, Source={x:Static strings:Strings.Instance}}"/>
                            </StackPanel>

                            <!-- Custom-expression editor (visible only when TriggerMode = CustomExpression).
                                 Sits ABOVE the legacy trigger-combo block so it shares the same
                                 spot in the layout. Named `FormulaEditor` so the shared
                                 FormulaChip_Click / FormulaPreset_Click handlers in
                                 PadPage.xaml.cs find the right textbox (they walk up the visual
                                 tree looking for an ancestor named "FormulaEditor"). -->
                            <StackPanel x:Name="FormulaEditor"
                                        Visibility="{Binding IsCustomExpressionMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Margin="0,0,0,8">
                                <TextBlock Text="{Binding Macro_Expression_Header, Source={x:Static strings:Strings.Instance}}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <DockPanel LastChildFill="True" Visibility="{Binding Visibility, ElementName=CustomFormulaBox}" Margin="0,0,0,4">
                                    <reset:SettingResetButton DockPanel.Dock="Right" Command="{Binding ResetSettingCommand}" CommandParameter="TriggerExpression" Visibility="{Binding Visibility, ElementName=CustomFormulaBox}" SettingLabel="{Binding Macro_Expression_Header, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroItem_TriggerExpression_1419"/>
                                    <TextBox x:Name="CustomFormulaBox"
                                             Text="{Binding TriggerExpression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{StaticResource TelemetryFontFamily}"
                                             AcceptsReturn="False"
                                             AllowDrop="True"
                                             Padding="6,4">
                                        <TextBox.ToolTip>
                                            <TextBlock common:BidiText.Text="{Binding Macro_Expression_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        </TextBox.ToolTip>
                                    </TextBox>
                                </DockPanel>
                                <!-- The default color lives in the style, not on the
                                     element: a local value outranks a trigger setter, so
                                     with it here neither the invalid red nor the warning
                                     orange could ever apply and the formula status stayed
                                     gray whatever the expression did. The mapping table's
                                     twin already reads this way. Warning is declared
                                     BEFORE invalid so invalid wins when both hold. -->
                                <TextBlock Text="{Binding CustomExpressionStatus}"
                                           FontFamily="{StaticResource TelemetryFontFamily}"
                                           FontSize="11" Margin="0,0,0,6">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCustomExpressionWarning}" Value="True">
                                                    <Setter Property="Foreground" Value="#CA5010"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCustomExpressionInvalid}" Value="True">
                                                    <Setter Property="Foreground" Value="#E81123"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Chip palette: click to insert at caret, or drag onto the
                                     formula box. Reuses FormulaChip_Click + the drag-out
                                     handlers from the merge-mapping editor verbatim. -->
                                <TextBlock Text="{Binding Pad_Formula_Insert, Source={x:Static strings:Strings.Instance}}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="2,4,0,2"/>
                                <WrapPanel Margin="0,0,0,4" MaxWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                    <WrapPanel.Resources>
                                        <Style x:Key="MacroFormulaChipStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                            <Setter Property="Padding" Value="6,2"/>
                                            <Setter Property="Margin" Value="0,0,3,3"/>
                                            <Setter Property="MinWidth" Value="28"/>
                                            <Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="FormulaChip_PreviewMouseLeftButtonDown"/>
                                            <EventSetter Event="PreviewMouseMove" Handler="FormulaChip_PreviewMouseMove"/>
                                            <!-- #175 hover-glow: based on DefaultButtonStyle
                                                 directly (not the page implicit), so the
                                                 neutral glow trigger rides here. -->
                                        </Style>
                                    </WrapPanel.Resources>
                                    <!-- Variable chips: a..z. Visibility tracks VariableCount so
                                         the palette only shows letters that bind to a real variable. -->
                                    <Button Content="a" Tag="a" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=0}"/>
                                    <Button Content="b" Tag="b" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=1}"/>
                                    <Button Content="c" Tag="c" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=2}"/>
                                    <Button Content="d" Tag="d" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=3}"/>
                                    <Button Content="e" Tag="e" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=4}"/>
                                    <Button Content="f" Tag="f" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=5}"/>
                                    <Button Content="g" Tag="g" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=6}"/>
                                    <Button Content="h" Tag="h" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=7}"/>
                                    <Button Content="i" Tag="i" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=8}"/>
                                    <Button Content="j" Tag="j" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=9}"/>
                                    <Button Content="k" Tag="k" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=10}"/>
                                    <Button Content="l" Tag="l" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=11}"/>
                                    <Button Content="m" Tag="m" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=12}"/>
                                    <Button Content="n" Tag="n" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=13}"/>
                                    <Button Content="o" Tag="o" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=14}"/>
                                    <Button Content="p" Tag="p" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=15}"/>
                                    <Button Content="q" Tag="q" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=16}"/>
                                    <Button Content="r" Tag="r" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=17}"/>
                                    <Button Content="s" Tag="s" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=18}"/>
                                    <Button Content="t" Tag="t" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=19}"/>
                                    <Button Content="u" Tag="u" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=20}"/>
                                    <Button Content="v" Tag="v" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=21}"/>
                                    <Button Content="w" Tag="w" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=22}"/>
                                    <Button Content="x" Tag="x" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=23}"/>
                                    <Button Content="y" Tag="y" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=24}"/>
                                    <Button Content="z" Tag="z" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=25}"/>
                                    <Border Width="6"/>
                                    <Button Content="+" Tag=" + " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Add, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="−" Tag=" - " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Subtract, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="×" Tag=" * " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Multiply, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="÷" Tag=" / " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Divide, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="−A" Tag="-a" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_NegateA, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="(" Tag="(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_OpenGroup, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content=")" Tag=")" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_CloseGroup, Source={x:Static strings:Strings.Instance}}"/>
                                    <Border Width="6"/>
                                    <Button Content="0" Tag="0" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click"/>
                                    <Button Content="½" Tag="0.5" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Half, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="1" Tag="1" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click"/>
                                    <Button Content="2" Tag="2" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click"/>
                                    <Border Width="6"/>
                                    <Button Content="&lt;" Tag=" &lt; " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_LessThan, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="&gt;" Tag=" &gt; " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_GreaterThan, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="≤" Tag=" &lt;= " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_LessOrEqual, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="≥" Tag=" &gt;= " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_GreaterOrEqual, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="=" Tag=" == " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Equal, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="≠" Tag=" != " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_NotEqual, Source={x:Static strings:Strings.Instance}}"/>
                                    <Border Width="6"/>
                                    <Button Content="and" Tag=" &amp;&amp; " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_BothConditions, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="or" Tag=" || " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_EitherCondition, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="not" Tag="!" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_FlipBool, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="if?" Tag=" ? " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_If, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="else:" Tag=" : " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Else, Source={x:Static strings:Strings.Instance}}"/>
                                    <Border Width="6"/>
                                    <Button Content="abs" Tag="abs(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Abs, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="min" Tag="min(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Min, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="max" Tag="max(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Max, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="clamp" Tag="clamp(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Clamp, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="sign" Tag="sign(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Sign, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="lerp" Tag="lerp(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Lerp, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="round" Tag="round(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Round, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="pow" Tag="pow(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Pow, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="hypot" Tag="hypot(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Hypot, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="deadzone" Tag="deadzone(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Deadzone, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="floor" Tag="floor(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Floor, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="ceil" Tag="ceil(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Ceil, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="sin" Tag="sin(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Sin, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="cos" Tag="cos(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Cos, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="tan" Tag="tan(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Tan, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="atan2" Tag="atan2(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Atan2, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="sqrt" Tag="sqrt(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" common:BidiText.ToolTip="{Binding Pad_Formula_Chip_Sqrt, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="," Tag=", " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click"/>
                                </WrapPanel>

                                <!-- Starter recipes. Common trigger patterns. Each button's
                                     Tag is the full formula. Clicking replaces the box text. -->
                                <TextBlock Text="{Binding Pad_Formula_StarterRecipes, Source={x:Static strings:Strings.Instance}}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="2,2,0,2"/>
                                <WrapPanel Margin="0,0,0,6" MaxWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                    <WrapPanel.Resources>
                                        <Style x:Key="MacroFormulaPresetStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                            <Setter Property="Padding" Value="8,3"/>
                                            <Setter Property="Margin" Value="0,0,4,3"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <!-- #175 hover-glow: DefaultButtonStyle bypasses
                                                 the implicit Button glow, so it rides here. -->
                                        </Style>
                                    </WrapPanel.Resources>
                                    <Button Content="{Binding Macro_Expression_Recipe_Single, Source={x:Static strings:Strings.Instance}}" Tag="a"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Macro_Expression_Recipe_Single_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Macro_Expression_Recipe_Both, Source={x:Static strings:Strings.Instance}}" Tag="a &amp;&amp; b"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Macro_Expression_Recipe_Both_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Macro_Expression_Recipe_Either, Source={x:Static strings:Strings.Instance}}" Tag="a || b"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Macro_Expression_Recipe_Either_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Macro_Expression_Recipe_AButNotB, Source={x:Static strings:Strings.Instance}}" Tag="a &amp;&amp; !b"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Macro_Expression_Recipe_AButNotB_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Macro_Expression_Recipe_AxisOverHalf, Source={x:Static strings:Strings.Instance}}" Tag="abs(a - 0.5) &gt; 0.25"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Macro_Expression_Recipe_AxisOverHalf_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <!-- Shared recipes from the merge-mapping editor. Same Pad_Formula_Preset_*
                                         keys, already translated across all 10 locales. -->
                                    <Button Content="{Binding Pad_Formula_Preset_HalfScale_Name, Source={x:Static strings:Strings.Instance}}" Tag="a * 0.5"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Pad_Formula_Preset_HalfScale_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Formula_Preset_QuarterScale_Name, Source={x:Static strings:Strings.Instance}}" Tag="a * 0.25"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Pad_Formula_Preset_QuarterScale_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Formula_Preset_ReverseA_Name, Source={x:Static strings:Strings.Instance}}" Tag="-a"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Pad_Formula_Preset_ReverseA_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Formula_Preset_CapTo1_Name, Source={x:Static strings:Strings.Instance}}" Tag="clamp(a + b, -1, 1)"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Pad_Formula_Preset_CapTo1_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Formula_Preset_WeightedBlend_Name, Source={x:Static strings:Strings.Instance}}" Tag="a * 0.7 + b * 0.3"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Pad_Formula_Preset_WeightedBlend_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Formula_Preset_Difference_Name, Source={x:Static strings:Strings.Instance}}" Tag="a - b"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Pad_Formula_Preset_Difference_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Formula_Preset_AUnlessIdle_Name, Source={x:Static strings:Strings.Instance}}" Tag="a != 0 ? a : b"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Pad_Formula_Preset_AUnlessIdle_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Formula_Preset_ThresholdGate_Name, Source={x:Static strings:Strings.Instance}}" Tag="(a &gt; 0.5) ? 1 : 0"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Pad_Formula_Preset_ThresholdGate_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Formula_Preset_BothPressed_Name, Source={x:Static strings:Strings.Instance}}" Tag="(a &gt; 0) &amp;&amp; (b &gt; 0) ? 1 : 0"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Pad_Formula_Preset_BothPressed_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Formula_Preset_StrongerWins_Name, Source={x:Static strings:Strings.Instance}}" Tag="max(abs(a), abs(b)) * sign(a + b)"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Pad_Formula_Preset_StrongerWins_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                </WrapPanel>

                                <!-- Variable list. Each row binds one variable to either an
                                     input-device input or an output-controller channel. -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Macro_Expression_Variables, Source={x:Static strings:Strings.Instance}}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <Button Content="{Binding Macro_Expression_AddVariable, Source={x:Static strings:Strings.Instance}}"
                                            Command="{Binding AddExpressionVariableCommand}"
                                            Padding="8,2"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding TriggerExpressionVariables}"
                                              AlternationCount="32">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource TextFillColorTertiaryBrush}"
                                                    BorderThickness="1" CornerRadius="3"
                                                    Padding="6,4" Margin="0,0,0,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource IndexToLetterConverter}}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"
                                                               FontFamily="{StaticResource TelemetryFontFamily}"
                                                               FontWeight="SemiBold"/>
                                                    <ComboBox SelectedValue="{Binding Source, Mode=TwoWay}"
                                                              SelectedValuePath="Tag" MinWidth="140" Margin="0,0,8,0">
                                                        <ComboBoxItem Content="{Binding Macro_InputDevice, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerSource.InputDevice}"/>
                                                        <ComboBoxItem Content="{Binding Macro_OutputController, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerSource.OutputController}"/>
                                                        <ComboBoxItem Content="{Binding Macro_GameTelemetry, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerSource.GameTelemetry}"/>
                                                    </ComboBox>
                                                    <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="Source" SettingLabel="{Binding Macro_Source, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroExpressionVariable_Source_1644" Margin="4,0,8,0"/>
                                                    <!-- Game telemetry channel (#531): speed, RPM, gear, the
                                                         pedals in percent, or a custom format's variable, in
                                                         the channel's own unit. -->
                                                    <ComboBox ItemsSource="{x:Static vm:TelemetryChannelOptions.Items}"
                                                              SelectedItem="{Binding TelemetryOption, Mode=TwoWay}"
                                                              DisplayMemberPath="Display"
                                                              MinWidth="220" Margin="0,0,8,0"
                                                              AutomationProperties.Name="{Binding Macro_GameTelemetry, Source={x:Static strings:Strings.Instance}}"
                                                              Visibility="{Binding Source, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=GameTelemetry}"/>
                                                    <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="TelemetryChannel" SettingLabel="{Binding Macro_GameTelemetry, Source={x:Static strings:Strings.Instance}}" Visibility="{Binding Source, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=GameTelemetry}" AutomationProperties.AutomationId="Reset_MacroExpressionVariable_TelemetryChannel_1648" Margin="4,0,8,0"/>
                                                    <!-- OutputChannel dropdown. Items are sourced from the
                                                         parent macro's OutputChannelOptions list, which renders
                                                         labels per the slot's VC family (matches the mapping
                                                         table: PlayStation ✕/○/◻/△ + L1/R1, Extended
                                                         Button N, Xbox A/B/X/Y + Left Shoulder, etc.). -->
                                                    <ComboBox ItemsSource="{Binding DataContext.OutputChannelOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              SelectedValue="{Binding OutputChannel, Mode=TwoWay}"
                                                              SelectedValuePath="Value"
                                                              DisplayMemberPath="Name"
                                                              MinWidth="160" Margin="0,0,8,0"
                                                              Visibility="{Binding Source, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=OutputController}"/>
                                                    <!-- Gated with the control it resets: an ungated reset left a lone button behind a hidden setting. -->
                                                    <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="OutputChannel" SettingLabel="{Binding ResetLabel_OutputChannel, Source={x:Static strings:Strings.Instance}}" Visibility="{Binding Source, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=OutputController}" AutomationProperties.AutomationId="Reset_MacroExpressionVariable_OutputChannel_1658" Margin="4,0,8,0"/>
                                                    <TextBlock Text="{Binding DisplaySummary}"
                                                               VerticalAlignment="Center"
                                                               FontStyle="Italic"
                                                               TextTrimming="CharacterEllipsis"
                                                               MinWidth="120"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Visibility="{Binding Source, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=InputDevice}"/>
                                                    <!-- Record / Stop button. Works for both Input Device
                                                         (captures the next press / axis on a physical device)
                                                         and Output Controller (captures the next change on the
                                                         slot's combined Gamepad output). Shares the
                                                         EmberIconButtonHot chrome with the merge-mapping
                                                         per-source Record buttons for visual parity. A
                                                         telemetry variable is picked, not recorded (#531). -->
                                                    <ui:Button Command="{Binding RecordCommand}"
                                                               Style="{StaticResource EmberIconButtonHot}"
                                                               Visibility="{Binding Source, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=InputDevice|OutputController}"
                                                               VerticalAlignment="Center">
                                                        <controls:GlyphText Text="{Binding RecordIcon}" FontFamily="Segoe MDL2 Assets"
                                                                   Foreground="{DynamicResource EmberBrush}"/>
                                                        <ui:Button.ToolTip>
                                                            <TextBlock Text="{Binding RecordTooltip}"/>
                                                        </ui:Button.ToolTip>
                                                    </ui:Button>
                                                    <!-- Clear binding button. Keeps the variable slot but
                                                         resets the device/channel binding. -->
                                                    <ui:Button AutomationProperties.Name="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}" Command="{Binding ClearBindingCommand}"
                                                               Style="{StaticResource EmberIconButtonHot}"
                                                               VerticalAlignment="Center">
                                                        <controls:GlyphText Text="&#xE75C;" FontFamily="Segoe MDL2 Assets"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                        <ui:Button.ToolTip>
                                                            <TextBlock Text="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}"/>
                                                        </ui:Button.ToolTip>
                                                    </ui:Button>
                                                    <!-- Delete variable button. Removes the row from the
                                                         macro's variable list. Subsequent variables shift
                                                         letters (b becomes a, etc.). Binds back up to the
                                                         macro via RelativeSource AncestorType=ItemsControl. -->
                                                    <ui:Button AutomationProperties.Name="{Binding Common_Delete, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource EmberIconButtonHot}"
                                                               VerticalAlignment="Center"
                                                               Command="{Binding DataContext.RemoveExpressionVariableCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding}">
                                                        <controls:GlyphText Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                        <ui:Button.ToolTip>
                                                            <TextBlock Text="{Binding Common_Delete, Source={x:Static strings:Strings.Instance}}"/>
                                                        </ui:Button.ToolTip>
                                                    </ui:Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding Macro_Expression_Hint, Source={x:Static strings:Strings.Instance}}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Trigger combination (visible only when one of OnPress / OnRelease / WhileHeld) -->
                            <StackPanel Visibility="{Binding ShowsTriggerComboEditor, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Source, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                               Width="80" Margin="0,0,8,0"/>
                                    <ComboBox SelectedValue="{Binding TriggerSource, Mode=TwoWay}"
                                              SelectedValuePath="Tag" MinWidth="160">
                                        <ComboBoxItem Content="{Binding Macro_InputDevice, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerSource.InputDevice}"/>
                                        <ComboBoxItem Content="{Binding Macro_OutputController, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerSource.OutputController}"/>
                                    </ComboBox>
                                    <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="TriggerSource" SettingLabel="{Binding Macro_Source, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroItem_TriggerSource_1724"/>
                                </StackPanel>
                                <!-- Dropdown trigger picker (#177): appends an input to the
                                     combo without recording. The list is the slot's cross-device
                                     choices filtered to entry-convertible descriptors, so the
                                     touchpad gestures the user enabled on the Touchpad tab are
                                     pickable here (recording can't capture them, and the issue
                                     reporter explicitly did not want it to). Kept aligned under
                                     the Source dropdown. -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding Macro_AddTriggerFromList, Source={x:Static strings:Strings.Instance}}"
                                               Width="80" Margin="0,0,8,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding DataContext.SlotMacroTriggerChoicesView, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              DisplayMemberPath="DisplayName" MinWidth="220" Padding="4,2"
                                              SelectionChanged="MacroTriggerPick_SelectionChanged"
                                              PreviewKeyDown="MacroTriggerPick_PreviewKeyDown"
                                              IsTextSearchEnabled="False"
                                              ToolTip="{Binding Macro_AddTriggerFromList_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                              ScrollViewer.VerticalScrollBarVisibility="Visible">
                                        <ComboBox.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,3,6,3">
                                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ComboBox.GroupStyle>
                                    </ComboBox>
                                </StackPanel>
                                <!-- Record + Clear all, above the list like the action sequence's
                                     Add / Remove / Duplicate sit above its list. -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ui:Button Command="{Binding RecordTriggerCommand}" Style="{StaticResource EmberIconButtonHot}">
                                        <controls:GlyphText Text="{Binding RecordTriggerIcon}" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource EmberBrush}"/>
                                        <ui:Button.ToolTip>
                                            <TextBlock Text="{Binding RecordTriggerButtonText}"/>
                                        </ui:Button.ToolTip>
                                    </ui:Button>
                                    <ui:Button AutomationProperties.Name="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}" Command="{Binding ClearTriggerCommand}" Style="{StaticResource EmberIconButtonHot}">
                                        <controls:GlyphText Text="&#xE75C;" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <ui:Button.ToolTip>
                                            <TextBlock Text="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}"/>
                                        </ui:Button.ToolTip>
                                    </ui:Button>
                                </StackPanel>
                                <TextBlock Text="{Binding Macro_RecordHint, Source={x:Static strings:Strings.Instance}}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,0,4"/>
                                <!-- Live preview of what's being recorded, just above the list. -->
                                <TextBlock Text="{Binding RecordingLiveText}" FontWeight="SemiBold" Margin="0,0,0,4"
                                           Visibility="{Binding IsRecordingTrigger, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <!-- Trigger inputs as a scrollable list, one removable row per
                                     input, in the same steel-lined well the action sequence uses.
                                     Each input keeps the mapping grid's cold chip grammar
                                     (#175 item 80). The X drops just that input. -->
                                <Border BorderBrush="{DynamicResource SteelLineBrush}" BorderThickness="1"
                                        CornerRadius="6" Background="{DynamicResource SteelRaisedBrush}"
                                        Padding="4" Margin="0,0,0,4">
                                    <Grid>
                                        <TextBlock Text="{Binding Macro_NotSet, Source={x:Static strings:Strings.Instance}}"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Margin="4,2" VerticalAlignment="Center"
                                                   Visibility="{Binding HasTriggerInputItems, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                        <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      Visibility="{Binding HasTriggerInputItems, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <!-- Right inset clears the 14px always-on overlay scrollbar so it
                                                 doesn't sit on top of the row X buttons. -->
                                            <ItemsControl ItemsSource="{Binding TriggerInputItems}" Margin="0,0,16,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <Border Style="{StaticResource ChipCold}" HorizontalAlignment="Left">
                                                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                                                                </Border>
                                                                <!-- Axis rows only: Invert / Half / Either + a labeled
                                                                     Deadzone. Folded in from what used to be a second,
                                                                     duplicate axis list, and the bare "%" now reads
                                                                     "Deadzone". Wraps if the row is narrow. -->
                                                                <WrapPanel Orientation="Horizontal" Margin="0,3,0,1"
                                                                           Visibility="{Binding IsAxis, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Invert, Source={x:Static strings:Strings.Instance}}"
                                                                              IsChecked="{Binding AxisEntry.Invert, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              IsEnabled="{Binding AxisEntry.IsInvertApplicable}"
                                                                              VerticalAlignment="Center" Margin="0,0,6,2"/>
                                                                    <reset:SettingResetButton Command="{Binding AxisEntry.ResetSettingCommand}" CommandParameter="Invert" SettingLabel="{Binding Pad_Invert, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_TriggerInputEntry_Invert_1825" Margin="4,0,8,0"/>
                                                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Half, Source={x:Static strings:Strings.Instance}}"
                                                                              IsChecked="{Binding AxisEntry.HalfAxis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              VerticalAlignment="Center" Margin="0,0,6,2"/>
                                                                    <reset:SettingResetButton Command="{Binding AxisEntry.ResetSettingCommand}" CommandParameter="HalfAxis" SettingLabel="{Binding Pad_Half, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_TriggerInputEntry_HalfAxis_1828" Margin="4,0,8,0"/>
                                                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Either, Source={x:Static strings:Strings.Instance}}"
                                                                              ToolTip="{Binding Pad_Either_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                                              IsChecked="{Binding AxisEntry.Bidirectional, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              IsEnabled="{Binding AxisEntry.HalfAxis}"
                                                                              VerticalAlignment="Center" Margin="0,0,10,2"/>
                                                                    <reset:SettingResetButton Command="{Binding AxisEntry.ResetSettingCommand}" CommandParameter="Bidirectional" SettingLabel="{Binding Pad_Either, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_TriggerInputEntry_Bidirectional_1833" Margin="4,0,8,0"/>
                                                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Sticks_Section_DeadZone, Source={x:Static strings:Strings.Instance}}"
                                                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                    <Slider Style="{StaticResource DzSlider}" Width="120" Minimum="1"
                                                                            Value="{Binding AxisEntry.DeadZone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                            TickFrequency="1"/>
                                                                    <TextBox Text="{Binding AxisEntry.DeadZone, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                             Style="{StaticResource DzValueEdit}"/>
                                                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                                    <ui:Button Command="{Binding AxisEntry.ResetDeadZoneCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Common_Reset_DeadZone, Source={x:Static strings:Strings.Instance}}"/>
                                                                </WrapPanel>
                                                                <!-- Thresholded descriptor rows (#468): the depth or
                                                                     radius the input fires at, the mapping grid's
                                                                     button-row Deadzone. On an analog key it is the
                                                                     actuation point, so two entries at two values are
                                                                     a soft press and a full press. -->
                                                                <WrapPanel Orientation="Horizontal" Margin="0,3,0,1"
                                                                           Visibility="{Binding HasThreshold, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Sticks_Section_DeadZone, Source={x:Static strings:Strings.Instance}}"
                                                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                    <Slider Style="{StaticResource DzSlider}" Width="120" Minimum="1"
                                                                            Value="{Binding ThresholdEntry.DescriptorThresholdPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                            TickFrequency="1"/>
                                                                    <TextBox Text="{Binding ThresholdEntry.DescriptorThresholdPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                             Style="{StaticResource DzValueEdit}"/>
                                                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                                    <ui:Button Command="{Binding ThresholdEntry.ResetDescriptorDeadZoneCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Common_Reset_DeadZone, Source={x:Static strings:Strings.Instance}}"/>
                                                                </WrapPanel>
                                                            </StackPanel>
                                                            <ui:Button AutomationProperties.Name="{Binding Macro_RemoveTriggerInput, Source={x:Static strings:Strings.Instance}}" Grid.Column="1" Command="{Binding RemoveCommand}"
                                                                       Style="{StaticResource EmberIconButtonHot}"
                                                                       VerticalAlignment="Top">
                                                                <controls:GlyphText Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                                <ui:Button.ToolTip>
                                                                    <TextBlock Text="{Binding Macro_RemoveTriggerInput, Source={x:Static strings:Strings.Instance}}"/>
                                                                </ui:Button.ToolTip>
                                                            </ui:Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                                <!-- Legacy slot-combined axis Threshold + Direction. Visible
                                     only for OutputController-source triggers that landed in
                                     the slot-combined TriggerAxisTargets list. InputDevice
                                     triggers go through the per-device axis entries below and
                                     carry their own Invert / Half / DeadZone, so these
                                     duplicate controls would just be redundant + confusing. -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                            Visibility="{Binding HasLegacyAxisTrigger, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Threshold, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <Slider Value="{Binding TriggerAxisThreshold, Mode=TwoWay}"
                                            Minimum="1" Maximum="100" Width="150"
                                            VerticalAlignment="Center"/>
                                    <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="TriggerAxisThreshold" SettingLabel="{Binding Macro_Threshold, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroItem_TriggerAxisThreshold_1873" Margin="4,0,8,0"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding TriggerAxisThreshold, Mode=OneWay}"/>
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="%"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                            Visibility="{Binding HasLegacyAxisTrigger, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_AxisDirection, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <ComboBox SelectedIndex="{Binding TriggerAxisDirectionIndex, Mode=TwoWay}" MinWidth="120">
                                        <ComboBoxItem Content="{Binding Macro_AxisDirection_Any, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Macro_AxisDirection_Positive, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Macro_AxisDirection_Negative, Source={x:Static strings:Strings.Instance}}"/>
                                    </ComboBox>
                                    <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="TriggerAxisDirectionIndex" SettingLabel="{Binding Macro_AxisDirection, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroItem_TriggerAxisDirectionIndex_1884"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <CheckBox VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Macro_ConsumeTrigger, Source={x:Static strings:Strings.Instance}}"
                                              ToolTip="{Binding Macro_ConsumeTrigger_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding ConsumeTriggerButtons, Mode=TwoWay}"/>
                                    <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="ConsumeTriggerButtons" SettingLabel="{Binding Macro_ConsumeTrigger, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroItem_ConsumeTriggerButtons_1894"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Always mode note -->
                            <TextBlock Text="{Binding Macro_AlwaysDesc, Source={x:Static strings:Strings.Instance}}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,4"
                                       Visibility="{Binding IsNotAlwaysMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>

                            <Separator Margin="0,4,0,12"/>

                            <!-- Action sequence -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="3" CornerRadius="1.5" Margin="0,2,7,2"
                                        Background="{DynamicResource EmberBrush}"/>
                                <TextBlock Text="{Binding Macro_ActionSequence, Source={x:Static strings:Strings.Instance}}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="{Binding Macro_AddAction, Source={x:Static strings:Strings.Instance}}" Command="{Binding AddActionCommand}"
                                        Padding="8,4" Margin="0,0,4,0"/>
                                <Button Content="{Binding Common_Remove, Source={x:Static strings:Strings.Instance}}" Command="{Binding RemoveActionCommand}"
                                        Padding="8,4" Margin="0,0,4,0"/>
                                <Button Content="{Binding Common_Duplicate, Source={x:Static strings:Strings.Instance}}" Command="{Binding DuplicateActionCommand}"
                                        Padding="8,4"/>
                            </StackPanel>
                            <!-- Action steps as ember dst chips (#175 item 80):
                                 each step writes output, so the rows inherit the
                                 mapping grid's ember chip grammar. Selection and
                                 interaction stay on the ListBox container. -->
                            <!-- Bounding box so the sequence reads as one list (user
                                 report): a steel-lined well. Drag a chip to reorder.
                                 The drop commits Actions.Move (handlers in code-behind). -->
                            <Border BorderBrush="{DynamicResource SteelLineBrush}" BorderThickness="1"
                                    CornerRadius="6" Background="{DynamicResource SteelRaisedBrush}"
                                    Padding="4" Margin="0,0,0,4">
                                <ListBox x:Name="ActionsList" ItemsSource="{Binding Actions}"
                                         SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                                         ItemContainerStyle="{StaticResource EmberSelectListItem}"
                                         Background="Transparent" BorderThickness="0"
                                         MinHeight="100" MaxHeight="200"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         AllowDrop="True"
                                         PreviewKeyDown="ActionsList_PreviewKeyDown"
                                         PreviewMouseLeftButtonDown="ActionsList_PreviewMouseLeftButtonDown"
                                         PreviewMouseMove="ActionsList_PreviewMouseMove"
                                         DragOver="ActionsList_DragOver"
                                         Drop="ActionsList_Drop">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Wrap long summaries (e.g. a multi-button Button Press)
                                                 instead of running off the edge. The list disables
                                                 horizontal scroll so the chip is width-constrained and
                                                 the text wraps to a second line. -->
                                            <Border Style="{StaticResource ChipEmber}"
                                                    HorizontalAlignment="Left" Margin="0,1">
                                                <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap"/>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <!-- Action editor (shows when an action is selected) -->
                            <Border BorderBrush="{DynamicResource TextFillColorTertiaryBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,12"
                                    DataContext="{Binding SelectedAction}"
                                    Visibility="{Binding DataContext.SelectedAction,
                                        RelativeSource={RelativeSource AncestorType=ScrollViewer},
                                        Converter={StaticResource NullToCollapsedConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Macro_EditAction, Source={x:Static strings:Strings.Instance}}" FontWeight="SemiBold" Margin="0,0,0,8"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                    <!-- Action type -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_ActionType, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                   Width="80" Margin="0,0,8,0"/>
                                        <ComboBox SelectedValue="{Binding Type, Mode=TwoWay}"
                                                  SelectedValuePath="Type" MinWidth="150"
                                                  ItemsSource="{Binding Source={x:Static vm:MacroTypeCatalog.View}}"
                                                  DisplayMemberPath="Label"
                                                  IsSynchronizedWithCurrentItem="False"
                                                  VirtualizingPanel.IsVirtualizing="True"
                                                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                                  VirtualizingPanel.VirtualizationMode="Recycling">
                                            <!-- Grouped action-type picker: the catalog carries
                                                 every MacroActionType exactly once (census-
                                                 pinned), grouped by what the action acts on,
                                                 the cross-device input picker's GroupStyle
                                                 arrangement. Tooltips ride the item container. -->
                                            <ComboBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel/>
                                                </ItemsPanelTemplate>
                                            </ComboBox.ItemsPanel>
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                                    <Setter Property="ToolTip" Value="{Binding Tooltip}"/>
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                            <ComboBox.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                                    Padding="6,3,6,3">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ComboBox.GroupStyle>
                                        </ComboBox>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="Type" SettingLabel="{Binding Macro_ActionType, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_Type_1980"/>
                                    </StackPanel>

                                    <!-- Disconnect Controller editor (#162). Target mode + device picker -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsDisconnectControllerType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MacroDisconnect_Target_Label, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <ComboBox SelectedValue="{Binding DisconnectTarget, Mode=TwoWay}"
                                                      SelectedValuePath="Tag"
                                                      Width="220" VerticalAlignment="Center"
                                                      ToolTip="{Binding MacroAction_DisconnectController_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                                <ComboBoxItem Content="{Binding MacroDisconnect_TriggeringDevice, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroDisconnectTarget.TriggeringDevice}"/>
                                                <ComboBoxItem Content="{Binding MacroDisconnect_SpecificDevice, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroDisconnectTarget.SpecificDevice}"/>
                                                <ComboBoxItem Content="{Binding MacroDisconnect_SlotDevices, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroDisconnectTarget.SlotDevices}"/>
                                                <ComboBoxItem Content="{Binding MacroDisconnect_AllDevices, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroDisconnectTarget.AllDevices}"/>
                                            </ComboBox>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="DisconnectTarget" SettingLabel="{Binding MacroDisconnect_Target_Label, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_DisconnectTarget_2024"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                                    Visibility="{Binding IsDisconnectSpecificDevice, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MacroDisconnect_Device_Label, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <ComboBox ItemsSource="{Binding DisconnectDeviceOptions}"
                                                      SelectedValue="{Binding DisconnectDeviceGuid, Mode=TwoWay}"
                                                      SelectedValuePath="Guid" DisplayMemberPath="Name"
                                                      Width="220" VerticalAlignment="Center"/>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="DisconnectDeviceGuid" SettingLabel="{Binding MacroDisconnect_Device_Label, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_DisconnectDeviceGuid_2038"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding MacroDisconnect_Caveat, Source={x:Static strings:Strings.Instance}}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Run Program editor. Same 80px label column as every other
                                         editor so the fields line up with the type dropdown. The
                                         Working directory label wraps to a second line rather than clip. -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsRunProgramType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MacroAction_RunProgram_Path, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding ProgramPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="220" VerticalAlignment="Center"/>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="ProgramPath" SettingLabel="{Binding MacroAction_RunProgram_Path, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_ProgramPath_2054" Margin="4,0,8,0"/>
                                            <Button Content="{Binding Common_Browse, Source={x:Static strings:Strings.Instance}}"
                                                    Click="RunProgramBrowseFile_Click" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MacroAction_RunProgram_Args, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding ProgramArgs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="220" VerticalAlignment="Center"/>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="ProgramArgs" SettingLabel="{Binding MacroAction_RunProgram_Args, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_ProgramArgs_2062"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MacroAction_RunProgram_WorkingDir, Source={x:Static strings:Strings.Instance}}"
                                                       ToolTip="{Binding MacroAction_RunProgram_WorkingDir_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding ProgramWorkingDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="{Binding MacroAction_RunProgram_WorkingDir_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                     Width="220" VerticalAlignment="Center"/>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="ProgramWorkingDir" SettingLabel="{Binding MacroAction_RunProgram_WorkingDir, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_ProgramWorkingDir_2070" Margin="4,0,8,0"/>
                                            <Button Content="{Binding Common_Browse, Source={x:Static strings:Strings.Instance}}"
                                                    Click="RunProgramBrowseFolder_Click" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Text Block editor (#201). Multiline text typed out via
                                         Unicode injection. Newlines press Enter, tab CHARACTERS
                                         press Tab. AcceptsTab stays off on purpose: the Tab key
                                         keeps moving focus between fields, so a tab character
                                         only enters the text via paste (the tooltip says so).
                                         Same 80px label column as the other editors. -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsTextBlockType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MacroAction_TextBlock_Text, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" TextWrapping="Wrap" VerticalAlignment="Top"/>
                                            <TextBox Text="{Binding TextContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="{Binding MacroAction_TextBlock_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                     Width="220" Height="64" AcceptsReturn="True"
                                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                     VerticalContentAlignment="Top"/>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="TextContent" SettingLabel="{Binding MacroAction_TextBlock_Text, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_TextContent_2091"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MacroAction_TextBlock_Delay, Source={x:Static strings:Strings.Instance}}"
                                                       ToolTip="{Binding MacroAction_TextBlock_Delay_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <!-- Commits on LostFocus like every sibling int box in this
                                                 editor. PropertyChanged would push each intermediate
                                                 keystroke (typing 500 commits 5, then 50, then 500)
                                                 live into a running macro's pacing. -->
                                            <TextBox Text="{Binding TextPerCharDelayMs, Mode=TwoWay}"
                                                     ToolTip="{Binding MacroAction_TextBlock_Delay_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                     Width="60" TextAlignment="Center" VerticalAlignment="Center"/>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="TextPerCharDelayMs" SettingLabel="{Binding MacroAction_TextBlock_Delay, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_TextPerCharDelayMs_2103"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- SetGyroEngaged Mode picker: Toggle / On / Off -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                                Visibility="{Binding IsSetGyroEngagedType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_SetGyroEngaged_Mode_Label, Source={x:Static strings:Strings.Instance}}"
                                                   Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <ComboBox SelectedValue="{Binding SetGyroEngagedMode, Mode=TwoWay}"
                                                  SelectedValuePath="Tag"
                                                  Width="160" VerticalAlignment="Center"
                                                  ScrollViewer.VerticalScrollBarVisibility="Visible"
                                                  ToolTip="{Binding Macro_SetGyroEngaged_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                            <ComboBoxItem Content="{Binding Macro_SetGyroEngaged_Toggle, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroSetGyroEngagedMode.Toggle}"/>
                                            <ComboBoxItem Content="{Binding Macro_SetGyroEngaged_On, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroSetGyroEngagedMode.On}"/>
                                            <ComboBoxItem Content="{Binding Macro_SetGyroEngaged_Off, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroSetGyroEngagedMode.Off}"/>
                                        </ComboBox>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="SetGyroEngagedMode" SettingLabel="{Binding Macro_SetGyroEngaged_Mode_Label, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_SetGyroEngagedMode_2116"/>
                                    </StackPanel>

                                    <!-- Gyro Recenter card (issue #9 wave 1b, B-18). Parameter-less.
                                         The card explains what one fire resets, mirroring the Stop
                                         Sounds card shape. -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6"
                                            Visibility="{Binding IsGyroRecenterType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MacroAction_Type_GyroRecenter, Source={x:Static strings:Strings.Instance}}"
                                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding MacroAction_GyroRecenter_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Combo Break card (discussion #237). Parameter-less. The card
                                         explains the park and resume behavior, mirroring the Gyro
                                         Recenter card shape. -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6"
                                            Visibility="{Binding IsComboBreakType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MacroAction_Type_ComboBreak, Source={x:Static strings:Strings.Instance}}"
                                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding MacroAction_ComboBreak_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Cursor Recenter Mode picker (#108). X / Y / X+Y -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                                Visibility="{Binding IsMouseRecenterType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_CursorRecenterMode_Label, Source={x:Static strings:Strings.Instance}}"
                                                   Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <ComboBox SelectedValue="{Binding CursorRecenterMode, Mode=TwoWay}"
                                                  SelectedValuePath="Tag"
                                                  Width="160" VerticalAlignment="Center"
                                                  ToolTip="{Binding MacroAction_MouseRecenter_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                            <ComboBoxItem Content="X+Y" Tag="{x:Static vm:CursorRecenterMode.XAndY}"/>
                                            <ComboBoxItem Content="X" Tag="{x:Static vm:CursorRecenterMode.XOnly}"/>
                                            <ComboBoxItem Content="Y" Tag="{x:Static vm:CursorRecenterMode.YOnly}"/>
                                        </ComboBox>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="CursorRecenterMode" SettingLabel="{Binding Macro_CursorRecenterMode_Label, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_CursorRecenterMode_2159"/>
                                    </StackPanel>

                                    <!-- Fix Mouse Position editor (#109). Mode + Pin X / Pin Y -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsMouseFixPositionType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_CursorPinMode_Label, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <ComboBox SelectedValue="{Binding CursorPinMode, Mode=TwoWay}"
                                                      SelectedValuePath="Tag"
                                                      Width="160" VerticalAlignment="Center"
                                                      ToolTip="{Binding MacroAction_MouseFixPosition_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                                <ComboBoxItem Content="X+Y" Tag="{x:Static vm:CursorPinMode.XAndY}"/>
                                                <ComboBoxItem Content="X" Tag="{x:Static vm:CursorPinMode.XOnly}"/>
                                                <ComboBoxItem Content="Y" Tag="{x:Static vm:CursorPinMode.YOnly}"/>
                                            </ComboBox>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="CursorPinMode" SettingLabel="{Binding Macro_CursorPinMode_Label, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_CursorPinMode_2175"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_CursorPinX_Label, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding CursorPinX, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                     Width="80" VerticalAlignment="Center"/>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="CursorPinX" SettingLabel="{Binding Macro_CursorPinX_Label, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_CursorPinX_2185"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_CursorPinY_Label, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding CursorPinY, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                     Width="80" VerticalAlignment="Center"/>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="CursorPinY" SettingLabel="{Binding Macro_CursorPinY_Label, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_CursorPinY_2191"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Macro_CursorWrite_Caveat, Source={x:Static strings:Strings.Instance}}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Limit Mouse Region editor (#110). Mode + Inset X / Inset Y -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsMouseLimitRegionType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_CursorClampMode_Label, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <ComboBox SelectedValue="{Binding CursorClampMode, Mode=TwoWay}"
                                                      SelectedValuePath="Tag"
                                                      Width="160" VerticalAlignment="Center"
                                                      ToolTip="{Binding MacroAction_MouseLimitRegion_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                                <ComboBoxItem Content="X+Y" Tag="{x:Static vm:CursorClampMode.XAndY}"/>
                                                <ComboBoxItem Content="X" Tag="{x:Static vm:CursorClampMode.XOnly}"/>
                                                <ComboBoxItem Content="Y" Tag="{x:Static vm:CursorClampMode.YOnly}"/>
                                            </ComboBox>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="CursorClampMode" SettingLabel="{Binding Macro_CursorClampMode_Label, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_CursorClampMode_2207"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_CursorClampInsetX_Label, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding CursorClampInsetX, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                     Width="80" VerticalAlignment="Center"/>
                                            <ui:Button Command="{Binding ResetCursorClampInsetXCommand}" Style="{StaticResource ResetButton}" Margin="8,0,0,0" ToolTip="{Binding Macro_Reset_InsetX, Source={x:Static strings:Strings.Instance}}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_CursorClampInsetY_Label, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding CursorClampInsetY, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                     Width="80" VerticalAlignment="Center"/>
                                            <ui:Button Command="{Binding ResetCursorClampInsetYCommand}" Style="{StaticResource ResetButton}" Margin="8,0,0,0" ToolTip="{Binding Macro_Reset_InsetY, Source={x:Static strings:Strings.Instance}}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_CursorClampOffsetX_Label, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding CursorClampOffsetX, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                     Width="80" VerticalAlignment="Center"/>
                                            <ui:Button Command="{Binding ResetCursorClampOffsetXCommand}" Style="{StaticResource ResetButton}" Margin="8,0,0,0" ToolTip="{Binding Macro_Reset_OffsetX, Source={x:Static strings:Strings.Instance}}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_CursorClampOffsetY_Label, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding CursorClampOffsetY, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                     Width="80" VerticalAlignment="Center"/>
                                            <ui:Button Command="{Binding ResetCursorClampOffsetYCommand}" Style="{StaticResource ResetButton}" Margin="8,0,0,0" ToolTip="{Binding Macro_Reset_OffsetY, Source={x:Static strings:Strings.Instance}}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Macro_CursorWrite_Caveat, Source={x:Static strings:Strings.Instance}}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Move Mouse to Screen Position editor (#9). Mouse X / Mouse Y + on-screen pick -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsMoveMouseToScreenPositionType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_MouseX_Label, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding MouseX, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                     Width="80" VerticalAlignment="Center"/>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="MouseX" SettingLabel="{Binding Macro_MouseX_Label, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_MouseX_2239"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_MouseY_Label, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding MouseY, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                     Width="80" VerticalAlignment="Center"/>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="MouseY" SettingLabel="{Binding Macro_MouseY_Label, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_MouseY_2245"/>
                                        </StackPanel>
                                        <Button Content="{Binding MousePickButtonText}" Command="{Binding PickMousePositionCommand}"
                                                HorizontalAlignment="Left" Padding="8,4" Margin="0,0,0,4"
                                                ToolTip="{Binding Macro_PickOnScreen_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBlock Text="{Binding Macro_CursorWrite_Caveat, Source={x:Static strings:Strings.Instance}}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Nudge Cursor editor (v16): signed dx / dy pixel deltas.
                                         Deliberately no on-screen pick: a nudge is a relative
                                         offset, not a coordinate. -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsMouseNudgeType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_MouseX_Label, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding NudgeDx, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                     Width="80" VerticalAlignment="Center"/>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="NudgeDx" SettingLabel="{Binding Macro_MouseX_Label, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_NudgeDx_2264"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_MouseY_Label, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding NudgeDy, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                     Width="80" VerticalAlignment="Center"/>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="NudgeDy" SettingLabel="{Binding Macro_MouseY_Label, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_NudgeDy_2270"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Macro_CursorWrite_Caveat, Source={x:Static strings:Strings.Instance}}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Cycle Tap List editor (v16): the step CSV plus the wrap
                                         toggle. The CSV is the persisted vocabulary the importer
                                         writes (see MacroAction.CycleStepsCsv). -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsCycleTapListType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_CycleSteps_Label, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding CycleStepsCsv, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     Width="220" VerticalAlignment="Center"/>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="CycleStepsCsv" SettingLabel="{Binding Macro_CycleSteps_Label, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_CycleStepsCsv_2286"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox VerticalAlignment="Center" IsChecked="{Binding CycleWrap, Mode=TwoWay}"
                                                      Content="{Binding Macro_CycleWrap_Label, Source={x:Static strings:Strings.Instance}}"/>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="CycleWrap" SettingLabel="{Binding Macro_CycleWrap_Label, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_CycleWrap_2289"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Pulse while latched (v19, M1): the toggle latches
                                         (button / key / mouse button / axis) can pulse their held
                                         contribution on the turbo square wave. Checking it surfaces
                                         the shared Interval row below. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                                Visibility="{Binding IsPulseCapableType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                  IsChecked="{Binding PulseWhileLatched, Mode=TwoWay}"
                                                  Content="{Binding Macro_PulseWhileLatched, Source={x:Static strings:Strings.Instance}}"
                                                  ToolTip="{Binding Macro_PulseWhileLatched_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="PulseWhileLatched" SettingLabel="{Binding Macro_PulseWhileLatched, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_PulseWhileLatched_2301"/>
                                    </StackPanel>

                                    <!-- Turbo interval (#9 + wave 1b, widened v19 M1): shared by the
                                         Repeat While Held turbos, Toggle Wheel Scroll, and any pulsing
                                         latch. Key picker / button grid are the shared panels below. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                                Visibility="{Binding IsRepeatIntervalType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_RepeatInterval_Label, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                   Width="80" Margin="0,0,8,0"/>
                                        <TextBox Text="{Binding IntervalMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="80"/>
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        <ui:Button Command="{Binding ResetIntervalMsCommand}" Style="{StaticResource ResetButton}" Margin="8,0,0,0" ToolTip="{Binding Macro_Reset_Interval, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>

                                    <!-- Pressure-scaled turbo (#290): rate follows an analog source.
                                         The Interval row above becomes the FAST end (full press).
                                         Slow Interval is the light-press end. The curve shapes the
                                         pressure between them. Source pickers reuse the sender-generic
                                         DeviceAxisPicker handlers the volume rows already use. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                                Visibility="{Binding IsRepeatIntervalType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                  IsChecked="{Binding PressureScaledRate, Mode=TwoWay}"
                                                  Content="{Binding Macro_PressureScaledRate, Source={x:Static strings:Strings.Instance}}"
                                                  ToolTip="{Binding Macro_PressureScaledRate_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="PressureScaledRate" SettingLabel="{Binding Macro_PressureScaledRate, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_PressureScaledRate_2326"/>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding ShowsPressureTurboRows, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_SlowInterval_Label, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"
                                                       ToolTip="{Binding Macro_SlowInterval_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <TextBox Text="{Binding SlowIntervalMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="80"/>
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            <ui:Button Command="{Binding ResetSlowIntervalMsCommand}" Style="{StaticResource ResetButton}" Margin="8,0,0,0" ToolTip="{Binding Macro_Reset_SlowInterval, Source={x:Static strings:Strings.Instance}}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_TurboRateCurve_Label, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"/>
                                            <ComboBox ItemsSource="{Binding TurboRateCurveOptions}"
                                                      DisplayMemberPath="Display"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding TurboRateCurve, Mode=TwoWay}"
                                                      MinWidth="150"/>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="TurboRateCurve" SettingLabel="{Binding Macro_TurboRateCurve_Label, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_TurboRateCurve_2344"/>
                                        </StackPanel>
                                        <!-- Ramp endpoints: pressure range that maps to slow-to-fast.
                                             Remapped BEFORE the curve (the Steam curve cluster's
                                             range-then-exponent order). -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_PressureStart_Label, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"
                                                       ToolTip="{Binding Macro_PressureStart_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <TextBox Text="{Binding PressureStartPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="80"/>
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="%" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            <ui:Button Command="{Binding ResetPressureStartCommand}" Style="{StaticResource ResetButton}" Margin="8,0,0,0" ToolTip="{Binding Macro_Reset_RampStart, Source={x:Static strings:Strings.Instance}}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_PressureEnd_Label, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"
                                                       ToolTip="{Binding Macro_PressureEnd_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <TextBox Text="{Binding PressureEndPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="80"/>
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="%" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            <ui:Button Command="{Binding ResetPressureEndCommand}" Style="{StaticResource ResetButton}" Margin="8,0,0,0" ToolTip="{Binding Macro_Reset_RampEnd, Source={x:Static strings:Strings.Instance}}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Device, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"/>
                                            <ComboBox MinWidth="200"
                                                      DisplayMemberPath="ResolvedName"
                                                      SelectedValuePath="InstanceGuid"
                                                      SelectedValue="{Binding SourceDeviceGuid, Mode=TwoWay}"
                                                      DropDownOpened="DeviceAxisPicker_DropDownOpened"
                                                      Loaded="DeviceAxisPicker_DropDownOpened"/>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="SourceDeviceGuid" SettingLabel="{Binding Macro_Device, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_SourceDeviceGuid_2373"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Axis, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"/>
                                            <ComboBox MinWidth="180"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="InputIndex"
                                                      SelectedValue="{Binding SourceDeviceAxisIndex, Mode=TwoWay}"
                                                      DropDownOpened="DeviceAxisIndexPicker_DropDownOpened"
                                                      Loaded="DeviceAxisIndexPicker_DropDownOpened"/>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="SourceDeviceAxisIndex" SettingLabel="{Binding Macro_Axis, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_SourceDeviceAxisIndex_2383" Margin="4,0,8,0"/>
                                            <ui:Button Command="{Binding RecordSourceCommand}"
                                                       Style="{StaticResource EmberIconButtonHot}"
                                                       VerticalAlignment="Center" Margin="4,0,0,0">
                                                <controls:GlyphText Text="{Binding SourceRecordIcon}" FontFamily="Segoe MDL2 Assets"
                                                           Foreground="{DynamicResource EmberBrush}"/>
                                                <ui:Button.ToolTip>
                                                    <TextBlock Text="{Binding SourceRecordTooltip}"/>
                                                </ui:Button.ToolTip>
                                            </ui:Button>
                                            <ui:Button AutomationProperties.Name="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}" Command="{Binding ClearSourceCommand}"
                                                       Style="{StaticResource EmberIconButtonHot}"
                                                       VerticalAlignment="Center">
                                                <controls:GlyphText Text="&#xE75C;" FontFamily="Segoe MDL2 Assets"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <ui:Button.ToolTip>
                                                    <TextBlock Text="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}"/>
                                                </ui:Button.ToolTip>
                                            </ui:Button>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Macro_PressureTurboHint, Source={x:Static strings:Strings.Instance}}"
                                                   FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Button flags checkbox grid for ButtonPress / ButtonRelease and
                                         the wave-1b turbo / toggle button actions (all address the
                                         target via the same ButtonFlags / CustomButtonWords pair) -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsAnyVcButtonType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Macro_Buttons, Source={x:Static strings:Strings.Instance}}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <reset:SettingResetButton Command="{Binding ResetButtonSelectionCommand}" SettingLabel="{Binding Macro_Buttons, Source={x:Static strings:Strings.Instance}}"/>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding ButtonOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Label}"
                                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                              MinWidth="70" Margin="0,0,8,4"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Key combo for KeyPress / KeyRelease / RepeatKeyWhileHeld (#9) / ToggleKey (wave 1b) -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsAnyKeyType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Macro_KeyCombo, Source={x:Static strings:Strings.Instance}}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                            <reset:SettingResetButton DockPanel.Dock="Right" Command="{Binding ResetSettingCommand}" CommandParameter="KeyString" SettingLabel="{Binding Macro_KeyCombo, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_KeyString_2436"/>
                                            <TextBox Text="{Binding KeyString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     FontFamily="{StaticResource TelemetryFontFamily}"
                                                     common:BidiText.ToolTip="{Binding Macro_KeyComboTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Instance binding, NOT x:Static: an x:Static ItemsSource is
                                                 evaluated once and never refreshes on a live language change. -->
                                            <ComboBox AutomationProperties.Name="{Binding Macro_KeyCombo, Source={x:Static strings:Strings.Instance}}" ItemsSource="{Binding VirtualKeyChoices}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="Key"
                                                      SelectedValue="{Binding SelectedKeyToAdd, Mode=TwoWay}"
                                                      MinWidth="180" MaxDropDownHeight="300"
                                                      IsTextSearchEnabled="True"/>
                                            <Button Content="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}" Command="{Binding ClearKeyStringCommand}"
                                                    Padding="8,4" Margin="4,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock common:BidiText.Text="{Binding Macro_KeyComboHint, Source={x:Static strings:Strings.Instance}}"
                                                   FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Duration. For ButtonPress / KeyPress / Delay / LightbarColor -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                                Visibility="{Binding IsDurationType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Duration, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                   Width="80" Margin="0,0,8,0"/>
                                        <TextBox Text="{Binding DurationMs, Mode=TwoWay}" Width="80"/>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="DurationMs" SettingLabel="{Binding Macro_Duration, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_DurationMs_2459" Margin="4,0,8,0"/>
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>

                                    <!-- Set Chroma Color card (#468): the color, painted on
                                         the Chroma categories of the Razer devices assigned to
                                         this virtual controller while the action runs. The
                                         hold is the Duration row above. -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6"
                                            Visibility="{Binding IsSetChromaColorType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MacroAction_Type_SetChromaColor, Source={x:Static strings:Strings.Instance}}"
                                                       FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <views:ColorPickerControl HorizontalAlignment="Left" Margin="0,0,0,4"
                                                                      Red="{Binding LightbarR, Mode=TwoWay}"
                                                                      Green="{Binding LightbarG, Mode=TwoWay}"
                                                                      Blue="{Binding LightbarB, Mode=TwoWay}"/>
                                            <Border Width="80" Height="20" HorizontalAlignment="Left" CornerRadius="3" Margin="0,0,0,6"
                                                    BorderBrush="{DynamicResource TextFillColorDisabledBrush}" BorderThickness="1">
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                                        <Binding Path="LightbarR"/>
                                                        <Binding Path="LightbarG"/>
                                                        <Binding Path="LightbarB"/>
                                                    </MultiBinding>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Text="{Binding MacroAction_SetChromaColor_Hint, Source={x:Static strings:Strings.Instance}}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Set Key Colors card (#557): the lights, picked on a
                                         full-size keyboard with a chip per group of lights and
                                         numbered in the order picked, the color, the style, how
                                         long it holds, and what the other lights show meanwhile.
                                         Keys go by HID usage, so the action lights the same keys
                                         on every keyboard this virtual controller lights. -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6"
                                            Visibility="{Binding IsSetKeyColorsType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MacroAction_Type_SetKeyColors, Source={x:Static strings:Strings.Instance}}"
                                                       FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
