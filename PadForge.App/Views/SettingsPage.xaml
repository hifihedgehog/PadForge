<UserControl x:Class="PadForge.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:strings="clr-namespace:PadForge.Resources.Strings"
             xmlns:local="clr-namespace:PadForge.Views"
             xmlns:vm="clr-namespace:PadForge.ViewModels"
             xmlns:controls="clr-namespace:PadForge.Controls"
             xmlns:reset="clr-namespace:PadForge.Controls"
             xmlns:common="clr-namespace:PadForge.Common"
             PreviewKeyDown="Page_PreviewKeyDown">

    <UserControl.Resources>
        <!-- A row, as the board draws one: 20 in from the card's edge and
             10 from its end, and with 2 over and under its 44 the board's
             48. Its label takes the room and its controls stand at its end
             (SettingRow.Ends, set on the groups' host). -->
        <Style TargetType="controls:SettingRow">
            <Setter Property="Margin" Value="20,2,10,2"/>
        </Style>
        <!-- The board's hairline over every row of a card, the card's whole
             width. -->
        <Style TargetType="controls:SettingItem">
            <Setter Property="Rule" Value="{DynamicResource SteelLineSoftBrush}"/>
        </Style>

        <!-- A plain button as the board draws it: 36 tall, 14 at each side. -->
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <!-- MinHeight and Padding mirror the App.xaml implicit Button
                 style (36 tall, 14 at the sides), which this page-local
                 implicit replaces. -->
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
            <!-- These five setters mirror the App.xaml implicit ComboBox
                 style, which this page-local implicit replaces. -->
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible"/>
            <Setter Property="MaxDropDownHeight" Value="200"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- A number as the board draws it: 64 by 34, its digits at the
             right. The arrow keys and Page Up and Down still step it. The
             box's template keeps the flyout of its compact spin buttons in
             the line, 20 wide by its style's MinWidth even while the spin
             buttons are hidden, which held the digits 20 short of the right
             inset. This page never shows those buttons. -->
        <Style TargetType="ui:NumberBox" BasedOn="{StaticResource DefaultUiNumberBoxStyle}">
            <Style.Resources>
                <Style TargetType="ui:Flyout" BasedOn="{StaticResource DefaultFlyoutStyle}">
                    <Setter Property="MinWidth" Value="0"/>
                </Style>
            </Style.Resources>
            <Setter Property="Width" Value="64"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Border.CornerRadius" Value="6"/>
            <Setter Property="SpinButtonPlacementMode" Value="Hidden"/>
            <Setter Property="ClearButtonEnabled" Value="False"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource EmberBrush}"/>
            <Setter Property="SelectionOpacity" Value="0.35"/>
        </Style>

        <!-- A row's label: the app's, with no width of its own. The row
             gives it the room its controls leave, and it wraps there. -->
        <Style x:Key="DzLabel" TargetType="TextBlock" BasedOn="{StaticResource DzLabel}">
            <Setter Property="Width" Value="Auto"/>
        </Style>
        <!-- A setting that belongs to the row above it: its label starts 16
             in and reads a step quieter, and its control still ends where
             every row's does. -->
        <Style x:Key="DzSubLabel" TargetType="TextBlock" BasedOn="{StaticResource DzLabel}">
            <Setter Property="Margin" Value="16,0,12,0"/>
            <Setter Property="Foreground" Value="{DynamicResource SubRowTextBrush}"/>
        </Style>
        <!-- A unit after its number, 12 on, wrapping when the row is narrow. -->
        <Style x:Key="DzPercent" TargetType="TextBlock" BasedOn="{StaticResource DzPercent}">
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- What a hardware switch or a number reports: quiet, or the
             warning color where a row says so. It stands beside the row's
             control, before it, so the switches of a card keep one column,
             and it is the part that gives way and wraps in a narrow row. -->
        <Style x:Key="RowStatus" TargetType="TextBlock">
            <Setter Property="controls:SettingRow.Fills" Value="True"/>
            <Setter Property="controls:SettingRow.Aside" Value="True"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
        </Style>

        <!-- A group button, the sidebar row's look: its line icon and its
             name, clear at rest with the secondary text, a lift under the
             pointer, and while its group shows the raised fill, the text
             color at SemiBold, an ember icon and the sidebar's ember bar at
             its leading edge. A long name wraps. The icon is the button's
             SettingsPage.GroupIcon. -->
        <Style x:Key="SettingsGroupButton" TargetType="RadioButton">
            <Setter Property="GroupName" Value="SettingsGroup"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="14,0,12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <DockPanel>
                                    <controls:DecorativeStrokeIcon x:Name="Icon" DockPanel.Dock="Left" Size="16" StrokeWidth="1.8"
                                                                   Margin="0,0,10,0" VerticalAlignment="Center"
                                                                   Data="{Binding (local:SettingsPage.GroupIcon), RelativeSource={RelativeSource TemplatedParent}}"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,6">
                                        <ContentPresenter.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                            </Style>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                </DockPanel>
                            </Border>
                            <Border x:Name="PickBar" Width="3" Height="18" CornerRadius="1.5"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource EmberBrush}" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SteelPaneHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SteelRaisedBrush}"/>
                                <Setter TargetName="PickBar" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource EmberBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A driver's row in the Drivers card: its dot, its name with the
             line under it, its state and version, and its button. The name
             takes the room left from a basis of 280, which keeps the button
             on the line at the 900 window. The row wraps when narrower. -->
        <Style x:Key="DriverRow" TargetType="controls:FlexLinePanel">
            <Setter Property="Gap" Value="14"/>
            <Setter Property="LineGap" Value="8"/>
            <Setter Property="MinLineHeight" Value="43"/>
            <Setter Property="Margin" Value="20,10,10,10"/>
        </Style>
        <!-- Hollow while the driver is absent. Each row fills it ember while
             its driver is there, as Home's offer has its dot. -->
        <Style x:Key="DriverDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Stroke" Value="{DynamicResource QuietGlyphBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DriverName" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style x:Key="DriverLine" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Secondary while the driver is absent. Each row makes it the text
             color while its driver is there. -->
        <Style x:Key="DriverState" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="DriverVersion" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DriverAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="96"/>
        </Style>
    </UserControl.Resources>

    <!-- Settings (#574): the title and the search box, then the five groups
         beside the selected group's cards. While the box holds a word, the
         matching rows of every group show under their group's name. The code
         shows the groups (ApplyView). The page reads in one column, as its
         board draws it, at the page's start however wide the window: 1040
         at most, the group list 190 of it and the cards the 822 that a gap
         of 28 leaves, so the cards end where the search box does. -->
    <ScrollViewer x:Name="SettingsScroll" AutomationProperties.Name="{Binding Settings_Title, Source={x:Static strings:Strings.Instance}}">
        <ScrollViewer.Resources>
            <!-- A card as the board draws one: no padding of its own, since
                 its head and its rows keep theirs and the hairlines between
                 them run from edge to edge, and 14 under it. -->
            <Style x:Key="CardBorder" TargetType="Border" BasedOn="{StaticResource CardBorder}">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,14"/>
            </Style>
            <!-- A card's title: the board's 15. -->
            <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource CardTitle}">
                <Setter Property="FontSize" Value="15"/>
            </Style>
        </ScrollViewer.Resources>
        <!-- The column's cap is the panel's own. A grid's star column that
             stops at a MaxWidth takes one device pixel more than it when
             the grid is wider and the window rounds its layout, and the
             search box then ended a pixel past the cards. -->
        <StackPanel x:Name="PageColumn" Margin="36,26,36,36" MaxWidth="1040" HorizontalAlignment="Left">
            <controls:FlexLinePanel Gap="16" LineGap="12">
                <TextBlock x:Name="SettingsTitle" AutomationProperties.HeadingLevel="Level1"
                           controls:FlexLinePanel.Basis="200" controls:FlexLinePanel.Grow="1" VerticalAlignment="Center"
                           Text="{Binding Settings_Title, Source={x:Static strings:Strings.Instance}}"
                           FontFamily="{StaticResource DisplayFontFamily}" FontSize="28" FontWeight="SemiBold"
                           LineHeight="40.6" LineStackingStrategy="BlockLineHeight"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ui:TextBox x:Name="SettingsSearchBox" controls:FlexLinePanel.Basis="300" VerticalAlignment="Center"
                            MinHeight="36" Padding="10,0" VerticalContentAlignment="Center"
                            AutomationProperties.AutomationId="Settings_Search"
                            AutomationProperties.Name="{Binding Settings_SearchPlaceholder, Source={x:Static strings:Strings.Instance}}"
                            PlaceholderText="{Binding Settings_SearchPlaceholder, Source={x:Static strings:Strings.Instance}}"
                            Text="{Binding SettingsSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PreviewKeyDown="SearchBox_PreviewKeyDown">
                    <!-- The board's corners, 8, which the field's template reads. -->
                    <ui:TextBox.Style>
                        <Style TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
                            <Setter Property="Border.CornerRadius" Value="8"/>
                        </Style>
                    </ui:TextBox.Style>
                    <ui:TextBox.Icon>
                        <controls:DecorativeStrokeIcon Data="{StaticResource SearchLineGeometry}" Size="14" StrokeWidth="2"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </ui:TextBox.Icon>
                </ui:TextBox>
            </controls:FlexLinePanel>

            <!-- The group buttons beside the cards, or over them on a narrow
                 window: a column of 190, the board's, at the line's start. -->
            <controls:FlexLinePanel Gap="28" LineGap="20" Margin="0,20,0,0">
                <Grid controls:FlexLinePanel.Basis="190" Width="190" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel x:Name="GroupList">
                        <RadioButton x:Name="GroupGeneral" Style="{StaticResource SettingsGroupButton}" IsChecked="True"
                                     local:SettingsPage.GroupIcon="{StaticResource NavSettingsGeometry}"
                                     Tag="{x:Static vm:SettingsGroup.General}" Checked="Group_Checked"
                                     AutomationProperties.AutomationId="Settings_Group_General"
                                     Content="{Binding Settings_Group_General, Source={x:Static strings:Strings.Instance}}"/>
                        <RadioButton x:Name="GroupInput" Style="{StaticResource SettingsGroupButton}"
                                     local:SettingsPage.GroupIcon="{StaticResource NavDevicesGeometry}"
                                     Tag="{x:Static vm:SettingsGroup.Input}" Checked="Group_Checked"
                                     AutomationProperties.AutomationId="Settings_Group_Input"
                                     Content="{Binding Settings_Group_Input, Source={x:Static strings:Strings.Instance}}"/>
                        <RadioButton x:Name="GroupHardware" Style="{StaticResource SettingsGroupButton}"
                                     local:SettingsPage.GroupIcon="{StaticResource ChipLineGeometry}"
                                     Tag="{x:Static vm:SettingsGroup.Hardware}" Checked="Group_Checked"
                                     AutomationProperties.AutomationId="Settings_Group_Hardware"
                                     Content="{Binding Settings_Group_Hardware, Source={x:Static strings:Strings.Instance}}"/>
                        <RadioButton x:Name="GroupDrivers" Style="{StaticResource SettingsGroupButton}"
                                     local:SettingsPage.GroupIcon="{StaticResource DownloadLineGeometry}"
                                     Tag="{x:Static vm:SettingsGroup.Drivers}" Checked="Group_Checked"
                                     AutomationProperties.AutomationId="Settings_Group_Drivers"
                                     Content="{Binding Settings_Group_Drivers, Source={x:Static strings:Strings.Instance}}"/>
                        <RadioButton x:Name="GroupData" Style="{StaticResource SettingsGroupButton}"
                                     local:SettingsPage.GroupIcon="{StaticResource ShieldLineGeometry}"
                                     Tag="{x:Static vm:SettingsGroup.Data}" Checked="Group_Checked"
                                     AutomationProperties.AutomationId="Settings_Group_Data"
                                     Content="{Binding Settings_Group_Data, Source={x:Static strings:Strings.Instance}}"/>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="GroupsHost" controls:FlexLinePanel.Basis="480" controls:FlexLinePanel.Grow="999" MaxWidth="822"
                            VerticalAlignment="Top" controls:SettingRow.Ends="True">
                    <TextBlock x:Name="SearchNoneLine" common:LiveText.Polite="True" Visibility="Collapsed" Margin="0,9,0,0"
                               TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               AutomationProperties.AutomationId="Settings_SearchNone"/>

                    <!-- ═══ General ═══ -->
                    <StackPanel x:Name="GeneralGroup" controls:SettingSearch.Group="{Binding Settings_Group_General, Source={x:Static strings:Strings.Instance}}">
                        <TextBlock x:Name="GeneralHeading" Style="{StaticResource SectionTitle}" Visibility="Collapsed" Margin="0,0,0,12"
                                   Text="{Binding Settings_Group_General, Source={x:Static strings:Strings.Instance}}"/>

                        <!-- Language -->
                        <Border Style="{StaticResource CardBorder}"
                                controls:SettingSearch.Card="{Binding Settings_Language, Source={x:Static strings:Strings.Instance}}"
                                controls:SettingSearch.Terms="{Binding Settings_LanguageDesc, Source={x:Static strings:Strings.Instance}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Settings_Language, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource CardTitle}"
                                           ToolTip="{Binding Settings_LanguageDesc, Source={x:Static strings:Strings.Instance}}" Margin="20,16,10,16"/>
                                <controls:SettingItem>
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_Language, Source={x:Static strings:Strings.Instance}}"/>
                                        <!-- The rows are LanguageCatalog's (#505): each language under its own
                                             name, its English name beside it, and typing jumps by own name.
                                             As wide as its language's name and 210 at the least, the board's,
                                             and narrower when the row has less room. -->
                                        <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                                  SelectedValuePath="Culture"
                                                  SelectedValue="{Binding SelectedLanguage}"
                                                  TextSearch.TextPath="NativeName"
                                                  controls:SettingRow.Fills="True" MinWidth="210">
                                            <!-- Each language is listed by its own name, so each row declares
                                                 its own language: 中文 takes the Chinese font and 日本語 the
                                                 Japanese one whatever the interface is in (#504). WPF refuses
                                                 a binding on Language that names no ConverterCulture, since
                                                 the culture would come from the property being set. -->
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                                    <Setter Property="Language" Value="{Binding Culture, Converter={StaticResource CultureLanguageConverter}, ConverterCulture=en-US}"/>
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding NativeName}"/>
                                                        <TextBlock Text="{Binding EnglishNameIfDifferent}" Margin="10,0,0,0"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="SelectedLanguage"
                                                                  SettingLabel="{Binding Settings_Language, Source={x:Static strings:Strings.Instance}}"
                                                                  AutomationProperties.AutomationId="Reset_SettingsViewModel_SelectedLanguage_80"/>
                                    </controls:SettingRow>
                                </controls:SettingItem>
                            </StackPanel>
                        </Border>

                        <!-- Appearance -->
                        <Border Style="{StaticResource CardBorder}"
                                controls:SettingSearch.Card="{Binding Settings_Appearance, Source={x:Static strings:Strings.Instance}}"
                                controls:SettingSearch.Terms="{Binding Settings_AppearanceDesc, Source={x:Static strings:Strings.Instance}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Settings_Appearance, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource CardTitle}"
                                           ToolTip="{Binding Settings_AppearanceDesc, Source={x:Static strings:Strings.Instance}}" Margin="20,16,10,16"/>
                                <controls:SettingItem>
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_Theme, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBox SelectedIndex="{Binding SelectedThemeIndex}" MinWidth="210"
                                                  AutomationProperties.Name="{Binding Settings_Theme, Source={x:Static strings:Strings.Instance}}">
                                            <ComboBoxItem Content="{Binding Settings_ThemeSystem, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding Settings_ThemeLight, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding Settings_ThemeDark, Source={x:Static strings:Strings.Instance}}"/>
                                        </ComboBox>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="SelectedThemeIndex"
                                                                  SettingLabel="{Binding Settings_Theme, Source={x:Static strings:Strings.Instance}}"
                                                                  AutomationProperties.AutomationId="Reset_SettingsViewModel_SelectedThemeIndex_96"/>
                                    </controls:SettingRow>
                                </controls:SettingItem>
                            </StackPanel>
                        </Border>

                        <!-- Window -->
                        <Border Style="{StaticResource CardBorder}"
                                controls:SettingSearch.Card="{Binding Settings_Window, Source={x:Static strings:Strings.Instance}}"
                                controls:SettingSearch.Terms="{Binding Settings_WindowDesc, Source={x:Static strings:Strings.Instance}}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" MinHeight="52" Margin="20,0,10,0">
                                    <TextBlock Text="{Binding Settings_Window, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource CardTitle}"
                                               ToolTip="{Binding Settings_WindowDesc, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Style="{StaticResource ResetAllButton}" Command="{Binding ResetCardCommand}" CommandParameter="Window"
                                               Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}"
                                               AutomationProperties.AutomationId="Settings_ResetAll_Window">
                                        <ui:Button.ToolTip>
                                            <MultiBinding Converter="{StaticResource FormatTextConverter}">
                                                <Binding Path="Settings_Window" Source="{x:Static strings:Strings.Instance}"/>
                                                <Binding Path="Pad_ResetSection_Format" Source="{x:Static strings:Strings.Instance}"/>
                                            </MultiBinding>
                                        </ui:Button.ToolTip>
                                    </ui:Button>
                                </DockPanel>
                                <controls:SettingItem>
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_MinimizeToTray, Source={x:Static strings:Strings.Instance}}"/>
                                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{Binding Settings_MinimizeToTray, Source={x:Static strings:Strings.Instance}}"
                                                  ToolTip="{Binding Settings_MinimizeToTrayTip, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding MinimizeToTray}"/>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="MinimizeToTray"
                                                                  SettingLabel="{Binding Settings_MinimizeToTray, Source={x:Static strings:Strings.Instance}}"
                                                                  AutomationProperties.AutomationId="Reset_SettingsViewModel_MinimizeToTray_118"/>
                                    </controls:SettingRow>
                                </controls:SettingItem>
                                <controls:SettingItem>
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_CloseToTray, Source={x:Static strings:Strings.Instance}}"/>
                                        <CheckBox x:Name="CloseToTrayCheckBox" Style="{StaticResource SwitchCheckBox}"
                                                  Content="{Binding Settings_CloseToTray, Source={x:Static strings:Strings.Instance}}"
                                                  ToolTip="{Binding Settings_CloseToTrayTip, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding CloseToTray}"/>
                                        <reset:SettingResetButton x:Name="CloseToTrayReset" Command="{Binding ResetCloseToTrayCommand}"
                                                                  SettingLabel="{Binding Settings_CloseToTray, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                </controls:SettingItem>
                                <controls:SettingItem>
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_AlwaysShowTrayIcon, Source={x:Static strings:Strings.Instance}}"/>
                                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{Binding Settings_AlwaysShowTrayIcon, Source={x:Static strings:Strings.Instance}}"
                                                  ToolTip="{Binding Settings_AlwaysShowTrayIconTip, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding AlwaysShowTrayIcon}"/>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="AlwaysShowTrayIcon"
                                                                  SettingLabel="{Binding Settings_AlwaysShowTrayIcon, Source={x:Static strings:Strings.Instance}}"
                                                                  AutomationProperties.AutomationId="Reset_SettingsViewModel_AlwaysShowTrayIcon_139"/>
                                    </controls:SettingRow>
                                </controls:SettingItem>
                                <controls:SettingItem>
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_StartMinimized, Source={x:Static strings:Strings.Instance}}"/>
                                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{Binding Settings_StartMinimized, Source={x:Static strings:Strings.Instance}}"
                                                  ToolTip="{Binding Settings_StartMinimizedTip, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding StartMinimized}"/>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="StartMinimized"
                                                                  SettingLabel="{Binding Settings_StartMinimized, Source={x:Static strings:Strings.Instance}}"
                                                                  AutomationProperties.AutomationId="Reset_SettingsViewModel_StartMinimized_132"/>
                                    </controls:SettingRow>
                                </controls:SettingItem>
                                <controls:SettingItem>
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_StartAtLogin, Source={x:Static strings:Strings.Instance}}"/>
                                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{Binding Settings_StartAtLogin, Source={x:Static strings:Strings.Instance}}"
                                                  ToolTip="{Binding Settings_StartAtLoginTip, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding StartAtLogin}"/>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="StartAtLogin"
                                                                  SettingLabel="{Binding Settings_StartAtLogin, Source={x:Static strings:Strings.Instance}}"
                                                                  AutomationProperties.AutomationId="Reset_SettingsViewModel_StartAtLogin_135"/>
                                    </controls:SettingRow>
                                </controls:SettingItem>
                            </StackPanel>
                        </Border>

                        <!-- Updates (#457): releases, or with Include Pre-Releases the
                             rolling dev build, from GitHub. UpdateController drives the
                             status line, the progress bar and the two action buttons. -->
                        <Border Style="{StaticResource CardBorder}"
                                controls:SettingSearch.Card="{Binding Settings_Updates, Source={x:Static strings:Strings.Instance}}"
                                controls:SettingSearch.Terms="{Binding Settings_UpdatesDesc, Source={x:Static strings:Strings.Instance}}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" MinHeight="52" Margin="20,0,10,0">
                                    <TextBlock Text="{Binding Settings_Updates, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource CardTitle}"
                                               ToolTip="{Binding Settings_UpdatesDesc, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Style="{StaticResource ResetAllButton}" Command="{Binding ResetCardCommand}" CommandParameter="Updates"
                                               Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}"
                                               AutomationProperties.AutomationId="Settings_ResetAll_Updates">
                                        <ui:Button.ToolTip>
                                            <MultiBinding Converter="{StaticResource FormatTextConverter}">
                                                <Binding Path="Settings_Updates" Source="{x:Static strings:Strings.Instance}"/>
                                                <Binding Path="Pad_ResetSection_Format" Source="{x:Static strings:Strings.Instance}"/>
                                            </MultiBinding>
                                        </ui:Button.ToolTip>
                                    </ui:Button>
                                </DockPanel>
                                <!-- The status, first under the card's head as the board has
                                     it, on the band's fill: a mark, then what the last check
                                     found, or PadForge's version before any check has run, and
                                     the actions at the row's end. The mark is the cold check
                                     once this build is the newest and the ember arrow while an
                                     update waits. The progress bar shows under them while an
                                     update downloads. -->
                                <controls:SettingItem x:Name="UpdateStatusItem" Background="{DynamicResource SteelBandBrush}">
                                    <controls:SettingRow MinHeight="56" Margin="20,2,20,2">
                                        <DockPanel x:Name="UpdateStatusLine" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <controls:DecorativeStrokeIcon DockPanel.Dock="Left" Size="18" StrokeWidth="2"
                                                                           Margin="0,0,10,0" VerticalAlignment="Center">
                                                <controls:DecorativeStrokeIcon.Style>
                                                    <Style TargetType="controls:DecorativeStrokeIcon">
                                                        <Setter Property="Data" Value="{StaticResource NavAboutGeometry}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUpToDate}" Value="True">
                                                                <Setter Property="Data" Value="{StaticResource CheckCircleGeometry}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource ColdBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                                <Setter Property="Data" Value="{StaticResource DownloadLineGeometry}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource EmberBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:DecorativeStrokeIcon.Style>
                                            </controls:DecorativeStrokeIcon>
                                            <Grid VerticalAlignment="Center">
                                                <!-- Before any check: PadForge and its version, in the
                                                     code face and the cold color as the board has it. -->
                                                <TextBlock x:Name="UpdateVersionLine" TextWrapping="Wrap"><TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding UpdateStatusText}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style><Run Text="PadForge" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{Binding VersionNumber, Mode=OneWay}" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}"/></TextBlock>
                                                <TextBlock x:Name="UpdateStatusLineText" common:LiveText.Polite="True" Text="{Binding UpdateStatusText}" TextWrapping="Wrap"
                                                           Visibility="{Binding UpdateStatusText, Converter={StaticResource StringToVisibility}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource EmberTextBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DockPanel>
                                        <!-- Check Now, and while an update waits Release Notes
                                             and then Install and Restart, the main action, at
                                             the row's end. -->
                                        <WrapPanel controls:SettingRow.Fills="True" VerticalAlignment="Center">
                                            <Button Content="{Binding Settings_CheckNow, Source={x:Static strings:Strings.Instance}}"
                                                    Command="{Binding CheckForUpdatesNowCommand}" Margin="12,4,0,4"/>
                                            <Button Content="{Binding Settings_ReleaseNotes, Source={x:Static strings:Strings.Instance}}"
                                                    Command="{Binding OpenReleaseNotesCommand}" Margin="12,4,0,4"
                                                    Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Button Content="{Binding Settings_InstallAndRestart, Source={x:Static strings:Strings.Instance}}"
                                                    Command="{Binding InstallUpdateCommand}"
                                                    Style="{StaticResource EmberAccentButton}" Padding="14,0" Margin="12,4,0,4"
                                                    Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </WrapPanel>
                                    </controls:SettingRow>
                                    <ProgressBar Value="{Binding UpdateProgress}" Maximum="100" Height="4"
                                                 AutomationProperties.Name="{Binding Settings_Updates, Source={x:Static strings:Strings.Instance}}"
                                                 Margin="20,0,20,12"
                                                 Visibility="{Binding IsUpdateDownloading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </controls:SettingItem>
                                <controls:SettingItem>
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_CheckForUpdates, Source={x:Static strings:Strings.Instance}}"/>
                                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{Binding Settings_CheckForUpdates, Source={x:Static strings:Strings.Instance}}"
                                                  ToolTip="{Binding Settings_CheckForUpdatesTip, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding CheckForUpdatesAutomatically}"/>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="CheckForUpdatesAutomatically"
                                                                  SettingLabel="{Binding Settings_CheckForUpdates, Source={x:Static strings:Strings.Instance}}"
                                                                  AutomationProperties.AutomationId="Reset_SettingsViewModel_CheckForUpdatesAutomatically_4571"/>
                                    </controls:SettingRow>
                                </controls:SettingItem>
                                <!-- Installing automatically needs the automatic check, so it
                                     shows only while that is on. -->
                                <controls:SettingItem Visibility="{Binding CheckForUpdatesAutomatically, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_InstallUpdatesAutomatically, Source={x:Static strings:Strings.Instance}}"/>
                                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{Binding Settings_InstallUpdatesAutomatically, Source={x:Static strings:Strings.Instance}}"
                                                  ToolTip="{Binding Settings_InstallUpdatesAutomaticallyTip, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding InstallUpdatesAutomatically}"/>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="InstallUpdatesAutomatically"
                                                                  SettingLabel="{Binding Settings_InstallUpdatesAutomatically, Source={x:Static strings:Strings.Instance}}"
                                                                  AutomationProperties.AutomationId="Reset_SettingsViewModel_InstallUpdatesAutomatically_4572"/>
                                    </controls:SettingRow>
                                </controls:SettingItem>
                                <controls:SettingItem>
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_IncludePreReleases, Source={x:Static strings:Strings.Instance}}"/>
                                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{Binding Settings_IncludePreReleases, Source={x:Static strings:Strings.Instance}}"
                                                  ToolTip="{Binding Settings_IncludePreReleasesTip, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding IncludePreReleaseUpdates}"/>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="IncludePreReleaseUpdates"
                                                                  SettingLabel="{Binding Settings_IncludePreReleases, Source={x:Static strings:Strings.Instance}}"
                                                                  AutomationProperties.AutomationId="Reset_SettingsViewModel_IncludePreReleaseUpdates_4573"/>
                                    </controls:SettingRow>
                                </controls:SettingItem>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ═══ Input ═══ -->
                    <StackPanel x:Name="InputGroup" Visibility="Collapsed"
                                controls:SettingSearch.Group="{Binding Settings_Group_Input, Source={x:Static strings:Strings.Instance}}">
                        <TextBlock x:Name="InputHeading" Style="{StaticResource SectionTitle}" Visibility="Collapsed" Margin="0,0,0,12"
                                   Text="{Binding Settings_Group_Input, Source={x:Static strings:Strings.Instance}}"/>

                        <!-- Input Engine -->
                        <Border Style="{StaticResource CardBorder}"
                                controls:SettingSearch.Card="{Binding Settings_InputEngine, Source={x:Static strings:Strings.Instance}}"
                                controls:SettingSearch.Terms="{Binding Settings_InputEngineDesc, Source={x:Static strings:Strings.Instance}}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" MinHeight="52" Margin="20,0,10,0">
                                    <TextBlock Text="{Binding Settings_InputEngine, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource CardTitle}"
                                               ToolTip="{Binding Settings_InputEngineDesc, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Style="{StaticResource ResetAllButton}" Command="{Binding ResetCardCommand}" CommandParameter="InputEngine"
                                               Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}"
                                               AutomationProperties.AutomationId="Settings_ResetAll_InputEngine">
                                        <ui:Button.ToolTip>
                                            <MultiBinding Converter="{StaticResource FormatTextConverter}">
                                                <Binding Path="Settings_InputEngine" Source="{x:Static strings:Strings.Instance}"/>
                                                <Binding Path="Pad_ResetSection_Format" Source="{x:Static strings:Strings.Instance}"/>
                                            </MultiBinding>
                                        </ui:Button.ToolTip>
                                    </ui:Button>
                                </DockPanel>
                                <controls:SettingItem>
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_AutoStart, Source={x:Static strings:Strings.Instance}}"/>
                                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{Binding Settings_AutoStart, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding AutoStartEngine}"/>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="AutoStartEngine"
                                                                  SettingLabel="{Binding Settings_AutoStart, Source={x:Static strings:Strings.Instance}}"
                                                                  AutomationProperties.AutomationId="Reset_SettingsViewModel_AutoStartEngine_151"/>
                                    </controls:SettingRow>
                                </controls:SettingItem>
                                <controls:SettingItem>
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_BackgroundPolling, Source={x:Static strings:Strings.Instance}}"/>
                                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{Binding Settings_BackgroundPolling, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding EnablePollingOnFocusLoss}"/>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="EnablePollingOnFocusLoss"
                                                                  SettingLabel="{Binding Settings_BackgroundPolling, Source={x:Static strings:Strings.Instance}}"
                                                                  AutomationProperties.AutomationId="Reset_SettingsViewModel_EnablePollingOnFocusLoss_154"/>
                                    </controls:SettingRow>
                                </controls:SettingItem>
                                <!-- Who is in charge of the knob (#365): while the active
                                     profile carries a polling override, the global value is
                                     dormant, and a setting that is silently outranked reads
                                     as broken. The note says which profile rules, in the
                                     row's free width, and is collapsed while the global
                                     value rules. -->
                                <controls:SettingItem>
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_PollingInterval, Source={x:Static strings:Strings.Instance}}"/>
                                        <ui:NumberBox Value="{Binding PollingRateMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Minimum="1" Maximum="16"
                                                      AutomationProperties.Name="{Binding Settings_PollingInterval, Source={x:Static strings:Strings.Instance}}"
                                                      ToolTip="{Binding Settings_PollingIntervalTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBlock Style="{StaticResource DzPercent}" Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBlock Style="{StaticResource RowStatus}" Text="{Binding PollingOverrideNote}"
                                                   Foreground="{DynamicResource WaitBrush}"
                                                   Visibility="{Binding PollingOverrideNote, Converter={StaticResource StringToVisibility}}"/>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="PollingRateMs"
                                                                  SettingLabel="{Binding Settings_PollingInterval, Source={x:Static strings:Strings.Instance}}"
                                                                  AutomationProperties.AutomationId="Reset_SettingsViewModel_PollingRateMs_179"/>
                                    </controls:SettingRow>
                                </controls:SettingItem>
                                <controls:SettingItem>
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_HmInactivityTimeout, Source={x:Static strings:Strings.Instance}}"/>
                                        <ui:NumberBox Value="{Binding HmInactivityDestroyTimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Minimum="0" Maximum="3600"
                                                      AutomationProperties.Name="{Binding Settings_HmInactivityTimeout, Source={x:Static strings:Strings.Instance}}"
                                                      ToolTip="{Binding Settings_HmInactivityTimeoutTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBlock Style="{StaticResource DzPercent}" controls:SettingRow.Fills="True"
                                                   Text="{Binding Settings_SecondsZeroNever, Source={x:Static strings:Strings.Instance}}"/>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="HmInactivityDestroyTimeoutSeconds"
                                                                  SettingLabel="{Binding Settings_HmInactivityTimeout, Source={x:Static strings:Strings.Instance}}"
                                                                  AutomationProperties.AutomationId="Reset_SettingsViewModel_HmInactivityDestroyTimeoutSeconds_197"/>
                                    </controls:SettingRow>
                                </controls:SettingItem>
                            </StackPanel>
                        </Border>

                        <!-- Assignment Prompts: the offers for a device PadForge meets.
                             Auto-assigning outright was ruled out (sim rigs and arcade
                             setups have many devices and no obvious home for each), so
                             the app only ever offers, and each offer can be turned off. -->
                        <Border Style="{StaticResource CardBorder}"
                                controls:SettingSearch.Card="{Binding Settings_AssignOffer, Source={x:Static strings:Strings.Instance}}"
                                controls:SettingSearch.Terms="{Binding Settings_AssignOfferDesc, Source={x:Static strings:Strings.Instance}}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" MinHeight="52" Margin="20,0,10,0">
                                    <TextBlock Text="{Binding Settings_AssignOffer, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource CardTitle}"
                                               ToolTip="{Binding Settings_AssignOfferDesc, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Style="{StaticResource ResetAllButton}" Command="{Binding ResetCardCommand}" CommandParameter="AssignmentPrompts"
                                               Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}"
                                               AutomationProperties.AutomationId="Settings_ResetAll_AssignmentPrompts">
                                        <ui:Button.ToolTip>
                                            <MultiBinding Converter="{StaticResource FormatTextConverter}">
                                                <Binding Path="Settings_AssignOffer" Source="{x:Static strings:Strings.Instance}"/>
                                                <Binding Path="Pad_ResetSection_Format" Source="{x:Static strings:Strings.Instance}"/>
                                            </MultiBinding>
                                        </ui:Button.ToolTip>
                                    </ui:Button>
                                </DockPanel>
                                <controls:SettingItem>
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_AssignOfferNew, Source={x:Static strings:Strings.Instance}}"/>
                                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{Binding Settings_AssignOfferNew, Source={x:Static strings:Strings.Instance}}"
                                                  ToolTip="{Binding Settings_AssignOfferNew_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding AssignOfferNewDevice}"/>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="AssignOfferNewDevice"
                                                                  SettingLabel="{Binding Settings_AssignOfferNew, Source={x:Static strings:Strings.Instance}}"
                                                                  AutomationProperties.AutomationId="Reset_SettingsViewModel_AssignOfferNewDevice_221"/>
                                    </controls:SettingRow>
                                </controls:SettingItem>
                                <controls:SettingItem>
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_AssignOfferEmpty, Source={x:Static strings:Strings.Instance}}"/>
                                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{Binding Settings_AssignOfferEmpty, Source={x:Static strings:Strings.Instance}}"
                                                  ToolTip="{Binding Settings_AssignOfferEmpty_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding AssignOfferEmptySlot}"/>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="AssignOfferEmptySlot"
                                                                  SettingLabel="{Binding Settings_AssignOfferEmpty, Source={x:Static strings:Strings.Instance}}"
                                                                  AutomationProperties.AutomationId="Reset_SettingsViewModel_AssignOfferEmptySlot_225"/>
                                    </controls:SettingRow>
                                </controls:SettingItem>
                                <!-- Home's offer for a device PadForge has just met (#574). -->
                                <controls:SettingItem>
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_AssignOfferHome, Source={x:Static strings:Strings.Instance}}"/>
                                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{Binding Settings_AssignOfferHome, Source={x:Static strings:Strings.Instance}}"
                                                  ToolTip="{Binding Settings_AssignOfferHome_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding AssignOfferHome}"/>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="AssignOfferHome"
                                                                  SettingLabel="{Binding Settings_AssignOfferHome, Source={x:Static strings:Strings.Instance}}"
                                                                  AutomationProperties.AutomationId="Reset_SettingsViewModel_AssignOfferHome"/>
                                    </controls:SettingRow>
                                </controls:SettingItem>
                            </StackPanel>
                        </Border>

                        <!-- Battery Alerts (#293): the low notice up front, and under More
                             the vibration, the repeat and the full-charge notice. -->
                        <Border Style="{StaticResource CardBorder}"
                                controls:SettingSearch.Card="{Binding Settings_BatteryNotify, Source={x:Static strings:Strings.Instance}}"
                                controls:SettingSearch.Terms="{Binding Settings_BatteryNotifyDesc, Source={x:Static strings:Strings.Instance}}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" MinHeight="52" Margin="20,0,10,0">
                                    <TextBlock Text="{Binding Settings_BatteryNotify, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource CardTitle}"
                                               ToolTip="{Binding Settings_BatteryNotifyDesc, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Style="{StaticResource ResetAllButton}" Command="{Binding ResetCardCommand}" CommandParameter="BatteryAlerts"
                                               Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}"
                                               AutomationProperties.AutomationId="Settings_ResetAll_BatteryAlerts">
                                        <ui:Button.ToolTip>
                                            <MultiBinding Converter="{StaticResource FormatTextConverter}">
                                                <Binding Path="Settings_BatteryNotify" Source="{x:Static strings:Strings.Instance}"/>
                                                <Binding Path="Pad_ResetSection_Format" Source="{x:Static strings:Strings.Instance}"/>
                                            </MultiBinding>
                                        </ui:Button.ToolTip>
                                    </ui:Button>
                                </DockPanel>
                                <controls:SettingItem>
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_BatteryNotifyEnable, Source={x:Static strings:Strings.Instance}}"/>
                                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{Binding Settings_BatteryNotifyEnable, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding BatteryNotifyEnabled}"/>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="BatteryNotifyEnabled"
                                                                  SettingLabel="{Binding Settings_BatteryNotifyEnable, Source={x:Static strings:Strings.Instance}}"
                                                                  AutomationProperties.AutomationId="Reset_SettingsViewModel_BatteryNotifyEnabled_261"/>
                                    </controls:SettingRow>
                                </controls:SettingItem>
                                <controls:SettingItem>
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_BatteryNotifyThreshold, Source={x:Static strings:Strings.Instance}}"/>
                                        <ui:NumberBox Value="{Binding BatteryNotifyThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Minimum="5" Maximum="50"
                                                      AutomationProperties.Name="{Binding Settings_BatteryNotifyThreshold, Source={x:Static strings:Strings.Instance}}"
                                                      IsEnabled="{Binding DataContext.BatteryNotifyEnabled, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                                        <TextBlock Style="{StaticResource DzPercent}" Text="%"/>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="BatteryNotifyThreshold"
                                                                  SettingLabel="{Binding Settings_BatteryNotifyThreshold, Source={x:Static strings:Strings.Instance}}"
                                                                  AutomationProperties.AutomationId="Reset_SettingsViewModel_BatteryNotifyThreshold_269"/>
                                    </controls:SettingRow>
                                </controls:SettingItem>
                                <controls:SettingItem>
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_BatteryNotifyTestLabel, Source={x:Static strings:Strings.Instance}}"/>
                                        <Button Content="{Binding Settings_BatteryNotifyTest, Source={x:Static strings:Strings.Instance}}"
                                                Click="TestBatteryNotify_Click" IsEnabled="{Binding BatteryNotifyEnabled}"/>
                                    </controls:SettingRow>
                                </controls:SettingItem>
                                <!-- The More row draws the hairline over itself and the one
                                     over its open part, so the item that holds it and the
                                     first row under it draw none. Its open part pads what it
                                     holds (20, 8, 12, 12), which the rows hand back to stand
                                     as the card's other rows do. -->
                                <controls:SettingItem Rule="{x:Null}">
                                    <controls:MoreRow x:Name="BatteryMore" StateKey="Settings.Input.BatteryAlerts.More" Margin="0"
                                                      AutomationProperties.AutomationId="Settings_More_BatteryAlerts"
                                                      Header="{Binding Common_More, Source={x:Static strings:Strings.Instance}}"
                                                      Hint="{Binding Settings_More_BatteryAlerts, Source={x:Static strings:Strings.Instance}}">
                                        <StackPanel Margin="-20,-8,-12,-12">
                                            <controls:SettingItem Rule="{x:Null}">
                                                <controls:SettingRow MinHeight="44">
                                                    <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_BatteryNotifyVibrate, Source={x:Static strings:Strings.Instance}}"/>
                                                    <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{Binding Settings_BatteryNotifyVibrate, Source={x:Static strings:Strings.Instance}}"
                                                              IsChecked="{Binding BatteryNotifyVibrate}" IsEnabled="{Binding BatteryNotifyEnabled}"/>
                                                    <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="BatteryNotifyVibrate"
                                                                              SettingLabel="{Binding Settings_BatteryNotifyVibrate, Source={x:Static strings:Strings.Instance}}"
                                                                              AutomationProperties.AutomationId="Reset_SettingsViewModel_BatteryNotifyVibrate_276"/>
                                                </controls:SettingRow>
                                            </controls:SettingItem>
                                            <!-- The low notice again, opt-in: 0, the default, never repeats it. -->
                                            <controls:SettingItem>
                                                <controls:SettingRow MinHeight="44">
                                                    <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_BatteryNotifyRepeat, Source={x:Static strings:Strings.Instance}}"/>
                                                    <ui:NumberBox Value="{Binding BatteryNotifyRepeatMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Minimum="0" Maximum="60"
                                                                  AutomationProperties.Name="{Binding Settings_BatteryNotifyRepeat, Source={x:Static strings:Strings.Instance}}"
                                                                  IsEnabled="{Binding DataContext.BatteryNotifyEnabled, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                                                    <TextBlock Style="{StaticResource DzPercent}" controls:SettingRow.Fills="True"
                                                               Text="{Binding Devices_IdleDisconnectMinutes, Source={x:Static strings:Strings.Instance}}"/>
                                                    <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="BatteryNotifyRepeatMinutes"
                                                                              SettingLabel="{Binding Settings_BatteryNotifyRepeat, Source={x:Static strings:Strings.Instance}}"
                                                                              AutomationProperties.AutomationId="Reset_SettingsViewModel_BatteryNotifyRepeatMinutes_277"/>
                                                </controls:SettingRow>
                                            </controls:SettingItem>
                                            <!-- The full-charge notice, opt-in and apart from the low notice. -->
                                            <controls:SettingItem>
                                                <controls:SettingRow MinHeight="44">
                                                    <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_BatteryNotifyFull, Source={x:Static strings:Strings.Instance}}"/>
                                                    <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{Binding Settings_BatteryNotifyFull, Source={x:Static strings:Strings.Instance}}"
                                                              IsChecked="{Binding BatteryNotifyFull}"/>
                                                    <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="BatteryNotifyFull"
                                                                              SettingLabel="{Binding Settings_BatteryNotifyFull, Source={x:Static strings:Strings.Instance}}"
                                                                              AutomationProperties.AutomationId="Reset_SettingsViewModel_BatteryNotifyFull_278"/>
                                                </controls:SettingRow>
                                            </controls:SettingItem>
                                        </StackPanel>
                                    </controls:MoreRow>
                                </controls:SettingItem>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ═══ Hardware ═══ -->
                    <StackPanel x:Name="HardwareGroup" Visibility="Collapsed"
                                controls:SettingSearch.Group="{Binding Settings_Group_Hardware, Source={x:Static strings:Strings.Instance}}">
                        <TextBlock x:Name="HardwareHeading" Style="{StaticResource SectionTitle}" Visibility="Collapsed" Margin="0,0,0,12"
                                   Text="{Binding Settings_Group_Hardware, Source={x:Static strings:Strings.Instance}}"/>

                        <!-- Hardware Support: a switch for each hardware PadForge can read
                             or drive, each with what it reports in the row's free width. -->
                        <Border Style="{StaticResource CardBorder}"
                                controls:SettingSearch.Card="{Binding Settings_HardwareSupport, Source={x:Static strings:Strings.Instance}}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" MinHeight="52" Margin="20,0,10,0">
                                    <TextBlock Text="{Binding Settings_HardwareSupport, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource CardTitle}"/>
                                    <ui:Button Style="{StaticResource ResetAllButton}" Command="{Binding ResetCardCommand}" CommandParameter="Hardware"
                                               Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}"
                                               AutomationProperties.AutomationId="Settings_ResetAll_Hardware">
                                        <ui:Button.ToolTip>
                                            <MultiBinding Converter="{StaticResource FormatTextConverter}">
                                                <Binding Path="Settings_HardwareSupport" Source="{x:Static strings:Strings.Instance}"/>
                                                <Binding Path="Pad_ResetSection_Format" Source="{x:Static strings:Strings.Instance}"/>
                                            </MultiBinding>
                                        </ui:Button.ToolTip>
                                    </ui:Button>
                                </DockPanel>
                                <controls:SettingItem>
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_FlydigiEnhanced, Source={x:Static strings:Strings.Instance}}"/>
                                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{Binding Settings_FlydigiEnhanced, Source={x:Static strings:Strings.Instance}}"
                                                  ToolTip="{Binding Settings_FlydigiEnhancedTooltip, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding FlydigiEnhancedProtocol}"/>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="FlydigiEnhancedProtocol"
                                                                  SettingLabel="{Binding Settings_FlydigiEnhanced, Source={x:Static strings:Strings.Instance}}"
                                                                  AutomationProperties.AutomationId="Reset_SettingsViewModel_FlydigiEnhancedProtocol_158"/>
                                    </controls:SettingRow>
                                </controls:SettingItem>
                                <!-- Logitech G-keys (#454): which of the seven cases the
                                     machine is in, so a quiet G-key is never a mystery. -->
                                <controls:SettingItem>
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_GKeys, Source={x:Static strings:Strings.Instance}}"/>
                                        <CheckBox x:Name="GKeysEnableCheckBox" Style="{StaticResource SwitchCheckBox}"
                                                  Content="{Binding Settings_GKeys, Source={x:Static strings:Strings.Instance}}"
                                                  ToolTip="{Binding Settings_GKeysTooltip, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding GKeysEnabled}"/>
                                        <TextBlock common:LiveText.Polite="True" Text="{Binding GKeysStatus}"
                                                   Visibility="{Binding GKeysStatus, Converter={StaticResource StringToVisibility}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource RowStatus}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding GKeysStatusIsWarning}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource WaitBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="GKeysEnabled"
                                                                  SettingLabel="{Binding Settings_GKeys, Source={x:Static strings:Strings.Instance}}"
                                                                  AutomationProperties.AutomationId="Reset_SettingsViewModel_GKeysEnabled_186"/>
                                    </controls:SettingRow>
                                </controls:SettingItem>
                                <!-- Analog keyboards (#468): that no supported keyboard was found. -->
                                <controls:SettingItem>
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_AnalogKeyboards, Source={x:Static strings:Strings.Instance}}"/>
                                        <CheckBox x:Name="AnalogKeyboardsEnableCheckBox" Style="{StaticResource SwitchCheckBox}"
                                                  Content="{Binding Settings_AnalogKeyboards, Source={x:Static strings:Strings.Instance}}"
                                                  ToolTip="{Binding Settings_AnalogKeyboardsTooltip, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding AnalogKeyboardsEnabled}"/>
                                        <TextBlock Style="{StaticResource RowStatus}" common:LiveText.Polite="True" Text="{Binding AnalogKeyboardsStatus}"
                                                   Foreground="{DynamicResource WaitBrush}"
                                                   Visibility="{Binding AnalogKeyboardsStatus, Converter={StaticResource StringToVisibility}}"/>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="AnalogKeyboardsEnabled"
                                                                  SettingLabel="{Binding Settings_AnalogKeyboards, Source={x:Static strings:Strings.Instance}}"
                                                                  AutomationProperties.AutomationId="Reset_SettingsViewModel_AnalogKeyboardsEnabled_188"/>
                                    </controls:SettingRow>
                                </controls:SettingItem>
                                <!-- Bliss-Box adapters (#469): that no port was found. -->
                                <controls:SettingItem>
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_BlissBox, Source={x:Static strings:Strings.Instance}}"/>
                                        <CheckBox x:Name="BlissBoxEnableCheckBox" Style="{StaticResource SwitchCheckBox}"
                                                  Content="{Binding Settings_BlissBox, Source={x:Static strings:Strings.Instance}}"
                                                  ToolTip="{Binding Settings_BlissBoxTooltip, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding BlissBoxEnabled}"/>
                                        <TextBlock Style="{StaticResource RowStatus}" common:LiveText.Polite="True" Text="{Binding BlissBoxStatus}"
                                                   Foreground="{DynamicResource WaitBrush}"
                                                   Visibility="{Binding BlissBoxStatus, Converter={StaticResource StringToVisibility}}"/>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="BlissBoxEnabled"
                                                                  SettingLabel="{Binding Settings_BlissBox, Source={x:Static strings:Strings.Instance}}"
                                                                  AutomationProperties.AutomationId="Reset_SettingsViewModel_BlissBoxEnabled_189"/>
                                    </controls:SettingRow>
                                </controls:SettingItem>
                                <!-- Handheld PC Buttons (#343). On, the Devices page gains the
                                     machine's Hidden Buttons row, learned by pressing, and its
                                     System Motion row. -->
                                <controls:SettingItem controls:SettingSearch.Terms="{Binding Settings_Handheld, Source={x:Static strings:Strings.Instance}}">
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_HandheldEnable, Source={x:Static strings:Strings.Instance}}"
                                                   ToolTip="{Binding Settings_HandheldDesc, Source={x:Static strings:Strings.Instance}}"/>
                                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{Binding Settings_HandheldEnable, Source={x:Static strings:Strings.Instance}}"
                                                  ToolTip="{Binding Settings_HandheldEnable_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding HandheldButtonsEnabled}"/>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="HandheldButtonsEnabled"
                                                                  SettingLabel="{Binding Settings_HandheldEnable, Source={x:Static strings:Strings.Instance}}"
                                                                  AutomationProperties.AutomationId="Reset_SettingsViewModel_HandheldButtonsEnabled_245"/>
                                    </controls:SettingRow>
                                </controls:SettingItem>
                                <!-- Keyboard Screens (#519): the Logitech GamePanel screens, Arx
                                     Control and the S.T.R.I.K.E. 7. The feature's lines are the
                                     vendor libraries and no screen found. Each screen's own row is
                                     on the Devices page. While the switch is on, the S.T.R.I.K.E.
                                     7's library line: Mad Catz's SDK fetched at the user's click,
                                     or a copy the user has, and the Visual C++ 2008 runtime it
                                     links. -->
                                <controls:SettingItem controls:SettingSearch.Terms="{Binding Settings_KeyboardScreens_Title, Source={x:Static strings:Strings.Instance}}">
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_KeyboardScreens, Source={x:Static strings:Strings.Instance}}"
                                                   ToolTip="{Binding Settings_KeyboardScreens_Desc, Source={x:Static strings:Strings.Instance}}"/>
                                        <CheckBox x:Name="KeyboardScreensEnableCheckBox" Style="{StaticResource SwitchCheckBox}"
                                                  Content="{Binding Settings_KeyboardScreens, Source={x:Static strings:Strings.Instance}}"
                                                  ToolTip="{Binding Settings_KeyboardScreensTooltip, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding KeyboardScreensEnabled}"/>
                                        <TextBlock common:LiveText.Polite="True" Text="{Binding KeyboardScreensStatus}"
                                                   Visibility="{Binding KeyboardScreensStatus, Converter={StaticResource StringToVisibility}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource RowStatus}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding KeyboardScreensStatusIsWarning}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource WaitBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="KeyboardScreensEnabled"
                                                                  SettingLabel="{Binding Settings_KeyboardScreens, Source={x:Static strings:Strings.Instance}}"
                                                                  AutomationProperties.AutomationId="Reset_SettingsViewModel_KeyboardScreensEnabled_13109"/>
                                    </controls:SettingRow>
                                    <WrapPanel Margin="20,2,10,4"
                                               Visibility="{Binding KeyboardScreensEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button Content="{Binding KeyboardScreens_DownloadStrike7, Source={x:Static strings:Strings.Instance}}"
                                                ToolTip="{Binding KeyboardScreens_DownloadStrike7_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                Command="{Binding DownloadStrike7LibraryCommand}" Margin="0,0,12,8"/>
                                        <Button Content="{Binding KeyboardScreens_PickStrike7, Source={x:Static strings:Strings.Instance}}"
                                                Command="{Binding PickStrike7LibraryCommand}" Margin="0,0,12,8"/>
                                        <Button Content="{Binding KeyboardScreens_InstallVc2008, Source={x:Static strings:Strings.Instance}}"
                                                ToolTip="{Binding KeyboardScreens_InstallVc2008_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                Command="{Binding InstallVc2008RuntimeCommand}" Margin="0,0,12,8"/>
                                    </WrapPanel>
                                </controls:SettingItem>
                                <!-- Novint Falcon (#521): PadForge opens each Falcon through Force
                                     Dimension's library, the user's own install of its SDK. The
                                     lines say which library runs and, while no Falcon is open,
                                     why none opened. Each open Falcon's line is on its Devices
                                     panel. -->
                                <controls:SettingItem controls:SettingSearch.Terms="{Binding Settings_Falcon_Title, Source={x:Static strings:Strings.Instance}}">
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_Falcon, Source={x:Static strings:Strings.Instance}}"
                                                   ToolTip="{Binding Settings_Falcon_Desc, Source={x:Static strings:Strings.Instance}}"/>
                                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{Binding Settings_Falcon, Source={x:Static strings:Strings.Instance}}"
                                                  ToolTip="{Binding Settings_FalconTooltip, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding NovintFalconEnabled}"/>
                                        <TextBlock common:LiveText.Polite="True" Text="{Binding FalconStatus}"
                                                   Visibility="{Binding FalconStatus, Converter={StaticResource StringToVisibility}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource RowStatus}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FalconStatusIsWarning}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource WaitBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="NovintFalconEnabled"
                                                                  SettingLabel="{Binding Settings_Falcon, Source={x:Static strings:Strings.Instance}}"
                                                                  AutomationProperties.AutomationId="Reset_SettingsViewModel_NovintFalconEnabled_13110"/>
                                    </controls:SettingRow>
                                    <WrapPanel Margin="20,2,10,4"
                                               Visibility="{Binding NovintFalconEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button Content="{Binding Falcon_PickLibrary, Source={x:Static strings:Strings.Instance}}"
                                                ToolTip="{Binding Falcon_PickLibrary_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                Command="{Binding PickFalconLibraryCommand}" Margin="0,0,12,8"/>
                                        <Button Content="{Binding Falcon_InstallDriver, Source={x:Static strings:Strings.Instance}}"
                                                ToolTip="{Binding Falcon_InstallDriver_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                Visibility="{Binding FalconCanInstallDriver, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Command="{Binding InstallFalconDriverCommand}" Margin="0,0,12,8"/>
                                        <Button Content="{Binding Falcon_OpenDownload, Source={x:Static strings:Strings.Instance}}"
                                                ToolTip="{Binding Falcon_OpenDownload_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                Command="{Binding OpenFalconDownloadCommand}" Margin="0,0,12,8"/>
                                    </WrapPanel>
                                </controls:SettingItem>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ═══ Drivers ═══ -->
                    <StackPanel x:Name="DriversGroup" Visibility="Collapsed"
                                controls:SettingSearch.Group="{Binding Settings_Group_Drivers, Source={x:Static strings:Strings.Instance}}">
                        <TextBlock x:Name="DriversHeading" Style="{StaticResource SectionTitle}" Visibility="Collapsed" Margin="0,0,0,12"
                                   Text="{Binding Settings_Group_Drivers, Source={x:Static strings:Strings.Instance}}"/>

                        <!-- One card of drivers with a hairline between rows, and at its
                             foot, while HidHide is installed, the fold of HidHide's
                             settings. -->
                        <controls:FoldList Gap="14" controls:SettingSearch.Card="{Binding Settings_Group_Drivers, Source={x:Static strings:Strings.Instance}}">
                            <controls:FoldList.Resources>
                                <!-- The list draws a hairline between two of its
                                     parts, so a part draws none over itself. -->
                                <Style TargetType="controls:SettingItem"/>
                            </controls:FoldList.Resources>
                            <Border Padding="20,16,10,16">
                                <TextBlock Text="{Binding Settings_Group_Drivers, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource CardTitle}"/>
                            </Border>

                            <!-- HidHide. Its line is what it does, so its name has no tooltip. -->
                            <controls:SettingItem MinHeight="63">
                                <controls:FlexLinePanel Style="{StaticResource DriverRow}">
                                    <Ellipse>
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse" BasedOn="{StaticResource DriverDot}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHidHideInstalled}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                                        <Setter Property="Stroke" Value="{DynamicResource EmberBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel controls:FlexLinePanel.Basis="280" controls:FlexLinePanel.Grow="1" VerticalAlignment="Center" Background="Transparent">
                                        <TextBlock Style="{StaticResource DriverName}" Text="{Binding Settings_HidHide, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBlock Style="{StaticResource DriverLine}" Text="{Binding Settings_HidHideDesc, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock common:LiveText.Polite="True" Text="{Binding HidHideStatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DriverState}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHidHideInstalled}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource DriverVersion}" Text="{Binding HidHideVersion}"
                                                   Visibility="{Binding HidHideVersion, Converter={StaticResource StringToVisibility}}"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource DriverAction}" Content="{Binding Common_Install, Source={x:Static strings:Strings.Instance}}"
                                            Command="{Binding InstallHidHideCommand}"
                                            Visibility="{Binding IsHidHideInstalled, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                        <AutomationProperties.Name>
                                            <MultiBinding StringFormat="{}{0}: {1}">
                                                <Binding Path="Settings_HidHide" Source="{x:Static strings:Strings.Instance}"/>
                                                <Binding Path="Common_Install" Source="{x:Static strings:Strings.Instance}"/>
                                            </MultiBinding>
                                        </AutomationProperties.Name>
                                    </Button>
                                    <Button Style="{StaticResource DriverAction}" Content="{Binding Common_Uninstall, Source={x:Static strings:Strings.Instance}}"
                                            Command="{Binding UninstallHidHideCommand}"
                                            Visibility="{Binding IsHidHideInstalled, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <AutomationProperties.Name>
                                            <MultiBinding StringFormat="{}{0}: {1}">
                                                <Binding Path="Settings_HidHide" Source="{x:Static strings:Strings.Instance}"/>
                                                <Binding Path="Common_Uninstall" Source="{x:Static strings:Strings.Instance}"/>
                                            </MultiBinding>
                                        </AutomationProperties.Name>
                                    </Button>
                                </controls:FlexLinePanel>
                            </controls:SettingItem>

                            <!-- HIDMaestro. Lit while the driver is in the driver store. The
                                 version is the SDK PadForge carries, which installs the
                                 driver with the first virtual controller. Uninstall (#518)
                                 opens a preview to confirm in and stays with the driver gone,
                                 since HIDMaestro can leave other things behind. -->
                            <controls:SettingItem MinHeight="63">
                                <controls:FlexLinePanel Style="{StaticResource DriverRow}">
                                    <Ellipse>
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse" BasedOn="{StaticResource DriverDot}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHIDMaestroInstalled}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                                        <Setter Property="Stroke" Value="{DynamicResource EmberBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel controls:FlexLinePanel.Basis="280" controls:FlexLinePanel.Grow="1" VerticalAlignment="Center" Background="Transparent"
                                                ToolTip="{Binding Settings_HIDMaestroDesc, Source={x:Static strings:Strings.Instance}}">
                                        <TextBlock Style="{StaticResource DriverName}" Text="{Binding Settings_HIDMaestro, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBlock Style="{StaticResource DriverLine}" Text="{Binding Settings_HIDMaestroLine, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock common:LiveText.Polite="True" Text="{Binding HIDMaestroStatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DriverState}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHIDMaestroInstalled}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource DriverVersion}" Text="{Binding HIDMaestroVersion}"
                                                   Visibility="{Binding HIDMaestroVersion, Converter={StaticResource StringToVisibility}}"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource DriverAction}" Content="{Binding Common_Uninstall, Source={x:Static strings:Strings.Instance}}"
                                            Command="{Binding UninstallHIDMaestroCommand}">
                                        <AutomationProperties.Name>
                                            <MultiBinding StringFormat="{}{0}: {1}">
                                                <Binding Path="Settings_HIDMaestro" Source="{x:Static strings:Strings.Instance}"/>
                                                <Binding Path="Common_Uninstall" Source="{x:Static strings:Strings.Instance}"/>
                                            </MultiBinding>
                                        </AutomationProperties.Name>
                                    </Button>
                                </controls:FlexLinePanel>
                            </controls:SettingItem>

                            <!-- BthPS3. Lit while either BthPS3 driver is installed as a
                                 service. The version is the BthPS3 PadForge carries, which a
                                 pairing installs. Uninstall opens a preview to confirm in and
                                 stays with the drivers gone, since PadForge's WinUSB package
                                 and certificate can remain. -->
                            <controls:SettingItem MinHeight="63">
                                <controls:FlexLinePanel Style="{StaticResource DriverRow}">
                                    <Ellipse>
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse" BasedOn="{StaticResource DriverDot}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBthPS3Installed}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                                        <Setter Property="Stroke" Value="{DynamicResource EmberBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel controls:FlexLinePanel.Basis="280" controls:FlexLinePanel.Grow="1" VerticalAlignment="Center" Background="Transparent"
                                                ToolTip="{Binding Settings_BthPS3Desc, Source={x:Static strings:Strings.Instance}}">
                                        <TextBlock Style="{StaticResource DriverName}" Text="{Binding Settings_BthPS3, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBlock Style="{StaticResource DriverLine}" Text="{Binding Settings_BthPS3Line, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BthPS3StatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DriverState}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBthPS3Installed}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource DriverVersion}" Text="{Binding BthPS3Version}"
                                                   Visibility="{Binding BthPS3Version, Converter={StaticResource StringToVisibility}}"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource DriverAction}" Content="{Binding Common_Uninstall, Source={x:Static strings:Strings.Instance}}"
                                            Command="{Binding UninstallBthPS3Command}">
                                        <AutomationProperties.Name>
                                            <MultiBinding StringFormat="{}{0}: {1}">
                                                <Binding Path="Settings_BthPS3" Source="{x:Static strings:Strings.Instance}"/>
                                                <Binding Path="Common_Uninstall" Source="{x:Static strings:Strings.Instance}"/>
                                            </MultiBinding>
                                        </AutomationProperties.Name>
                                    </Button>
                                </controls:FlexLinePanel>
                            </controls:SettingItem>

                            <!-- Windows MIDI Services. The older runtime's version reads in
                                 the telemetry face beside the state, and a note (a leftover
                                 runtime, a service that did not start, what the PC lacks)
                                 reads as a line under the description. Install fetches
                                 PadForge's build of the runtime (Microsoft withdrew its
                                 installers on 2026-10-01) where the PC has no in-box API and
                                 is not in Legacy API mode. Uninstall removes whichever
                                 runtime is installed, Microsoft's or PadForge's, and asks
                                 first when it is Microsoft's bundle, whose tools Microsoft no
                                 longer offers. While an uninstaller PadForge started still
                                 runs, both wait for it, and Install's tooltip, shown though
                                 the button is off, says so. -->
                            <controls:SettingItem MinHeight="63">
                                <controls:FlexLinePanel Style="{StaticResource DriverRow}">
                                    <Ellipse>
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse" BasedOn="{StaticResource DriverDot}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMidiAvailable}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                                        <Setter Property="Stroke" Value="{DynamicResource EmberBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel controls:FlexLinePanel.Basis="280" controls:FlexLinePanel.Grow="1" VerticalAlignment="Center" Background="Transparent"
                                                ToolTip="{Binding Settings_MidiDesc, Source={x:Static strings:Strings.Instance}}">
                                        <TextBlock Style="{StaticResource DriverName}" Text="{Binding Settings_MidiServices, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBlock Style="{StaticResource DriverLine}" Text="{Binding Settings_MidiLine, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBlock Text="{Binding MidiServicesDetailText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DriverLine}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MidiDetailIsVersion}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MidiServicesDetailText}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MidiServicesDetailText}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock common:LiveText.Polite="True" Text="{Binding MidiServicesStatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DriverState}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMidiAvailable}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding MidiServicesDetailText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DriverVersion}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MidiDetailIsVersion}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Style="{StaticResource DriverAction}" Content="{Binding Common_Install, Source={x:Static strings:Strings.Instance}}"
                                            Command="{Binding InstallMidiRuntimeCommand}"
                                            ToolTip="{Binding MidiInstallTooltip}"
                                            ToolTipService.ShowOnDisabled="True"
                                            AutomationProperties.AutomationId="MidiRuntimeInstallButton"
                                            Visibility="{Binding CanInstallMidiRuntime, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <AutomationProperties.Name>
                                            <MultiBinding StringFormat="{}{0}: {1}">
                                                <Binding Path="Settings_MidiServices" Source="{x:Static strings:Strings.Instance}"/>
                                                <Binding Path="Common_Install" Source="{x:Static strings:Strings.Instance}"/>
                                            </MultiBinding>
                                        </AutomationProperties.Name>
                                    </Button>
                                    <Button Style="{StaticResource DriverAction}" Content="{Binding Common_Uninstall, Source={x:Static strings:Strings.Instance}}"
                                            Command="{Binding UninstallMidiServicesCommand}"
                                            AutomationProperties.AutomationId="MidiRuntimeUninstallButton"
                                            Visibility="{Binding IsMidiRuntimeInstalled, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <AutomationProperties.Name>
                                            <MultiBinding StringFormat="{}{0}: {1}">
                                                <Binding Path="Settings_MidiServices" Source="{x:Static strings:Strings.Instance}"/>
                                                <Binding Path="Common_Uninstall" Source="{x:Static strings:Strings.Instance}"/>
                                            </MultiBinding>
                                        </AutomationProperties.Name>
                                    </Button>
                                </controls:FlexLinePanel>
                            </controls:SettingItem>

                            <!-- SteamVR (VR controllers, #49). HIDMaestro lists other OpenVR
                                 drivers SteamVR can see under HIDMaestro's driver name
                                 (HMVR.FindDriverNameConflicts). OpenVR loads one driver per
                                 name, so with one present the VR slot's controllers can fail
                                 to appear for no other visible reason, which the warning line
                                 says. The install location shows only before an install
                                 exists. PadForge does not keep it. On success the HIDMaestro
                                 path hint is the record of where the payload lives. Uninstall
                                 is offered only for the Steam-free install PadForge itself
                                 made. A Steam client's install belongs to Steam. -->
                            <controls:SettingItem MinHeight="63">
                                <controls:FlexLinePanel Style="{StaticResource DriverRow}">
                                    <Ellipse>
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse" BasedOn="{StaticResource DriverDot}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSteamVrInstalled}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                                        <Setter Property="Stroke" Value="{DynamicResource EmberBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel controls:FlexLinePanel.Basis="280" controls:FlexLinePanel.Grow="1" VerticalAlignment="Center" Background="Transparent"
                                                ToolTip="{Binding Settings_SteamVRDesc, Source={x:Static strings:Strings.Instance}}">
                                        <TextBlock Style="{StaticResource DriverName}" Text="{Binding Settings_SteamVR, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBlock Style="{StaticResource DriverLine}" Text="{Binding Settings_SteamVRLine, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBlock Style="{StaticResource DriverLine}" Text="{Binding SteamVrDriverConflictText}"
                                                   Margin="0,4,0,0" Foreground="{DynamicResource WaitBrush}"
                                                   Visibility="{Binding HasSteamVrDriverConflict, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock common:LiveText.Polite="True" Text="{Binding SteamVrStatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DriverState}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSteamVrInstalled}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Style="{StaticResource DriverAction}" Content="{Binding Common_Install, Source={x:Static strings:Strings.Instance}}"
                                            Command="{Binding InstallSteamVrCommand}"
                                            Visibility="{Binding IsSteamVrInstalled, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                        <AutomationProperties.Name>
                                            <MultiBinding StringFormat="{}{0}: {1}">
                                                <Binding Path="Settings_SteamVR" Source="{x:Static strings:Strings.Instance}"/>
                                                <Binding Path="Common_Install" Source="{x:Static strings:Strings.Instance}"/>
                                            </MultiBinding>
                                        </AutomationProperties.Name>
                                    </Button>
                                    <Button Style="{StaticResource DriverAction}" Content="{Binding Common_Uninstall, Source={x:Static strings:Strings.Instance}}"
                                            Command="{Binding UninstallSteamVrCommand}"
                                            Visibility="{Binding ShowSteamVrUninstall, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <AutomationProperties.Name>
                                            <MultiBinding StringFormat="{}{0}: {1}">
                                                <Binding Path="Settings_SteamVR" Source="{x:Static strings:Strings.Instance}"/>
                                                <Binding Path="Common_Uninstall" Source="{x:Static strings:Strings.Instance}"/>
                                            </MultiBinding>
                                        </AutomationProperties.Name>
                                    </Button>
                                </controls:FlexLinePanel>
                                <controls:SettingRow MinHeight="44" Margin="44,0,10,10"
                                                     Visibility="{Binding IsSteamVrInstalled, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                    <TextBlock Text="{Binding Settings_SteamVRInstallDir, Source={x:Static strings:Strings.Instance}}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBox Text="{Binding SteamVrInstallDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             controls:SettingRow.Fills="True" MaxWidth="420" MinWidth="200" VerticalAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             AutomationProperties.Name="{Binding Settings_SteamVRInstallDir, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Common_Browse, Source={x:Static strings:Strings.Instance}}"
                                            Click="SteamVrBrowse_Click" Margin="12,0,0,0"/>
                                    <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="SteamVrInstallDir"
                                                              SettingLabel="{Binding Settings_SteamVRInstallDir, Source={x:Static strings:Strings.Instance}}"
                                                              AutomationProperties.AutomationId="Reset_SettingsViewModel_SteamVrInstallDir_535"/>
                                </controls:SettingRow>
                            </controls:SettingItem>

                            <!-- HidHide's settings, in a fold at the card's foot while HidHide
                                 is installed, their gate since they have nothing to act on
                                 without it. -->
                            <controls:SettingItem Visibility="{Binding IsHidHideInstalled, Converter={StaticResource BoolToVisibilityConverter}}">
                                <controls:FoldCard x:Name="HidHideOptions" StateKey="Settings.Drivers.HidHideOptions" Padding="20,0,20,0"
                                                   AutomationProperties.AutomationId="Settings_HidHideOptions"
                                                   Header="{Binding Settings_HidHideOptions, Source={x:Static strings:Strings.Instance}}"
                                                   Hint="{Binding Settings_HidHideOptions_FoldHint, Source={x:Static strings:Strings.Instance}}">
                                    <!-- The fold's open part pads what it holds (20, 0,
                                         12, 12), which the rows hand back to stand as
                                         every card's rows do, each under its hairline. -->
                                    <StackPanel Margin="-20,0,-12,-12">
                                        <StackPanel.Resources>
                                            <Style TargetType="controls:SettingItem">
                                                <Setter Property="Rule" Value="{DynamicResource SteelLineSoftBrush}"/>
                                            </Style>
                                        </StackPanel.Resources>
                                        <controls:SettingItem>
                                            <controls:SettingRow MinHeight="44">
                                                <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_HideDevices, Source={x:Static strings:Strings.Instance}}"/>
                                                <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{Binding Settings_HideDevices, Source={x:Static strings:Strings.Instance}}"
                                                          ToolTip="{Binding Settings_HideDevicesTooltip, Source={x:Static strings:Strings.Instance}}"
                                                          IsChecked="{Binding EnableInputHiding}"/>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="EnableInputHiding"
                                                                          SettingLabel="{Binding Settings_HideDevices, Source={x:Static strings:Strings.Instance}}"
                                                                          AutomationProperties.AutomationId="Reset_SettingsViewModel_EnableInputHiding_348"/>
                                            </controls:SettingRow>
                                        </controls:SettingItem>
                                        <controls:SettingItem>
                                            <controls:SettingRow MinHeight="44">
                                                <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_KeepCloaksBetweenLaunches, Source={x:Static strings:Strings.Instance}}"/>
                                                <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{Binding Settings_KeepCloaksBetweenLaunches, Source={x:Static strings:Strings.Instance}}"
                                                          ToolTip="{Binding Settings_KeepCloaksBetweenLaunchesTooltip, Source={x:Static strings:Strings.Instance}}"
                                                          IsChecked="{Binding KeepHidHideCloaksBetweenLaunches}"/>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="KeepHidHideCloaksBetweenLaunches"
                                                                          SettingLabel="{Binding Settings_KeepCloaksBetweenLaunches, Source={x:Static strings:Strings.Instance}}"
                                                                          AutomationProperties.AutomationId="Reset_SettingsViewModel_KeepHidHideCloaksBetweenLaunches_355"/>
                                            </controls:SettingRow>
                                        </controls:SettingItem>
                                        <!-- The applications HidHide lets see the hidden devices. The
                                             list's rows take the ember select look (user report
                                             2026-07-05), not the stock accent slab. -->
                                        <!-- Not a row: the list's name with what it is for
                                             under it, the list the card's width in a well of its
                                             own, so an empty list still reads as a list, and its
                                             two buttons. -->
                                        <controls:SettingItem>
                                            <StackPanel x:Name="WhitelistBlock" Margin="20,13,10,10">
                                                <TextBlock Text="{Binding Settings_WhitelistedApps, Source={x:Static strings:Strings.Instance}}"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Settings_WhitelistDesc, Source={x:Static strings:Strings.Instance}}"
                                                           Style="{StaticResource CardDescription}" Margin="0,2,0,10"/>
                                                <Border CornerRadius="8" BorderThickness="1" Padding="4" Margin="0,0,0,10"
                                                        Background="{DynamicResource SteelFieldBrush}" BorderBrush="{DynamicResource SteelLineSoftBrush}">
                                                    <ListBox ItemsSource="{Binding HidHideWhitelistPaths}"
                                                             SelectedItem="{Binding SelectedWhitelistPath}"
                                                             ItemContainerStyle="{StaticResource EmberSelectListItem}"
                                                             MaxHeight="140" MinHeight="32"
                                                             AutomationProperties.Name="{Binding Settings_WhitelistedApps, Source={x:Static strings:Strings.Instance}}">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" FontSize="12" FontFamily="{StaticResource TelemetryFontFamily}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Border>
                                                <!-- Each button reads with the list's name, as a
                                                     driver's button reads with the driver's. -->
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="WhitelistAdd" Content="{Binding Settings_AddDots, Source={x:Static strings:Strings.Instance}}"
                                                            Command="{Binding AddWhitelistPathCommand}" Margin="0,0,12,0">
                                                        <AutomationProperties.Name>
                                                            <MultiBinding StringFormat="{}{0}: {1}">
                                                                <Binding Path="Settings_WhitelistedApps" Source="{x:Static strings:Strings.Instance}"/>
                                                                <Binding Path="Settings_AddDots" Source="{x:Static strings:Strings.Instance}"/>
                                                            </MultiBinding>
                                                        </AutomationProperties.Name>
                                                    </Button>
                                                    <Button x:Name="WhitelistRemove" Content="{Binding Common_Remove, Source={x:Static strings:Strings.Instance}}"
                                                            Command="{Binding RemoveWhitelistPathCommand}">
                                                        <AutomationProperties.Name>
                                                            <MultiBinding StringFormat="{}{0}: {1}">
                                                                <Binding Path="Settings_WhitelistedApps" Source="{x:Static strings:Strings.Instance}"/>
                                                                <Binding Path="Common_Remove" Source="{x:Static strings:Strings.Instance}"/>
                                                            </MultiBinding>
                                                        </AutomationProperties.Name>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </controls:SettingItem>
                                    </StackPanel>
                                </controls:FoldCard>
                            </controls:SettingItem>
                        </controls:FoldList>
                    </StackPanel>

                    <!-- ═══ Data & Privacy ═══ -->
                    <StackPanel x:Name="DataGroup" Visibility="Collapsed"
                                controls:SettingSearch.Group="{Binding Settings_Group_Data, Source={x:Static strings:Strings.Instance}}">
                        <TextBlock x:Name="DataHeading" Style="{StaticResource SectionTitle}" Visibility="Collapsed" Margin="0,0,0,12"
                                   Text="{Binding Settings_Group_Data, Source={x:Static strings:Strings.Instance}}"/>

                        <!-- Community Configs (Steam Workshop, #9). The paragraph says when
                             PadForge reaches Steam, and What Is Sent opens the full account
                             in place. Clear Cached Configs and the update check stay with
                             the opt-in off: the check answers with a status message instead
                             of reaching the network. -->
                        <Border Style="{StaticResource CardBorder}"
                                controls:SettingSearch.Card="{Binding Settings_CommunityConfigs, Source={x:Static strings:Strings.Instance}}"
                                controls:SettingSearch.Terms="{Binding Settings_CommunityConfigsDesc, Source={x:Static strings:Strings.Instance}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Settings_CommunityConfigs, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource CardTitle}" Margin="20,16,10,16"/>
                                <controls:SettingItem>
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_EnableCommunityConfigs, Source={x:Static strings:Strings.Instance}}"/>
                                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{Binding Settings_EnableCommunityConfigs, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding EnableCommunityConfigLookup}"/>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="EnableCommunityConfigLookup"
                                                                  SettingLabel="{Binding Settings_EnableCommunityConfigs, Source={x:Static strings:Strings.Instance}}"
                                                                  AutomationProperties.AutomationId="Reset_SettingsViewModel_EnableCommunityConfigLookup_573"/>
                                    </controls:SettingRow>
                                </controls:SettingItem>
                                <controls:SettingItem Visibility="{Binding EnableCommunityConfigLookup, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Style="{StaticResource DzSubLabel}" Text="{Binding Settings_ShowLegacyConfigs, Source={x:Static strings:Strings.Instance}}"/>
                                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{Binding Settings_ShowLegacyConfigs, Source={x:Static strings:Strings.Instance}}"
                                                  ToolTip="{Binding Settings_ShowLegacyConfigsTooltip, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding ShowLegacyWorkshopConfigs}"/>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="ShowLegacyWorkshopConfigs"
                                                                  SettingLabel="{Binding Settings_ShowLegacyConfigs, Source={x:Static strings:Strings.Instance}}"
                                                                  AutomationProperties.AutomationId="Reset_SettingsViewModel_ShowLegacyWorkshopConfigs_581"/>
                                    </controls:SettingRow>
                                </controls:SettingItem>
                                <!-- What Is Sent stands under the line it adds to and
                                     opens the full account under itself, with the
                                     chevron the pad page's More Options has: down while
                                     closed, up while open. Beside the two buttons and
                                     with no chevron it read as their name. Its words
                                     start where the line's do, and its fill under the
                                     pointer reaches 10 past them at each side. -->
                                <controls:SettingItem>
                                    <TextBlock Text="{Binding Settings_CommunityConfigs_Line, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardDescription}" Margin="20,12,10,2"/>
                                    <ToggleButton x:Name="WhatIsSentToggle" Style="{StaticResource QuietToggle}" Padding="10,0" Margin="10,0,10,0"
                                                  HorizontalAlignment="Left" AutomationProperties.AutomationId="Settings_WhatIsSent"
                                                  AutomationProperties.Name="{Binding Settings_WhatIsSent, Source={x:Static strings:Strings.Instance}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Settings_WhatIsSent, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"/>
                                            <Path x:Name="WhatIsSentChevron" FlowDirection="LeftToRight" Data="M 1,3 L 5,7 L 9,3" Width="10" Height="10" Margin="8,0,0,0"
                                                  Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.4"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=WhatIsSentToggle}" Value="True">
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <RotateTransform Angle="180"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </StackPanel>
                                    </ToggleButton>
                                    <TextBlock x:Name="WhatIsSentAccount" Text="{Binding Settings_CommunityConfigsDesc, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardDescription}" Margin="20,2,10,6"
                                               Visibility="{Binding IsChecked, ElementName=WhatIsSentToggle, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <controls:FlexLinePanel Gap="12" LineGap="12" MinLineHeight="44" Margin="20,2,10,4">
                                        <Button Content="{Binding Settings_ClearWorkshopCache, Source={x:Static strings:Strings.Instance}}"
                                                Command="{Binding ClearWorkshopCacheCommand}"/>
                                        <Button Content="{Binding Settings_CheckWorkshopUpdates, Source={x:Static strings:Strings.Instance}}"
                                                Command="{Binding CheckWorkshopUpdatesCommand}"/>
                                    </controls:FlexLinePanel>
                                </controls:SettingItem>
                            </StackPanel>
                        </Border>

                        <!-- Settings File. Save commits the file. Reset to Defaults stands
                             apart at the line's end in the danger tint. -->
                        <Border Style="{StaticResource CardBorder}"
                                controls:SettingSearch.Card="{Binding Settings_SettingsFile, Source={x:Static strings:Strings.Instance}}"
                                controls:SettingSearch.Terms="{Binding Settings_SettingsFileDesc, Source={x:Static strings:Strings.Instance}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Settings_SettingsFile, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource CardTitle}"
                                           ToolTip="{Binding Settings_SettingsFileDesc, Source={x:Static strings:Strings.Instance}}" Margin="20,16,10,16"/>
                                <controls:SettingItem>
                                    <TextBlock Text="{Binding SettingsFilePath}" FontSize="13" FontFamily="{StaticResource TelemetryFontFamily}"
                                               Foreground="{DynamicResource ColdBrush}" TextWrapping="Wrap" Margin="20,14,10,6"/>
                                    <controls:FlexLinePanel Gap="12" LineGap="12" MinLineHeight="44" EndsApart="True" Margin="20,0,10,4">
                                        <Button Content="{Binding Common_Save, Source={x:Static strings:Strings.Instance}}" Command="{Binding SaveCommand}"
                                                Style="{StaticResource EmberAccentButton}" Padding="14,0"/>
                                        <Button Content="{Binding Settings_Reload, Source={x:Static strings:Strings.Instance}}" Command="{Binding ReloadCommand}"/>
                                        <Button Content="{Binding Settings_OpenFolder, Source={x:Static strings:Strings.Instance}}" Command="{Binding OpenSettingsFolderCommand}"/>
                                        <Button controls:FlexLinePanel.AtEnd="True" Content="{Binding Settings_ResetToDefaults, Source={x:Static strings:Strings.Instance}}"
                                                Command="{Binding ResetCommand}"
                                                Foreground="{DynamicResource DangerInkBrush}" BorderBrush="{DynamicResource EmberEdgeBrush}"/>
                                    </controls:FlexLinePanel>
                                    <TextBlock Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibilityConverter}}"
                                               Text="{Binding Settings_UnsavedChanges, Source={x:Static strings:Strings.Instance}}"
                                               Foreground="{DynamicResource WaitBrush}" FontSize="13" Margin="20,0,10,10"/>
                                </controls:SettingItem>
                            </StackPanel>
                        </Border>

                        <!-- Diagnostics. Logging (#303) is the flag-free way to get a
                             trace: the switch persists, so sessions that start the engine
                             on their own log too. A snapshot works with logging off,
                             since the engine always keeps its recent events in memory. -->
                        <Border Style="{StaticResource CardBorder}"
                                controls:SettingSearch.Card="{Binding Settings_Diagnostics, Source={x:Static strings:Strings.Instance}}"
                                controls:SettingSearch.Terms="{Binding Settings_DiagnosticsDesc, Source={x:Static strings:Strings.Instance}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Settings_Diagnostics, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource CardTitle}"
                                           ToolTip="{Binding Settings_DiagnosticsDesc, Source={x:Static strings:Strings.Instance}}" Margin="20,16,10,16"/>
                                <controls:SettingItem>
                                    <controls:SettingRow MinHeight="30">
                                        <TextBlock Style="{StaticResource DzLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding Settings_AppVersion, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBlock Text="{Binding ApplicationVersion}" FontSize="13" FontFamily="{StaticResource TelemetryFontFamily}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    </controls:SettingRow>
                                    <controls:SettingRow MinHeight="30">
                                        <TextBlock Style="{StaticResource DzLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding Settings_DotNetRuntime, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBlock Text="{Binding RuntimeVersion}" FontSize="13" FontFamily="{StaticResource TelemetryFontFamily}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    </controls:SettingRow>
                                    <controls:SettingRow MinHeight="30">
                                        <TextBlock Style="{StaticResource DzLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding Settings_SdlVersion, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBlock Text="{Binding SdlVersion}" FontSize="13" FontFamily="{StaticResource TelemetryFontFamily}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    </controls:SettingRow>
                                </controls:SettingItem>
                                <controls:SettingItem>
                                    <controls:SettingRow MinHeight="44">
                                        <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Settings_DiagnosticsLogging, Source={x:Static strings:Strings.Instance}}"/>
                                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{Binding Settings_DiagnosticsLogging, Source={x:Static strings:Strings.Instance}}"
                                                  ToolTip="{Binding Settings_DiagnosticsLoggingTooltip, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding DiagnosticsLoggingEnabled}"/>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="DiagnosticsLoggingEnabled"
                                                                  SettingLabel="{Binding Settings_DiagnosticsLogging, Source={x:Static strings:Strings.Instance}}"
                                                                  AutomationProperties.AutomationId="Reset_SettingsViewModel_DiagnosticsLoggingEnabled_674"/>
                                    </controls:SettingRow>
                                </controls:SettingItem>
                                <controls:SettingItem>
                                    <controls:FlexLinePanel Gap="12" LineGap="12" MinLineHeight="44" Margin="20,2,10,2">
                                        <Button Content="{Binding Settings_DiagnosticsSnapshot, Source={x:Static strings:Strings.Instance}}"
                                                Click="SaveDiagSnapshot_Click"
                                                ToolTip="{Binding Settings_DiagnosticsSnapshotTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <Button Content="{Binding Settings_DiagnosticsOpenFolder, Source={x:Static strings:Strings.Instance}}"
                                                Click="OpenDiagFolder_Click" ToolTip="{Binding DiagnosticsFolderPath}"/>
                                    </controls:FlexLinePanel>
                                </controls:SettingItem>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </controls:FlexLinePanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
