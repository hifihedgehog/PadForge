<UserControl x:Class="PadForge.Views.VRPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:strings="clr-namespace:PadForge.Resources.Strings"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="700"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Button pill. Lit state is applied in code-behind so the
             per-frame path touches a brush, not a trigger. -->
        <Style x:Key="VrPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SegTrackStrokeBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SegTrackBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
        <Style x:Key="VrPillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
        </Style>
        <Style x:Key="VrAxisLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="52"/>
        </Style>
        <Style x:Key="VrHandTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="16">
        <Grid Width="640">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ Left hand ═══ -->
            <Border Grid.Row="0" Grid.Column="0" Padding="16"
                    CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource SegTrackStrokeBrush}"
                    Background="{DynamicResource CrucibleCardBrush}">
                <StackPanel>
                    <TextBlock Text="{Binding Vr_LeftHand, Source={x:Static strings:Strings.Instance}}"
                               Style="{StaticResource VrHandTitle}"/>

                    <!-- Stick crosshair -->
                    <Canvas x:Name="LeftStickCanvas" Width="96" Height="96"
                            HorizontalAlignment="Left" Margin="0,0,0,12">
                        <Ellipse Width="96" Height="96"
                                 Stroke="{DynamicResource SegTrackStrokeBrush}" StrokeThickness="1"
                                 Fill="{DynamicResource SegTrackBrush}"/>
                        <Ellipse x:Name="LeftStickDot" Width="16" Height="16"
                                 Canvas.Left="40" Canvas.Top="40"
                                 Fill="{DynamicResource EmberBrush}"/>
                    </Canvas>

                    <!-- Analog pulls -->
                    <Grid Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="{Binding Btn_LeftTrigger, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource VrAxisLabel}"/>
                            <Border Width="160" Height="10" CornerRadius="5"
                                    Background="{DynamicResource SegTrackBrush}"
                                    BorderThickness="1" BorderBrush="{DynamicResource SegTrackStrokeBrush}">
                                <Rectangle x:Name="LeftTriggerBar" Width="0" HorizontalAlignment="Left"
                                           RadiusX="5" RadiusY="5" Fill="{DynamicResource EmberBrush}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding Btn_VrLeftGrip, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource VrAxisLabel}"/>
                            <Border Width="160" Height="10" CornerRadius="5"
                                    Background="{DynamicResource SegTrackBrush}"
                                    BorderThickness="1" BorderBrush="{DynamicResource SegTrackStrokeBrush}">
                                <Rectangle x:Name="LeftGripBar" Width="0" HorizontalAlignment="Left"
                                           RadiusX="5" RadiusY="5" Fill="{DynamicResource EmberBrush}"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Buttons, in HMVRButton bit order -->
                    <WrapPanel x:Name="LeftButtonPanel"/>
                </StackPanel>
            </Border>

            <!-- ═══ Right hand ═══ -->
            <Border Grid.Row="0" Grid.Column="2" Padding="16"
                    CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource SegTrackStrokeBrush}"
                    Background="{DynamicResource CrucibleCardBrush}">
                <StackPanel>
                    <TextBlock Text="{Binding Vr_RightHand, Source={x:Static strings:Strings.Instance}}"
                               Style="{StaticResource VrHandTitle}"/>

                    <Canvas x:Name="RightStickCanvas" Width="96" Height="96"
                            HorizontalAlignment="Left" Margin="0,0,0,12">
                        <Ellipse Width="96" Height="96"
                                 Stroke="{DynamicResource SegTrackStrokeBrush}" StrokeThickness="1"
                                 Fill="{DynamicResource SegTrackBrush}"/>
                        <Ellipse x:Name="RightStickDot" Width="16" Height="16"
                                 Canvas.Left="40" Canvas.Top="40"
                                 Fill="{DynamicResource EmberBrush}"/>
                    </Canvas>

                    <Grid Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="{Binding Btn_RightTrigger, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource VrAxisLabel}"/>
                            <Border Width="160" Height="10" CornerRadius="5"
                                    Background="{DynamicResource SegTrackBrush}"
                                    BorderThickness="1" BorderBrush="{DynamicResource SegTrackStrokeBrush}">
                                <Rectangle x:Name="RightTriggerBar" Width="0" HorizontalAlignment="Left"
                                           RadiusX="5" RadiusY="5" Fill="{DynamicResource EmberBrush}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding Btn_VrRightGrip, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource VrAxisLabel}"/>
                            <Border Width="160" Height="10" CornerRadius="5"
                                    Background="{DynamicResource SegTrackBrush}"
                                    BorderThickness="1" BorderBrush="{DynamicResource SegTrackStrokeBrush}">
                                <Rectangle x:Name="RightGripBar" Width="0" HorizontalAlignment="Left"
                                           RadiusX="5" RadiusY="5" Fill="{DynamicResource EmberBrush}"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <WrapPanel x:Name="RightButtonPanel"/>
                </StackPanel>
            </Border>

            <!-- Footnote: v1 sends no pose, so say so rather than leave
                 the user wondering where the headset tracking is. -->
            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                       Text="{Binding Vr_PreviewNote, Source={x:Static strings:Strings.Instance}}"
                       FontSize="11" TextWrapping="Wrap" Margin="2,14,2,0"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
        </Grid>
    </Viewbox>

</UserControl>
