<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>PadForge.Engine</RootNamespace>
    <AssemblyName>PadForge.Engine</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!--
      CA1416: this assembly is Windows-only by design (SDL3, Raw Input, HID,
      registry-driven device enumeration). The TargetFramework already pins
      net10.0-windows; the platform-compatibility warnings on RegistryKey
      etc. don't add information.
    -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <Product>PadForge</Product>
    <Company>PadForge</Company>
    <Copyright>Copyright © PadForge Contributors</Copyright>
    <Description>PadForge input engine — SDL3, Raw Input, and HID device enumeration.</Description>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
