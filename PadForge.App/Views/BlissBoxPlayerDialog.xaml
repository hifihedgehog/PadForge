<views:DialogWindow AutomationProperties.IsDialog="True" x:Class="PadForge.Views.BlissBoxPlayerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        xmlns:controls="clr-namespace:PadForge.Controls"
        xmlns:reset="clr-namespace:PadForge.Controls"
        xmlns:views="clr-namespace:PadForge.Views"
        BodyPadding="22,14,22,18"
        Title="{Binding BlissBoxPlayer_Title, Source={x:Static strings:Strings.Instance}}"
        Subtitle="{Binding BlissBoxPlayer_Message, Source={x:Static strings:Strings.Instance}}">

    <!-- A Bliss-Box port's player number (issue #469), as the Confirm board
         draws it: the number to choose over a foot where Cancel holds the
         default and the focus, since the adapter reconnects as a new
         device once the number is set. -->
    <views:DialogWindow.Foot>
        <controls:FlexLinePanel Style="{StaticResource DialogFootPanel}">
            <Button x:Name="CancelButton" Style="{StaticResource DialogButton}"
                    Content="{Binding Common_Cancel, Source={x:Static strings:Strings.Instance}}"
                    IsCancel="True" IsDefault="True"/>
            <Button x:Name="ActionButton" Style="{StaticResource DialogPrimaryButton}"
                    Content="{Binding BlissBoxPlayer_Action, Source={x:Static strings:Strings.Instance}}"
                    Click="ActionButton_Click"/>
        </controls:FlexLinePanel>
    </views:DialogWindow.Foot>

    <StackPanel>
        <!-- The port being changed, which the board does not draw: it says
             which adapter and port the number is for. Collapsed when the
             caller names none. -->
        <TextBlock x:Name="DetailText" Style="{StaticResource DialogMonoNote}" Margin="0,0,0,8"/>
        <controls:SettingRow MinHeight="34">
            <TextBlock Style="{StaticResource DialogLabel}" Width="120" Margin="0,0,12,0"
                       Text="{Binding BlissBoxPlayer_Label, Source={x:Static strings:Strings.Instance}}"/>
            <ComboBox x:Name="PlayerBox" Style="{StaticResource DialogSelect}" MinWidth="64"
                      AutomationProperties.Name="{Binding BlissBoxPlayer_Label, Source={x:Static strings:Strings.Instance}}">
                <ComboBoxItem Content="1" Tag="1"/>
                <ComboBoxItem Content="2" Tag="2"/>
                <ComboBoxItem Content="3" Tag="3"/>
                <ComboBoxItem Content="4" Tag="4"/>
            </ComboBox>
            <reset:SettingResetButton Click="ResetPlayer_Click" SettingLabel="{Binding BlissBoxPlayer_Label, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_?dialog_PlayerBox_49"/>
        </controls:SettingRow>
    </StackPanel>
</views:DialogWindow>
