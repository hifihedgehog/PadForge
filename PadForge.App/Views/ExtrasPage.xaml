                                           Style="{StaticResource CardDescription}"/>
                                <DockPanel LastChildFill="True" Margin="0,10,0,8" HorizontalAlignment="Left">
                                    <reset:SettingResetButton DockPanel.Dock="Right" Command="{Binding RemoteLink.ResetSettingCommand}" CommandParameter="IdentityProtectionModeIndex" SettingLabel="{Binding RemoteLink_IdentityTitle, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_SettingsViewModel_IdentityProtectionModeIndex_1638"/>
                                    <ComboBox Width="320"
                                              ItemsSource="{Binding RemoteLink.IdentityProtectionModes}"
                                              SelectedIndex="{Binding RemoteLink.IdentityProtectionModeIndex, Mode=TwoWay}"/>
                                </DockPanel>
                                <TextBlock Text="{Binding RemoteLink.IdentityProtectionHint}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>

                                <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,14,0,14"/>

                                <!-- Connect by address OR code (fallback when discovery can't see the PC) -->
                                <TextBlock Text="{Binding Dashboard_RemoteLinkConnect, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardSectionTitle}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBox Text="{Binding RemoteLinkConnectHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="192.168.1.20:27500" Width="220" VerticalAlignment="Center"
                                                AutomationProperties.Name="{Binding Dashboard_RemoteLinkConnect, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Command="{Binding ConnectToPeerCommand}" Margin="8,0,0,0"
                                               Content="{Binding Dashboard_RemoteLinkConnectButton, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </StackPanel>
                        </controls:MoreRow>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ═══ Motion Server ═══
                 First: whether it is serving. Under More: the port. -->
            <StackPanel x:Name="MotionServerPage" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Style="{StaticResource ExtrasCrumb}" Click="Back_Click"
                            AutomationProperties.AutomationId="Extras_Back_MotionServer"
                            Content="{Binding Extras_Title, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock Text="/" VerticalAlignment="Center" Margin="8,0,8,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="{Binding Dashboard_MotionServer, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <reset:GlyphText Text="&#xE7AD;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="MotionServerTitle" AutomationProperties.HeadingLevel="Level1" Text="{Binding Dashboard_MotionServer, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource TitleTextBlockStyle}" FontFamily="{StaticResource DisplayFontFamily}" FontWeight="650" FontSize="26" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Style="{StaticResource SwitchCheckBox}" controls:SwitchLook.ShowState="True"
                                  VerticalAlignment="Center" Content="{Binding Dashboard_EnableDsu, Source={x:Static strings:Strings.Instance}}"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  IsChecked="{Binding EnableDsuMotionServer}"/>
