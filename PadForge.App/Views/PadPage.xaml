                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Label}"
                                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                  MinWidth="160" Margin="0,0,8,4"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
