<UserControl x:Class="PadForge.Views.Controls.ProfilePill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:strings="clr-namespace:PadForge.Resources.Strings">
    <!-- Active-profile pill (#175 item 8): rounded steel chip carrying a
         lit flame + the active profile name in telemetry mono. Hosted in
         the pad-page tier-1 bar and the status-bar instrument cluster.
         Both hosts sit under different DataContexts, so code-behind
         rebinds the pill to MainViewModel.Settings on Loaded. That is the
         one SettingsViewModel whose ActiveProfileInfo every switch path
         (auto, shortcut cycle, Load button, delete/revert) already sets.
         Click opens the switcher flyout; MainWindow wires it. Hover is a
         fill lighten only: the Effect slot is reserved for the code-driven
         auto-switch flare (one Effect slot per element). -->
    <Border x:Name="PillBorder" CornerRadius="9" BorderThickness="1"
            Padding="8,2" Cursor="Hand"
            MouseLeftButtonUp="Pill_MouseLeftButtonUp">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource SteelLineSoftBrush}"/>
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <!-- Tooltip carries the untruncated name (slot-card precedent). -->
        <Border.ToolTip>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Profiles_ActiveProfile, Source={x:Static strings:Strings.Instance}}" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding ActiveProfileInfo}"/>
            </StackPanel>
        </Border.ToolTip>
        <StackPanel Orientation="Horizontal">
            <!-- The active profile burns (#175): same lit flame as the
                 Profiles-page header. Always lit, so the glow is static. -->
            <Path Data="{StaticResource FlameOuterGeometry}"
                  Fill="{DynamicResource EmberBrush}"
                  Width="10" Height="12" Stretch="Uniform"
                  VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBlock Text="{Binding ActiveProfileInfo}"
                       FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       MaxWidth="140" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
