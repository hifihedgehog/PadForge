                                                  SpinButtonPlacementMode="Inline" Width="200"/>
                                    <reset:SettingResetButton Command="{Binding ResetRemoteLinkPortCommand}" SettingLabel="{Binding Dashboard_RemoteLinkPort, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,14,0,14"/>

