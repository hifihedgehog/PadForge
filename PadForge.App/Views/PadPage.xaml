                                                        <DataTrigger Binding="{Binding LeftTriggerRouteActivatorSelectedInput}" Value="{x:Null}">
                                                            <Setter Property="Text" Value="{Binding Common_Unassigned, Source={x:Static strings:Strings.Instance}}"/>
                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <ui:Button Command="{Binding LeftTriggerRouteActivatorRecordCommand}" Style="{StaticResource EmberIconButtonHot}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding LeftTriggerRouteActivatorRecordButtonIcon}" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource EmberBrush}"/>
                                        <ui:Button.ToolTip><TextBlock Text="{Binding LeftTriggerRouteActivatorRecordButtonText}"/></ui:Button.ToolTip>
                                    </ui:Button>
                                    <ui:Button Command="{Binding ResetLeftTriggerRouteActivatorCommand}" Style="{StaticResource ResetButton}" VerticalAlignment="Top"
                                            ToolTip="{Binding Pad_ResetTriggerRouteActivator, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Pad_TriggerRouting_ActivatorMode, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ComboBox SelectedValue="{Binding LeftTriggerRouteActivatorMode, Mode=TwoWay}" SelectedValuePath="Tag" MinWidth="220">
                                        <ComboBoxItem Content="{Binding Settings_GyroAimEngageMode_Hold, Source={x:Static strings:Strings.Instance}}" Tag="Hold"/>
                                        <ComboBoxItem Content="{Binding Settings_GyroAimEngageMode_Toggle, Source={x:Static strings:Strings.Instance}}" Tag="Toggle"/>
                                        <ComboBoxItem Content="{Binding Pad_TriggerRouting_ActivatorMode_AlwaysOn, Source={x:Static strings:Strings.Instance}}" Tag="AlwaysOn"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding ResetLeftTriggerRouteActivatorModeCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTriggerRouteActivatorMode, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- ─── Right trigger ─── -->
                                <TextBlock Text="{Binding Pad_TriggerRouting_RightTrigger, Source={x:Static strings:Strings.Instance}}"
                                           FontWeight="SemiBold" Margin="0,12,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Pad_TriggerRouting_Source, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ComboBox SelectedValue="{Binding RightTriggerRouteSource, Mode=TwoWay}" SelectedValuePath="Tag" MinWidth="220">
                                        <ComboBoxItem Content="{Binding Pad_TriggerRouting_Source_None, Source={x:Static strings:Strings.Instance}}" Tag="None"/>
                                        <ComboBoxItem Content="{Binding Pad_TriggerRouting_Source_MainLeft, Source={x:Static strings:Strings.Instance}}" Tag="MainLeft"/>
                                        <ComboBoxItem Content="{Binding Pad_TriggerRouting_Source_MainRight, Source={x:Static strings:Strings.Instance}}" Tag="MainRight"/>
                                        <ComboBoxItem Content="{Binding Pad_TriggerRouting_Source_MaxOfBoth, Source={x:Static strings:Strings.Instance}}" Tag="MaxOfBoth"/>
                                        <ComboBoxItem Content="{Binding Pad_TriggerRouting_Source_SumOfBoth, Source={x:Static strings:Strings.Instance}}" Tag="SumOfBoth"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding ResetRightTriggerRouteSourceCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTriggerRouteSource, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Pad_TriggerRouting_Mode, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ComboBox SelectedValue="{Binding RightTriggerRouteMode, Mode=TwoWay}" SelectedValuePath="Tag" MinWidth="220">
                                        <ComboBoxItem Content="{Binding Pad_TriggerRouting_Mode_Off, Source={x:Static strings:Strings.Instance}}" Tag="Off"/>
                                        <ComboBoxItem Content="{Binding Pad_TriggerRouting_Mode_Duplicate, Source={x:Static strings:Strings.Instance}}" Tag="Duplicate"/>
                                        <ComboBoxItem Content="{Binding Pad_TriggerRouting_Mode_Redirect, Source={x:Static strings:Strings.Instance}}" Tag="Redirect"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding ResetRightTriggerRouteModeCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTriggerRouteMode, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Pad_TriggerRouting_Scale, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding RightTriggerRouteScale, Mode=TwoWay}" Minimum="0" Maximum="200"
                                            SmallChange="1" LargeChange="10" Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding RightTriggerRouteScale, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="%" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <ui:Button Command="{Binding ResetRightTriggerRouteScaleCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTriggerRouteScale, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Pad_TriggerRouting_Activator, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource DzLabel}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                    <StackPanel Orientation="Vertical">
                                        <ComboBox ItemsSource="{Binding SlotAvailableInputsView}"
                                                  SelectedItem="{Binding RightTriggerRouteActivatorSelectedInput, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName" MinWidth="220" Padding="4,2">
                                            <ComboBox.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,3,6,3">
                                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ComboBox.GroupStyle>
                                        </ComboBox>
                                        <TextBlock FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="4,1,0,0" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding RightTriggerRouteActivatorSelectedInput.DeviceLabel}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RightTriggerRouteActivatorSelectedInput}" Value="{x:Null}">
                                                            <Setter Property="Text" Value="{Binding Common_Unassigned, Source={x:Static strings:Strings.Instance}}"/>
                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <ui:Button Command="{Binding RightTriggerRouteActivatorRecordCommand}" Style="{StaticResource EmberIconButtonHot}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding RightTriggerRouteActivatorRecordButtonIcon}" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource EmberBrush}"/>
                                        <ui:Button.ToolTip><TextBlock Text="{Binding RightTriggerRouteActivatorRecordButtonText}"/></ui:Button.ToolTip>
                                    </ui:Button>
                                    <ui:Button Command="{Binding ResetRightTriggerRouteActivatorCommand}" Style="{StaticResource ResetButton}" VerticalAlignment="Top"
