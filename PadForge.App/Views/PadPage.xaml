                                                           VerticalAlignment="Center" Width="80" Margin="0,0,8,0" TextWrapping="Wrap"/>
                                                <ComboBox SelectedIndex="{Binding StopwatchActionIndex, Mode=TwoWay}" Width="180" VerticalAlignment="Center"
                                                          AutomationProperties.Name="{Binding Macro_Stopwatch_Action, Source={x:Static strings:Strings.Instance}}">
