                                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Slider AutomationProperties.Name="{Binding MacroAction_Type_GuideLedBrightness, Source={x:Static strings:Strings.Instance}}" Value="{Binding GuideLedPercent, Mode=TwoWay}" Minimum="0" Maximum="100"
                                                        Width="180" VerticalAlignment="Center"/>
                                                <TextBox AutomationProperties.Name="{Binding MacroAction_Type_GuideLedBrightness, Source={x:Static strings:Strings.Instance}}" Text="{Binding GuideLedPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="%" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="GuideLedPercent" SettingLabel="{Binding Macro_GuideLedBrightnessName, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_GuideLedPercent_2729"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Rumble card (Reactive | Sticky). Shared by the main-motor
                                         Rumble action and the trigger-channel RumbleTrigger action
                                         (#102). The header title switches per action type. -->
