<views:DialogWindow common:Reach.Class="UsersOwn" AutomationProperties.IsDialog="True" x:Class="PadForge.Views.DownloadFromDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        xmlns:common="clr-namespace:PadForge.Common"
        xmlns:controls="clr-namespace:PadForge.Controls"
        xmlns:views="clr-namespace:PadForge.Views"
        IsWide="True"
        Title="{Binding ControllerDatabase_DownloadFrom, Source={x:Static strings:Strings.Instance}}">

    <!-- Download From's Change… (#600 item 49): one box for the address
         Update Now downloads the controller database from. The dialog is
         the user's alone, as the line that opens it is, so no program sets
         the source. OK takes only an address PadForge takes, and the line
         under the box says why one was not taken. -->
    <views:DialogWindow.Foot>
        <controls:FlexLinePanel Style="{StaticResource DialogFootPanel}">
            <Button Style="{StaticResource DialogButton}" IsCancel="True"
                    Content="{Binding Common_Cancel, Source={x:Static strings:Strings.Instance}}"/>
            <Button x:Name="OkButton" Style="{StaticResource DialogPrimaryButton}" IsDefault="True"
                    Content="{Binding Common_OK, Source={x:Static strings:Strings.Instance}}"
                    Click="Ok_Click"/>
        </controls:FlexLinePanel>
    </views:DialogWindow.Foot>

    <StackPanel>
        <ui:TextBox x:Name="AddressBox" Style="{StaticResource DialogTextBox}" common:InitialFocus.First="True"
                    AutomationProperties.Name="{Binding ControllerDatabase_DownloadFromBox, Source={x:Static strings:Strings.Instance}}"
                    PlaceholderText="{Binding ControllerDatabase_DownloadFromBox, Source={x:Static strings:Strings.Instance}}"
                    TextChanged="AddressBox_TextChanged"/>
        <!-- Why the address was not taken. -->
        <TextBlock x:Name="ErrorText" common:LiveText.Polite="True" Margin="0,10,0,0" FontSize="13" TextWrapping="Wrap"
                   Foreground="{DynamicResource WaitBrush}" Visibility="Collapsed"
                   Text="{Binding ControllerDatabase_DownloadFromRule, Source={x:Static strings:Strings.Instance}}"/>
        <TextBlock Style="{StaticResource DialogNote}" Margin="0,10,0,0"
                   Text="{Binding ControllerDatabase_DownloadFromNote, Source={x:Static strings:Strings.Instance}}"/>
    </StackPanel>
</views:DialogWindow>
