<UserControl x:Class="PadForge.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:common="clr-namespace:PadForge.Common"
             xmlns:vm="clr-namespace:PadForge.ViewModels"
             xmlns:strings="clr-namespace:PadForge.Resources.Strings"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="po"
             xmlns:reset="clr-namespace:PadForge.Controls"
             xmlns:controls="clr-namespace:PadForge.Controls">

    <UserControl.Resources>
        <!-- Hover glow (#175): every hover color change carries a glow in
             the hue the element turns. Ember hovers bloom ember; neutral
             steel hovers carry the faint ember signature. Frozen shared
             static effects, set from triggers only, never animated. -->
        <DropShadowEffect x:Key="EmberHoverGlow" po:Freeze="True" Color="#FF6B2C" ShadowDepth="0" BlurRadius="12" Opacity="0.45"/>
        <DropShadowEffect x:Key="NeutralHoverGlow" po:Freeze="True" Color="#FF6B2C" ShadowDepth="0" BlurRadius="10" Opacity="0.30"/>

        <!-- Type-switch button style: transparent bg, dark gray hover, rounded corners -->
        <Style x:Key="TypeSwitchButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Hover glow (#175): neutral steel hover, faint ember bloom.
                     First in the list so derived state triggers (active seg
                     tile ember glow, cold-card Effect=x:Null fallback) win
                     while their state holds. -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Hover glow sweep (#175): stock-chrome classes bloom in the same
             moment their hover fill shifts. BasedOn the WPF-UI defaults so
             theme brushes survive. -->
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <!-- MinHeight mirrors the App.xaml implicit Button style (32px
                 grid), which this page-local implicit replaces. -->
            <Setter Property="MinHeight" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ui:Button" BasedOn="{StaticResource DefaultUiButtonStyle}">
            <!-- PadUiButtonTemplate: the App.xaml pressed-foreground fix.
                 Page-local implicits replace the app implicit, so the
                 Template setter rides along here too. -->
            <Setter Property="Template" Value="{StaticResource PadUiButtonTemplate}"/>
            <Style.Triggers>
                <!-- Neutral first; the Primary accent rides the ember ramp,
                     so its MultiTrigger sits later and wins on hover. -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="Appearance" Value="Primary"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Effect" Value="{StaticResource EmberHoverGlow}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <!-- Stage ledger glyphs (#175 item 10): ember when the stage
             carries a non-default configuration, ashen steel when inert.
             Font stages (gyro / lighting / touchpad / audio) share the
             text style; the Zacksly stick / trigger shapes share the
             path style. -->
        <Style x:Key="StageGlyphText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHot}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource EmberBrush}"/>
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StageGlyphShape" TargetType="Path">
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHot}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Glow bleed (#175 clip report 2026-07-06): ScrollViewer.Padding sits
         OUTSIDE the scroll clip (Wpf.Ui ScrollViewer.xaml wraps the
         ScrollContentPresenter in a grid whose Margin is the Padding), so
         the slot-card glows died 8px past the card: only the item margin
         lay inside the clip, and the 24px page gutter was dead space. The
         gutter moves onto the scrolled StackPanel instead: content keeps
         the identical 24px inset, but the clip edge now sits at the viewer
         bounds, giving edge cards 24+8 = 32px of aura room per side
         (BlurRadius 30). -->
    <!-- Home (#574), top to bottom: the engine, the offer for a device that
         is connected and not in use, the virtual controllers, and the extras
         that are on. HomePage.xaml.cs raises what a click asks for, and
         MainWindow answers. -->
    <ScrollViewer AutomationProperties.Name="{Binding Home_Title, Source={x:Static strings:Strings.Instance}}">
        <StackPanel Margin="24,16,24,16">

            <!-- Page header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <reset:GlyphText Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="HomeTitle" AutomationProperties.HeadingLevel="Level1" Text="{Binding Home_Title, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource TitleTextBlockStyle}" FontFamily="{StaticResource DisplayFontFamily}" FontWeight="650" FontSize="26" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>

            <!-- ═══ The engine ═══
                 One card with no heading over it: its own first line says
                 what it is. The flame is the switch it always was, and the
                 worded button beside the rate is the same switch for someone
                 who has not learned the flame. -->
            <Border x:Name="EngineCard" Padding="16,14" Margin="0,0,0,12">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                        <Style.Triggers>
                            <!-- The forge glows while it burns (#175). -->
                            <DataTrigger Binding="{Binding EngineStateKey}" Value="Running">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF6B2C" BlurRadius="20" ShadowDepth="0" Opacity="0.16"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <!-- Content cached (perf, 2026-07-15): the engine card's rim
                     effect sits on the Border above; caching the content Grid
                     keeps per-frame repaints (from any dirty rect that crosses
                     this card) as texture blits instead of re-rasterizing the
                     flame path and status glyphs. Status text changes re-render
                     the cache once, which is the cheap direction. -->
                <Grid CacheMode="BitmapCache">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Engine flame toggle (#175): the forge is lit or it is
                         not. Ember = running, gold = idle or stopping (flash),
                         outline = stopped. TypeSwitchButton chrome gives it
                         the same hover fill + NeutralHoverGlow the slot power
                         flames wear, and the tooltip mirrors their state-aware
                         pattern (#175 phase 2 item 3). -->
                    <controls:StateToggleButton x:Name="EngineFlame" IsOn="{Binding IsEngineOn}" Padding="2" VerticalAlignment="Center"
                            Width="40" Height="40"
                            Click="EngineToggle_Click" Margin="0,0,12,0"
                            AutomationProperties.Name="{Binding Dashboard_InputEngine, Source={x:Static strings:Strings.Instance}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TypeSwitchButton}">
                                <!-- Default = stopped, like the slot flame's
                                     default = disabled. -->
                                <Setter Property="ToolTip" Value="{Binding Dashboard_EngineFlame_Stopped, Source={x:Static strings:Strings.Instance}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EngineStateKey}" Value="Running">
                                        <Setter Property="ToolTip" Value="{Binding Dashboard_EngineFlame_Running, Source={x:Static strings:Strings.Instance}}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EngineStateKey}" Value="Idle">
                                        <Setter Property="ToolTip" Value="{Binding Dashboard_EngineFlame_Idle, Source={x:Static strings:Strings.Instance}}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EngineStateKey}" Value="Stopping">
                                        <Setter Property="ToolTip" Value="{Binding Common_Stopping, Source={x:Static strings:Strings.Instance}}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path FlowDirection="LeftToRight" Data="{StaticResource FlameOuterGeometry}"
                              Width="20" Height="20" Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="Transparent"/>
                                    <Setter Property="Stroke" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <Setter Property="StrokeThickness" Value="1.3"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EngineStateKey}" Value="Running">
                                            <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                            <Setter Property="Stroke" Value="{x:Null}"/>
                                            <!-- Glow sweep (#175): lit blooms. Static effect only. -->
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#FF6B2C" BlurRadius="12" ShadowDepth="0" Opacity="0.5"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EngineStateKey}" Value="Idle">
                                            <Setter Property="Fill" Value="{DynamicResource WaitBrush}"/>
                                            <Setter Property="Stroke" Value="{x:Null}"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#E8B434" BlurRadius="8" ShadowDepth="0" Opacity="0.35"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <!-- Stopping: gold, flashing (mirrors the
                                             slot-card igniting flash style). -->
                                        <DataTrigger Binding="{Binding EngineStateKey}" Value="Stopping">
                                            <Setter Property="Fill" Value="{DynamicResource WaitBrush}"/>
                                            <Setter Property="Stroke" Value="{x:Null}"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#E8B434" BlurRadius="8" ShadowDepth="0" Opacity="0.35"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <!-- Reduced motion (#175 item 98): the flash loop only
                                             runs when Windows animations are on. Off, the flame
                                             holds steady gold from the setters above. -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding EngineStateKey}" Value="Stopping"/>
                                                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="FlashGoldStoryboard">
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="Opacity"
                                                            From="1.0" To="0.15"
                                                            Duration="0:0:0.5"
                                                            AutoReverse="True"
                                                            RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="FlashGoldStoryboard"/>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </controls:StateToggleButton>

                    <!-- The engine's state, and under it how many of the known
                         devices are connected. -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="EngineStatusLine" common:LiveText.Polite="True" Text="{Binding EngineStatus}"
                                   FontSize="16" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <!-- Forging reads hot (#175). -->
                                        <DataTrigger Binding="{Binding EngineStateKey}" Value="Running">
                                            <Setter Property="Foreground" Value="{DynamicResource EmberHotBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel x:Name="EngineDevicesLine" Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Foreground="{DynamicResource ColdBrush}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12" Text="{Binding OnlineDevices, Mode=OneWay}"/>
                            <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12" Text="/"/>
                            <TextBlock Foreground="{DynamicResource ColdBrush}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12" Text="{Binding TotalDevices, Mode=OneWay}"/>
                            <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12" Text="{Binding Dashboard_DevicesOnline, Source={x:Static strings:Strings.Instance}}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="24,0,16,0"
                               Foreground="{DynamicResource ColdBrush}"
                               FontFamily="{StaticResource TelemetryFontFamily}"
                               Text="{Binding PollingFrequencyText, Mode=OneWay}"/>

                    <!-- Start or Stop in words. It raises the click the flame
                         raises and wears the flame's tooltips. -->
                    <Button x:Name="EngineButton" Grid.Column="3" VerticalAlignment="Center" MinWidth="76"
                            Content="{Binding EngineButtonText}"
                            Click="EngineToggle_Click"
                            AutomationProperties.AutomationId="Home_EngineButton">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="ToolTip" Value="{Binding Dashboard_EngineFlame_Stopped, Source={x:Static strings:Strings.Instance}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EngineStateKey}" Value="Running">
                                        <Setter Property="ToolTip" Value="{Binding Dashboard_EngineFlame_Running, Source={x:Static strings:Strings.Instance}}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EngineStateKey}" Value="Idle">
                                        <Setter Property="ToolTip" Value="{Binding Dashboard_EngineFlame_Idle, Source={x:Static strings:Strings.Instance}}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EngineStateKey}" Value="Stopping">
                                        <Setter Property="ToolTip" Value="{Binding Common_Stopping, Source={x:Static strings:Strings.Instance}}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- ═══ The offer ═══
                 A device PadForge has just met that is connected and on no
                 virtual controller (Settings > Assignment Prompts). It is
                 the pad page's offer band in Home's words: Use It opens the
                 type bar under its own button, and the controller it makes
                 takes the device. Not Now ends the offer for that device for
                 good. Nothing happens without a click. The band and its dot
                 are gold, the color of something that waits, where the pad
                 page's band is ember because it sits on a slot. -->
            <Border x:Name="HomeOffer" Margin="0,0,0,12" Padding="14,8,12,8" CornerRadius="6"
                    Background="#1AE8B434" BorderThickness="1"
                    Visibility="{Binding HasHomeOffer, Converter={StaticResource BoolToVisibilityConverter}}"
                    AutomationProperties.AutomationId="HomeOffer">
                <Border.BorderBrush>
                    <SolidColorBrush Color="#4DE8B434"/>
                </Border.BorderBrush>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="10" Height="10" Fill="{DynamicResource WaitBrush}"
                             VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="HomeOfferLine" Grid.Column="1" common:LiveText.Polite="True"
                               Text="{Binding HomeOfferText}"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:Button x:Name="HomeOfferUse" Grid.Column="2" MinWidth="90" Margin="12,0,8,0"
                               Style="{StaticResource EmberPrimaryButton}"
                               Click="HomeOfferUse_Click"
                               Content="{Binding Home_Offer_Use, Source={x:Static strings:Strings.Instance}}"
                               AutomationProperties.AutomationId="HomeOfferUse"/>
                    <ui:Button x:Name="HomeOfferDismiss" Grid.Column="3" MinWidth="90"
                               Command="{Binding DismissHomeOfferCommand}"
                               Content="{Binding Pad_AssignOffer_Dismiss, Source={x:Static strings:Strings.Instance}}"
                               AutomationProperties.AutomationId="HomeOfferDismiss"/>
                </Grid>
            </Border>

            <!-- ═══ The virtual controllers ═══ -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                <reset:GlyphText Text="&#xE7FC;" Style="{StaticResource SectionGlyph}"/>
                <TextBlock x:Name="ControllersHeading" Text="{Binding Home_Controllers, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}" Style="{StaticResource SectionTitle}"/>
            </StackPanel>

            <ItemsControl x:Name="SlotsItemsControl">
                <!-- Slot cards + the Add Controller tile share one wrap flow
                     (#175 phase 2 item 3): the tile rides the same panel as
                     the cards via a CompositeCollection. CollectionContainer
                     sits outside the visual tree, so code-behind hands it
                     SlotSummaries directly (DataContextChanged). The tile is
                     a UIElement item, so the SlotSummary ItemTemplate never
                     touches it, and the drag/reorder code skips it (no int
                     Tag, not a SlotSummary). -->
                <ItemsControl.ItemsSource>
                    <CompositeCollection>
                        <CollectionContainer x:Name="SlotsCollectionContainer"/>

                        <!-- Add Controller tile: slot-card footprint, dashed
                             steel outline (Border can't dash, the Rectangle
                             wears the stroke), plus glyph + label centered.
                             Same click handler and hover lift as the old
                             full-width band it replaces. -->
                        <Grid Margin="8"
                              Visibility="{Binding ShowAddController, Converter={StaticResource BoolToVisibilityConverter}}"
                              AutomationProperties.Name="{Binding Main_AddController, Source={x:Static strings:Strings.Instance}}">
                            <reset:ClickBorder x:Name="AddControllerCard"
                                    Width="252" MinHeight="132"
                                    Background="Transparent" CornerRadius="8"
                                    Cursor="Hand" Click="AddControllerCard_Click">
                                <Border.RenderTransform>
                                    <TranslateTransform/>
                                </Border.RenderTransform>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <!-- Hover glow + lift (#175): faint ember,
                                                 static effect; only the transform
                                                 animates. -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                             To="-2" Duration="0:0:0.13">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                             To="0" Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseIn"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Rectangle RadiusX="8" RadiusY="8"
                                               Stroke="{DynamicResource SteelLineBrush}"
                                               StrokeThickness="1.5" StrokeDashArray="4 3"
                                               SnapsToDevicePixels="True"/>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <reset:GlyphText Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock Text="{Binding Main_AddController, Source={x:Static strings:Strings.Instance}}"
                                                   FontSize="13" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </reset:ClickBorder>
                        </Grid>
                    </CompositeCollection>
                </ItemsControl.ItemsSource>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Resources>
                    <!-- Implicit, typed template rather than an explicit
                         ItemTemplate: the CompositeCollection mixes
                         SlotSummary cards with the UIElement Add tile, and
                         an explicit ItemTemplate makes WPF log an
                         error-level trace for the UIElement item on every
                         launch. Typed to SlotSummary, this template never
                         claims the tile and the log stays clean. -->
                    <DataTemplate DataType="{x:Type vm:SlotSummary}">
                        <!-- 8px item margin (#175 clip report): the card glows
                             (hover 12px, forging host 30px) were truncated at
                             the viewport clip when a card sat at a row edge. -->
                        <Grid Margin="8">
                            <!-- Heat that rises fast and cools slow (#175 motion
                                 spec, overlay pattern): the glow host behind the
                                 card carries the effect, its plain Opacity
                                 animates. 300ms ease-out up, 1200ms ease-in down.
                                 One-shot storyboards, no Forever loops. -->
                            <!-- BitmapCache wrap (perf, 2026-07-15): the Grid is
                                 the cache root and the storyboards' target; the
                                 effect-bearing Border inside renders its blur-30
                                 ONCE into the cache. The previous shape animated
                                 the effect-bearing element's own Opacity, which
                                 is a DEPENDENT animation: every tick re-rendered
                                 the whole card-sized blur intermediate, measured
                                 at ~17% of one core PER CONNECTED CARD (isolated
                                 probe, shapes K vs N). The storyboards below are
                                 untouched; their pathless "Opacity" now lands on
                                 this cache root, whose alpha is applied to the
                                 cached texture instead of re-blurring. -->
                            <Grid IsHitTestVisible="False" Opacity="0">
                                <Grid.CacheMode>
                                    <BitmapCache/>
                                </Grid.CacheMode>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                                    <Condition Binding="{Binding HasMappedDevices}" Value="True"/>
                                                    <Condition Binding="{Binding IsVirtualControllerConnected}" Value="True"/>
                                                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
                                                    <!-- Ambient gate (2026-07-16): a permanent breathe pays WPF's
                                                         fixed per-frame pipeline cost (~18% of a core at 60fps,
                                                         isolated measurement) even when the app is behind a game.
                                                         Backgrounded, the ExitActions ease the aura to its static
                                                         0.5 glow; re-activation restarts the breathe. -->
                                                    <Condition Binding="{Binding IsAppActive, Source={x:Static common:AmbientMotionProbe.Instance}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <!-- 30fps on the STORYBOARD: WPF consults DesiredFrameRate
                                                             only on the root of a clock tree, so setting it on the
                                                             child animation is a silent no-op. A soft opacity fade
                                                             has no spatial motion, and every ambient animation
                                                             frame costs the same fixed pipeline work (gate note
                                                             above). -->
                                                        <Storyboard Timeline.DesiredFrameRate="30">
                                                            <!-- Artifact breathe: 3.2s ease-in-out shadow pulse. -->
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="0.55" To="1.0" Duration="0:0:1.6"
                                                                             AutoReverse="True" RepeatBehavior="Forever">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <SineEase EasingMode="EaseInOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:1.2">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseIn"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>
                                            <!-- Reduced motion (#175 item 98): breathe swaps for a
                                                 static glow. 0.74 host opacity x the 0.55 shadow
                                                 lands the spec's rgba(255,107,44,0.22) equivalent.
                                                 Zero-length animations, because the host's local
                                                 Opacity="0" outranks trigger setters. -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                                    <Condition Binding="{Binding HasMappedDevices}" Value="True"/>
                                                    <Condition Binding="{Binding IsVirtualControllerConnected}" Value="True"/>
                                                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.74" Duration="0:0:0"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>
                                            <!-- ORDER IS THE CONTRACT. All three
                                                 triggers animate this one Opacity, and
                                                 the last exit to begin decides where it
                                                 rests. An unassign raises HasMappedDevices
                                                 before IsVirtualControllerConnected, so
                                                 with this trigger declared first its exit
                                                 to 0 ran and the connected exit to 0.5
                                                 landed after it, leaving a warm glow on a
                                                 card with no devices. The cold exit is
                                                 declared LAST so it wins, and the two
                                                 connected triggers below now carry the
                                                 same fuel conditions so every exit fires
                                                 on one notification rather than across
                                                 ticks. -->
                                            <!-- Heat requires fuel (#175): the enable glow
                                                 only ignites once devices are mapped. -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                                    <Condition Binding="{Binding HasMappedDevices}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.3">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:1.2">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseIn"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Border CornerRadius="8"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#FF6B2C" BlurRadius="30" ShadowDepth="0" Opacity="0.55"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        <!-- Content cached as a texture (perf, 2026-07-15): the
                             breathing aura behind this card dirties the card's
                             rect every frame, and WPF repaints everything the
                             rect covers. Profiled: per-frame re-rasterization
                             of every icon path plus a DropShadow pipeline run
                             per glyph glow. Cached, that repaint is a blit;
                             the cache re-renders only when the card's own
                             content actually changes. -->
                        <!-- The cache root wraps the card from OUTSIDE so the
                             heat-rim Effect (trigger-set on the Border below)
                             renders INTO the cache. A CacheMode on the same
                             node as an Effect is ignored for the effect path
                             (WpfGfx rule), which left the rim's pipeline and
                             the card's rounded-rect chrome re-running every
                             frame under the aura's dirty rect. -->
                        <Grid CacheMode="BitmapCache">
                        <Border Background="{DynamicResource CrucibleCardBrush}"
                                CornerRadius="8" Padding="10"
                                BorderThickness="2"
                                Width="252"
                                Cursor="Hand"
                                Tag="{Binding PadIndex}"
                                Loaded="SlotCard_Loaded"
                                ToolTip="{Binding Dashboard_SlotCard_Configure, Source={x:Static strings:Strings.Instance}}"
                                ToolTipService.InitialShowDelay="600">
                            <!-- Hover lift (#175): element-level transform so the
                                 trigger storyboard animates a per-card instance. -->
                            <Border.RenderTransform>
                                <TranslateTransform/>
                            </Border.RenderTransform>
                            <!-- Heat states (#175 pitch): cold = steel line,
                                 awaiting devices = faint warm rim, forging =
                                 ember rim. The glow host behind matches with
                                 its 0 / 0.5 / 1.0 opacity ladder. -->
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource SteelLineBrush}"/>
                                    <Style.Triggers>
                                        <!-- Hover glow + lift (#175): the whole card is a
                                             Cursor=Hand click/drag zone, so hovering blooms
                                             ember and the card lifts 2px to invite the grab.
                                             Static effect; only the transform animates. -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Effect" Value="{StaticResource EmberHoverGlow}"/>
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                         To="-2" Duration="0:0:0.13">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                         To="0" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseIn"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <!-- Persistent selection bloom: the card whose pad
                                             page is in focus wears the same ember hover glow
                                             at rest, so the selected card reads as clearly as
                                             a hover. Declared after the hover trigger so both
                                             resolve to the same ember effect (no fight). -->
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Effect" Value="{StaticResource EmberHoverGlow}"/>
                                        </DataTrigger>
                                        <!-- Pure cold: nothing mapped, card recedes. -->
                                        <DataTrigger Binding="{Binding HasMappedDevices}" Value="False">
                                            <Setter Property="Opacity" Value="0.72"/>
                                        </DataTrigger>
                                        <!-- Warm rim only once devices are mapped (#175). -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                                <Condition Binding="{Binding HasMappedDevices}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="BorderBrush" Value="#2EFF6B2C"/>
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding IsVirtualControllerConnected}" Value="True">
                                            <Setter Property="BorderBrush" Value="#8CFF6B2C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: [Flame] [Type chip] Type name #N ... [X] -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                    <!-- Power button -->
                                    <controls:StateToggleButton AutomationProperties.Name="{Binding Common_Enabled, Source={x:Static strings:Strings.Instance}}" IsOn="{Binding IsEnabled}" Click="PowerToggle_Click" Tag="{Binding PadIndex}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource TypeSwitchButton}">
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="ToolTip" Value="{Binding Common_Disabled, Source={x:Static strings:Strings.Instance}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                        <Setter Property="ToolTip" Value="{Binding Main_Active, Source={x:Static strings:Strings.Instance}}"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                                            <Condition Binding="{Binding IsVirtualControllerConnected}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="ToolTip" Value="{Binding Main_AwaitingDevices, Source={x:Static strings:Strings.Instance}}"/>
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                                            <Condition Binding="{Binding DataContext.EngineStateKey, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Stopped"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="ToolTip" Value="{Binding Main_EngineStopped, Source={x:Static strings:Strings.Instance}}"/>
                                                    </MultiDataTrigger>
                                                    <!-- Create failed: outranks awaiting-devices (a failed
                                                         create with online devices is not waiting) -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                                            <Condition Binding="{Binding IsCreateFailed}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="ToolTip" Value="{Binding Main_VcFailed, Source={x:Static strings:Strings.Instance}}"/>
                                                    </MultiDataTrigger>
                                                    <!-- Initializing: override tooltip -->
                                                    <DataTrigger Binding="{Binding IsInitializing}" Value="True">
                                                        <Setter Property="ToolTip" Value="{Binding Main_Initializing, Source={x:Static strings:Strings.Instance}}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Path FlowDirection="LeftToRight" Data="{StaticResource FlameOuterGeometry}"
                                              Width="12" Height="12" Stretch="Uniform">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <!-- Default: cold outline (disabled) (#175) -->
                                                    <Setter Property="Fill" Value="Transparent"/>
                                                    <Setter Property="Stroke" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <Setter Property="StrokeThickness" Value="1.2"/>
                                                    <Style.Triggers>
                                                        <!-- Enabled + devices mapped: ember (forging).
                                                             Enabled-but-empty stays the cold outline (#175):
                                                             heat requires fuel. -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                                                <Condition Binding="{Binding HasMappedDevices}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                                            <Setter Property="Stroke" Value="{x:Null}"/>
                                                            <!-- Glow sweep (#175): lit blooms. Static effect only. -->
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="#FF6B2C" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </MultiDataTrigger>
                                                        <!-- Enabled + mapped but no live VC: gold (awaiting
                                                             devices). During the HM-inactivity grace period
                                                             the VC stays alive even with devices offline, so
                                                             the flame stays ember until the timeout actually
                                                             fires and tears the VC down. -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                                                <Condition Binding="{Binding HasMappedDevices}" Value="True"/>
                                                                <Condition Binding="{Binding IsVirtualControllerConnected}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Fill" Value="{DynamicResource WaitBrush}"/>
                                                            <Setter Property="Stroke" Value="{x:Null}"/>
                                                            <!-- Cooling gold holds a faint glow (#175 glow sweep). -->
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="#E8B434" BlurRadius="8" ShadowDepth="0" Opacity="0.35"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </MultiDataTrigger>
                                                        <!-- Enabled + mapped but engine stopped: gold -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                                                <Condition Binding="{Binding HasMappedDevices}" Value="True"/>
                                                                <Condition Binding="{Binding DataContext.EngineStateKey, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Stopped"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Fill" Value="{DynamicResource WaitBrush}"/>
                                                            <Setter Property="Stroke" Value="{x:Null}"/>
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="#E8B434" BlurRadius="8" ShadowDepth="0" Opacity="0.35"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </MultiDataTrigger>
                                                        <!-- Igniting: flashing ember -->
                                                        <DataTrigger Binding="{Binding IsInitializing}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                                            <Setter Property="Stroke" Value="{x:Null}"/>
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="#FF6B2C" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                        <!-- Reduced motion (#175 item 98): no flash loop,
                                                             the flame holds steady ember instead. -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsInitializing}" Value="True"/>
                                                                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <MultiDataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="FlashEmberStoryboard">
                                                                    <Storyboard>
                                                                        <DoubleAnimation
                                                                            Storyboard.TargetProperty="Opacity"
                                                                            From="1.0" To="0.15"
                                                                            Duration="0:0:0.5"
                                                                            AutoReverse="True"
                                                                            RepeatBehavior="Forever"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </MultiDataTrigger.EnterActions>
                                                            <MultiDataTrigger.ExitActions>
                                                                <StopStoryboard BeginStoryboardName="FlashEmberStoryboard"/>
                                                            </MultiDataTrigger.ExitActions>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </controls:StateToggleButton>

                                    <!-- The type chip (discussion #543). The
                                         seven-tile segment stood here once, and a
                                         stray click on it changed the type outright.
                                         The chip is that segment's active tile on
                                         its own, with the same ember and the same
                                         steel on a cold card. A click on it opens
                                         the type bar Add Controller uses, under the
                                         card. -->
                                    <Button Margin="7,0,0,0"
                                            Click="TypeChip_Click" Tag="{Binding PadIndex}"
                                            AutomationProperties.AutomationId="Dash_SlotTypeChip">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource TypeSwitchButton}">
                                                <Setter Property="Padding" Value="5,3"/>
                                                <Setter Property="Foreground" Value="#FFFFF3E8"/>
                                                <Setter Property="Background" Value="{DynamicResource EmberSegGradient}"/>
                                                <Setter Property="ToolTip" Value="{Binding ControllerType_Xbox, Source={x:Static strings:Strings.Instance}}"/>
                                                <Setter Property="AutomationProperties.Name" Value="{Binding ControllerType_Xbox, Source={x:Static strings:Strings.Instance}}"/>
                                                <!-- The sidebar chip's look (owner, 2026-10-30): no
                                                     glow at rest, and on hover the color holds, so the
                                                     chip keeps showing the slot's type, while
                                                     TypeSwitchButton's subtle glow says it can be
                                                     clicked. That template swaps the fill on hover and
                                                     press, so the chip draws its own. -->
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <!-- The type's name, live across a culture
                                                         change, as each tile carried it. -->
                                                    <DataTrigger Binding="{Binding OutputType}" Value="PlayStation">
                                                        <Setter Property="ToolTip" Value="{Binding ControllerType_PlayStation, Source={x:Static strings:Strings.Instance}}"/>
                                                        <Setter Property="AutomationProperties.Name" Value="{Binding ControllerType_PlayStation, Source={x:Static strings:Strings.Instance}}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding OutputType}" Value="Nintendo">
                                                        <Setter Property="ToolTip" Value="{Binding ControllerType_Nintendo, Source={x:Static strings:Strings.Instance}}"/>
                                                        <Setter Property="AutomationProperties.Name" Value="{Binding ControllerType_Nintendo, Source={x:Static strings:Strings.Instance}}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding OutputType}" Value="Extended">
                                                        <Setter Property="ToolTip" Value="{Binding ControllerType_Extended, Source={x:Static strings:Strings.Instance}}"/>
                                                        <Setter Property="AutomationProperties.Name" Value="{Binding ControllerType_Extended, Source={x:Static strings:Strings.Instance}}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding OutputType}" Value="KeyboardMouse">
                                                        <Setter Property="ToolTip" Value="{Binding ControllerType_KeyboardMouse, Source={x:Static strings:Strings.Instance}}"/>
                                                        <Setter Property="AutomationProperties.Name" Value="{Binding ControllerType_KeyboardMouse, Source={x:Static strings:Strings.Instance}}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding OutputType}" Value="Midi">
                                                        <Setter Property="ToolTip" Value="{Binding ControllerType_MIDI, Source={x:Static strings:Strings.Instance}}"/>
                                                        <Setter Property="AutomationProperties.Name" Value="{Binding ControllerType_MIDI, Source={x:Static strings:Strings.Instance}}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding OutputType}" Value="Vr">
                                                        <Setter Property="ToolTip" Value="{Binding ControllerType_VR, Source={x:Static strings:Strings.Instance}}"/>
                                                        <Setter Property="AutomationProperties.Name" Value="{Binding ControllerType_VR, Source={x:Static strings:Strings.Instance}}"/>
                                                    </DataTrigger>
                                                    <!-- Cold card (0 mapped): the chip falls back to steel. -->
                                                    <DataTrigger Binding="{Binding HasMappedDevices}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <Setter Property="Background" Value="{DynamicResource SteelRaisedBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <!-- SlotTypeIconMap, shared with the Devices badges:
                                             the logo for the four vector types, the MDL2
                                             glyph for the other three. -->
                                        <Grid Margin="2,1">
                                            <Path FlowDirection="LeftToRight" Data="{Binding TypeGeometry, Mode=OneWay}" Width="13" Height="13"
                                                  Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            <reset:GlyphText Text="{Binding TypeGlyph, Mode=OneWay}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Visibility="{Binding TypeGlyph, Converter={StaticResource StringToVisibility}}"/>
                                        </Grid>
                                    </Button>
                                    <!-- The card's headline (#574): the type's name
                                         and which one of that type this is, where
                                         "Slot N" stood. The name wears CardTitle at
                                         14px, the compact card's scale. It trims
                                         where a long translation outgrows the row,
                                         and the chip beside it names the type in
                                         its tooltip. 126 is the row's 208 less the
                                         flame (18), the chip and its gap (34), the
                                         two gaps here (12) and "#16" (17.6,
                                         Cascadia @10). -->
                                    <TextBlock MaxWidth="126" TextTrimming="CharacterEllipsis" Margin="7,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CardTitle}">
                                                <Setter Property="FontSize" Value="14"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <Setter Property="Text" Value="{Binding ControllerType_Xbox, Source={x:Static strings:Strings.Instance}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OutputType}" Value="PlayStation">
                                                        <Setter Property="Text" Value="{Binding ControllerType_PlayStation, Source={x:Static strings:Strings.Instance}}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding OutputType}" Value="Nintendo">
                                                        <Setter Property="Text" Value="{Binding ControllerType_Nintendo, Source={x:Static strings:Strings.Instance}}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding OutputType}" Value="Extended">
                                                        <Setter Property="Text" Value="{Binding ControllerType_Extended, Source={x:Static strings:Strings.Instance}}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding OutputType}" Value="KeyboardMouse">
                                                        <Setter Property="Text" Value="{Binding ControllerType_KeyboardMouse, Source={x:Static strings:Strings.Instance}}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding OutputType}" Value="Midi">
                                                        <Setter Property="Text" Value="{Binding ControllerType_MIDI, Source={x:Static strings:Strings.Instance}}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding OutputType}" Value="Vr">
                                                        <Setter Property="Text" Value="{Binding ControllerType_VR, Source={x:Static strings:Strings.Instance}}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding TypeInstanceLabel, StringFormat={}#{0}}"
                                               FontFamily="{StaticResource TelemetryFontFamily}"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Center" Margin="5,0,0,0"/>
                                </StackPanel>

                                <!-- Row 1: the Preset (discussion #543), under the
                                     type as on the sidebar card. It trims at rest
                                     and scrolls while the pointer is on the card. -->
                                <controls:MarqueeLabel Grid.Row="1" Text="{Binding PresetName}"
                                                       Margin="0,6,0,0"
                                                       TextElement.FontSize="12"
                                                       TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Active="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ContentPresenter}}"/>

                                <!-- Delete button (upper-right corner). Hover-
                                     revealed (#175 phase 2 item 1a): opacity
                                     rides the card hover so the X never
                                     competes with the card face at rest, and
                                     keyboard focus brings it back for tab
                                     users. Stays focusable and hit-testable
                                     the whole time. Same treatment as the
                                     device list row X (maintainer report
                                     2026-07-06): the reveal watches the whole
                                     item container, the ItemsControl analogue
                                     of the ListBoxItem trigger there, not the
                                     nearest Border, which a future wrapper
                                     could silently hijack. The click routes
                                     through the shared confirm dialog in
                                     code-behind. -->
                                <ui:Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                           ToolTip="{Binding Main_DeleteVC, Source={x:Static strings:Strings.Instance}}"
                                           Click="DeleteSlot_Click" Tag="{Binding PadIndex}">
                                    <ui:Button.Style>
                                        <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource EmberIconButtonHot}">
                                            <Setter Property="Opacity" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </DataTrigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                    <reset:GlyphText Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </ui:Button>

                                <!-- Row 2: Device name (compact). Cold: the
                                     physical device feeding this slot (#175). -->
                                <Border Grid.Row="2" ClipToBounds="True" Margin="0,8,0,0">
                                    <!-- Edge fade (#175 round 3, made conditional
                                         2026-07-06): MarqueeBehavior now applies the
                                         transparency ramps to this clip ancestor ONLY
                                         while the content actually overflows and
                                         scrolls. The static mask here dimmed the edges
                                         of fully-legible text ("No device mapped"). -->
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Empty state only: roster below owns the mapped case.
                                             Tertiary, not cold (#175 item 74): cold is reserved
                                             for real hardware facts, and "no device" is not one. -->
                                        <TextBlock Text="{Binding DeviceName}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MappedDevices.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MappedDevices}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- Device roster (#175): name + dynamic battery glyph
                                             per mapped device, pipe separators, marquee when
                                             the roster outgrows the card. -->
                                        <ItemsControl ItemsSource="{Binding MappedDevices}"
                                                      AlternationCount="99"
                                                      common:MarqueeBehavior.IsEnabled="True"
                                                      ToolTipService.InitialShowDelay="400"
                                                      ToolTipService.ShowDuration="20000">
                                            <!-- Full roster on hover (#175 competitor item 9):
                                                 the marquee stays (user direction), the tooltip
                                                 shows every device untruncated, one per line. -->
                                            <ItemsControl.ToolTip>
                                                <ToolTip>
                                                    <ItemsControl ItemsSource="{Binding MappedDevices}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                    <!-- Same offline dim as the roster line (#175
                                                                         phase 2 item 14). -->
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                                    <Setter Property="Opacity" Value="0.5"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <!-- Same device-class glyph as the roster line (#175). -->
                                                                    <reset:GlyphText Text="{Binding TypeGlyph}"
                                                                               FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                    <TextBlock Text="{Binding Name}" FontSize="12">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource ColdBrush}"/>
                                                                                <Style.Triggers>
                                                                                    <!-- Cold is reserved for live hardware (#175):
                                                                                         offline names fall to tertiary. -->
                                                                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <reset:GlyphText Text="{Binding TransportGlyph}"
                                                                               FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                               VerticalAlignment="Center" Margin="5,0,0,0"
                                                                               Visibility="{Binding HasTransportGlyph, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                    <reset:GlyphText Text="{Binding BatteryGlyph}"
                                                                               FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                               Foreground="{DynamicResource ColdBrush}"
                                                                               VerticalAlignment="Center" Margin="6,0,0,0"
                                                                               Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                    <TextBlock Text="{Binding BatteryText}"
                                                                               FontFamily="{StaticResource TelemetryFontFamily}" FontSize="10.5"
                                                                               Foreground="{DynamicResource ColdBrush}" Opacity="0.85"
                                                                               VerticalAlignment="Center" Margin="3,0,0,0"
                                                                               Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ToolTip>
                                            </ItemsControl.ToolTip>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <!-- Offline dim (#175 phase 2 item 14): a disconnected
                                                             device's line drops to half opacity so it can't
                                                             read as live while the count says otherwise.
                                                             Opacity only; the marquee is untouched. -->
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                        <Setter Property="Opacity" Value="0.5"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBlock Text="  |  " FontSize="12"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <!-- Device-class glyph (#175): keyboards read as keyboards,
                                                             mice as mice (DeviceTypeGlyph vocabulary); rides inside
                                                             each roster item so it repeats per device. -->
                                                        <reset:GlyphText Text="{Binding TypeGlyph}"
                                                                   FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="12">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ColdBrush}"/>
                                                                    <Style.Triggers>
                                                                        <!-- Cold is reserved for live hardware (#175):
                                                                             offline names fall to tertiary. -->
                                                                        <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <!-- Transport (#175 competitor item 9): Bluetooth
                                                             links carry the E702 glyph, wired stays
                                                             unmarked. -->
                                                        <reset:GlyphText Text="{Binding TransportGlyph}"
                                                                   FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                   VerticalAlignment="Center" Margin="5,0,0,0"
                                                                   Visibility="{Binding HasTransportGlyph, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <reset:GlyphText Text="{Binding BatteryGlyph}"
                                                                   FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                   Foreground="{DynamicResource ColdBrush}"
                                                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                                                   Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <TextBlock Text="{Binding BatteryText}"
                                                                   FontFamily="{StaticResource TelemetryFontFamily}" FontSize="10.5"
                                                                   Foreground="{DynamicResource ColdBrush}" Opacity="0.85"
                                                                   VerticalAlignment="Center" Margin="3,0,0,0"
                                                                   Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Row 3: Status -->
                                <StackPanel Grid.Row="3" Orientation="Horizontal"
                                            Margin="0,2,0,0">
                                    <TextBlock common:LiveText.Polite="True" Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource WaitBrush}"/>
                                                    </DataTrigger>
                                                    <!-- Gold requires mappings (#175): enabled but
                                                         empty reads Cold in tertiary steel. -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                                            <Condition Binding="{Binding MappedDeviceCount}" Value="0"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    </MultiDataTrigger>
                                                    <DataTrigger Binding="{Binding IsVirtualControllerConnected}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource EmberHotBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- Middle-dot separator (#175 iter 71, artifact):
                                         "Forging · 2 mapped, 1 connected". -->
                                    <TextBlock Text="·" FontSize="11" Margin="5,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding MappedDeviceCount, Mode=OneWay}"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Dashboard_Mapped, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ConnectedDeviceCount, Mode=OneWay}"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Dashboard_Connected, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Row 4: pipeline stage ledger (#175 item 10).
                                     One tab glyph per configuration stage the
                                     slot's assigned devices actually have,
                                     mirroring the Pad page capability gates.
                                     Ember when the stage carries a non-default
                                     configuration, ashen steel when inert.
                                     Hover = per-device readout in the fan-in
                                     annotation idiom: mono value tokens, Body
                                     device suffix, one line per covered device
                                     (STOCK for the untouched ones). Wrapped so
                                     long readouts never clip at the screen
                                     edge. Inert stages carry no tooltip. -->
                                <ItemsControl Grid.Row="4" ItemsSource="{Binding StageLedger}"
                                              Margin="1,7,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,9,0" Background="Transparent"
                                                  ToolTipService.IsEnabled="{Binding HasSummary}"
                                                  ToolTipService.InitialShowDelay="400"
                                                  ToolTipService.ShowDuration="20000">
                                                <Grid.ToolTip>
                                                    <ItemsControl ItemsSource="{Binding SummaryLines}" MaxWidth="400">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <!-- Icon, name, settings (user direction 2026-07-06):
                                                                     the same order as the card's main device label. -->
                                                                <TextBlock TextWrapping="Wrap" Margin="0,1,0,1"><Run Text="{Binding DeviceGlyph, Mode=OneWay}" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/><Run Text="{Binding DeviceName, Mode=OneWay}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/><Run Text="{Binding Tokens, Mode=OneWay}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></TextBlock>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid.ToolTip>
                                                <!-- Zacksly stick silhouette (Sticks stage). -->
                                                <Grid Width="12" Height="12"
                                                      Visibility="{Binding IsStickShape, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Path FlowDirection="LeftToRight" Data="{StaticResource ZackslyStickOuterRingGeometry}" Style="{StaticResource StageGlyphShape}"/>
                                                    <Path FlowDirection="LeftToRight" Data="{StaticResource ZackslyStickInnerDiscGeometry}" Style="{StaticResource StageGlyphShape}"/>
                                                </Grid>
                                                <!-- Zacksly trigger silhouette (Triggers stage). -->
                                                <Grid Width="12" Height="12"
                                                      Visibility="{Binding IsTriggerShape, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Path FlowDirection="LeftToRight" Data="{StaticResource ZackslyTriggerOuterBodyGeometry}" Style="{StaticResource StageGlyphShape}"/>
                                                </Grid>
                                                <!-- Font stages (gyro / lighting / touchpad / audio). -->
                                                <reset:GlyphText Text="{Binding Glyph}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource StageGlyphText}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Glyph}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </reset:GlyphText>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Hover chevron (#175 phase 2 item 3): the
                                     whole card opens the controller page, so
                                     hovering reveals the app's forward glyph
                                     (E72A, same as the PadPage routing arrows)
                                     at the right edge. Opacity swap only; no
                                     layout shift, no hit-testing. -->
                                <reset:GlyphText Grid.RowSpan="5" Text="&#xE72A;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           IsHitTestVisible="False"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,0,1,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Opacity" Value="0"/>
                                            <Setter Property="Foreground" Value="{DynamicResource EmberBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </reset:GlyphText>
                            </Grid>
                        </Border>
                        </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.Resources>
            </ItemsControl>

            <!-- ═══ Extras in use ═══
                 One row for each extra that is on, in the Extras page's
                 order, each opening that extra's page. A row shows while its
                 extra's switch is on, the same value its tile in the catalog
                 shows, so the two never disagree. With some on and some off,
                 the line under the rows says where the others are. With none
                 on, the section introduces the Extras page in the page's own
                 words. Open Extras is there in every case.
                 ExtrasPageTests holds these rows to the catalog's ten keys. -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,12">
                <reset:GlyphText Text="&#xE74C;" Style="{StaticResource SectionGlyph}"/>
                <TextBlock x:Name="ExtrasHeading">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
                            <Setter Property="Text" Value="{Binding Home_ExtrasInUse, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowsExtrasIntro}" Value="True">
                                    <Setter Property="Text" Value="{Binding Extras_Title, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <WrapPanel x:Name="ExtrasInUseRows" controls:ExtraTile.OpenRequested="ExtraInUse_OpenRequested">
                <controls:ExtraTile Style="{StaticResource HomeExtraTile}" Key="WebController" Glyph="&#xE774;"
                                    Title="{Binding Dashboard_WebController, Source={x:Static strings:Strings.Instance}}"
                                    IsOn="{Binding EnableWebController, Mode=OneWay}"
                                    Status="{Binding WebControllerStatus}"
                                    Visibility="{Binding EnableWebController, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <controls:ExtraTile Style="{StaticResource HomeExtraTile}" Key="HeadTracking" Glyph="&#xE77B;"
                                    Title="{Binding Dashboard_HeadTracking, Source={x:Static strings:Strings.Instance}}"
                                    IsOn="{Binding HeadTrackingAnyEnabled, Mode=OneWay}"
                                    Status="{Binding HeadTrackingStatus}"
                                    Visibility="{Binding HeadTrackingAnyEnabled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <controls:ExtraTile Style="{StaticResource HomeExtraTile}" Key="GameTelemetry" Glyph="&#xEC4A;"
                                    Title="{Binding Dashboard_GameTelemetry, Source={x:Static strings:Strings.Instance}}"
                                    IsOn="{Binding EnableGameTelemetry, Mode=OneWay}"
                                    Status="{Binding GameTelemetryStatus}"
                                    Visibility="{Binding EnableGameTelemetry, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <controls:ExtraTile Style="{StaticResource HomeExtraTile}" Key="TwitchChat" Glyph="&#xE8F2;"
                                    Title="{Binding Dashboard_TwitchChat, Source={x:Static strings:Strings.Instance}}"
                                    IsOn="{Binding EnableTwitchChat, Mode=OneWay}"
                                    Status="{Binding TwitchChatStatus}"
                                    Visibility="{Binding EnableTwitchChat, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <controls:ExtraTile Style="{StaticResource HomeExtraTile}" Key="RemoteLink" Glyph="&#xE969;"
                                    Title="{Binding Dashboard_RemoteLink, Source={x:Static strings:Strings.Instance}}"
                                    IsOn="{Binding EnableRemoteLink, Mode=OneWay}"
                                    Status="{Binding RemoteLinkStatus}"
                                    Visibility="{Binding EnableRemoteLink, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <controls:ExtraTile Style="{StaticResource HomeExtraTile}" Key="MotionServer" Glyph="&#xE7AD;"
                                    Title="{Binding Dashboard_MotionServer, Source={x:Static strings:Strings.Instance}}"
                                    IsOn="{Binding EnableDsuMotionServer, Mode=OneWay}"
                                    Status="{Binding DsuServerStatus}"
                                    Visibility="{Binding EnableDsuMotionServer, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <controls:ExtraTile Style="{StaticResource HomeExtraTile}" Key="GameMods" Glyph="&#xEA86;"
                                    Title="{Binding Dashboard_GameMods, Source={x:Static strings:Strings.Instance}}"
                                    IsOn="{Binding EnableGameModServer, Mode=OneWay}"
                                    Status="{Binding GameModServerStatus}"
                                    Visibility="{Binding EnableGameModServer, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <controls:ExtraTile Style="{StaticResource HomeExtraTile}" Key="Overlays" Glyph="&#xE700;"
                                    Title="{Binding Dashboard_Overlays, Source={x:Static strings:Strings.Instance}}"
                                    IsOn="{Binding OverlaysAnyEnabled, Mode=OneWay}"
                                    Visibility="{Binding OverlaysAnyEnabled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <controls:ExtraTile Style="{StaticResource HomeExtraTile}" Key="TouchpadOverlay" Glyph="&#xEDA4;"
                                    Title="{Binding Dashboard_TouchpadOverlay, Source={x:Static strings:Strings.Instance}}"
                                    IsOn="{Binding EnableTouchpadOverlay, Mode=OneWay}"
                                    Status="{Binding TouchpadOverlayStatus}"
                                    Visibility="{Binding EnableTouchpadOverlay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <controls:ExtraTile Style="{StaticResource HomeExtraTile}" Key="ScreenOverlay" Glyph="&#xE7F4;"
                                    Title="{Binding Dashboard_ScreenOverlay, Source={x:Static strings:Strings.Instance}}"
                                    IsOn="{Binding ScreenOverlaysAnyEnabled, Mode=OneWay}"
                                    Visibility="{Binding ScreenOverlaysAnyEnabled, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </WrapPanel>

            <!-- The line and the way to the rest. The line is the page's own
                 subtitle while no extra is on, says where the others are
                 while some are on, and is gone when all ten are. In a wrap
                 panel so the button drops under a line too long for the row. -->
            <WrapPanel x:Name="ExtrasFoot">
                <TextBlock x:Name="ExtrasLine" MaxWidth="560" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CardDescription}">
                            <Setter Property="Margin" Value="0,0,12,8"/>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowsExtrasIntro}" Value="True">
                                    <Setter Property="Text" Value="{Binding Extras_Subtitle, Source={x:Static strings:Strings.Instance}}"/>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShowsExtrasRestLine}" Value="True">
                                    <Setter Property="Text" Value="{Binding Home_MoreExtras, Source={x:Static strings:Strings.Instance}}"/>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ui:Button x:Name="OpenExtrasButton" Margin="0,0,0,8" VerticalAlignment="Center"
                           Click="OpenExtras_Click"
                           Content="{Binding Home_OpenExtras, Source={x:Static strings:Strings.Instance}}"
                           AutomationProperties.AutomationId="Home_OpenExtras"/>
            </WrapPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
