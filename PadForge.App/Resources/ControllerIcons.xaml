    mc:Ignorable="po">


    <conv:UppercaseConverter x:Key="UpperConverter"/>

    <!-- Hover-glow effects (#175): every hover color change carries a
         glow matched to the hue it turns. Ember hover glows ember, cold
         hover glows cold, neutral steel lifts get a faint ember (the
         app's signature). Frozen so one instance is shared by every
         style trigger and code-behind site; static Effect setters only,
         never animated (Effect animation from style triggers crashes at
         startup). -->
    <DropShadowEffect x:Key="EmberHoverGlow" po:Freeze="True"
                      Color="#FF6B2C" ShadowDepth="0" BlurRadius="12" Opacity="0.45"/>
    <DropShadowEffect x:Key="EmberHoverGlowSmall" po:Freeze="True"
                      Color="#FF6B2C" ShadowDepth="0" BlurRadius="8" Opacity="0.45"/>
    <DropShadowEffect x:Key="ColdHoverGlow" po:Freeze="True"
                      Color="#58B6E4" ShadowDepth="0" BlurRadius="10" Opacity="0.40"/>
    <DropShadowEffect x:Key="NeutralHoverGlow" po:Freeze="True"
                      Color="#FF6B2C" ShadowDepth="0" BlurRadius="10" Opacity="0.30"/>
