<UserControl x:Class="PadForge.Views.PadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PadForge.ViewModels"
             xmlns:controls="clr-namespace:PadForge.Controls"
             xmlns:views="clr-namespace:PadForge.Views"
             xmlns:viewControls="clr-namespace:PadForge.Views.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:strings="clr-namespace:PadForge.Resources.Strings"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             mc:Ignorable="d po"
             d:DataContext="{d:DesignInstance vm:PadViewModel}"
             d:DesignHeight="700" d:DesignWidth="900"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:common="clr-namespace:PadForge.Common">

    <UserControl.Resources>
        <!-- #175 hover-glow: hue-matched glows for anything whose color
             changes on hover. Ember hover gets an ember glow, cold hover a
             cold glow, steel/brightness-only hover the faint neutral ember
             (the app's signature hue). Static Effect setters only. Never
             animate Effect or Effect.Opacity from style triggers (startup
             crash). Frozen so one instance is shared safely. -->
        <DropShadowEffect x:Key="EmberHoverGlow" po:Freeze="True" Color="#FF6B2C" ShadowDepth="0" BlurRadius="12" Opacity="0.45"/>
        <DropShadowEffect x:Key="ColdHoverGlow" po:Freeze="True" Color="#58B6E4" ShadowDepth="0" BlurRadius="10" Opacity="0.40"/>
        <DropShadowEffect x:Key="NeutralHoverGlow" po:Freeze="True" Color="#FF6B2C" ShadowDepth="0" BlurRadius="10" Opacity="0.30"/>

        <!-- Touchpad stick rows (#175 item 15): settings persist as 0..1
             fractions, the DZ-row idiom displays percent. Two-way converter
             at the edit boundary, class lives in PadPage.xaml.cs. -->
        <views:FractionToPercentConverter x:Key="FractionToPercentConverter"/>

        <!-- Style for deadzone slider groups -->
        <Style x:Key="DzLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="270"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="DzSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="0.1"/>
        </Style>
        <Style x:Key="OffsetSlider" TargetType="Slider" BasedOn="{StaticResource DzSlider}">
            <Setter Property="Minimum" Value="-100"/>
        </Style>
        <Style x:Key="DzValueEdit" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="Width" Value="56"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="2,1"/>
            <!-- #175 hover-glow: hover lightens the recessed well one step
                 (TextControlBackgroundPointerOver), a neutral change. -->
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DzDigitEdit" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="Width" Value="56"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="ToolTip" Value="{Binding Pad_RawAxisValue, Source={x:Static strings:Strings.Instance}}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DzPercent" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
        </Style>
        <!--
            FontFamily / FontSize live on the child TextBlock so the symbol-
            font glyph renders inside the button without leaking through the
            visual tree to the tooltip. The tooltip then keeps its WPF UI
            themed font (Fluent / Segoe UI Variable). Mirrors the working
            pattern used by the mapping grid's record / clear buttons:
            symbol font scoped to a child TextBlock, not the Button itself.
        -->
        <Style x:Key="ResetButton" TargetType="ui:Button" BasedOn="{StaticResource EmberIconButton}">
            <Setter Property="Content" Value="&#xE72C;"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="{Binding Common_Reset, Source={x:Static strings:Strings.Instance}}"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <!-- #175 hover-glow: the cold glow trigger is inherited from
                 EmberIconButton (App.xaml), matching the cold hover ring. -->
        </Style>
        <!-- Reset All is a reset-domain text button: same ghost stroke /
             cold-ring chrome as EmberIconButton, but natural width so the
             localized label fits. -->
        <Style x:Key="ResetAllButton" TargetType="ui:Button" BasedOn="{StaticResource EmberIconButton}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <!-- #175 hover-glow: cold glow inherited from EmberIconButton. -->
        </Style>

        <!-- Compact row styles for RGB sliders that need to fit under
             a 200×200 ColorPickerControl. Used in the lightbar base
             color and the three audio-threshold color blocks. -->
        <Style x:Key="DzLabelTight" TargetType="TextBlock">
            <Setter Property="Width" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <!-- Channel letters wear the telemetry mono face, matching the
                 Devices-page X/Y/Z axis tokens. -->
            <Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <!-- RGB rows ride the EmberSlider retemplate (user report,
             2026-07-04): the stock rail reads invisible on the picker
             panel ground, so the recessed steel tray + hairline makes
             the bar present at every value, with the ember fill as the
             level readout. Uniform across all four RGB slider sites. -->
        <Style x:Key="DzRgbSlider" TargetType="Slider" BasedOn="{StaticResource EmberSlider}">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="255"/>
            <Setter Property="Width" Value="148"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
        </Style>
        <Style x:Key="DzValueEditTight" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="Width" Value="48"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="2,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Tight variant kept as an alias: EmberIconButton's fixed 28x28
             already gives the compact RGB rows their footprint. -->
        <Style x:Key="ResetButtonTight" TargetType="ui:Button" BasedOn="{StaticResource ResetButton}"/>

        <!-- Custom tab strip button (RadioButton styled as tab header) -->
        <Style x:Key="TabStripButton" TargetType="RadioButton">
            <Setter Property="GroupName" Value="PadTab"/>
            <Setter Property="Margin" Value="2,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <!-- Artifact .tier1 .tab.sel: ember-tint fill, warm
                             600-weight text, inset 2px bottom underline.
                             No outline. Hover carries the ember hover glow
                             (#175 hover-glow). -->
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
                            <Grid>
                                <ContentPresenter Margin="12,5,12,7" VerticalAlignment="Center"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}"/>
                                <Rectangle x:Name="Underline" Height="2" RadiusX="1" RadiusY="1"
                                           VerticalAlignment="Bottom" Margin="6,0,6,1"
                                           Fill="{DynamicResource EmberBrush}" Opacity="0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFF6B2C"/>
                                <Setter Property="Foreground" Value="{DynamicResource EmberHotBrush}"/>
                                <Setter Property="TextBlock.FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Underline" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FF6B2C"/>
                                <Setter TargetName="Bd" Property="Effect" Value="{StaticResource EmberHoverGlow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cold variant for the device tier (#175): same tab shape, cold
             underline. Slot-tier tabs keep the ember (accent) underline.
             Own radio group so WPF never auto-unchecks across tiers.
             SyncTabStripSelection keeps exactly one tab checked overall
             (#175 item 18: only the tier owning the active tab shows a
             highlight, the idle tier drops to hover affordance). -->
        <Style x:Key="TabStripButtonCold" TargetType="RadioButton">
            <Setter Property="GroupName" Value="PadTabDevice"/>
            <Setter Property="Margin" Value="2,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <!-- Artifact .tier2 .tab.sel: cold tint + inset cold
                             underline. -->
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
                            <Grid>
                                <ContentPresenter Margin="12,5,12,7" VerticalAlignment="Center"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}"/>
                                <Rectangle x:Name="Underline" Height="2" RadiusX="1" RadiusY="1"
                                           VerticalAlignment="Bottom" Margin="6,0,6,1"
                                           Fill="{DynamicResource ColdBrush}" Opacity="0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ColdTintBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ColdBrush}"/>
                                <Setter Property="TextBlock.FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Underline" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1458B6E4"/>
                                <Setter TargetName="Bd" Property="Effect" Value="{StaticResource ColdHoverGlow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════ #175 hover-glow styles ═══════════════
             Where a whole class shares one hover treatment, the glow rides
             a BasedOn style (implicit for stock chrome) so WPF-UI theme
             brushes survive. Stock-chrome hover fills raised steel via the
             EmberTheme PointerOver keys, a brightness-only change, so those
             classes get the faint neutral ember. The plain Button, ComboBox,
             TextBox, and CheckBox classes plus the EmberIconButton family
             already carry their glow triggers in the App.xaml styles, so no
             page-level shadows for those here. -->

        <!-- Map All pill (Controller tab): hover swaps transparent fill to
             raised steel. -->
        <Style x:Key="MapAllPillButton" TargetType="ui:Button" BasedOn="{StaticResource DefaultUiButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Shift-layer tab chips: stock RadioButton chrome. -->
        <Style x:Key="ShiftLayerTabChip" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Stock-chrome item containers, page-wide (no app-level glow for
             these two): Macros list, macro Actions list, sound packages
             list, and every mapping-picker dropdown item. -->
        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Adaptive-trigger mode cards (#175 competitor item 5): the
             Mode ComboBox becomes a radio-like card grid. Each card is
             a steel tile. Selection reads ember (tint wash + the
             #66FF6B2C rim the identity chip and output chips use) and
             round-trips through SelectedValue/Tag exactly like the
             Lighting mode picker. Static Effect setter only on hover.
             Nothing animates. -->
        <Style x:Key="AtModeCardContainer" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBd" CornerRadius="8" BorderThickness="1"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource SteelLineBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBd" Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBd" Property="Background" Value="{DynamicResource EmberTintBrush}"/>
                                <Setter TargetName="CardBd" Property="BorderBrush" Value="#66FF6B2C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AtModeCardName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Device selector header -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Extended config bar (visible only for Extended slots) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Configuration tabs -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════
             ROW 0: Two-tier tab strip (#175).
             Tier 1, ember: the virtual controller being shaped. Slot badge
             (doubles as the Preview tab), Mappings, Macros.
             Tier 2, cold: the physical device feeding it. Device picker
             plus its capability tabs. Color carries the scope; the old
             chevron separators are gone.
             ═══════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,2">
            <Border Padding="4,0" BorderThickness="0,0,0,1">
                <Border.BorderBrush>
                    <SolidColorBrush Color="#3DFF6B2C"/>
                </Border.BorderBrush>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1FFF6B2C" Offset="0"/>
                        <GradientStop Color="#00FF6B2C" Offset="0.6"/>
                    </LinearGradientBrush>
                </Border.Background>
            <DockPanel LastChildFill="False" VerticalAlignment="Center">

                <!-- Scope label (#175 iteration 2): without it the two tiers
                     read as arbitrary strips. -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,4,0">
                    <TextBlock Text="{Binding Dashboard_Slot, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}"
                               FontFamily="{StaticResource TelemetryFontFamily}"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource EmberTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SlotNumber}"
                               FontFamily="{StaticResource TelemetryFontFamily}"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource EmberTextBrush}" Margin="3,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Identity chip (#175 final close-out): standalone and
                     non-interactive. It states what the slot IS; the tabs
                     to its right are the navigation. Always ember,
                     independent of which tab is checked. -->
                <Border Background="{DynamicResource EmberTintBrush}" BorderBrush="#66FF6B2C" BorderThickness="1"
                        CornerRadius="8" Padding="8,2" Margin="4,4,2,4"
                        VerticalAlignment="Center"
                        TextBlock.Foreground="{DynamicResource EmberHotBrush}">
                    <StackPanel Orientation="Horizontal">
                        <!-- Gamepad glyph + slot number removed (#175
                             iteration 3): the tier's Slot N scope label
                             already says it. The badge keeps type + instance. -->
                        <Image Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source" Value="{StaticResource GenericControllerIcon}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OutputType}" Value="Xbox">
                                            <Setter Property="Source" Value="{StaticResource XboxControllerIcon}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OutputType}" Value="PlayStation">
                                            <Setter Property="Source" Value="{StaticResource DS4ControllerIcon}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OutputType}" Value="Nintendo">
                                            <Setter Property="Source" Value="{StaticResource NintendoControllerIcon}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OutputType}" Value="Extended">
                                            <Setter Property="Source" Value="{StaticResource ExtendedControllerIcon}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OutputType}" Value="Midi">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OutputType}" Value="KeyboardMouse">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <!-- MIDI glyph icon (visible only when OutputType == Midi) -->
                        <TextBlock Text="&#xEC4F;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,4,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OutputType}" Value="Midi">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Keyboard+Mouse glyph icon (visible only when OutputType == KeyboardMouse) -->
                        <TextBlock Text="&#xE961;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,4,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OutputType}" Value="KeyboardMouse">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Type name + instance token share ONE TextBlock so
                             they render on a single baseline (user report
                             2026-07-06: the mono #N sat low beside the body
                             type name when each was its own TextBlock centering
                             its own line box). The type name is one VM string;
                             the ember mono #N is a Run on the same baseline,
                             its leading space giving the gap the old margin
                             carried. -->
                        <TextBlock FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"><Run Text="{Binding OutputTypeDisplayName, Mode=OneWay}"/><Run Text="{Binding TypeInstanceLabel, Mode=OneWay, StringFormat=' #{0}'}" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource EmberTextBrush}"/></TextBlock>
                    </StackPanel>
                </Border>

                <!-- Preset ghost chip (#175, per the approved header mock):
                     slot-scope, inline in tier 1, carried by the ChipGhost
                     grammar (item 10). Visibility still driven by
                     code-behind through the same names. -->
                <Border x:Name="HMaestroProfileBar" Margin="10,4,4,4"
                        Style="{StaticResource ChipGhost}"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <!-- Label inherits ChipGhost's TextElement.Foreground /
                             FontSize like the other chip consumers. The ComboBox
                             is a templated Control, so the Border-targeted style
                             can't carry it: it keeps the equivalent brush keys
                             inline (tertiary text, transparent fill/stroke so
                             the chip surface shows through). -->
                        <TextBlock Text="{Binding Pad_Preset, Source={x:Static strings:Strings.Instance}}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="HMaestroProfileCombo" VerticalAlignment="Center"
                                  MaxWidth="380"
                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                  FontSize="12.5"
                                  AutomationProperties.AutomationId="HMaestroProfileCombo"
                                  ItemsSource="{Binding AvailableProfiles}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding ProfileId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  PreviewKeyDown="ProfileCombo_PreviewKeyDown">
                            <!-- Chip presentation, take 2 (user report: the
                                 custom minimal template broke the dropdown).
                                 The stock WPF-UI template keeps its own
                                 toggle/popup machinery; chrome is stripped to
                                 chip weight through properties only. -->
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <!-- Chip weight (user report: "looks a little
                                         weird"): the stock template's default
                                         padding inflated the chip to input-field
                                         height. -->
                                    <Setter Property="Padding" Value="4,0"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </StackPanel>
                </Border>
<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <!-- The active-profile pill lives in the status bar ONLY.
                     A copy sat here (#175 item 8) until a user read it as a
                     per-pad profile selector (2026-07-05). Profiles are
                     global, so the pad page carries none. -->
                <!-- [Preview] tab (#175 re-audit): the artifact's tier1 puts
                     one right-pushed tabset holding all three slot tabs after
                     the identity + preset chips; Preview was stranded on the
                     left. Tag/Click/IsChecked/AutomationId unchanged so
                     SelectedConfigTab numbering and the code-behind sync
                     keep working. -->
                <RadioButton x:Name="TabController" Tag="0" Style="{StaticResource TabStripButton}" Click="TabBtn_Click"
                             IsChecked="True"
                             AutomationProperties.AutomationId="TabController">
                    <TextBlock Text="{Binding Pad_Tab_Preview, Source={x:Static strings:Strings.Instance}}" FontSize="15"/>
                </RadioButton>

                <!-- [Mappings]. Per-VC scope (Issue #61 multi-source).
                     Sits before the Device dropdown (the table sources
                     from any device assigned to this VC, not just the
                     selected one) AND before Macros (it's the primary
                     config tab — Macros is the layered-effect surface
                     that sits on top of a configured mapping table).
                     Sticks/Triggers/FFB stay after the dropdown — they
                     shape physical-input characteristics, so they remain
                     device-scoped. Tag stays 2 to keep SelectedConfigTab
                     numbering stable (TabControl content + the visibility-
                     kick logic in PadPage.xaml.cs key off these ints). -->
                <RadioButton Tag="2" Style="{StaticResource TabStripButton}" Click="TabBtn_Click"
                             AutomationProperties.AutomationId="MappingsTab">
                    <TextBlock Text="{Binding Pad_Mappings, Source={x:Static strings:Strings.Instance}}" FontSize="15"/>
                </RadioButton>

                <!-- [Macros] -->
                <RadioButton Tag="1" Style="{StaticResource TabStripButton}" Click="TabBtn_Click"
                             AutomationProperties.AutomationId="MacrosTab">
                    <TextBlock Text="{Binding Pad_Macros, Source={x:Static strings:Strings.Instance}}" FontSize="15"/>
                </RadioButton>

                <!-- [Menus] (#9 B-17). Slot tier: menus live on the slot's
                     MappingSet like the mapping table and macros. Tag 15 =
                     the appended TabItem's index. -->
                <RadioButton Tag="15" Style="{StaticResource TabStripButton}" Click="TabBtn_Click"
                             AutomationProperties.AutomationId="MenusTab">
                    <TextBlock Text="{Binding Pad_Menus, Source={x:Static strings:Strings.Instance}}" FontSize="15"/>
                </RadioButton>

                <!-- [Bass Shakers] (#236). Slot tier: the rumble-to-audio
                     config lives on the slot's MappingSet like menus. Tag
                     16 = the appended TabItem's index. Visible only for
                     Xbox / PlayStation slot types (the outputs whose game
                     feedback the engine decodes). A SLOT-TYPE gate, never
                     a physical-device capability gate. -->
                <RadioButton Tag="16" Style="{StaticResource TabStripButton}" Click="TabBtn_Click"
                             AutomationProperties.AutomationId="BassShakersTab"
                             Visibility="{Binding RumbleAudioTabVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding Pad_Tab_BassShakers, Source={x:Static strings:Strings.Instance}}" FontSize="15"/>
                </RadioButton>
                </StackPanel>

            </DockPanel>
            </Border>

            <!-- Tier 2: the physical device and its capability tabs. -->
            <Border Padding="4,0" BorderThickness="0,0,0,1">
                <Border.BorderBrush>
                    <SolidColorBrush Color="#3858B6E4"/>
                </Border.BorderBrush>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1758B6E4" Offset="0"/>
                        <GradientStop Color="#0058B6E4" Offset="0.6"/>
                    </LinearGradientBrush>
                </Border.Background>
            <!-- Item 16 (#175 final close-out): scope label + picker sit
                 left, the capability tabset is pushed right to mirror the
                 slot tier. The tabs keep a WrapPanel so narrow windows
                 wrap to a second line instead of clipping. -->
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <TextBlock Text="{Binding Pad_ScopeDevice, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}"
                           FontFamily="{StaticResource TelemetryFontFamily}"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource ColdBrush}" Margin="8,0,4,0" VerticalAlignment="Center"/>

                <!-- [Device] inline ComboBox: cold side. -->
                <ComboBox ItemsSource="{Binding MappedDevices}"
                          SelectedItem="{Binding SelectedMappedDevice, Mode=TwoWay}"
                          BorderBrush="#4D58B6E4" Background="#0D58B6E4"
                          MinWidth="200" Margin="4,2" VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Path Margin="0,0,6,0">
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource LivenessFlameBase}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                                    <Setter Property="Stroke" Value="{x:Null}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#FF6B2C" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ColdBrush}"/>
                                <!-- Battery (issue #167): quiet suffix, empty when unreported -->
                                <TextBlock Text="{Binding BatteryText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                </StackPanel>

                <WrapPanel Grid.Column="1" Orientation="Horizontal"
                           HorizontalAlignment="Right" VerticalAlignment="Center">

                <!-- Config tabs (device-scoped: Sticks / Triggers /
                     Force Feedback shape physical-input characteristics
                     for the selected device, so they sit in the device
                     tier). The Mappings tab was here in v3.1.x and
                     earlier; Issue #61 moved it to the slot tier because
                     the mapping table is per-VC, not per-device. -->
                <RadioButton x:Name="TabSticks" Tag="3" Style="{StaticResource TabStripButtonCold}" Click="TabBtn_Click">
                    <TextBlock Text="{Binding Pad_Sticks, Source={x:Static strings:Strings.Instance}}" FontSize="13"/>
                </RadioButton>
                <RadioButton x:Name="TabTriggers" Tag="4" Style="{StaticResource TabStripButtonCold}" Click="TabBtn_Click">
                    <TextBlock Text="{Binding Pad_Triggers, Source={x:Static strings:Strings.Instance}}" FontSize="13"/>
                </RadioButton>
                <RadioButton x:Name="TabForceFeedback" Tag="5" Style="{StaticResource TabStripButtonCold}" Click="TabBtn_Click">
                    <TextBlock Text="{Binding Pad_ForceFeedback, Source={x:Static strings:Strings.Instance}}" FontSize="13"/>
                </RadioButton>

                <!-- Wheel tab — native-FFB wheels (Logitech / Fanatec / Thrustmaster) only.
                     Visibility driven from code-behind (SyncTabVisibility) when the
                     selected device matches a wheel VID/PID gate. Holds the wheel-only
                     settings (rotation range, auto-center, RPM shift LEDs) that used to
                     sit on the Force Feedback tab. -->
                <RadioButton x:Name="TabWheel" Tag="11" Style="{StaticResource TabStripButtonCold}" Click="TabBtn_Click"
                             Visibility="Collapsed">
                    <TextBlock Text="{Binding Pad_Wheel, Source={x:Static strings:Strings.Instance}}" FontSize="13"/>
                </RadioButton>

                <!-- Impulse Triggers tab — Xbox One / Elite / Series only.
                     Visibility driven from code-behind via SyncTabVisibility
                     which checks the assigned device's HasRumbleTriggers
                     (SDL_PROP_JOYSTICK_CAP_TRIGGER_RUMBLE_BOOLEAN). Hidden
                     on Xbox 360, PlayStation, generic, MIDI, KbM. -->
                <RadioButton x:Name="TabImpulseTriggers" Tag="9" Style="{StaticResource TabStripButtonCold}" Click="TabBtn_Click"
                             Visibility="Collapsed">
                    <TextBlock Text="{Binding Pad_ImpulseTriggers, Source={x:Static strings:Strings.Instance}}" FontSize="13"/>
                </RadioButton>

                <!-- Adaptive Triggers tab — DualSense / DualSense Edge only.
                     Visibility driven from code-behind via SyncTabStripSelection
                     which reads OutputType + ProfileId.  PadPage's runtime
                     visibility gate hides this RadioButton on Xbox / Extended
                     / MIDI / KbM slots and on DS4 PlayStation slots.  -->
                <RadioButton x:Name="TabAdaptiveTriggers" Tag="6" Style="{StaticResource TabStripButtonCold}" Click="TabBtn_Click"
                             Visibility="Collapsed">
                    <TextBlock Text="{Binding Pad_AdaptiveTriggers, Source={x:Static strings:Strings.Instance}}" FontSize="13"/>
                </RadioButton>

                <!-- Lighting tab — DS4 / DualSense / DualSense Edge.  Hidden
                     on slots whose profile lacks a lightbar.  -->
                <RadioButton x:Name="TabLighting" Tag="7" Style="{StaticResource TabStripButtonCold}" Click="TabBtn_Click"
                             Visibility="Collapsed">
                    <TextBlock Text="{Binding Pad_Lighting, Source={x:Static strings:Strings.Instance}}" FontSize="13"/>
                </RadioButton>

                <!-- Gyro tab — per-(device, slot) gyro tuning. Visible when
                     the selected mapped device has a gyroscope sensor
                     (driven from SyncTabVisibility via UserDevice.HasGyro). -->
                <RadioButton x:Name="TabGyro" Tag="8" Style="{StaticResource TabStripButtonCold}" Click="TabBtn_Click"
                             Visibility="Collapsed">
                    <TextBlock Text="{Binding Pad_Gyro, Source={x:Static strings:Strings.Instance}}" FontSize="13"/>
                </RadioButton>

                <!-- Touchpad tab — per-(device, pad) gesture detection
                     settings. Visible when the selected mapped device
                     has at least one touchpad (UserDevice.HasTouchpad). -->
                <RadioButton x:Name="TabTouchpad" Tag="10" Style="{StaticResource TabStripButtonCold}" Click="TabBtn_Click"
                             Visibility="Collapsed">
                    <TextBlock Text="{Binding Pad_Touchpad, Source={x:Static strings:Strings.Instance}}" FontSize="13"/>
                </RadioButton>

                <!-- Audio tab: controller speaker output (issue #83) — passthrough,
                     macro sounds, master volume. Visible only when the selected
                     mapped device has a speaker: the DualSense family or the
                     DualShock 4 (Sony VID 0x054C). Hidden for everything else. -->
                <RadioButton x:Name="TabAudio" Tag="12" Style="{StaticResource TabStripButtonCold}" Click="TabBtn_Click"
                             Visibility="Collapsed">
                    <TextBlock Text="{Binding Pad_Audio, Source={x:Static strings:Strings.Instance}}" FontSize="13"/>
                </RadioButton>
                <!-- Pointer tab: Wii Remote IR camera tuning (#146). Visible only
                     when the selected mapped device is an IR-capable Wii Remote. -->
                <RadioButton x:Name="TabPointer" Tag="13" Style="{StaticResource TabStripButtonCold}" Click="TabBtn_Click"
                             Visibility="Collapsed">
                    <TextBlock Text="{Binding Pad_Pointer, Source={x:Static strings:Strings.Instance}}" FontSize="13"/>
                </RadioButton>
                <!-- Mouse tab: per-device mouse-gesture settings (#200).
                     Visible only when the selected mapped device is a mouse. -->
                <RadioButton x:Name="TabMouse" Tag="14" Style="{StaticResource TabStripButtonCold}" Click="TabBtn_Click"
                             Visibility="Collapsed">
                    <TextBlock Text="{Binding Pad_Mouse, Source={x:Static strings:Strings.Instance}}" FontSize="13"/>
                </RadioButton>
                </WrapPanel>
            </Grid>
            </Border>
        </StackPanel>

        <!-- ══════════════════════════════════════
             ROW 1: HIDMAESTRO PROFILE PICKER BAR
             (visible for Xbox / PlayStation / Extended slots)
             ══════════════════════════════════════ -->


        <!-- ══════════════════════════════════════
             ROW 1: EXTENDED CONFIGURATION BAR
             (visible only when OutputType == Extended)
             ══════════════════════════════════════ -->
        <Border x:Name="ExtendedConfigBar" Grid.Row="1" Margin="4,4,4,0"
                Padding="10,8" CornerRadius="4"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource TextFillColorDisabledBrush}" BorderThickness="1"
                Visibility="Collapsed">
            <StackPanel>
                <!-- Row 1: Profile picker + Import-from-device -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Pad_Preset, Source={x:Static strings:Strings.Instance}}"
                               VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                    <ComboBox x:Name="ExtendedProfileCombo" Width="420" VerticalAlignment="Center"
                              ItemsSource="{Binding AvailableProfiles}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding ProfileId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              PreviewKeyDown="ProfileCombo_PreviewKeyDown"/>
                    <Button x:Name="ExtendedImportBtn"
                            Content="{Binding Pad_ExtendedImportFromDevice, Source={x:Static strings:Strings.Instance}}"
                            Margin="12,0,0,0" VerticalAlignment="Center"
                            Click="ExtendedImportBtn_Click"
                            ToolTip="{Binding Pad_ExtendedImportFromDeviceTooltip, Source={x:Static strings:Strings.Instance}}"/>
                    <Button x:Name="ExtendedCloneBtn"
                            Content="{Binding Pad_ExtendedCloneDevice, Source={x:Static strings:Strings.Instance}}"
                            Margin="8,0,0,0" VerticalAlignment="Center"
                            Click="ExtendedCloneBtn_Click"
                            ToolTip="{Binding Pad_ExtendedCloneDeviceTooltip, Source={x:Static strings:Strings.Instance}}"/>
                </StackPanel>

                <!-- Row 2: Master Customize toggle. Controls IsEnabled of rows 3+4 below.
                     When off, the VC uses the catalog profile as-is with no overrides. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" x:Name="ExtendedCustomizeChk"
                              VerticalAlignment="Center"
                              Content="{Binding Pad_ExtendedCustomize, Source={x:Static strings:Strings.Instance}}"
                              Checked="ExtendedCustomize_Toggled" Unchecked="ExtendedCustomize_Toggled"
                              ToolTip="{Binding Pad_ExtendedCustomizeTooltip, Source={x:Static strings:Strings.Instance}}"/>
                    <ui:Button x:Name="ExtendedResetDefaultsBtn" Style="{StaticResource ResetButton}"
                            Click="ExtendedResetDefaults_Click"
                            IsEnabled="{Binding IsChecked, ElementName=ExtendedCustomizeChk}"
                            ToolTip="{Binding Pad_ExtendedResetDefaultsTooltip, Source={x:Static strings:Strings.Instance}}"/>
                </StackPanel>

                <!-- Row 3: Identity override (Product String / OEM / VID / PID) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0"
                            IsEnabled="{Binding IsChecked, ElementName=ExtendedCustomizeChk}">
                    <TextBlock Text="{Binding Pad_ExtendedProductString, Source={x:Static strings:Strings.Instance}}"
                               VerticalAlignment="Center" Margin="0,0,4,0" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               ToolTip="{Binding Pad_ExtendedProductStringTooltip, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBox x:Name="ExtendedProductStringBox" Width="280" VerticalAlignment="Center"
                             LostFocus="ExtendedOverride_Changed" KeyDown="ExtendedOverride_KeyDown"/>

                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" x:Name="ExtendedOemOverrideChk" Margin="6,0,0,0"
                              VerticalAlignment="Center"
                              Content="{Binding Pad_ExtendedOemOverride, Source={x:Static strings:Strings.Instance}}"
                              Checked="ExtendedOemOverride_Toggled" Unchecked="ExtendedOemOverride_Toggled"
                              ToolTip="{Binding Pad_ExtendedOemOverrideTooltip, Source={x:Static strings:Strings.Instance}}"/>

                    <TextBlock Text="{Binding Pad_ExtendedVid, Source={x:Static strings:Strings.Instance}}"
                               VerticalAlignment="Center" Margin="12,0,4,0" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="ExtendedVidBox" Width="78" VerticalAlignment="Center"
                             TextAlignment="Center"
                             LostFocus="ExtendedOverride_Changed" KeyDown="ExtendedOverride_KeyDown"/>

                    <TextBlock Text="{Binding Pad_ExtendedPid, Source={x:Static strings:Strings.Instance}}"
                               VerticalAlignment="Center" Margin="12,0,4,0" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="ExtendedPidBox" Width="78" VerticalAlignment="Center"
                             TextAlignment="Center"
                             LostFocus="ExtendedOverride_Changed" KeyDown="ExtendedOverride_KeyDown"/>
                </StackPanel>

                <!-- Row 4: Layout override (Sticks / Triggers / POVs / Buttons) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0"
                            IsEnabled="{Binding IsChecked, ElementName=ExtendedCustomizeChk}">
                    <TextBlock Text="{Binding Pad_ExtendedSticks, Source={x:Static strings:Strings.Instance}}"
                               VerticalAlignment="Center" Margin="0,0,4,0" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="RawStickCountBox" Width="40" VerticalAlignment="Center"
                             AutomationProperties.AutomationId="RawStickCountBox"
                             TextAlignment="Center" Text="2"
                             LostFocus="ExtendedCustomValue_Changed" KeyDown="ExtendedCustomValue_KeyDown"/>

                    <TextBlock Text="{Binding Pad_ExtendedTriggers, Source={x:Static strings:Strings.Instance}}"
                               VerticalAlignment="Center" Margin="10,0,4,0" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="ExtendedTriggerCountBox" Width="40" VerticalAlignment="Center"
                             AutomationProperties.AutomationId="ExtendedTriggerCountBox"
                             TextAlignment="Center" Text="2"
                             LostFocus="ExtendedCustomValue_Changed" KeyDown="ExtendedCustomValue_KeyDown"/>

                    <TextBlock Text="{Binding Pad_ExtendedPOVs, Source={x:Static strings:Strings.Instance}}"
                               VerticalAlignment="Center" Margin="10,0,4,0" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="RawPovCountBox" Width="40" VerticalAlignment="Center"
                             AutomationProperties.AutomationId="RawPovCountBox"
                             TextAlignment="Center" Text="1"
                             LostFocus="ExtendedCustomValue_Changed" KeyDown="ExtendedCustomValue_KeyDown"/>

                    <TextBlock Text="{Binding Pad_ExtendedButtons, Source={x:Static strings:Strings.Instance}}"
                               VerticalAlignment="Center" Margin="10,0,4,0" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="RawButtonCountBox" Width="72" VerticalAlignment="Center"
                             AutomationProperties.AutomationId="RawButtonCountBox"
                             TextAlignment="Center" Text="11"
                             LostFocus="ExtendedCustomValue_Changed" KeyDown="ExtendedCustomValue_KeyDown"/>

                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" x:Name="ExtendedForceFeedbackChk" Margin="14,0,0,0"
                              VerticalAlignment="Center"
                              Content="{Binding Pad_ExtendedForceFeedback, Source={x:Static strings:Strings.Instance}}"
                              IsChecked="{Binding ExtendedConfig.ForceFeedbackEnabled, Mode=TwoWay}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════
             ROW 1 (alt): MIDI CONFIGURATION BAR
             (visible only when OutputType == Midi)
             ══════════════════════════════════════ -->
        <Border x:Name="MidiConfigBar" Grid.Row="1" Margin="4,4,4,0"
                Padding="10,6" CornerRadius="4"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource TextFillColorDisabledBrush}" BorderThickness="1"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Pad_MidiChannel, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           ToolTip="{Binding Pad_MidiChannelTooltip, Source={x:Static strings:Strings.Instance}}"/>
                <TextBox x:Name="MidiChannelBox" Width="40" VerticalAlignment="Center"
                         TextAlignment="Center" Text="1"
                         LostFocus="MidiConfig_Changed" KeyDown="MidiConfig_KeyDown"/>

                <TextBlock Text="{Binding Pad_MidiCCCount, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="12,0,4,0" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           ToolTip="{Binding Pad_MidiCCCountTooltip, Source={x:Static strings:Strings.Instance}}"/>
                <TextBox x:Name="MidiCcCountBox" Width="54" VerticalAlignment="Center"
                         TextAlignment="Center" Text="6"
                         LostFocus="MidiConfig_Changed" KeyDown="MidiConfig_KeyDown"/>

                <TextBlock Text="{Binding Pad_MidiStartCC, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="12,0,4,0" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           ToolTip="{Binding Pad_MidiStartCCTooltip, Source={x:Static strings:Strings.Instance}}"/>
                <TextBox x:Name="MidiStartCcBox" Width="54" VerticalAlignment="Center"
                         TextAlignment="Center" Text="1"
                         LostFocus="MidiConfig_Changed" KeyDown="MidiConfig_KeyDown"/>

                <TextBlock Text="{Binding Pad_MidiNoteCount, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="12,0,4,0" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           ToolTip="{Binding Pad_MidiNoteCountTooltip, Source={x:Static strings:Strings.Instance}}"/>
                <TextBox x:Name="MidiNoteCountBox" Width="54" VerticalAlignment="Center"
                         TextAlignment="Center" Text="11"
                         LostFocus="MidiConfig_Changed" KeyDown="MidiConfig_KeyDown"/>

                <TextBlock Text="{Binding Pad_MidiStartNote, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="12,0,4,0" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           ToolTip="{Binding Pad_MidiStartNoteTooltip, Source={x:Static strings:Strings.Instance}}"/>
                <TextBox x:Name="MidiStartNoteBox" Width="54" VerticalAlignment="Center"
                         TextAlignment="Center" Text="60"
                         LostFocus="MidiConfig_Changed" KeyDown="MidiConfig_KeyDown"/>

                <TextBlock Text="{Binding Pad_MidiVelocity, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="12,0,4,0" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           ToolTip="{Binding Pad_MidiVelocityTooltip, Source={x:Static strings:Strings.Instance}}"/>
                <TextBox x:Name="MidiVelocityBox" Width="54" VerticalAlignment="Center"
                         TextAlignment="Center" Text="127"
                         LostFocus="MidiConfig_Changed" KeyDown="MidiConfig_KeyDown"/>
            </StackPanel>
        </Border>

        <!-- Expose Mappings count for UI Automation tests (invisible but accessible) -->
        <TextBlock AutomationProperties.AutomationId="MappingsCountIndicator"
                   AutomationProperties.Name="{Binding Mappings.Count}"
                   Width="0" Height="0" Opacity="0"/>

        <!-- ═══════════════════════════════════════════
             ROW 2: Configuration TabControl
             Tabs: Controller | Mappings | Left Stick | Right Stick | Triggers | Force Feedback | Macros
             ═══════════════════════════════════════════ -->
        <TabControl Grid.Row="2"
                    PreviewKeyDown="ConfigTabControl_PreviewKeyDown"
                    SelectedIndex="{Binding SelectedConfigTab, Mode=TwoWay}">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                      ContentSource="SelectedContent"/>
                </ControlTemplate>
            </TabControl.Template>

            <!-- ─── TAB 0: Controller (slot-level) ─── -->
            <TabItem>
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>      <!-- 3D viewport -->
                        <RowDefinition Height="Auto"/>   <!-- Motor bars -->
                        <RowDefinition Height="Auto"/>   <!-- Map All -->
                    </Grid.RowDefinitions>

                    <!-- Ember stage floor (#175): one continuous surface
                         under the model, the motor instruments, and Map All,
                         so the glow never seams at a row boundary. -->
                    <Border Grid.Row="0" Grid.RowSpan="3" IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush GradientOrigin="0.5,0.82" Center="0.5,0.82" RadiusX="0.55" RadiusY="0.45">
                                <GradientStop Color="#20FF6B2C" Offset="0"/>
                                <GradientStop Color="#00FF6B2C" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- ══════════════════════════════════════
                         CONTROLLER MODEL (2D / 3D)
                         ══════════════════════════════════════ -->
                    <Grid Grid.Row="0" AutomationProperties.AutomationId="ControllerModelHost">
                        <views:ControllerModelView x:Name="ControllerModel3D" />
                        <views:ControllerModel2DView x:Name="ControllerModel2D" Visibility="Collapsed" />
                        <views:ControllerSchematicView x:Name="ControllerSchematic" Visibility="Collapsed" />
                        <views:MidiPreviewView x:Name="MidiPreview" Visibility="Collapsed" />
                        <views:KBMPreviewView x:Name="KBMPreview" Visibility="Collapsed" />

                        <!-- 2D/3D toggle button (top-left to avoid overlap with 3D Reset View) -->
                        <Button x:Name="ViewModeToggle"
                                AutomationProperties.AutomationId="ViewModeToggle"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="8,8,0,0" Padding="6,4"
                                Click="ViewModeToggle_Click" ToolTip="{Binding Pad_SwitchTo2D, Source={x:Static strings:Strings.Instance}}">
                            <TextBlock x:Name="ViewModeIcon" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Text="&#xE8B9;"/>
                        </Button>
                    </Grid>

                    <!-- ══════════════════════════════════════
                         MOTOR ACTIVITY INDICATORS
                         ══════════════════════════════════════ -->
                    <!-- Symmetry with the Map All pill (user report
                         2026-07-05, re-raised: the 16px bars still read
                         thin against the fat button). Each meter is now a
                         capsule TWIN of MapAllPillButton: same 32px height,
                         same 16px corner radius, same SteelLineSoft
                         hairline. The mono caption sits INSIDE the capsule
                         and the ember fill slides underneath it, so at rest
                         the pair reads as two steel pills over a third. -->
                    <Grid x:Name="MotorBarsGrid" Grid.Row="1" Width="400" Margin="0,6,0,4" HorizontalAlignment="Center">
                        <Grid.Resources>
                            <!-- Capsule instrument: standard PART_Indicator
                                 template so ProgressBar owns the fill math.
                                 Track/indicator radii mirror the Map All
                                 pill's CornerRadius="16". -->
                            <ControlTemplate x:Key="MotorCapsuleTemplate" TargetType="ProgressBar">
                                <Grid>
                                    <Border CornerRadius="16"
                                            Background="{DynamicResource SteelGroundBrush}"
                                            BorderBrush="{DynamicResource SteelLineSoftBrush}"
                                            BorderThickness="1"/>
                                    <!-- PART_Track is the INSET area, not the outer
                                         capsule: ProgressBar sizes PART_Indicator
                                         against PART_Track's width, so when the
                                         track was the full-width border and the
                                         indicator carried Margin="1", a full fill
                                         overhung the capsule's right edge by that
                                         margin and clipped against the rounding
                                         (user report 2026-07-06). With the basis
                                         inset, a full fill ends exactly inside the
                                         hairline. Radius 15 nests inside the 16. -->
                                    <Grid x:Name="PART_Track" Margin="1">
                                        <Border x:Name="PART_Indicator" CornerRadius="15"
                                                HorizontalAlignment="Left">
                                            <!-- Ember bloom around the force fill (not the
                                                 capsule): the shadow is cast by the
                                                 indicator geometry, so at 0% the fill has
                                                 no width and no glow, and as force comes
                                                 through the bar lights up and its leading
                                                 edge glows, mirroring the card ember. -->
                                            <Border.Effect>
                                                <DropShadowEffect Color="#FF6B2C" BlurRadius="9"
                                                                  ShadowDepth="0" Opacity="0.6"/>
                                            </Border.Effect>
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#C43D0C" Offset="0"/>
                                                    <GradientStop Color="#FF6B2C" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </ControlTemplate>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Cursor="Hand" Margin="0,0,12,0"
                              MouseEnter="Motor_MouseEnter" MouseLeave="Motor_MouseLeave"
                              MouseLeftButtonDown="LeftMotor_Click"
                              ToolTip="{Binding Pad_TestLeftMotor, Source={x:Static strings:Strings.Instance}}"
                              Background="Transparent">
                            <ProgressBar Template="{StaticResource MotorCapsuleTemplate}" Height="32"
                                         Value="{Binding LeftMotorDisplay, Mode=OneWay}" Minimum="0" Maximum="1"
                                         IsHitTestVisible="False"/>
                            <!-- Button typography, not mono tokens (user report
                                 2026-07-05: the mono caps clashed with Map All
                                 below): these capsules are clickable test pills
                                 in the same family as the button, so their
                                 labels wear the button's face, size, and Title
                                 Case. -->
                            <TextBlock Text="{Binding Pad_LeftMotor, Source={x:Static strings:Strings.Instance}}"
                                       FontFamily="{StaticResource BodyFontFamily}" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>

                        <Grid Grid.Column="1" Cursor="Hand" Margin="12,0,0,0"
                              MouseEnter="Motor_MouseEnter" MouseLeave="Motor_MouseLeave"
                              MouseLeftButtonDown="RightMotor_Click"
                              ToolTip="{Binding Pad_TestRightMotor, Source={x:Static strings:Strings.Instance}}"
                              Background="Transparent">
                            <ProgressBar Template="{StaticResource MotorCapsuleTemplate}" Height="32"
                                         Value="{Binding RightMotorDisplay, Mode=OneWay}" Minimum="0" Maximum="1"
                                         IsHitTestVisible="False"/>
                            <TextBlock Text="{Binding Pad_RightMotor, Source={x:Static strings:Strings.Instance}}"
                                       FontFamily="{StaticResource BodyFontFamily}" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>

                    <!-- ══════════════════════════════════════
                         MAP ALL — Controller tab controls
                         ══════════════════════════════════════ -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,4">
                        <!-- Height pinned to the motor capsules' 32 so all
                             three pills share exact end curvature (radius
                             16 = height/2 on every one; the padding-driven
                             height landed a couple px taller and flattened
                             the arcs - user report 2026-07-05). -->
                        <ui:Button Content="{Binding MapAllButtonText}"
                                   Style="{StaticResource MapAllPillButton}"
                                   Height="32" Padding="18,0" FontSize="13"
                                   CornerRadius="16"
                                   Background="Transparent"
                                   MouseOverBackground="{DynamicResource SteelRaisedBrush}"
                                   BorderBrush="{DynamicResource SteelLineSoftBrush}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   ToolTip="{Binding MapAllButtonTooltip}"
                                   Click="MapAllToggle_Click"/>
                        <TextBlock Text="{Binding MapAllPromptText}" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="{DynamicResource EmberHotBrush}"
                                   Visibility="{Binding MapAllPromptText, Converter={StaticResource NullToCollapsedConverter}}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ─── TAB 1: Macros (slot-level) ─── -->
            <TabItem>
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Macro list -->
                    <DockPanel Grid.Column="0">
                        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button AutomationProperties.AutomationId="MacroAddButton" Content="{Binding Common_Add, Source={x:Static strings:Strings.Instance}}" Command="{Binding AddMacroCommand}"
                                    Padding="8,4" Margin="0,0,4,4"/>
                            <Button AutomationProperties.AutomationId="MacroRemoveButton" Content="{Binding Common_Remove, Source={x:Static strings:Strings.Instance}}" Command="{Binding RemoveMacroCommand}"
                                    Padding="8,4" Margin="0,0,4,4"/>
                            <Button Content="{Binding Common_Duplicate, Source={x:Static strings:Strings.Instance}}" Command="{Binding DuplicateMacroCommand}"
                                    Padding="8,4" Margin="0,0,4,4"/>
                            <Button Content="{Binding Common_Copy, Source={x:Static strings:Strings.Instance}}" Command="{Binding CopyMacroCommand}"
                                    Padding="8,4" Margin="0,0,4,4"/>
                            <Button Content="{Binding Common_Paste, Source={x:Static strings:Strings.Instance}}" Command="{Binding PasteMacroCommand}"
                                    Padding="8,4" Margin="0,0,4,4"/>
                            <Button Content="{Binding Pad_CopyFrom, Source={x:Static strings:Strings.Instance}}" Command="{Binding CopyMacroFromCommand}"
                                    Padding="8,4" Margin="0,0,0,4"
                                    ToolTip="{Binding Pad_CopyFromTooltip, Source={x:Static strings:Strings.Instance}}"/>
                        </WrapPanel>

                        <ListBox ItemsSource="{Binding Macros}"
                                 SelectedItem="{Binding SelectedMacro, Mode=TwoWay}"
                                 TextSearch.TextPath="Name"
                                 ItemContainerStyle="{StaticResource EmberSelectListItem}">
                            <!-- #254 A-1: the scope dot marks layer-scoped
                                 macros so scope is visible without selecting
                                 each one, the layer-tab dot's sibling. -->
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{DynamicResource TextFillColorTertiaryBrush}"
                                                 Visibility="{Binding HasLayerScope, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="4" Margin="4,0"
                                  HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                  ResizeBehavior="PreviousAndNext"/>

                    <!-- Empty state (#175): cold guidance instead of a bare wall. -->
                    <Grid Grid.Column="2">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedMacro}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource FlameOuterGeometry}" Width="34" Height="34" Stretch="Uniform"
                                  Fill="Transparent" StrokeThickness="1.2"
                                  Stroke="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Macro_EmptyHint, Source={x:Static strings:Strings.Instance}}"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300"/>
                        </StackPanel>
                    </Grid>

                    <!-- Macro editor (shows when a macro is selected). Horizontal
                         scroll DISABLED: Auto handed infinite width to the whole
                         column, so nothing (action chips, wrapping text) could ever
                         wrap and the h-scrollbar engaged on any wide row. Disabled
                         constrains the content to the viewport so it wraps instead. -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="8"
                                  DataContext="{Binding SelectedMacro}"
                                  Visibility="{Binding DataContext.HasSelectedMacro,
                                      RelativeSource={RelativeSource AncestorType=TabItem},
                                      Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <!-- Macro name -->
                            <TextBlock Text="{Binding Macro_Name, Source={x:Static strings:Strings.Instance}}" FontWeight="SemiBold" Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,12"/>

                            <!-- Enabled -->
                            <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Common_Enabled, Source={x:Static strings:Strings.Instance}}" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                      Margin="0,0,0,12"/>

                            <!-- Trigger mode -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="3" CornerRadius="1.5" Margin="0,2,7,2"
                                        Background="{DynamicResource EmberBrush}"/>
                                <TextBlock Text="{Binding Macro_Trigger, Source={x:Static strings:Strings.Instance}}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Fire, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                           Width="80" Margin="0,0,8,0"/>
                                <ComboBox SelectedValue="{Binding TriggerMode, Mode=TwoWay}"
                                          SelectedValuePath="Tag" MinWidth="120">
                                    <ComboBoxItem Content="{Binding Macro_OnPress, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerMode.OnPress}"/>
                                    <ComboBoxItem Content="{Binding Macro_SinglePress, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerMode.SinglePress}"
                                                  ToolTip="{Binding Macro_SinglePress_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBoxItem Content="{Binding Macro_OnRelease, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerMode.OnRelease}"/>
                                    <ComboBoxItem Content="{Binding Macro_WhileHeld, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerMode.WhileHeld}"/>
                                    <ComboBoxItem Content="{Binding Macro_HoldForMs, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerMode.HoldForMs}"
                                                  ToolTip="{Binding Macro_HoldForMs_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBoxItem Content="{Binding Macro_ShortPress, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerMode.ShortPress}"
                                                  ToolTip="{Binding Macro_ShortPress_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBoxItem Content="{Binding Macro_DoublePress, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerMode.DoublePress}"
                                                  ToolTip="{Binding Macro_DoublePress_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBoxItem Content="{Binding Macro_TriplePress, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerMode.TriplePress}"
                                                  ToolTip="{Binding Macro_TriplePress_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBoxItem Content="{Binding Macro_Toggle, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerMode.Toggle}"
                                                  ToolTip="{Binding Macro_Toggle_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBoxItem Content="{Binding Macro_Turbo, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerMode.Turbo}"
                                                  ToolTip="{Binding Macro_Turbo_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBoxItem Content="{Binding Macro_Always, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerMode.Always}"/>
                                    <ComboBoxItem Content="{Binding Macro_CustomExpression, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerMode.CustomExpression}"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Macro layer scope (#254 A-1). Visible only when the slot
                                 has shift layers, the same gate the Mappings strip uses.
                                 "" = Any layer (the ungated default), "Base" and each
                                 layer scope the macro exactly like a mapping row. -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <!-- Visible when the slot HAS layers, or when this
                                     macro already carries a scope (audit C3): an
                                     imported or copied mask must stay visible and
                                     clearable even on a slot with no layers. -->
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.HasShiftLayers, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ShowsLayerRow}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Layer, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                           Width="80" Margin="0,0,8,0"
                                           ToolTip="{Binding Macro_Layer_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                <ComboBox MinWidth="160"
                                          ItemsSource="{Binding DataContext.MacroLayerChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedValue="{Binding LayerMask, Mode=TwoWay}"
                                          SelectedValuePath="LayerMask"
                                          DisplayMemberPath="LayerName"
                                          ToolTip="{Binding Macro_Layer_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                            </StackPanel>

                            <!-- Hold-threshold row (issue #9 wave 1b, B-8b). Visible only in
                                 On Hold mode: the macro fires once the trigger combo has been
                                 held this long; a shorter tap does nothing. -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                        Visibility="{Binding ShowsHoldTimeRow, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_TriggerHoldMs_Label, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                           Width="80" Margin="0,0,8,0"
                                           ToolTip="{Binding HoldTimeToolTip}"/>
                                <TextBox Text="{Binding TriggerHoldMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="80"
                                         ToolTip="{Binding HoldTimeToolTip}"/>
                                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <ui:Button Command="{Binding ResetTriggerHoldMsCommand}" Style="{StaticResource ResetButton}" Margin="8,0,0,0"/>
                            </StackPanel>

                            <!-- Press-window row (translator v17, shared with Triple
                                 Press per #238). Visible in Double Press and Triple
                                 Press modes: the macro fires when the trigger chains
                                 its presses within this window. The tooltip follows
                                 the active mode via TriggerPressWindowToolTip. -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                        Visibility="{Binding IsDoublePressMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_TriggerDoublePressMs_Label, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                           Width="80" Margin="0,0,8,0"
                                           ToolTip="{Binding TriggerPressWindowToolTip}"/>
                                <TextBox Text="{Binding TriggerDoublePressMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="80"
                                         ToolTip="{Binding TriggerPressWindowToolTip}"/>
                                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <ui:Button Command="{Binding ResetTriggerDoublePressMsCommand}" Style="{StaticResource ResetButton}" Margin="8,0,0,0"/>
                            </StackPanel>

                            <!-- Inline interval row (#238): visible in Turbo and Toggle,
                                 binding the SAME RepeatDelayMs the Repeat section edits.
                                 Both modes force until-release repeats in the engine, so
                                 the interval is their only live repeat setting (the turbo
                                 rate, or the while-latched pacing) and the dead Repeat
                                 section hides for them below. -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                        Visibility="{Binding ShowsInlineIntervalRow, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_RepeatInterval_Label, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                           Width="80" Margin="0,0,8,0"
                                           ToolTip="{Binding InlineIntervalToolTip}"/>
                                <TextBox Text="{Binding RepeatDelayMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="80"
                                         ToolTip="{Binding InlineIntervalToolTip}"/>
                                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <ui:Button Command="{Binding ResetRepeatDelayMsCommand}" Style="{StaticResource ResetButton}" Margin="8,0,0,0"/>
                            </StackPanel>

                            <!-- Custom-expression editor (visible only when TriggerMode = CustomExpression).
                                 Sits ABOVE the legacy trigger-combo block so it shares the same
                                 spot in the layout. Named `FormulaEditor` so the shared
                                 FormulaChip_Click / FormulaPreset_Click handlers in
                                 PadPage.xaml.cs find the right textbox (they walk up the visual
                                 tree looking for an ancestor named "FormulaEditor"). -->
                            <StackPanel x:Name="FormulaEditor"
                                        Visibility="{Binding IsCustomExpressionMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Margin="0,0,0,8">
                                <TextBlock Text="{Binding Macro_Expression_Header, Source={x:Static strings:Strings.Instance}}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBox x:Name="CustomFormulaBox"
                                         Text="{Binding TriggerExpression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource TelemetryFontFamily}"
                                         AcceptsReturn="False"
                                         AllowDrop="True"
                                         Padding="6,4"
                                         Margin="0,0,0,4">
                                    <TextBox.ToolTip>
                                        <TextBlock Text="{Binding Macro_Expression_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    </TextBox.ToolTip>
                                </TextBox>
                                <TextBlock Text="{Binding CustomExpressionStatus}"
                                           FontFamily="{StaticResource TelemetryFontFamily}"
                                           FontSize="11" Margin="0,0,0,6"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCustomExpressionInvalid}" Value="True">
                                                    <Setter Property="Foreground" Value="#E81123"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCustomExpressionWarning}" Value="True">
                                                    <Setter Property="Foreground" Value="#CA5010"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Chip palette: click to insert at caret, or drag onto the
                                     formula box. Reuses FormulaChip_Click + the drag-out
                                     handlers from the merge-mapping editor verbatim. -->
                                <TextBlock Text="{Binding Pad_Formula_Insert, Source={x:Static strings:Strings.Instance}}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="2,4,0,2"/>
                                <WrapPanel Margin="0,0,0,4">
                                    <WrapPanel.Resources>
                                        <Style x:Key="MacroFormulaChipStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                            <Setter Property="Padding" Value="6,2"/>
                                            <Setter Property="Margin" Value="0,0,3,3"/>
                                            <Setter Property="MinWidth" Value="28"/>
                                            <Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="FormulaChip_PreviewMouseLeftButtonDown"/>
                                            <EventSetter Event="PreviewMouseMove" Handler="FormulaChip_PreviewMouseMove"/>
                                            <!-- #175 hover-glow: based on DefaultButtonStyle
                                                 directly (not the page implicit), so the
                                                 neutral glow trigger rides here. -->
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </WrapPanel.Resources>
                                    <!-- Variable chips: a..z. Visibility tracks VariableCount so
                                         the palette only shows letters that bind to a real variable. -->
                                    <Button Content="a" Tag="a" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=0}"/>
                                    <Button Content="b" Tag="b" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=1}"/>
                                    <Button Content="c" Tag="c" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=2}"/>
                                    <Button Content="d" Tag="d" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=3}"/>
                                    <Button Content="e" Tag="e" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=4}"/>
                                    <Button Content="f" Tag="f" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=5}"/>
                                    <Button Content="g" Tag="g" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=6}"/>
                                    <Button Content="h" Tag="h" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=7}"/>
                                    <Button Content="i" Tag="i" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=8}"/>
                                    <Button Content="j" Tag="j" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=9}"/>
                                    <Button Content="k" Tag="k" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=10}"/>
                                    <Button Content="l" Tag="l" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=11}"/>
                                    <Button Content="m" Tag="m" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=12}"/>
                                    <Button Content="n" Tag="n" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=13}"/>
                                    <Button Content="o" Tag="o" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=14}"/>
                                    <Button Content="p" Tag="p" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=15}"/>
                                    <Button Content="q" Tag="q" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=16}"/>
                                    <Button Content="r" Tag="r" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=17}"/>
                                    <Button Content="s" Tag="s" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=18}"/>
                                    <Button Content="t" Tag="t" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=19}"/>
                                    <Button Content="u" Tag="u" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=20}"/>
                                    <Button Content="v" Tag="v" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=21}"/>
                                    <Button Content="w" Tag="w" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=22}"/>
                                    <Button Content="x" Tag="x" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=23}"/>
                                    <Button Content="y" Tag="y" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=24}"/>
                                    <Button Content="z" Tag="z" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=25}"/>
                                    <Border Width="6"/>
                                    <Button Content="+" Tag=" + " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Add, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="−" Tag=" - " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Subtract, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="×" Tag=" * " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Multiply, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="÷" Tag=" / " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Divide, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="−A" Tag="-a" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_NegateA, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="(" Tag="(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_OpenGroup, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content=")" Tag=")" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_CloseGroup, Source={x:Static strings:Strings.Instance}}"/>
                                    <Border Width="6"/>
                                    <Button Content="0" Tag="0" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click"/>
                                    <Button Content="½" Tag="0.5" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Half, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="1" Tag="1" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click"/>
                                    <Button Content="2" Tag="2" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click"/>
                                    <Border Width="6"/>
                                    <Button Content="&lt;" Tag=" &lt; " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_LessThan, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="&gt;" Tag=" &gt; " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_GreaterThan, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="≤" Tag=" &lt;= " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_LessOrEqual, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="≥" Tag=" &gt;= " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_GreaterOrEqual, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="=" Tag=" == " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Equal, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="≠" Tag=" != " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_NotEqual, Source={x:Static strings:Strings.Instance}}"/>
                                    <Border Width="6"/>
                                    <Button Content="and" Tag=" &amp;&amp; " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_BothConditions, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="or" Tag=" || " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_EitherCondition, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="not" Tag="!" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_FlipBool, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="if?" Tag=" ? " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_If, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="else:" Tag=" : " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Else, Source={x:Static strings:Strings.Instance}}"/>
                                    <Border Width="6"/>
                                    <Button Content="abs" Tag="abs(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Abs, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="min" Tag="min(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Min, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="max" Tag="max(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Max, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="clamp" Tag="clamp(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Clamp, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="sign" Tag="sign(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Sign, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="lerp" Tag="lerp(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Lerp, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="round" Tag="round(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Round, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="sqrt" Tag="sqrt(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Sqrt, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="," Tag=", " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click"/>
                                </WrapPanel>

                                <!-- Starter recipes — common trigger patterns. Each button's
                                     Tag is the full formula; clicking replaces the box text. -->
                                <TextBlock Text="{Binding Pad_Formula_StarterRecipes, Source={x:Static strings:Strings.Instance}}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="2,2,0,2"/>
                                <WrapPanel Margin="0,0,0,6">
                                    <WrapPanel.Resources>
                                        <Style x:Key="MacroFormulaPresetStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                            <Setter Property="Padding" Value="8,3"/>
                                            <Setter Property="Margin" Value="0,0,4,3"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <!-- #175 hover-glow: DefaultButtonStyle bypasses
                                                 the implicit Button glow, so it rides here. -->
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </WrapPanel.Resources>
                                    <Button Content="{Binding Macro_Expression_Recipe_Single, Source={x:Static strings:Strings.Instance}}" Tag="a"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Macro_Expression_Recipe_Single_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Macro_Expression_Recipe_Both, Source={x:Static strings:Strings.Instance}}" Tag="a &amp;&amp; b"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Macro_Expression_Recipe_Both_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Macro_Expression_Recipe_Either, Source={x:Static strings:Strings.Instance}}" Tag="a || b"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Macro_Expression_Recipe_Either_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Macro_Expression_Recipe_AButNotB, Source={x:Static strings:Strings.Instance}}" Tag="a &amp;&amp; !b"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Macro_Expression_Recipe_AButNotB_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Macro_Expression_Recipe_AxisOverHalf, Source={x:Static strings:Strings.Instance}}" Tag="abs(a - 0.5) &gt; 0.25"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Macro_Expression_Recipe_AxisOverHalf_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <!-- Shared recipes from the merge-mapping editor. Same Pad_Formula_Preset_*
                                         keys, already translated across all 10 locales. -->
                                    <Button Content="{Binding Pad_Formula_Preset_HalfScale_Name, Source={x:Static strings:Strings.Instance}}" Tag="a * 0.5"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Pad_Formula_Preset_HalfScale_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Formula_Preset_QuarterScale_Name, Source={x:Static strings:Strings.Instance}}" Tag="a * 0.25"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Pad_Formula_Preset_QuarterScale_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Formula_Preset_ReverseA_Name, Source={x:Static strings:Strings.Instance}}" Tag="-a"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Pad_Formula_Preset_ReverseA_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Formula_Preset_CapTo1_Name, Source={x:Static strings:Strings.Instance}}" Tag="clamp(a + b, -1, 1)"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Pad_Formula_Preset_CapTo1_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Formula_Preset_WeightedBlend_Name, Source={x:Static strings:Strings.Instance}}" Tag="a * 0.7 + b * 0.3"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Pad_Formula_Preset_WeightedBlend_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Formula_Preset_Difference_Name, Source={x:Static strings:Strings.Instance}}" Tag="a - b"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Pad_Formula_Preset_Difference_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Formula_Preset_AUnlessIdle_Name, Source={x:Static strings:Strings.Instance}}" Tag="a != 0 ? a : b"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Pad_Formula_Preset_AUnlessIdle_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Formula_Preset_ThresholdGate_Name, Source={x:Static strings:Strings.Instance}}" Tag="(a &gt; 0.5) ? 1 : 0"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Pad_Formula_Preset_ThresholdGate_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Formula_Preset_BothPressed_Name, Source={x:Static strings:Strings.Instance}}" Tag="(a &gt; 0) &amp;&amp; (b &gt; 0) ? 1 : 0"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Pad_Formula_Preset_BothPressed_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Formula_Preset_StrongerWins_Name, Source={x:Static strings:Strings.Instance}}" Tag="max(abs(a), abs(b)) * sign(a + b)"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Pad_Formula_Preset_StrongerWins_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                </WrapPanel>

                                <!-- Variable list. Each row binds one variable to either an
                                     input-device input or an output-controller channel. -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Macro_Expression_Variables, Source={x:Static strings:Strings.Instance}}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <Button Content="{Binding Macro_Expression_AddVariable, Source={x:Static strings:Strings.Instance}}"
                                            Command="{Binding AddExpressionVariableCommand}"
                                            Padding="8,2"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding TriggerExpressionVariables}"
                                              AlternationCount="32">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource TextFillColorTertiaryBrush}"
                                                    BorderThickness="1" CornerRadius="3"
                                                    Padding="6,4" Margin="0,0,0,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource IndexToLetterConverter}}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"
                                                               FontFamily="{StaticResource TelemetryFontFamily}"
                                                               FontWeight="SemiBold"/>
                                                    <ComboBox SelectedValue="{Binding Source, Mode=TwoWay}"
                                                              SelectedValuePath="Tag" MinWidth="140" Margin="0,0,8,0">
                                                        <ComboBoxItem Content="{Binding Macro_InputDevice, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerSource.InputDevice}"/>
                                                        <ComboBoxItem Content="{Binding Macro_OutputController, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerSource.OutputController}"/>
                                                    </ComboBox>
                                                    <!-- OutputChannel dropdown — items are sourced from the
                                                         parent macro's OutputChannelOptions list, which renders
                                                         labels per the slot's VC family (matches the mapping
                                                         table: PlayStation ✕/○/◻/△ + L1/R1, Extended
                                                         Button N, Xbox A/B/X/Y + Left Shoulder, etc.). -->
                                                    <ComboBox ItemsSource="{Binding DataContext.OutputChannelOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              SelectedValue="{Binding OutputChannel, Mode=TwoWay}"
                                                              SelectedValuePath="Value"
                                                              DisplayMemberPath="Name"
                                                              MinWidth="160" Margin="0,0,8,0"
                                                              Visibility="{Binding Source, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=OutputController}"/>
                                                    <TextBlock Text="{Binding DisplaySummary}"
                                                               VerticalAlignment="Center"
                                                               FontStyle="Italic"
                                                               TextTrimming="CharacterEllipsis"
                                                               MinWidth="120"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Visibility="{Binding Source, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=InputDevice}"/>
                                                    <!-- Record / Stop button. Works for both Input Device
                                                         (captures the next press / axis on a physical device)
                                                         and Output Controller (captures the next change on the
                                                         slot's combined Gamepad output). Shares the
                                                         EmberIconButtonHot chrome with the merge-mapping
                                                         per-source Record buttons for visual parity. -->
                                                    <ui:Button Command="{Binding RecordCommand}"
                                                               Style="{StaticResource EmberIconButtonHot}"
                                                               VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RecordIcon}" FontFamily="Segoe MDL2 Assets"
                                                                   Foreground="{DynamicResource EmberBrush}"/>
                                                        <ui:Button.ToolTip>
                                                            <TextBlock Text="{Binding RecordTooltip}"/>
                                                        </ui:Button.ToolTip>
                                                    </ui:Button>
                                                    <!-- Clear binding button. Keeps the variable slot but
                                                         resets the device/channel binding. -->
                                                    <ui:Button Command="{Binding ClearBindingCommand}"
                                                               Style="{StaticResource EmberIconButtonHot}"
                                                               VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE75C;" FontFamily="Segoe MDL2 Assets"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                        <ui:Button.ToolTip>
                                                            <TextBlock Text="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}"/>
                                                        </ui:Button.ToolTip>
                                                    </ui:Button>
                                                    <!-- Delete variable button. Removes the row from the
                                                         macro's variable list. Subsequent variables shift
                                                         letters (b becomes a, etc.). Binds back up to the
                                                         macro via RelativeSource AncestorType=ItemsControl. -->
                                                    <ui:Button Style="{StaticResource EmberIconButtonHot}"
                                                               VerticalAlignment="Center"
                                                               Command="{Binding DataContext.RemoveExpressionVariableCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding}">
                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                        <ui:Button.ToolTip>
                                                            <TextBlock Text="{Binding Common_Delete, Source={x:Static strings:Strings.Instance}}"/>
                                                        </ui:Button.ToolTip>
                                                    </ui:Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding Macro_Expression_Hint, Source={x:Static strings:Strings.Instance}}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Trigger combination (visible only when one of OnPress / OnRelease / WhileHeld) -->
                            <StackPanel Visibility="{Binding ShowsTriggerComboEditor, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Source, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                               Width="80" Margin="0,0,8,0"/>
                                    <ComboBox SelectedValue="{Binding TriggerSource, Mode=TwoWay}"
                                              SelectedValuePath="Tag" MinWidth="160">
                                        <ComboBoxItem Content="{Binding Macro_InputDevice, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerSource.InputDevice}"/>
                                        <ComboBoxItem Content="{Binding Macro_OutputController, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerSource.OutputController}"/>
                                    </ComboBox>
                                </StackPanel>
                                <!-- Dropdown trigger picker (#177): appends an input to the
                                     combo without recording. The list is the slot's cross-device
                                     choices filtered to entry-convertible descriptors, so the
                                     touchpad gestures the user enabled on the Touchpad tab are
                                     pickable here (recording can't capture them, and the issue
                                     reporter explicitly did not want it to). Kept aligned under
                                     the Source dropdown. -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding Macro_AddTriggerFromList, Source={x:Static strings:Strings.Instance}}"
                                               Width="80" Margin="0,0,8,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding DataContext.SlotMacroTriggerChoicesView, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              DisplayMemberPath="DisplayName" MinWidth="220" Padding="4,2"
                                              SelectionChanged="MacroTriggerPick_SelectionChanged"
                                              PreviewKeyDown="MacroTriggerPick_PreviewKeyDown"
                                              IsTextSearchEnabled="False"
                                              ToolTip="{Binding Macro_AddTriggerFromList_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                              ScrollViewer.VerticalScrollBarVisibility="Visible">
                                        <ComboBox.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,3,6,3">
                                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ComboBox.GroupStyle>
                                    </ComboBox>
                                </StackPanel>
                                <!-- Record + Clear all, above the list like the action sequence's
                                     Add / Remove / Duplicate sit above its list. -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ui:Button Command="{Binding RecordTriggerCommand}" Style="{StaticResource EmberIconButtonHot}">
                                        <TextBlock Text="{Binding RecordTriggerIcon}" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource EmberBrush}"/>
                                        <ui:Button.ToolTip>
                                            <TextBlock Text="{Binding RecordTriggerButtonText}"/>
                                        </ui:Button.ToolTip>
                                    </ui:Button>
                                    <ui:Button Command="{Binding ClearTriggerCommand}" Style="{StaticResource EmberIconButtonHot}">
                                        <TextBlock Text="&#xE75C;" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <ui:Button.ToolTip>
                                            <TextBlock Text="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}"/>
                                        </ui:Button.ToolTip>
                                    </ui:Button>
                                </StackPanel>
                                <TextBlock Text="{Binding Macro_RecordHint, Source={x:Static strings:Strings.Instance}}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,0,4"/>
                                <!-- Live preview of what's being recorded, just above the list. -->
                                <TextBlock Text="{Binding RecordingLiveText}" FontWeight="SemiBold" Margin="0,0,0,4"
                                           Visibility="{Binding IsRecordingTrigger, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <!-- Trigger inputs as a scrollable list, one removable row per
                                     input, in the same steel-lined well the action sequence uses.
                                     Each input keeps the mapping grid's cold chip grammar
                                     (#175 item 80); the X drops just that input. -->
                                <Border BorderBrush="{DynamicResource SteelLineBrush}" BorderThickness="1"
                                        CornerRadius="6" Background="{DynamicResource SteelRaisedBrush}"
                                        Padding="4" Margin="0,0,0,4">
                                    <Grid>
                                        <TextBlock Text="{Binding Macro_NotSet, Source={x:Static strings:Strings.Instance}}"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Margin="4,2" VerticalAlignment="Center"
                                                   Visibility="{Binding HasTriggerInputItems, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                        <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      Visibility="{Binding HasTriggerInputItems, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <!-- Right inset clears the 14px always-on overlay scrollbar so it
                                                 doesn't sit on top of the row X buttons. -->
                                            <ItemsControl ItemsSource="{Binding TriggerInputItems}" Margin="0,0,16,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <Border Style="{StaticResource ChipCold}" HorizontalAlignment="Left">
                                                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                                                                </Border>
                                                                <!-- Axis rows only: Invert / Half / Either + a labeled
                                                                     Deadzone. Folded in from what used to be a second,
                                                                     duplicate axis list, and the bare "%" now reads
                                                                     "Deadzone". Wraps if the row is narrow. -->
                                                                <WrapPanel Orientation="Horizontal" Margin="0,3,0,1"
                                                                           Visibility="{Binding IsAxis, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Invert, Source={x:Static strings:Strings.Instance}}"
                                                                              IsChecked="{Binding AxisEntry.Invert, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              IsEnabled="{Binding AxisEntry.IsInvertApplicable}"
                                                                              VerticalAlignment="Center" Margin="0,0,6,2"/>
                                                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Half, Source={x:Static strings:Strings.Instance}}"
                                                                              IsChecked="{Binding AxisEntry.HalfAxis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              VerticalAlignment="Center" Margin="0,0,6,2"/>
                                                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Either, Source={x:Static strings:Strings.Instance}}"
                                                                              ToolTip="{Binding Pad_Either_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                                              IsChecked="{Binding AxisEntry.Bidirectional, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              IsEnabled="{Binding AxisEntry.HalfAxis}"
                                                                              VerticalAlignment="Center" Margin="0,0,10,2"/>
                                                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Sticks_Section_DeadZone, Source={x:Static strings:Strings.Instance}}"
                                                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                    <Slider Style="{StaticResource DzSlider}" Width="120" Minimum="1"
                                                                            Value="{Binding AxisEntry.DeadZone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                            TickFrequency="1"/>
                                                                    <TextBox Text="{Binding AxisEntry.DeadZone, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                             Style="{StaticResource DzValueEdit}"/>
                                                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                                    <ui:Button Command="{Binding AxisEntry.ResetDeadZoneCommand}" Style="{StaticResource ResetButton}"/>
                                                                </WrapPanel>
                                                            </StackPanel>
                                                            <ui:Button Grid.Column="1" Command="{Binding RemoveCommand}"
                                                                       Style="{StaticResource EmberIconButtonHot}"
                                                                       VerticalAlignment="Top">
                                                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                                <ui:Button.ToolTip>
                                                                    <TextBlock Text="{Binding Macro_RemoveTriggerInput, Source={x:Static strings:Strings.Instance}}"/>
                                                                </ui:Button.ToolTip>
                                                            </ui:Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                                <!-- Legacy slot-combined axis Threshold + Direction. Visible
                                     only for OutputController-source triggers that landed in
                                     the slot-combined TriggerAxisTargets list — InputDevice
                                     triggers go through the per-device axis entries below and
                                     carry their own Invert / Half / DeadZone, so these
                                     duplicate controls would just be redundant + confusing. -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                            Visibility="{Binding HasLegacyAxisTrigger, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Threshold, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <Slider Value="{Binding TriggerAxisThreshold, Mode=TwoWay}"
                                            Minimum="1" Maximum="100" Width="150"
                                            VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding TriggerAxisThreshold, Mode=OneWay}"/>
                                        <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="%"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                            Visibility="{Binding HasLegacyAxisTrigger, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_AxisDirection, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <ComboBox SelectedIndex="{Binding TriggerAxisDirectionIndex, Mode=TwoWay}" MinWidth="120">
                                        <ComboBoxItem Content="{Binding Macro_AxisDirection_Any, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Macro_AxisDirection_Positive, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Macro_AxisDirection_Negative, Source={x:Static strings:Strings.Instance}}"/>
                                    </ComboBox>
                                </StackPanel>

                                <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Macro_ConsumeTrigger, Source={x:Static strings:Strings.Instance}}"
                                          ToolTip="{Binding Macro_ConsumeTrigger_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                          IsChecked="{Binding ConsumeTriggerButtons, Mode=TwoWay}"
                                          Margin="0,0,0,4"/>
                            </StackPanel>

                            <!-- Always mode note -->
                            <TextBlock Text="{Binding Macro_AlwaysDesc, Source={x:Static strings:Strings.Instance}}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,4"
                                       Visibility="{Binding IsNotAlwaysMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>

                            <Separator Margin="0,4,0,12"/>

                            <!-- Action sequence -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="3" CornerRadius="1.5" Margin="0,2,7,2"
                                        Background="{DynamicResource EmberBrush}"/>
                                <TextBlock Text="{Binding Macro_ActionSequence, Source={x:Static strings:Strings.Instance}}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="{Binding Macro_AddAction, Source={x:Static strings:Strings.Instance}}" Command="{Binding AddActionCommand}"
                                        Padding="8,4" Margin="0,0,4,0"/>
                                <Button Content="{Binding Common_Remove, Source={x:Static strings:Strings.Instance}}" Command="{Binding RemoveActionCommand}"
                                        Padding="8,4" Margin="0,0,4,0"/>
                                <Button Content="{Binding Common_Duplicate, Source={x:Static strings:Strings.Instance}}" Command="{Binding DuplicateActionCommand}"
                                        Padding="8,4"/>
                            </StackPanel>
                            <!-- Action steps as ember dst chips (#175 item 80):
                                 each step writes output, so the rows inherit the
                                 mapping grid's ember chip grammar. Selection and
                                 interaction stay on the ListBox container. -->
                            <!-- Bounding box so the sequence reads as one list (user
                                 report): a steel-lined well. Drag a chip to reorder;
                                 the drop commits Actions.Move (handlers in code-behind). -->
                            <Border BorderBrush="{DynamicResource SteelLineBrush}" BorderThickness="1"
                                    CornerRadius="6" Background="{DynamicResource SteelRaisedBrush}"
                                    Padding="4" Margin="0,0,0,4">
                                <ListBox x:Name="ActionsList" ItemsSource="{Binding Actions}"
                                         SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                                         ItemContainerStyle="{StaticResource EmberSelectListItem}"
                                         Background="Transparent" BorderThickness="0"
                                         MinHeight="100" MaxHeight="200"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         AllowDrop="True"
                                         PreviewMouseLeftButtonDown="ActionsList_PreviewMouseLeftButtonDown"
                                         PreviewMouseMove="ActionsList_PreviewMouseMove"
                                         DragOver="ActionsList_DragOver"
                                         Drop="ActionsList_Drop">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Wrap long summaries (e.g. a multi-button Button Press)
                                                 instead of running off the edge. The list disables
                                                 horizontal scroll so the chip is width-constrained and
                                                 the text wraps to a second line. -->
                                            <Border Style="{StaticResource ChipEmber}"
                                                    HorizontalAlignment="Left" Margin="0,1">
                                                <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap"/>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <!-- Action editor (shows when an action is selected) -->
                            <Border BorderBrush="{DynamicResource TextFillColorTertiaryBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,12"
                                    DataContext="{Binding SelectedAction}"
                                    Visibility="{Binding DataContext.SelectedAction,
                                        RelativeSource={RelativeSource AncestorType=ScrollViewer},
                                        Converter={StaticResource NullToCollapsedConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Macro_EditAction, Source={x:Static strings:Strings.Instance}}" FontWeight="SemiBold" Margin="0,0,0,8"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                    <!-- Action type -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_ActionType, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                   Width="80" Margin="0,0,8,0"/>
                                        <ComboBox SelectedValue="{Binding Type, Mode=TwoWay}"
                                                  SelectedValuePath="Tag" MinWidth="150">
                                            <ComboBoxItem Content="{Binding Macro_ButtonPress, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroActionType.ButtonPress}"/>
                                            <ComboBoxItem Content="{Binding Macro_ButtonRelease, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroActionType.ButtonRelease}"/>
                                            <ComboBoxItem Content="{Binding Macro_KeyPress, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroActionType.KeyPress}"/>
                                            <ComboBoxItem Content="{Binding Macro_KeyRelease, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroActionType.KeyRelease}"/>
                                            <ComboBoxItem Content="{Binding Macro_Delay, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroActionType.Delay}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_ComboBreak, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.ComboBreak}"
                                                          ToolTip="{Binding MacroAction_ComboBreak_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding Macro_SetAxis, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroActionType.AxisSet}"/>
                                            <ComboBoxItem Content="{Binding Macro_SystemVolume, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroActionType.SystemVolume}"/>
                                            <ComboBoxItem Content="{Binding Macro_AppVolume, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroActionType.AppVolume}"/>
                                            <ComboBoxItem Content="{Binding Macro_MouseMove, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroActionType.MouseMove}"/>
                                            <ComboBoxItem Content="{Binding Macro_MouseButtonPress, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroActionType.MouseButtonPress}"/>
                                            <ComboBoxItem Content="{Binding Macro_MouseButtonRelease, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroActionType.MouseButtonRelease}"/>
                                            <ComboBoxItem Content="{Binding Macro_MouseScroll, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroActionType.MouseScroll}"/>
                                            <ComboBoxItem Content="{Binding Macro_ToggleTouchpadOverlay, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroActionType.ToggleTouchpadOverlay}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_LightbarColor, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.LightbarColor}"
                                                          ToolTip="{Binding MacroAction_LightbarColor_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_LightbarColorClear, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.LightbarColorClear}"
                                                          ToolTip="{Binding MacroAction_LightbarColorClear_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_LightbarModeSet, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.LightbarModeSet}"
                                                          ToolTip="{Binding MacroAction_LightbarModeSet_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_LightbarModeCycle, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.LightbarModeCycle}"
                                                          ToolTip="{Binding MacroAction_LightbarModeCycle_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_PointerModeCycle, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.PointerModeCycle}"
                                                          ToolTip="{Binding MacroAction_PointerModeCycle_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_PointerModeSet, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.PointerModeSet}"
                                                          ToolTip="{Binding MacroAction_PointerModeSet_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_GuideLedBrightness, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.GuideLedBrightness}"
                                                          ToolTip="{Binding MacroAction_GuideLedBrightness_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_Rumble, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.Rumble}"
                                                          ToolTip="{Binding MacroAction_Rumble_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_RumbleStop, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.RumbleStop}"
                                                          ToolTip="{Binding MacroAction_RumbleStop_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_RumbleTrigger, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.RumbleTrigger}"
                                                          ToolTip="{Binding MacroAction_RumbleTrigger_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_RumbleTriggerStop, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.RumbleTriggerStop}"
                                                          ToolTip="{Binding MacroAction_RumbleTriggerStop_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_PlaySound, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.PlaySound}"
                                                          ToolTip="{Binding MacroAction_PlaySound_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_SoundStop, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.SoundStop}"
                                                          ToolTip="{Binding MacroAction_SoundStop_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding Macro_SetGyroEngaged, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.SetGyroEngaged}"
                                                          ToolTip="{Binding Macro_SetGyroEngaged_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_GyroRecenter, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.GyroRecenter}"
                                                          ToolTip="{Binding MacroAction_GyroRecenter_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_MouseRecenter, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.MouseRecenter}"
                                                          ToolTip="{Binding MacroAction_MouseRecenter_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_MouseFixPosition, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.MouseFixPosition}"
                                                          ToolTip="{Binding MacroAction_MouseFixPosition_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_MouseLimitRegion, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.MouseLimitRegion}"
                                                          ToolTip="{Binding MacroAction_MouseLimitRegion_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_MoveMouseToScreenPosition, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.MoveMouseToScreenPosition}"
                                                          ToolTip="{Binding MacroAction_MoveMouseToScreenPosition_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_RepeatKeyWhileHeld, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.RepeatKeyWhileHeld}"
                                                          ToolTip="{Binding MacroAction_RepeatKeyWhileHeld_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_RepeatVcButtonWhileHeld, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.RepeatVcButtonWhileHeld}"
                                                          ToolTip="{Binding MacroAction_RepeatVcButtonWhileHeld_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_ToggleVcButton, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.ToggleVcButton}"
                                                          ToolTip="{Binding MacroAction_ToggleVcButton_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_ToggleKey, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.ToggleKey}"
                                                          ToolTip="{Binding MacroAction_ToggleKey_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_AxisHold, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.AxisHold}"
                                                          ToolTip="{Binding MacroAction_AxisHold_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_AxisAdd, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.AxisAdd}"
                                                          ToolTip="{Binding MacroAction_AxisAdd_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_AxisScale, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.AxisScale}"
                                                          ToolTip="{Binding MacroAction_AxisScale_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_AxisSetLatched, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.AxisSetLatched}"
                                                          ToolTip="{Binding MacroAction_AxisSetLatched_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_AxisLatchRelease, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.AxisLatchRelease}"
                                                          ToolTip="{Binding MacroAction_AxisLatchRelease_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_MouseWheelTap, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.MouseWheelTap}"
                                                          ToolTip="{Binding MacroAction_MouseWheelTap_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_MouseNudge, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.MouseNudge}"
                                                          ToolTip="{Binding MacroAction_MouseNudge_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_CycleTapList, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.CycleTapList}"
                                                          ToolTip="{Binding MacroAction_CycleTapList_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_ToggleMouseButton, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.ToggleMouseButton}"
                                                          ToolTip="{Binding MacroAction_ToggleMouseButton_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_ToggleVcAxis, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.ToggleVcAxis}"
                                                          ToolTip="{Binding MacroAction_ToggleVcAxis_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_RepeatVcAxisWhileHeld, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.RepeatVcAxisWhileHeld}"
                                                          ToolTip="{Binding MacroAction_RepeatVcAxisWhileHeld_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_ToggleWheel, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.ToggleWheel}"
                                                          ToolTip="{Binding MacroAction_ToggleWheel_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_DisconnectController, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.DisconnectController}"
                                                          ToolTip="{Binding MacroAction_DisconnectController_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_RunProgram, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.RunProgram}"
                                                          ToolTip="{Binding MacroAction_RunProgram_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_TextBlock, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.TextBlock}"
                                                          ToolTip="{Binding MacroAction_TextBlock_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Disconnect Controller editor (#162). Target mode + device picker -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsDisconnectControllerType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MacroDisconnect_Target_Label, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <ComboBox SelectedValue="{Binding DisconnectTarget, Mode=TwoWay}"
                                                      SelectedValuePath="Tag"
                                                      Width="220" VerticalAlignment="Center"
                                                      ToolTip="{Binding MacroAction_DisconnectController_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                                <ComboBoxItem Content="{Binding MacroDisconnect_TriggeringDevice, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroDisconnectTarget.TriggeringDevice}"/>
                                                <ComboBoxItem Content="{Binding MacroDisconnect_SpecificDevice, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroDisconnectTarget.SpecificDevice}"/>
                                                <ComboBoxItem Content="{Binding MacroDisconnect_SlotDevices, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroDisconnectTarget.SlotDevices}"/>
                                                <ComboBoxItem Content="{Binding MacroDisconnect_AllDevices, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroDisconnectTarget.AllDevices}"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                                    Visibility="{Binding IsDisconnectSpecificDevice, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MacroDisconnect_Device_Label, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <ComboBox ItemsSource="{Binding DisconnectDeviceOptions}"
                                                      SelectedValue="{Binding DisconnectDeviceGuid, Mode=TwoWay}"
                                                      SelectedValuePath="Guid" DisplayMemberPath="Name"
                                                      Width="220" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding MacroDisconnect_Caveat, Source={x:Static strings:Strings.Instance}}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Run Program editor. Same 80px label column as every other
                                         editor so the fields line up with the type dropdown. The
                                         Working directory label wraps to a second line rather than clip. -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsRunProgramType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MacroAction_RunProgram_Path, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding ProgramPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="220" VerticalAlignment="Center"/>
                                            <Button Content="{Binding Common_Browse, Source={x:Static strings:Strings.Instance}}"
                                                    Click="RunProgramBrowseFile_Click" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MacroAction_RunProgram_Args, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding ProgramArgs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="220" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MacroAction_RunProgram_WorkingDir, Source={x:Static strings:Strings.Instance}}"
                                                       ToolTip="{Binding MacroAction_RunProgram_WorkingDir_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding ProgramWorkingDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="{Binding MacroAction_RunProgram_WorkingDir_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                     Width="220" VerticalAlignment="Center"/>
                                            <Button Content="{Binding Common_Browse, Source={x:Static strings:Strings.Instance}}"
                                                    Click="RunProgramBrowseFolder_Click" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Text Block editor (#201). Multiline text typed out via
                                         Unicode injection; newlines press Enter, tab CHARACTERS
                                         press Tab. AcceptsTab stays off on purpose: the Tab key
                                         keeps moving focus between fields, so a tab character
                                         only enters the text via paste (the tooltip says so).
                                         Same 80px label column as the other editors. -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsTextBlockType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MacroAction_TextBlock_Text, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" TextWrapping="Wrap" VerticalAlignment="Top"/>
                                            <TextBox Text="{Binding TextContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="{Binding MacroAction_TextBlock_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                     Width="220" Height="64" AcceptsReturn="True"
                                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                     VerticalContentAlignment="Top"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MacroAction_TextBlock_Delay, Source={x:Static strings:Strings.Instance}}"
                                                       ToolTip="{Binding MacroAction_TextBlock_Delay_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <!-- Commits on LostFocus like every sibling int box in this
                                                 editor. PropertyChanged would push each intermediate
                                                 keystroke (typing 500 commits 5, then 50, then 500)
                                                 live into a running macro's pacing. -->
                                            <TextBox Text="{Binding TextPerCharDelayMs, Mode=TwoWay}"
                                                     ToolTip="{Binding MacroAction_TextBlock_Delay_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                     Width="60" TextAlignment="Center" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- SetGyroEngaged Mode picker: Toggle / On / Off -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                                Visibility="{Binding IsSetGyroEngagedType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_SetGyroEngaged_Mode_Label, Source={x:Static strings:Strings.Instance}}"
                                                   Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <ComboBox SelectedValue="{Binding SetGyroEngagedMode, Mode=TwoWay}"
                                                  SelectedValuePath="Tag"
                                                  Width="160" VerticalAlignment="Center"
                                                  ScrollViewer.VerticalScrollBarVisibility="Visible"
                                                  ToolTip="{Binding Macro_SetGyroEngaged_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                            <ComboBoxItem Content="{Binding Macro_SetGyroEngaged_Toggle, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroSetGyroEngagedMode.Toggle}"/>
                                            <ComboBoxItem Content="{Binding Macro_SetGyroEngaged_On, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroSetGyroEngagedMode.On}"/>
                                            <ComboBoxItem Content="{Binding Macro_SetGyroEngaged_Off, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroSetGyroEngagedMode.Off}"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Gyro Recenter card (issue #9 wave 1b, B-18). Parameter-less;
                                         the card explains what one fire resets, mirroring the Stop
                                         Sounds card shape. -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6"
                                            Visibility="{Binding IsGyroRecenterType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MacroAction_Type_GyroRecenter, Source={x:Static strings:Strings.Instance}}"
                                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding MacroAction_GyroRecenter_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Combo Break card (discussion #237). Parameter-less. The card
                                         explains the park and resume behavior, mirroring the Gyro
                                         Recenter card shape. -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6"
                                            Visibility="{Binding IsComboBreakType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MacroAction_Type_ComboBreak, Source={x:Static strings:Strings.Instance}}"
                                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding MacroAction_ComboBreak_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Cursor Recenter Mode picker (#108). X / Y / X+Y -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                                Visibility="{Binding IsMouseRecenterType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_CursorRecenterMode_Label, Source={x:Static strings:Strings.Instance}}"
                                                   Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <ComboBox SelectedValue="{Binding CursorRecenterMode, Mode=TwoWay}"
                                                  SelectedValuePath="Tag"
                                                  Width="160" VerticalAlignment="Center"
                                                  ToolTip="{Binding MacroAction_MouseRecenter_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                            <ComboBoxItem Content="X+Y" Tag="{x:Static vm:CursorRecenterMode.XAndY}"/>
                                            <ComboBoxItem Content="X" Tag="{x:Static vm:CursorRecenterMode.XOnly}"/>
                                            <ComboBoxItem Content="Y" Tag="{x:Static vm:CursorRecenterMode.YOnly}"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Fix Mouse Position editor (#109). Mode + Pin X / Pin Y -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsMouseFixPositionType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_CursorPinMode_Label, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <ComboBox SelectedValue="{Binding CursorPinMode, Mode=TwoWay}"
                                                      SelectedValuePath="Tag"
                                                      Width="160" VerticalAlignment="Center"
                                                      ToolTip="{Binding MacroAction_MouseFixPosition_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                                <ComboBoxItem Content="X+Y" Tag="{x:Static vm:CursorPinMode.XAndY}"/>
                                                <ComboBoxItem Content="X" Tag="{x:Static vm:CursorPinMode.XOnly}"/>
                                                <ComboBoxItem Content="Y" Tag="{x:Static vm:CursorPinMode.YOnly}"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_CursorPinX_Label, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding CursorPinX, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                     Width="80" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_CursorPinY_Label, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding CursorPinY, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                     Width="80" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Macro_CursorWrite_Caveat, Source={x:Static strings:Strings.Instance}}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Limit Mouse Region editor (#110). Mode + Inset X / Inset Y -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsMouseLimitRegionType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_CursorClampMode_Label, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <ComboBox SelectedValue="{Binding CursorClampMode, Mode=TwoWay}"
                                                      SelectedValuePath="Tag"
                                                      Width="160" VerticalAlignment="Center"
                                                      ToolTip="{Binding MacroAction_MouseLimitRegion_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                                <ComboBoxItem Content="X+Y" Tag="{x:Static vm:CursorClampMode.XAndY}"/>
                                                <ComboBoxItem Content="X" Tag="{x:Static vm:CursorClampMode.XOnly}"/>
                                                <ComboBoxItem Content="Y" Tag="{x:Static vm:CursorClampMode.YOnly}"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_CursorClampInsetX_Label, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding CursorClampInsetX, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                     Width="80" VerticalAlignment="Center"/>
                                            <ui:Button Command="{Binding ResetCursorClampInsetXCommand}" Style="{StaticResource ResetButton}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_CursorClampInsetY_Label, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding CursorClampInsetY, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                     Width="80" VerticalAlignment="Center"/>
                                            <ui:Button Command="{Binding ResetCursorClampInsetYCommand}" Style="{StaticResource ResetButton}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Macro_CursorWrite_Caveat, Source={x:Static strings:Strings.Instance}}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Move Mouse to Screen Position editor (#9). Mouse X / Mouse Y + on-screen pick -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsMoveMouseToScreenPositionType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_MouseX_Label, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding MouseX, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                     Width="80" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_MouseY_Label, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding MouseY, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                     Width="80" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Content="{Binding MousePickButtonText}" Command="{Binding PickMousePositionCommand}"
                                                HorizontalAlignment="Left" Padding="8,4" Margin="0,0,0,4"
                                                ToolTip="{Binding Macro_PickOnScreen_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBlock Text="{Binding Macro_CursorWrite_Caveat, Source={x:Static strings:Strings.Instance}}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Nudge Cursor editor (v16): signed dx / dy pixel deltas.
                                         Deliberately no on-screen pick: a nudge is a relative
                                         offset, not a coordinate. -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsMouseNudgeType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_MouseX_Label, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding NudgeDx, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                     Width="80" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_MouseY_Label, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding NudgeDy, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                     Width="80" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Macro_CursorWrite_Caveat, Source={x:Static strings:Strings.Instance}}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Cycle Tap List editor (v16): the step CSV plus the wrap
                                         toggle. The CSV is the persisted vocabulary the importer
                                         writes (see MacroAction.CycleStepsCsv). -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsCycleTapListType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_CycleSteps_Label, Source={x:Static strings:Strings.Instance}}"
                                                       Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding CycleStepsCsv, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     Width="220" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <CheckBox IsChecked="{Binding CycleWrap, Mode=TwoWay}"
                                                  Content="{Binding Macro_CycleWrap_Label, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>

                                    <!-- Pulse while latched (v19, M1): the toggle latches
                                         (button / key / mouse button / axis) can pulse their held
                                         contribution on the turbo square wave; checking it surfaces
                                         the shared Interval row below. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                                Visibility="{Binding IsPulseCapableType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                  IsChecked="{Binding PulseWhileLatched, Mode=TwoWay}"
                                                  Content="{Binding Macro_PulseWhileLatched, Source={x:Static strings:Strings.Instance}}"
                                                  ToolTip="{Binding Macro_PulseWhileLatched_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>

                                    <!-- Turbo interval (#9 + wave 1b, widened v19 M1): shared by the
                                         Repeat While Held turbos, Toggle Wheel Scroll, and any pulsing
                                         latch. Key picker / button grid are the shared panels below. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                                Visibility="{Binding IsRepeatIntervalType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_RepeatInterval_Label, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                   Width="80" Margin="0,0,8,0"/>
                                        <TextBox Text="{Binding IntervalMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="80"/>
                                        <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        <ui:Button Command="{Binding ResetIntervalMsCommand}" Style="{StaticResource ResetButton}" Margin="8,0,0,0"/>
                                    </StackPanel>

                                    <!-- Button flags checkbox grid for ButtonPress / ButtonRelease and
                                         the wave-1b turbo / toggle button actions (all address the
                                         target via the same ButtonFlags / CustomButtonWords pair) -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsAnyVcButtonType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Macro_Buttons, Source={x:Static strings:Strings.Instance}}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding ButtonOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Label}"
                                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                              MinWidth="70" Margin="0,0,8,4"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Key combo for KeyPress / KeyRelease / RepeatKeyWhileHeld (#9) / ToggleKey (wave 1b) -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsAnyKeyType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Macro_KeyCombo, Source={x:Static strings:Strings.Instance}}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding KeyString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{StaticResource TelemetryFontFamily}" Margin="0,0,0,4"
                                                 ToolTip="{Binding Macro_KeyComboTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Instance binding, NOT x:Static: an x:Static ItemsSource is
                                                 evaluated once and never refreshes on a live language change. -->
                                            <ComboBox ItemsSource="{Binding VirtualKeyChoices}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="Key"
                                                      SelectedValue="{Binding SelectedKeyToAdd, Mode=TwoWay}"
                                                      MinWidth="180" MaxDropDownHeight="300"
                                                      IsTextSearchEnabled="True"/>
                                            <Button Content="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}" Command="{Binding ClearKeyStringCommand}"
                                                    Padding="8,4" Margin="4,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Macro_KeyComboHint, Source={x:Static strings:Strings.Instance}}"
                                                   FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Duration — for ButtonPress / KeyPress / Delay / LightbarColor -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                                Visibility="{Binding IsDurationType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Duration, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                   Width="80" Margin="0,0,8,0"/>
                                        <TextBox Text="{Binding DurationMs, Mode=TwoWay}" Width="80"/>
                                        <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>

                                    <!-- Lightbar Color card (Reactive | Sticky) -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6"
                                            Visibility="{Binding IsLightbarType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MacroAction_Type_LightbarColor, Source={x:Static strings:Strings.Instance}}"
                                                       FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_LightbarHold_Label, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="80" Margin="0,0,8,0"/>
                                                <ComboBox SelectedValue="{Binding LightbarHoldMode, Mode=TwoWay}"
                                                          SelectedValuePath="Tag" MinWidth="140">
                                                    <ComboBoxItem Content="{Binding Macro_LightbarHold_Reactive, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroLightbarHoldMode.Reactive}"/>
                                                    <ComboBoxItem Content="{Binding Macro_LightbarHold_Sticky, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroLightbarHoldMode.Sticky}"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <!-- Color source — Reactive only. Sticky always uses Fixed. -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                                        Visibility="{Binding IsLightbarReactiveHold, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_LightbarColorSource_Label, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="80" Margin="0,0,8,0"/>
                                                <ComboBox SelectedValue="{Binding LightbarColorSource, Mode=TwoWay}"
                                                          SelectedValuePath="Tag" MinWidth="160">
                                                    <ComboBoxItem Content="{Binding Macro_LightbarColorSource_Fixed, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroLightbarColorSource.Fixed}"/>
                                                    <ComboBoxItem Content="{Binding Macro_LightbarColorSource_RandomHue, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroLightbarColorSource.RandomHue}"/>
                                                    <ComboBoxItem Content="{Binding Macro_LightbarColorSource_PaletteStep, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroLightbarColorSource.PaletteStep}"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <!-- Color picker — visible for Sticky always, Reactive only when Source=Fixed. -->
                                            <StackPanel Margin="0,0,0,6"
                                                        Visibility="{Binding IsLightbarFixedColorVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <views:ColorPickerControl HorizontalAlignment="Left" Margin="0,0,0,4"
                                                                          Red="{Binding LightbarR, Mode=TwoWay}"
                                                                          Green="{Binding LightbarG, Mode=TwoWay}"
                                                                          Blue="{Binding LightbarB, Mode=TwoWay}"/>
                                                <Border Width="80" Height="20" HorizontalAlignment="Left" CornerRadius="3"
                                                        BorderBrush="{DynamicResource TextFillColorDisabledBrush}" BorderThickness="1">
                                                    <Border.Background>
                                                        <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                                            <Binding Path="LightbarR"/>
                                                            <Binding Path="LightbarG"/>
                                                            <Binding Path="LightbarB"/>
                                                        </MultiBinding>
                                                    </Border.Background>
                                                </Border>
                                            </StackPanel>
                                            <!-- Per-macro palette editor — visible only when Reactive + PaletteStep. -->
                                            <StackPanel Margin="0,0,0,6"
                                                        Visibility="{Binding IsLightbarPaletteVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Macro_LightbarPalette_Label, Source={x:Static strings:Strings.Instance}}"
                                                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding Macro_LightbarPalette_Empty, Source={x:Static strings:Strings.Instance}}"
                                                           FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Margin="0,0,0,4"/>
                                                <ItemsControl ItemsSource="{Binding LightbarPalette}" Margin="0,0,0,4">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:LightbarPaletteEntry}">
                                                            <Border BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,6,6"
                                                                    BorderBrush="{DynamicResource TextFillColorDisabledBrush}">
                                                                <StackPanel>
                                                                    <ui:Button Command="{Binding DataContext.RemoveLightbarPaletteColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                               CommandParameter="{Binding}"
                                                                               Style="{StaticResource EmberIconButtonHot}"
                                                                               HorizontalAlignment="Right" Margin="0,0,0,4"
                                                                               ToolTip="{Binding Pad_Lighting_RemoveColor, Source={x:Static strings:Strings.Instance}}">
                                                                        <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                                    </ui:Button>
                                                                    <views:ColorPickerControl HorizontalAlignment="Left"
                                                                        Red="{Binding R, Mode=TwoWay}"
                                                                        Green="{Binding G, Mode=TwoWay}"
                                                                        Blue="{Binding B, Mode=TwoWay}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Content="{Binding Pad_Lighting_AddColor, Source={x:Static strings:Strings.Instance}}"
                                                        Command="{Binding AddLightbarPaletteColorCommand}"
                                                        HorizontalAlignment="Left" Padding="8,2"/>
                                            </StackPanel>
                                            <!-- Hold slider, Reactive only. Held at full intensity for this many ms before the fade begins.
                                                 Labelled with the DURATION key, not Macro_LightbarHold_Label: that key labels the
                                                 mode picker above, and translators read it that way (es "Modo", de "Modus", it
                                                 "Modalità"), so sharing it made one of the two rows wrong in every locale. -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                                        Visibility="{Binding IsLightbarReactiveHold, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_TriggerHoldMs_Label, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="80" Margin="0,0,8,0"/>
                                                <Slider Value="{Binding LightbarHoldMs, Mode=TwoWay}"
                                                        Minimum="0" Maximum="5000" Width="220"
                                                        VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding LightbarHoldMs, Mode=TwoWay}" Width="80" Margin="8,0,0,0"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </StackPanel>
                                            <!-- Fade slider — Reactive only. Linear fade from full to off after the hold. -->
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding IsLightbarReactiveHold, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_LightbarFade_Label, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="80" Margin="0,0,8,0"/>
                                                <Slider Value="{Binding LightbarFadeMs, Mode=TwoWay}"
                                                        Minimum="0" Maximum="5000" Width="220"
                                                        VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding LightbarFadeMs, Mode=TwoWay}" Width="80" Margin="8,0,0,0"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Lightbar Color Clear card -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6"
                                            Visibility="{Binding IsLightbarColorClearType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MacroAction_Type_LightbarColorClear, Source={x:Static strings:Strings.Instance}}"
                                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding MacroAction_LightbarColorClear_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Lightbar Mode Set card -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6"
                                            Visibility="{Binding IsLightbarModeSetType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MacroAction_Type_LightbarModeSet, Source={x:Static strings:Strings.Instance}}"
                                                       FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_LightbarTargetMode_Label, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="80" Margin="0,0,8,0"/>
                                                <ComboBox SelectedValue="{Binding LightbarTargetMode, Mode=TwoWay}"
                                                          SelectedValuePath="Tag" MinWidth="280">
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_PlayerNumber, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.PlayerNumber}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_Off, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.Off}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_Static, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.Static}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_Breathing, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.Breathing}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_Strobe, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.Strobe}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_Rainbow, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.Rainbow}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_ColorCycle, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.ColorCycle}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_Battery, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.Battery}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_AudioPulse, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.AudioPulse}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_AudioPulseRandom, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.AudioPulseRandom}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_AudioPulseRainbow, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.AudioPulseRainbow}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_AudioThresholds, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.AudioThresholds}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_AudioGradient, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.AudioGradient}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_AudioCrossFade, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.AudioCrossFade}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_InputReactive, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.InputReactive}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_InputReactiveCycle, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.InputReactiveCycle}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_InputReactiveFixed, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.InputReactiveFixed}"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Lightbar Mode Cycle card — checkbox grid bound through LightbarCycleModesCsv via the action's CycleModeOptions list. -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6"
                                            Visibility="{Binding IsLightbarModeCycleType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MacroAction_Type_LightbarModeCycle, Source={x:Static strings:Strings.Instance}}"
                                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Macro_LightbarCycleModes_Hint, Source={x:Static strings:Strings.Instance}}"
                                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <ItemsControl ItemsSource="{Binding CycleModeOptions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Label}"
                                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                  MinWidth="160" Margin="0,0,8,4"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Pointer Mode Cycle card (issue #203), same shape as the
                                         lightbar cycle card above. -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6"
                                            Visibility="{Binding IsPointerModeCycleType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MacroAction_Type_PointerModeCycle, Source={x:Static strings:Strings.Instance}}"
                                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Macro_PointerCycleModes_Hint, Source={x:Static strings:Strings.Instance}}"
                                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <ItemsControl ItemsSource="{Binding PointerCycleModeOptions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Label}"
                                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                  MinWidth="160" Margin="0,0,8,4"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Pointer Mode Set card (issue #203 follow-up): one fixed
                                         mode, the pointer sibling of the lightbar mode-set card.
                                         Combo mirrors the Pointer tab's mode picker. -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6"
                                            Visibility="{Binding IsPointerModeSetType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MacroAction_Type_PointerModeSet, Source={x:Static strings:Strings.Instance}}"
                                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Macro_PointerSetMode_Hint, Source={x:Static strings:Strings.Instance}}"
                                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <ComboBox Width="240" HorizontalAlignment="Left" SelectedValuePath="Tag"
                                                      SelectedValue="{Binding PointerSetMode, Mode=TwoWay}">
                                                <ComboBoxItem Content="{Binding Pad_Pointer_Mode_Mouse, Source={x:Static strings:Strings.Instance}}" Tag="Mouse"/>
                                                <ComboBoxItem Content="{Binding Pad_Pointer_Mode_FpsMouse, Source={x:Static strings:Strings.Instance}}" Tag="FpsMouse"/>
                                                <ComboBoxItem Content="{Binding Pad_Pointer_Mode_43, Source={x:Static strings:Strings.Instance}}" Tag="Mouse43"/>
                                                <ComboBoxItem Content="{Binding Pad_Pointer_Mode_169, Source={x:Static strings:Strings.Instance}}" Tag="Mouse169"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>

                                    <!-- Guide LED brightness card (#209): one transient
                                         brightness write for every capable controller on
                                         the slot (Xbox over USB, 2015 Steam Controller). -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6"
                                            Visibility="{Binding IsGuideLedBrightnessType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MacroAction_Type_GuideLedBrightness, Source={x:Static strings:Strings.Instance}}"
                                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Macro_GuideLedBrightness_Hint, Source={x:Static strings:Strings.Instance}}"
                                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Slider Value="{Binding GuideLedPercent, Mode=TwoWay}" Minimum="0" Maximum="100"
                                                        Width="180" VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding GuideLedPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="%" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Rumble card (Reactive | Sticky). Shared by the main-motor
                                         Rumble action and the trigger-channel RumbleTrigger action
                                         (#102); the header title switches per action type. -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6"
                                            Visibility="{Binding IsAnyRumbleSetType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding RumbleEditorTitle}"
                                                       FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_RumbleHold_Label, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="100" Margin="0,0,8,0"/>
                                                <ComboBox SelectedValue="{Binding RumbleHoldMode, Mode=TwoWay}"
                                                          SelectedValuePath="Tag" MinWidth="140">
                                                    <ComboBoxItem Content="{Binding Macro_RumbleHold_Reactive, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroRumbleHoldMode.Reactive}"/>
                                                    <ComboBoxItem Content="{Binding Macro_RumbleHold_Sticky, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroRumbleHoldMode.Sticky}"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <!-- Left motor strength -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_RumbleStrengthLeft_Label, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="100" Margin="0,0,8,0"/>
                                                <Slider Value="{Binding RumbleStrengthLeft, Mode=TwoWay}"
                                                        Minimum="0" Maximum="100" Width="220"
                                                        VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding RumbleStrengthLeft, Mode=TwoWay}" Width="60" Margin="8,0,0,0"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="%" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                            </StackPanel>
                                            <!-- Right motor strength -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_RumbleStrengthRight_Label, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="100" Margin="0,0,8,0"/>
                                                <Slider Value="{Binding RumbleStrengthRight, Mode=TwoWay}"
                                                        Minimum="0" Maximum="100" Width="220"
                                                        VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding RumbleStrengthRight, Mode=TwoWay}" Width="60" Margin="8,0,0,0"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="%" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                            </StackPanel>
                                            <!-- Hold ms — Reactive only -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                                        Visibility="{Binding IsRumbleReactiveHold, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_RumbleHoldMs_Label, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="100" Margin="0,0,8,0"/>
                                                <Slider Value="{Binding RumbleHoldMs, Mode=TwoWay}"
                                                        Minimum="0" Maximum="5000" Width="220"
                                                        VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding RumbleHoldMs, Mode=TwoWay}" Width="80" Margin="8,0,0,0"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </StackPanel>
                                            <!-- Fade ms — Reactive only -->
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding IsRumbleReactiveHold, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_RumbleFadeMs_Label, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="100" Margin="0,0,8,0"/>
                                                <Slider Value="{Binding RumbleFadeMs, Mode=TwoWay}"
                                                        Minimum="0" Maximum="5000" Width="220"
                                                        VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding RumbleFadeMs, Mode=TwoWay}" Width="80" Margin="8,0,0,0"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Rumble Stop card. Shared by RumbleStop (main motors) and
                                         RumbleTriggerStop (trigger channel, #102); title + body switch
                                         per action type. -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6"
                                            Visibility="{Binding IsAnyRumbleStopType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding RumbleStopEditorTitle}"
                                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding RumbleStopEditorBody}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Play Sound card (issue #83) — file + volume + loop + preview -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6"
                                            Visibility="{Binding IsPlaySoundType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MacroAction_Type_PlaySound, Source={x:Static strings:Strings.Instance}}"
                                                       FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Sound_File_Label, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="80" Margin="0,0,8,0"/>
                                                <TextBox Text="{Binding SoundFilePath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Width="260" VerticalAlignment="Center"
                                                         ToolTip="{Binding SoundFilePath}"/>
                                                <Button Content="{Binding Macro_Sound_Browse, Source={x:Static strings:Strings.Instance}}"
                                                        Click="BrowseSoundFile_Click" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                <Button Content="{Binding Macro_Sound_Preview, Source={x:Static strings:Strings.Instance}}"
                                                        Click="PreviewSoundFile_Click" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Sound_Volume_Label, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="80" Margin="0,0,8,0"/>
                                                <Slider Value="{Binding SoundVolume, Mode=TwoWay}" Minimum="0" Maximum="100"
                                                        Width="180" VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding SoundVolume, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="%" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                            </StackPanel>
                                            <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsChecked="{Binding SoundLoop, Mode=TwoWay}"
                                                      Content="{Binding Macro_Sound_Loop, Source={x:Static strings:Strings.Instance}}"
                                                      ToolTip="{Binding Macro_Sound_Loop_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Stop Sounds card (issue #83) -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6"
                                            Visibility="{Binding IsSoundStopType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MacroAction_Type_SoundStop, Source={x:Static strings:Strings.Instance}}"
                                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding MacroAction_SoundStop_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Axis target + value for AxisSet / AxisHold plus the v19 M1
                                         ToggleVcAxis latch and RepeatVcAxisWhileHeld turbo. The
                                         AxisAdd relative deflection (discussion #237) rides the same
                                         pair, reading the signed value as the per-frame add. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                                Visibility="{Binding IsAnyAxisValueType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Axis, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                   Width="80" Margin="0,0,8,0"/>
                                        <ComboBox SelectedValue="{Binding AxisTarget, Mode=TwoWay}"
                                                  SelectedValuePath="Tag" MinWidth="120">
                                            <ComboBoxItem Content="{Binding Common_None, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.None}"/>
                                            <ComboBoxItem Content="{Binding Macro_LeftStickX, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftStickX}"/>
                                            <ComboBoxItem Content="{Binding Macro_LeftStickY, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftStickY}"/>
                                            <ComboBoxItem Content="{Binding Macro_RightStickX, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightStickX}"/>
                                            <ComboBoxItem Content="{Binding Macro_RightStickY, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightStickY}"/>
                                            <ComboBoxItem Content="{Binding Macro_LeftTrigger, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftTrigger}"/>
                                            <ComboBoxItem Content="{Binding Macro_RightTrigger, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightTrigger}"/>
                                        </ComboBox>
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_AxisValue, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                   Margin="12,0,8,0"/>
                                        <!-- Percent, not raw axis units (-32768..32767): every
                                             summary and tooltip in this family speaks percent, and
                                             a bare raw box gave the user no way to know that 75
                                             meant 0.2% (owner report, 2026-07-24). The VM converts
                                             to the persisted raw short, clamped to -100..100. -->
                                        <TextBox Text="{Binding AxisValuePercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F0}" Width="60"/>
                                        <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="%" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>

                                    <!-- Axis Add hint (discussion #237): the shared value box is
                                         already signed. The hint spells out that negative values
                                         subtract and that triggers add on the pull scale. -->
                                    <TextBlock Text="{Binding MacroAction_AxisAdd_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding IsAxisAddType, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <!-- Scale Axis hint (#251): the shared signed value box is
                                         the scale delta, -50% halves the current deflection. -->
                                    <TextBlock Text="{Binding MacroAction_AxisScale_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding IsAxisScaleType, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <!-- Set Axis (Latched) hint (#251): ladder semantics. -->
                                    <TextBlock Text="{Binding MacroAction_AxisSetLatched_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding IsAxisSetLatchedType, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <!-- Release Axis Latches (#251): target-only row, no value box
                                         (the action carries no value). None reads as all axes. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                                Visibility="{Binding IsAxisLatchReleaseType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Axis, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                   Width="80" Margin="0,0,8,0"/>
                                        <ComboBox SelectedValue="{Binding AxisTarget, Mode=TwoWay}"
                                                  SelectedValuePath="Tag" MinWidth="120"
                                                  ToolTip="{Binding MacroAction_AxisLatchRelease_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                            <ComboBoxItem Content="{Binding MacroAction_AllAxes, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.None}"/>
                                            <ComboBoxItem Content="{Binding Macro_LeftStickX, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftStickX}"/>
                                            <ComboBoxItem Content="{Binding Macro_LeftStickY, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftStickY}"/>
                                            <ComboBoxItem Content="{Binding Macro_RightStickX, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightStickX}"/>
                                            <ComboBoxItem Content="{Binding Macro_RightStickY, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightStickY}"/>
                                            <ComboBoxItem Content="{Binding Macro_LeftTrigger, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftTrigger}"/>
                                            <ComboBoxItem Content="{Binding Macro_RightTrigger, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightTrigger}"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Yield to physical input (discussion #237): the axis holds
                                         can hand the axis back to the player mid-activation. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                                Visibility="{Binding IsAxisYieldCapableType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                  IsChecked="{Binding AxisYieldToPhysical, Mode=TwoWay}"
                                                  Content="{Binding Macro_AxisYieldToPhysical, Source={x:Static strings:Strings.Instance}}"
                                                  ToolTip="{Binding Macro_AxisYieldToPhysical_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>

                                    <!-- Wheel tick count for MouseWheelTap (v15) and the v19 M1
                                         ToggleWheel latch. Reuses the AxisValue field as the signed
                                         tick count. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                                Visibility="{Binding IsAnyWheelTapType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_AxisValue, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                   Width="80" Margin="0,0,8,0"/>
                                        <TextBox Text="{Binding AxisValue, Mode=TwoWay}" Width="80"/>
                                        <CheckBox IsChecked="{Binding WheelHorizontal, Mode=TwoWay}" Margin="12,0,0,0"
                                                  Content="{Binding Mouse_ScrollH, Source={x:Static strings:Strings.Instance}}"
                                                  VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Source axis for SystemVolume -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsSystemVolumeType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <!-- Axis source selector -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_AxisFrom, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"/>
                                            <ComboBox SelectedValue="{Binding AxisSource, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" MinWidth="150">
                                                <ComboBoxItem Content="{Binding Macro_OutputController, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisSource.OutputController}"/>
                                                <ComboBoxItem Content="{Binding Macro_InputDevice, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisSource.InputDevice}"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <!-- Output controller axis (existing) -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                                    Visibility="{Binding IsOutputAxisSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_SourceAxis, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"/>
                                            <ComboBox SelectedValue="{Binding AxisTarget, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" MinWidth="150">
                                                <ComboBoxItem Content="{Binding Macro_LeftStickX, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftStickX}"/>
                                                <ComboBoxItem Content="{Binding Macro_LeftStickY, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftStickY}"/>
                                                <ComboBoxItem Content="{Binding Macro_RightStickX, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightStickX}"/>
                                                <ComboBoxItem Content="{Binding Macro_RightStickY, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightStickY}"/>
                                                <ComboBoxItem Content="{Binding Macro_LeftTrigger, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftTrigger}"/>
                                                <ComboBoxItem Content="{Binding Macro_RightTrigger, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightTrigger}"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <!-- Input device axis -->
                                        <StackPanel Visibility="{Binding IsDeviceAxisSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Device, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                           Width="80" Margin="0,0,8,0"/>
                                                <ComboBox x:Name="SysVolDevicePicker"
                                                          MinWidth="200"
                                                          DisplayMemberPath="ResolvedName"
                                                          SelectedValuePath="InstanceGuid"
                                                          SelectedValue="{Binding SourceDeviceGuid, Mode=TwoWay}"
                                                          DropDownOpened="DeviceAxisPicker_DropDownOpened"
                                                          Loaded="DeviceAxisPicker_DropDownOpened"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Axis, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                           Width="80" Margin="0,0,8,0"/>
                                                <ComboBox MinWidth="180"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectedValuePath="InputIndex"
                                                          SelectedValue="{Binding SourceDeviceAxisIndex, Mode=TwoWay}"
                                                          DropDownOpened="DeviceAxisIndexPicker_DropDownOpened"
                                                          Loaded="DeviceAxisIndexPicker_DropDownOpened"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_VolumeLimit, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"/>
                                            <Slider Value="{Binding VolumeLimit, Mode=TwoWay}"
                                                    Minimum="1" Maximum="100" Width="150"
                                                    VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding VolumeLimit, Mode=OneWay}"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="%"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Macro_InvertAxis, Source={x:Static strings:Strings.Instance}}"
                                                 IsChecked="{Binding InvertAxis, Mode=TwoWay}" Margin="0,0,0,4"/>
                                        <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Macro_ShowVolumeOsd, Source={x:Static strings:Strings.Instance}}"
                                                 IsChecked="{Binding ShowVolumeOsd, Mode=TwoWay}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Macro_SysVolumeHint, Source={x:Static strings:Strings.Instance}}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Source axis + process name — for AppVolume -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsAppVolumeType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Process, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"/>
                                            <ComboBox IsEditable="True"
                                                      Text="{Binding ProcessName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding AudioProcessNames}"
                                                      MinWidth="180" MaxDropDownHeight="200"
                                                      IsTextSearchEnabled="True"
                                                      ToolTip="{Binding Macro_ProcessTooltip, Source={x:Static strings:Strings.Instance}}"
                                                      DropDownOpened="AppVolumeProcessDropDown_Opened"/>
                                        </StackPanel>
                                        <!-- Axis source selector -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_AxisFrom, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"/>
                                            <ComboBox SelectedValue="{Binding AxisSource, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" MinWidth="150">
                                                <ComboBoxItem Content="{Binding Macro_OutputController, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisSource.OutputController}"/>
                                                <ComboBoxItem Content="{Binding Macro_InputDevice, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisSource.InputDevice}"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <!-- Output controller axis -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                                    Visibility="{Binding IsOutputAxisSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_SourceAxis, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"/>
                                            <ComboBox SelectedValue="{Binding AxisTarget, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" MinWidth="150">
                                                <ComboBoxItem Content="{Binding Macro_LeftStickX, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftStickX}"/>
                                                <ComboBoxItem Content="{Binding Macro_LeftStickY, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftStickY}"/>
                                                <ComboBoxItem Content="{Binding Macro_RightStickX, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightStickX}"/>
                                                <ComboBoxItem Content="{Binding Macro_RightStickY, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightStickY}"/>
                                                <ComboBoxItem Content="{Binding Macro_LeftTrigger, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftTrigger}"/>
                                                <ComboBoxItem Content="{Binding Macro_RightTrigger, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightTrigger}"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <!-- Input device axis -->
                                        <StackPanel Visibility="{Binding IsDeviceAxisSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Device, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                           Width="80" Margin="0,0,8,0"/>
                                                <ComboBox x:Name="AppVolDevicePicker"
                                                          MinWidth="200"
                                                          DisplayMemberPath="ResolvedName"
                                                          SelectedValuePath="InstanceGuid"
                                                          SelectedValue="{Binding SourceDeviceGuid, Mode=TwoWay}"
                                                          DropDownOpened="DeviceAxisPicker_DropDownOpened"
                                                          Loaded="DeviceAxisPicker_DropDownOpened"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Axis, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                           Width="80" Margin="0,0,8,0"/>
                                                <ComboBox MinWidth="180"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectedValuePath="InputIndex"
                                                          SelectedValue="{Binding SourceDeviceAxisIndex, Mode=TwoWay}"
                                                          DropDownOpened="DeviceAxisIndexPicker_DropDownOpened"
                                                          Loaded="DeviceAxisIndexPicker_DropDownOpened"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_VolumeLimit, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"/>
                                            <Slider Value="{Binding VolumeLimit, Mode=TwoWay}"
                                                    Minimum="1" Maximum="100" Width="150"
                                                    VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding VolumeLimit, Mode=OneWay}"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="%"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Macro_InvertAxis, Source={x:Static strings:Strings.Instance}}"
                                                 IsChecked="{Binding InvertAxis, Mode=TwoWay}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Macro_AppVolumeHint, Source={x:Static strings:Strings.Instance}}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Source axis + sensitivity — for MouseMove / MouseScroll -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsMouseMoveType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <!-- Axis source selector -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_AxisFrom, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"/>
                                            <ComboBox SelectedValue="{Binding AxisSource, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" MinWidth="150">
                                                <ComboBoxItem Content="{Binding Macro_OutputController, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisSource.OutputController}"/>
                                                <ComboBoxItem Content="{Binding Macro_InputDevice, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisSource.InputDevice}"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <!-- Output controller axis -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                                    Visibility="{Binding IsOutputAxisSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_SourceAxis, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"/>
                                            <ComboBox SelectedValue="{Binding AxisTarget, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" MinWidth="150">
                                                <ComboBoxItem Content="{Binding Macro_LeftStickX, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftStickX}"/>
                                                <ComboBoxItem Content="{Binding Macro_LeftStickY, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftStickY}"/>
                                                <ComboBoxItem Content="{Binding Macro_RightStickX, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightStickX}"/>
                                                <ComboBoxItem Content="{Binding Macro_RightStickY, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightStickY}"/>
                                                <ComboBoxItem Content="{Binding Macro_LeftTrigger, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftTrigger}"/>
                                                <ComboBoxItem Content="{Binding Macro_RightTrigger, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightTrigger}"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <!-- Input device axis -->
                                        <StackPanel Visibility="{Binding IsDeviceAxisSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Device, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                           Width="80" Margin="0,0,8,0"/>
                                                <ComboBox x:Name="MouseDevicePicker"
                                                          MinWidth="200"
                                                          DisplayMemberPath="ResolvedName"
                                                          SelectedValuePath="InstanceGuid"
                                                          SelectedValue="{Binding SourceDeviceGuid, Mode=TwoWay}"
                                                          DropDownOpened="DeviceAxisPicker_DropDownOpened"
                                                          Loaded="DeviceAxisPicker_DropDownOpened"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Axis, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                           Width="80" Margin="0,0,8,0"/>
                                                <ComboBox MinWidth="180"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectedValuePath="InputIndex"
                                                          SelectedValue="{Binding SourceDeviceAxisIndex, Mode=TwoWay}"
                                                          DropDownOpened="DeviceAxisIndexPicker_DropDownOpened"
                                                          Loaded="DeviceAxisIndexPicker_DropDownOpened"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Sensitivity, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"/>
                                            <Slider Value="{Binding MouseSensitivity, Mode=TwoWay}"
                                                    Minimum="1" Maximum="100" Width="180"
                                                    TickPlacement="None" IsSnapToTickEnabled="False"
                                                    VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding MouseSensitivity, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                     Width="50" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Macro_InvertAxis, Source={x:Static strings:Strings.Instance}}"
                                                 IsChecked="{Binding InvertAxis, Mode=TwoWay}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Macro_MouseMoveHint, Source={x:Static strings:Strings.Instance}}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Mouse button picker for MouseButtonPress / MouseButtonRelease
                                         plus the v19 M1 ToggleMouseButton latch -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsAnyMouseButtonType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Buttons, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"/>
                                            <ComboBox SelectedValue="{Binding MouseButton, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" MinWidth="120">
                                                <ComboBoxItem Content="{Binding Macro_MouseLeft, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroMouseButton.Left}"/>
                                                <ComboBoxItem Content="{Binding Macro_MouseRight, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroMouseButton.Right}"/>
                                                <ComboBoxItem Content="{Binding Macro_MouseMiddle, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroMouseButton.Middle}"/>
                                                <ComboBoxItem Content="{Binding Macro_MouseX1, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroMouseButton.X1}"/>
                                                <ComboBoxItem Content="{Binding Macro_MouseX2, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroMouseButton.X2}"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Repeat settings. Hidden for Turbo and Toggle (#238):
                                 those modes force until-release repeats in the engine,
                                 so Mode and Count would be dead controls there; their
                                 one live knob (the interval) rides the inline row
                                 beside the Fire picker instead. -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                        Visibility="{Binding ShowsRepeatSection, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border Width="3" CornerRadius="1.5" Margin="0,2,7,2"
                                        Background="{DynamicResource EmberBrush}"/>
                                <TextBlock Text="{Binding Macro_Repeat, Source={x:Static strings:Strings.Instance}}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                        Visibility="{Binding ShowsRepeatSection, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_RepeatMode, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                           Width="80" Margin="0,0,8,0"/>
                                <ComboBox SelectedValue="{Binding RepeatMode, Mode=TwoWay}"
                                          SelectedValuePath="Tag" MinWidth="120">
                                    <ComboBoxItem Content="{Binding Macro_Once, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroRepeatMode.Once}"/>
                                    <ComboBoxItem Content="{Binding Macro_FixedCount, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroRepeatMode.FixedCount}"/>
                                    <ComboBoxItem Content="{Binding Macro_UntilRelease, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroRepeatMode.UntilRelease}"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                        Visibility="{Binding ShowsRepeatSection, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Count, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                           Margin="0,0,8,0" Width="80"/>
                                <TextBox Text="{Binding RepeatCount, Mode=TwoWay}"
                                         Width="60"/>
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_DelayMs, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                           Margin="12,0,8,0"/>
                                <TextBox Text="{Binding RepeatDelayMs, Mode=TwoWay}"
                                         Width="60"/>
                                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ─── TAB 2: Mappings (device-specific) ─── -->
            <TabItem>
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="{Binding Common_Copy, Source={x:Static strings:Strings.Instance}}" Command="{Binding CopySettingsCommand}"
                                Padding="8,4" Margin="0,0,4,0"
                                ToolTip="{Binding Pad_CopyTooltip, Source={x:Static strings:Strings.Instance}}"/>
                        <Button Content="{Binding Common_Paste, Source={x:Static strings:Strings.Instance}}" Command="{Binding PasteSettingsCommand}"
                                Padding="8,4" Margin="0,0,4,0"
                                ToolTip="{Binding Pad_PasteTooltip, Source={x:Static strings:Strings.Instance}}"/>
                        <Button Content="{Binding Pad_CopyFrom, Source={x:Static strings:Strings.Instance}}" Command="{Binding CopyFromCommand}"
                                Padding="8,4" Margin="0,0,8,0"
                                ToolTip="{Binding Pad_CopyFromTooltip, Source={x:Static strings:Strings.Instance}}"/>
                        <Button Content="{Binding MapAllButtonText}"
                                Padding="8,4" Margin="0,0,8,0"
                                ToolTip="{Binding MapAllButtonTooltip}"
                                Click="MapAllToggle_Click"/>
                        <Button x:Name="AddShiftLayerButton"
                                Content="{Binding Pad_Shift_AddLayer, Source={x:Static strings:Strings.Instance}}"
                                Padding="8,4" Margin="0,0,8,0"
                                ToolTip="{Binding Pad_Shift_AddLayer_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                Click="AddShiftLayer_Click"/>
                        <TextBlock Text="{Binding Pad_MappingHint, Source={x:Static strings:Strings.Instance}}"
                                   VerticalAlignment="Center" FontStyle="Italic"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <!-- Clear All rides at the far end in warning chrome
                             (#175 item 1d): it wipes every mapping row, so it
                             no longer leads the strip, and the Click path asks
                             through the shared ConfirmDialog first. -->
                        <Button Content="{Binding Pad_ClearAll, Source={x:Static strings:Strings.Instance}}" Click="ClearAllMappings_Click"
                                Style="{StaticResource EmberDestructiveButton}"
                                Padding="8,4" Margin="8,0,0,0"
                                ToolTip="{Binding Pad_ClearMappings, Source={x:Static strings:Strings.Instance}}"/>
                    </StackPanel>

                    <!-- Direct-row compression readout (#175 telemetry board):
                         mono tertiary count of rows currently rendered as
                         compact one-liners. DIRECT is a locale-neutral
                         telemetry token like the radar legend's DZ / PEAK.
                         Hidden when no row is compact. -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="8,0,4,8">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DirectMappingCount}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding DirectMappingCount}"
                                   FontFamily="{StaticResource TelemetryFontFamily}" FontSize="10"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="DIRECT"
                                   FontFamily="{StaticResource TelemetryFontFamily}" FontSize="10"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Nested layer-tab strip. Hidden when only Base exists
                         (basic users without any shift layers see the
                         Mappings tab exactly as before). One RadioButton per
                         entry in PadViewModel.LayerTabs; right-click opens
                         the per-tab context menu. -->
                    <!-- Inline rename popup, anchored at runtime to the
                         clicked shift-layer tab. Single-field input + Save
                         + Cancel — much lighter than reopening the full
                         Configure dialog when the user just wants to fix
                         the name. -->
                    <Popup x:Name="RenameLayerPopup"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           StaysOpen="False">
                        <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                                  Direction="270" Opacity="0.30" Color="Black"/>
                            </Border.Effect>
                            <StackPanel Orientation="Vertical" MinWidth="240">
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Shift_LayerName, Source={x:Static strings:Strings.Instance}}"
                                           Margin="0,0,0,4"/>
                                <TextBox x:Name="RenameLayerBox"
                                         Margin="0,0,0,8"
                                         KeyDown="RenameLayerBox_KeyDown"/>
                                <TextBlock x:Name="RenameLayerHint"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,6"
                                           Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <!-- Save is the popup's primary affirmative and wears
                                         the ember accent (#175 dialog language). The old
                                         inline TextOnAccent-on-accent pair went dark text
                                         on ember (user report 2026-07-05). -->
                                    <Button Content="{Binding Common_Save, Source={x:Static strings:Strings.Instance}}"
                                            MinWidth="72" Margin="0,0,6,0"
                                            IsDefault="True"
                                            Click="RenameLayerSave_Click"
                                            Style="{StaticResource EmberAccentButton}"/>
                                    <Button Content="{Binding Common_Cancel, Source={x:Static strings:Strings.Instance}}"
                                            MinWidth="72"
                                            IsCancel="True"
                                            Click="RenameLayerCancel_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <ItemsControl Grid.Row="1" x:Name="ShiftLayerTabStrip"
                                  ItemsSource="{Binding LayerTabs}"
                                  Margin="0,0,0,8"
                                  Visibility="{Binding HasShiftLayers, Converter={StaticResource BoolToVisibilityConverter}}">
                        <!-- WrapPanel so layers with many activators flow
                             to a second row when the window narrows
                             instead of clipping off the right edge. -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="ShiftLayerTabs"
                                             Style="{StaticResource ShiftLayerTabChip}"
                                             IsChecked="{Binding IsActive, Mode=TwoWay}"
                                             Margin="0,0,4,4"
                                             Padding="10,4"
                                             Click="ShiftLayerTab_Click"
                                             Tag="{Binding LayerMask}">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Per-layer color dot. Hidden on the Base
                                             tab; visible (gray default or authored
                                             color) for every shift layer. -->
                                        <Ellipse Width="8" Height="8"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding Color, Converter={StaticResource HexToBrushConverter}}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBase}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding LayerName}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <!-- Per-tab context menu, shown on every
                                         tab including Base (round seven, R7:
                                         an older comment here claimed the
                                         first three were disabled for Base,
                                         which nothing implemented). On the
                                         Base tab: Configure opens the
                                         base-appearance dialog, Rename edits
                                         a legacy activator's display name if
                                         one exists, and Delete removes only
                                         a legacy "Base"-masked activator,
                                         never base rows or macros
                                         (ExecuteLayerDelete heals). Copy /
                                         Paste / Clear work against Base rows
                                         as always. -->
                                    <RadioButton.ContextMenu>
                                        <ContextMenu>
                                            <ContextMenu.Resources>
                                                <!-- #175 hover-glow: item hover is the stock
                                                     subtle-fill steel highlight. StaticResource
                                                     resolves lexically, so the page-level glow
                                                     effect is reachable from the popup. -->
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContextMenu.Resources>
                                            <MenuItem Header="{Binding Pad_Shift_Configure, Source={x:Static strings:Strings.Instance}}"
                                                      Click="ShiftLayer_Configure_Click"
                                                      Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="{Binding Pad_Shift_Rename, Source={x:Static strings:Strings.Instance}}"
                                                      Click="ShiftLayer_Rename_Click"
                                                      Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <Separator/>
                                            <MenuItem Header="{Binding Pad_Shift_Copy, Source={x:Static strings:Strings.Instance}}"
                                                      Click="ShiftLayer_Copy_Click"
                                                      Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="{Binding Pad_Shift_Paste, Source={x:Static strings:Strings.Instance}}"
                                                      Click="ShiftLayer_Paste_Click"
                                                      Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="{Binding Pad_Shift_Clear, Source={x:Static strings:Strings.Instance}}"
                                                      Click="ShiftLayer_Clear_Click"
                                                      Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <Separator/>
                                            <MenuItem Header="{Binding Pad_Shift_Delete, Source={x:Static strings:Strings.Instance}}"
                                                      Click="ShiftLayer_Delete_Click"
                                                      Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        </ContextMenu>
                                    </RadioButton.ContextMenu>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Pipeline heat chips (#175 item 10): one chip per
                         transform pipeline currently rewiring this slot's
                         input. CURVE / GYRO / SHIFT / INV / DZ are mono
                         locale-neutral tokens (DZ / PEAK / DIRECT
                         precedent). A chip renders only while its pipeline
                         carries configuration; the flame inside fills ember
                         while an owning row's live value is active this
                         frame (rowfire lane, no extra timer). Click scrolls
                         the grid to the owning row; repeat clicks cycle
                         when several rows own the pipeline. SHIFT cycles
                         the layer tabs instead. Tooltips list the real
                         configured rows. -->
                    <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8"
                               Visibility="{Binding HasAnyPipelineChips, Converter={StaticResource BoolToVisibilityConverter}}">
                        <WrapPanel.Resources>
                            <!-- Shared chip skeleton: ChipEmber grammar plus
                                 the clickable hover bloom. Static effect from
                                 a trigger, never animated. -->
                            <Style x:Key="PipelineChip" TargetType="Border" BasedOn="{StaticResource ChipEmber}">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Margin" Value="0,0,6,4"/>
                                <Setter Property="Padding" Value="8,2"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Effect" Value="{StaticResource EmberHoverGlow}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style x:Key="PipelineChipToken" TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}"/>
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                            <!-- Structured tooltip line (user report 2026-07-05:
                                 the chip tooltip ran the whole listing as one
                                 long line). Three lanes on one template, toggled
                                 by the row flags: a device header (only when
                                 several controllers feed the set), the mono
                                 "OUTPUT ← source" mapping line with a shared-
                                 size output column, or the "+N" overflow tail.
                                 Rows come from PadViewModel.BuildPipelineTipRows
                                 on the 1 s config lane. -->
                            <DataTemplate x:Key="PipelineTipRowTemplate">
                                <Grid>
                                    <TextBlock x:Name="TipHeader" Visibility="Collapsed"
                                               Text="{Binding Text}"
                                               FontFamily="{StaticResource TelemetryFontFamily}"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,6,0,2"/>
                                    <Grid x:Name="TipLine" Margin="0,1,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="PipelineTipOutput"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Output}"
                                                   FontFamily="{StaticResource TelemetryFontFamily}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource EmberHotBrush}"/>
                                        <TextBlock Grid.Column="1" Text="←" Margin="8,0,8,0"
                                                   FontFamily="{StaticResource TelemetryFontFamily}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                                   FontFamily="{StaticResource TelemetryFontFamily}"
                                                   FontSize="11"
                                                   MaxWidth="300" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                        <Setter TargetName="TipHeader" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="TipLine" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsTail}" Value="True">
                                        <Setter TargetName="TipHeader" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="TipHeader" Property="FontWeight" Value="Normal"/>
                                        <Setter TargetName="TipHeader" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <Setter TargetName="TipLine" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </WrapPanel.Resources>

                        <!-- CURVE: any curve-bearing output with a non-linear
                             sensitivity curve. -->
                        <Border Style="{StaticResource PipelineChip}" Tag="Curve"
                                MouseLeftButtonUp="PipelineChip_Click"
                                Visibility="{Binding PipelineCurveActive, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.ToolTip>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <Path Style="{StaticResource LivenessFlameBase}" Margin="0,0,5,0"/>
                                        <TextBlock Text="CURVE" Style="{StaticResource PipelineChipToken}"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding PipelineCurveTipRows}"
                                                  ItemTemplate="{StaticResource PipelineTipRowTemplate}"
                                                  Grid.IsSharedSizeScope="True"/>
                                </StackPanel>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <Path Margin="0,0,5,0">
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource LivenessFlameBase}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PipelineCurveLive}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                                    <Setter Property="Stroke" Value="{x:Null}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#FF6B2C" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="CURVE" Style="{StaticResource PipelineChipToken}"/>
                            </StackPanel>
                        </Border>

                        <!-- GYRO: rows fed by a Gyro axis source. -->
                        <Border Style="{StaticResource PipelineChip}" Tag="Gyro"
                                MouseLeftButtonUp="PipelineChip_Click"
                                Visibility="{Binding PipelineGyroActive, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.ToolTip>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <Path Style="{StaticResource LivenessFlameBase}" Margin="0,0,5,0"/>
                                        <TextBlock Text="GYRO" Style="{StaticResource PipelineChipToken}"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding PipelineGyroTipRows}"
                                                  ItemTemplate="{StaticResource PipelineTipRowTemplate}"
                                                  Grid.IsSharedSizeScope="True"/>
                                </StackPanel>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <Path Margin="0,0,5,0">
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource LivenessFlameBase}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PipelineGyroLive}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                                    <Setter Property="Stroke" Value="{x:Null}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#FF6B2C" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="GYRO" Style="{StaticResource PipelineChipToken}"/>
                            </StackPanel>
                        </Border>

                        <!-- SHIFT: slot has layers beyond Base; flames while
                             the engine holds a non-Base layer engaged. -->
                        <Border Style="{StaticResource PipelineChip}" Tag="Shift"
                                MouseLeftButtonUp="PipelineChip_Click"
                                Visibility="{Binding PipelineShiftActive, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.ToolTip>
                                <TextBlock Text="{Binding PipelineShiftSummary}"
                                           FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11"/>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <Path Margin="0,0,5,0">
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource LivenessFlameBase}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PipelineShiftLive}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                                    <Setter Property="Stroke" Value="{x:Null}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#FF6B2C" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="SHIFT" Style="{StaticResource PipelineChipToken}"/>
                            </StackPanel>
                        </Border>

                        <!-- INV: rows with the invert transform on. -->
                        <Border Style="{StaticResource PipelineChip}" Tag="Invert"
                                MouseLeftButtonUp="PipelineChip_Click"
                                Visibility="{Binding PipelineInvertActive, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.ToolTip>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <Path Style="{StaticResource LivenessFlameBase}" Margin="0,0,5,0"/>
                                        <TextBlock Text="INV" Style="{StaticResource PipelineChipToken}"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding PipelineInvertTipRows}"
                                                  ItemTemplate="{StaticResource PipelineTipRowTemplate}"
                                                  Grid.IsSharedSizeScope="True"/>
                                </StackPanel>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <Path Margin="0,0,5,0">
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource LivenessFlameBase}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PipelineInvertLive}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                                    <Setter Property="Stroke" Value="{x:Null}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#FF6B2C" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="INV" Style="{StaticResource PipelineChipToken}"/>
                            </StackPanel>
                        </Border>

                        <!-- DZ: rows with a per-mapping deadzone off its
                             50% default. -->
                        <Border Style="{StaticResource PipelineChip}" Tag="DeadZone"
                                MouseLeftButtonUp="PipelineChip_Click"
                                Visibility="{Binding PipelineDeadZoneActive, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.ToolTip>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <Path Style="{StaticResource LivenessFlameBase}" Margin="0,0,5,0"/>
                                        <TextBlock Text="DZ" Style="{StaticResource PipelineChipToken}"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding PipelineDeadZoneTipRows}"
                                                  ItemTemplate="{StaticResource PipelineTipRowTemplate}"
                                                  Grid.IsSharedSizeScope="True"/>
                                </StackPanel>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <Path Margin="0,0,5,0">
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource LivenessFlameBase}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PipelineDeadZoneLive}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                                    <Setter Property="Stroke" Value="{x:Null}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#FF6B2C" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="DZ" Style="{StaticResource PipelineChipToken}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- Mapping DataGrid. HorizontalAlignment=Left so the DataGrid
                         doesn't stretch wider than its columns sum to. Without
                         this, any Auto / SizeToCells column absorbs the leftover
                         horizontal slack and bloats. With HorizontalAlignment=Left,
                         each column genuinely auto-collapses to its own content
                         and any empty space sits to the right of the grid. -->
                    <DataGrid Grid.Row="3"
                              x:Name="MappingDataGrid"
                              HorizontalAlignment="Left"
                              MinRowHeight="40"
                              ItemsSource="{Binding Mappings}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              IsReadOnly="True"
                              VerticalScrollBarVisibility="Visible"
                              Grid.IsSharedSizeScope="True"
                              SelectionChanged="MappingDataGrid_SelectionChanged"
                              Loaded="MappingDataGrid_Loaded">
                        <!-- Ember close-out item 8: mono eyebrow column headers
                             (spec 235-244). Attached directly here, NOT as an
                             implicit page-level style (that broke once with a
                             white bar). Uppercase is display-only via
                             UpperConverter; resource strings stay Title Case. -->
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}"/>
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource SteelLineSoftBrush}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource UpperConverter}}"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <!-- #175 hover-glow: stock header hover is a
                                     neutral fill change. -->
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <!-- HorizontalContentAlignment used to be Stretch here.
                                     That made every cell hand its child the full column
                                     width during arrange, which (combined with the
                                     CellsPanel's measure pass) inflated the Auto Options
                                     column to absorb the leftover horizontal slack of
                                     the row. Switched to Left so cells size and align
                                     to their content's actual DesiredSize. Columns
                                     that need horizontal fill (the Source ComboBox)
                                     set Stretch on their own template root. -->
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Style.Triggers>
                                    <!-- The base DataGridCell paints #FFF0F0F0 (the classic
                                         Windows control grey) on IsSelected, which is the
                                         searing white on a selected row in dark mode. Keep
                                         selected cells transparent so the row's subtle ember
                                         wash shows through uniformly, and hold the text light. -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="Transparent"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <!-- Compact rows (trivial + collapsed fan-in) have
                                     their cells collapsed, so a click never reaches a
                                     DataGridCell and WPF's own selection logic won't
                                     fire. The handler expands + selects the row (#175
                                     telemetry board / phase two item 10). Enter/Space
                                     on a focused row toggles it open and closed. -->
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="MappingRow_PreviewMouseLeftButtonDown"/>
                                <EventSetter Event="PreviewKeyDown" Handler="MappingRow_PreviewKeyDown"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <!-- Rowfire (#175 artifact .mrow::after): the
                                             underline lives at the CELLS' bottom edge,
                                             above the details presenter, exactly where
                                             the pitch draws it. -->
                                        <ControlTemplate TargetType="DataGridRow">
                                            <Border x:Name="DGR_Border"
                                                    Background="{TemplateBinding Background}"
                                                    SnapsToDevicePixels="True">
                                                <SelectiveScrollingGrid>
                                                    <SelectiveScrollingGrid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </SelectiveScrollingGrid.RowDefinitions>
                                                    <DataGridCellsPresenter x:Name="CellsHost"
                                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                    <!-- Compact line (#175 telemetry board):
                                                         a plain Direct row with no options collapses
                                                         to one 26px mono line so a whole config reads
                                                         on one screen. Clicking it expands the row
                                                         back to the full editor via IsExpandedOverride
                                                         (set in code-behind). The liveness flame is the
                                                         static liveness cue; rowfire below still
                                                         animates on compact rows.
                                                         Phase two item 10: unselected fan-in rows
                                                         (HasExtraSources) collapse to this same line
                                                         plus a "+N" tail and the combine token, and
                                                         expand via selection instead of the override.
                                                         The output segment is a shared-size column
                                                         (scope = the DataGrid) so collapsed lines read
                                                         as an aligned board, same construction as the
                                                         pipeline-tip listing's shared output column. -->
                                                    <Grid x:Name="CompactLine" Height="26" Margin="10,0,8,0"
                                                          Visibility="Collapsed">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="CompactRowOutput"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <!-- Liveness flame (brand canon, supersedes
                                                                 dots): ashen outline at rest, ember fill +
                                                                 static glow while input flows through the
                                                                 row. Static setters, reduced-motion safe. -->
                                                            <Path Margin="0,0,8,0">
                                                                <Path.Style>
                                                                    <Style TargetType="Path" BasedOn="{StaticResource LivenessFlameBase}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsInputActive}" Value="True">
                                                                                <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                                                                <Setter Property="Stroke" Value="{x:Null}"/>
                                                                                <Setter Property="Effect">
                                                                                    <Setter.Value>
                                                                                        <DropShadowEffect Color="#FF6B2C" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                            <TextBlock Text="{Binding TargetLabel}"
                                                                       FontWeight="SemiBold" FontSize="12"
                                                                       Foreground="{DynamicResource EmberHotBrush}"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <TextBlock Text="←"
                                                                       FontFamily="{StaticResource TelemetryFontFamily}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                       VerticalAlignment="Center" Margin="8,0,6,0"/>
                                                            <TextBlock Text="{Binding SourceDisplayText, Mode=OneWay}"
                                                                       FontFamily="{StaticResource TelemetryFontFamily}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <!-- Source device (user report 2026-07-04: "Button A
                                                                 from which device?!"): the compact line carries
                                                                 the feeding device, dimmer, after the source. -->
                                                            <TextBlock Text="{Binding PrimarySourceDeviceLabel}"
                                                                       FontFamily="{StaticResource TelemetryFontFamily}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                       Opacity="0.7"
                                                                       VerticalAlignment="Center" Margin="10,0,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding PrimarySourceDeviceLabel}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <!-- Fan-in tail: "+N" for the extra sources
                                                                 feeding this output, same grammar as the
                                                                 pipeline-tip overflow tail. Collapses on
                                                                 trivial lines (no extras by definition). -->
                                                            <TextBlock FontFamily="{StaticResource TelemetryFontFamily}"
                                                                       FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource ColdBrush}"
                                                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                                                       Text="{Binding ExtraSources.Count, Mode=OneWay, StringFormat={}+{0}}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ExtraSources.Count}" Value="0">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <!-- Combine token chip: the engine's locale-
                                                                 neutral mode value (MaxAbs / OR / XOR…),
                                                                 display-uppercased like the column headers.
                                                                 Cold chip family: combining is a source-
                                                                 side affair. Hidden alongside the +N tail,
                                                                 and when the mode is still the implicit-
                                                                 default empty sentinel. -->
                                                            <Border CornerRadius="3" BorderThickness="1"
                                                                    Padding="5,1" Margin="8,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Background="#0D58B6E4">
                                                                <Border.BorderBrush>
                                                                    <SolidColorBrush Color="#3D58B6E4"/>
                                                                </Border.BorderBrush>
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ExtraSources.Count}" Value="0">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding CombineMode}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding CombineMode, Converter={StaticResource UpperConverter}}"
                                                                           FontFamily="{StaticResource TelemetryFontFamily}"
                                                                           FontSize="9.5"
                                                                           Foreground="{DynamicResource ColdBrush}"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Rectangle x:Name="Rowfire" Height="1.5"
                                                               VerticalAlignment="Bottom"
                                                               Margin="8,0,8,0" Opacity="0"
                                                               IsHitTestVisible="False">
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                                                <GradientStop Color="#8058B6E4" Offset="0"/>
                                                                <GradientStop Color="#99FF6B2C" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                    <DataGridDetailsPresenter Grid.Row="1"
                                                        Visibility="{TemplateBinding DetailsVisibility}"/>
                                                </SelectiveScrollingGrid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!-- Compact swap (#175 telemetry board): trivial
                                                     Direct rows hide the cell set and show the
                                                     one-line summary until clicked (expansion
                                                     override) or selected. -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsTrivialDirect}" Value="True"/>
                                                        <Condition Binding="{Binding IsExpandedOverride}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="CellsHost" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="CompactLine" Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                                <!-- Fan-in compact swap (#175 phase two item 10):
                                                     an unselected multi-source row collapses to
                                                     the one-line summary; selecting it brings back
                                                     the full cells and opens the details editor.
                                                     IsRowSelected mirrors DataGrid selection (set
                                                     in SelectionChanged). The IsExpandedOverride
                                                     condition keeps the Loaded-time column-width
                                                     measure pass honest: it force-expands compact
                                                     rows off-frame through that flag. -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasExtraSources}" Value="True"/>
                                                        <Condition Binding="{Binding IsRowSelected}" Value="False"/>
                                                        <Condition Binding="{Binding IsExpandedOverride}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="CellsHost" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="CompactLine" Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                                <!-- Reduced motion (#175 item 98): rowfire only
                                                     animates when the OS animation preference
                                                     (ClientAreaAnimation) is on. -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsInputActive}" Value="True"/>
                                                        <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Rowfire"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 To="1" Duration="0:0:0.3">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.EnterActions>
                                                    <MultiDataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Rowfire"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 To="0" Duration="0:0:1.2">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseIn"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <!-- Selected row: a subtle ember wash. The stock selection
                                         fill reads near-white in dark mode and is retina-searing
                                         against the steel ground. Kept below the recording tint
                                         (#30) so an armed row still reads hotter; the recording
                                         triggers sit after this one so they win when both hold. -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="#24FF6B2C"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <!-- Reduced motion (#175 item 98): the looping arm-flash
                                         only runs when ClientAreaAnimation is on; otherwise
                                         the armed row holds a static ember tint.
                                         The pulse holds the ember tint via the setter and
                                         breathes the row's Opacity, a single-step path. The
                                         old (Background).(Color) complex path crashed when a
                                         recording row re-realized under virtualization: the
                                         trigger is already true mid-instantiation, before the
                                         row's Background is an animatable local brush (same
                                         class as the forge-bar and v4.0.0 launch crashes). -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsRecording}" Value="True"/>
                                            <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="#48FF6B2C"/>
                                        <MultiDataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="RecordFlash">
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="Opacity"
                                                        From="1.0" To="0.55"
                                                        Duration="0:0:0.4" AutoReverse="True"
                                                        RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </MultiDataTrigger.EnterActions>
                                        <MultiDataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="RecordFlash"/>
                                        </MultiDataTrigger.ExitActions>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsRecording}" Value="True"/>
                                            <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="#30FF6B2C"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.RowDetailsVisibilityMode>VisibleWhenSelected</DataGrid.RowDetailsVisibilityMode>
                        <DataGrid.RowDetailsTemplate>
                            <!-- Issue #61 multi-source: per-row details
                                 visible when the row is selected. Shows
                                 the row's combine mode, the list of
                                 ExtraSources (sources beyond the primary
                                 single-source), and a + Add source link
                                 to append a new source. -->
                            <DataTemplate>
                                <!-- Subpanel look (#175 artifact .subpanel): 2px cold left
                                     rail, faint cold wash, rounded on the free right side
                                     only (radius 0,8,8,0). rgba(88,182,228,0.03) = #0858B6E4. -->
                                <Border Padding="20,4,8,8"
                                        BorderThickness="2,0,0,0"
                                        CornerRadius="0,8,8,0"
                                        Background="#0858B6E4">
                                    <Border.Style>
                                        <!-- Rail tints to the active layer's authored
                                             color (#175); cold when the layer has none.
                                             Converter's gray fallback never shows: the
                                             empty-string trigger wins first. -->
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush"
                                                    Value="{Binding DataContext.ActiveLayerColor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource HexToBrushConverter}}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.ActiveLayerColor, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="">
                                                    <Setter Property="BorderBrush" Value="#3D58B6E4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Vertical">
                                        <!-- Primary mode + kind tuning (#111). The Mode dropdown lives here
                                             in the detail strip so the Source cell holds only the mapping and
                                             never crowds the input picker. Set it to Direct (or hit the row's
                                             Clear) to drop the kind. The Ramp / Incremental sliders below are
                                             gated by kind. DataContext is the row's PrimaryKindSource. -->
                                        <StackPanel DataContext="{Binding PrimaryKindSource}" Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Pad_Mapping_PrimaryMode, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                                           FontFamily="{StaticResource TelemetryFontFamily}"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="10"/>
                                                <ComboBox ItemsSource="{Binding DataContext.PrimaryKindOptions, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"
                                                          SelectedValue="{Binding Kind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          SelectedValuePath="Value" DisplayMemberPath="Name"
                                                          MinWidth="130" Padding="4,2" VerticalAlignment="Center"
                                                          ToolTip="{Binding Pad_Mapping_Kind_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                          PreviewKeyDown="MappingComboBox_PreviewKeyDown"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        Visibility="{Binding IsRampedKind, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Mapping_Ramp_Attack, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <Slider Value="{Binding ParamAttackTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="2" SmallChange="0.05" LargeChange="0.25" Width="80" VerticalAlignment="Center"
                                                        ToolTip="{Binding Pad_Mapping_Ramp_Attack_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <TextBox Text="{Binding ParamAttackTime, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}" Width="44" Margin="4,0,8,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Mapping_Ramp_Release, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <Slider Value="{Binding ParamReleaseTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="2" SmallChange="0.05" LargeChange="0.25" Width="80" VerticalAlignment="Center"
                                                        ToolTip="{Binding Pad_Mapping_Ramp_Release_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <TextBox Text="{Binding ParamReleaseTime, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}" Width="44" Margin="4,0,8,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Mapping_Ramp_Reverse, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <Slider Value="{Binding ParamReverseMultiplier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="10" SmallChange="1" LargeChange="1" Width="70" VerticalAlignment="Center"
                                                        ToolTip="{Binding Pad_Mapping_Ramp_Reverse_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <TextBox Text="{Binding ParamReverseMultiplier, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.0}}" Width="40" Margin="4,0,8,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                                <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Mapping_Ramp_Autocenter, Source={x:Static strings:Strings.Instance}}" IsChecked="{Binding ParamAutocenter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                          ToolTip="{Binding Pad_Mapping_Ramp_Autocenter_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        Visibility="{Binding IsIncrementalKind, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Mapping_Rate, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <Slider Value="{Binding ParamRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0.05" Maximum="5" SmallChange="0.05" LargeChange="0.5" Width="80" VerticalAlignment="Center"
                                                        ToolTip="{Binding Pad_Mapping_Rate_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <TextBox Text="{Binding ParamRate, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}" Width="44" Margin="4,0,8,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                                <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Mapping_Sticky, Source={x:Static strings:Strings.Instance}}" IsChecked="{Binding ParamSticky, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                          ToolTip="{Binding Pad_Mapping_Sticky_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Mapping_Min, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                <TextBox Text="{Binding ParamMin, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}" Width="44" Margin="0,0,6,0" Padding="2,1" VerticalContentAlignment="Center"
                                                         ToolTip="{Binding Pad_Mapping_Min_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Mapping_Max, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                <TextBox Text="{Binding ParamMax, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}" Width="44" Margin="0,0,4,0" Padding="2,1" VerticalContentAlignment="Center"
                                                         ToolTip="{Binding Pad_Mapping_Max_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Combine row — visible only on multi-source rows.
                                             Bound to AvailableCombineModes which pairs the
                                             engine's name (MaxAbs / OR / XOR…) with a layman
                                             label + one-line description so non-STEM users
                                             aren't staring at acronyms. EnsureCombineModeDefault
                                             auto-picks MaxAbs/OR per target class on first
                                             multi-source transition. -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                                    Visibility="{Binding IsMultiSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding Pad_Combine_Label, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}"
                                                       FontSize="10"
                                                       FontFamily="{StaticResource TelemetryFontFamily}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Margin="0,0,8,0"/>
                                            <ComboBox ItemsSource="{Binding AvailableCombineModes}"
                                                      SelectedValue="{Binding CombineMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Value"
                                                      DisplayMemberPath="Name"
                                                      MinWidth="200" Margin="0" Padding="4,2"
                                                      VerticalAlignment="Center"
                                                      ToolTip="{Binding Pad_Combine_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                      PreviewKeyDown="MappingComboBox_PreviewKeyDown">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Vertical" Margin="0,2,0,2">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                            <!-- Description renders in the dropdown only (#175
                                                                 item 5): the selection box has no ComboBoxItem
                                                                 ancestor, so FindAncestor yields null and the
                                                                 closed face collapses to the one-line name.
                                                                 Plain converter binding, not a Style trigger
                                                                 (stack-overflow precedent, 2026-07-04). -->
                                                            <TextBlock Text="{Binding Description}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       TextWrapping="Wrap"
                                                                       Visibility="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ComboBoxItem}}, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>


                                        <!-- Stick Trim settings (#155): only visible when the
                                             row is multi-source AND Stick Trim is the picked
                                             combine, the ShouldShowCustomExpression gating
                                             pattern. The row's LAST source is the trim stick.
                                             The earlier sources gate the trigger. -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                                    Visibility="{Binding ShouldShowTrimSettings, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Mapping_TrimDeadzone, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <Slider Value="{Binding TrimDeadzone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="95" SmallChange="1" LargeChange="5" Width="80" VerticalAlignment="Center"
                                                    ToolTip="{Binding Pad_Mapping_TrimDeadzone_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <TextBox Text="{Binding TrimDeadzone, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="36" Margin="4,0,0,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="%" VerticalAlignment="Center" Margin="1,0,2,0"/>
                                            <ui:Button Command="{Binding ResetTrimDeadzoneCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetTrimDeadzone, Source={x:Static strings:Strings.Instance}}" Margin="0,0,8,0"/>
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Mapping_TrimRate, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <Slider Value="{Binding TrimRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="10" Maximum="400" SmallChange="10" LargeChange="50" Width="80" VerticalAlignment="Center"
                                                    ToolTip="{Binding Pad_Mapping_TrimRate_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <TextBox Text="{Binding TrimRate, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="40" Margin="4,0,0,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="%/s" VerticalAlignment="Center" Margin="1,0,2,0"/>
                                            <ui:Button Command="{Binding ResetTrimRateCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetTrimRate, Source={x:Static strings:Strings.Instance}}" Margin="0,0,8,0"/>
                                            <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Mapping_TrimReset, Source={x:Static strings:Strings.Instance}}" IsChecked="{Binding TrimResetOnRelease, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,2,0"
                                                      ToolTip="{Binding Pad_Mapping_TrimReset_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ui:Button Command="{Binding ResetTrimResetOnReleaseCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetTrimResetOnRelease, Source={x:Static strings:Strings.Instance}}" Margin="0,0,8,0"/>
                                        </StackPanel>

                                        <!-- Custom formula editor: only visible when the row
                                             is multi-source AND Custom is the picked combine.
                                             Gating on ShouldShowCustomExpression instead of
                                             just IsCustomCombine means removing the last
                                             extra source also collapses the formula box,
                                             instead of leaving stale text on a single-source
                                             row. The italic placeholder shows an example
                                             until the user types something. -->
                                        <!-- Custom formula visual editor — chip palette
                                             below a free-text formula box. Users who don't
                                             want to type can build a formula by clicking
                                             chips (each chip's Tag is inserted at the
                                             caret) or load a complete preset by clicking
                                             one of the named buttons. The Click handlers
                                             live in PadPage.xaml.cs and use VisualTreeHelper
                                             to find the named TextBox inside the same
                                             FormulaEditor StackPanel — that avoids the
                                             ComboBox-SelectedItem write-back hell that
                                             made the previous Quick fill dropdown unable
                                             to populate the formula on selection. -->
                                        <StackPanel x:Name="FormulaEditor" Orientation="Vertical" Margin="0,0,0,4"
                                                    Visibility="{Binding ShouldShowCustomExpression, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBox x:Name="CustomFormulaBox"
                                                     Text="{Binding CombineExpression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     MinWidth="380" Padding="6,4"
                                                     VerticalAlignment="Center"
                                                     FontFamily="{StaticResource TelemetryFontFamily}"
                                                     AllowDrop="True"
                                                     ToolTip="{Binding Pad_Formula_TextBox_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <TextBlock Text="{Binding CombineExpressionStatus}"
                                                       FontSize="10" FontFamily="{StaticResource TelemetryFontFamily}"
                                                       Margin="2,2,0,4"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#16C60C"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCombineExpressionWarning}" Value="True">
                                                                <Setter Property="Foreground" Value="#F2A33C"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCombineExpressionInvalid}" Value="True">
                                                                <Setter Property="Foreground" Value="#C42B1C"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Chip palette: variables, operators, numbers,
                                                 functions. Tag carries the literal text to
                                                 insert at the formula's caret. -->
                                            <TextBlock Text="{Binding Pad_Formula_Insert, Source={x:Static strings:Strings.Instance}}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Margin="2,4,0,2"/>
                                            <WrapPanel Margin="0,0,0,4">
                                                <WrapPanel.Resources>
                                                    <Style x:Key="FormulaChipStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Padding" Value="6,2"/>
                                                        <Setter Property="Margin" Value="0,0,3,3"/>
                                                        <Setter Property="MinWidth" Value="28"/>
                                                        <Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}"/>
                                                        <Setter Property="FontSize" Value="11"/>
                                                        <!-- Drag-out support: PreviewMouseLeftButtonDown
                                                             records the start point, MouseMove past the
                                                             drag threshold starts the DragDrop with the
                                                             chip's Tag (the literal text to insert)
                                                             as the data payload. The formula TextBox
                                                             has AllowDrop=True; WPF's built-in text
                                                             drop behavior inserts at the drop point. -->
                                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="FormulaChip_PreviewMouseLeftButtonDown"/>
                                                        <EventSetter Event="PreviewMouseMove" Handler="FormulaChip_PreviewMouseMove"/>
                                                    </Style>
                                                </WrapPanel.Resources>
                                                <!-- Source variables (a-d cover most rows; users with
                                                     more sources can type the rest). Tooltips bind to
                                                     the row's per-position friendly alias so users
                                                     see what `a/b/c/d` mean for THIS row. -->
                                                <!-- Variable chips: a..z. Each chip's Visibility tracks the
                                                     row's VariableCount (1 primary + ExtraSources) so the user
                                                     only sees letters that bind to a real source. -->
                                                <Button Content="a" Tag="a" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding VariableATooltip}" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=0}"/>
                                                <Button Content="b" Tag="b" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding VariableBTooltip}" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=1}"/>
                                                <Button Content="c" Tag="c" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding VariableCTooltip}" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=2}"/>
                                                <Button Content="d" Tag="d" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding VariableDTooltip}" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=3}"/>
                                                <Button Content="e" Tag="e" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=4}"/>
                                                <Button Content="f" Tag="f" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=5}"/>
                                                <Button Content="g" Tag="g" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=6}"/>
                                                <Button Content="h" Tag="h" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=7}"/>
                                                <Button Content="i" Tag="i" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=8}"/>
                                                <Button Content="j" Tag="j" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=9}"/>
                                                <Button Content="k" Tag="k" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=10}"/>
                                                <Button Content="l" Tag="l" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=11}"/>
                                                <Button Content="m" Tag="m" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=12}"/>
                                                <Button Content="n" Tag="n" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=13}"/>
                                                <Button Content="o" Tag="o" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=14}"/>
                                                <Button Content="p" Tag="p" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=15}"/>
                                                <Button Content="q" Tag="q" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=16}"/>
                                                <Button Content="r" Tag="r" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=17}"/>
                                                <Button Content="s" Tag="s" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=18}"/>
                                                <Button Content="t" Tag="t" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=19}"/>
                                                <Button Content="u" Tag="u" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=20}"/>
                                                <Button Content="v" Tag="v" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=21}"/>
                                                <Button Content="w" Tag="w" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=22}"/>
                                                <Button Content="x" Tag="x" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=23}"/>
                                                <Button Content="y" Tag="y" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=24}"/>
                                                <Button Content="z" Tag="z" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=25}"/>
                                                <!-- Touchpad-only "is touching" flags. Visible on
                                                     TouchpadX*/Y* rows; resolve to 1.0 while the
                                                     paired finger is touching, 0.0 when lifted. Used
                                                     to write gated formulas like
                                                     `aD ? a : (bD ? b : 0.5)` so a stale finger
                                                     position can't pollute the combine. The flag
                                                     channel is only supplied by the touchpad-
                                                     passthrough evaluator — referencing aD on a
                                                     non-touchpad row resolves to 0. -->
                                                <Button Content="aD" Tag="aD" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click"
                                                        ToolTip="{Binding Pad_Formula_Chip_TouchpadFlag_A, Source={x:Static strings:Strings.Instance}}"
                                                        Visibility="{Binding IsTouchpadAxisTarget, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <Button Content="bD" Tag="bD" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click"
                                                        ToolTip="{Binding Pad_Formula_Chip_TouchpadFlag_B, Source={x:Static strings:Strings.Instance}}"
                                                        Visibility="{Binding IsTouchpadAxisTarget, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <Button Content="cD" Tag="cD" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click"
                                                        ToolTip="{Binding Pad_Formula_Chip_TouchpadFlag_C, Source={x:Static strings:Strings.Instance}}"
                                                        Visibility="{Binding IsTouchpadAxisTarget, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <Button Content="dD" Tag="dD" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click"
                                                        ToolTip="{Binding Pad_Formula_Chip_TouchpadFlag_D, Source={x:Static strings:Strings.Instance}}"
                                                        Visibility="{Binding IsTouchpadAxisTarget, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <!-- Operators -->
                                                <Border Width="6"/>
                                                <Button Content="+" Tag=" + " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Add, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="−" Tag=" - " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Subtract, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="×" Tag=" * " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Multiply, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="÷" Tag=" / " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Divide, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="−A" Tag="-a" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_NegateA, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="(" Tag="(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_OpenGroup, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content=")" Tag=")" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_CloseGroup, Source={x:Static strings:Strings.Instance}}"/>
                                                <!-- Numbers -->
                                                <Border Width="6"/>
                                                <Button Content="0" Tag="0" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click"/>
                                                <Button Content="½" Tag="0.5" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Half, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="1" Tag="1" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click"/>
                                                <Button Content="2" Tag="2" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click"/>
                                                <!-- Comparisons (yield 0 / 1 for use in if-then-else or scaled by *) -->
                                                <Border Width="6"/>
                                                <Button Content="&lt;" Tag=" &lt; " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_LessThan, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="&gt;" Tag=" &gt; " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_GreaterThan, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="≤" Tag=" &lt;= " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_LessOrEqual, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="≥" Tag=" &gt;= " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_GreaterOrEqual, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="=" Tag=" == " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Equal, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="≠" Tag=" != " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_NotEqual, Source={x:Static strings:Strings.Instance}}"/>
                                                <!-- Logic + if-then-else -->
                                                <Border Width="6"/>
                                                <Button Content="and" Tag=" &amp;&amp; " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_BothConditions, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="or" Tag=" || " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_EitherCondition, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="not" Tag="!" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_FlipBool, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="if?" Tag=" ? " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_If, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="else:" Tag=" : " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Else, Source={x:Static strings:Strings.Instance}}"/>
                                                <!-- Functions -->
                                                <Border Width="6"/>
                                                <Button Content="abs" Tag="abs(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Abs, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="min" Tag="min(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Min, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="max" Tag="max(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Max, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="clamp" Tag="clamp(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Clamp, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="sign" Tag="sign(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Sign, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="lerp" Tag="lerp(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Lerp, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="round" Tag="round(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Round, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="sqrt" Tag="sqrt(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Sqrt, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="," Tag=", " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click"/>
                                            </WrapPanel>

                                            <!-- Preset buttons: load a complete formula
                                                 (replaces what's in the box). Each button's
                                                 Tag is the formula text. -->
                                            <TextBlock Text="{Binding Pad_Formula_StarterRecipes, Source={x:Static strings:Strings.Instance}}" FontSize="10"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Margin="2,2,0,2"/>
                                            <WrapPanel>
                                                <WrapPanel.Resources>
                                                    <Style x:Key="FormulaPresetStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Padding" Value="8,3"/>
                                                        <Setter Property="Margin" Value="0,0,4,3"/>
                                                        <Setter Property="FontSize" Value="11"/>
                                                    </Style>
                                                </WrapPanel.Resources>
                                                <Button Content="{Binding Pad_Formula_Preset_HalfScale_Name, Source={x:Static strings:Strings.Instance}}" Tag="a * 0.5"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Pad_Formula_Preset_HalfScale_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Pad_Formula_Preset_QuarterScale_Name, Source={x:Static strings:Strings.Instance}}" Tag="a * 0.25"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Pad_Formula_Preset_QuarterScale_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Pad_Formula_Preset_ReverseA_Name, Source={x:Static strings:Strings.Instance}}" Tag="-a"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Pad_Formula_Preset_ReverseA_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Pad_Formula_Preset_CapTo1_Name, Source={x:Static strings:Strings.Instance}}" Tag="clamp(a + b, -1, 1)"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Pad_Formula_Preset_CapTo1_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Pad_Formula_Preset_WeightedBlend_Name, Source={x:Static strings:Strings.Instance}}" Tag="a * 0.7 + b * 0.3"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Pad_Formula_Preset_WeightedBlend_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Pad_Formula_Preset_Difference_Name, Source={x:Static strings:Strings.Instance}}" Tag="a - b"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Pad_Formula_Preset_Difference_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Pad_Formula_Preset_AUnlessIdle_Name, Source={x:Static strings:Strings.Instance}}" Tag="a != 0 ? a : b"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Pad_Formula_Preset_AUnlessIdle_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Pad_Formula_Preset_ThresholdGate_Name, Source={x:Static strings:Strings.Instance}}" Tag="(a &gt; 0.5) ? 1 : 0"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Pad_Formula_Preset_ThresholdGate_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Pad_Formula_Preset_BothPressed_Name, Source={x:Static strings:Strings.Instance}}" Tag="(a &gt; 0) &amp;&amp; (b &gt; 0) ? 1 : 0"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Pad_Formula_Preset_BothPressed_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Pad_Formula_Preset_StrongerWins_Name, Source={x:Static strings:Strings.Instance}}" Tag="max(abs(a), abs(b)) * sign(a + b)"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Pad_Formula_Preset_StrongerWins_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <!-- Shared recipes from the macro custom-expression editor. Same
                                                     Macro_Expression_Recipe_* keys, already translated across all
                                                     10 locales. -->
                                                <Button Content="{Binding Macro_Expression_Recipe_Single, Source={x:Static strings:Strings.Instance}}" Tag="a"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Macro_Expression_Recipe_Single_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Macro_Expression_Recipe_Both, Source={x:Static strings:Strings.Instance}}" Tag="a &amp;&amp; b"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Macro_Expression_Recipe_Both_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Macro_Expression_Recipe_Either, Source={x:Static strings:Strings.Instance}}" Tag="a || b"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Macro_Expression_Recipe_Either_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Macro_Expression_Recipe_AButNotB, Source={x:Static strings:Strings.Instance}}" Tag="a &amp;&amp; !b"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Macro_Expression_Recipe_AButNotB_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Macro_Expression_Recipe_AxisOverHalf, Source={x:Static strings:Strings.Instance}}" Tag="abs(a - 0.5) &gt; 0.25"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Macro_Expression_Recipe_AxisOverHalf_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- ExtraSources list. Each row has its own
                                             cascading Device/Input picker: the Device
                                             ComboBox lists every device assigned to the
                                             slot, and the Input ComboBox draws from the
                                             per-source AvailableInputs (which the parent
                                             MappingItem refreshes whenever the source's
                                             DeviceGuid changes). Empty Device =
                                             "use the slot's primary device" — the parent
                                             falls the per-source AvailableInputs back to
                                             its own list in that case. -->
                                        <ItemsControl ItemsSource="{Binding ExtraSources}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- Extra source as a cold chip (#175 final
                                                         close-out): the sub-source row reads in
                                                         the src-chip language. Cold border and
                                                         wash, radius 8, kind glyph up front,
                                                         compact controls inside, remove ✕ at the
                                                         end. Controls stay inline (no per-source
                                                         focus state exists to collapse against). -->
                                                    <Border Background="#0D58B6E4" BorderThickness="1"
                                                            CornerRadius="8" Padding="7,3"
                                                            Margin="0,2,0,2" HorizontalAlignment="Left">
                                                        <Border.BorderBrush>
                                                            <SolidColorBrush Color="#3D58B6E4"/>
                                                        </Border.BorderBrush>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="↳" FontSize="14"
                                                                   Foreground="{DynamicResource ColdBrush}"
                                                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <!-- Kind selector. Schema/engine value ("Direct" / "Incremental" /
                                                             "InvertOnHold") round-trips via SelectedValue; the dropdown
                                                             shows the friendly display name from KindChoice.Name so the
                                                             user reads "Invert On Hold" instead of the camel-case identifier. -->
                                                        <!-- Instance binding, NOT x:Static: an x:Static ItemsSource is
                                                             evaluated once and never refreshes on a live language change. -->
                                                        <ComboBox ItemsSource="{Binding KindChoices}"
                                                                  SelectedValue="{Binding Kind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  SelectedValuePath="Value"
                                                                  DisplayMemberPath="Name"
                                                                  Width="150" Padding="4,2" Margin="0,0,6,0"
                                                                  VerticalAlignment="Center"
                                                                  ToolTip="{Binding Pad_Mapping_Kind_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                                  PreviewKeyDown="MappingComboBox_PreviewKeyDown"/>
                                                        <!-- Direction badge: visible only when the parent target is
                                                             a bipolar stick axis AND this source is button-class.
                                                             Derived from per-source Invert flag. -->
                                                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                                CornerRadius="3" Padding="4,1" Margin="0,0,4,0"
                                                                VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding DataContext.IsBipolarAxisTarget,
                                                                                            RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True"/>
                                                                                <Condition Binding="{Binding IsButtonClassDescriptor}" Value="True"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding DirectionBadge}" FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        </Border>
                                                        <!-- Cross-device grouped picker. ItemsSource is the
                                                             parent MappingItem's full cross-device flat list;
                                                             GroupStyle headers identify which device each
                                                             input belongs to. Selecting an InputChoice writes
                                                             both the source's Descriptor and DeviceGuid in
                                                             one shot via the InputChoiceToSource attached
                                                             behavior. Hidden for Incremental — that kind reads
                                                             its inputs from the Up/Down pickers on the row
                                                             below, not from a single source descriptor. -->
                                                        <StackPanel Orientation="Vertical" Margin="0,0,4,0"
                                                                    Visibility="{Binding IsKindDescriptorless, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                                            <ComboBox ItemsSource="{Binding DataContext.AvailableInputsView,
                                                                        RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"
                                                                      SelectedItem="{Binding SelectedInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      DisplayMemberPath="DisplayName"
                                                                      MinWidth="240" Padding="4,2"
                                                                      ToolTip="{Binding Pad_Mapping_ExtraSourcePickerTooltip, Source={x:Static strings:Strings.Instance}}"
                                                                      BorderBrush="#4D58B6E4" Background="#0D58B6E4"
                                                                      PreviewKeyDown="MappingComboBox_PreviewKeyDown"
                                                                      IsSynchronizedWithCurrentItem="False">
                                                                <ComboBox.GroupStyle>
                                                                    <GroupStyle>
                                                                        <GroupStyle.HeaderTemplate>
                                                                            <DataTemplate>
                                                                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                                                        Padding="6,3,6,3">
                                                                                    <TextBlock Text="{Binding Name}"
                                                                                               FontSize="11"
                                                                                               FontWeight="SemiBold"
                                                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                                               TextTrimming="CharacterEllipsis"/>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </GroupStyle.HeaderTemplate>
                                                                    </GroupStyle>
                                                                </ComboBox.GroupStyle>
                                                            </ComboBox>
                                                            <!-- Subtitle: assigned-device name when set,
                                                                 italic "Unassigned" when no descriptor. -->
                                                            <TextBlock FontSize="10"
                                                                       Foreground="{DynamicResource ColdMutedBrush}"
                                                                       Margin="4,1,0,0"
                                                                       TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="{Binding DeviceLabel}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Descriptor}" Value="">
                                                                                <Setter Property="Text" Value="{Binding Common_Unassigned, Source={x:Static strings:Strings.Instance}}"/>
                                                                                <Setter Property="FontStyle" Value="Italic"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <!-- InvertOnHold inline picker. Fits in the same slot
                                                             as the (hidden-for-InvertOnHold) source picker so
                                                             the whole row stays on one line. While the picked
                                                             modifier is held, the row's combined output is
                                                             sign-flipped — that's the B.3 reversible-throttle
                                                             shape (engine treats Kind=InvertOnHold sources as
                                                             row-level modifiers, see InputManager.Step3.
                                                             MappingSetEval.IsInvertOnHoldActive). -->
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,4,0"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding IsInvertOnHoldKind, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="⇋" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                       ToolTip="{Binding Pad_Mapping_Modifier_IconTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                            <StackPanel Orientation="Vertical" Margin="0,0,4,0">
                                                                <ComboBox ItemsSource="{Binding DataContext.AvailableInputsView,
                                                                            RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"
                                                                          SelectedItem="{Binding ParamModifierInputChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          DisplayMemberPath="DisplayName"
                                                                          MinWidth="240" Padding="4,2"
                                                                          ToolTip="{Binding Pad_Mapping_Modifier_PickerTooltip, Source={x:Static strings:Strings.Instance}}"
                                                                          PreviewKeyDown="MappingComboBox_PreviewKeyDown"
                                                                          IsSynchronizedWithCurrentItem="False">
                                                                    <ComboBox.GroupStyle>
                                                                        <GroupStyle>
                                                                            <GroupStyle.HeaderTemplate>
                                                                                <DataTemplate>
                                                                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,3,6,3">
                                                                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </GroupStyle.HeaderTemplate>
                                                                        </GroupStyle>
                                                                    </ComboBox.GroupStyle>
                                                                </ComboBox>
                                                                <TextBlock FontSize="10"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           Margin="4,1,0,0"
                                                                           TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="{Binding ParamModifierDeviceLabel}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ParamModifier}" Value="">
                                                                                    <Setter Property="Text" Value="{Binding Common_Unassigned, Source={x:Static strings:Strings.Instance}}"/>
                                                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <ui:Button Command="{Binding RecordParamModifierCommand}"
                                                                       Style="{StaticResource EmberIconButtonHot}"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding RecordIconParamModifier}" FontFamily="Segoe MDL2 Assets"
                                                                           Foreground="{DynamicResource EmberBrush}"/>
                                                                <ui:Button.ToolTip>
                                                                    <TextBlock Text="{Binding RecordTextParamModifier}"/>
                                                                </ui:Button.ToolTip>
                                                            </ui:Button>
                                                        </StackPanel>
                                                        <!-- Record / Clear / Options / DeadZone — for Direct sources only.
                                                             Incremental sources author their inputs through the dedicated
                                                             Up / Down pickers + Record buttons on the row below; the main
                                                             Descriptor / Invert / HalfAxis / DeadZone fields are unused for
                                                             that kind, so these controls would just be misleading noise. -->
                                                        <ui:Button Command="{Binding ToggleRecordCommand}"
                                                                   Style="{StaticResource EmberIconButtonHot}"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding IsKindDescriptorless, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                                            <TextBlock Text="{Binding RecordButtonIcon}" FontFamily="Segoe MDL2 Assets"
                                                                       Foreground="{DynamicResource EmberBrush}"/>
                                                            <ui:Button.ToolTip>
                                                                <TextBlock Text="{Binding RecordButtonText}"/>
                                                            </ui:Button.ToolTip>
                                                        </ui:Button>
                                                        <ui:Button Command="{Binding ClearCommand}"
                                                                   Style="{StaticResource EmberIconButtonHot}"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding IsKindDescriptorless, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                                            <TextBlock Text="&#xE75C;" FontFamily="Segoe MDL2 Assets"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                            <ui:Button.ToolTip>
                                                                <TextBlock Text="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}"/>
                                                            </ui:Button.ToolTip>
                                                        </ui:Button>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                                    Visibility="{Binding IsKindDescriptorless, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                                            <CheckBox Content="{Binding Pad_Invert, Source={x:Static strings:Strings.Instance}}"
                                                                      IsChecked="{Binding Invert, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      IsEnabled="{Binding IsInvertApplicable}"
                                                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11.5"
                                                                      Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <CheckBox Content="{Binding Pad_Half, Source={x:Static strings:Strings.Instance}}"
                                                                      IsChecked="{Binding HalfAxis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      IsEnabled="{Binding IsHalfAxisApplicable}"
                                                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11.5"
                                                                      Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <CheckBox Content="{Binding Pad_Either, Source={x:Static strings:Strings.Instance}}"
                                                                      ToolTip="{Binding Pad_Either_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                                      IsChecked="{Binding Bidirectional, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      IsEnabled="{Binding HalfAxis}"
                                                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11.5"
                                                                      Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <!-- Per-source gyro sensitivity. Only renders for
                                                             gyro descriptors so non-gyro sources don't see a
                                                             knob that does nothing. Sits before the deadzone
                                                             to match the primary-source row's order. -->
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0"
                                                                    Visibility="{Binding IsGyroSource, Converter={StaticResource BoolToVisibilityConverter}}">
