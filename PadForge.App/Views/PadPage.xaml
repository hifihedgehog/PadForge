                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="ParamAttackTime" SettingLabel="{Binding Pad_Mapping_Ramp_Attack, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MappingSourceItem_ParamAttackTime_4288" Margin="4,0,8,0"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Mapping_Ramp_Release, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <Slider Value="{Binding ParamReleaseTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="5" SmallChange="0.05" LargeChange="0.25" Width="80" VerticalAlignment="Center"
                                                        ToolTip="{Binding Pad_Mapping_Ramp_Release_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <TextBox Text="{Binding ParamReleaseTime, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}" Width="44" Margin="4,0,8,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="ParamReleaseTime" SettingLabel="{Binding Pad_Mapping_Ramp_Release, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MappingSourceItem_ParamReleaseTime_4292" Margin="4,0,8,0"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Mapping_Ramp_Reverse, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <Slider Value="{Binding ParamReverseMultiplier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="10" SmallChange="1" LargeChange="1" Width="70" VerticalAlignment="Center"
                                                        ToolTip="{Binding Pad_Mapping_Ramp_Reverse_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <TextBox Text="{Binding ParamReverseMultiplier, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.0}}" Width="40" Margin="4,0,8,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="ParamReverseMultiplier" SettingLabel="{Binding Pad_Mapping_Ramp_Reverse, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MappingSourceItem_ParamReverseMultiplier_4296" Margin="4,0,8,0"/>
                                                <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Mapping_Ramp_Autocenter, Source={x:Static strings:Strings.Instance}}" IsChecked="{Binding ParamAutocenter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                          ToolTip="{Binding Pad_Mapping_Ramp_Autocenter_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="ParamAutocenter" SettingLabel="{Binding Pad_Mapping_Ramp_Autocenter, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MappingSourceItem_ParamAutocenter_4299"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        Visibility="{Binding IsIncrementalKind, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Mapping_Rate, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <Slider Value="{Binding ParamRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0.05" Maximum="5" SmallChange="0.05" LargeChange="0.5" Width="80" VerticalAlignment="Center"
                                                        ToolTip="{Binding Pad_Mapping_Rate_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <TextBox Text="{Binding ParamRate, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}" Width="44" Margin="4,0,8,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="ParamRate" SettingLabel="{Binding Pad_Mapping_Rate, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MappingSourceItem_ParamRate_4305" Margin="4,0,8,0"/>
                                                <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Mapping_Sticky, Source={x:Static strings:Strings.Instance}}" IsChecked="{Binding ParamSticky, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                          ToolTip="{Binding Pad_Mapping_Sticky_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="ParamSticky" SettingLabel="{Binding Pad_Mapping_Sticky, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MappingSourceItem_ParamSticky_4308" Margin="4,0,8,0"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Mapping_Min, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                <TextBox Text="{Binding ParamMin, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}" Width="44" Margin="0,0,6,0" Padding="2,1" VerticalContentAlignment="Center"
                                                         ToolTip="{Binding Pad_Mapping_Min_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="ParamMin" SettingLabel="{Binding Pad_Mapping_Min, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MappingSourceItem_ParamMin_4311" Margin="4,0,8,0"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Mapping_Max, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                <TextBox Text="{Binding ParamMax, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}" Width="44" Margin="0,0,4,0" Padding="2,1" VerticalContentAlignment="Center"
                                                         ToolTip="{Binding Pad_Mapping_Max_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="ParamMax" SettingLabel="{Binding Pad_Mapping_Max, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MappingSourceItem_ParamMax_4314"/>
                                            </StackPanel>
                                            <!-- Rapid Trigger (#482): the distance that releases, or presses
