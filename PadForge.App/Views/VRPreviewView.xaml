<UserControl x:Class="PadForge.Views.VRPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:strings="clr-namespace:PadForge.Resources.Strings"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="900"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="VrHandTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <!-- Axis captions size to their CONTENT. A fixed width clipped
             "Left Trigger" in English and would have clipped harder in
             every other locale. -->
        <Style x:Key="VrAxisLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
    </UserControl.Resources>

    <!-- Centred, natural size. Uniform stretch would blow the panels up to
         fill the whole page on a maximised window. -->
    <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
             HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
        <Grid Width="860">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="LeftHandPanel" Grid.Row="0" Grid.Column="0" Padding="20"
                    CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource SegTrackStrokeBrush}"
                    Background="{DynamicResource CrucibleCardBrush}">
                <StackPanel>
                    <TextBlock Text="{Binding Vr_LeftHand, Source={x:Static strings:Strings.Instance}}"
                               Style="{StaticResource VrHandTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Canvas x:Name="LeftStickCanvas" Grid.Column="0"
                                Width="120" Height="120" Margin="0,0,20,0"/>
                        <StackPanel x:Name="LeftAxisPanel" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                    <WrapPanel x:Name="LeftButtonPanel" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>

            <Border x:Name="RightHandPanel" Grid.Row="0" Grid.Column="2" Padding="20"
                    CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource SegTrackStrokeBrush}"
                    Background="{DynamicResource CrucibleCardBrush}">
                <StackPanel>
                    <TextBlock Text="{Binding Vr_RightHand, Source={x:Static strings:Strings.Instance}}"
                               Style="{StaticResource VrHandTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Canvas x:Name="RightStickCanvas" Grid.Column="0"
                                Width="120" Height="120" Margin="0,0,20,0"/>
                        <StackPanel x:Name="RightAxisPanel" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                    <WrapPanel x:Name="RightButtonPanel" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                       Text="{Binding Vr_PreviewNote, Source={x:Static strings:Strings.Instance}}"
                       FontSize="11" TextWrapping="Wrap" Margin="2,16,2,0"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
        </Grid>
    </Viewbox>

</UserControl>
