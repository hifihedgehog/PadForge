                                                <Slider Value="{Binding ParamRapidTriggerDistance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="50" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1" Width="80" VerticalAlignment="Center"
                                                        ToolTip="{Binding Pad_Mapping_RapidTrigger_Distance_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <TextBox Text="{Binding ParamRapidTriggerDistance, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="44" Margin="4,0,0,0" Padding="2,1" VerticalContentAlignment="Center"
                                                         ToolTip="{Binding Pad_Mapping_RapidTrigger_Distance_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="ParamRapidTriggerDistance" SettingLabel="{Binding Pad_Mapping_RapidTrigger_Distance, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MappingSourceItem_ParamRapidTriggerDistance_4316" Margin="4,0,8,0"/>
                                            </StackPanel>
