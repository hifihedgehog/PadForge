                                            Visibility="{Binding IsAnyRumbleSetType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding RumbleEditorTitle}"
                                                       FontWeight="SemiBold" Margin="0,0,0,6"/>
