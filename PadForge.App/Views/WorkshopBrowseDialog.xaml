<ui:FluentWindow x:Class="PadForge.Views.WorkshopBrowseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        xmlns:views="clr-namespace:PadForge.Views"
        FontFamily="{StaticResource BodyFontFamily}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Title="{Binding Workshop_DialogTitle, Source={x:Static strings:Strings.Instance}}"
        Width="1280" Height="760" MinWidth="1080" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>

            <!-- Forge bar (design doc: the one loading treatment, no skeletons,
                 no per-card spinners). The ember segment sweeps the 170px track
                 while visible; with Windows animations off the segment holds
                 still at the left and the caption carries the state.
                 The sweep animates Canvas.Left, a single-step path on the
                 Rectangle itself, never a (RenderTransform).(X) complex path.
                 The IsVisible condition is already true while this template
                 instantiates inside a visible loading panel, so the trigger's
                 EnterActions run mid-instantiation, before an inline
                 RenderTransform member would have applied. Storyboard
                 verification then walks the path against the frozen
                 Transform.Identity default and every layout pass retries and
                 rethrows "Cannot animate '(0).(1)' on an immutable object
                 instance" (the 2026-07-13 crash storm, sibling of the v4.0.0
                 CardBorder launch crash). Single-step paths attach the clock
                 directly to the element and never enter
                 Storyboard.ProcessComplexPath. -->
            <ControlTemplate x:Key="ForgeBarTemplate" TargetType="ContentControl">
                <Border Width="170" Height="5" CornerRadius="3"
                        Background="{DynamicResource SteelRaisedBrush}" ClipToBounds="True">
                    <Canvas>
                        <Rectangle Canvas.Left="0" Width="68" Height="5" RadiusX="3" RadiusY="3">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FF6B2C" Offset="0"/>
                                    <GradientStop Color="#FF6B2C" Offset="0.5"/>
                                    <GradientStop Color="#00FF6B2C" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="ForgeSweep">
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="(Canvas.Left)"
                                                                         From="-68" To="170" Duration="0:0:1.4">
                                                            <DoubleAnimation.EasingFunction>
                                                                <SineEase EasingMode="EaseInOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="ForgeSweep"/>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                    </Canvas>
                </Border>
            </ControlTemplate>

            <!-- Pane eyebrow text: mono 10.5, dim. Tokens themselves are
                 hair-spaced literals (Devices facet-chip precedent). -->
            <Style x:Key="WsPaneHeaderText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}"/>
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Controller-type chip on a config card: mono token on an inset
                 tile. The Steam Deck chip flips cold via the item flag. -->
            <Style x:Key="WsTagChip" TargetType="Border">
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="Padding" Value="7,3"/>
                <Setter Property="Margin" Value="5,0,0,0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource SteelGroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SteelLineSoftBrush}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCold}" Value="True">
                        <Setter Property="BorderBrush" Value="#5958B6E4"/>
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource ColdBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Filter chip (Devices type-facet chip idiom): mono pill, ember
                 tint while active. -->
            <Style x:Key="WsFilterChip" TargetType="Border">
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="10,3"/>
                <Setter Property="Margin" Value="0,0,6,4"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="{DynamicResource SteelGroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SteelLineBrush}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                    </Trigger>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource EmberTintBrush}"/>
                        <Setter Property="BorderBrush" Value="#66FF6B2C"/>
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource EmberBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Preset chip (the shift-layer chips these become on import):
                 mono pill, ember tint while included. Standalone rather than
                 BasedOn the filter chip: the base style's IsActive trigger
                 would bind a property preset items don't carry (BINDERR bar). -->
            <Style x:Key="WsPresetChip" TargetType="Border">
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="10,3"/>
                <Setter Property="Margin" Value="0,0,7,0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="{DynamicResource SteelGroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SteelLineBrush}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                    </Trigger>
                    <DataTrigger Binding="{Binding IsIncluded}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource EmberTintBrush}"/>
                        <Setter Property="BorderBrush" Value="#66FF6B2C"/>
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource EmberBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Config rows: inert container (EmberSelectListItem precedent:
                 the stock template's accent slab and foreground flip are
                 template triggers, so the container is retemplated). Selection
                 is the mapping-row ember edge-light: 3px inset bar + a wash
                 that fades out by 60%. -->
            <Style x:Key="WsConfigRowContainer" TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="RowBd" BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource SteelLineSoftBrush}"
                                    Background="Transparent" Padding="14,12">
                                <Grid>
                                    <Rectangle x:Name="EdgeBar" Width="3" Fill="{DynamicResource EmberBrush}"
                                               HorizontalAlignment="Left" Margin="-14,-12" Visibility="Collapsed"/>
                                    <ContentPresenter/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RowBd" Property="Background" Value="#0CFF6B2C"/>
                                    <Setter TargetName="RowBd" Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="EdgeBar" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="RowBd" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#1AFF6B2C" Offset="0"/>
                                                <GradientStop Color="#00FF6B2C" Offset="0.6"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Shelf tiles: bare container; the ember selection ring lives on
                 the cover Border inside the item template (profile-card
                 precedent). -->
            <Style x:Key="WsShelfContainer" TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,12,12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Manifest telemetry rows: two shapes ride one ItemsControl, so
                 both templates are implicit-typed (BINDERR canon). -->
            <DataTemplate DataType="{x:Type views:WorkshopManifestGroupItem}">
                <DockPanel Margin="2,10,2,6" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Name}"
                               FontFamily="{StaticResource TelemetryFontFamily}" FontSize="10.5"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Rectangle Height="1" Fill="{DynamicResource SteelLineSoftBrush}" VerticalAlignment="Center"/>
                </DockPanel>
            </DataTemplate>
            <DataTemplate DataType="{x:Type views:WorkshopManifestRowItem}">
                <Grid Margin="8,0" Height="26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="7" Height="7" Fill="{Binding DotBrush}" Effect="{Binding DotGlow}"
                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <!-- Input badge: tint carries the input class and the
                         corner radius carries the shape (round for face
                         buttons and sticks, pill for everything else), so
                         the list is scannable without reading it. Collapses
                         for sources we cannot place on a controller. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" MinWidth="172" MaxWidth="240"
                                VerticalAlignment="Center">
                        <Border Visibility="{Binding GlyphVisibility}"
                                Background="{Binding GlyphTint}"
                                CornerRadius="{Binding GlyphCorner}"
                                MinWidth="26" Height="18" Padding="6,0" Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Glyph}"
                                       FontFamily="{StaticResource TelemetryFontFamily}"
                                       FontSize="10" FontWeight="SemiBold" Foreground="#FF14181D"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Source}"
                                   FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12"
                                   Foreground="{DynamicResource ColdBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="&#x2192;" Margin="10,0"
                               FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding Target}"
                               FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="4" Text="{Binding Reason}" MaxWidth="270" Margin="10,0,0,0"
                               FontSize="11" FontStyle="Italic"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}"
                               Visibility="{Binding Reason, Converter={StaticResource StringToVisibility}}"/>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Dialog head (#175 item 11 canon) with the engine-flame liveness
             dot: lit once the opt-in gate is on. -->
        <Border Padding="14"
                BorderBrush="{DynamicResource SteelLineSoftBrush}"
                BorderThickness="0,0,0,1" Panel.ZIndex="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Path x:Name="TitleFlame" Data="{StaticResource FlameOuterGeometry}"
                      Width="11" Height="13" Stretch="Uniform"
                      Fill="Transparent" Stroke="{DynamicResource TextFillColorTertiaryBrush}"
                      StrokeThickness="1.1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontFamily="{StaticResource DisplayFontFamily}"
                           FontWeight="SemiBold" FontSize="15"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding Workshop_DialogPath, Source={x:Static strings:Strings.Instance}}"
                           FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"/>
                <ui:Button Grid.Column="4" Style="{StaticResource EmberIconButton}"
                           VerticalAlignment="Center" Click="Dismiss_Click"
                           ToolTip="{Binding Common_Close, Source={x:Static strings:Strings.Instance}}">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </ui:Button>
            </Grid>
        </Border>

        <!-- Content ground. Painted so the art scrim has a color to fade
             into; states swap over it. -->
        <Grid Grid.Row="1" Background="{DynamicResource ApplicationBackgroundBrush}">

            <!-- Hero art layer (game-selected state): the game's library_hero
                 under the steel scrim. Filter treatment (saturate .82,
                 brightness .8) is baked into the bitmap in code; the two
                 scrim rectangles get their gradients built in code from the
                 live theme ground color. -->
            <Grid x:Name="ArtLayer" Height="340" VerticalAlignment="Top" ClipToBounds="True" Visibility="Collapsed">
                <Image x:Name="HeroImage" Stretch="UniformToFill" VerticalAlignment="Top" Margin="0,-18,0,0">
                    <Image.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#EB000000" Offset="0"/>
                            <GradientStop Color="#8C000000" Offset="0.55"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Image.OpacityMask>
                </Image>
                <Rectangle x:Name="ScrimVertical"/>
                <Rectangle x:Name="ScrimHorizontal"/>
            </Grid>

            <!-- ── State: cold forge (opt-in) ─────────────────────────── -->
            <StackPanel x:Name="ColdPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <Border Width="44" Height="44" CornerRadius="22" HorizontalAlignment="Center"
                        BorderThickness="1" BorderBrush="{DynamicResource SteelLineBrush}">
                    <Border.Background>
                        <RadialGradientBrush GradientOrigin="0.35,0.3">
                            <GradientStop Color="#3A4557" Offset="0"/>
                            <GradientStop Color="#1A212C" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                    <!-- The unlit flame: LivenessFlameBase idiom at cold-state size. -->
                    <Path Data="{StaticResource FlameOuterGeometry}" Width="18" Height="21" Stretch="Uniform"
                          Fill="Transparent" Stroke="{DynamicResource TextFillColorTertiaryBrush}"
                          StrokeThickness="1.1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding Workshop_ColdTitle, Source={x:Static strings:Strings.Instance}}"
                           FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="{Binding Workshop_ColdBody, Source={x:Static strings:Strings.Instance}}"
                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <!-- The endpoint list IS the privacy statement (design P4):
                     shown in plain telemetry, not linked away. Locale-neutral
                     host literals. -->
                <TextBlock FontFamily="{StaticResource TelemetryFontFamily}" FontSize="10"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           LineHeight="17" HorizontalAlignment="Center" TextAlignment="Left" Margin="0,10,0,0"
                           Text="store.steampowered.com&#10;api.steampowered.com&#10;steamcommunity.com&#10;cdn.steamusercontent.com&#10;cdn.cloudflare.steamstatic.com"/>
                <ui:Button Style="{StaticResource EmberPrimaryButton}" MinWidth="90"
                           HorizontalAlignment="Center" Margin="0,14,0,0" Click="EnableCommunityConfigs_Click"
                           Content="{Binding Workshop_EnableButton, Source={x:Static strings:Strings.Instance}}"/>
            </StackPanel>

            <!-- ── State: game search (quiet steel room) ──────────────── -->
            <Grid x:Name="SearchPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Margin="16,16,16,0" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource SteelLineBrush}"
                        Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                     FontSize="13.5" Padding="0" VerticalAlignment="Center"
                                     CaretBrush="{DynamicResource EmberBrush}"
                                     TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
                            <TextBlock x:Name="SearchPlaceholder" IsHitTestVisible="False"
                                       Text="{Binding Workshop_SearchPlaceholder, Source={x:Static strings:Strings.Instance}}"
                                       FontSize="13.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="GamesCountText" Grid.Column="2"
                                   FontFamily="{StaticResource TelemetryFontFamily}" FontSize="10.5"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Portrait shelf; the wrap grid is the shelf collapsing at
                     narrow widths (design open question 1). -->
                <ScrollViewer Grid.Row="1" Margin="8,8,8,8"
                              VerticalScrollBarVisibility="Visible"
                              HorizontalScrollBarVisibility="Disabled">
                    <ListBox x:Name="ShelfList" Background="Transparent" BorderThickness="0"
                             Margin="8"
                             ItemContainerStyle="{StaticResource WsShelfContainer}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             KeyDown="ShelfList_KeyDown"
                             PreviewMouseLeftButtonUp="ShelfList_MouseLeftButtonUp">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="118">
                                    <Grid Height="177">
                                        <!-- Steel tile + initial: the no-art floor of the
                                             fallback chain. Sits under the cover image. -->
                                        <Border CornerRadius="8" BorderThickness="1"
                                                BorderBrush="{DynamicResource SteelLineSoftBrush}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                                                    <GradientStop Color="#1C2430" Offset="0"/>
                                                    <GradientStop Color="#12161E" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="{Binding Initial}"
                                                       FontFamily="{StaticResource TelemetryFontFamily}" FontSize="22"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <!-- Cover. UniformToFill for real portraits;
                                             letterboxed Uniform when header art stands in. -->
                                        <Border CornerRadius="8" ClipToBounds="True"
                                                Visibility="{Binding Portrait, Converter={StaticResource NullToCollapsedConverter}}">
                                            <Image Source="{Binding Portrait}">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Stretch" Value="UniformToFill"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLetterbox}" Value="True">
                                                                <Setter Property="Stretch" Value="Uniform"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Border>
                                        <!-- Selection ring: ember rim + lifted glow
                                             (profile-card aura idiom, static). -->
                                        <Border CornerRadius="8" BorderThickness="1" IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource EmberBrush}"/>
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="#FF6B2C" BlurRadius="24" ShadowDepth="0" Opacity="0.4"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="11.5" Margin="0,7,0,0"
                                               TextWrapping="Wrap" MaxHeight="30" LineHeight="15"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding CountText}"
                                               FontFamily="{StaticResource TelemetryFontFamily}" FontSize="10"
                                               Foreground="{DynamicResource ColdBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <!-- Search-state overlays -->
                <StackPanel x:Name="SearchLoadingPanel" Grid.Row="1" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ContentControl Template="{StaticResource ForgeBarTemplate}" Focusable="False"/>
                    <TextBlock Text="{Binding Workshop_SearchingSteam, Source={x:Static strings:Strings.Instance}}"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
                <TextBlock x:Name="SearchHintText" Grid.Row="1" Visibility="Collapsed"
                           FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel x:Name="SearchErrorPanel" Grid.Row="1" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Workshop_ErrorTitle, Source={x:Static strings:Strings.Instance}}"
                               FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Workshop_ErrorBody, Source={x:Static strings:Strings.Instance}}"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="340" Margin="0,8,0,0"/>
                    <Button Content="{Binding Workshop_Retry, Source={x:Static strings:Strings.Instance}}"
                            HorizontalAlignment="Center" Margin="0,12,0,0" MinWidth="90"
                            Click="SearchRetry_Click"/>
                </StackPanel>
            </Grid>

            <!-- ── State: game selected (band + panes over the art) ───── -->
            <Grid x:Name="BrowsePanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Game band -->
                <Grid Margin="22,26,22,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="120" Height="180" CornerRadius="8" ClipToBounds="True"
                            BorderThickness="1" BorderBrush="{DynamicResource SteelLineBrush}"
                            VerticalAlignment="Bottom">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="10" BlurRadius="34" Opacity="0.6"/>
                        </Border.Effect>
                        <Grid>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                                        <GradientStop Color="#1C2430" Offset="0"/>
                                        <GradientStop Color="#12161E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock x:Name="CapsuleInitial"
                                           FontFamily="{StaticResource TelemetryFontFamily}" FontSize="26"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Image x:Name="CapsuleImage" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Bottom">
                        <Border HorizontalAlignment="Left" CornerRadius="10" Padding="12,4"
                                Background="#8C0A0D12" BorderThickness="1"
                                BorderBrush="{DynamicResource SteelLineSoftBrush}"
                                Cursor="Hand" MouseLeftButtonUp="BackToSearch_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x2190;" FontFamily="{StaticResource TelemetryFontFamily}"
                                           FontSize="11" Foreground="#94A3BD" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Workshop_BackToSearch, Source={x:Static strings:Strings.Instance}}"
                                           FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11"
                                           Foreground="#94A3BD"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="GameNameText" FontFamily="{StaticResource DisplayFontFamily}"
                                   FontSize="26" FontWeight="Bold" Margin="0,8,0,0"
                                   Foreground="#E9EDF4" TextTrimming="CharacterEllipsis">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" BlurRadius="18" Opacity="0.8"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <!-- appid + config count read as data (telemetry cyan
                             runs built in code). -->
                        <TextBlock x:Name="GameMetaText" FontFamily="{StaticResource TelemetryFontFamily}"
                                   FontSize="11.5" Foreground="#94A3BD" Margin="0,4,0,0">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" BlurRadius="8" Opacity="0.9"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- Panes -->
                <Grid Grid.Row="1" Margin="16,8,16,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Config list pane -->
                    <Grid>
                        <Rectangle RadiusX="10" RadiusY="10" Opacity="0.94"
                                   Fill="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                        <Border CornerRadius="10" BorderThickness="1"
                                BorderBrush="{DynamicResource SteelLineSoftBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SteelLineSoftBrush}"
                                        Padding="14,11">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="C&#8202;O&#8202;N&#8202;F&#8202;I&#8202;G&#8202;S"
                                                   Style="{StaticResource WsPaneHeaderText}"
                                                   Foreground="{DynamicResource EmberBrush}" FontWeight="Bold"/>
                                        <TextBlock Style="{StaticResource WsPaneHeaderText}" Margin="8,0,0,0"
                                                   Text="{Binding Workshop_SortedByRating, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBlock x:Name="ConfigsFoundText" Style="{StaticResource WsPaneHeaderText}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- Filter chips from live result tags -->
                                <Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SteelLineSoftBrush}"
                                        Padding="12,10,12,6">
                                    <ItemsControl x:Name="TagChipList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource WsFilterChip}" MouseLeftButtonUp="TagChip_Click">
                                                    <TextBlock Text="{Binding Label}"
                                                               FontFamily="{StaticResource TelemetryFontFamily}"
                                                               FontSize="10.5" FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <ListBox x:Name="ConfigList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                                         ItemContainerStyle="{StaticResource WsConfigRowContainer}"
                                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.ScrollChanged="ConfigList_ScrollChanged"
                                         SelectionChanged="ConfigList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Creator avatar tile; initials in telemetry
                                                     cyan until the persona answers. -->
                                                <Border Width="34" Height="34" CornerRadius="7" ClipToBounds="True"
                                                        BorderThickness="1" BorderBrush="{DynamicResource SteelLineBrush}"
                                                        VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <Grid>
                                                        <Border>
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#2A3342" Offset="0"/>
                                                                    <GradientStop Color="#171D27" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                            <TextBlock Text="{Binding AvatarInitials}"
                                                                       FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12"
                                                                       Foreground="{DynamicResource ColdBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Image Source="{Binding Avatar}" Stretch="UniformToFill"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                                    <TextBlock Text="{Binding ByLine}" FontSize="11.5"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                        <Border Width="64" Height="4" CornerRadius="2"
                                                                Background="{DynamicResource SteelRaisedBrush}"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding HasVotes, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <Rectangle RadiusX="2" RadiusY="2" HorizontalAlignment="Left"
                                                                       Width="{Binding VoteBarWidth}">
                                                                <Rectangle.Fill>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                        <GradientStop Color="#C43D0C" Offset="0"/>
                                                                        <GradientStop Color="#FF6B2C" Offset="1"/>
                                                                    </LinearGradientBrush>
                                                                </Rectangle.Fill>
                                                            </Rectangle>
                                                        </Border>
                                                        <TextBlock Text="{Binding VotePercentText}" Margin="8,0,0,0"
                                                                   FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding HasVotes, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <TextBlock Text="{Binding SubsText}" Margin="12,0,0,0"
                                                                   FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ItemsControl ItemsSource="{Binding Tags}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{StaticResource WsTagChip}">
                                                                    <TextBlock Text="{Binding Label}"
                                                                               FontFamily="{StaticResource TelemetryFontFamily}"
                                                                               FontSize="9.5"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Border Margin="5,0,0,0" CornerRadius="5" Padding="7,3" BorderThickness="1"
                                                            Background="#1AE3B341" BorderBrush="#66E3B341"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsLegacy, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="LEGACY" Foreground="#E3B341"
                                                                   FontFamily="{StaticResource TelemetryFontFamily}" FontSize="9.5"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <!-- Config-list overlays -->
                                <StackPanel x:Name="ConfigsLoadingPanel" Grid.Row="2" Visibility="Collapsed"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentControl Template="{StaticResource ForgeBarTemplate}" Focusable="False"/>
                                    <TextBlock Text="{Binding Workshop_ReadingConfigs, Source={x:Static strings:Strings.Instance}}"
                                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                </StackPanel>
                                <StackPanel x:Name="ConfigsEmptyPanel" Grid.Row="2" Visibility="Collapsed"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                                    <TextBlock Text="{Binding Workshop_EmptyTitle, Source={x:Static strings:Strings.Instance}}"
                                               FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ConfigsEmptyBody" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280" Margin="0,8,0,0"/>
                                </StackPanel>
                                <StackPanel x:Name="ConfigsErrorPanel" Grid.Row="2" Visibility="Collapsed"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                                    <TextBlock Text="{Binding Workshop_ErrorTitle, Source={x:Static strings:Strings.Instance}}"
                                               FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ConfigsErrorBody" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280" Margin="0,8,0,0"/>
                                    <Button Content="{Binding Workshop_Retry, Source={x:Static strings:Strings.Instance}}"
                                            HorizontalAlignment="Center" Margin="0,12,0,0" MinWidth="90"
                                            Click="ConfigsRetry_Click"/>
                                </StackPanel>
                                <!-- Load-more strip: the forge bar at the foot of the
                                     list while the next page streams in (infinite
                                     scroll; the loaded rows never blank). -->
                                <Border x:Name="ConfigsMorePanel" Grid.Row="2" Visibility="Collapsed"
                                        VerticalAlignment="Bottom" IsHitTestVisible="False"
                                        CornerRadius="0,0,10,10" Padding="0,9"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SteelLineSoftBrush}">
                                    <ContentControl Template="{StaticResource ForgeBarTemplate}"
                                                    Focusable="False" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Translation manifest pane (the dossier) -->
                    <Grid Grid.Column="2">
                        <Rectangle RadiusX="10" RadiusY="10" Opacity="0.94"
                                   Fill="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                        <Border CornerRadius="10" BorderThickness="1"
                                BorderBrush="{DynamicResource SteelLineSoftBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SteelLineSoftBrush}"
                                        Padding="14,11">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="T&#8202;R&#8202;A&#8202;N&#8202;S&#8202;L&#8202;A&#8202;T&#8202;I&#8202;O&#8202;N&#8201;&#8201;M&#8202;A&#8202;N&#8202;I&#8202;F&#8202;E&#8202;S&#8202;T"
                                                   Style="{StaticResource WsPaneHeaderText}"
                                                   Foreground="{DynamicResource EmberBrush}" FontWeight="Bold"/>
                                        <TextBlock x:Name="ManifestHeaderRight" DockPanel.Dock="Right"
                                                   Style="{StaticResource WsPaneHeaderText}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Border>

                                <!-- Result: stat blocks + grouped telemetry rows -->
                                <Grid x:Name="ManifestResultPanel" Grid.Row="1" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Margin="14,14,14,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Stat blocks: dashboard slot-summary treatment,
                                             semantic top edge like mini-card heat. -->
                                        <Border CornerRadius="7" BorderThickness="1"
                                                Background="{DynamicResource SteelGroundBrush}"
                                                BorderBrush="{DynamicResource SteelLineSoftBrush}">
                                            <Grid>
                                                <Rectangle Height="2" VerticalAlignment="Top" Fill="#57C784" RadiusX="1" RadiusY="1" Margin="1,1,1,0"/>
                                                <StackPanel Margin="14,12">
                                                    <TextBlock x:Name="StatCleanNum" Text="0" Foreground="#57C784"
                                                               FontFamily="{StaticResource TelemetryFontFamily}" FontSize="24" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Workshop_StatClean, Source={x:Static strings:Strings.Instance}}"
                                                               FontFamily="{StaticResource TelemetryFontFamily}" FontSize="10"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="2" CornerRadius="7" BorderThickness="1"
                                                Background="{DynamicResource SteelGroundBrush}"
                                                BorderBrush="{DynamicResource SteelLineSoftBrush}">
                                            <Grid>
                                                <Rectangle Height="2" VerticalAlignment="Top" Fill="#E3B341" RadiusX="1" RadiusY="1" Margin="1,1,1,0"/>
                                                <StackPanel Margin="14,12">
                                                    <TextBlock x:Name="StatPartialNum" Text="0" Foreground="#E3B341"
                                                               FontFamily="{StaticResource TelemetryFontFamily}" FontSize="24" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Workshop_StatPartial, Source={x:Static strings:Strings.Instance}}"
                                                               FontFamily="{StaticResource TelemetryFontFamily}" FontSize="10"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="4" CornerRadius="7" BorderThickness="1"
                                                Background="{DynamicResource SteelGroundBrush}"
                                                BorderBrush="{DynamicResource SteelLineSoftBrush}">
                                            <Grid>
                                                <Rectangle Height="2" VerticalAlignment="Top" Fill="#8B95A3" RadiusX="1" RadiusY="1" Margin="1,1,1,0"/>
                                                <StackPanel Margin="14,12">
                                                    <TextBlock x:Name="StatSkippedNum" Text="0" Foreground="#8B95A3"
                                                               FontFamily="{StaticResource TelemetryFontFamily}" FontSize="24" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Workshop_StatSkipped, Source={x:Static strings:Strings.Instance}}"
                                                               FontFamily="{StaticResource TelemetryFontFamily}" FontSize="10"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <ScrollViewer Grid.Row="1" Margin="14,0,14,6"
                                                  VerticalScrollBarVisibility="Visible"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="ManifestRowsList"/>
                                    </ScrollViewer>
                                </Grid>

                                <!-- Idle / loading / legacy / error fills of the dossier -->
                                <TextBlock x:Name="ManifestIdlePanel" Grid.Row="1"
                                           Text="{Binding Workshop_ManifestIdle, Source={x:Static strings:Strings.Instance}}"
                                           FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <StackPanel x:Name="ManifestLoadingPanel" Grid.Row="1" Visibility="Collapsed"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentControl Template="{StaticResource ForgeBarTemplate}" Focusable="False"/>
                                    <TextBlock Text="{Binding Workshop_ReadingConfig, Source={x:Static strings:Strings.Instance}}"
                                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                </StackPanel>
                                <StackPanel x:Name="ManifestLegacyPanel" Grid.Row="1" Visibility="Collapsed"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                                    <Border CornerRadius="5" Padding="10,5" BorderThickness="1"
                                            Background="#1AE3B341" BorderBrush="#66E3B341" HorizontalAlignment="Center">
                                        <TextBlock Text="LEGACY" Foreground="#E3B341"
                                                   FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11"/>
                                    </Border>
                                    <TextBlock Text="{Binding Workshop_LegacyBody, Source={x:Static strings:Strings.Instance}}"
                                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" Margin="0,10,0,0"/>
                                    <Button Content="{Binding Workshop_LegacyOpenButton, Source={x:Static strings:Strings.Instance}}"
                                            HorizontalAlignment="Center" Margin="0,12,0,0" MinWidth="90"
                                            Click="OpenInSteam_Click"/>
                                </StackPanel>
                                <StackPanel x:Name="ManifestErrorPanel" Grid.Row="1" Visibility="Collapsed"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                                    <TextBlock Text="{Binding Workshop_ErrorTitle, Source={x:Static strings:Strings.Instance}}"
                                               FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ManifestErrorBody" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" Margin="0,8,0,0"/>
                                    <Button Content="{Binding Workshop_Retry, Source={x:Static strings:Strings.Instance}}"
                                            HorizontalAlignment="Center" Margin="0,12,0,0" MinWidth="90"
                                            Click="ManifestRetry_Click"/>
                                </StackPanel>

                                <!-- Dossier footer: preset chips (the shift layers
                                     these become) + the verb band. -->
                                <Border x:Name="ManifestFooter" Grid.Row="2" Visibility="Collapsed"
                                        BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SteelLineSoftBrush}"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        CornerRadius="0,0,10,10" Padding="14,13">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ItemsControl x:Name="PresetChipList" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource WsPresetChip}" MouseLeftButtonUp="PresetChip_Click">
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontFamily="{StaticResource TelemetryFontFamily}"
                                                                   FontSize="10.5" FontWeight="SemiBold"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button MinWidth="90" Margin="0,0,8,0"
                                                    Content="{Binding Common_Cancel, Source={x:Static strings:Strings.Instance}}"
                                                    Click="Dismiss_Click"/>
                                            <Button MinWidth="90" Margin="0,0,8,0"
                                                    Content="{Binding Workshop_SaveProfile, Source={x:Static strings:Strings.Instance}}"
                                                    Click="SaveProfile_Click"/>
                                            <ui:Button MinWidth="90"
                                                       Style="{StaticResource EmberPrimaryButton}"
                                                       Content="{Binding Workshop_SaveAndApply, Source={x:Static strings:Strings.Instance}}"
                                                       Click="SaveAndApply_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
