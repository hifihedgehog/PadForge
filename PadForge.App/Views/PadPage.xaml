                                        </StackPanel>
                                        <!-- Output controller axis -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                                    Visibility="{Binding IsOutputAxisSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_SourceAxis, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"/>
                                            <ComboBox SelectedValue="{Binding AxisTarget, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" MinWidth="150">
                                                <ComboBoxItem Content="{Binding Macro_LeftStickX, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftStickX}"/>
                                                <ComboBoxItem Content="{Binding Macro_LeftStickY, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftStickY}"/>
                                                <ComboBoxItem Content="{Binding Macro_RightStickX, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightStickX}"/>
                                                <ComboBoxItem Content="{Binding Macro_RightStickY, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightStickY}"/>
                                                <ComboBoxItem Content="{Binding Macro_LeftTrigger, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftTrigger}"/>
                                                <ComboBoxItem Content="{Binding Macro_RightTrigger, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightTrigger}"/>
                                            </ComboBox>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="AxisTarget" SettingLabel="{Binding Macro_SourceAxis, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_AxisTarget_3157"/>
                                        </StackPanel>
                                        <!-- Input device axis -->
                                        <StackPanel Visibility="{Binding IsDeviceAxisSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Device, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                           Width="80" Margin="0,0,8,0"/>
                                                <ComboBox x:Name="MouseDevicePicker"
                                                          MinWidth="200"
                                                          DisplayMemberPath="ResolvedName"
                                                          SelectedValuePath="InstanceGuid"
                                                          SelectedValue="{Binding SourceDeviceGuid, Mode=TwoWay}"
                                                          DropDownOpened="DeviceAxisPicker_DropDownOpened"
                                                          Loaded="DeviceAxisPicker_DropDownOpened"/>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="SourceDeviceGuid" Visibility="{Binding Visibility, ElementName=MouseDevicePicker}" SettingLabel="{Binding Macro_Device, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_SourceDeviceGuid_3177"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Axis, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                           Width="80" Margin="0,0,8,0"/>
                                                <ComboBox MinWidth="180"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectedValuePath="InputIndex"
                                                          SelectedValue="{Binding SourceDeviceAxisIndex, Mode=TwoWay}"
                                                          DropDownOpened="DeviceAxisIndexPicker_DropDownOpened"
                                                          Loaded="DeviceAxisIndexPicker_DropDownOpened"/>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="SourceDeviceAxisIndex" SettingLabel="{Binding Macro_Axis, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_SourceDeviceAxisIndex_3187" Margin="4,0,8,0"/>
                                                <ui:Button Command="{Binding RecordSourceCommand}"
                                                           Style="{StaticResource EmberIconButtonHot}"
                                                           VerticalAlignment="Center" Margin="4,0,0,0">
                                                    <controls:GlyphText Text="{Binding SourceRecordIcon}" FontFamily="Segoe MDL2 Assets"
                                                               Foreground="{DynamicResource EmberBrush}"/>
                                                    <ui:Button.ToolTip>
                                                        <TextBlock Text="{Binding SourceRecordTooltip}"/>
                                                    </ui:Button.ToolTip>
                                                </ui:Button>
                                                <ui:Button AutomationProperties.Name="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}" Command="{Binding ClearSourceCommand}"
                                                           Style="{StaticResource EmberIconButtonHot}"
                                                           VerticalAlignment="Center">
                                                    <controls:GlyphText Text="&#xE75C;" FontFamily="Segoe MDL2 Assets"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <ui:Button.ToolTip>
                                                        <TextBlock Text="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}"/>
                                                    </ui:Button.ToolTip>
                                                </ui:Button>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Sensitivity, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"/>
                                            <Slider Value="{Binding MouseSensitivity, Mode=TwoWay}"
                                                    Minimum="1" Maximum="100" Width="180"
                                                    TickPlacement="None" IsSnapToTickEnabled="False"
                                                    VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding MouseSensitivity, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                     Width="50" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="MouseSensitivity" SettingLabel="{Binding Macro_Sensitivity, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_MouseSensitivity_3214"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <CheckBox VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Macro_InvertAxis, Source={x:Static strings:Strings.Instance}}"
                                                     IsChecked="{Binding InvertAxis, Mode=TwoWay}"/>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="InvertAxis" SettingLabel="{Binding Macro_InvertAxis, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_InvertAxis_3219"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Macro_MouseMoveHint, Source={x:Static strings:Strings.Instance}}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Mouse button picker for MouseButtonPress / MouseButtonRelease
                                         plus the v19 M1 ToggleMouseButton latch -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsAnyMouseButtonType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Buttons, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"/>
                                            <ComboBox SelectedValue="{Binding MouseButton, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" MinWidth="120">
                                                <ComboBoxItem Content="{Binding Macro_MouseLeft, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroMouseButton.Left}"/>
                                                <ComboBoxItem Content="{Binding Macro_MouseRight, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroMouseButton.Right}"/>
                                                <ComboBoxItem Content="{Binding Macro_MouseMiddle, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroMouseButton.Middle}"/>
                                                <ComboBoxItem Content="{Binding Macro_MouseX1, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroMouseButton.X1}"/>
                                                <ComboBoxItem Content="{Binding Macro_MouseX2, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroMouseButton.X2}"/>
                                            </ComboBox>
                                            <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="MouseButton" SettingLabel="{Binding Macro_Buttons, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_MouseButton_3233"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Repeat settings. Hidden for Turbo and Toggle (#238):
                                 those modes force until-release repeats in the engine,
                                 so Mode and Count would be dead controls there. Their
                                 one live knob (the interval) rides the inline row
                                 beside the Fire picker instead. -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                        Visibility="{Binding ShowsRepeatSection, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border Width="3" CornerRadius="1.5" Margin="0,2,7,2"
                                        Background="{DynamicResource EmberBrush}"/>
                                <TextBlock Text="{Binding Macro_Repeat, Source={x:Static strings:Strings.Instance}}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                        Visibility="{Binding ShowsRepeatSection, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_RepeatMode, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                           Width="80" Margin="0,0,8,0"/>
                                <ComboBox SelectedValue="{Binding RepeatMode, Mode=TwoWay}"
                                          SelectedValuePath="Tag" MinWidth="120">
                                    <ComboBoxItem Content="{Binding Macro_Once, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroRepeatMode.Once}"/>
                                    <ComboBoxItem Content="{Binding Macro_FixedCount, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroRepeatMode.FixedCount}"/>
                                    <ComboBoxItem Content="{Binding Macro_UntilRelease, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroRepeatMode.UntilRelease}" IsEnabled="{Binding SupportsUntilReleaseRepeat}"/>
                                    <ComboBoxItem Content="{Binding Macro_UntilNextPress, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroRepeatMode.UntilNextPress}"/>
                                </ComboBox>
                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="RepeatMode" SettingLabel="{Binding Macro_RepeatMode, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroItem_RepeatMode_3262"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                        Visibility="{Binding ShowsRepeatSection, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Count, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                           Margin="0,0,8,0" Width="80"/>
                                <TextBox Text="{Binding RepeatCount, Mode=TwoWay}"
                                         Width="60"/>
                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="RepeatCount" SettingLabel="{Binding Macro_Count, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroItem_RepeatCount_3273" Margin="4,0,8,0"/>
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_DelayMs, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                           Margin="12,0,8,0"/>
                                <TextBox Text="{Binding RepeatDelayMs, Mode=TwoWay}"
                                         Width="60"/>
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- === TAB 15: Menus (slot-level, #9 B-17 radial / touch menus) === -->
            <TabItem>
                <Grid Margin="8">
                    <Grid.Resources>
                        <!-- Every tooltip on this tab is a sentence-or-three
                             string. Without a cap + wrap they render as one
                             screen-wide line. Scoped here because a GLOBAL
                             wrap template would stringify element-content
                             tooltips elsewhere. BasedOn keeps the app's
                             tooltip typography (theme-strip canon). -->
                        <Style TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
                            <Setter Property="MaxWidth" Value="440"/>
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="400"/>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <!-- One keyboard control row (#566), the Click Input row's
                             shape: the slot's inputs grouped by device, the device
                             under the list, then record and reset. The label column
                             is shared with the card's steering rows. -->
                        <!-- A keyboard row's press point (#566): where an analog input
                             presses, the Axis-to-Button Deadzone a Mappings row with a
                             button target has, shown only where it acts. -->
                        <DataTemplate x:Key="KeyboardThresholdTemplate" DataType="{x:Type vm:KeyboardInputRow}">
                            <StackPanel Orientation="Horizontal" Margin="4,4,0,0"
                                        Visibility="{Binding ShowsThreshold, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding Pad_HeaderDeadZone, Source={x:Static strings:Strings.Instance}}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Slider AutomationProperties.Name="{Binding ThresholdName, TargetNullValue=''}"
                                        AutomationProperties.AutomationId="{Binding ThresholdAutomationId}"
                                        Style="{StaticResource DzSlider}" Width="120" Minimum="1" Maximum="99" TickFrequency="1"
                                        Value="{Binding ThresholdPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox AutomationProperties.Name="{Binding ThresholdName, TargetNullValue=''}"
                                         Text="{Binding ThresholdPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource DzValueEdit}"/>
                                <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                <ui:Button Command="{Binding ResetThresholdCommand}" Style="{StaticResource ResetButton}"
                                           ToolTip="{Binding Pad_Reset_AxisToButtonDeadZone, Source={x:Static strings:Strings.Instance}}"
                                           AutomationProperties.Name="{Binding Pad_Reset_AxisToButtonDeadZone, Source={x:Static strings:Strings.Instance}}"/>
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate x:Key="KeyboardControlRowTemplate" DataType="{x:Type vm:KeyboardInputRow}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuKeyboardLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Label}"
                                           Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="240"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <StackPanel Orientation="Vertical">
                                        <ComboBox MinWidth="260" ItemsSource="{Binding ChoicesView}"
                                                  AutomationProperties.AutomationId="{Binding AutomationId}"
                                                  AutomationProperties.Name="{Binding Label, TargetNullValue=''}"
                                                  DisplayMemberPath="DisplayName" SelectedValuePath="Key"
                                                  SelectedValue="{Binding SelectedKey, Mode=TwoWay}">
                                            <ComboBox.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,3,6,3">
                                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ComboBox.GroupStyle>
                                        </ComboBox>
                                        <TextBlock FontSize="10" Margin="4,1,0,0" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Subtitle}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource EmberBrush}"/>
                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource KeyboardThresholdTemplate}"
                                                        Focusable="False" IsTabStop="False"/>
                                    </StackPanel>
                                    <!-- The template builds this row while the tab shows,
                                         inside the tab control's presenter, where the page
                                         is an ancestor and the TabItem is not. -->
                                    <ui:Button AutomationProperties.Name="{Binding RecordText, TargetNullValue=''}"
                                               Command="{Binding DataContext.MenuKeyboardRecordCommand,
                                                   RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               Style="{StaticResource EmberIconButtonHot}" Margin="6,0,0,0" VerticalAlignment="Top">
                                        <controls:GlyphText Text="{Binding RecordIcon}" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource EmberBrush}"/>
                                    </ui:Button>
                                    <ui:Button Command="{Binding ResetInputCommand}" Style="{StaticResource ResetButton}" VerticalAlignment="Top"
                                               ToolTip="{Binding ResetTip}" AutomationProperties.Name="{Binding ResetTip, TargetNullValue=''}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Menu list -->
                    <DockPanel Grid.Column="0">
                        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button AutomationProperties.AutomationId="MenuAddButton" Content="{Binding Common_Add, Source={x:Static strings:Strings.Instance}}" Command="{Binding AddMenuCommand}"
                                    Padding="8,4" Margin="0,0,4,4"/>
                            <Button AutomationProperties.AutomationId="MenuRemoveButton" Content="{Binding Common_Remove, Source={x:Static strings:Strings.Instance}}" Command="{Binding RemoveMenuCommand}"
                                    Padding="8,4" Margin="0,0,4,4"/>
                            <Button Content="{Binding Common_Duplicate, Source={x:Static strings:Strings.Instance}}" Command="{Binding DuplicateMenuCommand}"
                                    Padding="8,4" Margin="0,0,0,4"/>
                        </WrapPanel>

                        <ListBox AutomationProperties.Name="{Binding Pad_Menus, Source={x:Static strings:Strings.Instance}}" ItemsSource="{Binding Menus}"
                                 SelectedItem="{Binding SelectedMenu, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource EmberSelectListItem}"
                                 DisplayMemberPath="Name"/>
                    </DockPanel>

                    <GridSplitter AutomationProperties.Name="{Binding Common_ResizePanes, Source={x:Static strings:Strings.Instance}}" Grid.Column="1" Width="4" Margin="4,0"
                                  HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                  ResizeBehavior="PreviousAndNext"/>

                    <!-- Empty state: cold guidance, same shape as Macros. -->
                    <Grid Grid.Column="2">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedMenu}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path FlowDirection="LeftToRight" Data="{StaticResource FlameOuterGeometry}" Width="34" Height="34" Stretch="Uniform"
                                  Fill="Transparent" StrokeThickness="1.2"
                                  Stroke="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Menu_EmptyHint, Source={x:Static strings:Strings.Instance}}"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300"/>
                        </StackPanel>
                    </Grid>

                    <!-- Menu editor -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="8"
                                  DataContext="{Binding SelectedMenu}"
                                  Visibility="{Binding DataContext.HasSelectedMenu,
                                      RelativeSource={RelativeSource AncestorType=TabItem},
                                      Converter={StaticResource BoolToVisibilityConverter}}">
                        <!-- Every label row shares one auto-sized column (SharedSizeGroup,
                             same device as the pipeline-tip and compact-row grids above).
                             The labels were pinned at Width="200", which fits the English
                             strings and clips or collides with the longer ones: de/pt-BR
                             run ~35% longer than en, and "Touch Menu Activation Style"
                             class strings are already near the limit in English. Auto +
                             SharedSizeGroup sizes the column to the widest label in
                             WHATEVER locale is loaded and keeps every row aligned, with no
                             per-locale numbers to maintain. Fields use MinWidth so they
                             hold the old rhythm but can still grow to their content. -->
                        <StackPanel Grid.IsSharedSizeScope="True">
                            <!-- Name + Enabled -->
                            <TextBlock Text="{Binding Menu_Name, Source={x:Static strings:Strings.Instance}}" FontWeight="SemiBold" Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <!-- Fixed width: a Min/Max auto-sized TextBox in a
                                     left-aligned StackPanel resizes while you type. -->
                                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Width="260" HorizontalAlignment="Left"/>
                                <CheckBox Content="{Binding Menu_Enabled, Source={x:Static strings:Strings.Instance}}"
                                          IsChecked="{Binding Enabled}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="Enabled" SettingLabel="{Binding Menu_Enabled, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MenuEditorItem_Enabled_12483"/>
                            </StackPanel>

                            <!-- Style row. All four setting combos below auto-size to
                                 their WIDEST ITEM and share one width group: MinWidth-only
                                 combos resized to the selected option (column rhythm
                                 broke), and the fixed widths that replaced them clipped
                                 longer locales like Italian and German (owner reports
                                 2026-07-16). The behavior remeasures when a language
                                 switch hands the combo a rebuilt list. -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuEditorLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Menu_Style, Source={x:Static strings:Strings.Instance}}"
                                           ToolTip="{Binding Menu_Style_Tip, Source={x:Static strings:Strings.Instance}}"
                                           Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ComboBox MinWidth="200" ItemsSource="{Binding KindOptions}"
                                              common:ComboBoxWidthBehavior.SizeToItems="True"
                                              common:ComboBoxWidthBehavior.WidthGroup="MenuSettingCombos"
                                              ToolTip="{Binding Menu_Style_Tip, Source={x:Static strings:Strings.Instance}}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding KindIndex, Mode=TwoWay}"/>
                                    <ui:Button Command="{Binding ResetStyleCommand}" Style="{StaticResource ResetButton}" Margin="6,0,0,0" ToolTip="{Binding Menu_Reset_Style, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuEditorLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="{Binding Menu_Style_Caption, Source={x:Static strings:Strings.Instance}}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"
                                           Margin="0,2,0,0" FontSize="12"/>
                            </Grid>

                            <!-- Keyboard (#566): how the keys are laid out and picked. -->
                            <Grid Margin="0,0,0,4"
                                  Visibility="{Binding IsKeyboard, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuEditorLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Menu_KeyboardLayout, Source={x:Static strings:Strings.Instance}}"
                                           ToolTip="{Binding Menu_KeyboardLayout_Tip, Source={x:Static strings:Strings.Instance}}"
                                           Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ComboBox MinWidth="200" ItemsSource="{Binding KeyboardLayoutOptions}"
                                              common:ComboBoxWidthBehavior.SizeToItems="True"
                                              common:ComboBoxWidthBehavior.WidthGroup="MenuSettingCombos"
                                              ToolTip="{Binding Menu_KeyboardLayout_Tip, Source={x:Static strings:Strings.Instance}}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding KeyboardLayoutIndex, Mode=TwoWay}">
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                                <Setter Property="ToolTip" Value="{Binding Description}"/>
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                    </ComboBox>
                                    <ui:Button Command="{Binding ResetKeyboardLayoutCommand}" Style="{StaticResource ResetButton}" Margin="6,0,0,0" ToolTip="{Binding Menu_Reset_KeyboardLayout, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,10"
                                  Visibility="{Binding IsKeyboard, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuEditorLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="{Binding KeyboardLayoutDescription}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"
                                           Margin="0,2,0,0" FontSize="12"/>
                            </Grid>

                            <!-- Web Menus (#471): a Touch Grid menu can be a page on the
                                 web controller's phone deck. A radial menu cannot, so
                                 the row shows for Touch Grid, and on any menu while the
                                 flag is set so it stays visible and resettable. -->
                            <Grid Margin="0,0,0,8"
                                  Visibility="{Binding ShowWebControllerRow, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuEditorLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <CheckBox VerticalAlignment="Center" Content="{Binding Menu_ShowOnWebController, Source={x:Static strings:Strings.Instance}}"
                                              ToolTip="{Binding Menu_ShowOnWebController_Tip, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding ShowOnWebController, Mode=TwoWay}"/>
                                    <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="ShowOnWebController" SettingLabel="{Binding Menu_ShowOnWebController, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MenuEditorItem_ShowOnWebController"/>
                                </StackPanel>
                            </Grid>

                            <!-- Layer gate (#413, @brawler14801 on discussion #409). The
                                 field, its persistence and the runtime gate all existed.
                                 Only the editor did not, so an imported or starter
                                 profile could carry a layer-gated menu and a hand-built
                                 one could not. Same shape and the same two visibility
                                 triggers as the macro editor's Layer row: shown when the
                                 slot has layers, or when this menu already carries a
                                 scope so it is always visible and clearable. -->
                            <Grid Margin="0,0,0,8">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.HasShiftLayers, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ShowsLayerRow}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuEditorLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Menu_Layer, Source={x:Static strings:Strings.Instance}}"
                                           ToolTip="{Binding Menu_Layer_Tip, Source={x:Static strings:Strings.Instance}}"
                                           Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <!-- The picker's collection is reconciled in place and
                                         never replaced, so the width behavior's ItemsSource
                                         watch would never fire. The version counter tells
                                         it when labels changed under a stable identity. -->
                                    <ComboBox MinWidth="200" ItemsSource="{Binding LayerChoices}"
                                              common:ComboBoxWidthBehavior.SizeToItems="True"
                                              common:ComboBoxWidthBehavior.WidthGroup="MenuSettingCombos"
                                              common:ComboBoxWidthBehavior.ItemsVersion="{Binding LayerChoicesVersion}"
                                              ToolTip="{Binding Menu_Layer_Tip, Source={x:Static strings:Strings.Instance}}"
                                              SelectedValue="{Binding LayerMask, Mode=TwoWay}"
                                              SelectedValuePath="LayerMask"
                                              DisplayMemberPath="LayerName"/>
                                    <ui:Button Command="{Binding ResetLayerCommand}" Style="{StaticResource ResetButton}" Margin="6,0,0,0" ToolTip="{Binding Menu_Reset_Layer, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Stay-open (#413): the layer holds the menu open and the
                                 surface only steers. A modifier on the gate above, so it
                                 lives directly under it and shows once a real layer is
                                 chosen (or while the flag is set, so a loaded file's
                                 flag is always visible and resettable). -->
                            <Grid Margin="0,0,0,8"
                                  Visibility="{Binding ShowLayerHold, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuEditorLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <CheckBox Content="{Binding Menu_LayerHoldsOpen, Source={x:Static strings:Strings.Instance}}"
                                              ToolTip="{Binding Menu_LayerHoldsOpen_Tip, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding LayerHoldsOpen, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetLayerHoldsOpenCommand}" Style="{StaticResource ResetButton}" Margin="6,0,0,0" ToolTip="{Binding Menu_Reset_LayerHoldsOpen, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Opens With (#566): any input on the slot's devices, or two
                                 held together, the row shape of a keyboard control. -->
                            <Grid Margin="0,0,0,4" DataContext="{Binding OpenRow}"
                                  Visibility="{Binding DataContext.IsKeyboard, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuEditorLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Menu_Keyboard_OpensWith, Source={x:Static strings:Strings.Instance}}"
                                           ToolTip="{Binding Menu_Keyboard_OpensWith_Caption, Source={x:Static strings:Strings.Instance}}"
                                           Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <StackPanel Orientation="Vertical">
                                        <ComboBox MinWidth="260" ItemsSource="{Binding ChoicesView}"
                                                  AutomationProperties.AutomationId="MenuKeyboard_OpensWith"
                                                  ToolTip="{Binding Menu_Keyboard_OpensWith_Caption, Source={x:Static strings:Strings.Instance}}"
                                                  DisplayMemberPath="DisplayName" SelectedValuePath="Key"
                                                  SelectedValue="{Binding SelectedKey, Mode=TwoWay}">
                                            <ComboBox.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,3,6,3">
                                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ComboBox.GroupStyle>
                                        </ComboBox>
                                        <TextBlock FontSize="10" Margin="4,1,0,0" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Subtitle}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource EmberBrush}"/>
                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource KeyboardThresholdTemplate}"
                                                        Focusable="False" IsTabStop="False"/>
                                    </StackPanel>
                                    <ui:Button AutomationProperties.Name="{Binding RecordText, TargetNullValue=''}"
                                               Command="{Binding DataContext.MenuKeyboardRecordCommand,
                                                   RelativeSource={RelativeSource AncestorType=TabItem}}"
                                               CommandParameter="{Binding}"
                                               Style="{StaticResource EmberIconButtonHot}" Margin="6,0,0,0" VerticalAlignment="Top">
                                        <controls:GlyphText Text="{Binding RecordIcon}" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource EmberBrush}"/>
                                    </ui:Button>
                                    <ui:Button Command="{Binding ResetInputCommand}" Style="{StaticResource ResetButton}" VerticalAlignment="Top"
                                               ToolTip="{Binding Menu_Reset_OpensWith, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,10"
                                  Visibility="{Binding IsKeyboard, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuEditorLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="{Binding Menu_Keyboard_OpensWith_Caption, Source={x:Static strings:Strings.Instance}}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"
                                           Margin="0,2,0,0" FontSize="12"/>
                            </Grid>

                            <!-- Opens On (#566): the macro trigger's press modes. Steam's
                                 Long_Press and Double_Press on Show Keyboard import here, so
                                 a short press keeps its own binding, and its Release imports
                                 as On Release. -->
                            <Grid Margin="0,0,0,10"
                                  Visibility="{Binding IsKeyboard, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuEditorLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Menu_Keyboard_OpenPress, Source={x:Static strings:Strings.Instance}}"
                                           ToolTip="{Binding Menu_Keyboard_OpenPress_Tip, Source={x:Static strings:Strings.Instance}}"
                                           Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ComboBox MinWidth="200" ItemsSource="{Binding OpenPressOptions}"
                                              common:ComboBoxWidthBehavior.SizeToItems="True"
                                              common:ComboBoxWidthBehavior.WidthGroup="MenuSettingCombos"
                                              ToolTip="{Binding Menu_Keyboard_OpenPress_Tip, Source={x:Static strings:Strings.Instance}}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding OpenPressIndex, Mode=TwoWay}">
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                                <Setter Property="ToolTip" Value="{Binding Description}"/>
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                    </ComboBox>
                                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                                                Visibility="{Binding ShowsOpenPressMs, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding OpenPressMsLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ui:NumberBox Width="200" Minimum="50" Maximum="10000" SmallChange="50"
                                                      ToolTip="{Binding Menu_Keyboard_OpenPress_Tip, Source={x:Static strings:Strings.Instance}}"
                                                      Value="{Binding OpenPressMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <ui:Button Command="{Binding ResetOpenPressCommand}" Style="{StaticResource ResetButton}" Margin="6,0,0,0" ToolTip="{Binding Menu_Reset_OpenPress, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Open When a Text Box Is Selected (#566). -->
                            <Grid Margin="0,0,0,4"
                                  Visibility="{Binding IsKeyboard, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuEditorLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <CheckBox VerticalAlignment="Center" Content="{Binding Menu_OpenOnTextFocus, Source={x:Static strings:Strings.Instance}}"
                                              ToolTip="{Binding Menu_OpenOnTextFocus_Caption, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding OpenOnTextFocus, Mode=TwoWay}"/>
                                    <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="OpenOnTextFocus" SettingLabel="{Binding Menu_OpenOnTextFocus, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MenuEditorItem_OpenOnTextFocus"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,10"
                                  Visibility="{Binding IsKeyboard, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuEditorLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="{Binding Menu_OpenOnTextFocus_Caption, Source={x:Static strings:Strings.Instance}}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"
                                           Margin="0,2,0,0" FontSize="12"/>
                            </Grid>

                            <!-- Host input row (Reset + Record per canon). A keyboard
                                 menu steers from its Keyboard Controls card (#566). -->
                            <Grid Margin="0,0,0,8"
                                  Visibility="{Binding IsCellMenu, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuEditorLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- "Opens With" in surface mode. "Steer With" when the
                                     layer holds the menu open (#413), because then the
                                     surface no longer opens anything. -->
                                <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding HostInputLabel}"
                                           ToolTip="{Binding HostInputTip}"
                                           Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ComboBox MinWidth="200" ItemsSource="{Binding HostOptions}"
                                              common:ComboBoxWidthBehavior.SizeToItems="True"
                                              common:ComboBoxWidthBehavior.WidthGroup="MenuSettingCombos"
                                              ToolTip="{Binding HostInputTip}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedHost, Mode=TwoWay}"/>
                                    <ui:Button AutomationProperties.Name="{Binding HostRecordText, TargetNullValue=''}" Command="{Binding DataContext.MenuHostRecordCommand,
                                                   RelativeSource={RelativeSource AncestorType=TabItem}}"
                                               Style="{StaticResource EmberIconButtonHot}" Margin="6,0,0,0">
                                        <controls:GlyphText Text="{Binding HostRecordIcon}" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource EmberBrush}"/>
                                    </ui:Button>
                                    <ui:Button Command="{Binding ResetHostCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Menu_Reset_HostInput, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </Grid>
                            <!-- Persistent caption: "Opens With" is the PHYSICAL side,
                                 and menus are the one tab where input and output meet,
                                 so users read the stick / touchpad options as the
                                 virtual controller's layout without this (owner report
                                 2026-07-16). -->
                            <Grid Margin="0,0,0,10"
                                  Visibility="{Binding IsCellMenu, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuEditorLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="{Binding HostInputCaption}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"
                                           Margin="0,2,0,0" FontSize="12"/>
                            </Grid>

                            <!-- Custom opener steer axes (Custom host only): any
                                 recorded axis on any device, which is how joysticks,
                                 wheels, and other non-gamepad devices host menus. -->
                            <Grid Margin="0,0,0,8"
                                  Visibility="{Binding ShowsCustomAxesRows, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuEditorLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Menu_CustomX, Source={x:Static strings:Strings.Instance}}"
                                           ToolTip="{Binding Menu_CustomAxis_Tip, Source={x:Static strings:Strings.Instance}}"
                                           Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <StackPanel Orientation="Vertical">
                                        <ComboBox MinWidth="260" ItemsSource="{Binding CustomXChoicesView}"
                                                  ToolTip="{Binding Menu_CustomAxis_Tip, Source={x:Static strings:Strings.Instance}}"
                                                  DisplayMemberPath="DisplayName" SelectedValuePath="Descriptor"
                                                  SelectedValue="{Binding CustomXSelected, Mode=TwoWay}">
                                            <ComboBox.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,3,6,3">
                                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ComboBox.GroupStyle>
                                        </ComboBox>
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Margin="4,1,0,0" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding CustomXSubtitle}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CustomXSelected}" Value="">
                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <ui:Button AutomationProperties.Name="{Binding CustomXRecordText, TargetNullValue=''}" Command="{Binding DataContext.MenuRecordTargetCommand,
                                                   RelativeSource={RelativeSource AncestorType=TabItem}}"
                                               CommandParameter="CustomX"
                                               Style="{StaticResource EmberIconButtonHot}" Margin="6,0,0,0"
                                               VerticalAlignment="Top">
                                        <controls:GlyphText Text="{Binding CustomXRecordIcon}" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource EmberBrush}"/>
                                    </ui:Button>
                                    <ui:Button Command="{Binding ResetCustomXCommand}" Style="{StaticResource ResetButton}" VerticalAlignment="Top" ToolTip="{Binding Menu_Reset_CustomX, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,8"
                                  Visibility="{Binding ShowsCustomAxesRows, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuEditorLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Menu_CustomY, Source={x:Static strings:Strings.Instance}}"
                                           ToolTip="{Binding Menu_CustomAxis_Tip, Source={x:Static strings:Strings.Instance}}"
                                           Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <StackPanel Orientation="Vertical">
                                        <ComboBox MinWidth="260" ItemsSource="{Binding CustomYChoicesView}"
                                                  ToolTip="{Binding Menu_CustomAxis_Tip, Source={x:Static strings:Strings.Instance}}"
                                                  DisplayMemberPath="DisplayName" SelectedValuePath="Descriptor"
                                                  SelectedValue="{Binding CustomYSelected, Mode=TwoWay}">
                                            <ComboBox.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,3,6,3">
                                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ComboBox.GroupStyle>
                                        </ComboBox>
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Margin="4,1,0,0" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding CustomYSubtitle}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CustomYSelected}" Value="">
                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <ui:Button AutomationProperties.Name="{Binding CustomYRecordText, TargetNullValue=''}" Command="{Binding DataContext.MenuRecordTargetCommand,
                                                   RelativeSource={RelativeSource AncestorType=TabItem}}"
                                               CommandParameter="CustomY"
                                               Style="{StaticResource EmberIconButtonHot}" Margin="6,0,0,0"
                                               VerticalAlignment="Top">
                                        <controls:GlyphText Text="{Binding CustomYRecordIcon}" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource EmberBrush}"/>
                                    </ui:Button>
                                    <ui:Button Command="{Binding ResetCustomYCommand}" Style="{StaticResource ResetButton}" VerticalAlignment="Top" ToolTip="{Binding Menu_Reset_CustomY, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Click input: the button On Click / On Click Release
                                 use, assignable on EVERY opener. The old behavior
                                 hard-wired it to the under-stick button, a gamepad
                                 convention joysticks and wheels do not share. -->
                            <Grid Margin="0,0,0,8"
                                  Visibility="{Binding ShowsClickRow, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuEditorLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Menu_ClickInput, Source={x:Static strings:Strings.Instance}}"
                                           ToolTip="{Binding Menu_ClickInput_Tip, Source={x:Static strings:Strings.Instance}}"
                                           Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <StackPanel Orientation="Vertical">
                                        <ComboBox MinWidth="260" ItemsSource="{Binding ClickChoicesView}"
                                                  ToolTip="{Binding Menu_ClickInput_Tip, Source={x:Static strings:Strings.Instance}}"
                                                  DisplayMemberPath="DisplayName" SelectedValuePath="Descriptor"
                                                  SelectedValue="{Binding ClickSelected, Mode=TwoWay}">
                                            <ComboBox.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,3,6,3">
                                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ComboBox.GroupStyle>
                                        </ComboBox>
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Margin="4,1,0,0" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding ClickSubtitle}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ClickSelected}" Value="">
                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <ui:Button AutomationProperties.Name="{Binding ClickRecordText, TargetNullValue=''}" Command="{Binding DataContext.MenuRecordTargetCommand,
                                                   RelativeSource={RelativeSource AncestorType=TabItem}}"
                                               CommandParameter="Click"
                                               Style="{StaticResource EmberIconButtonHot}" Margin="6,0,0,0"
                                               VerticalAlignment="Top">
                                        <controls:GlyphText Text="{Binding ClickRecordIcon}" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource EmberBrush}"/>
                                    </ui:Button>
                                    <ui:Button Command="{Binding ResetClickCommand}" Style="{StaticResource ResetButton}" VerticalAlignment="Top" ToolTip="{Binding Menu_Reset_Click, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Hotbar: the four controls Steam's hotbar runs on, Down,
                                 Left, Right and Up of its opener. Each records any button
                                 on the slot's devices, and an empty one reads the
                                 opener's own direction. -->
                            <Grid Margin="0,0,0,8"
                                  Visibility="{Binding IsHotbar, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuEditorLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Menu_Hotbar_Show, Source={x:Static strings:Strings.Instance}}"
                                           ToolTip="{Binding Menu_Hotbar_Show_Tip, Source={x:Static strings:Strings.Instance}}"
                                           Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <StackPanel Orientation="Vertical">
                                        <ComboBox MinWidth="260" ItemsSource="{Binding HotbarShowChoicesView}"
                                                  AutomationProperties.AutomationId="MenuHotbar_Show"
                                                  ToolTip="{Binding Menu_Hotbar_Show_Tip, Source={x:Static strings:Strings.Instance}}"
                                                  DisplayMemberPath="DisplayName" SelectedValuePath="Descriptor"
                                                  SelectedValue="{Binding HotbarShowSelected, Mode=TwoWay}">
                                            <ComboBox.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,3,6,3">
                                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ComboBox.GroupStyle>
                                        </ComboBox>
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Margin="4,1,0,0" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding HotbarShowSubtitle}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HotbarShowSelected}" Value="">
