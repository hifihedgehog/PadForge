                                        <ui:Button Command="{Binding ResetTouchpadCooldownMsCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_ResetTouchpadCooldownMs, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ─── In-box gestures card ─── -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel IsEnabled="{Binding TouchpadInBoxSectionEnabled}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xF12B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_Touchpad_InBox_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding ResetTouchpadInBoxCardCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetTouchpadInBox, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Why-is-this-gray pointer: the whole card is gated on the
                                     Detection card's master toggle + Recognize mode, and users
                                     kept checking categories with the master off, then not
                                     finding the gestures in the mapping list (#177/#178). -->
                                <TextBlock Text="{Binding Pad_Touchpad_SectionGated_Hint, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}"
                                           Visibility="{Binding TouchpadInBoxSectionEnabled, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Touchpad_TouchSpots, Source={x:Static strings:Strings.Instance}}"
                                              ToolTip="{Binding Pad_Touchpad_TouchSpots_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding TouchpadEnableTouchSpots, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetTouchpadEnableTouchSpotsCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadTouchSpots, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Touchpad_FourWaySwipes, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding TouchpadEnableFourWaySwipes, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetTouchpadEnableFourWaySwipesCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadFourWaySwipes, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Touchpad_EightWaySwipes, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding TouchpadEnableEightWaySwipes, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetTouchpadEnableEightWaySwipesCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadEightWaySwipes, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="20,0,0,6">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Touchpad_SwipeDistanceThreshold, Source={x:Static strings:Strings.Instance}}"
                                               VerticalAlignment="Center" Width="270"/>
                                    <TextBox Text="{Binding TouchpadSwipeDistanceThreshold, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                             Width="80" VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetTouchpadSwipeDistanceThresholdCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadSwipeDistance, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="20,0,0,8">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Touchpad_SwipeTimeWindow, Source={x:Static strings:Strings.Instance}}"
                                               VerticalAlignment="Center" Width="270"/>
                                    <TextBox Text="{Binding TouchpadSwipeTimeWindowMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Width="80" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetTouchpadSwipeTimeWindowMsCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadSwipeTimeWindow, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Touchpad_RadialZones, Source={x:Static strings:Strings.Instance}}"
                                              ToolTip="{Binding Pad_Touchpad_RadialZones_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding TouchpadEnableRadialZones, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetTouchpadEnableRadialZonesCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadRadialZones, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="20,0,0,6">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Touchpad_RadialZoneCount, Source={x:Static strings:Strings.Instance}}"
                                               VerticalAlignment="Center" Width="270"/>
                                    <ComboBox ItemsSource="{Binding TouchpadRadialZoneCountOptions}"
                                              SelectedItem="{Binding TouchpadRadialZoneCount, Mode=TwoWay}"
                                              Width="80" VerticalAlignment="Center"
                                              ScrollViewer.VerticalScrollBarVisibility="Visible"/>
                                    <ui:Button Command="{Binding ResetTouchpadRadialZoneCountCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadRadialZoneCount, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="20,0,0,8">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Touchpad_RadialCenterDeadzone, Source={x:Static strings:Strings.Instance}}"
                                               VerticalAlignment="Center" Width="270"/>
                                    <TextBox Text="{Binding TouchpadRadialCenterDeadzone, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                             Width="80" VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetTouchpadRadialCenterDeadzoneCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadRadialCenterDeadzone, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Touchpad_Taps, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding TouchpadEnableTaps, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetTouchpadEnableTapsCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadTaps, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="20,0,0,6">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Touchpad_TapTimeWindow, Source={x:Static strings:Strings.Instance}}"
                                               VerticalAlignment="Center" Width="270"/>
                                    <TextBox Text="{Binding TouchpadTapTimeWindowMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Width="80" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetTouchpadTapTimeWindowMsCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadTapTimeWindow, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="20,0,0,8">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Touchpad_MultiTapGap, Source={x:Static strings:Strings.Instance}}"
                                               VerticalAlignment="Center" Width="270"/>
                                    <TextBox Text="{Binding TouchpadMultiTapGapMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Width="80" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetTouchpadMultiTapGapMsCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadMultiTapGap, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Touchpad_LongPress, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding TouchpadEnableLongPress, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetTouchpadEnableLongPressCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadLongPress, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="20,0,0,8">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Touchpad_LongPressTimeWindow, Source={x:Static strings:Strings.Instance}}"
                                               VerticalAlignment="Center" Width="270"/>
                                    <TextBox Text="{Binding TouchpadLongPressTimeWindowMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Width="80" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetTouchpadLongPressTimeWindowMsCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadLongPressTimeWindow, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Touchpad_TwoFingerSwipes, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding TouchpadEnableTwoFingerSwipes, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetTouchpadEnableTwoFingerSwipesCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadTwoFingerSwipes, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Touchpad_PinchSpread, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding TouchpadEnablePinchSpread, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetTouchpadEnablePinchSpreadCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadPinchSpread, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Touchpad_Rotate, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding TouchpadEnableRotate, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetTouchpadEnableRotateCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadRotate, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Touchpad_ThreeFinger, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding TouchpadEnableThreeFingerGestures, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetTouchpadEnableThreeFingerGesturesCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadThreeFinger, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Touchpad_FourFinger, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding TouchpadEnableFourFingerGestures, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetTouchpadEnableFourFingerGesturesCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadFourFinger, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Touchpad_FiveFinger, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding TouchpadEnableFiveFingerGestures, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetTouchpadEnableFiveFingerGesturesCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadFiveFinger, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_Touchpad_ShapeGestures, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding TouchpadEnableShapeGestures, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetTouchpadEnableShapeGesturesCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadShapeGestures, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Touchpad_MatchThreshold, Source={x:Static strings:Strings.Instance}}"
                                               VerticalAlignment="Center" Width="270"/>
                                    <TextBox Text="{Binding TouchpadGestureMatchThreshold, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                             Width="80" VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetTouchpadGestureMatchThresholdCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetTouchpadMatchThreshold, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ─── Custom gestures card ─── -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel IsEnabled="{Binding TouchpadCustomSectionEnabled}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xF4A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_Touchpad_Custom_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                </StackPanel>

                                <TextBlock Text="{Binding Pad_Touchpad_SectionGated_Hint, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}"
                                           Visibility="{Binding TouchpadCustomSectionEnabled, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>

                                <TextBlock Text="{Binding Pad_Touchpad_Custom_Empty, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}"
                                           Visibility="{Binding HasNoCustomTouchpadGestures, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <ItemsControl ItemsSource="{Binding CustomTouchpadGestures}" Margin="0,0,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Summary}"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center" Margin="12,0"/>
                                                <Button Grid.Column="2"
                                                        Content="{Binding Common_Remove, Source={x:Static strings:Strings.Instance}}"
                                                        Command="{Binding DataContext.DeleteTouchpadGestureCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="8,2"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="{Binding Pad_Touchpad_RecordNew, Source={x:Static strings:Strings.Instance}}"
                                        Command="{Binding RecordTouchpadGestureCommand}"
                                        HorizontalAlignment="Left" Padding="10,4"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ Wheel (Tag 11) — native-FFB wheels only ═══ -->
            <TabItem>
                <ScrollViewer Padding="24,0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Viewbox Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="{DynamicResource EmberBrush}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M9.4,12 A2.6,2.6 0 1 1 14.6,12 A2.6,2.6 0 1 1 9.4,12 Z M9.4,12 L2.2,12 M14.6,12 L21.8,12 M12,14.6 L12,21.8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding Pad_Wheel, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource TitleTextBlockStyle}" FontFamily="{StaticResource DisplayFontFamily}" FontWeight="650" FontSize="26"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Pad_Wheel_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Viewbox Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="{DynamicResource EmberBrush}" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M9.4,12 A2.6,2.6 0 1 1 14.6,12 A2.6,2.6 0 1 1 9.4,12 Z M9.4,12 L2.2,12 M14.6,12 L21.8,12 M12,14.6 L12,21.8"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding Pad_Wheel, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding ResetWheelAllCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetWheel, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Rotation range — wheel hardware steering lock (not a force).
                                     Native HID command (vendor wheels only); hidden for generic
                                     SDL wheels, which expose no set-range API. -->
                                <StackPanel x:Name="WheelRangeRow" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Pad_Wheel_RotationRange, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding WheelRotationRange, Mode=TwoWay}" Minimum="40" Maximum="2520"
                                            Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding WheelRotationRange, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="&#176;" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetWheelRotationRangeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetRotationRange, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Auto-center — centering spring force -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Pad_Wheel_Autocenter, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding WheelAutoCenter, Mode=TwoWay}" Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding WheelAutoCenter, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetWheelAutoCenterCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetAutocenter, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- RPM shift LEDs — telemetry-driven rev display.
                                     Native HID command (vendor wheels only); hidden for generic
                                     SDL wheels, which have no addressable rev strip. -->
                                <StackPanel x:Name="WheelRpmRow" Orientation="Horizontal" Margin="0,4,0,0">
                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsChecked="{Binding WheelRpmLeds, Mode=TwoWay}"
                                              Content="{Binding Pad_Wheel_RpmLeds, Source={x:Static strings:Strings.Instance}}"
                                              VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetWheelRpmLedsCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetRpmLeds, Source={x:Static strings:Strings.Instance}}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- === TAB 12: Audio (slot-level, issue #83) === -->
            <TabItem>
                <ScrollViewer Padding="24,0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE767;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Pad_Audio_Header, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource TitleTextBlockStyle}" FontFamily="{StaticResource DisplayFontFamily}" FontWeight="650" FontSize="26"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Pad_Audio_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- Sound Output card -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE7F5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_Audio_Output_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding ResetSoundOutputAllCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_Audio_Reset_All, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Pad_Audio_Output_Desc, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}"/>
                                <!-- Per assigned device, by convention: this toggle (and the
                                     speaker routing of macro sounds) follows the device selected
                                     in the assigned-devices dropdown. No output picker. -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                            Visibility="{Binding SelectedDeviceHasSpeaker, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsChecked="{Binding DeviceConfig.AudioPassthroughEnabled, Mode=TwoWay}"
                                              Content="{Binding Pad_Audio_Mirror, Source={x:Static strings:Strings.Instance}}"
                                              ToolTip="{Binding Pad_Audio_Mirror_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                              VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetAudioMirrorCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetAudioMirror, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <!-- Mirror SOURCE: which playback device feeds the mirror.
                                     "" = system default. Lets games that send specific
                                     sounds to a separate playback device target the pad. -->
                                <StackPanel Orientation="Horizontal" Margin="20,0,0,8"
                                            Visibility="{Binding SelectedDeviceHasSpeaker, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Audio_MirrorSource_Label, Source={x:Static strings:Strings.Instance}}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <!-- SelectedValuePath/DisplayMemberPath MUST precede the
                                         ItemsSource/SelectedValue bindings: XAML applies
                                         attributes in order, and a SelectedValue that attaches
                                         before SelectedValuePath is set fails to resolve and
                                         never retries — the closed box renders blank. -->
                                    <ComboBox SelectedValuePath="Id" DisplayMemberPath="Name"
                                              ItemsSource="{Binding MirrorSourceOptions}"
                                              SelectedValue="{Binding SelectedMirrorSourceId, Mode=TwoWay}"
                                              MinWidth="260" MaxWidth="380"
                                              DropDownOpened="MirrorSource_DropDownOpened"
                                              IsEnabled="{Binding DeviceConfig.AudioPassthroughEnabled}"
                                              ToolTip="{Binding Pad_Audio_MirrorSource_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ui:Button Command="{Binding ResetMirrorSourceCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetMirrorSource, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <!-- Mirror ENGAGE gate (#185), haptic-tone devices only: a
                                     resonant actuator buzzing with music is intrusive in a
                                     way a real speaker is not. Always / While an input is
                                     held / While the game rumbles, with a release delay so
                                     the tone does not clip off the instant the source drops. -->
                                <StackPanel Margin="20,0,0,8"
                                            Visibility="{Binding SelectedDeviceHasHapticTones, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Audio_Engage_Label, Source={x:Static strings:Strings.Instance}}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox SelectedValuePath="Tag"
                                                  SelectedValue="{Binding DeviceConfig.AudioMirrorEngageMode, Mode=TwoWay}"
                                                  MinWidth="220"
                                                  IsEnabled="{Binding DeviceConfig.AudioPassthroughEnabled}"
                                                  ToolTip="{Binding Pad_Audio_Engage_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                            <ComboBoxItem Content="{Binding Pad_Audio_Engage_Always, Source={x:Static strings:Strings.Instance}}" Tag="Always"/>
                                            <ComboBoxItem Content="{Binding Pad_Audio_Engage_Input, Source={x:Static strings:Strings.Instance}}" Tag="Input"/>
                                            <ComboBoxItem Content="{Binding Pad_Audio_Engage_Rumble, Source={x:Static strings:Strings.Instance}}" Tag="Rumble"/>
                                        </ComboBox>
                                        <ui:Button Command="{Binding ResetMirrorEngageModeCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_ResetMirrorEngageMode, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                    <!-- Engage input picker, Input mode only. Same grouped
                                         cross-device list + device-label subtitle as the
                                         gyro Aim Engage picker. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DeviceConfig.AudioMirrorEngageMode}" Value="Input">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Audio_EngageInput_Label, Source={x:Static strings:Strings.Instance}}"
                                                   VerticalAlignment="Top" Margin="0,4,8,0"/>
                                        <StackPanel Orientation="Vertical">
                                            <ComboBox ItemsSource="{Binding SlotAvailableInputsView}"
                                                      SelectedItem="{Binding MirrorEngageSelectedInput, Mode=TwoWay}"
                                                      DisplayMemberPath="DisplayName"
                                                      MinWidth="260" Padding="4,2"
                                                      IsEnabled="{Binding DeviceConfig.AudioPassthroughEnabled}"
                                                      IsSynchronizedWithCurrentItem="False">
                                                <ComboBox.GroupStyle>
                                                    <GroupStyle>
                                                        <GroupStyle.HeaderTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,3,6,3">
                                                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </GroupStyle.HeaderTemplate>
                                                    </GroupStyle>
                                                </ComboBox.GroupStyle>
                                            </ComboBox>
                                            <TextBlock FontSize="10"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Margin="4,1,0,0"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding MirrorEngageSelectedInput.DeviceLabel}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MirrorEngageSelectedInput}" Value="{x:Null}">
                                                                <Setter Property="Text" Value="{Binding Common_Unassigned, Source={x:Static strings:Strings.Instance}}"/>
                                                                <Setter Property="FontStyle" Value="Italic"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <ui:Button Command="{Binding MirrorEngageRecordCommand}"
                                                   Style="{StaticResource EmberIconButtonHot}"
                                                   VerticalAlignment="Top">
                                            <TextBlock Text="{Binding MirrorEngageRecordButtonIcon}" FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{DynamicResource EmberBrush}"/>
                                            <ui:Button.ToolTip>
                                                <TextBlock Text="{Binding MirrorEngageRecordButtonText}"/>
                                            </ui:Button.ToolTip>
                                        </ui:Button>
                                        <ui:Button Command="{Binding ResetMirrorEngageInputCommand}" Style="{StaticResource ResetButton}"
                                                VerticalAlignment="Top"
                                                ToolTip="{Binding Pad_ResetMirrorEngageInput, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                    <!-- Release delay, any gated mode. -->
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DeviceConfig.AudioMirrorEngageMode}" Value="Always">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Audio_EngageRelease_Label, Source={x:Static strings:Strings.Instance}}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                   ToolTip="{Binding Pad_Audio_EngageRelease_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBox Text="{Binding DeviceConfig.AudioMirrorEngageReleaseMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Width="64" VerticalAlignment="Center"
                                                 IsEnabled="{Binding DeviceConfig.AudioPassthroughEnabled}"/>
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="ms" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        <ui:Button Command="{Binding ResetMirrorEngageReleaseMsCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_ResetMirrorEngageRelease, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                </StackPanel>
                                <!-- High-tone filter (#202), haptic-tone devices only: the
                                     sink reduces everything it plays (mirror, macro sounds,
                                     Test) to one pitch per tick, so beeps above the limit
                                     can be cut, or folded down an octave at a time keeping
                                     their pitch class. Independent of the mirror toggle:
                                     macro sounds are filtered too, so no IsEnabled gate. -->
                                <StackPanel Margin="0,0,0,8"
                                            Visibility="{Binding SelectedDeviceHasHapticTones, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Audio_ToneFilter_Label, Source={x:Static strings:Strings.Instance}}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox SelectedValuePath="Tag"
                                                  SelectedValue="{Binding DeviceConfig.AudioToneFilterMode, Mode=TwoWay}"
                                                  MinWidth="220"
                                                  ToolTip="{Binding Pad_Audio_ToneFilter_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                            <ComboBoxItem Content="{Binding Pad_Audio_ToneFilter_Off, Source={x:Static strings:Strings.Instance}}" Tag="Off"/>
                                            <ComboBoxItem Content="{Binding Pad_Audio_ToneFilter_Cut, Source={x:Static strings:Strings.Instance}}" Tag="Cut"/>
                                            <ComboBoxItem Content="{Binding Pad_Audio_ToneFilter_Fold, Source={x:Static strings:Strings.Instance}}" Tag="Fold"/>
                                        </ComboBox>
                                        <ui:Button Command="{Binding ResetToneFilterModeCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_ResetToneFilterMode, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                    <!-- Limit, hidden while Off. Wider range than the bass
                                         cutoff's 20-200 by design: midtones stay in the
                                         default pass band, 800 keeps engine and shot
                                         rumble, folds or cuts only beeps above. -->
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DeviceConfig.AudioToneFilterMode}" Value="Off">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding Pad_Audio_ToneLimit_Label, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"
                                                   ToolTip="{Binding Pad_Audio_ToneLimit_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <Slider Value="{Binding DeviceConfig.AudioToneLimitHz, Mode=TwoWay}" Minimum="100" Maximum="1300"
                                                Style="{StaticResource DzSlider}"/>
                                        <TextBox Text="{Binding DeviceConfig.AudioToneLimitHz, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="Hz" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding ResetToneLimitHzCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_ResetToneLimit, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{Binding Pad_Audio_NoSpeaker, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}"
                                           Visibility="{Binding SelectedDeviceHasNoSpeaker, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Pad_Audio_MasterVolume, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding SoundMasterVolume, Mode=TwoWay}" Minimum="0" Maximum="100" Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding SoundMasterVolume, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetSoundMasterVolumeCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_Audio_Reset_MasterVolume, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding Pad_Audio_Test, Source={x:Static strings:Strings.Instance}}"
                                            Command="{Binding SoundTestCommand}" Padding="10,4" VerticalAlignment="Center"
                                            ToolTip="{Binding Pad_Audio_Test_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Audio_StopAll, Source={x:Static strings:Strings.Instance}}"
                                            Command="{Binding SoundStopAllCommand}" Padding="10,4" Margin="6,0,0,0" VerticalAlignment="Center"
                                            ToolTip="{Binding Pad_Audio_StopAll_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Sound Macros hub card -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xEC4F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_Audio_Macros_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Pad_Audio_Macros_Desc, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}"/>
                                <Button Content="{Binding Pad_Audio_NewSoundMacro, Source={x:Static strings:Strings.Instance}}"
                                        Command="{Binding AddSoundMacroCommand}" Padding="10,4" HorizontalAlignment="Left"
                                        Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding Pad_Audio_NoSoundMacros, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}"
                                           Visibility="{Binding HasNoSoundMacros, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <ItemsControl ItemsSource="{Binding SoundMacros}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="SoundMacroRow_Click" HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left" Margin="0,0,0,4" Padding="8,5"
                                                    ToolTip="{Binding Pad_Audio_OpenMacro_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xEC4F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding SoundFilesSummary}" VerticalAlignment="Center"
                                                               Margin="10,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Sound Packages card -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_Audio_Packages_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Pad_Audio_Packages_Desc, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="{Binding Pad_Audio_Packages_Add, Source={x:Static strings:Strings.Instance}}"
                                            Click="PackageAdd_Click" Padding="10,4"
                                            ToolTip="{Binding Pad_Audio_Packages_Add_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Audio_Packages_Create, Source={x:Static strings:Strings.Instance}}"
                                            Click="PackageCreate_Click" Padding="10,4" Margin="6,0,0,0"
                                            ToolTip="{Binding Pad_Audio_Packages_Create_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Common_Remove, Source={x:Static strings:Strings.Instance}}"
                                            Click="PackageRemove_Click" Padding="10,4" Margin="6,0,0,0"
                                            ToolTip="{Binding Pad_Audio_Packages_Remove_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <TextBlock x:Name="SoundPackagesEmptyText"
                                           Text="{Binding Pad_Audio_Packages_Empty, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}"/>
                                <ListBox x:Name="SoundPackagesList" MaxHeight="170"
                                         ItemContainerStyle="{StaticResource EmberSelectListItem}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Path}" VerticalAlignment="Center"
                                                           Margin="10,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- === TAB 13: Pointer (Wii Remote IR camera tuning, issue #146) === -->
            <TabItem>
                <ScrollViewer Padding="24,0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE8B0;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Pad_Pointer_Header, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource TitleTextBlockStyle}" FontFamily="{StaticResource DisplayFontFamily}" FontWeight="650" FontSize="26"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Pad_Pointer_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- Pointer Mode card (issue #203): how the aim drives the
                             OS cursor. Modes shape the cursor drive only; "IR
                             Pointer X/Y" mapping sources keep reading raw aim. -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE962;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_Pointer_ModeTitle, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding ResetPointerModeCardCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetPointerModeCard, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ComboBox Width="240" SelectedValuePath="Tag"
                                              SelectedValue="{Binding PointerMode, Mode=TwoWay}"
                                              ToolTip="{Binding Pad_Pointer_Mode_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                        <ComboBoxItem Content="{Binding Pad_Pointer_Mode_Mouse, Source={x:Static strings:Strings.Instance}}" Tag="Mouse"/>
                                        <ComboBoxItem Content="{Binding Pad_Pointer_Mode_FpsMouse, Source={x:Static strings:Strings.Instance}}" Tag="FpsMouse"/>
                                        <ComboBoxItem Content="{Binding Pad_Pointer_Mode_43, Source={x:Static strings:Strings.Instance}}" Tag="Mouse43"/>
                                        <ComboBoxItem Content="{Binding Pad_Pointer_Mode_169, Source={x:Static strings:Strings.Instance}}" Tag="Mouse169"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding ResetPointerModeCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetPointerMode, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- FPS speed knob, FpsMouse only. -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PointerMode}" Value="FpsMouse">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Pointer_FpsSpeed, Source={x:Static strings:Strings.Instance}}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"
                                               ToolTip="{Binding Pad_Pointer_FpsSpeed_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding PointerFpsSpeed, Mode=TwoWay}"
                                            Minimum="5" Maximum="100" Width="200" VerticalAlignment="Center"/>
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding PointerFpsSpeed}"
                                               FontFamily="{StaticResource TelemetryFontFamily}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="30"/>
                                    <ui:Button Command="{Binding ResetPointerFpsSpeedCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetPointerFpsSpeed, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <TextBlock Text="{Binding Pad_Pointer_ModeNote, Source={x:Static strings:Strings.Instance}}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE9E9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_Pointer_TuningTitle, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding ResetPointerTuningCardCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetPointerTuning, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Pointer_SensorBar, Source={x:Static strings:Strings.Instance}}"
                                           Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Width="240" HorizontalAlignment="Left"
                                              SelectedIndex="{Binding IrSensorBarPos, Mode=TwoWay}">
                                        <ComboBoxItem Content="{Binding Pad_Pointer_SensorBar_Centered, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Pointer_SensorBar_Above, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Pointer_SensorBar_Below, Source={x:Static strings:Strings.Instance}}"/>
                                    </ComboBox>
                                    <ui:Button Command="{Binding ResetIrSensorBarPosCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetSensorBarPos, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Pointer_Compensation, Source={x:Static strings:Strings.Instance}}"
                                           Margin="0,12,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <Slider Value="{Binding IrSensorBarCompPercent, Mode=TwoWay}"
                                            Minimum="0" Maximum="50" Width="240" VerticalAlignment="Center"/>
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding IrSensorBarCompPercent, StringFormat={}{0}%}"
                                               FontFamily="{StaticResource TelemetryFontFamily}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="36"/>
                                    <ui:Button Command="{Binding ResetIrSensorBarCompCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetSensorBarComp, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Pointer_Smoothing, Source={x:Static strings:Strings.Instance}}"
                                           Margin="0,12,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <Slider Value="{Binding IrSmoothingPercent, Mode=TwoWay}"
                                            Minimum="0" Maximum="100" Width="240" VerticalAlignment="Center"/>
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding IrSmoothingPercent, StringFormat={}{0}%}"
                                               FontFamily="{StaticResource TelemetryFontFamily}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="36"/>
                                    <ui:Button Command="{Binding ResetIrSmoothingCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetIrSmoothing, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- === TAB 14: Mouse (mouse gestures, issue #200) === -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Visible" Padding="0,0,8,0">
                    <StackPanel>
                        <!-- Mouse Gestures card: hold the gesture button, flick,
                             one action fires at release. Five actions per button
                             counting the plain click (Logi Options+ semantics). -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE962;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_MouseGestures_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding ResetMouseGesturesCardCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetMouseGestures, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Pad_MouseGestures_Desc, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Pad_MouseGestures_Enabled, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding MouseGesturesEnabled, Mode=TwoWay}"
                                              ToolTip="{Binding Pad_MouseGestures_Enabled_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                              VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetMouseGesturesEnabledCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetMouseGesturesEnabled, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel IsEnabled="{Binding MouseGesturesEnabled}">
                                    <!-- Grid + WrapPanel so the five checkboxes flow to
                                         extra lines instead of clipping in narrow windows
                                         (a horizontal StackPanel never wraps). -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="270"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_MouseGestures_Button, Source={x:Static strings:Strings.Instance}}"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding Pad_MouseGestures_Button_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Mouse_LeftClick, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,2,10,2"
                                                      IsChecked="{Binding MouseGestureButtonLeft, Mode=TwoWay}"/>
                                            <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Mouse_MiddleClick, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,2,10,2"
                                                      IsChecked="{Binding MouseGestureButtonMiddle, Mode=TwoWay}"/>
                                            <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Mouse_RightClick, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,2,10,2"
                                                      IsChecked="{Binding MouseGestureButtonRight, Mode=TwoWay}"/>
                                            <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="X1" VerticalAlignment="Center" Margin="0,2,10,2"
                                                      IsChecked="{Binding MouseGestureButtonX1, Mode=TwoWay}"/>
                                            <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="X2" VerticalAlignment="Center" Margin="0,2,10,2"
                                                      IsChecked="{Binding MouseGestureButtonX2, Mode=TwoWay}"/>
                                            <!-- Custom activation (discussion #216): a sixth gesture
                                                 button armed by a recorded input from ANY device
                                                 (key, gamepad button, pedal) instead of the mouse. -->
                                            <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding Mapping_MouseGestureCustom, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,2,10,2"
                                                      IsChecked="{Binding MouseGestureButtonCustom, Mode=TwoWay}"
                                                      ToolTip="{Binding Pad_MouseGestures_Custom_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        </WrapPanel>
                                        <ui:Button Grid.Column="2" Command="{Binding ResetMouseGestureButtonCommand}" Style="{StaticResource ResetButton}"
                                                VerticalAlignment="Center"
                                                ToolTip="{Binding Pad_ResetMouseGestureButton, Source={x:Static strings:Strings.Instance}}"/>
                                    </Grid>
                                    <!-- Custom activation input (discussion #216): cross-device
                                         picker + Record + Reset, the Aim Engage cluster's exact
                                         arrangement (see the Gyro tab's engage-button row). The
                                         recorded input arms the Custom gesture session while
                                         held; axes engage past half travel. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" IsEnabled="{Binding MouseGestureButtonCustom}">
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_MouseGestures_CustomInput, Source={x:Static strings:Strings.Instance}}"
                                                   Width="270" VerticalAlignment="Top" Margin="0,4,0,0"
                                                   ToolTip="{Binding Pad_MouseGestures_CustomInput_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <StackPanel Orientation="Vertical">
                                            <ComboBox ItemsSource="{Binding SlotAvailableInputsView}"
                                                      SelectedItem="{Binding MouseGestureCustomEngageSelectedInput, Mode=TwoWay}"
                                                      DisplayMemberPath="DisplayName"
                                                      MinWidth="260" Padding="4,2"
                                                      ToolTip="{Binding Pad_MouseGestures_CustomInput_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                      IsSynchronizedWithCurrentItem="False">
                                                <ComboBox.GroupStyle>
                                                    <GroupStyle>
                                                        <GroupStyle.HeaderTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,3,6,3">
                                                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </GroupStyle.HeaderTemplate>
                                                    </GroupStyle>
                                                </ComboBox.GroupStyle>
                                            </ComboBox>
                                            <TextBlock FontSize="10"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Margin="4,1,0,0"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding MouseGestureCustomEngageSelectedInput.DeviceLabel}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MouseGestureCustomEngageSelectedInput}" Value="{x:Null}">
                                                                <Setter Property="Text" Value="{Binding Common_Unassigned, Source={x:Static strings:Strings.Instance}}"/>
                                                                <Setter Property="FontStyle" Value="Italic"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <ui:Button Command="{Binding MouseGestureCustomEngageRecordCommand}"
                                                   Style="{StaticResource EmberIconButtonHot}"
                                                   VerticalAlignment="Top">
                                            <TextBlock Text="{Binding MouseGestureCustomEngageRecordButtonIcon}" FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{DynamicResource EmberBrush}"/>
                                            <ui:Button.ToolTip>
                                                <TextBlock Text="{Binding MouseGestureCustomEngageRecordButtonText}"/>
                                            </ui:Button.ToolTip>
                                        </ui:Button>
                                        <ui:Button Command="{Binding ResetMouseGestureCustomEngageCommand}" Style="{StaticResource ResetButton}"
                                                VerticalAlignment="Top"
                                                ToolTip="{Binding Pad_ResetMouseGestureCustomInput, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_MouseGestures_FlickThreshold, Source={x:Static strings:Strings.Instance}}"
                                                   Width="270" VerticalAlignment="Center"
                                                   ToolTip="{Binding Pad_MouseGestures_FlickThreshold_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <TextBox Width="80" VerticalAlignment="Center" TextAlignment="Center"
                                                 Text="{Binding MouseGestureFlickThreshold, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                        <ui:Button Command="{Binding ResetMouseGestureFlickThresholdCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_ResetMouseGestureFlickThreshold, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_MouseGestures_Cooldown, Source={x:Static strings:Strings.Instance}}"
                                                   Width="270" VerticalAlignment="Center"/>
                                        <TextBox Width="80" VerticalAlignment="Center" TextAlignment="Center"
                                                 Text="{Binding MouseGestureCooldownMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="ms" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        <ui:Button Command="{Binding ResetMouseGestureCooldownCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_ResetMouseGestureCooldown, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- === TAB 15: Menus (slot-level, #9 B-17 radial / touch menus) === -->
            <TabItem>
                <Grid Margin="8">
                    <Grid.Resources>
                        <!-- Every tooltip on this tab is a sentence-or-three
                             string; without a cap + wrap they render as one
                             screen-wide line. Scoped here because a GLOBAL
                             wrap template would stringify element-content
                             tooltips elsewhere. BasedOn keeps the app's
                             tooltip typography (theme-strip canon). -->
                        <Style TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
                            <Setter Property="MaxWidth" Value="440"/>
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="400"/>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Menu list -->
                    <DockPanel Grid.Column="0">
                        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button AutomationProperties.AutomationId="MenuAddButton" Content="{Binding Common_Add, Source={x:Static strings:Strings.Instance}}" Command="{Binding AddMenuCommand}"
                                    Padding="8,4" Margin="0,0,4,4"/>
                            <Button AutomationProperties.AutomationId="MenuRemoveButton" Content="{Binding Common_Remove, Source={x:Static strings:Strings.Instance}}" Command="{Binding RemoveMenuCommand}"
                                    Padding="8,4" Margin="0,0,4,4"/>
                            <Button Content="{Binding Common_Duplicate, Source={x:Static strings:Strings.Instance}}" Command="{Binding DuplicateMenuCommand}"
                                    Padding="8,4" Margin="0,0,0,4"/>
                        </WrapPanel>

                        <ListBox ItemsSource="{Binding Menus}"
                                 SelectedItem="{Binding SelectedMenu, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource EmberSelectListItem}"
                                 DisplayMemberPath="Name"/>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="4" Margin="4,0"
                                  HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                  ResizeBehavior="PreviousAndNext"/>

                    <!-- Empty state: cold guidance, same shape as Macros. -->
                    <Grid Grid.Column="2">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedMenu}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource FlameOuterGeometry}" Width="34" Height="34" Stretch="Uniform"
                                  Fill="Transparent" StrokeThickness="1.2"
                                  Stroke="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Menu_EmptyHint, Source={x:Static strings:Strings.Instance}}"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300"/>
                        </StackPanel>
                    </Grid>

                    <!-- Menu editor -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="8"
                                  DataContext="{Binding SelectedMenu}"
                                  Visibility="{Binding DataContext.HasSelectedMenu,
                                      RelativeSource={RelativeSource AncestorType=TabItem},
                                      Converter={StaticResource BoolToVisibilityConverter}}">
                        <!-- Every label row shares one auto-sized column (SharedSizeGroup,
                             same device as the pipeline-tip and compact-row grids above).
                             The labels were pinned at Width="200", which fits the English
                             strings and clips or collides with the longer ones: de/pt-BR
                             run ~35% longer than en, and "Touch Menu Activation Style"
                             class strings are already near the limit in English. Auto +
                             SharedSizeGroup sizes the column to the widest label in
                             WHATEVER locale is loaded and keeps every row aligned, with no
                             per-locale numbers to maintain. Fields use MinWidth so they
                             hold the old rhythm but can still grow to their content. -->
                        <StackPanel Grid.IsSharedSizeScope="True">
                            <!-- Name + Enabled -->
                            <TextBlock Text="{Binding Menu_Name, Source={x:Static strings:Strings.Instance}}" FontWeight="SemiBold" Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <!-- Fixed width: a Min/Max auto-sized TextBox in a
                                     left-aligned StackPanel resizes while you type. -->
                                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Width="260" HorizontalAlignment="Left"/>
                                <CheckBox Content="{Binding Menu_Enabled, Source={x:Static strings:Strings.Instance}}"
                                          IsChecked="{Binding Enabled}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Style row. All four setting combos below auto-size to
                                 their WIDEST ITEM and share one width group: MinWidth-only
                                 combos resized to the selected option (column rhythm
                                 broke), and the fixed widths that replaced them clipped
                                 longer locales like Italian and German (owner reports
                                 2026-07-16). The behavior remeasures when a language
                                 switch hands the combo a rebuilt list. -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuEditorLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Menu_Style, Source={x:Static strings:Strings.Instance}}"
                                           ToolTip="{Binding Menu_Style_Tip, Source={x:Static strings:Strings.Instance}}"
                                           Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ComboBox MinWidth="200" ItemsSource="{Binding KindOptions}"
                                              common:ComboBoxWidthBehavior.SizeToItems="True"
                                              common:ComboBoxWidthBehavior.WidthGroup="MenuSettingCombos"
                                              ToolTip="{Binding Menu_Style_Tip, Source={x:Static strings:Strings.Instance}}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding KindIndex, Mode=TwoWay}"/>
                                    <ui:Button Command="{Binding ResetStyleCommand}" Style="{StaticResource ResetButton}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Host input row (Reset + Record per canon) -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuEditorLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Menu_HostInput, Source={x:Static strings:Strings.Instance}}"
                                           ToolTip="{Binding Menu_HostInput_Tip, Source={x:Static strings:Strings.Instance}}"
                                           Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ComboBox MinWidth="200" ItemsSource="{Binding HostOptions}"
                                              common:ComboBoxWidthBehavior.SizeToItems="True"
                                              common:ComboBoxWidthBehavior.WidthGroup="MenuSettingCombos"
                                              ToolTip="{Binding Menu_HostInput_Tip, Source={x:Static strings:Strings.Instance}}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedHost, Mode=TwoWay}"/>
                                    <ui:Button Command="{Binding DataContext.MenuHostRecordCommand,
                                                   RelativeSource={RelativeSource AncestorType=TabItem}}"
                                               Style="{StaticResource EmberIconButtonHot}" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding HostRecordIcon}" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource EmberBrush}"/>
                                    </ui:Button>
                                    <ui:Button Command="{Binding ResetHostCommand}" Style="{StaticResource ResetButton}"/>
                                </StackPanel>
                            </Grid>
                            <!-- Persistent caption: "Opens With" is the PHYSICAL side,
                                 and menus are the one tab where input and output meet,
                                 so users read the stick / touchpad options as the
                                 virtual controller's layout without this (owner report
                                 2026-07-16). -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuEditorLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="{Binding Menu_HostInput_Caption, Source={x:Static strings:Strings.Instance}}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"
                                           Margin="0,2,0,0" FontSize="12"/>
                            </Grid>

                            <!-- Custom opener steer axes (Custom host only): any
                                 recorded axis on any device, which is how joysticks,
                                 wheels, and other non-gamepad devices host menus. -->
                            <Grid Margin="0,0,0,8"
                                  Visibility="{Binding IsCustomHost, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuEditorLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Menu_CustomX, Source={x:Static strings:Strings.Instance}}"
                                           ToolTip="{Binding Menu_CustomAxis_Tip, Source={x:Static strings:Strings.Instance}}"
                                           Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <StackPanel Orientation="Vertical">
                                        <ComboBox MinWidth="260" ItemsSource="{Binding CustomXChoicesView}"
                                                  ToolTip="{Binding Menu_CustomAxis_Tip, Source={x:Static strings:Strings.Instance}}"
                                                  DisplayMemberPath="DisplayName" SelectedValuePath="Descriptor"
                                                  SelectedValue="{Binding CustomXSelected, Mode=TwoWay}">
                                            <ComboBox.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,3,6,3">
                                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ComboBox.GroupStyle>
                                        </ComboBox>
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Margin="4,1,0,0" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding CustomXSubtitle}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CustomXSelected}" Value="">
                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <ui:Button Command="{Binding DataContext.MenuRecordTargetCommand,
                                                   RelativeSource={RelativeSource AncestorType=TabItem}}"
                                               CommandParameter="CustomX"
                                               Style="{StaticResource EmberIconButtonHot}" Margin="6,0,0,0"
                                               VerticalAlignment="Top">
                                        <TextBlock Text="{Binding CustomXRecordIcon}" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource EmberBrush}"/>
                                    </ui:Button>
                                    <ui:Button Command="{Binding ResetCustomXCommand}" Style="{StaticResource ResetButton}" VerticalAlignment="Top"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,8"
                                  Visibility="{Binding IsCustomHost, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuEditorLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Menu_CustomY, Source={x:Static strings:Strings.Instance}}"
                                           ToolTip="{Binding Menu_CustomAxis_Tip, Source={x:Static strings:Strings.Instance}}"
                                           Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <StackPanel Orientation="Vertical">
                                        <ComboBox MinWidth="260" ItemsSource="{Binding CustomYChoicesView}"
                                                  ToolTip="{Binding Menu_CustomAxis_Tip, Source={x:Static strings:Strings.Instance}}"
                                                  DisplayMemberPath="DisplayName" SelectedValuePath="Descriptor"
                                                  SelectedValue="{Binding CustomYSelected, Mode=TwoWay}">
                                            <ComboBox.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,3,6,3">
                                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ComboBox.GroupStyle>
                                        </ComboBox>
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Margin="4,1,0,0" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding CustomYSubtitle}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CustomYSelected}" Value="">
                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <ui:Button Command="{Binding DataContext.MenuRecordTargetCommand,
                                                   RelativeSource={RelativeSource AncestorType=TabItem}}"
                                               CommandParameter="CustomY"
                                               Style="{StaticResource EmberIconButtonHot}" Margin="6,0,0,0"
                                               VerticalAlignment="Top">
                                        <TextBlock Text="{Binding CustomYRecordIcon}" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource EmberBrush}"/>
                                    </ui:Button>
                                    <ui:Button Command="{Binding ResetCustomYCommand}" Style="{StaticResource ResetButton}" VerticalAlignment="Top"/>
                                </StackPanel>
                            </Grid>

                            <!-- Click input: the button On Click / On Click Release
                                 use, assignable on EVERY opener. The old behavior
                                 hard-wired it to the under-stick button, a gamepad
                                 convention joysticks and wheels do not share. -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuEditorLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Menu_ClickInput, Source={x:Static strings:Strings.Instance}}"
                                           ToolTip="{Binding Menu_ClickInput_Tip, Source={x:Static strings:Strings.Instance}}"
                                           Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <StackPanel Orientation="Vertical">
                                        <ComboBox MinWidth="260" ItemsSource="{Binding ClickChoicesView}"
                                                  ToolTip="{Binding Menu_ClickInput_Tip, Source={x:Static strings:Strings.Instance}}"
                                                  DisplayMemberPath="DisplayName" SelectedValuePath="Descriptor"
                                                  SelectedValue="{Binding ClickSelected, Mode=TwoWay}">
                                            <ComboBox.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,3,6,3">
                                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ComboBox.GroupStyle>
                                        </ComboBox>
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Margin="4,1,0,0" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding ClickSubtitle}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ClickSelected}" Value="">
                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <ui:Button Command="{Binding DataContext.MenuRecordTargetCommand,
                                                   RelativeSource={RelativeSource AncestorType=TabItem}}"
                                               CommandParameter="Click"
                                               Style="{StaticResource EmberIconButtonHot}" Margin="6,0,0,0"
                                               VerticalAlignment="Top">
                                        <TextBlock Text="{Binding ClickRecordIcon}" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource EmberBrush}"/>
                                    </ui:Button>
                                    <ui:Button Command="{Binding ResetClickCommand}" Style="{StaticResource ResetButton}" VerticalAlignment="Top"/>
                                </StackPanel>
                            </Grid>

                            <!-- Pad half (touchpad hosts only) -->
                            <Grid Margin="0,0,0,8"
                                  Visibility="{Binding HostIsTouchpad, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuEditorLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Menu_HostHalf, Source={x:Static strings:Strings.Instance}}"
                                           ToolTip="{Binding Menu_HostHalf_Tip, Source={x:Static strings:Strings.Instance}}"
                                           Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ComboBox MinWidth="200" ItemsSource="{Binding HostHalfOptions}"
                                              common:ComboBoxWidthBehavior.SizeToItems="True"
                                              common:ComboBoxWidthBehavior.WidthGroup="MenuSettingCombos"
                                              ToolTip="{Binding Menu_HostHalf_Tip, Source={x:Static strings:Strings.Instance}}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding HostHalfIndex, Mode=TwoWay}"/>
                                    <ui:Button Command="{Binding ResetHostHalfCommand}" Style="{StaticResource ResetButton}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Fire mode -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuEditorLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Menu_FireMode, Source={x:Static strings:Strings.Instance}}"
                                           ToolTip="{Binding Menu_FireMode_Tip, Source={x:Static strings:Strings.Instance}}"
                                           Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ComboBox MinWidth="200" ItemsSource="{Binding FireOptions}"
                                              common:ComboBoxWidthBehavior.SizeToItems="True"
                                              common:ComboBoxWidthBehavior.WidthGroup="MenuSettingCombos"
                                              ToolTip="{Binding Menu_FireMode_Tip, Source={x:Static strings:Strings.Instance}}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding FireTypeIndex, Mode=TwoWay}">
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                                <Setter Property="ToolTip" Value="{Binding Description}"/>
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                    </ComboBox>
                                    <ui:Button Command="{Binding ResetFireCommand}" Style="{StaticResource ResetButton}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <!-- Persistent caption for the selected fire mode. A tooltip
                                 alone failed its one field test: "On Click" reads as
                                 self-explanatory while actually requiring a stick or
                                 trackpad CLICK, and the user walked straight past it. -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuEditorLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedFireDescription}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"
                                           Margin="0,2,0,0" FontSize="12"/>
                            </Grid>

                            <!-- Cells + center -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuEditorLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Menu_Cells, Source={x:Static strings:Strings.Instance}}"
                                           ToolTip="{Binding Menu_Cells_Tip, Source={x:Static strings:Strings.Instance}}"
                                           Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <!-- 200, the app's proven NumberBox width (Dashboard port
                                         boxes): the inline spin buttons PLUS the clear X that
                                         appears on focus consume ~100px of chrome, so 120 left
                                         the value cramped the moment the box was clicked
                                         (owner report 2026-07-16). Applies to every NumberBox
                                         on this tab. -->
                                    <ui:NumberBox Width="200" Minimum="1" Maximum="20" SmallChange="1"
                                                  ToolTip="{Binding Menu_Cells_Tip, Source={x:Static strings:Strings.Instance}}"
                                                  Value="{Binding CellCount, Mode=TwoWay}"/>
                                    <CheckBox Content="{Binding Menu_HasCenter, Source={x:Static strings:Strings.Instance}}"
                                              ToolTip="{Binding Menu_HasCenter_Tip, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding HasCenter}" Margin="12,0,0,0" VerticalAlignment="Center"
                                              Visibility="{Binding IsRadial, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <ui:Button Command="{Binding ResetCellsCommand}" Style="{StaticResource ResetButton}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Engage deadzone -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuEditorLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Menu_Deadzone, Source={x:Static strings:Strings.Instance}}"
                                           ToolTip="{Binding Menu_Deadzone_Tip, Source={x:Static strings:Strings.Instance}}"
                                           Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Slider Width="160" Minimum="1" Maximum="95"
                                            ToolTip="{Binding Menu_Deadzone_Tip, Source={x:Static strings:Strings.Instance}}"
                                            Value="{Binding EngageDeadzonePercent, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <ui:NumberBox Width="200" Minimum="1" Maximum="95" SmallChange="1" Margin="8,0,0,0"
                                                  Value="{Binding EngageDeadzonePercent, Mode=TwoWay}"/>
                                    <ui:Button Command="{Binding ResetDeadzoneCommand}" Style="{StaticResource ResetButton}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Overlay geometry card -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,4,0,12" Padding="12">
                                <!-- Own shared-size scope: this card's labels align with each
                                     other, not with the wider editor rows outside it. -->
                                <StackPanel Grid.IsSharedSizeScope="True">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Dashboard_MenuOverlay, Source={x:Static strings:Strings.Instance}}"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <ui:Button Command="{Binding ResetGeometryCommand}" Style="{StaticResource ResetButton}" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <CheckBox Content="{Binding Menu_ShowLabels, Source={x:Static strings:Strings.Instance}}"
                                              ToolTip="{Binding Menu_ShowLabels_Tip, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding ShowLabels}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGeometryLabel"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding Menu_Position, Source={x:Static strings:Strings.Instance}}"
                                                   ToolTip="{Binding Menu_Position_Tip, Source={x:Static strings:Strings.Instance}}"
                                                   Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="240"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    ToolTip="{Binding Menu_Position_Tip, Source={x:Static strings:Strings.Instance}}">
                                            <ui:NumberBox Width="200" Minimum="0" Maximum="100" SmallChange="5"
                                                          Value="{Binding PosXPercent, Mode=TwoWay}"/>
                                            <ui:NumberBox Width="200" Minimum="0" Maximum="100" SmallChange="5" Margin="8,0,0,0"
                                                          Value="{Binding PosYPercent, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGeometryLabel"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding Menu_Scale, Source={x:Static strings:Strings.Instance}}"
                                                   ToolTip="{Binding Menu_Scale_Tip, Source={x:Static strings:Strings.Instance}}"
                                                   Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="240"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <ui:NumberBox Width="200" Minimum="10" Maximum="400" SmallChange="10"
                                                          ToolTip="{Binding Menu_Scale_Tip, Source={x:Static strings:Strings.Instance}}"
                                                          Value="{Binding ScalePercent, Mode=TwoWay}"/>
                                            <TextBlock Text="%" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGeometryLabel"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding Menu_Opacity, Source={x:Static strings:Strings.Instance}}"
                                                   ToolTip="{Binding Menu_Opacity_Tip, Source={x:Static strings:Strings.Instance}}"
                                                   Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="240"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <ui:NumberBox Width="200" Minimum="5" Maximum="100" SmallChange="5"
                                                          ToolTip="{Binding Menu_Opacity_Tip, Source={x:Static strings:Strings.Instance}}"
                                                          Value="{Binding OpacityPercent, Mode=TwoWay}"/>
                                            <TextBlock Text="%" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Cell bindings -->
                            <TextBlock Text="{Binding Menu_CellBindings, Source={x:Static strings:Strings.Instance}}"
                                       FontWeight="SemiBold" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <!-- Cell rows share their own auto column for the "Center"/"Item N"
                                 header (Menu_CellCenter is a word, not a number, and is longer
                                 than 72px in several locales). The pickers keep their rhythm
                                 through MinWidth but can widen for long key / button names. -->
                            <ItemsControl ItemsSource="{Binding Cells}" Grid.IsSharedSizeScope="True">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuCellHeader"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Header}" VerticalAlignment="Center"
                                                       Margin="0,0,8,0" TextWrapping="Wrap" MaxWidth="160"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <!-- Imported Steam icon indicator (translator v21):
                                                     the resolved local-Steam glyph, or the picture
                                                     placeholder when the art is not on this
                                                     machine. Indicator only, the reset button
                                                     clears it with the rest of the cell. -->
                                                <Image Width="16" Height="16" Margin="0,0,6,0"
                                                       VerticalAlignment="Center"
                                                       Source="{Binding IconImage}"
                                                       ToolTip="{Binding IconName}"
                                                       Visibility="{Binding IconImage, Converter={StaticResource NullToCollapsedConverter}}"/>
                                                <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14" Margin="0,0,6,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           ToolTip="{Binding IconName}"
                                                           Visibility="{Binding ShowIconGlyph, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <!-- Pickers auto-size to their widest ITEM, one
                                                     width group per column, so rows stay in
                                                     column across selections AND long locales
                                                     never clip (fixed widths clipped Italian /
                                                     German option names). -->
                                                <TextBox Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Width="160"
                                                         ToolTip="{Binding Menu_CellLabel_Tip, Source={x:Static strings:Strings.Instance}}"/>
                                                <ComboBox MinWidth="140" Margin="8,0,0,0"
                                                          common:ComboBoxWidthBehavior.SizeToItems="True"
                                                          common:ComboBoxWidthBehavior.WidthGroup="MenuCellKindCombos"
                                                          ToolTip="{Binding Menu_BindingKind_Tip, Source={x:Static strings:Strings.Instance}}"
                                                          ItemsSource="{Binding BindingKindOptions}"
                                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                                          SelectedValue="{Binding BindingKind, Mode=TwoWay}"/>
                                                <ComboBox MinWidth="140" Margin="8,0,0,0"
                                                          common:ComboBoxWidthBehavior.SizeToItems="True"
                                                          common:ComboBoxWidthBehavior.WidthGroup="MenuCellKeyCombos"
                                                          ItemsSource="{Binding KeyOptions}"
                                                          DisplayMemberPath="Label" SelectedValuePath="Vk"
                                                          SelectedValue="{Binding SelectedKeyVk, Mode=TwoWay}"
                                                          Visibility="{Binding ShowKeyPicker, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <ComboBox MinWidth="140" Margin="8,0,0,0"
                                                          common:ComboBoxWidthBehavior.SizeToItems="True"
                                                          common:ComboBoxWidthBehavior.WidthGroup="MenuCellButtonCombos"
                                                          ItemsSource="{Binding ButtonOptions}"
                                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                                          SelectedValue="{Binding SelectedButtonFlag, Mode=TwoWay}"
                                                          Visibility="{Binding ShowButtonPicker, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <ui:Button Command="{Binding ResetCellCommand}" Style="{StaticResource ResetButton}" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- === TAB 16: Bass Shakers (slot-level, issue #236 rumble to audio) === -->
            <TabItem>
                <ScrollViewer Padding="24,0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE7F5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Pad_RumbleAudio_Header, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource TitleTextBlockStyle}" FontFamily="{StaticResource DisplayFontFamily}" FontWeight="650" FontSize="26"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Pad_RumbleAudio_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- Rumble to Audio card -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE877;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_RumbleAudio_Card_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding ResetRumbleAudioAllCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_RumbleAudio_ResetCard_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Pad_RumbleAudio_Card_Desc, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}"/>

                                <!-- Enable row. First enable authors the config with the
                                     four default voices; disable keeps every setting. -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsChecked="{Binding RumbleAudioEnabled, Mode=TwoWay}"
                                              Content="{Binding Pad_RumbleAudio_Enable, Source={x:Static strings:Strings.Instance}}"
                                              ToolTip="{Binding Pad_RumbleAudio_Enable_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                              VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetRumbleAudioEnabledCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_RumbleAudio_ResetEnable, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <StackPanel IsEnabled="{Binding RumbleAudioEnabled}">
                                    <!-- Output Device row. "" = system default; a configured
                                         endpoint that disappears FAILS CLOSED (status line
                                         below warns, selection is preserved). -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Pad_RumbleAudio_OutputDevice, Source={x:Static strings:Strings.Instance}}"
                                                   Style="{StaticResource DzLabel}"
                                                   ToolTip="{Binding Pad_RumbleAudio_OutputDevice_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <!-- SelectedValuePath/DisplayMemberPath MUST precede the
                                             ItemsSource/SelectedValue bindings: XAML applies
                                             attributes in order, and a SelectedValue that attaches
                                             before SelectedValuePath is set fails to resolve and
                                             never retries (the mirror-source picker documents it). -->
                                        <ComboBox SelectedValuePath="Id" DisplayMemberPath="Name"
                                                  ItemsSource="{Binding RumbleAudioEndpointOptions}"
                                                  SelectedValue="{Binding RumbleAudioEndpointId, Mode=TwoWay}"
                                                  MinWidth="260" MaxWidth="380"
                                                  DropDownOpened="RumbleAudioEndpoint_DropDownOpened"
                                                  ToolTip="{Binding Pad_RumbleAudio_OutputDevice_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <ui:Button Command="{Binding ResetRumbleAudioEndpointCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_RumbleAudio_ResetOutputDevice, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                    <!-- Live endpoint status, driven by the code-behind meter
                                         timer from RumbleAudioService.GetSlotStatus. -->
                                    <TextBlock x:Name="BassShakerStatusText" FontSize="12" TextWrapping="Wrap"
                                               Margin="270,0,0,2"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Pad_RumbleAudio_BluetoothHint, Source={x:Static strings:Strings.Instance}}"
                                               FontSize="12" TextWrapping="Wrap" Margin="270,0,0,8"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>

                                    <!-- Channel Mode row -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Pad_RumbleAudio_ChannelMode, Source={x:Static strings:Strings.Instance}}"
                                                   Style="{StaticResource DzLabel}"
                                                   ToolTip="{Binding Pad_RumbleAudio_ChannelMode_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBox SelectedValuePath="Tag"
                                                  SelectedValue="{Binding RumbleAudioChannelMode, Mode=TwoWay}"
                                                  MinWidth="260"
                                                  ToolTip="{Binding Pad_RumbleAudio_ChannelMode_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                            <ComboBoxItem Content="{Binding Pad_RumbleAudio_Mode_Mono, Source={x:Static strings:Strings.Instance}}" Tag=""/>
                                            <ComboBoxItem Content="{Binding Pad_RumbleAudio_Mode_Stereo, Source={x:Static strings:Strings.Instance}}" Tag="Stereo"/>
                                        </ComboBox>
                                        <ui:Button Command="{Binding ResetRumbleAudioChannelModeCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_RumbleAudio_ResetChannelMode, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>

                                    <!-- Master Gain row -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Pad_RumbleAudio_MasterGain, Source={x:Static strings:Strings.Instance}}"
                                                   Style="{StaticResource DzLabel}"
                                                   ToolTip="{Binding Pad_RumbleAudio_MasterGain_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <Slider Value="{Binding RumbleAudioMasterGain, Mode=TwoWay}" Minimum="0" Maximum="100"
                                                Style="{StaticResource DzSlider}" TickFrequency="1"/>
                                        <TextBox Text="{Binding RumbleAudioMasterGain, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding ResetRumbleAudioMasterGainCommand}" Style="{StaticResource ResetButton}"
                                                ToolTip="{Binding Pad_RumbleAudio_ResetMasterGain, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>

                                    <!-- The four fixed voice rows (low, high, trigger left,
                                         trigger right): enable + carrier frequency + gain +
                                         live meter + per-row Test and Reset. -->
                                    <ItemsControl ItemsSource="{Binding RumbleAudioVoices}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                              Content="{Binding Label}"
                                                              Width="270" VerticalAlignment="Center"
                                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                              ToolTip="{Binding Pad_RumbleAudio_VoiceEnable_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                    <Slider Value="{Binding FrequencyHz, Mode=TwoWay}" Minimum="20" Maximum="120"
                                                            Width="140" VerticalAlignment="Center"
                                                            IsSnapToTickEnabled="True" TickFrequency="1"
                                                            ToolTip="{Binding Pad_RumbleAudio_Frequency_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                    <TextBox Text="{Binding FrequencyHz, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             Style="{StaticResource DzValueEdit}"
                                                             ToolTip="{Binding Pad_RumbleAudio_Frequency_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                    <TextBlock Text="Hz" Style="{StaticResource DzPercent}"/>
                                                    <Slider Value="{Binding GainPercent, Mode=TwoWay}" Minimum="0" Maximum="100"
                                                            Width="140" VerticalAlignment="Center" Margin="12,0,0,0"
                                                            IsSnapToTickEnabled="True" TickFrequency="1"
                                                            ToolTip="{Binding Pad_RumbleAudio_Gain_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                    <TextBox Text="{Binding GainPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             Style="{StaticResource DzValueEdit}"
                                                             ToolTip="{Binding Pad_RumbleAudio_Gain_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                    <ProgressBar Value="{Binding MeterLevel, Mode=OneWay}"
                                                                 Minimum="0" Maximum="100"
                                                                 Width="80" Height="8" VerticalAlignment="Center" Margin="12,0,0,0"
                                                                 Foreground="{DynamicResource EmberHotBrush}"/>
                                                    <Button Content="{Binding Pad_RumbleAudio_Test, Source={x:Static strings:Strings.Instance}}"
                                                            Command="{Binding TestCommand}" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                                            ToolTip="{Binding Pad_RumbleAudio_Test_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                    <ui:Button Command="{Binding ResetCommand}" Style="{StaticResource ResetButton}"
                                                            ToolTip="{Binding ResetTooltip}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Test buttons row -->
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="{Binding Pad_RumbleAudio_Sweep, Source={x:Static strings:Strings.Instance}}"
                                                Command="{Binding RumbleAudioSweepCommand}" Padding="10,4" VerticalAlignment="Center"
                                                ToolTip="{Binding Pad_RumbleAudio_Sweep_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <Button Content="{Binding Pad_RumbleAudio_StopTest, Source={x:Static strings:Strings.Instance}}"
                                                Command="{Binding RumbleAudioStopTestCommand}" Padding="10,4" Margin="6,0,0,0" VerticalAlignment="Center"
                                                ToolTip="{Binding Pad_RumbleAudio_StopTest_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
