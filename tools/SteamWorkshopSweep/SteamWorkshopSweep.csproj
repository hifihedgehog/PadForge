<Project Sdk="Microsoft.NET.Sdk">

  <!-- Mass wild-corpus regression sweep for the Workshop config translator.
       Standalone (not in PadForge.sln), same as SteamWorkshopSmoke. Harvests the
       live top-by-vote configs for every game in games.csv over the anonymous
       QueryFiles client, caches the VDFs (gitignored), commits a manifest of ids
       and hashes, translates everything, and reports every report line whose
       reason key is outside the lockdown-approved set. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>SteamWorkshopSweep</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PadForge.SteamWorkshop\PadForge.SteamWorkshop.csproj" />
  </ItemGroup>

  <!-- Single sources of truth shared with the test suite: the
       lockdown-approved reason set and the manifest DTO. -->
  <ItemGroup>
    <Compile Include="..\..\PadForge.SteamWorkshop.Tests\ApprovedReasonLockdown.cs" Link="ApprovedReasonLockdown.cs" />
    <Compile Include="..\..\PadForge.SteamWorkshop.Tests\SweepManifest.cs" Link="SweepManifest.cs" />
  </ItemGroup>

</Project>
