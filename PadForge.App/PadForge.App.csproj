<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <WindowsSdkPackageVersion>10.0.26100.57</WindowsSdkPackageVersion>
    <RootNamespace>PadForge</RootNamespace>
    <AssemblyName>PadForge</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!--
      CA1416: emitted by the auto-generated WPF temp project (*_wpftmp.csproj)
      because that intermediate doesn't inherit TargetPlatformVersion from
      this csproj. The main project already targets net10.0-windows10.0.26100.0
      which satisfies the API platform requirements.

      WFO0003: WinForms migration recommendation to move HighDPI from the
      manifest to <ApplicationHighDpiMode> / Application.SetHighDpiMode. This
      app is WPF-primary with WinForms enabled only for NotifyIcon; WPF reads
      DPI awareness from the manifest, so the manifest is the right place.
    -->
    <NoWarn>$(NoWarn);CA1416;WFO0003</NoWarn>

    <Product>PadForge</Product>
    <Company>PadForge</Company>
    <Copyright>Copyright © PadForge Contributors</Copyright>
    <Description>PadForge — Modern controller mapping application.</Description>
    <ApplicationIcon>Resources\PadForge.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Single-file portable publish: dotnet publish -c Release
       That builds win-x64, which stays the default so every existing command,
       script and CI step keeps producing exactly what it always has. ARM64 is
       the same command with -r win-arm64. -->
  <PropertyGroup>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <!-- The folder name the native libraries for this build live under. Every
         architecture-specific Content item below is keyed on it, so adding an
         architecture is a matter of dropping its DLL into the matching folder
         and nothing else in this file. -->
    <NativeArch Condition="'$(RuntimeIdentifier)' == 'win-arm64'">arm64</NativeArch>
    <NativeArch Condition="'$(NativeArch)' == ''">x64</NativeArch>
    <!-- CS8012 on the ARM64 build only, and only because it is a false alarm
         there. Microsoft.Windows.Devices.Midi2 stamps its COMPILE-TIME
         reference (ref\net10.0) as x64 where a reference assembly should be
         neutral, so compiling for ARM64 reports a processor mismatch. What is
         DEPLOYED is the package's runtimes\win-arm64 copy, which is a real
         ARM64 image: checked by reading the PE machine field of all three
         copies and of the DLL in the win-arm64 output. The x64 build never
         raises it, so it stays visible there if it ever starts meaning
         something. -->
    <NoWarn Condition="'$(NativeArch)' == 'arm64'">$(NoWarn);CS8012</NoWarn>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- MUST stay true: bundles WPF's native libs (wpfgfx_cor3, PresentationNative_cor3,
         PenImc_cor3, D3DCompiler_47_cor3, vcruntime140_cor3) INTO the single exe. Setting
         false scatters them as loose files next to the exe, breaking the portable-single-
         exe model and the "copy only PadForge.exe" deploy. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Remove WinForms implicit usings to avoid ambiguity with WPF types. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\PadForge.ico" />
    <Resource Include="Resources\PadForge-logo.png" />
    <Resource Include="Resources\PadForge-icon.png" />
    <!--
      SDL3.dll: Link="SDL3.dll" ensures the file is copied to the OUTPUT ROOT
      (next to PadForge.exe) rather than preserving the Resources\SDL3\<arch>\ subdirectory.
      It is built from the PadForge SDL fork, never the upstream release, because
      the fork carries the HIDMaestro filter, the Switch 2 Pro driver and the PS5
      status bytes. $(NativeArch) picks the x64 or arm64 folder for this build.
      Condition checks for existence so the build succeeds before the DLL is placed.
      That silence is closed off by RequireBundledNatives at the bottom of this
      file, which refuses a publish that lacks it, for either architecture.
    -->
    <Content Include="Resources\SDL3\$(NativeArch)\SDL3.dll" Link="SDL3.dll" Condition="Exists('Resources\SDL3\$(NativeArch)\SDL3.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\SDL3\$(NativeArch)\libusb-1.0.dll" Link="libusb-1.0.dll" Condition="Exists('Resources\SDL3\$(NativeArch)\libusb-1.0.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- SDL's C++ runtime dependencies share the native extraction directory.
         Bundle the redistributable files so no separate runtime install is needed.
         msvcp140.dll is bundled for both architectures, because both
         SDL3.dll files import it for the Elite paddle reader, which is C++.
         The ARM64 SDL3.dll delivered for 4.5.1 had that reader switched off
         and imported vcruntime140.dll alone, so the ARM64 folder went
         without msvcp140.dll until the fork built the reader for ARM64 (SDL
         fork a1416320e2). BundledSdlRuntimeImportsTests reads each SDL3.dll
         for the runtime DLLs it names and fails when one is not in that
         architecture's folder, which is how the ARM64 file came to be added.
         The item carries no Exists condition, like vcruntime140.dll below
         it. With one, a missing file was left out in silence and the publish
         went through with an SDL3.dll that cannot load on a clean machine.
         Without one, the build stops and names the file. -->
    <Content Include="Resources\VisualCpp\$(NativeArch)\msvcp140.dll" Link="msvcp140.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\VisualCpp\$(NativeArch)\vcruntime140.dll" Link="vcruntime140.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- x64 only. vcruntime140_1.dll holds __CxxFrameHandler4, which exists
         for the x64 ABI alone, and native ARM64 code never imports it: ARM64
         keeps that handler inside vcruntime140.dll. Microsoft's own ARM64
         redist folder does carry a file by this name, and it is an x64 image
         put there for emulated x64 code. Copying it into the ARM64 build
         would ship an x64 DLL nothing in that process can load. -->
    <Content Include="Resources\VisualCpp\x64\vcruntime140_1.dll" Link="vcruntime140_1.dll" Condition="'$(NativeArch)' == 'x64'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      OpenXInput-derived xinput1_4.dll replaces the system one via DLL search order
      (application directory before System32 for non-KnownDLLs).  When SDL3 calls
      LoadLibrary("xinput1_4.dll"), this local copy resolves first and SDL's XInput
      backend uses it instead of Microsoft's.  Forked from Nemirtingas/OpenXInput
      with a HIDMaestro classifier added to the enumeration step so HM virtuals
      are skipped during slot assignment.

      Do NOT also bundle devobj.dll here.  OpenXInput's source tree contains a
      stub devobj.dll (every export returns 0xCDCDCDCD) to satisfy xinput1_4's
      static-link import at compile time.  If we ship that stub alongside,
      SetDllDirectory pre-empts C:\Windows\System32\devobj.dll for the whole
      process — including system setupapi.dll's own DevObj* imports — and
      setupapi crashes during HID class enumeration on systems where the
      hijack succeeds.  See PadForge #69 and memory/openxinput-devobj-stub-hijack-bug.md.
      xinput1_4.dll's devobj.dll import resolves from System32 unaided.
    -->
    <!-- Interhaptics engine + Razer Sensa provider (#374): the same pair
         every Unity title embedding Razer's public Interhaptics Core SDK
         redistributes, vendored from WyvrnOfficial/Interhaptics_Unity_CoreSDK
         Runtime/Plugins/x64. P/Invoked lazily by SensaHapticsService, so a
         missing pair degrades to a diag line, never a crash. -->
    <Content Include="Resources\Interhaptics\$(NativeArch)\HAR.dll" Link="HAR.dll" Condition="Exists('Resources\Interhaptics\$(NativeArch)\HAR.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Interhaptics\$(NativeArch)\Interhaptics.RazerProvider.dll" Link="Interhaptics.RazerProvider.dll" Condition="Exists('Resources\Interhaptics\$(NativeArch)\Interhaptics.RazerProvider.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\OpenXInput\$(NativeArch)\xinput1_4.dll" Link="xinput1_4.dll" Condition="Exists('Resources\OpenXInput\$(NativeArch)\xinput1_4.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- libvosk for the ARM64 build. The x64 build gets its libvosk.dll from
         the Vosk package's own targets, which carry nothing for ARM64. See
         DropX64OnlyNativesOnArm64 near the bottom of this file. -->
    <Content Include="Resources\Vosk\arm64\libvosk.dll" Link="libvosk.dll" Condition="'$(NativeArch)' == 'arm64' And Exists('Resources\Vosk\arm64\libvosk.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="gamecontrollerdb_padforge.txt" />
    <EmbeddedResource Include="..\LICENSE" LogicalName="PadForge.ThirdPartyNotices.txt" />
    <!-- The x64 HidHide setup, for x64 machines. Only the x64 build can run
         on one, so only the x64 build carries its 7.7 MB. -->
    <EmbeddedResource Include="Resources\HidHide_1.5.230_x64.exe" Condition="'$(NativeArch)' == 'x64'" />
    <!-- HidHide for ARM64 machines, in BOTH builds, because the x64 build
         also runs on ARM64 Windows and a kernel driver follows the machine.
         Upstream's setup is x64 only (nefarius/HidHide#57), and upstream
         publishes the Microsoft-signed ARM64 driver by itself with a
         documented manual install. HidHideArm64Installer performs it.
           HidHide_ARM64.zip  github.com/nefarius/HidHide drivers/ at fb5615c0,
                              driver 1.6.280.0, byte for byte as published
           nefconc.exe        nefcon v1.20.0, the ARM64 console build, the
                              tool upstream's own installer drives
         Both are pinned by hash in HidHideArm64InstallerTests. -->
    <EmbeddedResource Include="Resources\HidHideArm64\HidHide_ARM64.zip" />
    <EmbeddedResource Include="Resources\HidHideArm64\nefconc.exe" />
    <!-- 3D controller model assets (adapted from Handheld Companion, CC BY-NC-SA 4.0;
         Switch2Pro set split from the purchased hado CGTrader model) -->
    <!-- Meshes and transparent atlases are packed by the EmbedPackedArt target
         below. The opaque atlases are JPEG, which is already compressed. -->
    <EmbeddedResource Include="3DModels\**\*.jpg" />
    <!-- 2D controller model assets (Gamepad-Asset-Pack by AL2009man, MIT license) -->
    <Resource Include="2DModels\**\*.png" />
    <!-- Web controller frontend assets (embedded, served by WebControllerServer) -->
    <EmbeddedResource Include="WebAssets\**\*" />
    <!-- Offline voice recognition (#317). The model ships INSIDE the exe.
         It used to download on first use, which made voice macros unusable
         on a machine with no internet and wrote 68 MB into LocalAppData,
         neither of which was ever asked for. Packed by EmbedPackedArt below,
         which gets it to 35 MB. -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.11" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="HelixToolkit.Core.Wpf" Version="2.27.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Windows.Devices.Midi2" Version="1.0.16-rc.3.7" />
    <!-- C#/WinRT generates the projection for the in-box Windows MIDI
         Services API (Windows.Devices.Midi2) from the metadata in
         Resources\WinMD, the way Microsoft's own C# samples build it. 2.2.0
         matches the WinRT.Runtime the Windows SDK projection already ships
         (2.2.0.0), which the rc.3.7 projection also references. -->
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Speech" Version="10.0.0" />
    <!-- Vosk (Apache-2.0, Alpha Cephei): modern offline recognizer for voice
         macros. Phrase-list grammar with an [unk] bucket, so non-phrase audio
         decodes as unknown instead of force-matching the nearest phrase. -->
    <PackageReference Include="Vosk" Version="0.3.38" />
    <!-- Opus encoder (pure C#) for the DualSense Bluetooth speaker stream -->
    <PackageReference Include="Concentus" Version="2.2.2" />
    <!-- Driver-store install, class filters, and USB CyclePort for the BthPS3
         DualShock 3 Bluetooth stack (nefarius, same lib BthPS3's own installer uses) -->
    <PackageReference Include="Nefarius.Utilities.DeviceManagement" Version="6.1.0" />
  </ItemGroup>

  <!-- The in-box Windows MIDI Services API ships in Windows 11 25H2 (build
       26200) from the late-November 2026 update, and the Windows SDK does not
       carry its metadata yet. Resources\WinMD\Windows.Devices.Midi2.winmd is
       the metadata from Microsoft's Windows.Devices.Midi2 0.99.88-preview.10
       package (microsoft/MIDI release inbox-preview-10, MIT): package SHA-256
       6daf121a3f76a4a1e0d46521c5072ac576477448c9332048383bb58960a4ce69, this
       file SHA-256 497d9e7c2fb219388f748c585d7aad537d3a6a576de854bd16bfe1bc73f8d9a9.
       Only the metadata is taken. The package's own implementation DLLs are
       never referenced: at run time PadForge uses the copy Windows installs
       in System32, or none. Replace this with the Windows SDK's metadata once
       an SDK carries it. -->
  <PropertyGroup>
    <CsWinRTIncludes>Windows.Devices.Midi2</CsWinRTIncludes>
  </PropertyGroup>
  <ItemGroup>
    <CsWinRTInputs Include="Resources\WinMD\Windows.Devices.Midi2.winmd" />
  </ItemGroup>

  <!-- Microsoft-signed BthPS3 + BthPS3PSM drivers (nefarius release) and the DS3
       WinUSB INF, embedded so the single-file app can drop them to a temp dir and
       install them at pairing time. No MSI, no external installer. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\BthPS3\**\*.*">
      <LogicalName>BthPS3.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Shared AssemblyVersion + AssemblyFileVersion — single source of truth
         across PadForge.App and PadForge.Engine. -->
    <Compile Include="..\SharedVersion.cs" Link="Properties\SharedVersion.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PadForge.Engine\PadForge.Engine.csproj" />
    <!-- Steam Workshop community-config import (#9): anonymous Steam clients,
         VDF parser, typed Steam Input model, translator, cache. -->
    <ProjectReference Include="..\PadForge.SteamWorkshop\PadForge.SteamWorkshop.csproj" />
    <!-- HIDMaestro SDK, pre-built release DLL, NOT a ProjectReference.
         Using a ProjectReference would build from source and pick up
         unstable in-progress work from the HIDMaestro repo. Update by
         copying the Release build of HIDMaestro.Core.dll from the
         HIDMaestro repo into Resources\HIDMaestro\ after tagging a
         release there. Current: v1.9.2, which moves the USB/IP
         transport to usbip-win2 0.9.8.1, the first release with the fix
         for the attach work item that blocked driver unload. The x64
         installer is the release asset, and the ARM64 one is the same
         tag's build from the project's signing service. A machine on
         0.9.7.7 or 0.9.7.5 moves to 0.9.8.1 by one driver update, only
         in a Windows session where the host controller has carried no
         device yet, and a usbip-win2 another program installed is left
         alone. The client now speaks the 0.9.7.x, 0.9.8.0 and 0.9.8.1
         request formats and asks the driver which it has, so a 0.9.8.0
         that Handheld Companion installed gets an attach request in its
         own format. HIDMaestro checked those two formats against each
         version's compiled header, not yet against a live driver.
         v1.9.1 before it catalogs the ARM64 driver with 10_RS3_ARM64
         (HM#63): v1.9.0 asked Inf2Cat for 10_ARM64, which Inf2Cat
         refuses, so the ARM64 install stopped before the driver reached
         the store. It also
         answers the Steam Controller (2026) persona's firmware build
         with the one Steam's own updater names, so Steam stops offering
         it an update it can never take (HM#62).
         v1.9.0 before that built and embedded an ARM64 driver payload
         beside the x64 one.
         v1.8.1 before it corrected the XUSB battery reply, which packed
         its fields one byte early, so every virtual Xbox pad read as the
         lowest battery level (HM#61, PadForge #447).
         v1.8.0 before that (HM#60) gave every
         virtual controller a durable identity: the device paths, the
         container id and the USB serial of the composite personas derive
         from an identity key PadForge passes per slot, so a pad comes
         back at the same paths after a restart, a reboot or a driver
         upgrade and a program that stored a binding against the path
         keeps it (#395, ChasePlane).
         v1.7.3 before it gave all four native
         binaries a version resource. They had none: no CompanyName, no
         ProductName, no FileDescription. Unsigned on disk (the SDK
         Authenticode-signs the driver at install time, not at build time)
         and at the install prevalence of a freshly built file, that is
         close to a worked example of what an antivirus machine-learning
         model distrusts, and Defender called HIDMaestro.dll
         Trojan:Win32/Bearfoos.A!ml on 2026-09-02. The !ml suffix marks a
         machine-learning verdict rather than a signature match, so
         clearing one hash would not have helped: every rebuild mints a
         new one. Whether it changes the verdict is unconfirmed, since the
         machine that raised it has an allow in place and the old binary
         scans clean there too, so there is no honest before-and-after
         available. The three binaries PadForge carries embedded read
         1.7.3.0 with company, product and description set, against
         nothing at all in 1.7.2, which is what 4.4.0 shipped.
         v1.7.2 before it gave the Xbox 360 family one WGI gamepad
         (HM#59), where the devnode restart rather than the dedup property
         turned out to be the operative leg.
         v1.7.1 before that landed the Triton raw path on its own report
         instead of the lizard mouse (HM#58): a profile that declares an
         input report id and is always armed emits verbatim, and
         SubmitRawExtendedReport is the explicit form of that. It also
         corrected the 2026 pad's rear-button pairing to SDL's (R4 is
         paddle 1, R5 is paddle 2) and throws at profile load on a button
         name that resolves to nothing, instead of dropping the bit in
         silence.
         Earlier and still carried: composite USB personas with embedded
         usbip-win2 and the HMController.UsbAudio surface, HM#39, the
         microphone ring frame-alignment fix, HM#41, and the ROOT\HIDMAESTRO_UDE
         hardware-id token on the emulated host controller, HM#42, which is what
         lets a devnode filter tell a composite persona from a real USB pad. -->
    <Reference Include="HIDMaestro.Core">
      <HintPath>Resources\HIDMaestro\HIDMaestro.Core.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Meshes and transparent atlases are packed here rather than left to the
       single-file bundle, and the reader unpacks them. Artists keep ordinary
       .obj and .png files in the tree.

       Meshes are ASCII Wavefront text, which the bundle deflates to 49.2 MB
       and Brotli takes to 32.4 MB.

       An atlas needs one step before Brotli can help. Its pixels are already
       a deflate stream, and compressing a compressed stream gains about two
       percent, so the data is inflated and written back with deflate's
       stored blocks first. That leaves an ordinary PNG carrying raw pixels,
       which Brotli then takes a third off. Nothing decodes the result except
       WPF, which receives a normal PNG.

       Packing is the slow part, minutes for the full set at the level that
       earns the size, so output older than its input is the only thing
       repacked. Art changes rarely, so this costs one build and then
       nothing. -->
  <UsingTask TaskName="PackAssets" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Assets ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputDir ParameterType="System.String" Required="true" />
      <!-- This project file. The packing code lives inside it, so its own
           timestamp is what says whether a cached output is still current. -->
      <PackerFile ParameterType="System.String" Required="true" />
      <Packed ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Diagnostics" />
      <Using Namespace="System.IO.Compression" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Threading" />
      <Using Namespace="System.Threading.Tasks" />
      <Using Namespace="Microsoft.Build.Framework" />
      <Using Namespace="Microsoft.Build.Utilities" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // BrotliStream is reached by reflection because an inline task
        // compiles against netstandard, which predates it. The task itself
        // runs on the SDK's own runtime, where the type is present. Which
        // assembly holds it has moved between releases, so both names are
        // tried rather than one being assumed.
        Type streamType = null, levelType = null;
        foreach (var candidate in new[] { "System.IO.Compression.Brotli", "System.IO.Compression" })
        {
            try
            {
                var asm = System.Reflection.Assembly.Load(candidate);
                streamType = streamType ?? asm.GetType("System.IO.Compression.BrotliStream");
                levelType = levelType ?? asm.GetType("System.IO.Compression.CompressionLevel");
            }
            catch (Exception) { }
        }
        if (streamType == null || levelType == null)
        {
            // Brotli arrived in .NET Core. An inline task runs inside the
            // MSBuild process, and Visual Studio's MSBuild runs on .NET
            // Framework, where the type does not exist at any version. The
            // old message named the symptom and left the reader guessing.
            Log.LogError(
                "The art packer needs Brotli, which the .NET Framework build of MSBuild does not have. "
                + "This project builds with the .NET SDK: run 'dotnet build' or 'dotnet publish' from the "
                + "repository root, or set Visual Studio to use the dotnet CLI. Host runtime: "
                + System.Runtime.InteropServices.RuntimeInformation.FrameworkDescription + ".");
            return false;
        }
        object smallest = Enum.Parse(levelType, "SmallestSize");

        var crcTable = new uint[256];
        for (uint n = 0; n < 256; n++)
        {
            uint c = n;
            for (int k = 0; k < 8; k++)
                c = (c & 1) != 0 ? 0xEDB88320u ^ (c >> 1) : c >> 1;
            crcTable[n] = c;
        }
        Func<byte[], uint> crc32 = bytes =>
        {
            uint c = 0xFFFFFFFFu;
            for (int i = 0; i < bytes.Length; i++)
                c = crcTable[(c ^ bytes[i]) & 0xFF] ^ (c >> 8);
            return c ^ 0xFFFFFFFFu;
        };

        // A PNG whose pixels are stored rather than deflated. Same pixels,
        // same header, still a PNG that any decoder reads.
        Func<byte[], byte[]> storePixels = png =>
        {
            var pieces = new List<KeyValuePair<string, byte[]>>();
            var deflated = new MemoryStream();
            int at = 8;
            while (at + 8 <= png.Length)
            {
                int len = (png[at] << 24) | (png[at + 1] << 16) | (png[at + 2] << 8) | png[at + 3];
                string kind = Encoding.ASCII.GetString(png, at + 4, 4);
                if (kind == "IDAT") deflated.Write(png, at + 8, len);
                else
                {
                    var body = new byte[len];
                    Array.Copy(png, at + 8, body, 0, len);
                    pieces.Add(new KeyValuePair<string, byte[]>(kind, body));
                }
                at += 12 + len;
            }

            var zlib = deflated.ToArray();
            byte[] pixels;
            // Skip the two-byte zlib header and the four-byte Adler trailer.
            using (var src = new MemoryStream(zlib, 2, zlib.Length - 6))
            using (var inflate = new DeflateStream(src, CompressionMode.Decompress))
            using (var grown = new MemoryStream())
            {
                inflate.CopyTo(grown);
                pixels = grown.ToArray();
            }

            byte[] stored;
            using (var ms = new MemoryStream())
            {
                ms.WriteByte(0x78);
                ms.WriteByte(0x01);
                using (var raw = new DeflateStream(ms, CompressionLevel.NoCompression, true))
                    raw.Write(pixels, 0, pixels.Length);
                uint a = 1, b = 0;
                for (int i = 0; i < pixels.Length; i++)
                {
                    a = (a + pixels[i]) % 65521;
                    b = (b + a) % 65521;
                }
                uint adler = (b << 16) | a;
                ms.WriteByte((byte)(adler >> 24));
                ms.WriteByte((byte)(adler >> 16));
                ms.WriteByte((byte)(adler >> 8));
                ms.WriteByte((byte)adler);
                stored = ms.ToArray();
            }

            using (var outMs = new MemoryStream())
            {
                outMs.Write(png, 0, 8);
                Action<string, byte[]> emit = (kind, body) =>
                {
                    var head = new byte[] { (byte)(body.Length >> 24), (byte)(body.Length >> 16),
                                            (byte)(body.Length >> 8), (byte)body.Length };
                    outMs.Write(head, 0, 4);
                    var tagged = new byte[4 + body.Length];
                    Encoding.ASCII.GetBytes(kind, 0, 4, tagged, 0);
                    Array.Copy(body, 0, tagged, 4, body.Length);
                    outMs.Write(tagged, 0, tagged.Length);
                    uint c = crc32(tagged);
                    outMs.Write(new byte[] { (byte)(c >> 24), (byte)(c >> 16),
                                             (byte)(c >> 8), (byte)c }, 0, 4);
                };
                foreach (var piece in pieces)
                {
                    if (piece.Key == "IEND") break;
                    emit(piece.Key, piece.Value);
                }
                emit("IDAT", stored);
                emit("IEND", new byte[0]);
                return outMs.ToArray();
            }
        };

        // An archive whose members are stored rather than deflated. Same
        // members, same names, still a zip that ZipArchive reads.
        Func<string, byte[]> storeMembers = source =>
        {
            using (var ms = new MemoryStream())
            {
                using (var input = new ZipArchive(File.OpenRead(source), ZipArchiveMode.Read))
                using (var output = new ZipArchive(ms, ZipArchiveMode.Create, true))
                    foreach (var entry in input.Entries)
                    {
                        var copy = output.CreateEntry(entry.FullName, CompressionLevel.NoCompression);
                        using (var from = entry.Open())
                        using (var to = copy.Open())
                            from.CopyTo(to);
                    }
                return ms.ToArray();
            }
        };

        // Indexed rather than appended: the pack runs in parallel below and
        // the embedded resource order has to stay what the item list said.
        var results = new ITaskItem[Assets.Length];
        // One slot per asset, written only by the iteration that owns it, so
        // the parallel loop needs no lock to report a failure.
        var notReplaced = new string[Assets.Length];
        int written = 0;
        Directory.CreateDirectory(OutputDir);
        // A missing packer file used to read as "never changed", which would
        // quietly switch off the repack-on-packer-edit rule below. It is a
        // wrong path in the target, so say so.
        if (!File.Exists(PackerFile))
        {
            Log.LogError("The art packer was given a packer file that does not exist: " + PackerFile);
            return false;
        }
        DateTime packerStamp = File.GetLastWriteTimeUtc(PackerFile);

        // One asset per core rather than one at a time. Every iteration reads
        // its own source and writes its own target, so the only shared state
        // is the counter and the result slot, and both are made safe below.
        // Brotli at SmallestSize is the expensive part and it is pure CPU, so
        // this is the whole difference between a minute and a quarter of an
        // hour on a machine with cores to spare. The packed bytes are
        // identical either way.
        Parallel.For(0, Assets.Length, idx =>
        {
            var asset = Assets[idx];
            string source = asset.GetMetadata("FullPath");
            // MSBuild prefixes a path segment that starts with a digit, which
            // is why 3DModels becomes _3DModels. The packed name has to match
            // what an unpacked resource would have been called.
            var segments = asset.GetMetadata("RelativeDir")
                                .Replace('/', '\\').Split(new[] { '\\' },
                                                          StringSplitOptions.RemoveEmptyEntries);
            var prefix = new StringBuilder("PadForge.");
            foreach (var segment in segments)
            {
                if (segment.Length > 0 && char.IsDigit(segment[0])) prefix.Append('_');
                prefix.Append(segment).Append('.');
            }

            string extension = Path.GetExtension(source).ToLowerInvariant();
            string packedExtension = extension == ".png" ? ".pngbr"
                                   : extension == ".zip" ? ".zipbr"
                                   : ".objbr";
            string logical = prefix.ToString()
                           + Path.GetFileNameWithoutExtension(source) + packedExtension;
            string target = Path.Combine(OutputDir, logical);

            // The packer itself is an input. Comparing only against the
            // asset's timestamp meant that editing storePixels, storeMembers
            // or the compression level left every cached output in place, so
            // an incremental build embedded art produced by an older
            // algorithm while reporting success.
            if (!File.Exists(target)
                || File.GetLastWriteTimeUtc(target) < File.GetLastWriteTimeUtc(source)
                || File.GetLastWriteTimeUtc(target) < packerStamp)
            {
                byte[] body;
                if (extension == ".png") body = storePixels(File.ReadAllBytes(source));
                else if (extension == ".zip") body = storeMembers(source);
                else body = File.ReadAllBytes(source);

                // Written beside the target and moved into place, so a build
                // that dies mid-pack cannot leave a truncated file whose
                // timestamp then reads as up to date forever. The staging
                // name carries the process id, because two builds sharing one
                // obj folder would otherwise fight over the same temp file.
                string staging = target + "." + Process.GetCurrentProcess().Id + "." + Thread.CurrentThread.ManagedThreadId + ".tmp";
                try
                {
                    using (var output = File.Create(staging))
                    using (var brotli = (Stream)Activator.CreateInstance(
                               streamType, new object[] { output, smallest, false }))
                        brotli.Write(body, 0, body.Length);
                }
                catch
                {
                    // A full disk fails here, part way through. The build
                    // still stops on the exception. It just does not leave
                    // a truncated .tmp behind for every asset it reached.
                    try { File.Delete(staging); } catch (IOException) { } catch (UnauthorizedAccessException) { }
                    throw;
                }
                // Publish the staged file. WPF runs a second MSBuild pass
                // through a generated _wpftmp project that shares this same
                // obj folder, so two passes can pack the same asset at once.
                // Whoever lands first wins and the loser drops its copy,
                // because both produced identical bytes from identical input.
                bool placed = false;
                try
                {
                    // Replace swaps the file in one step, so no reader ever
                    // finds the target missing. Delete-then-move left a gap
                    // in which the other pass could.
                    if (File.Exists(target)) File.Replace(staging, target, null);
                    else File.Move(staging, target);
                    placed = true;
                    Interlocked.Increment(ref written);
                }
                catch (IOException) { }
                catch (UnauthorizedAccessException) { }

                // A replace that failed used to be assumed harmless: another
                // pass packed the same asset first, and its file is as good
                // as this one. That is one way to land here. A target that
                // is read-only, or held open by another program, is another,
                // and then the STALE file stayed in place and was embedded
                // while the build reported success. The two are told apart
                // by the one thing that defines "as good": the bytes. The
                // pack is deterministic, so a winner's file equals this one
                // exactly, and a stale file does not. Timestamps cannot say,
                // because a winner can land between any two reads of them.
                if (!placed)
                {
                    bool sameBytes = false;
                    try
                    {
                        if (File.Exists(target))
                        {
                            byte[] theirs = File.ReadAllBytes(target);
                            byte[] ours = File.ReadAllBytes(staging);
                            sameBytes = theirs.Length == ours.Length;
                            for (int b = 0; sameBytes && b < ours.Length; b++)
                                sameBytes = theirs[b] == ours[b];
                        }
                    }
                    catch (IOException) { }
                    catch (UnauthorizedAccessException) { }
                    try { File.Delete(staging); } catch (IOException) { } catch (UnauthorizedAccessException) { }
                    if (!sameBytes)
                    {
                        notReplaced[idx] = target;
                        return;
                    }
                }
            }

            var item = new TaskItem(target);
            item.SetMetadata("LogicalName", logical);
            results[idx] = item;
        });

        bool anyNotReplaced = false;
        foreach (string stale in notReplaced)
        {
            if (stale == null) continue;
            anyNotReplaced = true;
            Log.LogError("Packed art could not be replaced, so the stale copy would have been embedded: "
                         + stale + ". Something holds it open, or it is read-only.");
        }
        if (anyNotReplaced) return false;

        Packed = results;
        Log.LogMessage(MessageImportance.High,
            written == 0
                ? "Art: " + Assets.Length + " already packed"
                : "Art: packed " + written + " of " + Assets.Length);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="EmbedPackedArt" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <ArtSource Include="3DModels\**\*.obj" />
      <ArtSource Include="3DModels\**\*.png" />
      <!-- The Vosk model rides in both builds. 4.5.1 left it out of the
           ARM64 one, because that build had no libvosk to read it with. It
           has one now (Resources\Vosk\arm64). -->
      <ArtSource Include="VoiceModels\*.zip" />
    </ItemGroup>
    <!-- PackerFile is this project file BY NAME, never $(MSBuildThisFileFullPath).
         WPF compiles XAML through a second pass over a generated copy of this
         project (PadForge.App_<random>_wpftmp.csproj), and in that pass
         MSBuildThisFileFullPath is the copy, written seconds earlier. Its
         timestamp is newer than every packed asset, so that pass repacked all
         of them on EVERY build, changed or not: four to five minutes on a
         32-core bench, and a second full pack in every CI run. The first pass reported
         "already packed" and the second "packed 721 of 721", in one build. -->
    <PackAssets Assets="@(ArtSource)" OutputDir="$(IntermediateOutputPath)meshes"
                PackerFile="$(MSBuildThisFileDirectory)PadForge.App.csproj">
      <Output TaskParameter="Packed" ItemName="CompressedMesh" />
    </PackAssets>
    <ItemGroup>
      <!-- WithCulture is not optional here. Each packed mesh is named for the
           resource it becomes, so its file name carries dots, and MSBuild
           reads the segment before the extension as a culture when it matches
           one. Switch2Pro's GL.obj became PadForge._3DModels.Switch2Pro.GL.objbr,
           whose GL is Galician, and that one mesh was routed into a satellite
           assembly and vanished from the pad. -->
      <EmbeddedResource Include="@(CompressedMesh)">
        <LogicalName>%(CompressedMesh.LogicalName)</LogicalName>
        <WithCulture>false</WithCulture>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <!-- ARM64 (4.5.1, preliminary).

       Vosk's own targets file adds its win-x64 natives whenever the BUILD
       machine is Windows, with no regard for the target architecture, so an
       ARM64 publish from this x64 bench would carry an x64 libvosk.dll and
       three MinGW runtime DLLs an ARM64 process cannot load. The items are
       taken back out here. NativeLibs is the item name Vosk.targets defines.

       The ARM64 build gets its own libvosk.dll from Resources\Vosk\arm64
       (the Content item near the top of this file). Vosk publishes no
       Windows ARM64 binary, but its maintainer wrote the recipe for one
       (vosk-api 1b308a30, travis/Dockerfile.winaarch64) and never shipped
       the output. tools/build-libvosk-arm64.sh is that recipe with every
       source pinned, run here. The DLL links its C++ runtime statically, so
       it needs no companion DLLs, where the x64 one needs three. -->
  <Target Name="DropX64OnlyNativesOnArm64" BeforeTargets="AssignTargetPaths"
          Condition="'$(NativeArch)' == 'arm64'">
    <ItemGroup>
      <None Remove="@(NativeLibs)" />
    </ItemGroup>
  </Target>

  <!-- SDL3.dll, libusb-1.0.dll and xinput1_4.dll come from outside this
       repository and are delivered here as binaries. Their Content items are
       conditioned on Exists, which is right for a first build but means a
       missing DLL is SILENT: the publish would succeed and produce an exe
       whose input engine cannot start, or one that reads its own virtual
       controllers back as input. A plain build is let through with a message
       so the rest of the tree can still be compiled and checked. A PUBLISH
       without them is refused, because that is the step whose output
       reaches somebody else's machine.

       The guard first covered ARM64 alone and named two files, because
       those were the two that did not exist yet. x64 had the same silence,
       and libusb had it on both: 4.5.0 shipped with wired Switch 2
       controllers dead because SDL could not load libusb, which is the
       state a missing libusb-1.0.dll reproduces exactly. The auto build
       runs no tests, so this target is the only check it has.

       An architecture with no native folder is refused outright. Any other
       runtime identifier fell through to the x64 folder, which would put
       x64 DLLs beside an x86 exe. -->
  <Target Name="RequireBundledNatives" BeforeTargets="PrepareForPublish">
    <Error Condition="'$(RuntimeIdentifier)' != 'win-x64' And '$(RuntimeIdentifier)' != 'win-arm64'"
           Text="Publish refused: PadForge bundles native libraries for win-x64 and win-arm64 only, and '$(RuntimeIdentifier)' would be given the x64 ones." />
    <Error Condition="!Exists('Resources\SDL3\$(NativeArch)\SDL3.dll')"
           Text="Publish refused: Resources\SDL3\$(NativeArch)\SDL3.dll is missing. It has to come from a $(NativeArch) build of the SDL fork. Without it the input engine cannot start." />
    <Error Condition="!Exists('Resources\SDL3\$(NativeArch)\libusb-1.0.dll')"
           Text="Publish refused: Resources\SDL3\$(NativeArch)\libusb-1.0.dll is missing. SDL loads it by name at run time, and without it wired Switch 2 controllers and the GameCube adapter never open." />
    <Error Condition="!Exists('Resources\OpenXInput\$(NativeArch)\xinput1_4.dll')"
           Text="Publish refused: Resources\OpenXInput\$(NativeArch)\xinput1_4.dll is missing. It has to come from a $(NativeArch) build of the OpenXInput fork. Without it SDL loads the system xinput1_4.dll, the HIDMaestro filter is gone, and PadForge reads its own virtual controllers back as input." />
    <Error Condition="'$(NativeArch)' == 'arm64' And !Exists('Resources\Vosk\arm64\libvosk.dll')"
           Text="Publish refused: Resources\Vosk\arm64\libvosk.dll is missing. The Vosk package carries no ARM64 library, so the ARM64 build bundles its own, built by tools/build-libvosk-arm64.sh. Without it voice macros lose the Vosk recognizer on ARM64." />
  </Target>
  <Target Name="NoteMissingBundledNatives" BeforeTargets="PrepareForBuild"
          Condition="!Exists('Resources\SDL3\$(NativeArch)\SDL3.dll') Or !Exists('Resources\SDL3\$(NativeArch)\libusb-1.0.dll') Or !Exists('Resources\OpenXInput\$(NativeArch)\xinput1_4.dll')">
    <Message Importance="high"
             Text="$(NativeArch): SDL3.dll, libusb-1.0.dll and/or xinput1_4.dll are not in Resources\...\$(NativeArch) yet. This build compiles, and a publish will be refused until all three are there." />
  </Target>

  <!-- PadForge ships none of Microsoft's in-box Windows MIDI Services
       binaries. Windows installs that API in System32, and this project takes
       only its metadata (Resources\WinMD). Nothing here brings the binaries
       in, so this refuses a publish that would carry one anyway: for example
       after a PackageReference to Microsoft's Windows.Devices.Midi2 preview
       package, whose runtimes\win-*\native DLL and .pri NuGet copies by
       itself. -->
  <Target Name="RefuseInBoxMidiBinaries" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_InBoxMidiBinary Include="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'Windows.Devices.Midi2'" />
    </ItemGroup>
    <Error Condition="'@(_InBoxMidiBinary)' != ''"
           Text="Publish refused: @(_InBoxMidiBinary->'%(Filename)%(Extension)') would ship. PadForge uses the Windows MIDI Services implementation Windows installs in System32 and ships none of its own." />
  </Target>

  <!-- Build identity for in-app updates (#457). Every build between two
       releases reports the same version, so the version alone cannot tell an
       older dev build from a newer one. CI names each dev build by the
       commit count and short hash, "PadForge r3676@b500441"
       (.github/workflows/build.yml, which fetches the full history so the
       count is the real one), and this stamps the same two values into the
       exe as assembly metadata, with the full hash, which is the only value
       that names one build exactly. A tree built without git stamps nothing,
       and the updater treats that build as older than any published one.

       Only this tree's own full history is stamped. A source zip unpacked
       inside another repository would otherwise take that repository's
       count and hash, and a shallow clone a count that is too low, and the
       updater orders dev builds by that count. So nothing is stamped unless
       git's top level is this solution folder, the commit holds this project
       file, and the clone is not shallow. HEAD is read once, so the count and
       the hash describe one commit even while HEAD moves.

       WriteOnlyWhenDifferent keeps an unchanged commit from recompiling, and
       the target is harmless in WPF's second compile pass over the
       _wpftmp copy of this project: it writes the same file. -->
  <Target Name="StampBuildIdentity" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <PadForgeBuildNumber></PadForgeBuildNumber>
      <PadForgeCommit></PadForgeCommit>
      <PadForgeCommitSha></PadForgeCommitSha>
      <_PadForgeSolutionDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..'))</_PadForgeSolutionDir>
    </PropertyGroup>
    <Exec Command="git rev-parse HEAD" WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" EchoOff="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_PadForgeHead" />
      <Output TaskParameter="ExitCode" PropertyName="_PadForgeHeadExit" />
    </Exec>
    <Exec Condition="'$(_PadForgeHeadExit)' == '0'" Command="git rev-parse --show-toplevel"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" EchoOff="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_PadForgeTop" />
      <Output TaskParameter="ExitCode" PropertyName="_PadForgeTopExit" />
    </Exec>
    <Exec Condition="'$(_PadForgeTopExit)' == '0'" Command="git rev-parse --is-shallow-repository"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" EchoOff="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_PadForgeShallow" />
      <Output TaskParameter="ExitCode" PropertyName="_PadForgeShallowExit" />
    </Exec>
    <PropertyGroup Condition="'$(_PadForgeShallowExit)' == '0' and '$(_PadForgeShallow)' == 'false' and '$(_PadForgeTop)' != ''">
      <_PadForgeTopDir>$([System.IO.Path]::GetFullPath('$(_PadForgeTop)'))</_PadForgeTopDir>
    </PropertyGroup>
    <Exec Condition="'$(_PadForgeTopDir)' != '' and '$(_PadForgeTopDir)' == '$(_PadForgeSolutionDir)'"
          Command="git cat-file -e $(_PadForgeHead):PadForge.App/PadForge.App.csproj"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          IgnoreExitCode="true" EchoOff="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_PadForgeOwnExit" />
    </Exec>
    <Exec Condition="'$(_PadForgeOwnExit)' == '0'" Command="git rev-list --count $(_PadForgeHead)"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" EchoOff="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_PadForgeCount" />
      <Output TaskParameter="ExitCode" PropertyName="_PadForgeCountExit" />
    </Exec>
    <Exec Condition="'$(_PadForgeCountExit)' == '0'" Command="git rev-parse --short=7 $(_PadForgeHead)"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" EchoOff="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_PadForgeShort" />
      <Output TaskParameter="ExitCode" PropertyName="_PadForgeShortExit" />
    </Exec>
    <PropertyGroup Condition="'$(_PadForgeShortExit)' == '0'">
      <PadForgeBuildNumber>$(_PadForgeCount)</PadForgeBuildNumber>
      <PadForgeCommit>$(_PadForgeShort)</PadForgeCommit>
      <PadForgeCommitSha>$(_PadForgeHead)</PadForgeCommitSha>
    </PropertyGroup>
    <ItemGroup>
      <_PadForgeIdentityLine Include="// Generated by StampBuildIdentity in PadForge.App.csproj." />
      <_PadForgeIdentityLine Include="[assembly: System.Reflection.AssemblyMetadata(&quot;PadForgeBuildNumber&quot;, &quot;$(PadForgeBuildNumber)&quot;)]" />
      <_PadForgeIdentityLine Include="[assembly: System.Reflection.AssemblyMetadata(&quot;PadForgeCommit&quot;, &quot;$(PadForgeCommit)&quot;)]" />
      <_PadForgeIdentityLine Include="[assembly: System.Reflection.AssemblyMetadata(&quot;PadForgeCommitSha&quot;, &quot;$(PadForgeCommitSha)&quot;)]" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)PadForgeBuildIdentity.g.cs" Lines="@(_PadForgeIdentityLine)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)PadForgeBuildIdentity.g.cs" />
    </ItemGroup>
  </Target>

</Project>
