<UserControl x:Class="PadForge.Views.DevicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:common="clr-namespace:PadForge.Common"
             xmlns:local="clr-namespace:PadForge.Views"
             xmlns:strings="clr-namespace:PadForge.Resources.Strings"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="po">

    <UserControl.Resources>
        <!-- Ember (#175): list-row meta segments render cold mono. Liveness
             reads as emphasis on both grounds: online rows carry the themed
             cold at full strength, offline rows dim the same cold to 0.55. -->
        <Style x:Key="DeviceMetaText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource ColdBrush}"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                    <Setter Property="Opacity" Value="1.0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Ember (#175): section eyebrows. Mono, small, tertiary.
             Uppercasing is display-only via UpperConverter. -->
        <Style x:Key="SectionEyebrow" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
        </Style>
        <!-- Ember (#175): Raw Input State cluster. Dark recessed cells,
             cold lit outline when pressed (outline lit, not solid). -->
        <Style x:Key="RawCellBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SteelGroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SteelLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPressed}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ColdBrush}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#58B6E4" BlurRadius="10" ShadowDepth="0" Opacity="0.45"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- NFC tag rows light on IsActive instead of IsPressed. -->
        <Style x:Key="RawCellBorderActive" TargetType="Border" BasedOn="{StaticResource RawCellBorder}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ColdBrush}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#58B6E4" BlurRadius="10" ShadowDepth="0" Opacity="0.45"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Glow sweep (#175): shared cold bloom for pressed touch dots
             and POV needles. Static, frozen, never animated. -->
        <DropShadowEffect x:Key="ColdDotGlow" Color="#58B6E4" BlurRadius="8" ShadowDepth="0" Opacity="0.45"/>
        <!-- Hover glow (#175): hover color changes carry a hue-matched
             bloom. Every hover shift on this page is neutral steel, so the
             glow is the faint ember signature. Frozen shared static effect,
             set from triggers only, never animated. -->
        <DropShadowEffect x:Key="NeutralHoverGlow" po:Freeze="True" Color="#FF6B2C" ShadowDepth="0" BlurRadius="10" Opacity="0.30"/>
        <!-- Hover glow sweep (#175): stock-chrome classes bloom in the same
             moment their hover fill shifts. BasedOn the WPF-UI defaults so
             theme brushes survive. The two inline Button styles below
             (Submit Mapping, Manage NFC Tags) chain into the Button
             implicit via their BasedOn {x:Type Button}. -->
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <!-- MinHeight mirrors the App.xaml implicit Button style (32px
                 grid), which this page-local implicit replaces. -->
            <Setter Property="MinHeight" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <!-- Selection setters mirror the App.xaml implicit TextBox
                 style, which this page-local implicit replaces. -->
            <Setter Property="SelectionBrush" Value="{DynamicResource EmberBrush}"/>
            <Setter Property="SelectionOpacity" Value="0.35"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RawCellLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPressed}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource ColdBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="&#xE772;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding Devices_Title, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource TitleTextBlockStyle}" FontFamily="{StaticResource DisplayFontFamily}" FontWeight="650" FontSize="26"/>
            <ui:Button Style="{StaticResource EmberIconButton}" Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Command="{Binding RefreshCommand}"
                       ToolTip="{Binding Common_Refresh, Source={x:Static strings:Strings.Instance}}">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </ui:Button>
            <ui:Button Style="{StaticResource EmberIconButton}" Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Command="{Binding PairCommand}"
                       ToolTip="{Binding Devices_Pair, Source={x:Static strings:Strings.Instance}}">
                <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </ui:Button>
            <!-- Telemetry counter (#175 typography): counts mono cold,
                 labels mono tertiary, same treatment as the status bar
                 and the Dashboard device counter. -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <TextBlock Foreground="{DynamicResource ColdBrush}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12" Text="{Binding OnlineCount, Mode=OneWay}"/>
                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12" Text="{Binding Devices_OnlineTotal, Source={x:Static strings:Strings.Instance}}"/>
                <TextBlock Foreground="{DynamicResource ColdBrush}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12" Text="{Binding TotalCount, Mode=OneWay}"/>
                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12" Text="{Binding Devices_Total, Source={x:Static strings:Strings.Instance}}"/>
            </StackPanel>
        </StackPanel>

        <!-- Main content: Card list + Detail -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════════════ -->
            <!--  Left: Device card list                    -->
            <!-- ═══════════════════════════════════════════ -->
            <ListBox ItemsSource="{Binding Devices}"
                     SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0" Background="Transparent"
                     Margin="0,0,12,0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8" Padding="12,10" Margin="0,0,0,4"
                                PreviewMouseLeftButtonDown="DeviceCard_MouseDown"
                                PreviewMouseMove="DeviceCard_MouseMove"
                                PreviewMouseLeftButtonUp="DeviceCard_MouseUp">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Status dot + Device name -->
                                <StackPanel Orientation="Horizontal">
                                    <Path Margin="0,0,8,0">
                                        <Path.Style>
                                            <Style TargetType="Path" BasedOn="{StaticResource LivenessFlameBase}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource EmberBrush}"/>
                                                        <Setter Property="Stroke" Value="{x:Null}"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#FF6B2C" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold"
                                               FontSize="13" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Slot badges (right, row 0–1, wraps if many) -->
                                <StackPanel Grid.Column="1" Grid.RowSpan="2"
                                            VerticalAlignment="Center" Margin="8,0,0,0">
                                    <ItemsControl ItemsSource="{Binding SlotBadges}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- The forge moment (#175): these badges only render
                                                     when assigned, so the ember treatment is
                                                     unconditional. Mirrors the right-pane slot pill. -->
                                                <Border CornerRadius="4" Padding="5,2"
                                                        Margin="0,0,4,3">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#FF6B2C" Offset="0"/>
                                                            <GradientStop Color="#C43D0C" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#FF6B2C" BlurRadius="10" ShadowDepth="0" Opacity="0.35"/>
                                                    </Border.Effect>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="10" Foreground="#FFFFF3E8"
                                                                   VerticalAlignment="Center"/>
                                                        <!-- Slot number is a chip token: mono, like the
                                                             PadPage tier-strip slot pill. -->
                                                        <TextBlock Text="{Binding SlotNumber}" FontFamily="{StaticResource TelemetryFontFamily}"
                                                                   FontSize="10" Foreground="#FFFFF3E8" Margin="3,0,0,0"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- Unassigned fallback -->
                                    <Border CornerRadius="4" Padding="5,2" Margin="0,0,4,3"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            Visibility="{Binding IsUnassigned, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Common_Unassigned, Source={x:Static strings:Strings.Instance}}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Delete button (upper-right) -->
                                <ui:Button Grid.Column="2" Grid.RowSpan="2"
                                           Style="{StaticResource EmberIconButtonHot}"
                                           ToolTip="{Binding Devices_RemoveTooltip, Source={x:Static strings:Strings.Instance}}"
                                           VerticalAlignment="Top"
                                           Click="RemoveDevice_Click">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </ui:Button>

                                <!-- Row 1: Type | VID:PID | Capabilities -->
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="3"
                                            Orientation="Horizontal" Margin="16,3,0,0">
                                    <TextBlock Text="{Binding DeviceType, Converter={StaticResource UpperConverter}}" Style="{StaticResource DeviceMetaText}"/>
                                    <TextBlock Text=" &#x2022; " Style="{StaticResource DeviceMetaText}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource DeviceMetaText}" Text="{Binding VendorIdHex, Mode=OneWay}"/>
                                        <TextBlock Style="{StaticResource DeviceMetaText}" Text=":"/>
                                        <TextBlock Style="{StaticResource DeviceMetaText}" Text="{Binding ProductIdHex, Mode=OneWay}"/>
                                    </StackPanel>
                                    <TextBlock Text=" &#x2022; " Style="{StaticResource DeviceMetaText}"/>
                                    <TextBlock Text="{Binding CapabilitiesSummary, Converter={StaticResource UpperConverter}}" Style="{StaticResource DeviceMetaText}"/>
                                    <!-- Battery (issue #167): shown only when the device reports one -->
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text=" &#x2022; " Style="{StaticResource DeviceMetaText}"/>
                                        <TextBlock Text="{Binding BatteryGlyph}" Style="{StaticResource DeviceMetaText}" FontFamily="Segoe MDL2 Assets"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding BatteryText}" Style="{StaticResource DeviceMetaText}"
                                                   Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid x:Name="RowRoot">
                                        <!-- Hover lift (#175): element-level transform so
                                             the trigger storyboard animates per row. -->
                                        <Grid.RenderTransform>
                                            <TranslateTransform/>
                                        </Grid.RenderTransform>
                                        <!-- Selection accent bar (left edge) -->
                                        <Border x:Name="SelectionBar" Width="4"
                                                HorizontalAlignment="Left" CornerRadius="2"
                                                Background="{DynamicResource SystemAccentColorSecondaryBrush}"
                                                Visibility="Collapsed" Margin="0,2"/>
                                        <ContentPresenter Margin="6,0,0,0"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <!-- Hover glow + lift (#175): the row card is
                                             clickable, selectable, and draggable but had no
                                             hover feedback. Hover before IsSelected;
                                             selection only drives the bar, so no Effect
                                             fight. Static effect; only the transform
                                             animates. -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="RowRoot"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                         To="-2" Duration="0:0:0.13">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="RowRoot"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                         To="0" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseIn"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- ═══════════════════════════════════════════ -->
            <!--  Right: Detail panel                       -->
            <!-- ═══════════════════════════════════════════ -->
            <Border Grid.Column="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="14,12">
                <Grid>

                <!-- Empty state (#175): steel schematic watermark + one cold
                     sentence, matching the Macros empty-state grammar. -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedDevice}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE772;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                               Foreground="{DynamicResource SteelLineBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Devices_EmptyHint, Source={x:Static strings:Strings.Instance}}"
                               Foreground="{DynamicResource ColdBrush}"
                               Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,14,0"
                              Visibility="{Binding HasSelectedDevice, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>

                        <!-- Device identity: the detail card's title, so it
                             wears the shared CardTitle (display face) instead
                             of a bespoke body-face heading. -->
                        <TextBlock Text="{Binding SelectedDevice.DeviceName}"
                                   Style="{StaticResource CardTitle}"
                                   TextWrapping="Wrap" Margin="0,0,0,6"/>

                        <!-- ─── Device Dossier (#175 competitor item 7) ─── -->
                        <!-- One dossier, at the top, per user report: the old
                             identity block up here and the dossier card down
                             by the inspector repeated VID:PID and split the
                             identity in two. The recessed mono card now
                             carries every identity field the engine holds in
                             one token grammar. Token labels stay locale-
                             neutral literals per the VID:PID precedent (the
                             localized Devices_Product/Type/AppGUID/SdlGUID/
                             InstancePath/VIDPID labels are no longer
                             referenced here). Lines whose fact is absent (no
                             SDL GUID, no HidHide path, no BT link, no serial,
                             no battery) collapse instead of showing
                             placeholders. No per-device measured poll Hz
                             exists (only the global forge rate), so the
                             dossier carries no HZ line. -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="{Binding Devices_Dossier, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}"
                                       Style="{StaticResource SectionEyebrow}" VerticalAlignment="Center"/>
                            <ui:Button Style="{StaticResource EmberIconButton}" HorizontalAlignment="Right"
                                       Click="CopyDossier_Click"
                                       ToolTip="{Binding Common_Copy, Source={x:Static strings:Strings.Instance}}">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </ui:Button>
                        </Grid>
                        <Border Background="{DynamicResource SteelGroundBrush}" BorderBrush="{DynamicResource SteelLineBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,2">
                            <StackPanel>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="PRODUCT" FontSize="10" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                    <TextBlock Grid.Column="1" FontSize="11" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}" TextWrapping="Wrap" Text="{Binding SelectedDevice.ProductName, Mode=OneWay}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="TYPE" Width="64" FontSize="10" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock FontSize="11" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}" Text="{Binding SelectedDevice.DeviceType, Mode=OneWay}"/>
                                </StackPanel>
                                <!-- The capabilities summary keeps its wrapped
                                     prose form, just re-homed onto a token row. -->
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CAPS" FontSize="10" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                    <TextBlock Grid.Column="1" FontSize="11" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}" TextWrapping="Wrap" Text="{Binding SelectedDevice.CapabilitiesSummary, Mode=OneWay}"/>
                                </Grid>
                                <!-- GUID / path hashes: same marquee mechanics as
                                     the old identity block (clipping border, the
                                     text scrolls to reveal overflow), same
                                     presence gates. -->
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="APP GUID" FontSize="10" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" ClipToBounds="True" Padding="0,1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="11" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}"
                                                       common:MarqueeBehavior.IsEnabled="True"
                                                       Text="{Binding SelectedDevice.InstanceGuid, Mode=OneWay}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Grid Margin="0,0,0,2"
                                      Visibility="{Binding SelectedDevice.SdlGuid, Converter={StaticResource StringToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SDL GUID" FontSize="10" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" ClipToBounds="True" Padding="0,1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="11" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}"
                                                       common:MarqueeBehavior.IsEnabled="True"
                                                       Text="{Binding SelectedDevice.SdlGuid, Mode=OneWay}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Grid Margin="0,0,0,2"
                                      Visibility="{Binding SelectedDevice.HidHideInstancePath, Converter={StaticResource StringToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="PATH" FontSize="10" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" ClipToBounds="True" Padding="0,1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="11" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}"
                                                       common:MarqueeBehavior.IsEnabled="True"
                                                       Text="{Binding SelectedDevice.HidHideInstancePath, Mode=OneWay}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="VID:PID" Width="64" FontSize="10" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock FontSize="11" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}" Text="{Binding SelectedDevice.VendorIdHex, Mode=OneWay}"/>
                                    <TextBlock FontSize="11" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}" Text=":"/>
                                    <TextBlock FontSize="11" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}" Text="{Binding SelectedDevice.ProductIdHex, Mode=OneWay}"/>
                                </StackPanel>
                                <!-- Transport renders only when Bluetooth is a
                                     positive fact (same path predicate as the
                                     disconnect gates and the item 9 slot-card
                                     glyph). A non-BT path may be USB, a dongle,
                                     or a virtual source, so no transport is
                                     claimed there. -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2"
                                            Visibility="{Binding SelectedDevice.IsBluetoothLink, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="LINK" Width="64" FontSize="10" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource ColdBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="BT" FontSize="11" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- Serial as SDL reports it (BT MAC on most
                                     wireless pads). Hidden when unreported. -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2"
                                            Visibility="{Binding SelectedDevice.SerialNumber, Converter={StaticResource StringToVisibility}}">
                                    <TextBlock Text="SERIAL" Width="64" FontSize="10" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock FontSize="11" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}" Text="{Binding SelectedDevice.SerialNumber, Mode=OneWay}"/>
                                </StackPanel>
                                <!-- Battery (#167 canon): glyph + percent, only
                                     when the device reports one. -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2"
                                            Visibility="{Binding SelectedDevice.HasBattery, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="BATT" Width="64" FontSize="10" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedDevice.BatteryGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource ColdBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding SelectedDevice.BatteryText}" FontSize="11" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- Capability row: the established capability
                                     glyphs (FFB card E877, Gyro tab E7AD,
                                     Touchpad tab EFA5), ember-lit, present-only.
                                     CapabilitiesSummary never lists absent
                                     capabilities, so no cold placeholders here
                                     either. Accel has no established glyph in
                                     the app and stays text-only above. -->
                                <StackPanel Visibility="{Binding SelectedDevice.HasCapabilityIcons, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border Height="1" Background="{DynamicResource SteelLineSoftBrush}" Margin="0,6,0,6"/>
                                    <WrapPanel>
                                        <Border Background="{DynamicResource EmberTintBrush}" BorderBrush="#66FF6B2C" BorderThickness="1"
                                                CornerRadius="4" Padding="6,3" Margin="0,0,4,0"
                                                ToolTip="{Binding Devices_Rumble, Source={x:Static strings:Strings.Instance}}"
                                                Visibility="{Binding SelectedDevice.HasRumble, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="&#xE877;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource EmberBrush}"/>
                                        </Border>
                                        <Border Background="{DynamicResource EmberTintBrush}" BorderBrush="#66FF6B2C" BorderThickness="1"
                                                CornerRadius="4" Padding="6,3" Margin="0,0,4,0"
                                                ToolTip="{Binding Devices_Gyro, Source={x:Static strings:Strings.Instance}}"
                                                Visibility="{Binding SelectedDevice.HasGyro, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="&#xE7AD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource EmberBrush}"/>
                                        </Border>
                                        <Border Background="{DynamicResource EmberTintBrush}" BorderBrush="#66FF6B2C" BorderThickness="1"
                                                CornerRadius="4" Padding="6,3" Margin="0,0,4,0"
                                                ToolTip="{Binding Btn_Touchpad, Source={x:Static strings:Strings.Instance}}"
                                                Visibility="{Binding SelectedDevice.ShowTouchpadCapability, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="&#xEFA5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource EmberBrush}"/>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Submit mapping (joysticks only, not gamepads, mice, or keyboards) -->
                        <Button Content="{Binding Devices_SubmitMapping, Source={x:Static strings:Strings.Instance}}" Margin="0,6,0,8"
                                Padding="8,4" HorizontalAlignment="Left"
                                Click="SubmitMapping_Click"
                                Visibility="{Binding SelectedDevice.ShowSubmitMapping, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"/>
                            </Button.Style>
                        </Button>

                        <!-- Register / manage NFC tags (NFC readers only, issue #150) -->
                        <Button Content="{Binding Nfc_ManageButton, Source={x:Static strings:Strings.Instance}}" Margin="0,6,0,8"
                                Padding="8,4" HorizontalAlignment="Left"
                                Click="RegisterNfcTag_Click"
                                Visibility="{Binding SelectedDevice.ShowRegisterNfcTag, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"/>
                            </Button.Style>
                        </Button>

                        <Separator Margin="0,2,0,6"/>

                        <!-- Assign to slot -->
                        <TextBlock Text="{Binding Devices_VCAssignment, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}"
                                   Style="{StaticResource SectionEyebrow}" Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,6">
                            <ItemsControl ItemsSource="{Binding ActiveSlotItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton IsChecked="{Binding IsAssigned, Mode=OneWay}"
                                                      Command="{Binding DataContext.ToggleSlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding PadIndex}"
                                                      Margin="0,0,3,3" Padding="5,3"
                                                      ToolTip="{Binding Devices_ToggleAssignment, Source={x:Static strings:Strings.Instance}}">
                                            <ToggleButton.Style>
                                                <!-- The forge moment (#175): an assigned pill fills
                                                     with the ember gradient and glows. -->
                                                <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                                    <Style.Triggers>
                                                        <!-- Hover glow (#175): neutral hover, faint ember.
                                                             Before IsChecked so the assigned pill's own
                                                             ember glow wins while checked. -->
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Effect" Value="{StaticResource NeutralHoverGlow}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Foreground" Value="#FFFFF3E8"/>
                                                            <Setter Property="Background">
                                                                <Setter.Value>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                        <GradientStop Color="#FF6B2C" Offset="0"/>
                                                                        <GradientStop Color="#C43D0C" Offset="1"/>
                                                                    </LinearGradientBrush>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="#FF6B2C" BlurRadius="10" ShadowDepth="0" Opacity="0.35"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="10" VerticalAlignment="Center"/>
                                                <!-- Chip token: mono, mirrors the list-card badge. -->
                                                <TextBlock Text="{Binding SlotNumber}" FontFamily="{StaticResource TelemetryFontFamily}"
                                                           FontSize="10" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>

                        <Separator Margin="0,2,0,8"
                                   Visibility="{Binding SelectedDevice.ShowInputModeOrHidingSection, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <!-- ─── Input Mode (real gamepads only — virtual web/overlay sources skip) ─── -->
                        <StackPanel Visibility="{Binding SelectedDevice.ShowInputModeSection, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding Devices_InputMode, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}"
                                       Style="{StaticResource SectionEyebrow}" Margin="0,0,0,6"/>

                            <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      IsChecked="{Binding SelectedDevice.ForceRawJoystickMode, Mode=TwoWay}"
                                      Click="HidingToggle_Click"
                                      ToolTip="{Binding Devices_ForceRawTooltip, Source={x:Static strings:Strings.Instance}}"
                                      Margin="0,0,0,4">
                                <TextBlock Text="{Binding Devices_ForceRaw, Source={x:Static strings:Strings.Instance}}"
                                           TextWrapping="Wrap"/>
                            </CheckBox>

                            <Separator Margin="0,2,0,8"/>
                        </StackPanel>

                        <!-- ─── Input Hiding ─── -->
                        <TextBlock Text="{Binding Devices_InputHiding, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}"
                                   Style="{StaticResource SectionEyebrow}" Margin="0,0,0,6"
                                   Visibility="{Binding SelectedDevice.ShowInputHidingSection, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <CheckBox Content="{Binding Devices_HideFromGames, Source={x:Static strings:Strings.Instance}}"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  IsChecked="{Binding SelectedDevice.HidHideEnabled, Mode=TwoWay}"
                                  IsEnabled="{Binding SelectedDevice.IsHidHideAvailable}"
                                  Visibility="{Binding SelectedDevice.IsInternalVirtual, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                  Click="HidingToggle_Click"
                                  Margin="0,0,0,4">
                            <CheckBox.ToolTip>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Devices_HideTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedDevice.IsHidHideAvailable}" Value="False">
                                                    <Setter Property="Text" Value="{Binding Devices_HideTooltipInstall, Source={x:Static strings:Strings.Instance}}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </CheckBox.ToolTip>
                        </CheckBox>

                        <CheckBox Content="{Binding Devices_ConsumeMapped, Source={x:Static strings:Strings.Instance}}"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  IsChecked="{Binding SelectedDevice.ConsumeInputEnabled, Mode=TwoWay}"
                                  Click="HidingToggle_Click"
                                  ToolTip="{Binding Devices_ConsumeTooltip, Source={x:Static strings:Strings.Instance}}"
                                  Margin="0,0,0,4">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDevice.ShowConsumeToggle}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>

                        <Separator Margin="0,4,0,8"/>

                        <!-- ─── Power (#162, wireless controllers only) ─── -->
                        <StackPanel Visibility="{Binding SelectedDevice.ShowIdleDisconnect, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding Devices_Power, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}"
                                       Style="{StaticResource SectionEyebrow}" Margin="0,0,0,6"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                        ToolTip="{Binding Devices_IdleDisconnectTooltip, Source={x:Static strings:Strings.Instance}}">
                                <TextBlock Text="{Binding Devices_IdleDisconnect, Source={x:Static strings:Strings.Instance}}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBox Text="{Binding SelectedDevice.IdleDisconnectMinutes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         Width="60" VerticalAlignment="Center"
                                         LostFocus="IdleDisconnect_LostFocus"/>
                                <TextBlock Text="{Binding Devices_IdleDisconnectMinutes, Source={x:Static strings:Strings.Instance}}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>

                            <Separator Margin="0,2,0,8"/>
                        </StackPanel>

                        <!-- ─── Raw Input State (Visual) ─── -->
                        <TextBlock Text="{Binding Devices_RawInputState, Source={x:Static strings:Strings.Instance}, Converter={StaticResource UpperConverter}}"
                                   Style="{StaticResource SectionEyebrow}" Margin="0,0,0,8"/>

                        <!-- Axes label (joysticks/gamepads only) -->
                        <TextBlock Text="{Binding Devices_Axes, Source={x:Static strings:Strings.Instance}}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,3">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="{Binding HasRawData, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKeyboardDevice}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMouseDevice}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsTouchpadDevice}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMidiDevice}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsNfcDevice}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsConsumerDevice}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Axes: progress bars (joysticks/gamepads only) -->
                        <ItemsControl ItemsSource="{Binding RawAxes}" Margin="0,0,0,8">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKeyboardDevice}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMouseDevice}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsTouchpadDevice}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMidiDevice}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsNfcDevice}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsConsumerDevice}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   FontFamily="{StaticResource TelemetryFontFamily}"
                                                   VerticalAlignment="Center"/>
                                        <!-- Cold (#175): raw hardware truth on the shared
                                             instrument tray (recessed SteelGround + hairline). -->
                                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="1"
                                                     Value="{Binding NormalizedValue, Mode=OneWay}"
                                                     Style="{StaticResource InstrumentBarRaw}"
                                                     Foreground="{DynamicResource ColdBrush}"
                                                     Margin="4,0"/>
                                        <TextBlock Grid.Column="2" FontSize="9" Foreground="{DynamicResource ColdBrush}"
                                                   FontFamily="{StaticResource TelemetryFontFamily}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding RawValue}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Buttons label and grid: shown for any device that exposes
                             button slots (gamepads, joysticks, touchpads with a
                             click button). Keyboards / mice have their own
                             dedicated visual previews instead. -->
                        <TextBlock Text="{Binding Devices_Buttons, Source={x:Static strings:Strings.Instance}}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,3">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="{Binding HasRawData, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKeyboardDevice}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMouseDevice}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMidiDevice}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsNfcDevice}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsConsumerDevice}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding RawButtons}" Margin="0,0,0,8">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKeyboardDevice}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMouseDevice}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMidiDevice}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsNfcDevice}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsConsumerDevice}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="24" Height="24" CornerRadius="12" Margin="1"
                                            Style="{StaticResource RawCellBorder}"
                                            ToolTip="{Binding DisplayNumber, StringFormat='Button {0}'}">
                                        <TextBlock Text="{Binding DisplayNumber}" FontSize="8"
                                                   Style="{StaticResource RawCellLabel}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- NFC: named tag list (issue #150). Shown for NFC readers in
                             place of the numbered button grid; each registered tag (and
                             "Any NFC Tag") lights up when its tag is tapped. -->
                        <StackPanel Visibility="{Binding IsNfcDevice, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Margin="0,0,0,8">
                            <TextBlock Text="{Binding Nfc_Title, Source={x:Static strings:Strings.Instance}}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,3"/>
                            <ItemsControl ItemsSource="{Binding NfcTags}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Margin="0,1" Padding="8,5"
                                                Style="{StaticResource RawCellBorderActive}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ColdBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Text="{Binding Uid}" FontFamily="{StaticResource TelemetryFontFamily}"
                                                           FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"
                                                           Margin="8,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Consumer Control: named button chips (issue #168). Shown for
                             consumer collections in place of the numbered grid and the
                             empty axes section; each canonical button ("Play/Pause",
                             "Voice Command", the OK button) lights while held. -->
                        <StackPanel Visibility="{Binding IsConsumerDevice, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Margin="0,0,0,8">
                            <TextBlock Text="{Binding Devices_Buttons, Source={x:Static strings:Strings.Instance}}"
                                       FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,3"/>
                            <ItemsControl ItemsSource="{Binding ConsumerButtons}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Margin="2" Padding="8,4"
                                                Style="{StaticResource RawCellBorder}">
                                            <TextBlock Text="{Binding Name}" FontSize="11"
                                                       Style="{StaticResource RawCellLabel}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Keyboard: visual QWERTY layout -->
                        <TextBlock Text="{Binding Devices_Keyboard, Source={x:Static strings:Strings.Instance}}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,3">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKeyboardDevice}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Viewbox Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,8"
                                 StretchDirection="DownOnly">
                            <Viewbox.Style>
                                <Style TargetType="Viewbox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKeyboardDevice}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Viewbox.Style>
                            <ItemsControl ItemsSource="{Binding KeyboardKeys}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Width="556" Height="136"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding KeyWidth}" Height="{Binding KeyHeight}"
                                                CornerRadius="3"
                                                Style="{StaticResource RawCellBorder}"
                                                ToolTip="{Binding Label}">
                                            <TextBlock Text="{Binding Label}" FontSize="8"
                                                       Style="{StaticResource RawCellLabel}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="None"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Viewbox>

                        <!-- Mouse: visual mouse graphic -->
                        <TextBlock Text="{Binding Devices_Mouse, Source={x:Static strings:Strings.Instance}}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,3">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseDevice}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Viewbox Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,8"
                                 StretchDirection="DownOnly" MaxHeight="280">
                            <Viewbox.Style>
                                <Style TargetType="Viewbox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseDevice}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Viewbox.Style>
                            <local:MousePreviewControl/>
                        </Viewbox>

                        <!-- MIDI: same piano + CC visual as the Pad page MIDI
                             preview, full 0-127 range (issue #128). Notes and
                             CCs are separate previews so their section titles
                             are normal-size headers OUTSIDE the scaling Viewbox.
                             BindInput is wired in code-behind on selection. -->
                        <StackPanel Margin="0,0,0,8">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMidiDevice}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="{Binding Preview_NoteOutputs, Source={x:Static strings:Strings.Instance}}"
                                       FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,3"/>
                            <local:MidiPreviewView x:Name="MidiNotesPreview" Height="230" Margin="0,0,0,12"
                                                   HorizontalAlignment="Stretch"/>

                            <TextBlock Text="{Binding Preview_CCOutputs, Source={x:Static strings:Strings.Instance}}"
                                       FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,3"/>
                            <local:MidiPreviewView x:Name="MidiCcPreview" Height="230"
                                                   HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <!-- POV Hats: compass indicators -->
                        <TextBlock Text="{Binding Devices_DPadPOV, Source={x:Static strings:Strings.Instance}}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Margin="0,0,0,3">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RawPovs.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding RawPovs}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                        <Canvas Width="36" Height="36">
                                            <!-- Background circle -->
                                            <Ellipse Width="36" Height="36"
                                                     Fill="{DynamicResource SteelGroundBrush}" Stroke="{DynamicResource SteelLineBrush}"
                                                     StrokeThickness="1"/>
                                            <!-- Center dot -->
                                            <Ellipse Width="4" Height="4" Canvas.Left="16" Canvas.Top="16"
                                                     Fill="{DynamicResource SteelLineBrush}"/>
                                            <!-- Direction indicator line -->
                                            <Line X1="18" Y1="18" X2="18" Y2="5"
                                                  Stroke="{DynamicResource ColdBrush}"
                                                  StrokeThickness="2.5" StrokeEndLineCap="Round"
                                                  Effect="{StaticResource ColdDotGlow}">
                                                <Line.Style>
                                                    <Style TargetType="Line">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCentered}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Line.Style>
                                                <Line.RenderTransform>
                                                    <RotateTransform Angle="{Binding AngleDegrees}"
                                                                     CenterX="18" CenterY="18"/>
                                                </Line.RenderTransform>
                                            </Line>
                                        </Canvas>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <TextBlock FontSize="10" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Devices_POV, Source={x:Static strings:Strings.Instance}}"/>
                                            <TextBlock FontSize="10" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Index, Mode=OneWay}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Gyroscope -->
                        <TextBlock Text="{Binding Devices_Gyroscope, Source={x:Static strings:Strings.Instance}}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,3"
                                   Visibility="{Binding HasGyroData, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Border Visibility="{Binding HasGyroData, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="{DynamicResource SteelGroundBrush}" BorderBrush="{DynamicResource SteelLineBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="X" FontSize="10" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock FontSize="11" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}" HorizontalAlignment="Center"
                                               Text="{Binding GyroX, StringFormat='{}{0:F3}'}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Y" FontSize="10" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock FontSize="11" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}" HorizontalAlignment="Center"
                                               Text="{Binding GyroY, StringFormat='{}{0:F3}'}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Z" FontSize="10" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock FontSize="11" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}" HorizontalAlignment="Center"
                                               Text="{Binding GyroZ, StringFormat='{}{0:F3}'}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Accelerometer -->
                        <TextBlock Text="{Binding Devices_Accelerometer, Source={x:Static strings:Strings.Instance}}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,3"
                                   Visibility="{Binding HasAccelData, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Border Visibility="{Binding HasAccelData, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="{DynamicResource SteelGroundBrush}" BorderBrush="{DynamicResource SteelLineBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="X" FontSize="10" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock FontSize="11" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}" HorizontalAlignment="Center"
                                               Text="{Binding AccelX, StringFormat='{}{0:F3}'}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Y" FontSize="10" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock FontSize="11" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}" HorizontalAlignment="Center"
                                               Text="{Binding AccelY, StringFormat='{}{0:F3}'}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Z" FontSize="10" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock FontSize="11" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}" HorizontalAlignment="Center"
                                               Text="{Binding AccelZ, StringFormat='{}{0:F3}'}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Touchpad preview -->
                        <TextBlock Text="{Binding TouchpadLabel}"
                                   FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,3"
                                   Visibility="{Binding HasTouchpadData, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Border x:Name="TouchpadPreviewBorder"
                                Visibility="{Binding HasTouchpadData, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="{DynamicResource SteelGroundBrush}" BorderBrush="{DynamicResource SteelLineBrush}"
                                BorderThickness="1"
                                CornerRadius="6" Margin="0,0,0,8"
                                Height="100" ClipToBounds="True">
                            <Canvas>
                                <!-- Up to 5 simultaneous touchpad contacts.
                                     SDL gamepad pads typically expose 1-2;
                                     Windows PTP can deliver up to 5. Each
                                     dot's visibility binds to its own
                                     TouchpadDownN flag so unused slots
                                     stay hidden on devices that don't
                                     report that many contacts. -->
                                <Ellipse x:Name="TouchpadDot0" Width="14" Height="14" Fill="#CCFF6600"
                                         Effect="{StaticResource ColdDotGlow}"
                                         Visibility="{Binding TouchpadDown0, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Ellipse x:Name="TouchpadDot1" Width="14" Height="14" Fill="#CC0066FF"
                                         Effect="{StaticResource ColdDotGlow}"
                                         Visibility="{Binding TouchpadDown1, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Ellipse x:Name="TouchpadDot2" Width="14" Height="14" Fill="#CC4CAF50"
                                         Effect="{StaticResource ColdDotGlow}"
                                         Visibility="{Binding TouchpadDown2, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Ellipse x:Name="TouchpadDot3" Width="14" Height="14" Fill="#CCBA68C8"
                                         Effect="{StaticResource ColdDotGlow}"
                                         Visibility="{Binding TouchpadDown3, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Ellipse x:Name="TouchpadDot4" Width="14" Height="14" Fill="#CCFFEB3B"
                                         Effect="{StaticResource ColdDotGlow}"
                                         Visibility="{Binding TouchpadDown4, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Canvas>
                        </Border>

                        <!-- Second touchpad preview — shown only for multi-pad devices
                             (Steam Controller 2026 / Steam Deck / original Steam Controller). -->
                        <TextBlock Text="{Binding Touchpad2Label}"
                                   FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,3"
                                   Visibility="{Binding HasSecondTouchpadData, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Border x:Name="Touchpad2PreviewBorder"
                                Visibility="{Binding HasSecondTouchpadData, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="{DynamicResource SteelGroundBrush}" BorderBrush="{DynamicResource SteelLineBrush}"
                                BorderThickness="1"
                                CornerRadius="6" Margin="0,0,0,8"
                                Height="100" ClipToBounds="True">
                            <Canvas>
                                <Ellipse x:Name="Pad2Dot0" Width="14" Height="14" Fill="#CCFF6600"
                                         Effect="{StaticResource ColdDotGlow}"
                                         Visibility="{Binding Pad2Down0, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Ellipse x:Name="Pad2Dot1" Width="14" Height="14" Fill="#CC0066FF"
                                         Effect="{StaticResource ColdDotGlow}"
                                         Visibility="{Binding Pad2Down1, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Ellipse x:Name="Pad2Dot2" Width="14" Height="14" Fill="#CC4CAF50"
                                         Effect="{StaticResource ColdDotGlow}"
                                         Visibility="{Binding Pad2Down2, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Ellipse x:Name="Pad2Dot3" Width="14" Height="14" Fill="#CCBA68C8"
                                         Effect="{StaticResource ColdDotGlow}"
                                         Visibility="{Binding Pad2Down3, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Ellipse x:Name="Pad2Dot4" Width="14" Height="14" Fill="#CCFFEB3B"
                                         Effect="{StaticResource ColdDotGlow}"
                                         Visibility="{Binding Pad2Down4, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Canvas>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
