<UserControl x:Class="PadForge.Views.ColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:strings="clr-namespace:PadForge.Resources.Strings">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Saturation (X) × Value (Y) square. Solid hue base layer
                 darkens to black down the Y axis and to white across the
                 X axis. The white→hue and hue→black gradient stack is
                 the canonical Photoshop-style picker. -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource TextFillColorDisabledBrush}" BorderThickness="1">
                <Canvas x:Name="SvCanvas" Width="200" Height="200" Background="Transparent"
                        MouseLeftButtonDown="SvCanvas_MouseDown"
                        MouseMove="SvCanvas_MouseMove"
                        MouseLeftButtonUp="SvCanvas_MouseUp">
                    <Canvas.Resources>
                        <!-- Base hue layer; replaced from code-behind on hue change. -->
                    </Canvas.Resources>
                    <Rectangle x:Name="SvHueLayer" Width="200" Height="200"/>
                    <!-- White→transparent across X (saturation 0→1). -->
                    <Rectangle Width="200" Height="200">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <!-- Transparent→black down Y (value 1→0). -->
                    <Rectangle Width="200" Height="200">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#FF000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <!-- Crosshair cursor at the current S/V position. -->
                    <Ellipse x:Name="SvCursor" Width="14" Height="14"
                             Stroke="White" StrokeThickness="2"
                             Fill="Transparent" IsHitTestVisible="False"/>
                </Canvas>
            </Border>
            <!-- Hue selector — vertical strip cycling 0..360°. -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource TextFillColorDisabledBrush}" BorderThickness="1">
                <Canvas x:Name="HueCanvas" Width="24" Height="200" Background="Transparent"
                        MouseLeftButtonDown="HueCanvas_MouseDown"
                        MouseMove="HueCanvas_MouseMove"
                        MouseLeftButtonUp="HueCanvas_MouseUp">
                    <Rectangle Width="24" Height="200">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFFF0000" Offset="0.000"/>
                                <GradientStop Color="#FFFFFF00" Offset="0.166"/>
                                <GradientStop Color="#FF00FF00" Offset="0.333"/>
                                <GradientStop Color="#FF00FFFF" Offset="0.500"/>
                                <GradientStop Color="#FF0000FF" Offset="0.666"/>
                                <GradientStop Color="#FFFF00FF" Offset="0.833"/>
                                <GradientStop Color="#FFFF0000" Offset="1.000"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle x:Name="HueCursor" Width="28" Height="3"
                               Stroke="White" StrokeThickness="2"
                               Fill="Transparent" IsHitTestVisible="False"
                               Canvas.Left="-2"/>
                </Canvas>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
