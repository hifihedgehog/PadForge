<views:DialogWindow common:Reach.Class="UsersOwn" AutomationProperties.IsDialog="True" x:Class="PadForge.Views.NetworkPortDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        xmlns:common="clr-namespace:PadForge.Common"
        xmlns:controls="clr-namespace:PadForge.Controls"
        xmlns:views="clr-namespace:PadForge.Views"
        Title="{Binding Net_Port_Title, Source={x:Static strings:Strings.Instance}}"
        Subtitle="{Binding Net_Port_Subtitle, Source={x:Static strings:Strings.Instance}}">

    <!-- Change… on the network door's Port row (#600 item 53): another port
         from 1024 to 49151, which PadForge reserves and lets in in place of
         the old one. The user's alone. -->
    <views:DialogWindow.Foot>
        <controls:FlexLinePanel Style="{StaticResource DialogFootPanel}">
            <Button Style="{StaticResource DialogButton}" IsCancel="True"
                    Content="{Binding Common_Cancel, Source={x:Static strings:Strings.Instance}}"/>
            <Button Style="{StaticResource DialogPrimaryButton}" IsDefault="True" Click="Ok_Click"
                    AutomationProperties.AutomationId="Net_PortOk"
                    Content="{Binding Common_OK, Source={x:Static strings:Strings.Instance}}"/>
        </controls:FlexLinePanel>
    </views:DialogWindow.Foot>

    <StackPanel>
        <controls:SettingRow MinHeight="44">
            <TextBlock Style="{StaticResource DialogLabel}" Text="{Binding Net_Port_Label, Source={x:Static strings:Strings.Instance}}"/>
            <TextBox x:Name="PortBox" Width="100" MaxLength="5" TextAlignment="Right" Typography.NumeralAlignment="Tabular"
                     AutomationProperties.AutomationId="Net_PortBox"
                     AutomationProperties.Name="{Binding Net_Port_Label, Source={x:Static strings:Strings.Instance}}"/>
        </controls:SettingRow>
        <TextBlock x:Name="ErrorText" common:LiveText.Polite="True" Margin="160,4,0,0" FontSize="13" TextWrapping="Wrap"
                   Foreground="{DynamicResource WaitBrush}" Visibility="Collapsed"/>
    </StackPanel>
</views:DialogWindow>
