                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="RumbleHoldMode" SettingLabel="{Binding ResetLabel_HoldMode, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_RumbleHoldMode_2749"/>
                                            </StackPanel>
                                            <!-- Left motor strength -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_RumbleStrengthLeft_Label, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="100" Margin="0,0,8,0"/>
                                                <Slider Value="{Binding RumbleStrengthLeft, Mode=TwoWay}"
                                                        Minimum="0" Maximum="100" Width="220"
                                                        VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding RumbleStrengthLeft, Mode=TwoWay}" Width="60" Margin="8,0,0,0"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="%" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="RumbleStrengthLeft" SettingLabel="{Binding Macro_RumbleStrengthLeft_Label, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_RumbleStrengthLeft_2760"/>
                                            </StackPanel>
                                            <!-- Right motor strength -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_RumbleStrengthRight_Label, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="100" Margin="0,0,8,0"/>
                                                <Slider Value="{Binding RumbleStrengthRight, Mode=TwoWay}"
                                                        Minimum="0" Maximum="100" Width="220"
                                                        VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding RumbleStrengthRight, Mode=TwoWay}" Width="60" Margin="8,0,0,0"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="%" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="RumbleStrengthRight" SettingLabel="{Binding Macro_RumbleStrengthRight_Label, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_RumbleStrengthRight_2770"/>
                                            </StackPanel>
                                            <!-- Hold ms. Reactive only -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                                        Visibility="{Binding IsRumbleReactiveHold, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_RumbleHoldMs_Label, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="100" Margin="0,0,8,0"/>
                                                <Slider Value="{Binding RumbleHoldMs, Mode=TwoWay}"
                                                        Minimum="0" Maximum="5000" Width="220"
                                                        VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding RumbleHoldMs, Mode=TwoWay}" Width="80" Margin="8,0,0,0"/>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="RumbleHoldMs" SettingLabel="{Binding Macro_TriggerHoldMs_Label, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_RumbleHoldMs_2781" Margin="4,0,8,0"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </StackPanel>
                                            <!-- Fade ms. Reactive only -->
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding IsRumbleReactiveHold, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_RumbleFadeMs_Label, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="100" Margin="0,0,8,0"/>
                                                <Slider Value="{Binding RumbleFadeMs, Mode=TwoWay}"
                                                        Minimum="0" Maximum="5000" Width="220"
                                                        VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding RumbleFadeMs, Mode=TwoWay}" Width="80" Margin="8,0,0,0"/>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="RumbleFadeMs" SettingLabel="{Binding Macro_RumbleFadeMs_Label, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_RumbleFadeMs_2792" Margin="4,0,8,0"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Rumble Stop card. Shared by RumbleStop (main motors) and
                                         RumbleTriggerStop (trigger channel, #102). Title + body switch
                                         per action type. -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6"
                                            Visibility="{Binding IsAnyRumbleStopType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding RumbleStopEditorTitle}"
                                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding RumbleStopEditorBody}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Adaptive Trigger Effect card (#531): the trigger, the
                                         effect, its parameters by name within the ranges the
                                         #529 encoder takes, and how long it holds. -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6"
                                            Visibility="{Binding IsTriggerEffectType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MacroAction_Type_TriggerEffect, Source={x:Static strings:Strings.Instance}}"
                                                       FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MacroAction_TriggerEffect_Side, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="120" Margin="0,0,8,0"/>
                                                <ComboBox SelectedValue="{Binding TriggerEffectSide, Mode=TwoWay}"
                                                          SelectedValuePath="Tag" MinWidth="180"
                                                          AutomationProperties.Name="{Binding MacroAction_TriggerEffect_Side, Source={x:Static strings:Strings.Instance}}">
                                                    <ComboBoxItem Content="{Binding MacroAction_TriggerEffect_SideRight, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerEffectSide.Right}"/>
                                                    <ComboBoxItem Content="{Binding MacroAction_TriggerEffect_SideLeft, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerEffectSide.Left}"/>
                                                    <ComboBoxItem Content="{Binding MacroAction_TriggerEffect_SideBoth, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerEffectSide.Both}"/>
                                                </ComboBox>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="TriggerEffectSide" SettingLabel="{Binding MacroAction_TriggerEffect_Side, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_TriggerEffectSide_3300"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MacroAction_TriggerEffect_Effect, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="120" Margin="0,0,8,0"/>
                                                <ComboBox ItemsSource="{x:Static vm:TriggerEffectCatalog.Kinds}"
                                                          SelectedItem="{Binding TriggerEffectKind, Mode=TwoWay}"
                                                          DisplayMemberPath="Display" MinWidth="240"
                                                          AutomationProperties.Name="{Binding MacroAction_TriggerEffect_Effect, Source={x:Static strings:Strings.Instance}}"/>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="TriggerEffectMode" SettingLabel="{Binding MacroAction_TriggerEffect_Effect, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_TriggerEffectMode_3312"/>
                                            </StackPanel>
                                            <!-- One row per parameter of the chosen effect, named, with
                                                 the range the encoder accepts. -->
                                            <ItemsControl ItemsSource="{Binding TriggerEffectRows}" KeyboardNavigation.TabNavigation="Continue">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:TriggerEffectParameterValue}">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Label}"
                                                                       VerticalAlignment="Center" Width="120" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
                                                            <Slider Value="{Binding Value, Mode=TwoWay}" Minimum="{Binding Min}" Maximum="{Binding Max}"
                                                                    IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="1"
                                                                    Width="220" VerticalAlignment="Center"
                                                                    AutomationProperties.Name="{Binding Label, TargetNullValue=''}"/>
                                                            <TextBox Text="{Binding Value, Mode=TwoWay}" Width="60" Margin="8,0,0,0"
                                                                     AutomationProperties.Name="{Binding Label, TargetNullValue=''}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding MacroAction_TriggerEffect_Invalid, Source={x:Static strings:Strings.Instance}}"
                                                       FontSize="11" TextWrapping="Wrap" Margin="0,2,0,4"
                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                       Visibility="{Binding TriggerEffectIsValid, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MacroAction_TriggerEffect_Hold, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="120" Margin="0,0,8,0"/>
                                                <ComboBox SelectedValue="{Binding TriggerEffectHold, Mode=TwoWay}"
                                                          SelectedValuePath="Tag" MinWidth="240"
                                                          AutomationProperties.Name="{Binding MacroAction_TriggerEffect_Hold, Source={x:Static strings:Strings.Instance}}">
                                                    <ComboBoxItem Content="{Binding MacroAction_TriggerEffect_HoldRelease, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerEffectHold.UntilRelease}"/>
                                                    <ComboBoxItem Content="{Binding MacroAction_TriggerEffect_HoldDuration, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerEffectHold.Duration}"/>
                                                    <ComboBoxItem Content="{Binding MacroAction_TriggerEffect_HoldStopped, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerEffectHold.UntilStopped}"/>
                                                </ComboBox>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="TriggerEffectHold" SettingLabel="{Binding MacroAction_TriggerEffect_Hold, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_TriggerEffectHold_3349"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                                        Visibility="{Binding IsTriggerEffectTimed, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MacroAction_TriggerEffect_Duration, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="120" Margin="0,0,8,0"/>
                                                <Slider Value="{Binding TriggerEffectMs, Mode=TwoWay}"
                                                        Minimum="1" Maximum="60000" Width="220"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="{Binding MacroAction_TriggerEffect_Duration, Source={x:Static strings:Strings.Instance}}"/>
                                                <TextBox Text="{Binding TriggerEffectMs, Mode=TwoWay}" Width="80" Margin="8,0,0,0"
                                                         AutomationProperties.Name="{Binding MacroAction_TriggerEffect_Duration, Source={x:Static strings:Strings.Instance}}"/>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="TriggerEffectMs" SettingLabel="{Binding MacroAction_TriggerEffect_Duration, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_TriggerEffectMs_3362" Margin="4,0,8,0"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding MacroAction_TriggerEffect_Hint, Source={x:Static strings:Strings.Instance}}"
                                                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Stop Adaptive Trigger Effect card (#531): which trigger. -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6"
                                            Visibility="{Binding IsTriggerEffectStopType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MacroAction_Type_TriggerEffectStop, Source={x:Static strings:Strings.Instance}}"
                                                       FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MacroAction_TriggerEffect_Side, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="120" Margin="0,0,8,0"/>
                                                <ComboBox SelectedValue="{Binding TriggerEffectSide, Mode=TwoWay}"
                                                          SelectedValuePath="Tag" MinWidth="180"
                                                          AutomationProperties.Name="{Binding MacroAction_TriggerEffect_Side, Source={x:Static strings:Strings.Instance}}">
                                                    <ComboBoxItem Content="{Binding MacroAction_TriggerEffect_SideRight, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerEffectSide.Right}"/>
                                                    <ComboBoxItem Content="{Binding MacroAction_TriggerEffect_SideLeft, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerEffectSide.Left}"/>
                                                    <ComboBoxItem Content="{Binding MacroAction_TriggerEffect_SideBoth, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerEffectSide.Both}"/>
                                                </ComboBox>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="TriggerEffectSide" SettingLabel="{Binding MacroAction_TriggerEffect_Side, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_TriggerEffectSide_3384"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding MacroAction_TriggerEffectStop_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Play Sound card (issue #83). File + volume + loop + preview -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6"
                                            Visibility="{Binding IsPlaySoundType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MacroAction_Type_PlaySound, Source={x:Static strings:Strings.Instance}}"
                                                       FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Sound_File_Label, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="80" Margin="0,0,8,0"/>
                                                <TextBox Text="{Binding SoundFilePath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Width="260" VerticalAlignment="Center"
                                                         ToolTip="{Binding SoundFilePath}"/>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="SoundFilePath" SettingLabel="{Binding Macro_Sound_File_Label, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_SoundFilePath_2824" Margin="4,0,8,0"/>
                                                <Button Content="{Binding Macro_Sound_Browse, Source={x:Static strings:Strings.Instance}}"
                                                        Click="BrowseSoundFile_Click" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                <Button Content="{Binding Macro_Sound_Preview, Source={x:Static strings:Strings.Instance}}"
                                                        Click="PreviewSoundFile_Click" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Sound_Volume_Label, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="80" Margin="0,0,8,0"/>
                                                <Slider Value="{Binding SoundVolume, Mode=TwoWay}" Minimum="0" Maximum="100"
                                                        Width="180" VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding SoundVolume, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="%" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="SoundVolume" SettingLabel="{Binding Macro_Sound_Volume_Label, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_SoundVolume_2834"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsChecked="{Binding SoundLoop, Mode=TwoWay}"
                                                          Content="{Binding Macro_Sound_Loop, Source={x:Static strings:Strings.Instance}}"
                                                          ToolTip="{Binding Macro_Sound_Loop_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="SoundLoop" SettingLabel="{Binding Macro_Sound_Loop, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_SoundLoop_2841"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Stop Sounds card (issue #83) -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6"
                                            Visibility="{Binding IsSoundStopType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MacroAction_Type_SoundStop, Source={x:Static strings:Strings.Instance}}"
                                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding MacroAction_SoundStop_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Axis target + value for AxisSet / AxisHold plus the v19 M1
                                         ToggleVcAxis latch and RepeatVcAxisWhileHeld turbo. The
                                         AxisAdd relative deflection (discussion #237) rides the same
                                         pair, reading the signed value as the per-frame add. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                                Visibility="{Binding IsAnyAxisValueType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_Axis, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                   Width="80" Margin="0,0,8,0"/>
                                        <ComboBox SelectedValue="{Binding AxisTarget, Mode=TwoWay}"
                                                  SelectedValuePath="Tag" MinWidth="120">
                                            <ComboBoxItem Content="{Binding Common_None, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.None}"/>
                                            <ComboBoxItem Content="{Binding Macro_LeftStickX, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftStickX}"/>
                                            <ComboBoxItem Content="{Binding Macro_LeftStickY, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftStickY}"/>
                                            <ComboBoxItem Content="{Binding Macro_RightStickX, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightStickX}"/>
                                            <ComboBoxItem Content="{Binding Macro_RightStickY, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightStickY}"/>
                                            <ComboBoxItem Content="{Binding Macro_LeftTrigger, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftTrigger}"/>
                                            <ComboBoxItem Content="{Binding Macro_RightTrigger, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightTrigger}"/>
                                            <!-- The virtual DualShock 3's button pressures (#530), on the
                                                 DualShock 3 (SIXAXIS): Full preset only. -->
                                            <ComboBoxItem Content="{Binding ButtonA, Source={x:Static vm:MacroPressureLabels.Instance}}" Tag="{x:Static vm:MacroAxisTarget.PressureButtonA}"
                                                          Visibility="{Binding CarriesPressure, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <ComboBoxItem Content="{Binding ButtonB, Source={x:Static vm:MacroPressureLabels.Instance}}" Tag="{x:Static vm:MacroAxisTarget.PressureButtonB}"
                                                          Visibility="{Binding CarriesPressure, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <ComboBoxItem Content="{Binding ButtonX, Source={x:Static vm:MacroPressureLabels.Instance}}" Tag="{x:Static vm:MacroAxisTarget.PressureButtonX}"
                                                          Visibility="{Binding CarriesPressure, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <ComboBoxItem Content="{Binding ButtonY, Source={x:Static vm:MacroPressureLabels.Instance}}" Tag="{x:Static vm:MacroAxisTarget.PressureButtonY}"
                                                          Visibility="{Binding CarriesPressure, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <ComboBoxItem Content="{Binding LeftShoulder, Source={x:Static vm:MacroPressureLabels.Instance}}" Tag="{x:Static vm:MacroAxisTarget.PressureLeftShoulder}"
                                                          Visibility="{Binding CarriesPressure, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <ComboBoxItem Content="{Binding RightShoulder, Source={x:Static vm:MacroPressureLabels.Instance}}" Tag="{x:Static vm:MacroAxisTarget.PressureRightShoulder}"
                                                          Visibility="{Binding CarriesPressure, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <ComboBoxItem Content="{Binding DPadUp, Source={x:Static vm:MacroPressureLabels.Instance}}" Tag="{x:Static vm:MacroAxisTarget.PressureDPadUp}"
                                                          Visibility="{Binding CarriesPressure, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <ComboBoxItem Content="{Binding DPadDown, Source={x:Static vm:MacroPressureLabels.Instance}}" Tag="{x:Static vm:MacroAxisTarget.PressureDPadDown}"
                                                          Visibility="{Binding CarriesPressure, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <ComboBoxItem Content="{Binding DPadLeft, Source={x:Static vm:MacroPressureLabels.Instance}}" Tag="{x:Static vm:MacroAxisTarget.PressureDPadLeft}"
                                                          Visibility="{Binding CarriesPressure, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <ComboBoxItem Content="{Binding DPadRight, Source={x:Static vm:MacroPressureLabels.Instance}}" Tag="{x:Static vm:MacroAxisTarget.PressureDPadRight}"
                                                          Visibility="{Binding CarriesPressure, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </ComboBox>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="AxisTarget" SettingLabel="{Binding Macro_Axis, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_AxisTarget_2866" Margin="4,0,8,0"/>
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Macro_AxisValue, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
