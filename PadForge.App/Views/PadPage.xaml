                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="ScreenMode" SettingLabel="{Binding DreamcastScreen_Mode_Label, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_ScreenMode_13105"/>
                                            </StackPanel>
                                            <TextBlock common:BidiText.Text="{Binding MacroAction_KeyboardScreenMode_Hint, Source={x:Static strings:Strings.Instance}}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
