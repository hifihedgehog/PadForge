                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Summary}"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center" Margin="12,0"/>
                                                <Button Grid.Column="2"
                                                        Content="{Binding Common_Remove, Source={x:Static strings:Strings.Instance}}"
                                                        Command="{Binding DataContext.DeleteTouchpadGestureCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="8,2"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="{Binding Pad_Touchpad_RecordNew, Source={x:Static strings:Strings.Instance}}"
                                        Command="{Binding RecordTouchpadGestureCommand}"
                                        HorizontalAlignment="Left" Padding="10,4"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ Wheel (Tag 11) — native-FFB wheels only ═══ -->
            <TabItem>
                <ScrollViewer Padding="24,0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Viewbox Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="{DynamicResource EmberBrush}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M9.4,12 A2.6,2.6 0 1 1 14.6,12 A2.6,2.6 0 1 1 9.4,12 Z M9.4,12 L2.2,12 M14.6,12 L21.8,12 M12,14.6 L12,21.8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding Pad_Wheel, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource TitleTextBlockStyle}" FontFamily="{StaticResource DisplayFontFamily}" FontWeight="650" FontSize="26"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Pad_Wheel_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Viewbox Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="{DynamicResource EmberBrush}" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M9.4,12 A2.6,2.6 0 1 1 14.6,12 A2.6,2.6 0 1 1 9.4,12 Z M9.4,12 L2.2,12 M14.6,12 L21.8,12 M12,14.6 L12,21.8"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding Pad_Wheel, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding ResetWheelAllCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetWheel, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Rotation range — wheel hardware steering lock (not a force).
                                     Native HID command (vendor wheels only); hidden for generic
                                     SDL wheels, which expose no set-range API. -->
                                <StackPanel x:Name="WheelRangeRow" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Pad_Wheel_RotationRange, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding WheelRotationRange, Mode=TwoWay}" Minimum="40" Maximum="2520"
                                            Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding WheelRotationRange, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="&#176;" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetWheelRotationRangeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetRotationRange, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Auto-center — centering spring force -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Pad_Wheel_Autocenter, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding WheelAutoCenter, Mode=TwoWay}" Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding WheelAutoCenter, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetWheelAutoCenterCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetAutocenter, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- RPM shift LEDs — telemetry-driven rev display.
                                     Native HID command (vendor wheels only); hidden for generic
                                     SDL wheels, which have no addressable rev strip. -->
                                <StackPanel x:Name="WheelRpmRow" Orientation="Horizontal" Margin="0,4,0,0">
                                    <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsChecked="{Binding WheelRpmLeds, Mode=TwoWay}"
                                              Content="{Binding Pad_Wheel_RpmLeds, Source={x:Static strings:Strings.Instance}}"
                                              VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding ResetWheelRpmLedsCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetRpmLeds, Source={x:Static strings:Strings.Instance}}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- === TAB 12: Audio (slot-level, issue #83) === -->
            <TabItem>
                <ScrollViewer Padding="24,0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE767;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Pad_Audio_Header, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource TitleTextBlockStyle}" FontFamily="{StaticResource DisplayFontFamily}" FontWeight="650" FontSize="26"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Pad_Audio_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- Sound Output card -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE7F5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_Audio_Output_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <ui:Button Command="{Binding ResetSoundOutputAllCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_Audio_Reset_All, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Pad_Audio_Output_Desc, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}"/>
                                <!-- Per assigned device, by convention: this toggle (and the
                                     speaker routing of macro sounds) follows the device selected
                                     in the assigned-devices dropdown. No output picker. -->
                                <CheckBox Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsChecked="{Binding PlayStationConfig.AudioPassthroughEnabled, Mode=TwoWay}"
                                          Content="{Binding Pad_Audio_Mirror, Source={x:Static strings:Strings.Instance}}"
                                          ToolTip="{Binding Pad_Audio_Mirror_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                          Margin="0,0,0,8"
                                          Visibility="{Binding SelectedDeviceHasSpeaker, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <!-- Mirror SOURCE: which playback device feeds the mirror.
                                     "" = system default. Lets games that send specific
                                     sounds to a separate playback device target the pad. -->
                                <StackPanel Orientation="Horizontal" Margin="20,0,0,8"
                                            Visibility="{Binding SelectedDeviceHasSpeaker, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Audio_MirrorSource_Label, Source={x:Static strings:Strings.Instance}}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <!-- SelectedValuePath/DisplayMemberPath MUST precede the
                                         ItemsSource/SelectedValue bindings: XAML applies
                                         attributes in order, and a SelectedValue that attaches
                                         before SelectedValuePath is set fails to resolve and
                                         never retries — the closed box renders blank. -->
                                    <ComboBox SelectedValuePath="Id" DisplayMemberPath="Name"
                                              ItemsSource="{Binding MirrorSourceOptions}"
                                              SelectedValue="{Binding SelectedMirrorSourceId, Mode=TwoWay}"
                                              MinWidth="260" MaxWidth="380"
                                              DropDownOpened="MirrorSource_DropDownOpened"
                                              IsEnabled="{Binding PlayStationConfig.AudioPassthroughEnabled}"
                                              ToolTip="{Binding Pad_Audio_MirrorSource_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Pad_Audio_NoSpeaker, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}"
                                           Visibility="{Binding SelectedDeviceHasNoSpeaker, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Pad_Audio_MasterVolume, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding SoundMasterVolume, Mode=TwoWay}" Minimum="0" Maximum="100" Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding SoundMasterVolume, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                    <ui:Button Command="{Binding ResetSoundMasterVolumeCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_Audio_Reset_MasterVolume, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding Pad_Audio_Test, Source={x:Static strings:Strings.Instance}}"
                                            Command="{Binding SoundTestCommand}" Padding="10,4" VerticalAlignment="Center"
                                            ToolTip="{Binding Pad_Audio_Test_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Audio_StopAll, Source={x:Static strings:Strings.Instance}}"
                                            Command="{Binding SoundStopAllCommand}" Padding="10,4" Margin="6,0,0,0" VerticalAlignment="Center"
                                            ToolTip="{Binding Pad_Audio_StopAll_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Sound Macros hub card -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xEC4F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_Audio_Macros_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Pad_Audio_Macros_Desc, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}"/>
                                <Button Content="{Binding Pad_Audio_NewSoundMacro, Source={x:Static strings:Strings.Instance}}"
                                        Command="{Binding AddSoundMacroCommand}" Padding="10,4" HorizontalAlignment="Left"
                                        Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding Pad_Audio_NoSoundMacros, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}"
                                           Visibility="{Binding HasNoSoundMacros, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <ItemsControl ItemsSource="{Binding SoundMacros}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="SoundMacroRow_Click" HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left" Margin="0,0,0,4" Padding="8,5"
                                                    ToolTip="{Binding Pad_Audio_OpenMacro_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xEC4F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding SoundFilesSummary}" VerticalAlignment="Center"
                                                               Margin="10,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Sound Packages card -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_Audio_Packages_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Pad_Audio_Packages_Desc, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="{Binding Pad_Audio_Packages_Add, Source={x:Static strings:Strings.Instance}}"
                                            Click="PackageAdd_Click" Padding="10,4"
                                            ToolTip="{Binding Pad_Audio_Packages_Add_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Audio_Packages_Create, Source={x:Static strings:Strings.Instance}}"
                                            Click="PackageCreate_Click" Padding="10,4" Margin="6,0,0,0"
                                            ToolTip="{Binding Pad_Audio_Packages_Create_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Common_Remove, Source={x:Static strings:Strings.Instance}}"
                                            Click="PackageRemove_Click" Padding="10,4" Margin="6,0,0,0"
                                            ToolTip="{Binding Pad_Audio_Packages_Remove_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <TextBlock x:Name="SoundPackagesEmptyText"
                                           Text="{Binding Pad_Audio_Packages_Empty, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}"/>
                                <ListBox x:Name="SoundPackagesList" MaxHeight="170">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Path}" VerticalAlignment="Center"
                                                           Margin="10,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- === TAB 13: Pointer (Wii Remote IR camera tuning, issue #146) === -->
            <TabItem>
                <ScrollViewer Padding="24,0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE8B0;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Pad_Pointer_Header, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource TitleTextBlockStyle}" FontFamily="{StaticResource DisplayFontFamily}" FontWeight="650" FontSize="26"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Pad_Pointer_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{Binding Pad_Pointer_TuningTitle, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>

                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Pointer_SensorBar, Source={x:Static strings:Strings.Instance}}"
                                           Margin="0,0,0,4"/>
                                <ComboBox Width="240" HorizontalAlignment="Left"
                                          SelectedIndex="{Binding IrSensorBarPos, Mode=TwoWay}">
                                    <ComboBoxItem Content="{Binding Pad_Pointer_SensorBar_Centered, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBoxItem Content="{Binding Pad_Pointer_SensorBar_Above, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBoxItem Content="{Binding Pad_Pointer_SensorBar_Below, Source={x:Static strings:Strings.Instance}}"/>
                                </ComboBox>

                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Pointer_Compensation, Source={x:Static strings:Strings.Instance}}"
                                           Margin="0,12,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <Slider Value="{Binding IrSensorBarCompPercent, Mode=TwoWay}"
                                            Minimum="0" Maximum="50" Width="240" VerticalAlignment="Center"/>
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding IrSensorBarCompPercent, StringFormat={}{0}%}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="36"/>
                                </StackPanel>

                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Pad_Pointer_Smoothing, Source={x:Static strings:Strings.Instance}}"
                                           Margin="0,12,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <Slider Value="{Binding IrSmoothingPercent, Mode=TwoWay}"
                                            Minimum="0" Maximum="100" Width="240" VerticalAlignment="Center"/>
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding IrSmoothingPercent, StringFormat={}{0}%}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="36"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
