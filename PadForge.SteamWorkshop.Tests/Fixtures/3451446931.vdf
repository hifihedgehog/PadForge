"controller_mappings"
{
	"version"		"3"
	"revision"		"193"
	"title"		"EPICMAN's Steam Deck/Game Pad Layout"
	"description"		"A New Ergonomic Control Layout, aiming for a Friction-less player experience. All inputs are labeled, hold L3 for sub layout (See 'secondary' in layout), Redundant mouse inputs for ergonomics, Virtual menu on left track pad for essential systems. Room for personal customization, message MrMcDerpy420 on Reddit for help editing. ENJOY!!"
	"creator"		"76561198043710255"
	"progenitor"		""
