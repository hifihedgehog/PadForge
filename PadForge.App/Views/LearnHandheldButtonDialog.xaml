<ui:FluentWindow x:Class="PadForge.Views.LearnHandheldButtonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Title="{Binding Handheld_Title, Source={x:Static strings:Strings.Instance}}"
        Height="640" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Dialog head (#175 item 11): same chrome as the NFC dialog. -->
        <Border Padding="14"
                BorderBrush="{DynamicResource SteelLineSoftBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5"
                           Fill="{DynamicResource EmberBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontFamily="{StaticResource DisplayFontFamily}"
                           FontWeight="SemiBold" FontSize="15"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           TextTrimming="CharacterEllipsis"/>
                <ui:Button Grid.Column="2" Style="{StaticResource EmberIconButton}"
                           VerticalAlignment="Center" Click="CloseButton_Click"
                           ToolTip="{Binding Common_Close, Source={x:Static strings:Strings.Instance}}">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </ui:Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding Handheld_LearnHeader, Source={x:Static strings:Strings.Instance}}" FontFamily="{StaticResource DisplayFontFamily}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1" Text="{Binding Handheld_Intro, Source={x:Static strings:Strings.Instance}}"
                       TextWrapping="Wrap" Margin="0,0,0,8"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <!-- Machine line plus the daemon notice: the vendor tool keeps
                 reacting to the same buttons until it is stopped. -->
            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Handheld_MachineLabel, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="MachineText" VerticalAlignment="Center" FontFamily="{StaticResource TelemetryFontFamily}"/>
                </StackPanel>
                <TextBlock x:Name="DaemonText" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11"
                           Foreground="{DynamicResource EmberBrush}" Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="StartBtn" Content="{Binding Handheld_StartButton, Source={x:Static strings:Strings.Instance}}"
                        Click="StartButton_Click" MinWidth="120" Margin="0,0,12,0"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- What the press produced: the chord line, and a candidate
                 picker when a report changed in more than one place. -->
            <StackPanel Grid.Row="4" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="{Binding Handheld_SourceLabel, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="ChordText" VerticalAlignment="Center" FontFamily="{StaticResource TelemetryFontFamily}"
                               Text="{Binding Nfc_Waiting, Source={x:Static strings:Strings.Instance}}"/>
                </StackPanel>
                <ComboBox x:Name="CandidateBox" Width="480" HorizontalAlignment="Left" Visibility="Collapsed"
                          DisplayMemberPath="Description"/>
            </StackPanel>

            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="{Binding Handheld_NameLabel, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="NameBox" Width="240" VerticalAlignment="Center" Margin="0,0,8,0"
                         KeyDown="NameBox_KeyDown"/>
                <Button x:Name="RegisterBtn" Content="{Binding Handheld_RegisterButton, Source={x:Static strings:Strings.Instance}}" Click="RegisterButton_Click"
                        MinWidth="90" IsEnabled="False"
                        Style="{StaticResource EmberAccentButton}"/>
            </StackPanel>

            <TextBlock Grid.Row="6" Text="{Binding Handheld_RegisteredHeader, Source={x:Static strings:Strings.Instance}}" FontWeight="SemiBold" Margin="0,4,0,4"/>

            <TextBlock Grid.Row="7" x:Name="EmptyText" Text="{Binding Handheld_NoneLearned, Source={x:Static strings:Strings.Instance}}"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" Margin="0,0,0,4"/>

            <ListBox Grid.Row="8" x:Name="ButtonListBox" MinHeight="100">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource EmberSelectListItem}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="8,6"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Name}"/>
                                <TextBlock Text="{Binding Description}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{Binding Common_Remove, Source={x:Static strings:Strings.Instance}}" Click="RemoveButton_Click"
                                    Style="{StaticResource EmberDestructiveButton}"
                                    Tag="{Binding Button}" MinWidth="72" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Footer: share the learned set as a file, or bring one in.
                 Close stays neutral (Register lives beside the name). -->
            <Grid Grid.Row="9" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="{Binding Handheld_Export, Source={x:Static strings:Strings.Instance}}" MinWidth="90" Margin="0,0,8,0" Click="ExportButton_Click"/>
                    <Button Content="{Binding Handheld_Import, Source={x:Static strings:Strings.Instance}}" MinWidth="90" Click="ImportButton_Click"/>
                </StackPanel>
                <Button Content="{Binding Common_Close, Source={x:Static strings:Strings.Instance}}" MinWidth="90" IsCancel="True" Click="CloseButton_Click" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
