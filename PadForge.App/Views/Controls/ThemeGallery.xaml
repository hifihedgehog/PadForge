<UserControl x:Class="PadForge.Views.Controls.ThemeGallery"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:strings="clr-namespace:PadForge.Resources.Strings"
             xmlns:controls="clr-namespace:PadForge.Controls"
             xmlns:local="clr-namespace:PadForge.Views.Controls">
    <!-- The theme gallery (#591), under the Theme row of Settings'
         Appearance card. Each tile is a small PadForge in that theme's
         colors, with a window into its picture, and a click picks it.
         System, Light and Dark come first, then the starters, then the
         theme files the user listed. A theme file's tile has two small
         buttons under the pointer or while it is picked: one opens it in
         the builder, the other takes it off the list and leaves the file.
         From the keyboard the arrows pick, Enter opens a theme file in the
         builder and Delete takes it off the list. -->
    <UserControl.Resources>
        <!-- One face of a tile: the page, a card with the accent's pill and
             a line of text, and the three colors as dots. -->
        <DataTemplate x:Key="TileFace" DataType="{x:Type local:ThemeTileFace}">
            <!-- A tile is a picture of the app with a theme's picture in
                 it: under a right-to-left language it stays as drawn. -->
            <Grid Width="140" Height="88" Background="{Binding Ground}" FlowDirection="LeftToRight">
                <Rectangle Height="67.2" VerticalAlignment="Top" Fill="{Binding Picture}"/>
                <Border Margin="11,11,11,0" Height="43" VerticalAlignment="Top" CornerRadius="6"
                        Background="{Binding Card}" BorderBrush="{Binding Line}" BorderThickness="1">
                    <StackPanel>
                        <Border Width="40" Height="11" CornerRadius="5.5" Background="{Binding Accent}"
                                HorizontalAlignment="Left" Margin="8,8,0,0"/>
                        <Border Width="64" Height="5" CornerRadius="2.5" Background="{Binding TextLine}"
                                HorizontalAlignment="Left" Margin="8,7,0,0"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,11">
                    <Ellipse Width="11" Height="11" Fill="{Binding Accent}" Margin="0,0,6,0"/>
                    <Ellipse Width="11" Height="11" Fill="{Binding Secondary}" Margin="0,0,6,0"/>
                    <Ellipse Width="11" Height="11" Fill="{Binding Attention}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- A small round button at a theme file's tile. -->
        <Style x:Key="TileButton" TargetType="controls:ClickBorder">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource SteelLiftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SteelLineBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SteelRaisedBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TileItem" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding SpokenName, TargetNullValue=''}"/>
            <Setter Property="ToolTip" Value="{Binding Tip}"/>
            <Setter Property="Margin" Value="0,0,8,12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <StackPanel Width="148" Background="Transparent">
                            <Grid>
                                <!-- The ring of the picked tile, 2 out from the tile's own edge. -->
                                <Border x:Name="Ring" CornerRadius="10" BorderThickness="2" Padding="2"
                                        BorderBrush="Transparent" HorizontalAlignment="Left">
                                    <Grid Width="140" Height="88">
                                        <Grid.Clip>
                                            <RectangleGeometry Rect="0,0,140,88" RadiusX="7" RadiusY="7"/>
                                        </Grid.Clip>
                                        <ContentPresenter Content="{Binding Face}" ContentTemplate="{StaticResource TileFace}"/>
                                        <!-- System: the other ground's face across the lower right half. -->
                                        <ContentPresenter x:Name="Other" Content="{Binding OtherFace}" ContentTemplate="{StaticResource TileFace}">
                                            <ContentPresenter.Clip>
                                                <PathGeometry Figures="M140,0 L140,88 L0,88 Z"/>
                                            </ContentPresenter.Clip>
                                        </ContentPresenter>
                                    </Grid>
                                </Border>
                                <Border CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource SteelLineBrush}"
                                        Width="140" Height="88" Margin="4" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        IsHitTestVisible="False"/>
                                <StackPanel x:Name="FileButtons" Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Top" Margin="0,-5,-1,0" Visibility="Collapsed">
                                    <controls:ClickBorder Style="{StaticResource TileButton}" Tag="{Binding Id}" Click="EditTile_Click"
                                                          ToolTip="{Binding Settings_ThemeEdit, Source={x:Static strings:Strings.Instance}}">
                                        <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </controls:ClickBorder>
                                    <controls:ClickBorder Style="{StaticResource TileButton}" Tag="{Binding Id}" Click="RemoveTile_Click"
                                                          ToolTip="{Binding Settings_ThemeRemoveTip, Source={x:Static strings:Strings.Instance}}">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </controls:ClickBorder>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="13" Margin="4,6,0,0"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="LookText" Text="{Binding Look}" FontSize="12" Margin="4,1,0,0"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock x:Name="FaultText" Text="{Binding FaultText}" FontSize="12" Margin="4,1,0,0"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       Foreground="{DynamicResource WaitBrush}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource EmberBrush}"/>
                                <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsKeyboardFocused" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource ColdBrush}"/>
                            </MultiTrigger>
                            <DataTrigger Binding="{Binding OtherFace}" Value="{x:Null}">
                                <Setter TargetName="Other" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Look}" Value="{x:Null}">
                                <Setter TargetName="LookText" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding FaultText}" Value="{x:Null}">
                                <Setter TargetName="FaultText" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsFile}" Value="True"/>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="FileButtons" Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsFile}" Value="True"/>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="FileButtons" Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <ListBox x:Name="Tiles" Background="Transparent" BorderThickness="0" Padding="0"
                 ItemContainerStyle="{StaticResource TileItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 SelectionChanged="Tiles_SelectionChanged" PreviewKeyDown="Tiles_PreviewKeyDown"
                 AutomationProperties.AutomationId="Settings_ThemeGallery"
                 AutomationProperties.Name="{Binding Settings_Theme, Source={x:Static strings:Strings.Instance}}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Template>
                <!-- No scroll viewer of its own: the page scrolls, and the
                     wheel over the gallery must scroll the page. -->
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter/>
                </ControlTemplate>
            </ListBox.Template>
        </ListBox>
        <!-- Why the picked theme is not the one showing: a profile's game
             look is up, or the picked file is gone. -->
        <TextBlock x:Name="Note" FontSize="13" Margin="4,0,12,8" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
</UserControl>
