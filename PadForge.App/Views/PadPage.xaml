                                                  ToolTip="{Binding Pad_Wheel_SetRotationRangeTooltip, Source={x:Static strings:Strings.Instance}}"
                                                  IsChecked="{Binding WheelRotationRangeEnabled, Mode=TwoWay}"/>
                                        <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="WheelRotationRangeEnabled" SettingLabel="{Binding Pad_Wheel_SetRotationRange, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_PadViewModel_WheelRotationRangeEnabled_12112"/>
                                    </controls:SettingRow>
                                    <controls:SettingRow MinHeight="44" IsEnabled="{Binding WheelRotationRangeEnabled}">
                                        <TextBlock Text="{Binding Pad_Wheel_RotationRange, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzSubLabel}"/>
