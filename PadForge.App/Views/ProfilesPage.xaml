<UserControl x:Class="PadForge.Views.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:strings="clr-namespace:PadForge.Resources.Strings"
             xmlns:controls="clr-namespace:PadForge.Controls"
             xmlns:services="clr-namespace:PadForge.Services"
             xmlns:vm="clr-namespace:PadForge.ViewModels">

    <UserControl.Resources>
        <!-- The joining words of a shortcut row: when, on, and the plus
             between two buttons. -->
        <Style x:Key="ShortcutWord" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <!-- A button of a shortcut, as the board draws a key: 26 tall with
             corners of 7 on the band's fill, its name at 12.5. -->
        <Style x:Key="ShortcutKey" TargetType="Border">
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SteelLineBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SteelBandBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="TextElement.FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- A controller type and its count on a profile's card: a pill 26
             tall on the band's fill, the type's own symbol and the number in
             one light steel. -->
        <Style x:Key="TypeChip" TargetType="Border">
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="7,0,9,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SteelPillLineBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SteelBandBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource SubRowTextBrush}"/>
            <Setter Property="TextElement.FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- A small outlined word: Built-in on Default's card, and what a
             starter profile makes. 11 in the quiet text color, corners of 5,
             no fill. -->
        <Style x:Key="SmallTag" TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SteelPillLineBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="TextElement.FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- A starter profile's tile: the band's fill inside the card's
             hairline with corners of 12, lifting one step under the pointer.
             The whole tile is one button. -->
        <Style x:Key="StarterTile" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SteelBandBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" CornerRadius="12" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource SteelCardHoverBrush}"/>
                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource SteelLineBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource SteelRaisedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Profiles (#574), top to bottom as its board draws it: the head with
         Get Profiles and New Profile, a card for each profile and the drop
         tile, four starter profiles, then Automatic Switching, Shortcuts and
         External Control. MainWindow answers what a click asks for. -->
    <ScrollViewer AutomationProperties.Name="{Binding Profiles_Title, Source={x:Static strings:Strings.Instance}}">
        <StackPanel Margin="36,26,36,36">

            <!-- The head: the title and what a profile is, with the two
                 buttons at its top edge. The buttons are one part, so a
                 narrow window never parts them, and the title's block gives
                 way down to 240 before they leave its line. -->
            <controls:FlexLinePanel x:Name="ProfilesHead" Gap="12" LineGap="12">
                <StackPanel controls:FlexLinePanel.Basis="240" controls:FlexLinePanel.Grow="1">
                    <TextBlock x:Name="ProfilesTitle" AutomationProperties.HeadingLevel="Level1"
                               Text="{Binding Profiles_Title, Source={x:Static strings:Strings.Instance}}"
                               FontFamily="{StaticResource DisplayFontFamily}" FontSize="28" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               LineHeight="40.6" LineStackingStrategy="BlockLineHeight"/>
                    <TextBlock Text="{Binding Profiles_Subtitle, Source={x:Static strings:Strings.Instance}}"
                               FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap"
                               LineHeight="18.85" LineStackingStrategy="BlockLineHeight"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
                <StackPanel x:Name="HeadButtons" Orientation="Horizontal" VerticalAlignment="Top">
                    <ui:Button x:Name="GetProfilesButton" Padding="14,0" MinHeight="36"
                               Command="{Binding GetProfilesCommand}" CommandParameter="Starters"
                               Content="{Binding GetProfiles_Title, Source={x:Static strings:Strings.Instance}}"
                               AutomationProperties.AutomationId="Profiles_GetProfiles">
                        <ui:Button.Icon>
                            <controls:DecorativeStrokeIcon Data="{StaticResource DownloadLineGeometry}" Size="15" StrokeWidth="1.8"/>
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button x:Name="NewProfileButton" Style="{StaticResource EmberPrimaryButton}" Margin="12,0,0,0" Padding="14,0"
                               Command="{Binding NewProfileCommand}"
                               Content="{Binding Profiles_New, Source={x:Static strings:Strings.Instance}}"
                               AutomationProperties.AutomationId="Profiles_NewProfile">
                        <ui:Button.Icon>
                            <controls:DecorativeStrokeIcon Data="{StaticResource PlusLineGeometry}" Size="14" StrokeWidth="2.2"/>
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </controls:FlexLinePanel>

            <!-- The cards and the drop tile share one grid of equal columns
                 at least 300 wide. The tile rides the same panel as the cards
                 through a CompositeCollection, whose CollectionContainer sits
                 outside the visual tree, so the code-behind hands it
                 ProfileItems. The tile takes what is left of its row, so no
                 column of the cards' line stands empty, and alone on a line
                 it is a band as tall as its words. The host is the drop zone
                 for profile files and carries the cold dashed cue while a
                 file is dragged over. -->
            <Grid x:Name="ProfileGridHost" Margin="0,20,0,0" AllowDrop="True"
                  DragEnter="ProfileList_DragEnter"
                  DragOver="ProfileList_DragOver"
                  DragLeave="ProfileList_DragLeave"
                  Drop="ProfileList_Drop">
                <ItemsControl x:Name="ProfileListBox"
                              AutomationProperties.Name="{Binding Profiles_Title, Source={x:Static strings:Strings.Instance}}">
                    <ItemsControl.ItemsSource>
                        <CompositeCollection>
                            <CollectionContainer x:Name="ProfilesCollectionContainer"/>

                            <!-- The drop tile: a card's footprint with a dashed
                                 outline (a Border cannot dash, so a Rectangle
                                 wears the stroke), the download icon and the
                                 words. A click opens Get Profiles on Import a
                                 File, as the board links it. -->
                            <Grid controls:TileGridPanel.TakesRest="True"
                                  AutomationProperties.Name="{Binding Profiles_DropTile, Source={x:Static strings:Strings.Instance}}">
                                <controls:ClickBorder x:Name="DropTile" CornerRadius="12" Cursor="Hand" Click="DropTile_Click"
                                                      AutomationProperties.AutomationId="Profiles_DropTile"
                                                      ToolTip="{Binding GetProfiles_File, Source={x:Static strings:Strings.Instance}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Rectangle RadiusX="12" RadiusY="12" Stroke="{DynamicResource DashLineBrush}"
                                                   StrokeThickness="1" StrokeDashArray="4 3" SnapsToDevicePixels="True"/>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                                            <controls:DecorativeStrokeIcon Data="{StaticResource DownloadLineGeometry}" Size="22" StrokeWidth="1.7"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Profiles_DropTile, Source={x:Static strings:Strings.Instance}}"
                                                       FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0" HorizontalAlignment="Center"
                                                       TextWrapping="Wrap" TextAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Profiles_DropTileFormats, Source={x:Static strings:Strings.Instance}}"
                                                       FontSize="13" Margin="0,6,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </controls:ClickBorder>
                            </Grid>
                        </CompositeCollection>
                    </ItemsControl.ItemsSource>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:TileGridPanel MinItemWidth="300" Gap="16"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Resources>
                        <!-- Implicit, typed template rather than an explicit
                             ItemTemplate: the CompositeCollection mixes the
                             profiles with the UIElement drop tile, and an
                             explicit ItemTemplate makes WPF log an error-level
                             trace for the UIElement item. Typed to
                             ProfileListItem, this template never claims the
                             tile. -->
                        <DataTemplate DataType="{x:Type vm:ProfileListItem}">
                            <!-- A profile's card. The active one is lit: an
                                 ember edge, a light around it and a warm
                                 wash from its upper corner. A double click
                                 loads the profile, as its Load button
                                 does. -->
                            <Border x:Name="ProfileCard" CornerRadius="12" BorderThickness="1"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    MouseLeftButtonDown="ProfileCard_MouseLeftButtonDown">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource EmberRingBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <!-- The light around the active card. It
                                         is the card's own child, and its
                                         margin takes it out to the card's
                                         outline. It draws only outside that
                                         outline. -->
                                    <controls:Halo x:Name="ActiveLight" Margin="-1" CornerRadius="12" Radius="42.5" Strength="0.075" Rim="0.18"
                                                   IsHitTestVisible="False" IsLit="{Binding IsActive}"/>
                                    <Border x:Name="ActiveWash" CornerRadius="11" IsHitTestVisible="False"
                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Border.Background>
                                            <RadialGradientBrush GradientOrigin="0,0" Center="0,0" RadiusX="0.9" RadiusY="1.2">
                                                <GradientStop Color="#21FF6B2C" Offset="0"/>
                                                <GradientStop Color="#00FF6B2C" Offset="0.62"/>
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <Grid x:Name="CardRows" Margin="18,16,12,12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- The name, and Built-in on Default. -->
                                        <DockPanel Margin="0,0,6,0">
                                            <Border DockPanel.Dock="Right" Style="{StaticResource SmallTag}" Margin="10,0,0,0"
                                                    Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Profiles_BuiltIn, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                           LineHeight="15.95" LineStackingStrategy="BlockLineHeight"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource HeroCardTitle}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}" LineHeight="26.1" LineStackingStrategy="BlockLineHeight"/>
                                        </DockPanel>

                                        <!-- The game line: No game set, or the games
                                             that load the profile, two names and the
                                             count of the rest in a cell of its own
                                             that is never cut short. The tooltip
                                             lists every game. -->
                                        <TextBlock Grid.Row="1" Margin="0,8,0,0" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   LineHeight="18.85" LineStackingStrategy="BlockLineHeight"
                                                   Text="{Binding Profiles_Card_NoGame, Source={x:Static strings:Strings.Instance}}"
                                                   Visibility="{Binding HasExecutables, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                        <Grid Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Left" ToolTip="{Binding Executables}"
                                              Visibility="{Binding HasExecutables, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding GameLead}" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       LineHeight="18.85" LineStackingStrategy="BlockLineHeight"/>
                                            <TextBlock Grid.Column="1" Text="{Binding GameNames}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                       LineHeight="18.85" LineStackingStrategy="BlockLineHeight"
                                                       FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding GameExtra}" FontSize="13" Margin="4,0,0,0"
                                                       LineHeight="18.85" LineStackingStrategy="BlockLineHeight"
                                                       FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}"
                                                       Visibility="{Binding GameExtra, Converter={StaticResource StringToVisibility}}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding GameTail}" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       LineHeight="18.85" LineStackingStrategy="BlockLineHeight"/>
                                        </Grid>

                                        <!-- A chip for each controller type, with how
                                             many of the profile's controllers are of
                                             it, or No Controllers. -->
                                        <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding TypeChips}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <controls:FlexLinePanel Gap="6" LineGap="6"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource TypeChip}" ToolTip="{Binding TypeName}"
                                                                AutomationProperties.Name="{Binding SpokenName, TargetNullValue='', FallbackValue=''}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Grid Width="14" Height="14" VerticalAlignment="Center">
                                                                    <Path FlowDirection="LeftToRight" Width="13" Height="13" Stretch="Uniform"
                                                                          Data="{Binding TypeGeometry, Mode=OneWay}"
                                                                          Fill="{DynamicResource SubRowTextBrush}"/>
                                                                    <controls:GlyphText Text="{Binding TypeGlyph, Mode=OneWay}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                                                        Foreground="{DynamicResource SubRowTextBrush}"
                                                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                        Visibility="{Binding TypeGlyph, Converter={StaticResource StringToVisibility}}"/>
                                                                </Grid>
                                                                <TextBlock Text="{Binding Count}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Border Style="{StaticResource TypeChip}" Padding="9,0" HorizontalAlignment="Left"
                                                    Visibility="{Binding HasNoSlots, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Profiles_NoSlots, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- The foot: Active with the flame on the
                                             active card, Load on the others, and More
                                             at the end. -->
                                        <DockPanel KeyboardNavigation.TabNavigation="Local" Grid.Row="4" Margin="0,18,0,0" MinHeight="32" LastChildFill="False">
                                            <ui:Button TabIndex="1" DockPanel.Dock="Right" Style="{StaticResource CardIconButton}" Click="CardMore_Click"
                                                       AutomationProperties.AutomationId="Profiles_More"
                                                       ToolTip="{Binding Common_More, Source={x:Static strings:Strings.Instance}}">
                                                <AutomationProperties.Name>
                                                    <MultiBinding Converter="{StaticResource FormatTextConverter}">
                                                        <Binding Path="Name"/>
                                                        <Binding Path="Profiles_CardMore_Format" Source="{x:Static strings:Strings.Instance}"/>
                                                    </MultiBinding>
                                                </AutomationProperties.Name>
                                                <Path FlowDirection="LeftToRight" Width="16" Height="4" Stretch="Uniform"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ui:Button}}}"
                                                      Data="M0,2 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M7,2 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M14,2 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0"/>
                                                <ui:Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Tag="Edit" Click="ProfileMenu_Click" AutomationProperties.AutomationId="Profiles_Menu_Edit"
                                                                  Header="{Binding Profiles_Edit, Source={x:Static strings:Strings.Instance}}"
                                                                  Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <MenuItem Tag="SaveAs" Click="ProfileMenu_Click" AutomationProperties.AutomationId="Profiles_Menu_SaveAs"
                                                                  Header="{Binding Profiles_SaveAs, Source={x:Static strings:Strings.Instance}}"
                                                                  Visibility="{Binding ShowsSaveAs, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <MenuItem Tag="SaveHere" Click="ProfileMenu_Click" AutomationProperties.AutomationId="Profiles_Menu_SaveHere"
                                                                  Header="{Binding Profiles_SaveHere, Source={x:Static strings:Strings.Instance}}"
                                                                  Visibility="{Binding ShowsSaveHere, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <MenuItem Tag="Export" Click="ProfileMenu_Click" AutomationProperties.AutomationId="Profiles_Menu_Export"
                                                                  Header="{Binding Profiles_Export, Source={x:Static strings:Strings.Instance}}"/>
                                                        <Separator Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <MenuItem Tag="Delete" Click="ProfileMenu_Click" AutomationProperties.AutomationId="Profiles_Menu_Delete"
                                                                  Header="{Binding Common_Delete, Source={x:Static strings:Strings.Instance}}"
                                                                  Foreground="{DynamicResource DangerInkBrush}"
                                                                  Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </ContextMenu>
                                                </ui:Button.ContextMenu>
                                            </ui:Button>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Path FlowDirection="LeftToRight" Data="{StaticResource FlameOuterGeometry}" Width="16" Height="16"
                                                      Stretch="Uniform" Fill="{DynamicResource EmberBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Profiles_Active, Source={x:Static strings:Strings.Instance}}" Margin="8,0,0,0"
                                                           FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource EmberHotBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <ui:Button TabIndex="0" Padding="14,0" MinHeight="32" VerticalAlignment="Center"
                                                       Content="{Binding Profiles_Load, Source={x:Static strings:Strings.Instance}}"
                                                       Command="{Binding DataContext.LoadProfileCommand, ElementName=ProfileListBox}"
                                                       CommandParameter="{Binding}" AutomationProperties.AutomationId="Profiles_Load"
                                                       Visibility="{Binding ShowsLoad, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </DockPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.Resources>
                </ItemsControl>
                <!-- Drop cue (#175): cold dashed rim and caption while a
                     profile file is dragged over the cards. Shown and hidden
                     from code (DragEnter/DragLeave), hit-test invisible so
                     drag events keep flowing underneath. -->
                <Grid x:Name="ProfileDropOverlay" Visibility="Collapsed" IsHitTestVisible="False">
                    <Rectangle RadiusX="12" RadiusY="12" Fill="#1458B6E4"
                               Stroke="{DynamicResource ColdBrush}" StrokeThickness="1.5"
                               StrokeDashArray="4 3"/>
                    <TextBlock Text="{Binding Profiles_DropToImport, Source={x:Static strings:Strings.Instance}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12"
                               Foreground="{DynamicResource ColdBrush}"/>
                </Grid>
            </Grid>

            <!-- ═══ Starter Profiles ═══
                 The first four of the profiles that ship with PadForge, one
                 for each kind of game. A click on a tile adds that profile to
                 the cards above, as Save Profile does in Get Profiles, and See
                 All opens Get Profiles on its Starters. -->
            <!-- The heading's three parts share a baseline, the first
                 line's when the hint wraps: the smaller text starts 2 lower
                 than the title, and the link, whose line is taller, 1. -->
            <controls:FlexLinePanel x:Name="StartersHead" Margin="0,28,0,12" Gap="12" LineGap="6">
                <TextBlock x:Name="StartersTitle" Style="{StaticResource PageSectionTitle}" VerticalAlignment="Top"
                           Text="{Binding Profiles_Starters, Source={x:Static strings:Strings.Instance}}"/>
                <TextBlock controls:FlexLinePanel.Basis="260" controls:FlexLinePanel.Grow="1" VerticalAlignment="Top" Margin="0,2,0,0"
                           Text="{Binding Profiles_StartersHint, Source={x:Static strings:Strings.Instance}}"
                           FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                <!-- It reads with its section's name: "See All" alone says
                     nothing of what to a listener who tabs to it. -->
                <Button x:Name="SeeAllStarters" Style="{StaticResource LinkButton}" VerticalAlignment="Top" Margin="0,1,0,0"
                        Command="{Binding GetProfilesCommand}" CommandParameter="Starters"
                        Content="{Binding Common_SeeAll, Source={x:Static strings:Strings.Instance}}"
                        AutomationProperties.AutomationId="Profiles_SeeAllStarters">
                    <AutomationProperties.Name>
                        <MultiBinding StringFormat="{}{0}: {1}">
                            <Binding Path="Profiles_Starters" Source="{x:Static strings:Strings.Instance}"/>
                            <Binding Path="Common_SeeAll" Source="{x:Static strings:Strings.Instance}"/>
                        </MultiBinding>
                    </AutomationProperties.Name>
                </Button>
            </controls:FlexLinePanel>
            <ItemsControl x:Name="StarterTiles" Focusable="False"
                          AutomationProperties.Name="{Binding Profiles_Starters, Source={x:Static strings:Strings.Instance}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:TileGridPanel MinItemWidth="230" Gap="12" FillRows="True" Balance="True"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type services:StarterProfileInfo}">
                        <Button Style="{StaticResource StarterTile}" Click="StarterTile_Click"
                                AutomationProperties.AutomationId="Profiles_Starter"
                                AutomationProperties.Name="{Binding Name, Mode=OneWay, TargetNullValue='', FallbackValue=''}"
                                AutomationProperties.HelpText="{Binding Description, Mode=OneWay}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           LineHeight="20.3" LineStackingStrategy="BlockLineHeight"/>
                                <Border Style="{StaticResource SmallTag}" HorizontalAlignment="Left" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding OutputLabel, Mode=OneWay}" FontFamily="{StaticResource TelemetryFontFamily}"
                                               LineHeight="15.95" LineStackingStrategy="BlockLineHeight"/>
                                </Border>
                                <TextBlock Text="{Binding Description, Mode=OneWay}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"
                                           LineHeight="18.85" LineStackingStrategy="BlockLineHeight"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ═══ Automatic Switching ═══
                 One line: the title, and under it what is in front now, then
                 the setting with its switch and its reset at the card's end.
                 The card has the one setting, so its reset is the row's. -->
            <Border x:Name="AutoSwitchCard" Style="{StaticResource CardBorder}" Padding="20,16,14,16" Margin="0,24,0,0">
                <controls:FlexLinePanel Gap="14" LineGap="10">
                    <StackPanel controls:FlexLinePanel.Basis="320" controls:FlexLinePanel.Grow="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Profiles_AutoSwitchTitle, Source={x:Static strings:Strings.Instance}}"
                                   Style="{StaticResource CardTitle}" FontSize="15" HorizontalAlignment="Left"
                                   AutomationProperties.HeadingLevel="Level2"/>
                        <!-- What is in front now: a cold dot, lit, then the
                             program's file in the code face and whether a
                             profile loads for it. The three runs stay on one
                             line so no space falls between them. -->
                        <Grid x:Name="InFrontLine" Margin="0,4,0,0"
                              Visibility="{Binding EnableAutoProfileSwitching, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <controls:Halo CornerRadius="3.5" Radius="10" Strength="0.4" IsLit="True" Margin="0,6,8,0" VerticalAlignment="Top"
                                           Color="{Binding Fill.Color, ElementName=InFrontDot}">
                                <Ellipse x:Name="InFrontDot" Width="7" Height="7" Fill="{DynamicResource ColdBrush}"/>
                            </controls:Halo>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center"
                                       LineHeight="18.85" LineStackingStrategy="BlockLineHeight"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" AutomationProperties.AutomationId="Profiles_InFront"><Run Text="{Binding ForegroundLead, Mode=OneWay}"/><Run Text="{Binding ForegroundExeName, Mode=OneWay}" FontFamily="{StaticResource TelemetryFontFamily}" Foreground="{DynamicResource ColdBrush}"/><Run Text="{Binding ForegroundTail, Mode=OneWay}"/></TextBlock>
                        </Grid>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Profiles_AutoSwitch, Source={x:Static strings:Strings.Instance}}"
                                   FontSize="14" Margin="0,0,14,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <CheckBox Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding EnableAutoProfileSwitching}" VerticalAlignment="Center"
                                  Content="{Binding Profiles_AutoSwitch, Source={x:Static strings:Strings.Instance}}"
                                  AutomationProperties.AutomationId="Profiles_AutoSwitch"/>
                        <controls:SettingResetButton Margin="14,0,0,0" Command="{Binding ResetSettingCommand}" CommandParameter="EnableAutoProfileSwitching"
                                                     SettingLabel="{Binding Profiles_AutoSwitch, Source={x:Static strings:Strings.Instance}}"
                                                     AutomationProperties.AutomationId="Reset_SettingsViewModel_EnableAutoProfileSwitching_75"/>
                    </StackPanel>
                </controls:FlexLinePanel>
            </Border>

            <!-- ═══ Shortcuts ═══ -->
            <Border x:Name="ShortcutsCard" Style="{StaticResource CardBorder}" Padding="20,16,14,14" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="{Binding Profiles_Shortcuts, Source={x:Static strings:Strings.Instance}}"
                                   Style="{StaticResource CardTitle}" FontSize="15" AutomationProperties.HeadingLevel="Level2"
                                   ToolTip="{Binding Profiles_ShortcutsDescription, Source={x:Static strings:Strings.Instance}}"/>
                        <ui:Button Style="{StaticResource ResetAllButton}" Command="{Binding ResetShortcutsCommand}"
                                   Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}"
                                   AutomationProperties.AutomationId="Profiles_ResetShortcuts">
                            <ui:Button.ToolTip>
                                <MultiBinding Converter="{StaticResource FormatTextConverter}">
                                    <Binding Path="Profiles_Shortcuts" Source="{x:Static strings:Strings.Instance}"/>
                                    <Binding Path="Pad_ResetSection_Format" Source="{x:Static strings:Strings.Instance}"/>
                                </MultiBinding>
                            </ui:Button.ToolTip>
                        </ui:Button>
                    </DockPanel>

                    <!-- The rows stand 4 under the title's line and draw
                         Add Shortcut 5 up, which with a row's 5 over and
                         under its controls of 34 gives the board's 10 over
                         a row and 8 under the last. -->
                    <ItemsControl ItemsSource="{Binding ProfileShortcuts}" Margin="0,4,0,-5">
                        <!-- Out of the screen-reader tree while empty, as the Devices page's
                             slot badges are: an empty list draws nothing and has no size,
                             so collapsing it changes nothing on screen. -->
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl" BasedOn="{StaticResource {x:Type ItemsControl}}">
                                <Setter Property="Focusable" Value="False"/>
                                <Style.Triggers>
                                    <Trigger Property="HasItems" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- A shortcut reads as a sentence: [action] when
                                     [buttons] on [device]. The buttons are a key
                                     each, with Record and Clear after them, as
                                     every input of the program has. Each picker's
                                     reset stands right after it, and Delete at the
                                     row's end. The parts wrap on a narrow window,
                                     every part as tall as its line. Its lines
                                     are 40 apart and it keeps 2 over and under
                                     itself, so the lines of one shortcut stand
                                     closer (6 between their controls) than two
                                     shortcuts do (10), and a wrapped list still
                                     reads one shortcut at a time. -->
                                <controls:FlexLinePanel x:Name="ShortcutLine" Margin="0,2" Gap="14" LineGap="0" MinLineHeight="40" EndsApart="True">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox ItemsSource="{Binding SwitchModes}" SelectedValue="{Binding SwitchMode}" SelectedValuePath="Mode"
                                                  MinHeight="34" MinWidth="200" MaxWidth="280" VerticalAlignment="Center"
                                                  AutomationProperties.AutomationId="Shortcut_Mode"
                                                  AutomationProperties.Name="{Binding Macro_RepeatMode, Source={x:Static strings:Strings.Instance}}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <controls:SettingResetButton Margin="4,0,0,0" Command="{Binding ResetSettingCommand}" CommandParameter="SwitchMode"
                                                                     SettingLabel="{Binding Macro_RepeatMode, Source={x:Static strings:Strings.Instance}}"
                                                                     AutomationProperties.AutomationId="Reset_ProfileShortcutViewModel_SwitchMode_808"/>
                                    </StackPanel>
                                    <!-- The profile, for Specific Profile only. -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                Visibility="{Binding IsSpecificMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ComboBox ItemsSource="{Binding ProfileChoices}" SelectedValue="{Binding TargetProfileId}" SelectedValuePath="ProfileId"
                                                  DisplayMemberPath="DisplayName" DropDownOpened="ProfileChoices_DropDownOpened"
                                                  MinHeight="34" MinWidth="160" MaxWidth="240" VerticalAlignment="Center"
                                                  AutomationProperties.AutomationId="Shortcut_Profile"
                                                  AutomationProperties.Name="{Binding ResetLabel_Profile, Source={x:Static strings:Strings.Instance}}"/>
                                        <controls:SettingResetButton Margin="4,0,0,0" Command="{Binding ResetSettingCommand}" CommandParameter="TargetProfileId"
                                                                     SettingLabel="{Binding ResetLabel_Profile, Source={x:Static strings:Strings.Instance}}"
                                                                     AutomationProperties.AutomationId="Reset_ProfileShortcutViewModel_TargetProfileId_826"/>
                                    </StackPanel>
                                    <!-- when, the recorded buttons as keys with a
                                         plus between two, then Record and Clear. A
                                         long combination wraps inside its own
                                         width. What stands after the keys says
                                         None while there are none, and counts the
                                         seconds down while it records. -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource ShortcutWord}" Text="{Binding Profiles_Shortcut_When, Source={x:Static strings:Strings.Instance}}"/>
                                        <ItemsControl ItemsSource="{Binding ComboParts}" MaxWidth="420" Focusable="False" VerticalAlignment="Center"
                                                      ToolTip="{Binding ButtonComboDisplay}" AutomationProperties.AutomationId="Shortcut_Combo"
                                                      AutomationProperties.Name="{Binding ButtonComboDisplay, TargetNullValue='', FallbackValue=''}">
                                            <!-- A wrap panel is as wide as its widest line, so
                                                 Record stands right after the keys. A flex
                                                 line would take all 420. -->
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel x:Name="Key" Orientation="Horizontal" Margin="6,2,0,2">
                                                        <TextBlock x:Name="Plus" Text="+" Style="{StaticResource ShortcutWord}" Margin="0,0,6,0"/>
                                                        <Border Style="{StaticResource ShortcutKey}">
                                                            <TextBlock VerticalAlignment="Center"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text="{Binding DeviceTail, Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/></TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                                            <Setter TargetName="Plus" Property="Visibility" Value="Collapsed"/>
                                                            <Setter TargetName="Key" Property="Margin" Value="0,2,0,2"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="ComboNote" Text="{Binding ComboNote}" FontSize="13" VerticalAlignment="Center"
                                                   Visibility="{Binding ComboNote, Converter={StaticResource StringToVisibility}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource EmberHotBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasCombo}" Value="True">
                                                            <Setter Property="Margin" Value="8,0,0,0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ui:Button Style="{StaticResource RecordButton}" MinHeight="32" Content="{Binding LearnButtonIcon}"
                                                   Click="ShortcutLearn_Click" AutomationProperties.AutomationId="Shortcut_Record"
                                                   AutomationProperties.Name="{Binding LearnButtonText, TargetNullValue='', FallbackValue=''}"/>
                                        <ui:Button Style="{StaticResource CardIconButton}" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Command="{Binding ClearCommand}"
                                                   AutomationProperties.AutomationId="Shortcut_Clear"
                                                   AutomationProperties.Name="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}"
                                                   ToolTip="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}">
                                            <controls:DecorativeStrokeIcon Data="{StaticResource CloseLineGeometry}" Size="16" StrokeWidth="1.8"/>
                                        </ui:Button>
                                    </StackPanel>
                                    <!-- on, the device. -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource ShortcutWord}" Text="{Binding Profiles_Shortcut_On, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBox ItemsSource="{Binding DeviceChoices}" SelectedValue="{Binding TriggerDeviceGuid}" SelectedValuePath="DeviceGuid"
                                                  DisplayMemberPath="DisplayName" DropDownOpened="DeviceChoices_DropDownOpened"
                                                  MinHeight="34" MinWidth="200" MaxWidth="280" VerticalAlignment="Center"
                                                  AutomationProperties.AutomationId="Shortcut_Device"
                                                  AutomationProperties.Name="{Binding Pad_ScopeDevice, Source={x:Static strings:Strings.Instance}}"/>
                                        <controls:SettingResetButton Margin="4,0,0,0" Command="{Binding ResetSettingCommand}" CommandParameter="TriggerDeviceGuid"
                                                                     SettingLabel="{Binding Pad_ScopeDevice, Source={x:Static strings:Strings.Instance}}"
                                                                     AutomationProperties.AutomationId="Reset_ProfileShortcutViewModel_TriggerDeviceGuid_835"/>
                                    </StackPanel>
                                    <ui:Button controls:FlexLinePanel.AtEnd="True" Style="{StaticResource QuietTextButton}" MinHeight="32" Padding="10,0"
                                               VerticalAlignment="Center" Content="{Binding Common_Delete, Source={x:Static strings:Strings.Instance}}"
                                               Command="{Binding DeleteCommand}" AutomationProperties.AutomationId="Shortcut_Delete"/>
                                </controls:FlexLinePanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Add Shortcut, 8 in from the rows' start as the board
                         draws it. -->
                    <ui:Button Style="{StaticResource QuietTextButton}" Margin="0,8,0,0" Padding="8,0" HorizontalAlignment="Left"
                               Click="AddShortcut_Click" AutomationProperties.AutomationId="Profiles_AddShortcut"
                               AutomationProperties.Name="{Binding Profiles_AddShortcut, Source={x:Static strings:Strings.Instance}}">
                        <StackPanel Orientation="Horizontal">
                            <Path FlowDirection="LeftToRight" Data="M 7,3 L 7,11 M 3,7 L 11,7" Width="14" Height="14" Margin="0,0,8,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ui:Button}}}"
                                  StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Profiles_AddShortcut, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Border>

            <!-- ═══ External Control ═══
                 The third way a profile can activate, beside the shortcut
                 combo and the program in front (#366). A launcher or script
                 activates profiles through a named pipe. Rarely used, so it
                 folds to one line with its value beside its title. -->
            <controls:FoldList Margin="0,12,0,0" Gap="0">
                <controls:FoldCard x:Name="ExternalControlFold" StateKey="Profiles.ExternalControl" HeaderMinHeight="52"
                                   Header="{Binding Profiles_ExternalControlTitle, Source={x:Static strings:Strings.Instance}}"
                                   Hint="{Binding Profiles_ExternalControl, Source={x:Static strings:Strings.Instance}}"
                                   Description="{Binding Profiles_ExternalControlTooltip, Source={x:Static strings:Strings.Instance}}">
                    <controls:FoldCard.HeaderAction>
                        <ui:Button Style="{StaticResource ResetAllButton}" Command="{Binding ResetSettingCommand}"
                                   CommandParameter="EnableExternalControl" AutomationProperties.AutomationId="Profiles_ResetExternalControl"
                                   Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}">
                            <ui:Button.ToolTip>
                                <MultiBinding Converter="{StaticResource FormatTextConverter}">
                                    <Binding Path="Profiles_ExternalControlTitle" Source="{x:Static strings:Strings.Instance}"/>
                                    <Binding Path="Pad_ResetSection_Format" Source="{x:Static strings:Strings.Instance}"/>
                                </MultiBinding>
                            </ui:Button.ToolTip>
                        </ui:Button>
                    </controls:FoldCard.HeaderAction>
                    <controls:FoldCard.Summary>
                        <MultiBinding Converter="{StaticResource OnOffTextConverter}">
                            <Binding Path="EnableExternalControl"/>
                            <Binding Path="Common_On" Source="{x:Static strings:Strings.Instance}"/>
                            <Binding Path="Common_Off" Source="{x:Static strings:Strings.Instance}"/>
                        </MultiBinding>
                    </controls:FoldCard.Summary>
                    <controls:SettingRow MinHeight="44">
                        <TextBlock Style="{StaticResource DzLabel}" Text="{Binding Profiles_ExternalControl, Source={x:Static strings:Strings.Instance}}"/>
                        <CheckBox Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding EnableExternalControl}" VerticalAlignment="Center"
                                  Content="{Binding Profiles_ExternalControl, Source={x:Static strings:Strings.Instance}}"
                                  ToolTip="{Binding Profiles_ExternalControlTooltip, Source={x:Static strings:Strings.Instance}}"
                                  AutomationProperties.AutomationId="Profiles_ExternalControl"/>
                        <controls:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="EnableExternalControl"
                                                     SettingLabel="{Binding Profiles_ExternalControl, Source={x:Static strings:Strings.Instance}}"
                                                     AutomationProperties.AutomationId="Reset_SettingsViewModel_EnableExternalControl_133"/>
                    </controls:SettingRow>
                </controls:FoldCard>
            </controls:FoldList>
        </StackPanel>
    </ScrollViewer>
</UserControl>
