<ui:FluentWindow x:Class="PadForge.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Width="440" SizeToContent="Height"
        MinHeight="170"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="20,18,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: ember tick + display-face title (#175 phase 2 confirm
             mock; same tick idiom as the Dashboard Services group header). -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5"
                       Fill="{DynamicResource EmberBrush}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="TitleText"
                       FontFamily="{StaticResource DisplayFontFamily}"
                       FontWeight="SemiBold" FontSize="15"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Body description. Body face rides in from the app-level
             FluentWindow style. -->
        <TextBlock Grid.Row="1" x:Name="MessageText" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

        <!-- Optional mono fact line: names the thing at stake (device,
             slot, file) in the cold telemetry voice. Collapsed unless the
             caller passes a detail value. -->
        <TextBlock Grid.Row="2" x:Name="DetailText" Margin="0,8,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed"
                   FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12"
                   Foreground="{DynamicResource ColdBrush}"/>

        <!-- Footer: Cancel holds the default and the initial focus, so
             Enter and Esc both land on the safe verb. The destructive
             action wears the ember-deep warning chrome and only fires on
             a deliberate click (or Tab + Enter). -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" MinWidth="90" Margin="0,0,8,0"
                    Content="{Binding Common_Cancel, Source={x:Static strings:Strings.Instance}}"
                    IsCancel="True" IsDefault="True"/>
            <Button x:Name="ActionButton" MinWidth="90"
                    Style="{StaticResource EmberDestructiveButton}"
                    Click="ActionButton_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
