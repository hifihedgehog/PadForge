                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- Drop-zone cue (#175): cold dashed rim and mono caption
                             while a .pfprofile drag is over the host. Shown and
                             hidden from code (DragEnter/DragLeave), hit-test
                             invisible so drag events keep flowing underneath. -->
                        <Grid x:Name="ProfileDropOverlay" Visibility="Collapsed" IsHitTestVisible="False">
                            <Rectangle RadiusX="8" RadiusY="8" Fill="#1458B6E4"
                                       Stroke="{DynamicResource ColdBrush}" StrokeThickness="1.5"
                                       StrokeDashArray="4 3"/>
                            <TextBlock Text="{Binding Profiles_DropToImport, Source={x:Static strings:Strings.Instance}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12"
                                       Foreground="{DynamicResource ColdBrush}"/>
                        </Grid>
                    </Grid>

                    <!-- Verb-grouped strip (#175 item 19): create / apply /
                         file clusters with 16px gaps per the approved pitch
                         mock. Load carries the accent weight, Delete the
                         shared destructive chrome. Edit and Delete explain
                         themselves while disabled: ToolTip is set only from
                         the two disabling states, so an enabled button shows
                         none. -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding Profiles_New, Source={x:Static strings:Strings.Instance}}"
                                Command="{Binding NewProfileCommand}"
                                Margin="0,0,8,0"/>
                        <Button Content="{Binding Profiles_SaveAs, Source={x:Static strings:Strings.Instance}}"
                                Command="{Binding SaveAsProfileCommand}"
                                Margin="0,0,16,0"/>
                        <Button Content="{Binding Profiles_Load, Source={x:Static strings:Strings.Instance}}"
                                Command="{Binding LoadProfileCommand}"
                                Style="{StaticResource EmberAccentButton}"
                                Margin="0,0,8,0"/>
                        <Button Content="{Binding Profiles_Edit, Source={x:Static strings:Strings.Instance}}"
                                Command="{Binding EditProfileCommand}"
                                ToolTipService.ShowOnDisabled="True"
                                Margin="0,0,16,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedProfile}" Value="{x:Null}">
                                            <Setter Property="ToolTip" Value="{Binding Profiles_SelectFirstHint, Source={x:Static strings:Strings.Instance}}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedProfile.IsDefault}" Value="True">
                                            <Setter Property="ToolTip" Value="{Binding Profiles_DefaultLockedHint, Source={x:Static strings:Strings.Instance}}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{Binding Profiles_Export, Source={x:Static strings:Strings.Instance}}"
                                Command="{Binding ExportProfileCommand}"
                                Margin="0,0,8,0"/>
                        <Button Content="{Binding Profiles_Import, Source={x:Static strings:Strings.Instance}}"
                                Command="{Binding ImportProfileCommand}"
                                Margin="0,0,8,0"/>
                        <!-- Steam Workshop entry (#9): always enabled. With the
                             opt-in off, the dialog opens on its cold-forge state
                             and offers the enable action itself. -->
                        <Button Content="{Binding Profiles_BrowseCommunity, Source={x:Static strings:Strings.Instance}}"
                                Command="{Binding BrowseCommunityConfigsCommand}"
                                Margin="0,0,8,0"/>
                        <Button Content="{Binding Common_Delete, Source={x:Static strings:Strings.Instance}}"
                                Command="{Binding DeleteProfileCommand}"
                                ToolTipService.ShowOnDisabled="True">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource EmberDestructiveButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedProfile}" Value="{x:Null}">
                                            <Setter Property="ToolTip" Value="{Binding Profiles_SelectFirstHint, Source={x:Static strings:Strings.Instance}}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedProfile.IsDefault}" Value="True">
                                            <Setter Property="ToolTip" Value="{Binding Profiles_DefaultLockedHint, Source={x:Static strings:Strings.Instance}}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══ Controller Shortcuts ═══ -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EmberBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Profiles_Shortcuts, Source={x:Static strings:Strings.Instance}}"
                                   Style="{StaticResource CardTitle}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Profiles_ShortcutsDescription, Source={x:Static strings:Strings.Instance}}"
                               Style="{StaticResource CardDescription}" Margin="0,0,0,12"/>

                    <ItemsControl ItemsSource="{Binding ProfileShortcuts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Mode: Next/Previous/Specific/ToggleWindow/ToggleVCsDisabled.
                                         Widened to fit the longest English label ("Toggle Virtual
                                         Controllers Disabled"). Longer Romance-language locales
                                         (Spanish/French ~45 chars) truncate via the ItemTemplate's
                                         TextTrimming with the full name on hover. -->
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding SwitchModes}"
                                              SelectedValue="{Binding SwitchMode}"
                                              SelectedValuePath="Mode"
                                              Width="290" Margin="0,0,6,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <!-- Profile dropdown (Specific only) -->
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding ProfileChoices}"
                                              SelectedValue="{Binding TargetProfileId}"
                                              SelectedValuePath="ProfileId"
                                              DisplayMemberPath="DisplayName"
                                              DropDownOpened="ProfileChoices_DropDownOpened"
                                              Width="140" Margin="0,0,6,0"
                                              Visibility="{Binding IsSpecificMode, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <!-- Device dropdown — matches the SwitchMode dropdown width. -->
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding DeviceChoices}"
                                              SelectedValue="{Binding TriggerDeviceGuid}"
                                              SelectedValuePath="DeviceGuid"
                                              DisplayMemberPath="DisplayName"
                                              DropDownOpened="DeviceChoices_DropDownOpened"
                                              Width="290" Margin="0,0,6,0"/>

                                    <!-- Button combo display (fills remaining space, marquee scrolls if too long) -->
                                    <Border Grid.Column="3" ClipToBounds="True" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ButtonComboDisplay}"
                                                       VerticalAlignment="Center"
                                                       common:MarqueeBehavior.IsEnabled="True"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Action buttons (right-justified) -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                                        <ui:Button Style="{StaticResource EmberIconButtonHot}"
                                                   Click="ShortcutLearn_Click" Margin="0,0,4,0">
                                            <TextBlock Text="{Binding LearnButtonIcon}" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" Foreground="{DynamicResource EmberBrush}"/>
                                            <ui:Button.ToolTip>
                                                <TextBlock Text="{Binding LearnButtonText}"/>
                                            </ui:Button.ToolTip>
                                        </ui:Button>
                                        <ui:Button Style="{StaticResource EmberIconButtonHot}"
                                                   Command="{Binding ClearCommand}" Margin="0,0,4,0">
                                            <TextBlock Text="&#xE75C;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <ui:Button.ToolTip>
                                                <TextBlock Text="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}"/>
                                            </ui:Button.ToolTip>
                                        </ui:Button>
                                        <ui:Button Style="{StaticResource EmberIconButtonHot}"
                                                   Command="{Binding DeleteCommand}" Margin="0">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <ui:Button.ToolTip>
                                                <TextBlock Text="{Binding Common_Delete, Source={x:Static strings:Strings.Instance}}"/>
                                            </ui:Button.ToolTip>
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="{Binding Profiles_AddShortcut, Source={x:Static strings:Strings.Instance}}"
                            Click="AddShortcut_Click" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
