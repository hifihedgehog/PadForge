                                               Foreground="{DynamicResource ColdBrush}"
                                               FontSize="14" Width="140" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding GyroLiveRateYaw,   StringFormat={}Yaw {0:+0.0;-0.0;0.0}°/s}"
                                               Foreground="{DynamicResource ColdBrush}"
                                               FontSize="14" Width="130" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding GyroLiveRateRoll,  StringFormat={}Roll {0:+0.0;-0.0;0.0}°/s}"
                                               Foreground="{DynamicResource ColdBrush}"
                                               FontSize="14" Width="135" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Settings_GyroLiveAccel_Label, Source={x:Static strings:Strings.Instance}}"
                                               FontSize="14" Width="160" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
