<views:DialogWindow AutomationProperties.IsDialog="True" x:Class="PadForge.Views.CustomTelemetryFormatsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        xmlns:controls="clr-namespace:PadForge.Controls"
        xmlns:common="clr-namespace:PadForge.Common"
        xmlns:views="clr-namespace:PadForge.Views"
        xmlns:vm="clr-namespace:PadForge.ViewModels"
        IsWide="True" ScrollsBody="False"
        Width="1040" Height="680" SizeToContent="Manual"
        HeadPadding="24,20,24,0" BodyPadding="24,16,24,16" FootPadding="24,14,24,14"
        Title="{Binding Telemetry_Formats_Title, Source={x:Static strings:Strings.Instance}}"
        Subtitle="{Binding Telemetry_Formats_Description, Source={x:Static strings:Strings.Instance}}">

    <!-- Custom Formats (#531, #574), as the Dialogs-Large board draws it:
         the formats at the left with what adds, copies and deletes one, and
         the picked format's settings and field rows at the right. Required
         Key and the gear values are under More. The dialog edits copies and
         writes them back only on Save, and the first problem that stops a
         save shows at the foot's start. The window keeps its size, so each
         column scrolls by itself and the body does not. -->
    <views:DialogWindow.Resources>
        <!-- A row's label: the board's 110 column, 10 before the control. -->
        <Style x:Key="FormatLabel" TargetType="TextBlock" BasedOn="{StaticResource DialogLabel}">
            <Setter Property="Width" Value="110"/>
        </Style>
        <!-- The label of a setting that follows another on its line. -->
        <Style x:Key="FormatInlineLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <!-- A number as the board draws one: a plain field 34 tall, no spin
             buttons and no clear button. It stays a NumberBox, so it keeps
             its Minimum and Maximum. -->
        <Style x:Key="FormatNumberBox" TargetType="ui:NumberBox" BasedOn="{StaticResource {x:Type ui:NumberBox}}">
            <Setter Property="SpinButtonPlacementMode" Value="Hidden"/>
            <Setter Property="ClearButtonEnabled" Value="False"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- A field row's text box and picker fill their columns. -->
        <Style x:Key="FieldBox" TargetType="ui:TextBox" BasedOn="{StaticResource DialogTextBox}">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </views:DialogWindow.Resources>

    <views:DialogWindow.Foot>
        <controls:FlexLinePanel Style="{StaticResource DialogFootPanel}">
            <!-- The first problem that stops a save. The dialog stays open. -->
            <TextBlock x:Name="ProblemText" Style="{StaticResource DialogFootNote}" common:LiveText.Polite="True"
                       Foreground="{DynamicResource WaitBrush}"/>
            <Button Style="{StaticResource DialogButton}" IsCancel="True" Click="CancelButton_Click"
                    Content="{Binding Common_Cancel, Source={x:Static strings:Strings.Instance}}"/>
            <Button x:Name="SaveButton" Style="{StaticResource DialogPrimaryButton}" IsDefault="True" Click="SaveButton_Click"
                    Content="{Binding Common_Save, Source={x:Static strings:Strings.Instance}}"/>
        </controls:FlexLinePanel>
    </views:DialogWindow.Foot>

    <Grid common:InitialFocus.First="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- The formats, and under them what adds, copies and deletes one.
             The list has no scroll view of its own, so the column scrolls
             as one. -->
        <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ListBox x:Name="FormatList" Style="{StaticResource PartList}" SelectionMode="Single"
                         SelectionChanged="FormatList_SelectionChanged"
                         AutomationProperties.Name="{Binding Telemetry_Formats_Title, Source={x:Static strings:Strings.Instance}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource PartListItem}">
                            <Setter Property="Margin" Value="0,0,0,4"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TelemetryFormatEdit}">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- Add reads Add Format to a screen reader, which has no
                     list beside the word to go by. -->
                <controls:FlexLinePanel Gap="6" LineGap="6" Margin="0,8,0,0">
                    <Button x:Name="AddFormatButton" Style="{StaticResource DialogButton}" MinHeight="32" Padding="12,0"
                            Click="AddFormatButton_Click"
                            Content="{Binding Common_Add, Source={x:Static strings:Strings.Instance}}"
                            AutomationProperties.Name="{Binding Telemetry_Formats_Add, Source={x:Static strings:Strings.Instance}}"/>
                    <Button x:Name="DuplicateFormatButton" Style="{StaticResource DialogQuietButton}" MinHeight="32" Padding="10,0"
                            Click="DuplicateFormatButton_Click"
                            Content="{Binding Common_Duplicate, Source={x:Static strings:Strings.Instance}}"/>
                    <Button x:Name="DeleteFormatButton" Style="{StaticResource DialogQuietDangerButton}" MinHeight="32" Padding="10,0"
                            Click="DeleteFormatButton_Click"
                            Content="{Binding Common_Delete, Source={x:Static strings:Strings.Instance}}"/>
                </controls:FlexLinePanel>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Column="2" x:Name="EditorScroll" Focusable="False" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="EditorPanel">
                <controls:SettingRow MinHeight="42">
                    <TextBlock Style="{StaticResource FormatLabel}"
                               Text="{Binding Telemetry_Formats_Name, Source={x:Static strings:Strings.Instance}}"/>
                    <ui:TextBox Style="{StaticResource DialogTextBox}" controls:SettingRow.Fills="True" VerticalAlignment="Center"
                                Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.Name="{Binding Telemetry_Formats_Name, Source={x:Static strings:Strings.Instance}}"/>
                </controls:SettingRow>

                <!-- What the packets are. Length and Byte Order belong to a
                     binary format. Each setting keeps its label on a line
                     that wraps, so a longer language loses none of them. -->
                <controls:FlexLinePanel x:Name="PacketsLine" Gap="22" LineGap="0" MinLineHeight="42">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource FormatLabel}"
                                   Text="{Binding Telemetry_Formats_Kind, Source={x:Static strings:Strings.Instance}}"/>
                        <ComboBox Style="{StaticResource DialogSelect}" common:ComboBoxWidthBehavior.SizeToItems="True"
                                  ItemsSource="{x:Static vm:TelemetryChoices.Kinds}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                  SelectedValue="{Binding Kind, Mode=TwoWay}"
                                  AutomationProperties.Name="{Binding Telemetry_Formats_Kind, Source={x:Static strings:Strings.Instance}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsBinary, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource FormatInlineLabel}"
                                   Text="{Binding Telemetry_Formats_Length, Source={x:Static strings:Strings.Instance}}"/>
                        <ui:NumberBox Style="{StaticResource FormatNumberBox}" Width="90" Minimum="0" Maximum="65507"
                                      Value="{Binding Length, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="{Binding Telemetry_Formats_Length_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                      AutomationProperties.Name="{Binding Telemetry_Formats_Length, Source={x:Static strings:Strings.Instance}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsBinary, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource FormatInlineLabel}"
                                   Text="{Binding Telemetry_Formats_ByteOrder, Source={x:Static strings:Strings.Instance}}"/>
                        <ComboBox Style="{StaticResource DialogSelect}" common:ComboBoxWidthBehavior.SizeToItems="True"
                                  ItemsSource="{x:Static vm:TelemetryChoices.ByteOrders}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                  SelectedValue="{Binding BigEndian, Mode=TwoWay}"
                                  ToolTip="{Binding Telemetry_Formats_ByteOrder_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                  AutomationProperties.Name="{Binding Telemetry_Formats_ByteOrder, Source={x:Static strings:Strings.Instance}}"/>
                    </StackPanel>
                </controls:FlexLinePanel>

                <!-- The fields. What a field reads and how its numbers run is
                     the heading's tooltip and its help text. -->
                <TextBlock Style="{StaticResource DialogHead3}" Margin="0,14,0,0" HorizontalAlignment="Left"
                           Text="{Binding Telemetry_Formats_Fields, Source={x:Static strings:Strings.Instance}}"
                           ToolTip="{Binding Telemetry_Formats_FieldsHint, Source={x:Static strings:Strings.Instance}}"
                           AutomationProperties.HelpText="{Binding Telemetry_Formats_FieldsHint, Source={x:Static strings:Strings.Instance}}"/>

                <!-- The column heads, in the rows' own columns. A binary
                     format has an offset and a type, and a JSON one a key
                     across both. -->
                <Grid x:Name="FieldHeads" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="1.55*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="0.7*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="0.75*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="0.7*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="0.6*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="0.6*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource EditorSubHead}" TextTrimming="CharacterEllipsis"
                               Text="{Binding Telemetry_Formats_ColName, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource EditorSubHead}" TextTrimming="CharacterEllipsis"
                               Text="{Binding Telemetry_Formats_ColTarget, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock Grid.Column="4" Style="{StaticResource EditorSubHead}" TextTrimming="CharacterEllipsis"
                               Text="{Binding Telemetry_Formats_ColOffset, Source={x:Static strings:Strings.Instance}}"
                               Visibility="{Binding IsBinary, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Grid.Column="6" Style="{StaticResource EditorSubHead}" TextTrimming="CharacterEllipsis"
                               Text="{Binding Telemetry_Formats_ColType, Source={x:Static strings:Strings.Instance}}"
                               Visibility="{Binding IsBinary, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Grid.Column="4" Grid.ColumnSpan="3" Style="{StaticResource EditorSubHead}" TextTrimming="CharacterEllipsis"
                               Text="{Binding Telemetry_Formats_ColKey, Source={x:Static strings:Strings.Instance}}"
                               Visibility="{Binding IsJson, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Grid.Column="8" Style="{StaticResource EditorSubHead}" TextTrimming="CharacterEllipsis"
                               Text="{Binding Telemetry_Formats_ColScale, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock Grid.Column="10" Style="{StaticResource EditorSubHead}" TextTrimming="CharacterEllipsis"
                               Text="{Binding Telemetry_Formats_ColMin, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBlock Grid.Column="12" Style="{StaticResource EditorSubHead}" TextTrimming="CharacterEllipsis"
                               Text="{Binding Telemetry_Formats_ColMax, Source={x:Static strings:Strings.Instance}}"/>
                </Grid>

                <ItemsControl x:Name="FieldRows" ItemsSource="{Binding Fields}" Focusable="False"
                              KeyboardNavigation.TabNavigation="Continue">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TelemetryFieldEdit}">
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="1.55*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="0.7*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="0.75*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="0.7*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="0.6*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="0.6*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Style="{StaticResource FieldBox}"
                                            Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding IsVariable}"
                                            AutomationProperties.Name="{Binding Telemetry_Formats_ColName, Source={x:Static strings:Strings.Instance}}"/>
                                <ComboBox Grid.Column="2" Style="{StaticResource DialogSelect}"
                                          ItemsSource="{x:Static vm:TelemetryChoices.Targets}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                          SelectedValue="{Binding Target, Mode=TwoWay}"
                                          AutomationProperties.Name="{Binding Telemetry_Formats_ColTarget, Source={x:Static strings:Strings.Instance}}"/>
                                <ui:NumberBox Grid.Column="4" Style="{StaticResource FormatNumberBox}" Minimum="0" Maximum="65506"
                                              Value="{Binding Offset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Visibility="{Binding IsBinary, Converter={StaticResource BoolToVisibilityConverter}}"
                                              AutomationProperties.Name="{Binding Telemetry_Formats_ColOffset, Source={x:Static strings:Strings.Instance}}"/>
                                <ComboBox Grid.Column="6" Style="{StaticResource DialogSelect}"
                                          ItemsSource="{x:Static vm:TelemetryChoices.Types}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                          SelectedValue="{Binding Type, Mode=TwoWay}"
                                          Visibility="{Binding IsBinary, Converter={StaticResource BoolToVisibilityConverter}}"
                                          AutomationProperties.Name="{Binding Telemetry_Formats_ColType, Source={x:Static strings:Strings.Instance}}"/>
                                <ui:TextBox Grid.Column="4" Grid.ColumnSpan="3" Style="{StaticResource FieldBox}"
                                            Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Visibility="{Binding IsJson, Converter={StaticResource BoolToVisibilityConverter}}"
                                            AutomationProperties.Name="{Binding Telemetry_Formats_ColKey, Source={x:Static strings:Strings.Instance}}"/>
                                <ui:TextBox Grid.Column="8" Style="{StaticResource FieldBox}"
                                            Text="{Binding Scale, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                            AutomationProperties.Name="{Binding Telemetry_Formats_ColScale, Source={x:Static strings:Strings.Instance}}"/>
                                <ui:TextBox Grid.Column="10" Style="{StaticResource FieldBox}"
                                            Text="{Binding Min, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                            IsEnabled="{Binding IsVariable}"
                                            AutomationProperties.Name="{Binding Telemetry_Formats_ColMin, Source={x:Static strings:Strings.Instance}}"/>
                                <ui:TextBox Grid.Column="12" Style="{StaticResource FieldBox}"
                                            Text="{Binding Max, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                            IsEnabled="{Binding IsVariable}"
                                            AutomationProperties.Name="{Binding Telemetry_Formats_ColMax, Source={x:Static strings:Strings.Instance}}"/>
                                <ui:Button Grid.Column="14" Style="{StaticResource DialogIconButton}" VerticalAlignment="Center"
                                           Click="RemoveFieldButton_Click"
                                           ToolTip="{Binding Telemetry_Formats_RemoveField, Source={x:Static strings:Strings.Instance}}"
                                           AutomationProperties.Name="{Binding Telemetry_Formats_RemoveField, Source={x:Static strings:Strings.Instance}}">
                                    <Path FlowDirection="LeftToRight" Data="M 3.5,3.5 L 10.5,10.5 M 10.5,3.5 L 3.5,10.5" Width="14" Height="14"
                                          StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ui:Button}}}"/>
                                </ui:Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Add Field: quiet, pulled left so its plus stands on the
                     column's edge. The plus takes the color the button
                     gives its words. -->
                <Button x:Name="AddFieldButton" Style="{StaticResource DialogQuietButton}" HorizontalAlignment="Left"
                        Margin="-16,8,0,0" Click="AddFieldButton_Click"
                        AutomationProperties.Name="{Binding Telemetry_Formats_AddField, Source={x:Static strings:Strings.Instance}}">
                    <StackPanel Orientation="Horizontal">
                        <Path FlowDirection="LeftToRight" Data="M 7,2.9 L 7,11.1 M 2.9,7 L 11.1,7" Width="14" Height="14"
                              Margin="0,0,8,0" VerticalAlignment="Center"
                              StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding Telemetry_Formats_AddField, Source={x:Static strings:Strings.Instance}}"/>
                    </StackPanel>
                </Button>

                <!-- More: the key a JSON packet must carry, and a gear
                     field's own numbers for reverse and neutral. It opens by
                     itself for a format that uses either. -->
                <controls:MoreRow x:Name="FormatMore" Style="{StaticResource DialogMoreRow}" Margin="0,14,0,0"
                                  AutomationProperties.AutomationId="TelemetryFormats_More"
                                  Header="{Binding Common_More, Source={x:Static strings:Strings.Instance}}"
                                  Hint="{Binding Telemetry_Formats_More, Source={x:Static strings:Strings.Instance}}">
                    <StackPanel>
                        <controls:SettingRow MinHeight="42"
                                             Visibility="{Binding IsJson, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource FormatLabel}"
                                       Text="{Binding Telemetry_Formats_Key, Source={x:Static strings:Strings.Instance}}"
                                       ToolTip="{Binding Telemetry_Formats_Key_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                            <ui:TextBox Style="{StaticResource DialogTextBox}" controls:SettingRow.Fills="True" VerticalAlignment="Center"
                                        Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="{Binding Telemetry_Formats_Key_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                        AutomationProperties.Name="{Binding Telemetry_Formats_Key, Source={x:Static strings:Strings.Instance}}"/>
                        </controls:SettingRow>
                        <controls:FlexLinePanel x:Name="GearLine" Gap="22" LineGap="0" MinLineHeight="42">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource FormatLabel}"
                                           Text="{Binding Telemetry_Formats_GearValues, Source={x:Static strings:Strings.Instance}}"
                                           ToolTip="{Binding Telemetry_Formats_GearValues_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                <CheckBox Style="{StaticResource SwitchCheckBox}"
                                          Content="{Binding Telemetry_Formats_GearValues, Source={x:Static strings:Strings.Instance}}"
                                          ToolTip="{Binding Telemetry_Formats_GearValues_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                          IsChecked="{Binding UseGearValues, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource FormatInlineLabel}"
                                           Text="{Binding Telemetry_Formats_GearReverse, Source={x:Static strings:Strings.Instance}}"/>
                                <ui:NumberBox Style="{StaticResource FormatNumberBox}" Width="90" Minimum="-1000" Maximum="1000"
                                              Value="{Binding GearReverse, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding UseGearValues}"
                                              AutomationProperties.Name="{Binding Telemetry_Formats_GearReverse, Source={x:Static strings:Strings.Instance}}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource FormatInlineLabel}"
                                           Text="{Binding Telemetry_Formats_GearNeutral, Source={x:Static strings:Strings.Instance}}"/>
                                <ui:NumberBox Style="{StaticResource FormatNumberBox}" Width="90" Minimum="-1000" Maximum="1000"
                                              Value="{Binding GearNeutral, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding UseGearValues}"
                                              AutomationProperties.Name="{Binding Telemetry_Formats_GearNeutral, Source={x:Static strings:Strings.Instance}}"/>
                            </StackPanel>
                        </controls:FlexLinePanel>
                    </StackPanel>
                </controls:MoreRow>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</views:DialogWindow>
