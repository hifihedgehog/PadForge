<UserControl x:Class="PadForge.Views.PadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PadForge.ViewModels"
             xmlns:controls="clr-namespace:PadForge.Controls"
             xmlns:views="clr-namespace:PadForge.Views"
             xmlns:viewControls="clr-namespace:PadForge.Views.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:strings="clr-namespace:PadForge.Resources.Strings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PadViewModel}"
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>
        <!-- Style for deadzone slider groups -->
        <Style x:Key="DzLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="270"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style x:Key="DzSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="0.1"/>
        </Style>
        <Style x:Key="OffsetSlider" TargetType="Slider" BasedOn="{StaticResource DzSlider}">
            <Setter Property="Minimum" Value="-100"/>
        </Style>
        <Style x:Key="DzValue" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
        <Style x:Key="DzValueEdit" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="Width" Value="56"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="2,1"/>
        </Style>
        <Style x:Key="DzDigitEdit" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="Width" Value="56"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="ToolTip" Value="Raw axis value"/>
        </Style>
        <Style x:Key="DzPercent" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <!--
            FontFamily / FontSize live on the child TextBlock so the symbol-
            font glyph renders inside the button without leaking through the
            visual tree to the tooltip. The tooltip then keeps its WPF UI
            themed font (Fluent / Segoe UI Variable). Mirrors the working
            pattern used by the mapping grid's record / clear buttons:
            symbol font scoped to a child TextBlock, not the Button itself.
        -->
        <Style x:Key="ResetButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Content" Value="&#xE72C;"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="Reset"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResetAllButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Compact row styles for RGB sliders that need to fit under
             a 200×200 ColorPickerControl. Used in the lightbar base
             color and the three audio-threshold color blocks. -->
        <Style x:Key="DzLabelTight" TargetType="TextBlock">
            <Setter Property="Width" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="DzRgbSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="255"/>
            <Setter Property="Width" Value="148"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
        </Style>
        <Style x:Key="DzValueEditTight" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="Width" Value="48"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="2,1"/>
        </Style>
        <Style x:Key="ResetButtonTight" TargetType="Button" BasedOn="{StaticResource ResetButton}">
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="MinWidth" Value="20"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
        </Style>

        <!-- Custom tab strip button (RadioButton styled as tab header) -->
        <Style x:Key="TabStripButton" TargetType="RadioButton">
            <Setter Property="GroupName" Value="PadTab"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Padding="10,6" Background="Transparent"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource SystemAccentColorSecondaryBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="#10FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#08FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Right-arrow separator between tab groups -->
        <Style x:Key="TabStripSeparator" TargetType="TextBlock">
            <Setter Property="Text" Value="&#xE76C;"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Device selector header -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Extended config bar (visible only for Extended slots) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Configuration tabs -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════
             ROW 0: Unified Tab Strip
             Combines navigation + device selector in one horizontal strip.
             ═══════════════════════════════════════════ -->
        <Border Grid.Row="0" Padding="4,0" Margin="0,0,0,2"
                BorderBrush="{DynamicResource TextFillColorTertiaryBrush}"
                BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- [Gamepad #  TypeIcon TypeName] — Controller tab -->
                <RadioButton x:Name="TabController" Tag="0" Style="{StaticResource TabStripButton}" Click="TabBtn_Click"
                             IsChecked="True"
                             AutomationProperties.AutomationId="TabController">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding SlotNumber}" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Image Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source" Value="{StaticResource GenericControllerIcon}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OutputType}" Value="Xbox">
                                            <Setter Property="Source" Value="{StaticResource XboxControllerIcon}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OutputType}" Value="PlayStation">
                                            <Setter Property="Source" Value="{StaticResource DS4ControllerIcon}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OutputType}" Value="Extended">
                                            <Setter Property="Source" Value="{StaticResource ExtendedControllerIcon}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OutputType}" Value="Midi">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OutputType}" Value="KeyboardMouse">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <!-- MIDI glyph icon (visible only when OutputType == Midi) -->
                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,4,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OutputType}" Value="Midi">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Keyboard+Mouse glyph icon (visible only when OutputType == KeyboardMouse) -->
                        <TextBlock Text="&#xE961;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,4,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OutputType}" Value="KeyboardMouse">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding TypeInstanceLabel}" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

<!-- [Mappings] — per-VC scope (Issue #61 multi-source).
                     Sits before the Device dropdown (the table sources
                     from any device assigned to this VC, not just the
                     selected one) AND before Macros (it's the primary
                     config tab — Macros is the layered-effect surface
                     that sits on top of a configured mapping table).
                     Sticks/Triggers/FFB stay after the dropdown — they
                     shape physical-input characteristics, so they remain
                     device-scoped. Tag stays 2 to keep SelectedConfigTab
                     numbering stable (TabControl content + the visibility-
                     kick logic in PadPage.xaml.cs key off these ints). -->
                <RadioButton Tag="2" Style="{StaticResource TabStripButton}" Click="TabBtn_Click"
                             AutomationProperties.AutomationId="MappingsTab">
                    <TextBlock Text="{Binding Pad_Mappings, Source={x:Static strings:Strings.Instance}}" FontSize="15"/>
                </RadioButton>

                <!-- [Macros] -->
                <RadioButton Tag="1" Style="{StaticResource TabStripButton}" Click="TabBtn_Click">
                    <TextBlock Text="{Binding Pad_Macros, Source={x:Static strings:Strings.Instance}}" FontSize="15"/>
                </RadioButton>

                <!-- | separator -->
                <TextBlock Style="{StaticResource TabStripSeparator}"/>

                <!-- [Device ▼] — inline ComboBox -->
                <ComboBox ItemsSource="{Binding MappedDevices}"
                          SelectedItem="{Binding SelectedMappedDevice, Mode=TwoWay}"
                          MinWidth="200" Margin="4,2" VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                         VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#FF888888"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                    <Setter Property="Fill" Value="#FF4CAF50"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Name}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- | separator -->
                <TextBlock Style="{StaticResource TabStripSeparator}"/>

                <!-- Config tabs (device-scoped — Sticks / Triggers /
                     Force Feedback shape physical-input characteristics
                     for the selected device, so they sit AFTER the
                     Device dropdown). The Mappings tab was here in v3.1.x
                     and earlier; Issue #61 moves it left of the dropdown
                     because the mapping table is now per-VC, not per-device. -->
                <RadioButton x:Name="TabSticks" Tag="3" Style="{StaticResource TabStripButton}" Click="TabBtn_Click">
                    <TextBlock Text="{Binding Pad_Sticks, Source={x:Static strings:Strings.Instance}}" FontSize="13"/>
                </RadioButton>
                <RadioButton x:Name="TabTriggers" Tag="4" Style="{StaticResource TabStripButton}" Click="TabBtn_Click">
                    <TextBlock Text="{Binding Pad_Triggers, Source={x:Static strings:Strings.Instance}}" FontSize="13"/>
                </RadioButton>
                <RadioButton x:Name="TabForceFeedback" Tag="5" Style="{StaticResource TabStripButton}" Click="TabBtn_Click">
                    <TextBlock Text="{Binding Pad_ForceFeedback, Source={x:Static strings:Strings.Instance}}" FontSize="13"/>
                </RadioButton>

                <!-- Wheel tab — native-FFB wheels (Logitech / Fanatec / Thrustmaster) only.
                     Visibility driven from code-behind (SyncTabVisibility) when the
                     selected device matches a wheel VID/PID gate. Holds the wheel-only
                     settings (rotation range, auto-center, RPM shift LEDs) that used to
                     sit on the Force Feedback tab. -->
                <RadioButton x:Name="TabWheel" Tag="11" Style="{StaticResource TabStripButton}" Click="TabBtn_Click"
                             Visibility="Collapsed">
                    <TextBlock Text="{Binding Pad_Wheel, Source={x:Static strings:Strings.Instance}}" FontSize="13"/>
                </RadioButton>

                <!-- Impulse Triggers tab — Xbox One / Elite / Series only.
                     Visibility driven from code-behind via SyncTabVisibility
                     which checks the assigned device's HasRumbleTriggers
                     (SDL_PROP_JOYSTICK_CAP_TRIGGER_RUMBLE_BOOLEAN). Hidden
                     on Xbox 360, PlayStation, generic, MIDI, KbM. -->
                <RadioButton x:Name="TabImpulseTriggers" Tag="9" Style="{StaticResource TabStripButton}" Click="TabBtn_Click"
                             Visibility="Collapsed">
                    <TextBlock Text="{Binding Pad_ImpulseTriggers, Source={x:Static strings:Strings.Instance}}" FontSize="13"/>
                </RadioButton>

                <!-- Adaptive Triggers tab — DualSense / DualSense Edge only.
                     Visibility driven from code-behind via SyncTabStripSelection
                     which reads OutputType + ProfileId.  PadPage's runtime
                     visibility gate hides this RadioButton on Xbox / Extended
                     / MIDI / KbM slots and on DS4 PlayStation slots.  -->
                <RadioButton x:Name="TabAdaptiveTriggers" Tag="6" Style="{StaticResource TabStripButton}" Click="TabBtn_Click"
                             Visibility="Collapsed">
                    <TextBlock Text="{Binding Pad_AdaptiveTriggers, Source={x:Static strings:Strings.Instance}}" FontSize="13"/>
                </RadioButton>

                <!-- Lighting tab — DS4 / DualSense / DualSense Edge.  Hidden
                     on slots whose profile lacks a lightbar.  -->
                <RadioButton x:Name="TabLighting" Tag="7" Style="{StaticResource TabStripButton}" Click="TabBtn_Click"
                             Visibility="Collapsed">
                    <TextBlock Text="{Binding Pad_Lighting, Source={x:Static strings:Strings.Instance}}" FontSize="13"/>
                </RadioButton>

                <!-- Gyro tab — per-(device, slot) gyro tuning. Visible when
                     the selected mapped device has a gyroscope sensor
                     (driven from SyncTabVisibility via UserDevice.HasGyro). -->
                <RadioButton x:Name="TabGyro" Tag="8" Style="{StaticResource TabStripButton}" Click="TabBtn_Click"
                             Visibility="Collapsed">
                    <TextBlock Text="{Binding Pad_Gyro, Source={x:Static strings:Strings.Instance}}" FontSize="13"/>
                </RadioButton>

                <!-- Touchpad tab — per-(device, pad) gesture detection
                     settings. Visible when the selected mapped device
                     has at least one touchpad (UserDevice.HasTouchpad). -->
                <RadioButton x:Name="TabTouchpad" Tag="10" Style="{StaticResource TabStripButton}" Click="TabBtn_Click"
                             Visibility="Collapsed">
                    <TextBlock Text="{Binding Pad_Touchpad, Source={x:Static strings:Strings.Instance}}" FontSize="13"/>
                </RadioButton>
            </WrapPanel>
        </Border>

        <!-- ══════════════════════════════════════
             ROW 1: HIDMAESTRO PROFILE PICKER BAR
             (visible for Xbox / PlayStation / Extended slots)
             ══════════════════════════════════════ -->
        <Border x:Name="HMaestroProfileBar" Grid.Row="1" Margin="4,4,4,0"
                Padding="10,6" CornerRadius="4"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource TextFillColorDisabledBrush}" BorderThickness="1"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Pad_Preset, Source={x:Static strings:Strings.Instance}}"
                           VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                <ComboBox x:Name="HMaestroProfileCombo" Width="420" VerticalAlignment="Center"
                          AutomationProperties.AutomationId="HMaestroProfileCombo"
                          ItemsSource="{Binding AvailableProfiles}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding ProfileId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          PreviewKeyDown="ProfileCombo_PreviewKeyDown"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════
             ROW 1: EXTENDED CONFIGURATION BAR
             (visible only when OutputType == Extended)
             ══════════════════════════════════════ -->
        <Border x:Name="ExtendedConfigBar" Grid.Row="1" Margin="4,4,4,0"
                Padding="10,8" CornerRadius="4"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource TextFillColorDisabledBrush}" BorderThickness="1"
                Visibility="Collapsed">
            <StackPanel>
                <!-- Row 1: Profile picker + Import-from-device -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Pad_Preset, Source={x:Static strings:Strings.Instance}}"
                               VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                    <ComboBox x:Name="ExtendedProfileCombo" Width="420" VerticalAlignment="Center"
                              ItemsSource="{Binding AvailableProfiles}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding ProfileId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              PreviewKeyDown="ProfileCombo_PreviewKeyDown"/>
                    <Button x:Name="ExtendedImportBtn"
                            Content="{Binding Pad_ExtendedImportFromDevice, Source={x:Static strings:Strings.Instance}}"
                            Margin="12,0,0,0" VerticalAlignment="Center"
                            Click="ExtendedImportBtn_Click"
                            ToolTip="{Binding Pad_ExtendedImportFromDeviceTooltip, Source={x:Static strings:Strings.Instance}}"/>
                </StackPanel>

                <!-- Row 2: Master Customize toggle. Controls IsEnabled of rows 3+4 below.
                     When off, the VC uses the catalog profile as-is with no overrides. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                    <CheckBox x:Name="ExtendedCustomizeChk"
                              VerticalAlignment="Center"
                              Content="{Binding Pad_ExtendedCustomize, Source={x:Static strings:Strings.Instance}}"
                              Checked="ExtendedCustomize_Toggled" Unchecked="ExtendedCustomize_Toggled"
                              ToolTip="{Binding Pad_ExtendedCustomizeTooltip, Source={x:Static strings:Strings.Instance}}"/>
                    <Button x:Name="ExtendedResetDefaultsBtn" Style="{StaticResource ResetButton}"
                            Click="ExtendedResetDefaults_Click"
                            IsEnabled="{Binding IsChecked, ElementName=ExtendedCustomizeChk}"
                            ToolTip="{Binding Pad_ExtendedResetDefaultsTooltip, Source={x:Static strings:Strings.Instance}}"/>
                </StackPanel>

                <!-- Row 3: Identity override (Product String / OEM / VID / PID) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0"
                            IsEnabled="{Binding IsChecked, ElementName=ExtendedCustomizeChk}">
                    <TextBlock Text="{Binding Pad_ExtendedProductString, Source={x:Static strings:Strings.Instance}}"
                               VerticalAlignment="Center" Margin="0,0,4,0" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               ToolTip="{Binding Pad_ExtendedProductStringTooltip, Source={x:Static strings:Strings.Instance}}"/>
                    <TextBox x:Name="ExtendedProductStringBox" Width="280" VerticalAlignment="Center"
                             LostFocus="ExtendedOverride_Changed" KeyDown="ExtendedOverride_KeyDown"/>

                    <CheckBox x:Name="ExtendedOemOverrideChk" Margin="6,0,0,0"
                              VerticalAlignment="Center"
                              Content="{Binding Pad_ExtendedOemOverride, Source={x:Static strings:Strings.Instance}}"
                              Checked="ExtendedOemOverride_Toggled" Unchecked="ExtendedOemOverride_Toggled"
                              ToolTip="{Binding Pad_ExtendedOemOverrideTooltip, Source={x:Static strings:Strings.Instance}}"/>

                    <TextBlock Text="{Binding Pad_ExtendedVid, Source={x:Static strings:Strings.Instance}}"
                               VerticalAlignment="Center" Margin="12,0,4,0" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="ExtendedVidBox" Width="78" VerticalAlignment="Center"
                             TextAlignment="Center"
                             LostFocus="ExtendedOverride_Changed" KeyDown="ExtendedOverride_KeyDown"/>

                    <TextBlock Text="{Binding Pad_ExtendedPid, Source={x:Static strings:Strings.Instance}}"
                               VerticalAlignment="Center" Margin="12,0,4,0" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="ExtendedPidBox" Width="78" VerticalAlignment="Center"
                             TextAlignment="Center"
                             LostFocus="ExtendedOverride_Changed" KeyDown="ExtendedOverride_KeyDown"/>
                </StackPanel>

                <!-- Row 4: Layout override (Sticks / Triggers / POVs / Buttons) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0"
                            IsEnabled="{Binding IsChecked, ElementName=ExtendedCustomizeChk}">
                    <TextBlock Text="{Binding Pad_ExtendedSticks, Source={x:Static strings:Strings.Instance}}"
                               VerticalAlignment="Center" Margin="0,0,4,0" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="ExtendedStickCountBox" Width="40" VerticalAlignment="Center"
                             AutomationProperties.AutomationId="ExtendedStickCountBox"
                             TextAlignment="Center" Text="2"
                             LostFocus="ExtendedCustomValue_Changed" KeyDown="ExtendedCustomValue_KeyDown"/>

                    <TextBlock Text="{Binding Pad_ExtendedTriggers, Source={x:Static strings:Strings.Instance}}"
                               VerticalAlignment="Center" Margin="10,0,4,0" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="ExtendedTriggerCountBox" Width="40" VerticalAlignment="Center"
                             AutomationProperties.AutomationId="ExtendedTriggerCountBox"
                             TextAlignment="Center" Text="2"
                             LostFocus="ExtendedCustomValue_Changed" KeyDown="ExtendedCustomValue_KeyDown"/>

                    <TextBlock Text="{Binding Pad_ExtendedPOVs, Source={x:Static strings:Strings.Instance}}"
                               VerticalAlignment="Center" Margin="10,0,4,0" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="ExtendedPovCountBox" Width="40" VerticalAlignment="Center"
                             AutomationProperties.AutomationId="ExtendedPovCountBox"
                             TextAlignment="Center" Text="1"
                             LostFocus="ExtendedCustomValue_Changed" KeyDown="ExtendedCustomValue_KeyDown"/>

                    <TextBlock Text="{Binding Pad_ExtendedButtons, Source={x:Static strings:Strings.Instance}}"
                               VerticalAlignment="Center" Margin="10,0,4,0" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="ExtendedButtonCountBox" Width="72" VerticalAlignment="Center"
                             AutomationProperties.AutomationId="ExtendedButtonCountBox"
                             TextAlignment="Center" Text="11"
                             LostFocus="ExtendedCustomValue_Changed" KeyDown="ExtendedCustomValue_KeyDown"/>

                    <CheckBox x:Name="ExtendedForceFeedbackChk" Margin="14,0,0,0"
                              VerticalAlignment="Center"
                              Content="{Binding Pad_ExtendedForceFeedback, Source={x:Static strings:Strings.Instance}}"
                              IsChecked="{Binding ExtendedConfig.ForceFeedbackEnabled, Mode=TwoWay}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════
             ROW 1 (alt): MIDI CONFIGURATION BAR
             (visible only when OutputType == Midi)
             ══════════════════════════════════════ -->
        <Border x:Name="MidiConfigBar" Grid.Row="1" Margin="4,4,4,0"
                Padding="10,6" CornerRadius="4"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource TextFillColorDisabledBrush}" BorderThickness="1"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Pad_MidiChannel, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           ToolTip="{Binding Pad_MidiChannelTooltip, Source={x:Static strings:Strings.Instance}}"/>
                <TextBox x:Name="MidiChannelBox" Width="40" VerticalAlignment="Center"
                         TextAlignment="Center" Text="1"
                         LostFocus="MidiConfig_Changed" KeyDown="MidiConfig_KeyDown"/>

                <TextBlock Text="{Binding Pad_MidiCCCount, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="12,0,4,0" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           ToolTip="{Binding Pad_MidiCCCountTooltip, Source={x:Static strings:Strings.Instance}}"/>
                <TextBox x:Name="MidiCcCountBox" Width="54" VerticalAlignment="Center"
                         TextAlignment="Center" Text="6"
                         LostFocus="MidiConfig_Changed" KeyDown="MidiConfig_KeyDown"/>

                <TextBlock Text="{Binding Pad_MidiStartCC, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="12,0,4,0" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           ToolTip="{Binding Pad_MidiStartCCTooltip, Source={x:Static strings:Strings.Instance}}"/>
                <TextBox x:Name="MidiStartCcBox" Width="54" VerticalAlignment="Center"
                         TextAlignment="Center" Text="1"
                         LostFocus="MidiConfig_Changed" KeyDown="MidiConfig_KeyDown"/>

                <TextBlock Text="{Binding Pad_MidiNoteCount, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="12,0,4,0" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           ToolTip="{Binding Pad_MidiNoteCountTooltip, Source={x:Static strings:Strings.Instance}}"/>
                <TextBox x:Name="MidiNoteCountBox" Width="54" VerticalAlignment="Center"
                         TextAlignment="Center" Text="11"
                         LostFocus="MidiConfig_Changed" KeyDown="MidiConfig_KeyDown"/>

                <TextBlock Text="{Binding Pad_MidiStartNote, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="12,0,4,0" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           ToolTip="{Binding Pad_MidiStartNoteTooltip, Source={x:Static strings:Strings.Instance}}"/>
                <TextBox x:Name="MidiStartNoteBox" Width="54" VerticalAlignment="Center"
                         TextAlignment="Center" Text="60"
                         LostFocus="MidiConfig_Changed" KeyDown="MidiConfig_KeyDown"/>

                <TextBlock Text="{Binding Pad_MidiVelocity, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="12,0,4,0" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           ToolTip="{Binding Pad_MidiVelocityTooltip, Source={x:Static strings:Strings.Instance}}"/>
                <TextBox x:Name="MidiVelocityBox" Width="54" VerticalAlignment="Center"
                         TextAlignment="Center" Text="127"
                         LostFocus="MidiConfig_Changed" KeyDown="MidiConfig_KeyDown"/>
            </StackPanel>
        </Border>

        <!-- Expose Mappings count for UI Automation tests (invisible but accessible) -->
        <TextBlock AutomationProperties.AutomationId="MappingsCountIndicator"
                   AutomationProperties.Name="{Binding Mappings.Count}"
                   Width="0" Height="0" Opacity="0"/>

        <!-- ═══════════════════════════════════════════
             ROW 2: Configuration TabControl
             Tabs: Controller | Mappings | Left Stick | Right Stick | Triggers | Force Feedback | Macros
             ═══════════════════════════════════════════ -->
        <TabControl Grid.Row="2"
                    SelectedIndex="{Binding SelectedConfigTab, Mode=TwoWay}">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                      ContentSource="SelectedContent"/>
                </ControlTemplate>
            </TabControl.Template>

            <!-- ─── TAB 0: Controller (slot-level) ─── -->
            <TabItem>
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>      <!-- 3D viewport -->
                        <RowDefinition Height="Auto"/>   <!-- Motor bars -->
                        <RowDefinition Height="Auto"/>   <!-- Map All -->
                    </Grid.RowDefinitions>

                    <!-- ══════════════════════════════════════
                         CONTROLLER MODEL (2D / 3D)
                         ══════════════════════════════════════ -->
                    <Grid Grid.Row="0" AutomationProperties.AutomationId="ControllerModelHost">
                        <views:ControllerModelView x:Name="ControllerModel3D" />
                        <views:ControllerModel2DView x:Name="ControllerModel2D" Visibility="Collapsed" />
                        <views:ControllerSchematicView x:Name="ControllerSchematic" Visibility="Collapsed" />
                        <views:MidiPreviewView x:Name="MidiPreview" Visibility="Collapsed" />
                        <views:KBMPreviewView x:Name="KBMPreview" Visibility="Collapsed" />

                        <!-- 2D/3D toggle button (top-left to avoid overlap with 3D Reset View) -->
                        <Button x:Name="ViewModeToggle"
                                AutomationProperties.AutomationId="ViewModeToggle"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="8,8,0,0" Padding="6,4"
                                Click="ViewModeToggle_Click" ToolTip="{Binding Pad_SwitchTo2D, Source={x:Static strings:Strings.Instance}}">
                            <TextBlock x:Name="ViewModeIcon" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Text="&#xE8B9;"/>
                        </Button>
                    </Grid>

                    <!-- ══════════════════════════════════════
                         MOTOR ACTIVITY INDICATORS
                         ══════════════════════════════════════ -->
                    <Grid x:Name="MotorBarsGrid" Grid.Row="1" Width="500" Margin="0,4,0,4" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Cursor="Hand" Margin="0,0,12,0"
                                    MouseEnter="Motor_MouseEnter" MouseLeave="Motor_MouseLeave"
                                    MouseLeftButtonDown="LeftMotor_Click"
                                    ToolTip="{Binding Pad_TestLeftMotor, Source={x:Static strings:Strings.Instance}}"
                                    Background="Transparent">
                            <TextBlock Text="{Binding Pad_LeftMotor, Source={x:Static strings:Strings.Instance}}" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <Border Height="24" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="3"
                                    BorderBrush="{DynamicResource TextFillColorDisabledBrush}" BorderThickness="1">
                                <Rectangle Fill="#FF2196F3" RadiusX="2" RadiusY="2"
                                           HorizontalAlignment="Left"
                                           Width="{Binding LeftMotorDisplay,
                                               Converter={StaticResource NormToTriggerHeightConverter},
                                               ConverterParameter=240}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Cursor="Hand" Margin="12,0,0,0"
                                    MouseEnter="Motor_MouseEnter" MouseLeave="Motor_MouseLeave"
                                    MouseLeftButtonDown="RightMotor_Click"
                                    ToolTip="{Binding Pad_TestRightMotor, Source={x:Static strings:Strings.Instance}}"
                                    Background="Transparent">
                            <TextBlock Text="{Binding Pad_RightMotor, Source={x:Static strings:Strings.Instance}}" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <Border Height="24" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="3"
                                    BorderBrush="{DynamicResource TextFillColorDisabledBrush}" BorderThickness="1">
                                <Rectangle Fill="#FF2196F3" RadiusX="2" RadiusY="2"
                                           HorizontalAlignment="Left"
                                           Width="{Binding RightMotorDisplay,
                                               Converter={StaticResource NormToTriggerHeightConverter},
                                               ConverterParameter=240}"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ══════════════════════════════════════
                         MAP ALL — Controller tab controls
                         ══════════════════════════════════════ -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,4">
                        <Button Content="{Binding MapAllButtonText}"
                                Padding="16,8" FontSize="14"
                                ToolTip="{Binding MapAllButtonTooltip}"
                                Click="MapAllToggle_Click"/>
                        <TextBlock Text="{Binding MapAllPromptText}" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="#FF2196F3"
                                   Visibility="{Binding MapAllPromptText, Converter={StaticResource NullToCollapsedConverter}}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ─── TAB 1: Macros (slot-level) ─── -->
            <TabItem>
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Macro list -->
                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="{Binding Common_Add, Source={x:Static strings:Strings.Instance}}" Command="{Binding AddMacroCommand}"
                                    Padding="8,4" Margin="0,0,4,0"/>
                            <Button Content="{Binding Common_Remove, Source={x:Static strings:Strings.Instance}}" Command="{Binding RemoveMacroCommand}"
                                    Padding="8,4"/>
                        </StackPanel>

                        <ListBox ItemsSource="{Binding Macros}"
                                 SelectedItem="{Binding SelectedMacro, Mode=TwoWay}"
                                 DisplayMemberPath="Name"/>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="4" Margin="4,0"
                                  HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                  ResizeBehavior="PreviousAndNext"/>

                    <!-- Macro editor (shows when a macro is selected) -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Auto"
                                  Padding="8"
                                  DataContext="{Binding SelectedMacro}"
                                  Visibility="{Binding DataContext.HasSelectedMacro,
                                      RelativeSource={RelativeSource AncestorType=TabItem},
                                      Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <!-- Macro name -->
                            <TextBlock Text="{Binding Macro_Name, Source={x:Static strings:Strings.Instance}}" FontWeight="SemiBold" Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,12"/>

                            <!-- Enabled -->
                            <CheckBox Content="{Binding Common_Enabled, Source={x:Static strings:Strings.Instance}}" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                      Margin="0,0,0,12"/>

                            <!-- Trigger mode -->
                            <TextBlock Text="{Binding Macro_Trigger, Source={x:Static strings:Strings.Instance}}" FontWeight="SemiBold"
                                       Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding Macro_Fire, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <ComboBox SelectedValue="{Binding TriggerMode, Mode=TwoWay}"
                                          SelectedValuePath="Tag" MinWidth="120">
                                    <ComboBoxItem Content="{Binding Macro_OnPress, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerMode.OnPress}"/>
                                    <ComboBoxItem Content="{Binding Macro_OnRelease, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerMode.OnRelease}"/>
                                    <ComboBoxItem Content="{Binding Macro_WhileHeld, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerMode.WhileHeld}"/>
                                    <ComboBoxItem Content="{Binding Macro_Always, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerMode.Always}"/>
                                    <ComboBoxItem Content="{Binding Macro_CustomExpression, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerMode.CustomExpression}"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Custom-expression editor (visible only when TriggerMode = CustomExpression).
                                 Sits ABOVE the legacy trigger-combo block so it shares the same
                                 spot in the layout. Named `FormulaEditor` so the shared
                                 FormulaChip_Click / FormulaPreset_Click handlers in
                                 PadPage.xaml.cs find the right textbox (they walk up the visual
                                 tree looking for an ancestor named "FormulaEditor"). -->
                            <StackPanel x:Name="FormulaEditor"
                                        Visibility="{Binding IsCustomExpressionMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Margin="0,0,0,8">
                                <TextBlock Text="{Binding Macro_Expression_Header, Source={x:Static strings:Strings.Instance}}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBox x:Name="CustomFormulaBox"
                                         Text="{Binding TriggerExpression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Consolas"
                                         AcceptsReturn="False"
                                         AllowDrop="True"
                                         Padding="6,4"
                                         Margin="0,0,0,4">
                                    <TextBox.ToolTip>
                                        <TextBlock Text="{Binding Macro_Expression_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    </TextBox.ToolTip>
                                </TextBox>
                                <TextBlock Text="{Binding CustomExpressionStatus}"
                                           FontSize="11" Margin="0,0,0,6"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCustomExpressionInvalid}" Value="True">
                                                    <Setter Property="Foreground" Value="#E81123"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCustomExpressionWarning}" Value="True">
                                                    <Setter Property="Foreground" Value="#CA5010"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Chip palette: click to insert at caret, or drag onto the
                                     formula box. Reuses FormulaChip_Click + the drag-out
                                     handlers from the merge-mapping editor verbatim. -->
                                <TextBlock Text="{Binding Pad_Formula_Insert, Source={x:Static strings:Strings.Instance}}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="2,4,0,2"/>
                                <WrapPanel Margin="0,0,0,4">
                                    <WrapPanel.Resources>
                                        <Style x:Key="MacroFormulaChipStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                            <Setter Property="Padding" Value="6,2"/>
                                            <Setter Property="Margin" Value="0,0,3,3"/>
                                            <Setter Property="MinWidth" Value="28"/>
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="FormulaChip_PreviewMouseLeftButtonDown"/>
                                            <EventSetter Event="PreviewMouseMove" Handler="FormulaChip_PreviewMouseMove"/>
                                        </Style>
                                    </WrapPanel.Resources>
                                    <!-- Variable chips: a..z. Visibility tracks VariableCount so
                                         the palette only shows letters that bind to a real variable. -->
                                    <Button Content="a" Tag="a" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=0}"/>
                                    <Button Content="b" Tag="b" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=1}"/>
                                    <Button Content="c" Tag="c" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=2}"/>
                                    <Button Content="d" Tag="d" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=3}"/>
                                    <Button Content="e" Tag="e" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=4}"/>
                                    <Button Content="f" Tag="f" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=5}"/>
                                    <Button Content="g" Tag="g" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=6}"/>
                                    <Button Content="h" Tag="h" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=7}"/>
                                    <Button Content="i" Tag="i" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=8}"/>
                                    <Button Content="j" Tag="j" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=9}"/>
                                    <Button Content="k" Tag="k" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=10}"/>
                                    <Button Content="l" Tag="l" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=11}"/>
                                    <Button Content="m" Tag="m" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=12}"/>
                                    <Button Content="n" Tag="n" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=13}"/>
                                    <Button Content="o" Tag="o" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=14}"/>
                                    <Button Content="p" Tag="p" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=15}"/>
                                    <Button Content="q" Tag="q" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=16}"/>
                                    <Button Content="r" Tag="r" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=17}"/>
                                    <Button Content="s" Tag="s" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=18}"/>
                                    <Button Content="t" Tag="t" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=19}"/>
                                    <Button Content="u" Tag="u" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=20}"/>
                                    <Button Content="v" Tag="v" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=21}"/>
                                    <Button Content="w" Tag="w" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=22}"/>
                                    <Button Content="x" Tag="x" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=23}"/>
                                    <Button Content="y" Tag="y" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=24}"/>
                                    <Button Content="z" Tag="z" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=25}"/>
                                    <Border Width="6"/>
                                    <Button Content="+" Tag=" + " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Add, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="−" Tag=" - " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Subtract, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="×" Tag=" * " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Multiply, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="÷" Tag=" / " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Divide, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="−A" Tag="-a" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_NegateA, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="(" Tag="(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_OpenGroup, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content=")" Tag=")" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_CloseGroup, Source={x:Static strings:Strings.Instance}}"/>
                                    <Border Width="6"/>
                                    <Button Content="0" Tag="0" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click"/>
                                    <Button Content="½" Tag="0.5" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Half, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="1" Tag="1" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click"/>
                                    <Button Content="2" Tag="2" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click"/>
                                    <Border Width="6"/>
                                    <Button Content="&lt;" Tag=" &lt; " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_LessThan, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="&gt;" Tag=" &gt; " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_GreaterThan, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="≤" Tag=" &lt;= " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_LessOrEqual, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="≥" Tag=" &gt;= " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_GreaterOrEqual, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="=" Tag=" == " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Equal, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="≠" Tag=" != " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_NotEqual, Source={x:Static strings:Strings.Instance}}"/>
                                    <Border Width="6"/>
                                    <Button Content="and" Tag=" &amp;&amp; " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_BothConditions, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="or" Tag=" || " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_EitherCondition, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="not" Tag="!" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_FlipBool, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="if?" Tag=" ? " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_If, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="else:" Tag=" : " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Else, Source={x:Static strings:Strings.Instance}}"/>
                                    <Border Width="6"/>
                                    <Button Content="abs" Tag="abs(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Abs, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="min" Tag="min(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Min, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="max" Tag="max(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Max, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="clamp" Tag="clamp(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Clamp, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="sign" Tag="sign(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Sign, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="lerp" Tag="lerp(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Lerp, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="round" Tag="round(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Round, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="sqrt" Tag="sqrt(" Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Sqrt, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="," Tag=", " Style="{StaticResource MacroFormulaChipStyle}" Click="FormulaChip_Click"/>
                                </WrapPanel>

                                <!-- Starter recipes — common trigger patterns. Each button's
                                     Tag is the full formula; clicking replaces the box text. -->
                                <TextBlock Text="{Binding Pad_Formula_StarterRecipes, Source={x:Static strings:Strings.Instance}}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="2,2,0,2"/>
                                <WrapPanel Margin="0,0,0,6">
                                    <WrapPanel.Resources>
                                        <Style x:Key="MacroFormulaPresetStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                            <Setter Property="Padding" Value="8,3"/>
                                            <Setter Property="Margin" Value="0,0,4,3"/>
                                            <Setter Property="FontSize" Value="11"/>
                                        </Style>
                                    </WrapPanel.Resources>
                                    <Button Content="{Binding Macro_Expression_Recipe_Single, Source={x:Static strings:Strings.Instance}}" Tag="a"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Macro_Expression_Recipe_Single_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Macro_Expression_Recipe_Both, Source={x:Static strings:Strings.Instance}}" Tag="a &amp;&amp; b"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Macro_Expression_Recipe_Both_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Macro_Expression_Recipe_Either, Source={x:Static strings:Strings.Instance}}" Tag="a || b"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Macro_Expression_Recipe_Either_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Macro_Expression_Recipe_AButNotB, Source={x:Static strings:Strings.Instance}}" Tag="a &amp;&amp; !b"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Macro_Expression_Recipe_AButNotB_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Macro_Expression_Recipe_AxisOverHalf, Source={x:Static strings:Strings.Instance}}" Tag="abs(a - 0.5) &gt; 0.25"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Macro_Expression_Recipe_AxisOverHalf_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <!-- Shared recipes from the merge-mapping editor. Same Pad_Formula_Preset_*
                                         keys, already translated across all 10 locales. -->
                                    <Button Content="{Binding Pad_Formula_Preset_HalfScale_Name, Source={x:Static strings:Strings.Instance}}" Tag="a * 0.5"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Pad_Formula_Preset_HalfScale_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Formula_Preset_QuarterScale_Name, Source={x:Static strings:Strings.Instance}}" Tag="a * 0.25"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Pad_Formula_Preset_QuarterScale_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Formula_Preset_ReverseA_Name, Source={x:Static strings:Strings.Instance}}" Tag="-a"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Pad_Formula_Preset_ReverseA_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Formula_Preset_CapTo1_Name, Source={x:Static strings:Strings.Instance}}" Tag="clamp(a + b, -1, 1)"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Pad_Formula_Preset_CapTo1_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Formula_Preset_WeightedBlend_Name, Source={x:Static strings:Strings.Instance}}" Tag="a * 0.7 + b * 0.3"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Pad_Formula_Preset_WeightedBlend_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Formula_Preset_Difference_Name, Source={x:Static strings:Strings.Instance}}" Tag="a - b"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Pad_Formula_Preset_Difference_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Formula_Preset_AUnlessIdle_Name, Source={x:Static strings:Strings.Instance}}" Tag="a != 0 ? a : b"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Pad_Formula_Preset_AUnlessIdle_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Formula_Preset_ThresholdGate_Name, Source={x:Static strings:Strings.Instance}}" Tag="(a &gt; 0.5) ? 1 : 0"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Pad_Formula_Preset_ThresholdGate_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Formula_Preset_BothPressed_Name, Source={x:Static strings:Strings.Instance}}" Tag="(a &gt; 0) &amp;&amp; (b &gt; 0) ? 1 : 0"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Pad_Formula_Preset_BothPressed_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Pad_Formula_Preset_StrongerWins_Name, Source={x:Static strings:Strings.Instance}}" Tag="max(abs(a), abs(b)) * sign(a + b)"
                                            Style="{StaticResource MacroFormulaPresetStyle}" Click="FormulaPreset_Click"
                                            ToolTip="{Binding Pad_Formula_Preset_StrongerWins_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                </WrapPanel>

                                <!-- Variable list. Each row binds one variable to either an
                                     input-device input or an output-controller channel. -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Macro_Expression_Variables, Source={x:Static strings:Strings.Instance}}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <Button Content="{Binding Macro_Expression_AddVariable, Source={x:Static strings:Strings.Instance}}"
                                            Command="{Binding AddExpressionVariableCommand}"
                                            Padding="8,2"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding TriggerExpressionVariables}"
                                              AlternationCount="32">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource TextFillColorTertiaryBrush}"
                                                    BorderThickness="1" CornerRadius="3"
                                                    Padding="6,4" Margin="0,0,0,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource IndexToLetterConverter}}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"
                                                               FontFamily="Consolas"
                                                               FontWeight="SemiBold"/>
                                                    <ComboBox SelectedValue="{Binding Source, Mode=TwoWay}"
                                                              SelectedValuePath="Tag" MinWidth="140" Margin="0,0,8,0">
                                                        <ComboBoxItem Content="{Binding Macro_InputDevice, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerSource.InputDevice}"/>
                                                        <ComboBoxItem Content="{Binding Macro_OutputController, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerSource.OutputController}"/>
                                                    </ComboBox>
                                                    <!-- OutputChannel dropdown — items are sourced from the
                                                         parent macro's OutputChannelOptions list, which renders
                                                         labels per the slot's VC family (matches the mapping
                                                         table: PlayStation ✕/○/◻/△ + L1/R1, Extended
                                                         Button N, Xbox A/B/X/Y + Left Shoulder, etc.). -->
                                                    <ComboBox ItemsSource="{Binding DataContext.OutputChannelOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              SelectedValue="{Binding OutputChannel, Mode=TwoWay}"
                                                              SelectedValuePath="Value"
                                                              DisplayMemberPath="Name"
                                                              MinWidth="160" Margin="0,0,8,0"
                                                              Visibility="{Binding Source, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=OutputController}"/>
                                                    <TextBlock Text="{Binding DisplaySummary}"
                                                               VerticalAlignment="Center"
                                                               FontStyle="Italic"
                                                               TextTrimming="CharacterEllipsis"
                                                               MinWidth="120"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Visibility="{Binding Source, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=InputDevice}"/>
                                                    <!-- Record / Stop button. Works for both Input Device
                                                         (captures the next press / axis on a physical device)
                                                         and Output Controller (captures the next change on the
                                                         slot's combined Gamepad output). Width/Padding/Vert
                                                         alignment match the merge-mapping per-source Record
                                                         buttons for visual parity. -->
                                                    <Button Command="{Binding RecordCommand}"
                                                            Width="36" Padding="2" Margin="6,0,2,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RecordIcon}" FontFamily="Segoe MDL2 Assets"/>
                                                        <Button.ToolTip>
                                                            <TextBlock Text="{Binding RecordTooltip}"/>
                                                        </Button.ToolTip>
                                                    </Button>
                                                    <!-- Clear binding button — keeps the variable slot but
                                                         resets the device/channel binding. -->
                                                    <Button Command="{Binding ClearBindingCommand}"
                                                            Width="36" Padding="2" Margin="0,0,2,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE75C;" FontFamily="Segoe MDL2 Assets"/>
                                                        <Button.ToolTip>
                                                            <TextBlock Text="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}"/>
                                                        </Button.ToolTip>
                                                    </Button>
                                                    <!-- Delete variable button — removes the row from the
                                                         macro's variable list. Subsequent variables shift
                                                         letters (b becomes a, etc.). Binds back up to the
                                                         macro via RelativeSource AncestorType=ItemsControl. -->
                                                    <Button Width="36" Padding="2"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding DataContext.RemoveExpressionVariableCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"/>
                                                        <Button.ToolTip>
                                                            <TextBlock Text="{Binding Common_Delete, Source={x:Static strings:Strings.Instance}}"/>
                                                        </Button.ToolTip>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding Macro_Expression_Hint, Source={x:Static strings:Strings.Instance}}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Trigger combination (visible only when one of OnPress / OnRelease / WhileHeld) -->
                            <StackPanel Visibility="{Binding ShowsTriggerComboEditor, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding Macro_Trigger, Source={x:Static strings:Strings.Instance}}" FontWeight="SemiBold"
                                           Margin="0,0,0,4"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Macro_Source, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <ComboBox SelectedValue="{Binding TriggerSource, Mode=TwoWay}"
                                              SelectedValuePath="Tag" MinWidth="160">
                                        <ComboBoxItem Content="{Binding Macro_InputDevice, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerSource.InputDevice}"/>
                                        <ComboBoxItem Content="{Binding Macro_OutputController, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroTriggerSource.OutputController}"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Grid MinWidth="150" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding TriggerDisplayText}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsRecordingTrigger, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                        <TextBlock Text="{Binding RecordingLiveText}"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Visibility="{Binding IsRecordingTrigger, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>
                                    <!-- Record/Stop button -->
                                    <Button Command="{Binding RecordTriggerCommand}" Width="40" Margin="0,0,4,0">
                                        <TextBlock Text="{Binding RecordTriggerIcon}" FontFamily="Segoe MDL2 Assets"/>
                                        <Button.ToolTip>
                                            <TextBlock Text="{Binding RecordTriggerButtonText}"/>
                                        </Button.ToolTip>
                                    </Button>
                                    <!-- Clear trigger button -->
                                    <Button Command="{Binding ClearTriggerCommand}" Width="40">
                                        <TextBlock Text="&#xE75C;" FontFamily="Segoe MDL2 Assets"/>
                                        <Button.ToolTip>
                                            <TextBlock Text="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}"/>
                                        </Button.ToolTip>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{Binding Macro_RecordHint, Source={x:Static strings:Strings.Instance}}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,0,4"/>

                                <!-- Legacy slot-combined axis Threshold + Direction. Visible
                                     only for OutputController-source triggers that landed in
                                     the slot-combined TriggerAxisTargets list — InputDevice
                                     triggers go through the per-device axis entries below and
                                     carry their own Invert / Half / DeadZone, so these
                                     duplicate controls would just be redundant + confusing. -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                            Visibility="{Binding HasLegacyAxisTrigger, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Macro_Threshold, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <Slider Value="{Binding TriggerAxisThreshold, Mode=TwoWay}"
                                            Minimum="1" Maximum="100" Width="150"
                                            VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding TriggerAxisThreshold, Mode=OneWay}"/>
                                        <TextBlock Text="%"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                            Visibility="{Binding HasLegacyAxisTrigger, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Macro_AxisDirection, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <ComboBox SelectedIndex="{Binding TriggerAxisDirectionIndex, Mode=TwoWay}" MinWidth="120">
                                        <ComboBoxItem Content="{Binding Macro_AxisDirection_Any, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Macro_AxisDirection_Positive, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Macro_AxisDirection_Negative, Source={x:Static strings:Strings.Instance}}"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Per-device axis entries editor — one row per axis entry, same
                                     Invert / HalfAxis / DeadZone trio the merge-mapping editor uses
                                     for its axis-to-button sources. Visible only when the recorded
                                     combo contains at least one per-device axis entry. -->
                                <ItemsControl ItemsSource="{Binding TriggerAxisEntries}"
                                              Margin="0,4,0,4"
                                              Visibility="{Binding HasTriggerAxisEntries, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DeviceLabel}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding AxisLabel}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <CheckBox Content="{Binding Pad_Invert, Source={x:Static strings:Strings.Instance}}"
                                                          IsChecked="{Binding Invert, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <CheckBox Content="{Binding Pad_Half, Source={x:Static strings:Strings.Instance}}"
                                                          IsChecked="{Binding HalfAxis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <CheckBox Content="{Binding Pad_Either, Source={x:Static strings:Strings.Instance}}"
                                                          ToolTip="{Binding Pad_Either_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                          IsChecked="{Binding Bidirectional, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding HalfAxis}"
                                                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Slider Style="{StaticResource DzSlider}" Width="120"
                                                        Value="{Binding DeadZone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        TickFrequency="1"/>
                                                <TextBox Text="{Binding DeadZone, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                <Button Command="{Binding ResetDeadZoneCommand}" Style="{StaticResource ResetButton}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <CheckBox Content="{Binding Macro_ConsumeTrigger, Source={x:Static strings:Strings.Instance}}"
                                          IsChecked="{Binding ConsumeTriggerButtons, Mode=TwoWay}"
                                          Margin="0,0,0,4"/>
                            </StackPanel>

                            <!-- Always mode note -->
                            <TextBlock Text="{Binding Macro_AlwaysDesc, Source={x:Static strings:Strings.Instance}}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,4"
                                       Visibility="{Binding IsNotAlwaysMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>

                            <Separator Margin="0,4,0,12"/>

                            <!-- Action sequence -->
                            <TextBlock Text="{Binding Macro_ActionSequence, Source={x:Static strings:Strings.Instance}}" FontWeight="SemiBold"
                                       Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="{Binding Macro_AddAction, Source={x:Static strings:Strings.Instance}}" Command="{Binding AddActionCommand}"
                                        Padding="8,4" Margin="0,0,4,0"/>
                                <Button Content="{Binding Common_Remove, Source={x:Static strings:Strings.Instance}}" Command="{Binding RemoveActionCommand}"
                                        Padding="8,4"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Actions}"
                                     SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                                     DisplayMemberPath="DisplayText"
                                     MinHeight="100" MaxHeight="200" Margin="0,0,0,4"/>

                            <!-- Action editor (shows when an action is selected) -->
                            <Border BorderBrush="{DynamicResource TextFillColorTertiaryBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,12"
                                    DataContext="{Binding SelectedAction}"
                                    Visibility="{Binding DataContext.SelectedAction,
                                        RelativeSource={RelativeSource AncestorType=ScrollViewer},
                                        Converter={StaticResource NullToCollapsedConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Macro_EditAction, Source={x:Static strings:Strings.Instance}}" FontWeight="SemiBold" Margin="0,0,0,8"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                    <!-- Action type -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Macro_ActionType, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                   Width="80" Margin="0,0,8,0"/>
                                        <ComboBox SelectedValue="{Binding Type, Mode=TwoWay}"
                                                  SelectedValuePath="Tag" MinWidth="150">
                                            <ComboBoxItem Content="{Binding Macro_ButtonPress, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroActionType.ButtonPress}"/>
                                            <ComboBoxItem Content="{Binding Macro_ButtonRelease, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroActionType.ButtonRelease}"/>
                                            <ComboBoxItem Content="{Binding Macro_KeyPress, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroActionType.KeyPress}"/>
                                            <ComboBoxItem Content="{Binding Macro_KeyRelease, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroActionType.KeyRelease}"/>
                                            <ComboBoxItem Content="{Binding Macro_Delay, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroActionType.Delay}"/>
                                            <ComboBoxItem Content="{Binding Macro_SetAxis, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroActionType.AxisSet}"/>
                                            <ComboBoxItem Content="{Binding Macro_SystemVolume, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroActionType.SystemVolume}"/>
                                            <ComboBoxItem Content="{Binding Macro_AppVolume, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroActionType.AppVolume}"/>
                                            <ComboBoxItem Content="{Binding Macro_MouseMove, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroActionType.MouseMove}"/>
                                            <ComboBoxItem Content="{Binding Macro_MouseButtonPress, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroActionType.MouseButtonPress}"/>
                                            <ComboBoxItem Content="{Binding Macro_MouseButtonRelease, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroActionType.MouseButtonRelease}"/>
                                            <ComboBoxItem Content="{Binding Macro_MouseScroll, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroActionType.MouseScroll}"/>
                                            <ComboBoxItem Content="{Binding Macro_ToggleTouchpadOverlay, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroActionType.ToggleTouchpadOverlay}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_LightbarColor, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.LightbarColor}"
                                                          ToolTip="{Binding MacroAction_LightbarColor_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_LightbarColorClear, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.LightbarColorClear}"
                                                          ToolTip="{Binding MacroAction_LightbarColorClear_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_LightbarModeSet, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.LightbarModeSet}"
                                                          ToolTip="{Binding MacroAction_LightbarModeSet_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_LightbarModeCycle, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.LightbarModeCycle}"
                                                          ToolTip="{Binding MacroAction_LightbarModeCycle_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_Rumble, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.Rumble}"
                                                          ToolTip="{Binding MacroAction_Rumble_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding MacroAction_Type_RumbleStop, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.RumbleStop}"
                                                          ToolTip="{Binding MacroAction_RumbleStop_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <ComboBoxItem Content="{Binding Macro_SetGyroEngaged, Source={x:Static strings:Strings.Instance}}"
                                                          Tag="{x:Static vm:MacroActionType.SetGyroEngaged}"
                                                          ToolTip="{Binding Macro_SetGyroEngaged_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- SetGyroEngaged Mode picker — Toggle / On / Off -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                                Visibility="{Binding IsSetGyroEngagedType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Macro_SetGyroEngaged_Mode_Label, Source={x:Static strings:Strings.Instance}}"
                                                   Width="60" VerticalAlignment="Center"/>
                                        <ComboBox SelectedValue="{Binding SetGyroEngagedMode, Mode=TwoWay}"
                                                  SelectedValuePath="Tag"
                                                  Width="160" VerticalAlignment="Center"
                                                  ScrollViewer.VerticalScrollBarVisibility="Visible"
                                                  ToolTip="{Binding Macro_SetGyroEngaged_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                            <ComboBoxItem Content="{Binding Macro_SetGyroEngaged_Toggle, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroSetGyroEngagedMode.Toggle}"/>
                                            <ComboBoxItem Content="{Binding Macro_SetGyroEngaged_On, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroSetGyroEngagedMode.On}"/>
                                            <ComboBoxItem Content="{Binding Macro_SetGyroEngaged_Off, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroSetGyroEngagedMode.Off}"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Button flags — checkbox grid for ButtonPress / ButtonRelease -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsButtonType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Macro_Buttons, Source={x:Static strings:Strings.Instance}}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding ButtonOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Label}"
                                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                              MinWidth="70" Margin="0,0,8,4"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Key combo — for KeyPress / KeyRelease -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsKeyType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Macro_KeyCombo, Source={x:Static strings:Strings.Instance}}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding KeyString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Consolas" Margin="0,0,0,4"
                                                 ToolTip="{Binding Macro_KeyComboTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <ComboBox ItemsSource="{x:Static vm:MacroAction.VirtualKeyValues}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="Key"
                                                      SelectedValue="{Binding SelectedKeyToAdd, Mode=TwoWay}"
                                                      MinWidth="180" MaxDropDownHeight="300"
                                                      IsTextSearchEnabled="True"/>
                                            <Button Content="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}" Command="{Binding ClearKeyStringCommand}"
                                                    Padding="8,4" Margin="4,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Macro_KeyComboHint, Source={x:Static strings:Strings.Instance}}"
                                                   FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Duration — for ButtonPress / KeyPress / Delay / LightbarColor -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                                Visibility="{Binding IsDurationType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Macro_Duration, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                   Width="80" Margin="0,0,8,0"/>
                                        <TextBox Text="{Binding DurationMs, Mode=TwoWay}" Width="80"/>
                                        <TextBlock Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>

                                    <!-- Lightbar Color card (Reactive | Sticky) -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6"
                                            Visibility="{Binding IsLightbarType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MacroAction_Type_LightbarColor, Source={x:Static strings:Strings.Instance}}"
                                                       FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Macro_LightbarHold_Label, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="80" Margin="0,0,8,0"/>
                                                <ComboBox SelectedValue="{Binding LightbarHoldMode, Mode=TwoWay}"
                                                          SelectedValuePath="Tag" MinWidth="140">
                                                    <ComboBoxItem Content="{Binding Macro_LightbarHold_Reactive, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroLightbarHoldMode.Reactive}"/>
                                                    <ComboBoxItem Content="{Binding Macro_LightbarHold_Sticky, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroLightbarHoldMode.Sticky}"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <!-- Color source — Reactive only. Sticky always uses Fixed. -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                                        Visibility="{Binding IsLightbarReactiveHold, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Macro_LightbarColorSource_Label, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="80" Margin="0,0,8,0"/>
                                                <ComboBox SelectedValue="{Binding LightbarColorSource, Mode=TwoWay}"
                                                          SelectedValuePath="Tag" MinWidth="160">
                                                    <ComboBoxItem Content="{Binding Macro_LightbarColorSource_Fixed, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroLightbarColorSource.Fixed}"/>
                                                    <ComboBoxItem Content="{Binding Macro_LightbarColorSource_RandomHue, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroLightbarColorSource.RandomHue}"/>
                                                    <ComboBoxItem Content="{Binding Macro_LightbarColorSource_PaletteStep, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroLightbarColorSource.PaletteStep}"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <!-- Color picker — visible for Sticky always, Reactive only when Source=Fixed. -->
                                            <StackPanel Margin="0,0,0,6"
                                                        Visibility="{Binding IsLightbarFixedColorVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <views:ColorPickerControl HorizontalAlignment="Left" Margin="0,0,0,4"
                                                                          Red="{Binding LightbarR, Mode=TwoWay}"
                                                                          Green="{Binding LightbarG, Mode=TwoWay}"
                                                                          Blue="{Binding LightbarB, Mode=TwoWay}"/>
                                                <Border Width="80" Height="20" HorizontalAlignment="Left" CornerRadius="3"
                                                        BorderBrush="{DynamicResource TextFillColorDisabledBrush}" BorderThickness="1">
                                                    <Border.Background>
                                                        <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                                            <Binding Path="LightbarR"/>
                                                            <Binding Path="LightbarG"/>
                                                            <Binding Path="LightbarB"/>
                                                        </MultiBinding>
                                                    </Border.Background>
                                                </Border>
                                            </StackPanel>
                                            <!-- Per-macro palette editor — visible only when Reactive + PaletteStep. -->
                                            <StackPanel Margin="0,0,0,6"
                                                        Visibility="{Binding IsLightbarPaletteVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Macro_LightbarPalette_Label, Source={x:Static strings:Strings.Instance}}"
                                                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding Macro_LightbarPalette_Empty, Source={x:Static strings:Strings.Instance}}"
                                                           FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Margin="0,0,0,4"/>
                                                <ItemsControl ItemsSource="{Binding LightbarPalette}" Margin="0,0,0,4">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:LightbarPaletteEntry}">
                                                            <Border BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,6,6"
                                                                    BorderBrush="{DynamicResource TextFillColorDisabledBrush}">
                                                                <StackPanel>
                                                                    <Button Command="{Binding DataContext.RemoveLightbarPaletteColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            HorizontalAlignment="Right" Margin="0,0,0,4"
                                                                            Padding="4,0" MinWidth="20"
                                                                            ToolTip="{Binding Pad_Lighting_RemoveColor, Source={x:Static strings:Strings.Instance}}">
                                                                        <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                                                                    </Button>
                                                                    <views:ColorPickerControl HorizontalAlignment="Left"
                                                                        Red="{Binding R, Mode=TwoWay}"
                                                                        Green="{Binding G, Mode=TwoWay}"
                                                                        Blue="{Binding B, Mode=TwoWay}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Content="{Binding Pad_Lighting_AddColor, Source={x:Static strings:Strings.Instance}}"
                                                        Command="{Binding AddLightbarPaletteColorCommand}"
                                                        HorizontalAlignment="Left" Padding="8,2"/>
                                            </StackPanel>
                                            <!-- Hold slider — Reactive only. Held at full intensity for this many ms before the fade begins. -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                                        Visibility="{Binding IsLightbarReactiveHold, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Macro_LightbarHold_Label, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="80" Margin="0,0,8,0"/>
                                                <Slider Value="{Binding LightbarHoldMs, Mode=TwoWay}"
                                                        Minimum="0" Maximum="5000" Width="220"
                                                        VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding LightbarHoldMs, Mode=TwoWay}" Width="80" Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </StackPanel>
                                            <!-- Fade slider — Reactive only. Linear fade from full to off after the hold. -->
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding IsLightbarReactiveHold, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Macro_LightbarFade_Label, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="80" Margin="0,0,8,0"/>
                                                <Slider Value="{Binding LightbarFadeMs, Mode=TwoWay}"
                                                        Minimum="0" Maximum="5000" Width="220"
                                                        VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding LightbarFadeMs, Mode=TwoWay}" Width="80" Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Lightbar Color Clear card -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6"
                                            Visibility="{Binding IsLightbarColorClearType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MacroAction_Type_LightbarColorClear, Source={x:Static strings:Strings.Instance}}"
                                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding MacroAction_LightbarColorClear_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Lightbar Mode Set card -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6"
                                            Visibility="{Binding IsLightbarModeSetType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MacroAction_Type_LightbarModeSet, Source={x:Static strings:Strings.Instance}}"
                                                       FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Macro_LightbarTargetMode_Label, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="80" Margin="0,0,8,0"/>
                                                <ComboBox SelectedValue="{Binding LightbarTargetMode, Mode=TwoWay}"
                                                          SelectedValuePath="Tag" MinWidth="280">
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_Off, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.Off}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_Static, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.Static}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_Breathing, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.Breathing}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_Rainbow, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.Rainbow}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_ColorCycle, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.ColorCycle}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_AudioPulse, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.AudioPulse}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_AudioPulseRandom, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.AudioPulseRandom}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_AudioPulseRainbow, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.AudioPulseRainbow}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_AudioThresholds, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.AudioThresholds}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_AudioGradient, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.AudioGradient}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_AudioCrossFade, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.AudioCrossFade}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_InputReactive, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.InputReactive}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_InputReactiveCycle, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.InputReactiveCycle}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Lighting_Mode_InputReactiveFixed, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.InputReactiveFixed}"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Lightbar Mode Cycle card — checkbox grid bound through LightbarCycleModesCsv via the action's CycleModeOptions list. -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6"
                                            Visibility="{Binding IsLightbarModeCycleType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MacroAction_Type_LightbarModeCycle, Source={x:Static strings:Strings.Instance}}"
                                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Macro_LightbarCycleModes_Hint, Source={x:Static strings:Strings.Instance}}"
                                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <ItemsControl ItemsSource="{Binding CycleModeOptions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Label}"
                                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                  MinWidth="160" Margin="0,0,8,4"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Rumble card (Reactive | Sticky) -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6"
                                            Visibility="{Binding IsRumbleType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MacroAction_Type_Rumble, Source={x:Static strings:Strings.Instance}}"
                                                       FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Macro_RumbleHold_Label, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="100" Margin="0,0,8,0"/>
                                                <ComboBox SelectedValue="{Binding RumbleHoldMode, Mode=TwoWay}"
                                                          SelectedValuePath="Tag" MinWidth="140">
                                                    <ComboBoxItem Content="{Binding Macro_RumbleHold_Reactive, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroRumbleHoldMode.Reactive}"/>
                                                    <ComboBoxItem Content="{Binding Macro_RumbleHold_Sticky, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroRumbleHoldMode.Sticky}"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <!-- Left motor strength -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Macro_RumbleStrengthLeft_Label, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="100" Margin="0,0,8,0"/>
                                                <Slider Value="{Binding RumbleStrengthLeft, Mode=TwoWay}"
                                                        Minimum="0" Maximum="100" Width="220"
                                                        VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding RumbleStrengthLeft, Mode=TwoWay}" Width="60" Margin="8,0,0,0"/>
                                                <TextBlock Text="%" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                            </StackPanel>
                                            <!-- Right motor strength -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Macro_RumbleStrengthRight_Label, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="100" Margin="0,0,8,0"/>
                                                <Slider Value="{Binding RumbleStrengthRight, Mode=TwoWay}"
                                                        Minimum="0" Maximum="100" Width="220"
                                                        VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding RumbleStrengthRight, Mode=TwoWay}" Width="60" Margin="8,0,0,0"/>
                                                <TextBlock Text="%" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                            </StackPanel>
                                            <!-- Hold ms — Reactive only -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                                        Visibility="{Binding IsRumbleReactiveHold, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Macro_RumbleHoldMs_Label, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="100" Margin="0,0,8,0"/>
                                                <Slider Value="{Binding RumbleHoldMs, Mode=TwoWay}"
                                                        Minimum="0" Maximum="5000" Width="220"
                                                        VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding RumbleHoldMs, Mode=TwoWay}" Width="80" Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </StackPanel>
                                            <!-- Fade ms — Reactive only -->
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding IsRumbleReactiveHold, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Macro_RumbleFadeMs_Label, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Width="100" Margin="0,0,8,0"/>
                                                <Slider Value="{Binding RumbleFadeMs, Mode=TwoWay}"
                                                        Minimum="0" Maximum="5000" Width="220"
                                                        VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding RumbleFadeMs, Mode=TwoWay}" Width="80" Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding Common_Ms, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Rumble Stop card -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6"
                                            Visibility="{Binding IsRumbleStopType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MacroAction_Type_RumbleStop, Source={x:Static strings:Strings.Instance}}"
                                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding MacroAction_RumbleStop_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Axis target + value — for AxisSet -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                                Visibility="{Binding IsAxisType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Macro_Axis, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                   Width="80" Margin="0,0,8,0"/>
                                        <ComboBox SelectedValue="{Binding AxisTarget, Mode=TwoWay}"
                                                  SelectedValuePath="Tag" MinWidth="120">
                                            <ComboBoxItem Content="{Binding Common_None, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.None}"/>
                                            <ComboBoxItem Content="{Binding Macro_LeftStickX, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftStickX}"/>
                                            <ComboBoxItem Content="{Binding Macro_LeftStickY, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftStickY}"/>
                                            <ComboBoxItem Content="{Binding Macro_RightStickX, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightStickX}"/>
                                            <ComboBoxItem Content="{Binding Macro_RightStickY, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightStickY}"/>
                                            <ComboBoxItem Content="{Binding Macro_LeftTrigger, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftTrigger}"/>
                                            <ComboBoxItem Content="{Binding Macro_RightTrigger, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightTrigger}"/>
                                        </ComboBox>
                                        <TextBlock Text="{Binding Macro_AxisValue, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                   Margin="12,0,8,0"/>
                                        <TextBox Text="{Binding AxisValue, Mode=TwoWay}" Width="80"/>
                                    </StackPanel>

                                    <!-- Source axis — for SystemVolume -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsSystemVolumeType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <!-- Axis source selector -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Macro_AxisFrom, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"/>
                                            <ComboBox SelectedValue="{Binding AxisSource, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" MinWidth="150">
                                                <ComboBoxItem Content="{Binding Macro_OutputController, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisSource.OutputController}"/>
                                                <ComboBoxItem Content="{Binding Macro_InputDevice, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisSource.InputDevice}"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <!-- Output controller axis (existing) -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                                    Visibility="{Binding IsOutputAxisSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding Macro_SourceAxis, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"/>
                                            <ComboBox SelectedValue="{Binding AxisTarget, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" MinWidth="150">
                                                <ComboBoxItem Content="{Binding Macro_LeftStickX, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftStickX}"/>
                                                <ComboBoxItem Content="{Binding Macro_LeftStickY, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftStickY}"/>
                                                <ComboBoxItem Content="{Binding Macro_RightStickX, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightStickX}"/>
                                                <ComboBoxItem Content="{Binding Macro_RightStickY, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightStickY}"/>
                                                <ComboBoxItem Content="{Binding Macro_LeftTrigger, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftTrigger}"/>
                                                <ComboBoxItem Content="{Binding Macro_RightTrigger, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightTrigger}"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <!-- Input device axis -->
                                        <StackPanel Visibility="{Binding IsDeviceAxisSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Macro_Device, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                           Width="80" Margin="0,0,8,0"/>
                                                <ComboBox x:Name="SysVolDevicePicker"
                                                          MinWidth="200"
                                                          DisplayMemberPath="ResolvedName"
                                                          SelectedValuePath="InstanceGuid"
                                                          SelectedValue="{Binding SourceDeviceGuid, Mode=TwoWay}"
                                                          DropDownOpened="DeviceAxisPicker_DropDownOpened"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Macro_Axis, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                           Width="80" Margin="0,0,8,0"/>
                                                <ComboBox MinWidth="180"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectedValuePath="InputIndex"
                                                          SelectedValue="{Binding SourceDeviceAxisIndex, Mode=TwoWay}"
                                                          DropDownOpened="DeviceAxisIndexPicker_DropDownOpened"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Macro_VolumeLimit, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"/>
                                            <Slider Value="{Binding VolumeLimit, Mode=TwoWay}"
                                                    Minimum="1" Maximum="100" Width="150"
                                                    VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding VolumeLimit, Mode=OneWay}"/>
                                                <TextBlock Text="%"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <CheckBox Content="{Binding Macro_InvertAxis, Source={x:Static strings:Strings.Instance}}"
                                                 IsChecked="{Binding InvertAxis, Mode=TwoWay}" Margin="0,0,0,4"/>
                                        <CheckBox Content="{Binding Macro_ShowVolumeOsd, Source={x:Static strings:Strings.Instance}}"
                                                 IsChecked="{Binding ShowVolumeOsd, Mode=TwoWay}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Macro_SysVolumeHint, Source={x:Static strings:Strings.Instance}}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Source axis + process name — for AppVolume -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsAppVolumeType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Macro_Process, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"/>
                                            <ComboBox IsEditable="True"
                                                      Text="{Binding ProcessName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding AudioProcessNames}"
                                                      MinWidth="180" MaxDropDownHeight="200"
                                                      IsTextSearchEnabled="True"
                                                      ToolTip="{Binding Macro_ProcessTooltip, Source={x:Static strings:Strings.Instance}}"
                                                      DropDownOpened="AppVolumeProcessDropDown_Opened"/>
                                        </StackPanel>
                                        <!-- Axis source selector -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Macro_AxisFrom, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"/>
                                            <ComboBox SelectedValue="{Binding AxisSource, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" MinWidth="150">
                                                <ComboBoxItem Content="{Binding Macro_OutputController, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisSource.OutputController}"/>
                                                <ComboBoxItem Content="{Binding Macro_InputDevice, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisSource.InputDevice}"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <!-- Output controller axis -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                                    Visibility="{Binding IsOutputAxisSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding Macro_SourceAxis, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"/>
                                            <ComboBox SelectedValue="{Binding AxisTarget, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" MinWidth="150">
                                                <ComboBoxItem Content="{Binding Macro_LeftStickX, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftStickX}"/>
                                                <ComboBoxItem Content="{Binding Macro_LeftStickY, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftStickY}"/>
                                                <ComboBoxItem Content="{Binding Macro_RightStickX, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightStickX}"/>
                                                <ComboBoxItem Content="{Binding Macro_RightStickY, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightStickY}"/>
                                                <ComboBoxItem Content="{Binding Macro_LeftTrigger, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftTrigger}"/>
                                                <ComboBoxItem Content="{Binding Macro_RightTrigger, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightTrigger}"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <!-- Input device axis -->
                                        <StackPanel Visibility="{Binding IsDeviceAxisSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Macro_Device, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                           Width="80" Margin="0,0,8,0"/>
                                                <ComboBox x:Name="AppVolDevicePicker"
                                                          MinWidth="200"
                                                          DisplayMemberPath="ResolvedName"
                                                          SelectedValuePath="InstanceGuid"
                                                          SelectedValue="{Binding SourceDeviceGuid, Mode=TwoWay}"
                                                          DropDownOpened="DeviceAxisPicker_DropDownOpened"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Macro_Axis, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                           Width="80" Margin="0,0,8,0"/>
                                                <ComboBox MinWidth="180"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectedValuePath="InputIndex"
                                                          SelectedValue="{Binding SourceDeviceAxisIndex, Mode=TwoWay}"
                                                          DropDownOpened="DeviceAxisIndexPicker_DropDownOpened"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Macro_VolumeLimit, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"/>
                                            <Slider Value="{Binding VolumeLimit, Mode=TwoWay}"
                                                    Minimum="1" Maximum="100" Width="150"
                                                    VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding VolumeLimit, Mode=OneWay}"/>
                                                <TextBlock Text="%"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <CheckBox Content="{Binding Macro_InvertAxis, Source={x:Static strings:Strings.Instance}}"
                                                 IsChecked="{Binding InvertAxis, Mode=TwoWay}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Macro_AppVolumeHint, Source={x:Static strings:Strings.Instance}}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Source axis + sensitivity — for MouseMove / MouseScroll -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsMouseMoveType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <!-- Axis source selector -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Macro_AxisFrom, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"/>
                                            <ComboBox SelectedValue="{Binding AxisSource, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" MinWidth="150">
                                                <ComboBoxItem Content="{Binding Macro_OutputController, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisSource.OutputController}"/>
                                                <ComboBoxItem Content="{Binding Macro_InputDevice, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisSource.InputDevice}"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <!-- Output controller axis -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                                    Visibility="{Binding IsOutputAxisSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding Macro_SourceAxis, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"/>
                                            <ComboBox SelectedValue="{Binding AxisTarget, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" MinWidth="150">
                                                <ComboBoxItem Content="{Binding Macro_LeftStickX, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftStickX}"/>
                                                <ComboBoxItem Content="{Binding Macro_LeftStickY, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftStickY}"/>
                                                <ComboBoxItem Content="{Binding Macro_RightStickX, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightStickX}"/>
                                                <ComboBoxItem Content="{Binding Macro_RightStickY, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightStickY}"/>
                                                <ComboBoxItem Content="{Binding Macro_LeftTrigger, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.LeftTrigger}"/>
                                                <ComboBoxItem Content="{Binding Macro_RightTrigger, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroAxisTarget.RightTrigger}"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <!-- Input device axis -->
                                        <StackPanel Visibility="{Binding IsDeviceAxisSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Macro_Device, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                           Width="80" Margin="0,0,8,0"/>
                                                <ComboBox x:Name="MouseDevicePicker"
                                                          MinWidth="200"
                                                          DisplayMemberPath="ResolvedName"
                                                          SelectedValuePath="InstanceGuid"
                                                          SelectedValue="{Binding SourceDeviceGuid, Mode=TwoWay}"
                                                          DropDownOpened="DeviceAxisPicker_DropDownOpened"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Macro_Axis, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                           Width="80" Margin="0,0,8,0"/>
                                                <ComboBox MinWidth="180"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectedValuePath="InputIndex"
                                                          SelectedValue="{Binding SourceDeviceAxisIndex, Mode=TwoWay}"
                                                          DropDownOpened="DeviceAxisIndexPicker_DropDownOpened"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Macro_Sensitivity, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"/>
                                            <Slider Value="{Binding MouseSensitivity, Mode=TwoWay}"
                                                    Minimum="1" Maximum="100" Width="180"
                                                    TickPlacement="None" IsSnapToTickEnabled="False"
                                                    VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding MouseSensitivity, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                     Width="50" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <CheckBox Content="{Binding Macro_InvertAxis, Source={x:Static strings:Strings.Instance}}"
                                                 IsChecked="{Binding InvertAxis, Mode=TwoWay}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Macro_MouseMoveHint, Source={x:Static strings:Strings.Instance}}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Mouse button — for MouseButtonPress / MouseButtonRelease -->
                                    <StackPanel Margin="0,0,0,6"
                                                Visibility="{Binding IsMouseButtonType, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Macro_Buttons, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                                       Width="80" Margin="0,0,8,0"/>
                                            <ComboBox SelectedValue="{Binding MouseButton, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" MinWidth="120">
                                                <ComboBoxItem Content="{Binding Macro_MouseLeft, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroMouseButton.Left}"/>
                                                <ComboBoxItem Content="{Binding Macro_MouseRight, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroMouseButton.Right}"/>
                                                <ComboBoxItem Content="{Binding Macro_MouseMiddle, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroMouseButton.Middle}"/>
                                                <ComboBoxItem Content="{Binding Macro_MouseX1, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroMouseButton.X1}"/>
                                                <ComboBoxItem Content="{Binding Macro_MouseX2, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroMouseButton.X2}"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Repeat settings -->
                            <TextBlock Text="{Binding Macro_Repeat, Source={x:Static strings:Strings.Instance}}" FontWeight="SemiBold" Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding Macro_RepeatMode, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <ComboBox SelectedValue="{Binding RepeatMode, Mode=TwoWay}"
                                          SelectedValuePath="Tag" MinWidth="120">
                                    <ComboBoxItem Content="{Binding Macro_Once, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroRepeatMode.Once}"/>
                                    <ComboBoxItem Content="{Binding Macro_FixedCount, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroRepeatMode.FixedCount}"/>
                                    <ComboBoxItem Content="{Binding Macro_UntilRelease, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:MacroRepeatMode.UntilRelease}"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding Macro_Count, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                           Margin="0,0,8,0" Width="90"/>
                                <TextBox Text="{Binding RepeatCount, Mode=TwoWay}"
                                         Width="60"/>
                                <TextBlock Text="{Binding Macro_DelayMs, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"
                                           Margin="12,0,8,0"/>
                                <TextBox Text="{Binding RepeatDelayMs, Mode=TwoWay}"
                                         Width="60"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ─── TAB 2: Mappings (device-specific) ─── -->
            <TabItem>
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="{Binding Pad_ClearAll, Source={x:Static strings:Strings.Instance}}" Command="{Binding ClearMappingsCommand}"
                                Padding="8,4" Margin="0,0,8,0"
                                ToolTip="{Binding Pad_ClearMappings, Source={x:Static strings:Strings.Instance}}"/>
                        <Button Content="{Binding Common_Copy, Source={x:Static strings:Strings.Instance}}" Command="{Binding CopySettingsCommand}"
                                Padding="8,4" Margin="0,0,4,0"
                                ToolTip="{Binding Pad_CopyTooltip, Source={x:Static strings:Strings.Instance}}"/>
                        <Button Content="{Binding Common_Paste, Source={x:Static strings:Strings.Instance}}" Command="{Binding PasteSettingsCommand}"
                                Padding="8,4" Margin="0,0,4,0"
                                ToolTip="{Binding Pad_PasteTooltip, Source={x:Static strings:Strings.Instance}}"/>
                        <Button Content="{Binding Pad_CopyFrom, Source={x:Static strings:Strings.Instance}}" Command="{Binding CopyFromCommand}"
                                Padding="8,4" Margin="0,0,8,0"
                                ToolTip="{Binding Pad_CopyFromTooltip, Source={x:Static strings:Strings.Instance}}"/>
                        <Button Content="{Binding MapAllButtonText}"
                                Padding="8,4" Margin="0,0,8,0"
                                ToolTip="{Binding MapAllButtonTooltip}"
                                Click="MapAllToggle_Click"/>
                        <Button x:Name="AddShiftLayerButton"
                                Content="{Binding Pad_Shift_AddLayer, Source={x:Static strings:Strings.Instance}}"
                                Padding="8,4" Margin="0,0,8,0"
                                ToolTip="{Binding Pad_Shift_AddLayer_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                Click="AddShiftLayer_Click"/>
                        <TextBlock Text="{Binding Pad_MappingHint, Source={x:Static strings:Strings.Instance}}"
                                   VerticalAlignment="Center" FontStyle="Italic"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Nested layer-tab strip. Hidden when only Base exists
                         (basic users without any shift layers see the
                         Mappings tab exactly as before). One RadioButton per
                         entry in PadViewModel.LayerTabs; right-click opens
                         the per-tab context menu. -->
                    <!-- Inline rename popup, anchored at runtime to the
                         clicked shift-layer tab. Single-field input + Save
                         + Cancel — much lighter than reopening the full
                         Configure dialog when the user just wants to fix
                         the name. -->
                    <Popup x:Name="RenameLayerPopup"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           StaysOpen="False">
                        <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                                  Direction="270" Opacity="0.30" Color="Black"/>
                            </Border.Effect>
                            <StackPanel Orientation="Vertical" MinWidth="240">
                                <TextBlock Text="{Binding Pad_Shift_LayerName, Source={x:Static strings:Strings.Instance}}"
                                           Margin="0,0,0,4"/>
                                <TextBox x:Name="RenameLayerBox"
                                         Margin="0,0,0,8"
                                         KeyDown="RenameLayerBox_KeyDown"/>
                                <TextBlock x:Name="RenameLayerHint"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,6"
                                           Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="{Binding Common_Save, Source={x:Static strings:Strings.Instance}}"
                                            MinWidth="72" Margin="0,0,6,0"
                                            IsDefault="True"
                                            Click="RenameLayerSave_Click"
                                            Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"/>
                                    <Button Content="{Binding Common_Cancel, Source={x:Static strings:Strings.Instance}}"
                                            MinWidth="72"
                                            IsCancel="True"
                                            Click="RenameLayerCancel_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <ItemsControl Grid.Row="1" x:Name="ShiftLayerTabStrip"
                                  ItemsSource="{Binding LayerTabs}"
                                  Margin="0,0,0,8"
                                  Visibility="{Binding HasShiftLayers, Converter={StaticResource BoolToVisibilityConverter}}">
                        <!-- WrapPanel so layers with many activators flow
                             to a second row when the window narrows
                             instead of clipping off the right edge. -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="ShiftLayerTabs"
                                             IsChecked="{Binding IsActive, Mode=TwoWay}"
                                             Margin="0,0,4,4"
                                             Padding="10,4"
                                             Click="ShiftLayerTab_Click"
                                             Tag="{Binding LayerMask}">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Per-layer color dot. Hidden on the Base
                                             tab; visible (gray default or authored
                                             color) for every shift layer. -->
                                        <Ellipse Width="8" Height="8"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding Color, Converter={StaticResource HexToBrushConverter}}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBase}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding LayerName}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <!-- Per-tab context menu. Configure /
                                         Rename / Delete are disabled for
                                         the Base tab (no activator to act
                                         on); Copy / Paste / Clear still
                                         work against Base rows. -->
                                    <RadioButton.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{Binding Pad_Shift_Configure, Source={x:Static strings:Strings.Instance}}"
                                                      Click="ShiftLayer_Configure_Click"
                                                      Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="{Binding Pad_Shift_Rename, Source={x:Static strings:Strings.Instance}}"
                                                      Click="ShiftLayer_Rename_Click"
                                                      Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <Separator/>
                                            <MenuItem Header="{Binding Pad_Shift_Copy, Source={x:Static strings:Strings.Instance}}"
                                                      Click="ShiftLayer_Copy_Click"
                                                      Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="{Binding Pad_Shift_Paste, Source={x:Static strings:Strings.Instance}}"
                                                      Click="ShiftLayer_Paste_Click"
                                                      Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="{Binding Pad_Shift_Clear, Source={x:Static strings:Strings.Instance}}"
                                                      Click="ShiftLayer_Clear_Click"
                                                      Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <Separator/>
                                            <MenuItem Header="{Binding Pad_Shift_Delete, Source={x:Static strings:Strings.Instance}}"
                                                      Click="ShiftLayer_Delete_Click"
                                                      Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        </ContextMenu>
                                    </RadioButton.ContextMenu>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Mapping DataGrid. HorizontalAlignment=Left so the DataGrid
                         doesn't stretch wider than its columns sum to — without
                         this, any Auto / SizeToCells column absorbs the leftover
                         horizontal slack and bloats. With HorizontalAlignment=Left,
                         each column genuinely auto-collapses to its own content
                         and any empty space sits to the right of the grid. -->
                    <DataGrid Grid.Row="2"
                              x:Name="MappingDataGrid"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding Mappings}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              IsReadOnly="True"
                              VerticalScrollBarVisibility="Visible"
                              LoadingRow="MappingDataGrid_LoadingRow"
                              UnloadingRow="MappingDataGrid_UnloadingRow"
                              SelectionChanged="MappingDataGrid_SelectionChanged"
                              Loaded="MappingDataGrid_Loaded">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <!-- HorizontalContentAlignment used to be Stretch here.
                                     That made every cell hand its child the full column
                                     width during arrange, which (combined with the
                                     CellsPanel's measure pass) inflated the Auto Options
                                     column to absorb the leftover horizontal slack of
                                     the row. Switched to Left so cells size and align
                                     to their content's actual DesiredSize. Columns
                                     that need horizontal fill (the Source ComboBox)
                                     set Stretch on their own template root. -->
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="Transparent"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="RecordFlash">
                                                <Storyboard>
                                                    <ColorAnimation
                                                        Storyboard.TargetProperty="(DataGridRow.Background).(SolidColorBrush.Color)"
                                                        From="#002196F3" To="#602196F3"
                                                        Duration="0:0:0.4" AutoReverse="True"
                                                        RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="RecordFlash"/>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.RowDetailsVisibilityMode>VisibleWhenSelected</DataGrid.RowDetailsVisibilityMode>
                        <DataGrid.RowDetailsTemplate>
                            <!-- Issue #61 multi-source: per-row details
                                 visible when the row is selected. Shows
                                 the row's combine mode, the list of
                                 ExtraSources (sources beyond the primary
                                 single-source), and a + Add source link
                                 to append a new source. -->
                            <DataTemplate>
                                <Border Padding="20,4,8,8"
                                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                        BorderThickness="0,1,0,0">
                                    <StackPanel Orientation="Vertical">
                                        <!-- Combine row — visible only on multi-source rows.
                                             Bound to AvailableCombineModes which pairs the
                                             engine's name (MaxAbs / OR / XOR…) with a layman
                                             label + one-line description so non-STEM users
                                             aren't staring at acronyms. EnsureCombineModeDefault
                                             auto-picks MaxAbs/OR per target class on first
                                             multi-source transition. -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                                    Visibility="{Binding IsMultiSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding Pad_Combine_Label, Source={x:Static strings:Strings.Instance}}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Margin="0,0,6,0"/>
                                            <ComboBox ItemsSource="{Binding AvailableCombineModes}"
                                                      SelectedValue="{Binding CombineMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Value"
                                                      DisplayMemberPath="Name"
                                                      MinWidth="200" Margin="0" Padding="4,2"
                                                      VerticalAlignment="Center"
                                                      ToolTip="{Binding Pad_Combine_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                      PreviewKeyDown="MappingComboBox_PreviewKeyDown">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Vertical" Margin="0,2,0,2">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                            <TextBlock Text="{Binding Description}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>


                                        <!-- Custom formula editor — only visible when the row
                                             is multi-source AND Custom is the picked combine.
                                             Gating on ShouldShowCustomExpression instead of
                                             just IsCustomCombine means removing the last
                                             extra source also collapses the formula box,
                                             instead of leaving stale text on a single-source
                                             row. The italic placeholder shows an example
                                             until the user types something. -->
                                        <!-- Custom formula visual editor — chip palette
                                             below a free-text formula box. Users who don't
                                             want to type can build a formula by clicking
                                             chips (each chip's Tag is inserted at the
                                             caret) or load a complete preset by clicking
                                             one of the named buttons. The Click handlers
                                             live in PadPage.xaml.cs and use VisualTreeHelper
                                             to find the named TextBox inside the same
                                             FormulaEditor StackPanel — that avoids the
                                             ComboBox-SelectedItem write-back hell that
                                             made the previous Quick fill dropdown unable
                                             to populate the formula on selection. -->
                                        <StackPanel x:Name="FormulaEditor" Orientation="Vertical" Margin="0,0,0,4"
                                                    Visibility="{Binding ShouldShowCustomExpression, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBox x:Name="CustomFormulaBox"
                                                     Text="{Binding CombineExpression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     MinWidth="380" Padding="6,4"
                                                     VerticalAlignment="Center"
                                                     FontFamily="Consolas"
                                                     AllowDrop="True"
                                                     ToolTip="{Binding Pad_Formula_TextBox_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            <TextBlock Text="{Binding CombineExpressionStatus}"
                                                       FontSize="10" FontFamily="Consolas"
                                                       Margin="2,2,0,4"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#16C60C"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCombineExpressionWarning}" Value="True">
                                                                <Setter Property="Foreground" Value="#F2A33C"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCombineExpressionInvalid}" Value="True">
                                                                <Setter Property="Foreground" Value="#C42B1C"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Chip palette: variables, operators, numbers,
                                                 functions. Tag carries the literal text to
                                                 insert at the formula's caret. -->
                                            <TextBlock Text="{Binding Pad_Formula_Insert, Source={x:Static strings:Strings.Instance}}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Margin="2,4,0,2"/>
                                            <WrapPanel Margin="0,0,0,4">
                                                <WrapPanel.Resources>
                                                    <Style x:Key="FormulaChipStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Padding" Value="6,2"/>
                                                        <Setter Property="Margin" Value="0,0,3,3"/>
                                                        <Setter Property="MinWidth" Value="28"/>
                                                        <Setter Property="FontFamily" Value="Consolas"/>
                                                        <Setter Property="FontSize" Value="11"/>
                                                        <!-- Drag-out support: PreviewMouseLeftButtonDown
                                                             records the start point, MouseMove past the
                                                             drag threshold starts the DragDrop with the
                                                             chip's Tag (the literal text to insert)
                                                             as the data payload. The formula TextBox
                                                             has AllowDrop=True; WPF's built-in text
                                                             drop behavior inserts at the drop point. -->
                                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="FormulaChip_PreviewMouseLeftButtonDown"/>
                                                        <EventSetter Event="PreviewMouseMove" Handler="FormulaChip_PreviewMouseMove"/>
                                                    </Style>
                                                </WrapPanel.Resources>
                                                <!-- Source variables (a-d cover most rows; users with
                                                     more sources can type the rest). Tooltips bind to
                                                     the row's per-position friendly alias so users
                                                     see what `a/b/c/d` mean for THIS row. -->
                                                <!-- Variable chips: a..z. Each chip's Visibility tracks the
                                                     row's VariableCount (1 primary + ExtraSources) so the user
                                                     only sees letters that bind to a real source. -->
                                                <Button Content="a" Tag="a" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding VariableATooltip}" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=0}"/>
                                                <Button Content="b" Tag="b" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding VariableBTooltip}" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=1}"/>
                                                <Button Content="c" Tag="c" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding VariableCTooltip}" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=2}"/>
                                                <Button Content="d" Tag="d" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" ToolTip="{Binding VariableDTooltip}" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=3}"/>
                                                <Button Content="e" Tag="e" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=4}"/>
                                                <Button Content="f" Tag="f" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=5}"/>
                                                <Button Content="g" Tag="g" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=6}"/>
                                                <Button Content="h" Tag="h" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=7}"/>
                                                <Button Content="i" Tag="i" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=8}"/>
                                                <Button Content="j" Tag="j" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=9}"/>
                                                <Button Content="k" Tag="k" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=10}"/>
                                                <Button Content="l" Tag="l" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=11}"/>
                                                <Button Content="m" Tag="m" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=12}"/>
                                                <Button Content="n" Tag="n" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=13}"/>
                                                <Button Content="o" Tag="o" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=14}"/>
                                                <Button Content="p" Tag="p" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=15}"/>
                                                <Button Content="q" Tag="q" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=16}"/>
                                                <Button Content="r" Tag="r" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=17}"/>
                                                <Button Content="s" Tag="s" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=18}"/>
                                                <Button Content="t" Tag="t" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=19}"/>
                                                <Button Content="u" Tag="u" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=20}"/>
                                                <Button Content="v" Tag="v" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=21}"/>
                                                <Button Content="w" Tag="w" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=22}"/>
                                                <Button Content="x" Tag="x" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=23}"/>
                                                <Button Content="y" Tag="y" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=24}"/>
                                                <Button Content="z" Tag="z" Style="{StaticResource FormulaChipStyle}" Click="FormulaChip_Click" Visibility="{Binding VariableCount, Converter={StaticResource IndexLessThanVisibilityConverter}, ConverterParameter=25}"/>
                                                <!-- Touchpad-only "is touching" flags. Visible on
                                                     TouchpadX*/Y* rows; resolve to 1.0 while the
                                                     paired finger is touching, 0.0 when lifted. Used
                                                     to write gated formulas like
                                                     `aD ? a : (bD ? b : 0.5)` so a stale finger
                                                     position can't pollute the combine. The flag
                                                     channel is only supplied by the touchpad-
                                                     passthrough evaluator — referencing aD on a
                                                     non-touchpad row resolves to 0. -->
                                                <Button Content="aD" Tag="aD" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click"
                                                        ToolTip="{Binding Pad_Formula_Chip_TouchpadFlag_A, Source={x:Static strings:Strings.Instance}}"
                                                        Visibility="{Binding IsTouchpadAxisTarget, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <Button Content="bD" Tag="bD" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click"
                                                        ToolTip="{Binding Pad_Formula_Chip_TouchpadFlag_B, Source={x:Static strings:Strings.Instance}}"
                                                        Visibility="{Binding IsTouchpadAxisTarget, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <Button Content="cD" Tag="cD" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click"
                                                        ToolTip="{Binding Pad_Formula_Chip_TouchpadFlag_C, Source={x:Static strings:Strings.Instance}}"
                                                        Visibility="{Binding IsTouchpadAxisTarget, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <Button Content="dD" Tag="dD" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click"
                                                        ToolTip="{Binding Pad_Formula_Chip_TouchpadFlag_D, Source={x:Static strings:Strings.Instance}}"
                                                        Visibility="{Binding IsTouchpadAxisTarget, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <!-- Operators -->
                                                <Border Width="6"/>
                                                <Button Content="+" Tag=" + " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Add, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="−" Tag=" - " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Subtract, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="×" Tag=" * " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Multiply, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="÷" Tag=" / " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Divide, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="−A" Tag="-a" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_NegateA, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="(" Tag="(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_OpenGroup, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content=")" Tag=")" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_CloseGroup, Source={x:Static strings:Strings.Instance}}"/>
                                                <!-- Numbers -->
                                                <Border Width="6"/>
                                                <Button Content="0" Tag="0" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click"/>
                                                <Button Content="½" Tag="0.5" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Half, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="1" Tag="1" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click"/>
                                                <Button Content="2" Tag="2" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click"/>
                                                <!-- Comparisons (yield 0 / 1 for use in if-then-else or scaled by *) -->
                                                <Border Width="6"/>
                                                <Button Content="&lt;" Tag=" &lt; " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_LessThan, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="&gt;" Tag=" &gt; " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_GreaterThan, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="≤" Tag=" &lt;= " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_LessOrEqual, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="≥" Tag=" &gt;= " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_GreaterOrEqual, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="=" Tag=" == " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Equal, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="≠" Tag=" != " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_NotEqual, Source={x:Static strings:Strings.Instance}}"/>
                                                <!-- Logic + if-then-else -->
                                                <Border Width="6"/>
                                                <Button Content="and" Tag=" &amp;&amp; " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_BothConditions, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="or" Tag=" || " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_EitherCondition, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="not" Tag="!" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_FlipBool, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="if?" Tag=" ? " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_If, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="else:" Tag=" : " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Else, Source={x:Static strings:Strings.Instance}}"/>
                                                <!-- Functions -->
                                                <Border Width="6"/>
                                                <Button Content="abs" Tag="abs(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Abs, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="min" Tag="min(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Min, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="max" Tag="max(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Max, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="clamp" Tag="clamp(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Clamp, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="sign" Tag="sign(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Sign, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="lerp" Tag="lerp(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Lerp, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="round" Tag="round(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Round, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="sqrt" Tag="sqrt(" Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click" ToolTip="{Binding Pad_Formula_Chip_Sqrt, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="," Tag=", " Style="{StaticResource FormulaChipStyle}"
                                                        Click="FormulaChip_Click"/>
                                            </WrapPanel>

                                            <!-- Preset buttons: load a complete formula
                                                 (replaces what's in the box). Each button's
                                                 Tag is the formula text. -->
                                            <TextBlock Text="{Binding Pad_Formula_StarterRecipes, Source={x:Static strings:Strings.Instance}}" FontSize="10"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Margin="2,2,0,2"/>
                                            <WrapPanel>
                                                <WrapPanel.Resources>
                                                    <Style x:Key="FormulaPresetStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Padding" Value="8,3"/>
                                                        <Setter Property="Margin" Value="0,0,4,3"/>
                                                        <Setter Property="FontSize" Value="11"/>
                                                    </Style>
                                                </WrapPanel.Resources>
                                                <Button Content="{Binding Pad_Formula_Preset_HalfScale_Name, Source={x:Static strings:Strings.Instance}}" Tag="a * 0.5"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Pad_Formula_Preset_HalfScale_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Pad_Formula_Preset_QuarterScale_Name, Source={x:Static strings:Strings.Instance}}" Tag="a * 0.25"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Pad_Formula_Preset_QuarterScale_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Pad_Formula_Preset_ReverseA_Name, Source={x:Static strings:Strings.Instance}}" Tag="-a"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Pad_Formula_Preset_ReverseA_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Pad_Formula_Preset_CapTo1_Name, Source={x:Static strings:Strings.Instance}}" Tag="clamp(a + b, -1, 1)"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Pad_Formula_Preset_CapTo1_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Pad_Formula_Preset_WeightedBlend_Name, Source={x:Static strings:Strings.Instance}}" Tag="a * 0.7 + b * 0.3"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Pad_Formula_Preset_WeightedBlend_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Pad_Formula_Preset_Difference_Name, Source={x:Static strings:Strings.Instance}}" Tag="a - b"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Pad_Formula_Preset_Difference_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Pad_Formula_Preset_AUnlessIdle_Name, Source={x:Static strings:Strings.Instance}}" Tag="a != 0 ? a : b"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Pad_Formula_Preset_AUnlessIdle_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Pad_Formula_Preset_ThresholdGate_Name, Source={x:Static strings:Strings.Instance}}" Tag="(a &gt; 0.5) ? 1 : 0"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Pad_Formula_Preset_ThresholdGate_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Pad_Formula_Preset_BothPressed_Name, Source={x:Static strings:Strings.Instance}}" Tag="(a &gt; 0) &amp;&amp; (b &gt; 0) ? 1 : 0"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Pad_Formula_Preset_BothPressed_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Pad_Formula_Preset_StrongerWins_Name, Source={x:Static strings:Strings.Instance}}" Tag="max(abs(a), abs(b)) * sign(a + b)"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Pad_Formula_Preset_StrongerWins_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <!-- Shared recipes from the macro custom-expression editor. Same
                                                     Macro_Expression_Recipe_* keys, already translated across all
                                                     10 locales. -->
                                                <Button Content="{Binding Macro_Expression_Recipe_Single, Source={x:Static strings:Strings.Instance}}" Tag="a"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Macro_Expression_Recipe_Single_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Macro_Expression_Recipe_Both, Source={x:Static strings:Strings.Instance}}" Tag="a &amp;&amp; b"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Macro_Expression_Recipe_Both_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Macro_Expression_Recipe_Either, Source={x:Static strings:Strings.Instance}}" Tag="a || b"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Macro_Expression_Recipe_Either_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Macro_Expression_Recipe_AButNotB, Source={x:Static strings:Strings.Instance}}" Tag="a &amp;&amp; !b"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Macro_Expression_Recipe_AButNotB_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <Button Content="{Binding Macro_Expression_Recipe_AxisOverHalf, Source={x:Static strings:Strings.Instance}}" Tag="abs(a - 0.5) &gt; 0.25"
                                                        Style="{StaticResource FormulaPresetStyle}"
                                                        Click="FormulaPreset_Click"
                                                        ToolTip="{Binding Macro_Expression_Recipe_AxisOverHalf_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- ExtraSources list. Each row has its own
                                             cascading Device/Input picker: the Device
                                             ComboBox lists every device assigned to the
                                             slot, and the Input ComboBox draws from the
                                             per-source AvailableInputs (which the parent
                                             MappingItem refreshes whenever the source's
                                             DeviceGuid changes). Empty Device =
                                             "use the slot's primary device" — the parent
                                             falls the per-source AvailableInputs back to
                                             its own list in that case. -->
                                        <ItemsControl ItemsSource="{Binding ExtraSources}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                                        <TextBlock Text="↳" FontSize="14"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <!-- Kind selector. Schema/engine value ("Direct" / "Incremental" /
                                                             "InvertOnHold") round-trips via SelectedValue; the dropdown
                                                             shows the friendly display name from KindChoice.Name so the
                                                             user reads "Invert On Hold" instead of the camel-case identifier. -->
                                                        <ComboBox ItemsSource="{x:Static vm:MappingSourceItem.KindOptions}"
                                                                  SelectedValue="{Binding Kind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  SelectedValuePath="Value"
                                                                  DisplayMemberPath="Name"
                                                                  Width="150" Padding="4,2" Margin="0,0,6,0"
                                                                  VerticalAlignment="Center"
                                                                  ToolTip="{Binding Pad_Mapping_Kind_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                                  PreviewKeyDown="MappingComboBox_PreviewKeyDown"/>
                                                        <!-- Direction badge: visible only when the parent target is
                                                             a bipolar stick axis AND this source is button-class.
                                                             Derived from per-source Invert flag. -->
                                                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                                CornerRadius="3" Padding="4,1" Margin="0,0,4,0"
                                                                VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding DataContext.IsBipolarAxisTarget,
                                                                                            RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True"/>
                                                                                <Condition Binding="{Binding IsButtonClassDescriptor}" Value="True"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding DirectionBadge}" FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        </Border>
                                                        <!-- Cross-device grouped picker. ItemsSource is the
                                                             parent MappingItem's full cross-device flat list;
                                                             GroupStyle headers identify which device each
                                                             input belongs to. Selecting an InputChoice writes
                                                             both the source's Descriptor and DeviceGuid in
                                                             one shot via the InputChoiceToSource attached
                                                             behavior. Hidden for Incremental — that kind reads
                                                             its inputs from the Up/Down pickers on the row
                                                             below, not from a single source descriptor. -->
                                                        <StackPanel Orientation="Vertical" Margin="0,0,4,0"
                                                                    Visibility="{Binding IsKindDescriptorless, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                                            <ComboBox ItemsSource="{Binding DataContext.AvailableInputsView,
                                                                        RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"
                                                                      SelectedItem="{Binding SelectedInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      DisplayMemberPath="DisplayName"
                                                                      MinWidth="240" Padding="4,2"
                                                                      ToolTip="{Binding Pad_Mapping_ExtraSourcePickerTooltip, Source={x:Static strings:Strings.Instance}}"
                                                                      PreviewKeyDown="MappingComboBox_PreviewKeyDown">
                                                                <ComboBox.GroupStyle>
                                                                    <GroupStyle>
                                                                        <GroupStyle.HeaderTemplate>
                                                                            <DataTemplate>
                                                                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                                                        Padding="6,3,6,3">
                                                                                    <TextBlock Text="{Binding Name}"
                                                                                               FontSize="11"
                                                                                               FontWeight="SemiBold"
                                                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                                               TextTrimming="CharacterEllipsis"/>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </GroupStyle.HeaderTemplate>
                                                                    </GroupStyle>
                                                                </ComboBox.GroupStyle>
                                                            </ComboBox>
                                                            <!-- Subtitle: assigned-device name when set,
                                                                 italic "Unassigned" when no descriptor. -->
                                                            <TextBlock FontSize="10"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       Margin="4,1,0,0"
                                                                       TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="{Binding DeviceLabel}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Descriptor}" Value="">
                                                                                <Setter Property="Text" Value="{Binding Common_Unassigned, Source={x:Static strings:Strings.Instance}}"/>
                                                                                <Setter Property="FontStyle" Value="Italic"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <!-- InvertOnHold inline picker. Fits in the same slot
                                                             as the (hidden-for-InvertOnHold) source picker so
                                                             the whole row stays on one line. While the picked
                                                             modifier is held, the row's combined output is
                                                             sign-flipped — that's the B.3 reversible-throttle
                                                             shape (engine treats Kind=InvertOnHold sources as
                                                             row-level modifiers, see InputManager.Step3.
                                                             MappingSetEval.IsInvertOnHoldActive). -->
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,4,0"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding IsInvertOnHoldKind, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="⇋" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                       ToolTip="{Binding Pad_Mapping_Modifier_IconTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                            <StackPanel Orientation="Vertical" Margin="0,0,4,0">
                                                                <ComboBox ItemsSource="{Binding DataContext.AvailableInputsView,
                                                                            RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"
                                                                          SelectedItem="{Binding ParamModifierInputChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          DisplayMemberPath="DisplayName"
                                                                          MinWidth="240" Padding="4,2"
                                                                          ToolTip="{Binding Pad_Mapping_Modifier_PickerTooltip, Source={x:Static strings:Strings.Instance}}"
                                                                          PreviewKeyDown="MappingComboBox_PreviewKeyDown">
                                                                    <ComboBox.GroupStyle>
                                                                        <GroupStyle>
                                                                            <GroupStyle.HeaderTemplate>
                                                                                <DataTemplate>
                                                                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,3,6,3">
                                                                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </GroupStyle.HeaderTemplate>
                                                                        </GroupStyle>
                                                                    </ComboBox.GroupStyle>
                                                                </ComboBox>
                                                                <TextBlock FontSize="10"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           Margin="4,1,0,0"
                                                                           TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="{Binding ParamModifierDeviceLabel}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ParamModifier}" Value="">
                                                                                    <Setter Property="Text" Value="{Binding Common_Unassigned, Source={x:Static strings:Strings.Instance}}"/>
                                                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <Button Command="{Binding RecordParamModifierCommand}"
                                                                    Width="40" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding RecordIconParamModifier}" FontFamily="Segoe MDL2 Assets"/>
                                                                <Button.ToolTip>
                                                                    <TextBlock Text="{Binding RecordTextParamModifier}"/>
                                                                </Button.ToolTip>
                                                            </Button>
                                                        </StackPanel>
                                                        <!-- Record / Clear / Options / DeadZone — for Direct sources only.
                                                             Incremental sources author their inputs through the dedicated
                                                             Up / Down pickers + Record buttons on the row below; the main
                                                             Descriptor / Invert / HalfAxis / DeadZone fields are unused for
                                                             that kind, so these controls would just be misleading noise. -->
                                                        <Button Command="{Binding ToggleRecordCommand}"
                                                                Width="40" HorizontalAlignment="Center" Margin="2"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding IsKindDescriptorless, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                                            <TextBlock Text="{Binding RecordButtonIcon}" FontFamily="Segoe MDL2 Assets"/>
                                                            <Button.ToolTip>
                                                                <TextBlock Text="{Binding RecordButtonText}"/>
                                                            </Button.ToolTip>
                                                        </Button>
                                                        <Button Command="{Binding ClearCommand}"
                                                                Width="40" HorizontalAlignment="Center" Margin="2"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding IsKindDescriptorless, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                                            <TextBlock Text="&#xE75C;" FontFamily="Segoe MDL2 Assets"/>
                                                            <Button.ToolTip>
                                                                <TextBlock Text="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}"/>
                                                            </Button.ToolTip>
                                                        </Button>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                                    Visibility="{Binding IsKindDescriptorless, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                                            <CheckBox Content="{Binding Pad_Invert, Source={x:Static strings:Strings.Instance}}"
                                                                      IsChecked="{Binding Invert, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <CheckBox Content="{Binding Pad_Half, Source={x:Static strings:Strings.Instance}}"
                                                                      IsChecked="{Binding HalfAxis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      IsEnabled="{Binding IsHalfAxisApplicable}"
                                                                      Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <CheckBox Content="{Binding Pad_Either, Source={x:Static strings:Strings.Instance}}"
                                                                      ToolTip="{Binding Pad_Either_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                                      IsChecked="{Binding Bidirectional, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      IsEnabled="{Binding HalfAxis}"
                                                                      Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0" Width="230"
                                                                    Visibility="{Binding IsKindDescriptorless, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDeadZoneApplicable}" Value="False">
                                                                            <Setter Property="IsEnabled" Value="False"/>
                                                                            <Setter Property="Opacity" Value="0.35"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <Slider Style="{StaticResource DzSlider}" Width="120"
                                                                    Value="{Binding DeadZone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    TickFrequency="1"/>
                                                            <TextBox Text="{Binding DeadZone, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                     Style="{StaticResource DzValueEdit}"/>
                                                            <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                            <Button Command="{Binding ResetDeadZoneCommand}" Style="{StaticResource ResetButton}"/>
                                                        </StackPanel>
                                                        <!-- Per-source gyro sensitivity. Only renders for
                                                             gyro descriptors so non-gyro sources don't see a
                                                             knob that does nothing. -->
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0"
                                                                    Visibility="{Binding IsGyroSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding Mapping_GyroSensitivity, Source={x:Static strings:Strings.Instance}}"
                                                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <Slider Value="{Binding GyroSensitivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    Minimum="0.1" Maximum="10" SmallChange="0.1" LargeChange="1"
                                                                    Width="120" VerticalAlignment="Center"
                                                                    ToolTip="{Binding Mapping_GyroSensitivity_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                            <TextBox Text="{Binding GyroSensitivity, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                                                     Width="50" Margin="4,0,4,0" Padding="2,1"
                                                                     VerticalContentAlignment="Center"/>
                                                            <TextBlock Text="×" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                        </StackPanel>
                                                        <!-- Remove this source from the row entirely.
                                                             Distinct from Clear (which keeps the row) — uses
                                                             a less-prominent ✕ glyph so it's clearly the
                                                             "delete row" action. -->
                                                        <!-- Incremental inline controls. Up/Down pickers + record
                                                             buttons + Rate + Sticky + Min/Max all on the same
                                                             horizontal row as the Kind dropdown so the source
                                                             stays one line and the ✕ Remove button sits at the
                                                             far right of the same line, not on a row above. -->
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                                    Visibility="{Binding IsIncrementalKind, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="↥" FontSize="14" VerticalAlignment="Center" Margin="0,0,2,0"
                                                                       ToolTip="{Binding Pad_Mapping_Up_IconTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                            <StackPanel Orientation="Vertical" Margin="0,0,2,0">
                                                                <ComboBox ItemsSource="{Binding DataContext.AvailableInputsView,
                                                                            RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"
                                                                          SelectedItem="{Binding ParamUpInputChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          DisplayMemberPath="DisplayName"
                                                                          MinWidth="180" Padding="4,2"
                                                                          ToolTip="{Binding Pad_Mapping_Up_PickerTooltip, Source={x:Static strings:Strings.Instance}}"
                                                                          PreviewKeyDown="MappingComboBox_PreviewKeyDown">
                                                                    <ComboBox.GroupStyle>
                                                                        <GroupStyle>
                                                                            <GroupStyle.HeaderTemplate>
                                                                                <DataTemplate>
                                                                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,3,6,3">
                                                                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </GroupStyle.HeaderTemplate>
                                                                        </GroupStyle>
                                                                    </ComboBox.GroupStyle>
                                                                </ComboBox>
                                                                <TextBlock FontSize="10"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           Margin="4,1,0,0"
                                                                           TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="{Binding ParamUpDeviceLabel}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ParamUp}" Value="">
                                                                                    <Setter Property="Text" Value="{Binding Common_Unassigned, Source={x:Static strings:Strings.Instance}}"/>
                                                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <Button Command="{Binding RecordParamUpCommand}"
                                                                    Width="36" Margin="0,0,6,0" Padding="2"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding RecordIconParamUp}" FontFamily="Segoe MDL2 Assets"/>
                                                                <Button.ToolTip>
                                                                    <TextBlock Text="{Binding RecordTextParamUp}"/>
                                                                </Button.ToolTip>
                                                            </Button>
                                                            <TextBlock Text="↧" FontSize="14" VerticalAlignment="Center" Margin="0,0,2,0"
                                                                       ToolTip="{Binding Pad_Mapping_Down_IconTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                            <StackPanel Orientation="Vertical" Margin="0,0,2,0">
                                                                <ComboBox ItemsSource="{Binding DataContext.AvailableInputsView,
                                                                            RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"
                                                                          SelectedItem="{Binding ParamDownInputChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          DisplayMemberPath="DisplayName"
                                                                          MinWidth="180" Padding="4,2"
                                                                          ToolTip="{Binding Pad_Mapping_Down_PickerTooltip, Source={x:Static strings:Strings.Instance}}"
                                                                          PreviewKeyDown="MappingComboBox_PreviewKeyDown">
                                                                    <ComboBox.GroupStyle>
                                                                        <GroupStyle>
                                                                            <GroupStyle.HeaderTemplate>
                                                                                <DataTemplate>
                                                                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,3,6,3">
                                                                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </GroupStyle.HeaderTemplate>
                                                                        </GroupStyle>
                                                                    </ComboBox.GroupStyle>
                                                                </ComboBox>
                                                                <TextBlock FontSize="10"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           Margin="4,1,0,0"
                                                                           TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="{Binding ParamDownDeviceLabel}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ParamDown}" Value="">
                                                                                    <Setter Property="Text" Value="{Binding Common_Unassigned, Source={x:Static strings:Strings.Instance}}"/>
                                                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <Button Command="{Binding RecordParamDownCommand}"
                                                                    Width="36" Margin="0,0,8,0" Padding="2"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding RecordIconParamDown}" FontFamily="Segoe MDL2 Assets"/>
                                                                <Button.ToolTip>
                                                                    <TextBlock Text="{Binding RecordTextParamDown}"/>
                                                                </Button.ToolTip>
                                                            </Button>
                                                            <TextBlock Text="{Binding Pad_Mapping_Rate, Source={x:Static strings:Strings.Instance}}"
                                                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <Slider Value="{Binding ParamRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    Minimum="0.05" Maximum="5" SmallChange="0.05" LargeChange="0.5"
                                                                    Width="80" VerticalAlignment="Center"
                                                                    ToolTip="{Binding Pad_Mapping_Rate_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                            <TextBox Text="{Binding ParamRate, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                                                     Width="44" Margin="4,0,8,0" Padding="2,1"
                                                                     VerticalContentAlignment="Center"/>
                                                            <CheckBox Content="{Binding Pad_Mapping_Sticky, Source={x:Static strings:Strings.Instance}}"
                                                                      IsChecked="{Binding ParamSticky, Mode=TwoWay}"
                                                                      VerticalAlignment="Center" Margin="0,0,8,0"
                                                                      ToolTip="{Binding Pad_Mapping_Sticky_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                            <TextBlock Text="{Binding Pad_Mapping_Min, Source={x:Static strings:Strings.Instance}}"
                                                                       VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                            <TextBox Text="{Binding ParamMin, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                                                     Width="44" Margin="0,0,6,0" Padding="2,1"
                                                                     VerticalContentAlignment="Center"
                                                                     ToolTip="{Binding Pad_Mapping_Min_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                            <TextBlock Text="{Binding Pad_Mapping_Max, Source={x:Static strings:Strings.Instance}}"
                                                                       VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                            <TextBox Text="{Binding ParamMax, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                                                     Width="44" Margin="0,0,4,0" Padding="2,1"
                                                                     VerticalContentAlignment="Center"
                                                                     ToolTip="{Binding Pad_Mapping_Max_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                        </StackPanel>
                                                        <Button Content="✕" Padding="6,2" Margin="2"
                                                                VerticalAlignment="Center"
                                                                Command="{Binding DataContext.RemoveExtraSourceCommand,
                                                                          RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="{Binding Pad_Mapping_RemoveSource_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- + Add source -->
                                        <Button Content="{Binding Pad_Mapping_AddSource, Source={x:Static strings:Strings.Instance}}"
                                                Padding="6,2"
                                                HorizontalAlignment="Left" Margin="0,4,0,0"
                                                Command="{Binding AddExtraSourceCommand}"
                                                ToolTip="{Binding Pad_Mapping_AddSource_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding Pad_HeaderOutput, Source={x:Static strings:Strings.Instance}}"
                                                Binding="{Binding TargetLabel}"
                                                Width="Auto"/>
                            <DataGridTemplateColumn Header="{Binding Pad_HeaderSource, Source={x:Static strings:Strings.Instance}}"
                                                Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical">
                                            <!-- Cross-device source picker. ItemsSource is the
                                                 grouped CollectionView (GroupDescription on
                                                 InputChoice.DeviceLabel) so the dropdown shows
                                                 each device's inputs under a device-name header.
                                                 SelectedItem write-back tags the row with the
                                                 picked InputChoice's DeviceGuid + DeviceLabel,
                                                 which is what makes the unified Mappings tab
                                                 device-correct without the user having to
                                                 fiddle with the Device dropdown to the right. -->
                                            <ComboBox ItemsSource="{Binding AvailableInputsView}"
                                                      SelectedItem="{Binding SelectedInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      DisplayMemberPath="DisplayName"
                                                      Margin="0" Padding="4,2"
                                                      HorizontalAlignment="Stretch"
                                                      PreviewKeyDown="MappingComboBox_PreviewKeyDown">
                                                <ComboBox.GroupStyle>
                                                    <GroupStyle>
                                                        <GroupStyle.HeaderTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                                        Padding="6,3,6,3" Margin="0,0,0,0">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </GroupStyle.HeaderTemplate>
                                                    </GroupStyle>
                                                </ComboBox.GroupStyle>
                                            </ComboBox>
                                            <!-- Phase 2C — primary source's device origin badge.
                                                 Visible when the row is bound to a per-VC
                                                 MappingSet primary and resolved to a
                                                 user-friendly device name. -->
                                            <!-- Source subtitle below the picker. Shows the device
                                                 the assigned input comes from when set; falls back
                                                 to italic "Unassigned" when nothing is mapped. The
                                                 Style sets Text via a Setter rather than a local
                                                 value so the DataTrigger's override actually wins. -->
                                            <TextBlock FontSize="10"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Margin="4,1,0,0"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding PrimarySourceDeviceLabel}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SourceDescriptor}" Value="">
                                                                <Setter Property="Text" Value="{Binding Common_Unassigned, Source={x:Static strings:Strings.Instance}}"/>
                                                                <Setter Property="FontStyle" Value="Italic"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- Phase 2C — empty-direction hint + one-click
                                                 affordance. Surfaces when a bipolar stick-axis
                                                 row has only the positive direction mapped
                                                 (one button-class source, not inverted).
                                                 Clicking adds a second source mirroring the
                                                 primary with Invert=true. Disappears once a
                                                 second source exists. -->
                                            <Button Content="{Binding Pad_Mapping_AddOppositeDir, Source={x:Static strings:Strings.Instance}}"
                                                    Command="{Binding AddOppositeDirectionCommand}"
                                                    HorizontalAlignment="Left"
                                                    Padding="4,0"
                                                    Margin="4,1,0,0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontSize="10"
                                                    FontStyle="Italic"
                                                    Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                                    Cursor="Hand"
                                                    ToolTip="{Binding Pad_Mapping_AddOppositeDir_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                    Visibility="{Binding ShouldShowEmptyDirectionHint, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{Binding Pad_HeaderValue, Source={x:Static strings:Strings.Instance}}"
                                                Binding="{Binding CurrentValueText, Mode=OneWay}"
                                                Width="Auto"/>
                            <!-- Record button -->
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding ToggleRecordCommand}"
                                                IsEnabled="{Binding IsRecordable}"
                                                Width="40" HorizontalAlignment="Center" Margin="2">
                                            <TextBlock Text="{Binding RecordButtonIcon}" FontFamily="Segoe MDL2 Assets"/>
                                            <Button.ToolTip>
                                                <TextBlock Text="{Binding RecordButtonText}"/>
                                            </Button.ToolTip>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Clear button -->
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding ClearCommand}"
                                                Width="40" HorizontalAlignment="Center" Margin="2">
                                            <TextBlock Text="&#xE75C;" FontFamily="Segoe MDL2 Assets"/>
                                            <Button.ToolTip>
                                                <TextBlock Text="{Binding Common_Clear, Source={x:Static strings:Strings.Instance}}"/>
                                            </Button.ToolTip>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Invert / Half-axis / Bidirectional / Do-not-inherit options.
                                 Width=Auto sizes to the widest cell + header. The
                                 always-visible checkboxes set the natural floor;
                                 the column expands when a row also shows NoInherit
                                 or the gyro sensitivity slider, and collapses when
                                 no such row exists. HorizontalAlignment=Left on the
                                 cell-template StackPanel keeps it from being
                                 measured against the cell's stretched arrange
                                 rectangle — without it, the WPF-UI DataGrid cell
                                 template feeds the StackPanel the column's stretched
                                 width during measurement, and the column inflates. -->
                            <DataGridTemplateColumn Header="{Binding Pad_HeaderOptions, Source={x:Static strings:Strings.Instance}}" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <CheckBox Content="{Binding Pad_Invert, Source={x:Static strings:Strings.Instance}}" IsChecked="{Binding IsInverted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <CheckBox Content="{Binding Pad_Half, Source={x:Static strings:Strings.Instance}}" IsChecked="{Binding IsHalfAxis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding IsHalfAxisApplicable}"
                                                      Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <CheckBox Content="{Binding Pad_Either, Source={x:Static strings:Strings.Instance}}"
                                                      ToolTip="{Binding Pad_Either_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                      IsChecked="{Binding IsBidirectional, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding IsHalfAxis}"
                                                      Margin="0,0,6,0"
                                                      VerticalAlignment="Center"/>
                                            <!-- NoInherit toggle. Only meaningful when authoring
                                                 a shift layer whose activator has InheritUnmapped
                                                 enabled — replace-mode layers (the default) block
                                                 Base wholesale, making NoInherit a no-op. The
                                                 CheckBox is hidden outside that narrow case so
                                                 users don't see a useless tickbox. -->
                                            <CheckBox Content="{Binding Pad_Shift_NoInherit, Source={x:Static strings:Strings.Instance}}"
                                                      ToolTip="{Binding Pad_Shift_NoInherit_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                                      IsChecked="{Binding NoInherit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      VerticalAlignment="Center"
                                                      Visibility="{Binding DataContext.IsActiveLayerInheriting, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <!-- Per-source gyro sensitivity for the primary source.
                                                 Mirrors the ExtraSource gyro-sensitivity row; only
                                                 renders for gyro descriptors so non-gyro primaries
                                                 don't see a knob that does nothing. -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0"
                                                        Visibility="{Binding IsGyroSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Mapping_GyroSensitivity, Source={x:Static strings:Strings.Instance}}"
                                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <Slider Value="{Binding GyroSensitivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Minimum="0.1" Maximum="10" SmallChange="0.1" LargeChange="1"
                                                        Width="120" VerticalAlignment="Center"
                                                        ToolTip="{Binding Mapping_GyroSensitivity_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                <TextBox Text="{Binding GyroSensitivity, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                                         Width="50" Margin="4,0,4,0" Padding="2,1"
                                                         VerticalContentAlignment="Center"/>
                                                <TextBlock Text="×" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Deadzone (per-mapping axis activation threshold) -->
                            <DataGridTemplateColumn Header="{Binding Pad_HeaderDeadZone, Source={x:Static strings:Strings.Instance}}" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDeadZoneApplicable}" Value="False">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                            <Setter Property="Opacity" Value="0.35"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Slider Style="{StaticResource DzSlider}" Width="120"
                                                    Value="{Binding MappingDeadZone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    TickFrequency="1"/>
                                            <TextBox Text="{Binding MappingDeadZone, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource DzValueEdit}"/>
                                            <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                            <Button Command="{Binding ResetDeadZoneCommand}" Style="{StaticResource ResetButton}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ─── TAB 3: Sticks (dynamic) ─── -->
            <TabItem>
                <ScrollViewer Padding="24,0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <viewControls:LabeledShapeIcon Shape="Stick" Width="24" Height="24"
                                                            VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Pad_Sticks_Header, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource TitleTextBlockStyle}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Pad_Sticks_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <ItemsControl ItemsSource="{Binding StickConfigs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StickConfigItem}">
                                <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <viewControls:LabeledShapeIcon Shape="Stick" Label="{Binding IconLabel}"
                                                                       Width="18" Height="18"
                                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource CardTitle}"/>
                                        <Button Command="{Binding ResetAllCommand}" Style="{StaticResource ResetAllButton}"
                                                Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                                ToolTip="{Binding ResetAllToolTip}"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Sliders (left) -->
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <!-- Center Offset Calibration -->
                                            <Button Margin="0,0,0,8"
                                                    Click="CalibrateCenter_Click"
                                                    Padding="8,4" HorizontalAlignment="Left">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Content" Value="{Binding Pad_CalibrateCenter, Source={x:Static strings:Strings.Instance}}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCalibrating}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                <Setter Property="Content" Value="{Binding Pad_Sampling, Source={x:Static strings:Strings.Instance}}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_CenterOffsetX, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <Slider Value="{Binding CenterOffsetX, Mode=TwoWay}"
                                                        Style="{StaticResource OffsetSlider}"/>
                                                <TextBox Text="{Binding CenterOffsetX, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                <TextBox Text="{Binding CenterOffsetXDigit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzDigitEdit}"/>
                                                <Button Command="{Binding ResetCenterOffsetXCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetCenterOffsetX, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_CenterOffsetY, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <Slider Value="{Binding CenterOffsetY, Mode=TwoWay}"
                                                        Style="{StaticResource OffsetSlider}"/>
                                                <TextBox Text="{Binding CenterOffsetY, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                <TextBox Text="{Binding CenterOffsetYDigit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzDigitEdit}"/>
                                                <Button Command="{Binding ResetCenterOffsetYCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetCenterOffsetY, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                            <Separator Margin="0,8,0,8"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_DeadZoneShape, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <ComboBox AutomationProperties.AutomationId="DeadZoneShapeCombo"
                                                          SelectedIndex="{Binding DeadZoneShapeIndex, Mode=TwoWay}"
                                                          Width="200" VerticalAlignment="Center">
                                                    <ComboBoxItem Content="{Binding Pad_DZScaledRadial, Source={x:Static strings:Strings.Instance}}"/>
                                                    <ComboBoxItem Content="{Binding Pad_DZRadial, Source={x:Static strings:Strings.Instance}}"/>
                                                    <ComboBoxItem Content="{Binding Pad_DZAxial, Source={x:Static strings:Strings.Instance}}"/>
                                                    <ComboBoxItem Content="{Binding Pad_DZHybrid, Source={x:Static strings:Strings.Instance}}"/>
                                                    <ComboBoxItem Content="{Binding Pad_DZSlopedScaledAxial, Source={x:Static strings:Strings.Instance}}"/>
                                                    <ComboBoxItem Content="{Binding Pad_DZSlopedAxial, Source={x:Static strings:Strings.Instance}}"/>
                                                </ComboBox>
                                                <Button Command="{Binding ResetDeadZoneShapeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetDeadZoneShape, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_DeadZoneX, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <Slider Value="{Binding DeadZoneX, Mode=TwoWay}"
                                                        Style="{StaticResource DzSlider}"/>
                                                <TextBox Text="{Binding DeadZoneX, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                <TextBox Text="{Binding DeadZoneXDigit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzDigitEdit}"/>
                                                <Button Command="{Binding ResetDeadZoneXCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetDeadZoneX, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_DeadZoneY, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <Slider Value="{Binding DeadZoneY, Mode=TwoWay}"
                                                        Style="{StaticResource DzSlider}"/>
                                                <TextBox Text="{Binding DeadZoneY, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                <TextBox Text="{Binding DeadZoneYDigit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzDigitEdit}"/>
                                                <Button Command="{Binding ResetDeadZoneYCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetDeadZoneY, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_AntiDeadZoneX, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <Slider Value="{Binding AntiDeadZoneX, Mode=TwoWay}"
                                                        Style="{StaticResource DzSlider}"/>
                                                <TextBox Text="{Binding AntiDeadZoneX, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                <TextBox Text="{Binding AntiDeadZoneXDigit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzDigitEdit}"/>
                                                <Button Command="{Binding ResetAntiDeadZoneXCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetAntiDeadZoneX, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_AntiDeadZoneY, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <Slider Value="{Binding AntiDeadZoneY, Mode=TwoWay}"
                                                        Style="{StaticResource DzSlider}"/>
                                                <TextBox Text="{Binding AntiDeadZoneY, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                <TextBox Text="{Binding AntiDeadZoneYDigit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzDigitEdit}"/>
                                                <Button Command="{Binding ResetAntiDeadZoneYCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetAntiDeadZoneY, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_Linear, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <Slider Value="{Binding Linear, Mode=TwoWay}"
                                                        Style="{StaticResource DzSlider}"/>
                                                <TextBox Text="{Binding Linear, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                <Button Command="{Binding ResetLinearCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetLinear, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                            <Separator Margin="0,8,0,8"/>
                                            <TextBlock Text="{Binding Pad_SensitivityCurves, Source={x:Static strings:Strings.Instance}}"
                                                       Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="{Binding Pad_SensitivityCurveHint, Source={x:Static strings:Strings.Instance}}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_SensitivityX, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <ComboBox AutomationProperties.AutomationId="SensitivityXCombo"
                                                          Width="120"
                                                          ItemsSource="{x:Static vm:StickConfigItem.CurvePresetNames}"
                                                          SelectedItem="{Binding PresetNameX, Mode=OneWay}"
                                                          SelectionChanged="StickPresetX_SelectionChanged"
                                                          Tag="{Binding}"/>
                                                <Button Command="{Binding ResetSensitivityXCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetSensitivityX, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_SensitivityY, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <ComboBox Width="120"
                                                          ItemsSource="{x:Static vm:StickConfigItem.CurvePresetNames}"
                                                          SelectedItem="{Binding PresetNameY, Mode=OneWay}"
                                                          SelectionChanged="StickPresetY_SelectionChanged"
                                                          Tag="{Binding}"/>
                                                <Button Command="{Binding ResetSensitivityYCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetSensitivityY, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                            <Separator Margin="0,8,0,8"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_MinRangeXLeft, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <Slider Value="{Binding MaxRangeXNeg, Mode=TwoWay}"
                                                        Minimum="1" Maximum="100"
                                                        Style="{StaticResource DzSlider}"/>
                                                <TextBox Text="{Binding MaxRangeXNeg, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                <TextBox Text="{Binding MaxRangeXNegDigit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzDigitEdit}"/>
                                                <Button Command="{Binding ResetMaxRangeXNegCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetMinRangeX, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_MaxRangeXRight, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <Slider Value="{Binding MaxRangeX, Mode=TwoWay}"
                                                        Minimum="1" Maximum="100"
                                                        Style="{StaticResource DzSlider}"/>
                                                <TextBox Text="{Binding MaxRangeX, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                <TextBox Text="{Binding MaxRangeXDigit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzDigitEdit}"/>
                                                <Button Command="{Binding ResetMaxRangeXCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetMaxRangeX, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_MinRangeYDown, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <Slider Value="{Binding MaxRangeY, Mode=TwoWay}"
                                                        Minimum="1" Maximum="100"
                                                        Style="{StaticResource DzSlider}"/>
                                                <TextBox Text="{Binding MaxRangeY, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                <TextBox Text="{Binding MaxRangeYDigit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzDigitEdit}"/>
                                                <Button Command="{Binding ResetMaxRangeYCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetMinRangeY, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_MaxRangeYUp, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <Slider Value="{Binding MaxRangeYNeg, Mode=TwoWay}"
                                                        Minimum="1" Maximum="100"
                                                        Style="{StaticResource DzSlider}"/>
                                                <TextBox Text="{Binding MaxRangeYNeg, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                <TextBox Text="{Binding MaxRangeYNegDigit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzDigitEdit}"/>
                                                <Button Command="{Binding ResetMaxRangeYNegCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetMaxRangeY, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Live preview (right) -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Top" MinWidth="216">
                                            <Border BorderBrush="#FF3F3F46" BorderThickness="2" CornerRadius="2"
                                                    Padding="4" Width="212" Height="212"
                                                    ClipToBounds="True">
                                                <Grid Width="200" Height="200">
                                                    <Ellipse Width="200" Height="200"
                                                             Fill="{DynamicResource ControlFillColorDefaultBrush}"/>
                                                    <!-- Grid lines (Grid layer, behind Canvas) -->
                                                    <Line X1="50" Y1="0" X2="50" Y2="200" Stroke="#40FFFFFF" StrokeDashArray="2 4" StrokeThickness="0.5"/>
                                                    <Line X1="150" Y1="0" X2="150" Y2="200" Stroke="#40FFFFFF" StrokeDashArray="2 4" StrokeThickness="0.5"/>
                                                    <Line X1="0" Y1="50" X2="200" Y2="50" Stroke="#40FFFFFF" StrokeDashArray="2 4" StrokeThickness="0.5"/>
                                                    <Line X1="0" Y1="150" X2="200" Y2="150" Stroke="#40FFFFFF" StrokeDashArray="2 4" StrokeThickness="0.5"/>
                                                    <Line X1="100" Y1="0" X2="100" Y2="200" Stroke="#60FFFFFF" StrokeThickness="0.75"/>
                                                    <Line X1="0" Y1="100" X2="200" Y2="100" Stroke="#60FFFFFF" StrokeThickness="0.75"/>
                                                    <Canvas>
                                                        <Ellipse Width="196" Height="196" Canvas.Left="2" Canvas.Top="2"
                                                                 Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                                 StrokeThickness="1.5" Fill="Transparent"/>
                                                        <Ellipse Width="98" Height="98" Canvas.Left="51" Canvas.Top="51"
                                                                 Stroke="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                                                 StrokeDashArray="4 2" StrokeThickness="0.5" Fill="Transparent"/>
                                                        <!-- Dead zone overlay: Cross for Axial, Ellipse for Radial, Rectangle for Sloped -->

                                                        <!-- Axial: cross arms (yellow) — movement occurs but snapped to axis -->
                                                        <Path Fill="#20FFC107" Stroke="#50FFC107" StrokeThickness="1"
                                                              Visibility="{Binding IsAxialShape, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <Path.Data>
                                                                <MultiBinding Converter="{StaticResource CrossGeometryConverter}">
                                                                    <Binding Path="DeadZoneX"/>
                                                                    <Binding Path="DeadZoneY"/>
                                                                </MultiBinding>
                                                            </Path.Data>
                                                        </Path>
                                                        <!-- Axial: center rectangle (red) — fully dead, no output -->
                                                        <Rectangle Fill="#18FF5722" Stroke="#60FF5722" StrokeThickness="1"
                                                                   Visibility="{Binding IsAxialShape, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <Rectangle.Width>
                                                                <Binding Path="DeadZoneX" Converter="{StaticResource PercentToSizeConverter}" ConverterParameter="200"/>
                                                            </Rectangle.Width>
                                                            <Rectangle.Height>
                                                                <Binding Path="DeadZoneY" Converter="{StaticResource PercentToSizeConverter}" ConverterParameter="200"/>
                                                            </Rectangle.Height>
                                                            <Rectangle.RenderTransform>
                                                                <TranslateTransform>
                                                                    <TranslateTransform.X>
                                                                        <Binding Path="DeadZoneX" Converter="{StaticResource PercentToSizeConverter}" ConverterParameter="-100"/>
                                                                    </TranslateTransform.X>
                                                                    <TranslateTransform.Y>
                                                                        <Binding Path="DeadZoneY" Converter="{StaticResource PercentToSizeConverter}" ConverterParameter="-100"/>
                                                                    </TranslateTransform.Y>
                                                                </TranslateTransform>
                                                            </Rectangle.RenderTransform>
                                                            <Canvas.Left>100</Canvas.Left>
                                                            <Canvas.Top>100</Canvas.Top>
                                                        </Rectangle>

                                                        <!-- Radial: ellipse/circle -->
                                                        <Ellipse Fill="#18FF5722" Stroke="#60FF5722" StrokeThickness="1"
                                                                 Visibility="{Binding IsRadialShape, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <Ellipse.Width>
                                                                <Binding Path="DeadZoneX" Converter="{StaticResource PercentToSizeConverter}" ConverterParameter="200"/>
                                                            </Ellipse.Width>
                                                            <Ellipse.Height>
                                                                <Binding Path="DeadZoneY" Converter="{StaticResource PercentToSizeConverter}" ConverterParameter="200"/>
                                                            </Ellipse.Height>
                                                            <Ellipse.RenderTransform>
                                                                <TranslateTransform>
                                                                    <TranslateTransform.X>
                                                                        <Binding Path="DeadZoneX" Converter="{StaticResource PercentToSizeConverter}" ConverterParameter="-100"/>
                                                                    </TranslateTransform.X>
                                                                    <TranslateTransform.Y>
                                                                        <Binding Path="DeadZoneY" Converter="{StaticResource PercentToSizeConverter}" ConverterParameter="-100"/>
                                                                    </TranslateTransform.Y>
                                                                </TranslateTransform>
                                                            </Ellipse.RenderTransform>
                                                            <Canvas.Left>100</Canvas.Left>
                                                            <Canvas.Top>100</Canvas.Top>
                                                        </Ellipse>

                                                        <!-- Sloped / Hybrid: 4 triangular wedges (yellow) — axis-snapped regions -->
                                                        <Path Fill="#20FFC107" Stroke="#50FFC107" StrokeThickness="1"
                                                              Visibility="{Binding HasSlopedWedges, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <Path.Data>
                                                                <MultiBinding Converter="{StaticResource SlopedWedgeGeometryConverter}">
                                                                    <Binding Path="DeadZoneX"/>
                                                                    <Binding Path="DeadZoneY"/>
                                                                </MultiBinding>
                                                            </Path.Data>
                                                        </Path>

                                                        <!-- Hybrid: circle (red) — fully dead center from radial stage -->
                                                        <Ellipse Fill="#18FF5722" Stroke="#60FF5722" StrokeThickness="1"
                                                                 Visibility="{Binding IsHybridShape, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <Ellipse.Width>
                                                                <Binding Path="DeadZoneX" Converter="{StaticResource PercentToSizeConverter}" ConverterParameter="200"/>
                                                            </Ellipse.Width>
                                                            <Ellipse.Height>
                                                                <Binding Path="DeadZoneY" Converter="{StaticResource PercentToSizeConverter}" ConverterParameter="200"/>
                                                            </Ellipse.Height>
                                                            <Ellipse.RenderTransform>
                                                                <TranslateTransform>
                                                                    <TranslateTransform.X>
                                                                        <Binding Path="DeadZoneX" Converter="{StaticResource PercentToSizeConverter}" ConverterParameter="-100"/>
                                                                    </TranslateTransform.X>
                                                                    <TranslateTransform.Y>
                                                                        <Binding Path="DeadZoneY" Converter="{StaticResource PercentToSizeConverter}" ConverterParameter="-100"/>
                                                                    </TranslateTransform.Y>
                                                                </TranslateTransform>
                                                            </Ellipse.RenderTransform>
                                                            <Canvas.Left>100</Canvas.Left>
                                                            <Canvas.Top>100</Canvas.Top>
                                                        </Ellipse>
                                                        <!-- Stick position dot -->
                                                        <Ellipse Width="11" Height="11" Fill="#FF2196F3"
                                                                 Stroke="#FF1976D2" StrokeThickness="1"
                                                                 Canvas.Left="{Binding LiveX, Converter={StaticResource NormToCanvasConverter}, ConverterParameter='200,11'}"
                                                                 Canvas.Top="{Binding LiveY, Converter={StaticResource NormToCanvasConverter}, ConverterParameter='200,11'}"/>
                                                    </Canvas>
                                                </Grid>
                                            </Border>
                                            <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center"
                                                       Text="{Binding RawDisplay, Mode=OneWay}"
                                                       TextWrapping="Wrap" TextAlignment="Center"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                                            <!-- Per-axis sensitivity curve editors -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                                <!-- X axis curve editor -->
                                                <StackPanel Margin="0,0,4,0">
                                                    <TextBlock Text="{Binding Pad_XAxis, Source={x:Static strings:Strings.Instance}}" HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               FontSize="10" Margin="0,0,0,2"/>
                                                    <controls:CurveEditor
                                                        CurveString="{Binding SensitivityCurveX, Mode=TwoWay}"
                                                        DeadZone="{Binding DeadZoneX}"
                                                        MaxRange="{Binding MaxRangeX}"
                                                        MaxRangeNeg="{Binding MaxRangeXNeg}"
                                                        LiveInput="{Binding LiveInputX}"
                                                        IsSigned="True" ChartSize="96"/>
                                                </StackPanel>
                                                <!-- Y axis curve editor -->
                                                <StackPanel Margin="4,0,0,0">
                                                    <TextBlock Text="{Binding Pad_YAxis, Source={x:Static strings:Strings.Instance}}" HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               FontSize="10" Margin="0,0,0,2"/>
                                                    <controls:CurveEditor
                                                        CurveString="{Binding SensitivityCurveY, Mode=TwoWay}"
                                                        DeadZone="{Binding DeadZoneY}"
                                                        MaxRange="{Binding MaxRangeYNeg}"
                                                        MaxRangeNeg="{Binding MaxRangeY}"
                                                        LiveInput="{Binding LiveInputY}"
                                                        IsSigned="True" ChartSize="96"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- ═══ Steering (winding / 2D angle-to-axis / motion lean) #94 — divider-separated section like the rest of the card ═══ -->
                                    <Separator Margin="0,16,0,8"/>
                                    <StackPanel>
                                            <TextBlock Text="{Binding Pad_Steering_Header, Source={x:Static strings:Strings.Instance}}"
                                                       Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="{Binding Pad_Steering_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap" Margin="0,0,0,8"/>

                                            <!-- Mode -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_Steering_Mode, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <ComboBox SelectedIndex="{Binding SteeringModeIndex, Mode=TwoWay}" Width="200" VerticalAlignment="Center">
                                                    <ComboBoxItem Content="{Binding Pad_Steering_Mode_Linear, Source={x:Static strings:Strings.Instance}}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Steering_Mode_Winding, Source={x:Static strings:Strings.Instance}}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Steering_Mode_AngleX, Source={x:Static strings:Strings.Instance}}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Steering_Mode_AngleY, Source={x:Static strings:Strings.Instance}}"/>
                                                    <ComboBoxItem Content="{Binding Pad_Steering_Mode_MotionLean, Source={x:Static strings:Strings.Instance}}"/>
                                                </ComboBox>
                                                <Button Command="{Binding ResetSteeringModeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_Mode, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>

                                            <!-- Winding parameters -->
                                            <StackPanel Visibility="{Binding IsWindingMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Pad_Steering_WindRange, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                    <Slider Value="{Binding WindRangeDeg, Mode=TwoWay}" Minimum="90" Maximum="2520" Style="{StaticResource DzSlider}"/>
                                                    <TextBox Text="{Binding WindRangeDeg, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                                    <TextBlock Text="&#176;" Style="{StaticResource DzPercent}"/>
                                                    <Button Command="{Binding ResetWindRangeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_WindRange, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Pad_Steering_WindPower, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                    <Slider Value="{Binding WindPower, Mode=TwoWay}" Minimum="0" Maximum="4" Style="{StaticResource DzSlider}"/>
                                                    <TextBox Text="{Binding WindPower, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                                    <Button Command="{Binding ResetWindPowerCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_WindPower, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Pad_Steering_WindUnwindRate, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                    <Slider Value="{Binding WindUnwindRate, Mode=TwoWay}" Minimum="0" Maximum="10000" Style="{StaticResource DzSlider}"/>
                                                    <TextBox Text="{Binding WindUnwindRate, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                                    <Button Command="{Binding ResetWindUnwindRateCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_WindUnwindRate, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Angle-to-axis parameters -->
                                            <StackPanel Visibility="{Binding IsAngleMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Pad_Steering_AngleInnerDz, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                    <Slider Value="{Binding AngleInnerDz, Mode=TwoWay}" Minimum="0" Maximum="89" Style="{StaticResource DzSlider}"/>
                                                    <TextBox Text="{Binding AngleInnerDz, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                                    <TextBlock Text="&#176;" Style="{StaticResource DzPercent}"/>
                                                    <Button Command="{Binding ResetAngleInnerDzCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_AngleInnerDz, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Pad_Steering_AngleOuterDz, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                    <Slider Value="{Binding AngleOuterDz, Mode=TwoWay}" Minimum="0" Maximum="89" Style="{StaticResource DzSlider}"/>
                                                    <TextBox Text="{Binding AngleOuterDz, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                                    <TextBlock Text="&#176;" Style="{StaticResource DzPercent}"/>
                                                    <Button Command="{Binding ResetAngleOuterDzCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_AngleOuterDz, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Motion-lean parameters -->
                                            <StackPanel Visibility="{Binding IsMotionLeanMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Pad_Steering_MotionInnerDz, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                    <Slider Value="{Binding MotionInnerDz, Mode=TwoWay}" Minimum="0" Maximum="179" Style="{StaticResource DzSlider}"/>
                                                    <TextBox Text="{Binding MotionInnerDz, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                                    <TextBlock Text="&#176;" Style="{StaticResource DzPercent}"/>
                                                    <Button Command="{Binding ResetMotionInnerDzCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_MotionInnerDz, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Pad_Steering_MotionOuterDz, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                    <Slider Value="{Binding MotionOuterDz, Mode=TwoWay}" Minimum="0" Maximum="179" Style="{StaticResource DzSlider}"/>
                                                    <TextBox Text="{Binding MotionOuterDz, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                                    <TextBlock Text="&#176;" Style="{StaticResource DzPercent}"/>
                                                    <Button Command="{Binding ResetMotionOuterDzCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_MotionOuterDz, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Pad_Steering_Orientation, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                    <ComboBox SelectedIndex="{Binding ControllerOrientationIndex, Mode=TwoWay}" Width="200" VerticalAlignment="Center">
                                                        <ComboBoxItem Content="{Binding Pad_Steering_Orient_Forward, Source={x:Static strings:Strings.Instance}}"/>
                                                        <ComboBoxItem Content="{Binding Pad_Steering_Orient_Left, Source={x:Static strings:Strings.Instance}}"/>
                                                        <ComboBoxItem Content="{Binding Pad_Steering_Orient_Right, Source={x:Static strings:Strings.Instance}}"/>
                                                        <ComboBoxItem Content="{Binding Pad_Steering_Orient_Backward, Source={x:Static strings:Strings.Instance}}"/>
                                                    </ComboBox>
                                                    <Button Command="{Binding ResetControllerOrientationCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_Orientation, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ═══ Steering at-lock feedback (#94) — per device, all opt-in.
                         Channels are shown only when the SELECTED assigned device can
                         do them (SyncTabVisibility gates each by capability). ═══ -->
                    <Border x:Name="LockFeedbackCard" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <!-- Steering wheel flanked by vibration waves: the wheel hits its
                                     lock and you feel the cue. -->
                                <Viewbox Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.7"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M5,12 A7,7 0 1 1 19,12 A7,7 0 1 1 5,12 Z M10.1,12 A1.9,1.9 0 1 1 13.9,12 A1.9,1.9 0 1 1 10.1,12 Z M10.1,12 L5,12 M13.9,12 L19,12 M12,13.9 L12,19 M3.7,9.8 A2.9,2.9 0 0 0 3.7,14.2 M2,8.5 A4.6,4.6 0 0 0 2,15.5 M20.3,9.8 A2.9,2.9 0 0 1 20.3,14.2 M22,8.5 A4.6,4.6 0 0 1 22,15.5"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{Binding Pad_Steering_LockFeedback, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardTitle}"/>
                                <Button Command="{Binding ResetSteeringLockAllCommand}" Style="{StaticResource ResetAllButton}"
                                        Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                        ToolTip="{Binding Pad_Steering_Reset_LockFeedback, Source={x:Static strings:Strings.Instance}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Pad_Steering_LockFeedback_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <!-- Each channel is a checkbox + its own reset (off), so every row
                                 in the card has a reset like the sliders below. Visibility is
                                 gated per row by SyncTabVisibility to the device's capability. -->
                            <StackPanel x:Name="LockRumbleRow" Orientation="Horizontal" Margin="0,0,0,4">
                                <CheckBox IsChecked="{Binding SteeringLockRumbleEnabled, Mode=TwoWay}" VerticalAlignment="Center"
                                          Content="{Binding Pad_Steering_Lock_Rumble, Source={x:Static strings:Strings.Instance}}"/>
                                <Button Command="{Binding ResetSteeringLockRumbleCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_Rumble, Source={x:Static strings:Strings.Instance}}"/>
                            </StackPanel>
                            <StackPanel x:Name="LockTriggerVibRow" Orientation="Horizontal" Margin="0,0,0,4">
                                <CheckBox IsChecked="{Binding SteeringLockTriggerVibEnabled, Mode=TwoWay}" VerticalAlignment="Center"
                                          Content="{Binding Pad_Steering_Lock_TriggerVib, Source={x:Static strings:Strings.Instance}}"/>
                                <Button Command="{Binding ResetSteeringLockTriggerVibCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_TriggerVib, Source={x:Static strings:Strings.Instance}}"/>
                            </StackPanel>
                            <StackPanel x:Name="LockLightbarRow" Orientation="Horizontal" Margin="0,0,0,4">
                                <CheckBox IsChecked="{Binding SteeringLockLightbarEnabled, Mode=TwoWay}" VerticalAlignment="Center"
                                          Content="{Binding Pad_Steering_Lock_Lightbar, Source={x:Static strings:Strings.Instance}}"/>
                                <Button Command="{Binding ResetSteeringLockLightbarCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_Lightbar, Source={x:Static strings:Strings.Instance}}"/>
                            </StackPanel>
                            <StackPanel x:Name="LockResistanceRow" Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox IsChecked="{Binding SteeringLockATResistanceEnabled, Mode=TwoWay}" VerticalAlignment="Center"
                                          Content="{Binding Pad_Steering_Lock_ATResistance, Source={x:Static strings:Strings.Instance}}"/>
                                <Button Command="{Binding ResetSteeringLockResistanceCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_ATResistance, Source={x:Static strings:Strings.Instance}}"/>
                            </StackPanel>
                            <!-- Pulse length — applies to the rumble / trigger / lightbar PULSE channels. -->
                            <StackPanel x:Name="LockPulseSection">
                                <Separator Margin="0,8,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <TextBlock Text="{Binding Pad_Steering_Lock_PulseMs, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding SteeringLockPulseMs, Mode=TwoWay}" Minimum="0" Maximum="2000" Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding SteeringLockPulseMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                    <Button Command="{Binding ResetSteeringLockPulseCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_PulseMs, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- Lightbar colour + fade — only meaningful on a device with a lightbar. -->
                            <StackPanel x:Name="LockLightbarSection">
                            <Separator Margin="0,8,0,8"/>
                            <!-- Lightbar pulse colour — full picker in a bounding box (matches every other
                                 colour picker): HSV box, swatch, hex field, RGB sliders + fields with per-channel resets -->
                            <TextBlock Text="{Binding Pad_Steering_Lock_LightbarColor, Source={x:Static strings:Strings.Instance}}" Margin="0,0,0,4"/>
                            <Border BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8"
                                    HorizontalAlignment="Left"
                                    BorderBrush="{DynamicResource TextFillColorDisabledBrush}">
                                <StackPanel>
                                    <views:ColorPickerControl Margin="0,0,0,12" HorizontalAlignment="Left"
                                        Red="{Binding SteeringLockColorR, Mode=TwoWay}"
                                        Green="{Binding SteeringLockColorG, Mode=TwoWay}"
                                        Blue="{Binding SteeringLockColorB, Mode=TwoWay}"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="48" Height="36" CornerRadius="4" HorizontalAlignment="Left"
                                                BorderBrush="{DynamicResource TextFillColorDisabledBrush}" BorderThickness="1">
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                                    <Binding Path="SteeringLockColorR"/>
                                                    <Binding Path="SteeringLockColorG"/>
                                                    <Binding Path="SteeringLockColorB"/>
                                                </MultiBinding>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Pad_Lighting_Hex, Source={x:Static strings:Strings.Instance}}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <TextBox Grid.Column="2" Width="100" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                 FontFamily="Consolas" Padding="6,4"
                                                 Text="{Binding SteeringLockLightbarColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="{Binding Pad_Lighting_HexTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="R" Style="{StaticResource DzLabelTight}" Foreground="#FFD32F2F"/>
                                        <Slider Value="{Binding SteeringLockColorR, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                        <TextBox Text="{Binding SteeringLockColorR, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                        <Button Command="{Binding ResetSteeringLockColorRCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarRed, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="G" Style="{StaticResource DzLabelTight}" Foreground="#FF388E3C"/>
                                        <Slider Value="{Binding SteeringLockColorG, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                        <TextBox Text="{Binding SteeringLockColorG, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                        <Button Command="{Binding ResetSteeringLockColorGCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarGreen, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                        <TextBlock Text="B" Style="{StaticResource DzLabelTight}" Foreground="#FF1976D2"/>
                                        <Slider Value="{Binding SteeringLockColorB, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                        <TextBox Text="{Binding SteeringLockColorB, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                        <Button Command="{Binding ResetSteeringLockColorBCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarBlue, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <TextBlock Text="{Binding Pad_Steering_Lock_LightbarFadeMs, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                <Slider Value="{Binding SteeringLockLightbarFadeMs, Mode=TwoWay}" Minimum="0" Maximum="5000" Style="{StaticResource DzSlider}"/>
                                <TextBox Text="{Binding SteeringLockLightbarFadeMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                <Button Command="{Binding ResetSteeringLockFadeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_Steering_Reset_LightbarFadeMs, Source={x:Static strings:Strings.Instance}}"/>
                            </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ─── TAB 4: Triggers (dynamic) ─── -->
            <TabItem>
                <ScrollViewer Padding="24,0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <viewControls:LabeledShapeIcon Shape="TriggerLeft" Width="24" Height="24"
                                                            VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Pad_Triggers_Header, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource TitleTextBlockStyle}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Pad_Triggers_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <ItemsControl ItemsSource="{Binding TriggerConfigs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TriggerConfigItem}">
                                <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <viewControls:LabeledShapeIcon
                                            Shape="{Binding IconRightSide, Converter={StaticResource BoolToTriggerShapeKindConverter}}"
                                            Label="{Binding IconLabel}"
                                            Width="18" Height="18"
                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource CardTitle}"/>
                                        <Button Command="{Binding ResetAllCommand}" Style="{StaticResource ResetAllButton}"
                                                Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                                ToolTip="{Binding ResetAllToolTip}"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: sliders and live bar -->
                                        <StackPanel Grid.Column="0">
                                            <!-- Range (dual-thumb: deadzone floor — max range ceiling) -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_Range, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <controls:RangeSlider
                                                    LowerValue="{Binding DeadZone, Mode=TwoWay}"
                                                    UpperValue="{Binding MaxRange, Mode=TwoWay}"
                                                    Minimum="0" Maximum="100"
                                                    Width="200" VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding DeadZone, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Text="—" VerticalAlignment="Center" Margin="2,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBox Text="{Binding MaxRange, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                <TextBox Text="{Binding DeadZoneDigit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzDigitEdit}"/>
                                                <TextBlock Text="—" VerticalAlignment="Center" Margin="2,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBox Text="{Binding MaxRangeDigit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzDigitEdit}"/>
                                                <Button Command="{Binding ResetRangeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetRange, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_AntiDeadZone, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <Slider Value="{Binding AntiDeadZone, Mode=TwoWay}"
                                                        Style="{StaticResource DzSlider}"/>
                                                <TextBox Text="{Binding AntiDeadZone, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzValueEdit}"/>
                                                <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                                <TextBox Text="{Binding AntiDeadZoneDigit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource DzDigitEdit}"/>
                                                <Button Command="{Binding ResetAntiDeadZoneCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetAntiDeadZone, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>

                                            <Separator Margin="0,8,0,8"/>
                                            <TextBlock Text="{Binding Pad_SensitivityCurve, Source={x:Static strings:Strings.Instance}}"
                                                       Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="{Binding Pad_SensitivityCurveHintShort, Source={x:Static strings:Strings.Instance}}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Pad_Preset_Label, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <ComboBox AutomationProperties.AutomationId="TriggerPresetCombo"
                                                          Width="120"
                                                          ItemsSource="{x:Static vm:TriggerConfigItem.CurvePresetNames}"
                                                          SelectedItem="{Binding PresetName, Mode=OneWay}"
                                                          SelectionChanged="TriggerPreset_SelectionChanged"
                                                          Tag="{Binding}"/>
                                                <Button Command="{Binding ResetSensitivityCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetSensitivity, Source={x:Static strings:Strings.Instance}}"/>
                                            </StackPanel>

                                            <!-- Live value bar -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Pad_Live, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                                <ProgressBar Value="{Binding LiveValue, Mode=OneWay}"
                                                             Minimum="0" Maximum="1"
                                                             Width="200" Height="16" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding RawDisplay, Mode=OneWay}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Right: sensitivity curve editor -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="16,-26,0,0">
                                            <TextBlock Text="{Binding Pad_TriggerAxis, Source={x:Static strings:Strings.Instance}}" Margin="0,0,0,4"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       FontSize="11"/>
                                            <controls:CurveEditor
                                                CurveString="{Binding SensitivityCurve, Mode=TwoWay}"
                                                DeadZone="{Binding DeadZone}"
                                                MaxRange="{Binding MaxRange}"
                                                LiveInput="{Binding LiveInputForCurve}"
                                                IsSigned="False" ChartSize="120"/>
                                        </StackPanel>
                                    </Grid>

                                </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ─── TAB 5: Force Feedback ─── -->
            <TabItem>
                <ScrollViewer Padding="24,0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE877;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Pad_ForceFeedback_Header, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource TitleTextBlockStyle}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Pad_ForceFeedback_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- Force Feedback / Rumble / Haptics section -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE877;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Pad_ForceFeedbackRumble, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource CardTitle}"/>
                            <Button Command="{Binding ResetForceAllCommand}" Style="{StaticResource ResetAllButton}"
                                    Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                    ToolTip="{Binding Pad_ResetForceFeedback, Source={x:Static strings:Strings.Instance}}"/>
                        </StackPanel>

                        <!-- Overall gain -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding Pad_OverallGain, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                            <Slider Value="{Binding ForceOverallGain, Mode=TwoWay}"
                                    Style="{StaticResource DzSlider}"/>
                            <TextBox Text="{Binding ForceOverallGain, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource DzValueEdit}"/>
                            <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                            <Button Command="{Binding ResetOverallGainCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetOverallGain, Source={x:Static strings:Strings.Instance}}"/>
                        </StackPanel>

                        <!-- Left motor -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding Pad_LeftMotorLabel, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                            <Slider Value="{Binding LeftMotorStrength, Mode=TwoWay}"
                                    Style="{StaticResource DzSlider}"/>
                            <TextBox Text="{Binding LeftMotorStrength, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource DzValueEdit}"/>
                            <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                            <Button Command="{Binding ResetLeftMotorCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetLeftMotor, Source={x:Static strings:Strings.Instance}}"/>
                        </StackPanel>

                        <!-- Right motor -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding Pad_RightMotorLabel, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                            <Slider Value="{Binding RightMotorStrength, Mode=TwoWay}"
                                    Style="{StaticResource DzSlider}"/>
                            <TextBox Text="{Binding RightMotorStrength, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource DzValueEdit}"/>
                            <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                            <Button Command="{Binding ResetRightMotorCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetRightMotor, Source={x:Static strings:Strings.Instance}}"/>
                        </StackPanel>

                        <!-- Swap motors -->
                        <CheckBox Content="{Binding Pad_SwapMotors, Source={x:Static strings:Strings.Instance}}"
                                  IsChecked="{Binding SwapMotors, Mode=TwoWay}"
                                  Margin="0,0,0,12"/>

                        <!-- Test rumble -->
                        <Button Content="{Binding Pad_TestRumble, Source={x:Static strings:Strings.Instance}}"
                                Command="{Binding TestRumbleCommand}"
                                Padding="12,6" HorizontalAlignment="Left"
                                Margin="0,0,0,12"/>

                        <!-- Live motor display -->
                        <TextBlock Text="{Binding Pad_MotorActivity, Source={x:Static strings:Strings.Instance}}" FontWeight="SemiBold" Margin="0,8,0,8"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{Binding Pad_LeftMotorLabel, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                            <ProgressBar Value="{Binding DeviceLeftMotorDisplay, Mode=OneWay}"
                                         Minimum="0" Maximum="1"
                                         Width="200" Height="16" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{Binding Pad_RightMotorLabel, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                            <ProgressBar Value="{Binding DeviceRightMotorDisplay, Mode=OneWay}"
                                         Minimum="0" Maximum="1"
                                         Width="200" Height="16" VerticalAlignment="Center"/>
                        </StackPanel>

                            </StackPanel>
                        </Border>

                        <!-- ── Constant Force section ── -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="&#xF0AD;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_ConstantForce_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <Button Command="{Binding ResetConstantForceCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetConstantForce, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Pad_ConstantForce_Description, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}" Margin="0,0,0,12"/>

                                <CheckBox Content="{Binding Pad_ConstantForce_Toggle, Source={x:Static strings:Strings.Instance}}"
                                          IsChecked="{Binding ConstantForceEnabled, Mode=TwoWay}"
                                          Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,8" IsEnabled="{Binding ConstantForceEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Interactive grid -->
                                    <Border x:Name="ConstantForcePadBorder" Grid.Column="0"
                                            BorderBrush="#FF3F3F46" BorderThickness="2" CornerRadius="2"
                                            Padding="4" Width="212" Height="212"
                                            Cursor="Cross"
                                            ClipToBounds="True"
                                            MouseLeftButtonDown="ConstantForcePad_MouseLeftButtonDown"
                                            MouseMove="ConstantForcePad_MouseMove"
                                            MouseLeftButtonUp="ConstantForcePad_MouseLeftButtonUp">
                                        <Grid Width="200" Height="200">
                                            <Ellipse Width="200" Height="200"
                                                     Fill="{DynamicResource ControlFillColorDefaultBrush}"/>
                                            <Line X1="50" Y1="0" X2="50" Y2="200" Stroke="#40FFFFFF" StrokeDashArray="2 4" StrokeThickness="0.5"/>
                                            <Line X1="150" Y1="0" X2="150" Y2="200" Stroke="#40FFFFFF" StrokeDashArray="2 4" StrokeThickness="0.5"/>
                                            <Line X1="0" Y1="50" X2="200" Y2="50" Stroke="#40FFFFFF" StrokeDashArray="2 4" StrokeThickness="0.5"/>
                                            <Line X1="0" Y1="150" X2="200" Y2="150" Stroke="#40FFFFFF" StrokeDashArray="2 4" StrokeThickness="0.5"/>
                                            <Line X1="100" Y1="0" X2="100" Y2="200" Stroke="#60FFFFFF" StrokeThickness="0.75"/>
                                            <Line X1="0" Y1="100" X2="200" Y2="100" Stroke="#60FFFFFF" StrokeThickness="0.75"/>
                                            <Canvas>
                                                <Ellipse Width="196" Height="196" Canvas.Left="2" Canvas.Top="2"
                                                         Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                         StrokeThickness="1.5" Fill="Transparent"/>
                                                <!-- Force vector line from center to handle (signed [-1..+1] → canvas, dot size 0 = use raw position) -->
                                                <Line Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="2"
                                                      X1="100" Y1="100"
                                                      X2="{Binding ConstantForceX, Converter={StaticResource SignedNormToCanvasConverter}, ConverterParameter='200,0'}"
                                                      Y2="{Binding ConstantForceY, Converter={StaticResource SignedNormToCanvasConverter}, ConverterParameter='200,0'}"/>
                                                <!-- Force handle dot -->
                                                <Ellipse Width="13" Height="13"
                                                         Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                                         Stroke="{DynamicResource AccentFillColorSecondaryBrush}" StrokeThickness="1.5"
                                                         Canvas.Left="{Binding ConstantForceX, Converter={StaticResource SignedNormToCanvasConverter}, ConverterParameter='200,13'}"
                                                         Canvas.Top="{Binding ConstantForceY, Converter={StaticResource SignedNormToCanvasConverter}, ConverterParameter='200,13'}"/>
                                            </Canvas>
                                        </Grid>
                                    </Border>

                                    <!-- Numeric readout + sliders -->
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Pad_ConstantForce_Position, Source={x:Static strings:Strings.Instance}}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,0,0,12"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Pad_ConstantForce_X, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                            <Slider Value="{Binding ConstantForceX, Mode=TwoWay}"
                                                    Minimum="-1" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                                                    Style="{StaticResource DzSlider}"/>
                                            <TextBox Text="{Binding ConstantForceX, Mode=TwoWay, StringFormat=F2, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource DzValueEdit}"/>
                                            <Button Command="{Binding ResetConstantForceXCommand}" Style="{StaticResource ResetButton}"
                                                    ToolTip="{Binding Pad_ResetConstantForceX, Source={x:Static strings:Strings.Instance}}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Pad_ConstantForce_Y, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                            <Slider Value="{Binding ConstantForceY, Mode=TwoWay}"
                                                    Minimum="-1" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                                                    Style="{StaticResource DzSlider}"/>
                                            <TextBox Text="{Binding ConstantForceY, Mode=TwoWay, StringFormat=F2, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource DzValueEdit}"/>
                                            <Button Command="{Binding ResetConstantForceYCommand}" Style="{StaticResource ResetButton}"
                                                    ToolTip="{Binding Pad_ResetConstantForceY, Source={x:Static strings:Strings.Instance}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ── Audio Bass Rumble section ── -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Settings_AudioRumble, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource CardTitle}"/>
                            <Button Command="{Binding ResetAudioRumbleAllCommand}" Style="{StaticResource ResetAllButton}"
                                    Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                    ToolTip="{Binding Pad_ResetAudioRumble, Source={x:Static strings:Strings.Instance}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Settings_AudioRumbleDesc, Source={x:Static strings:Strings.Instance}}"
                                   Style="{StaticResource CardDescription}" Margin="0,0,0,12"/>

                        <CheckBox Content="{Binding Settings_AudioRumble_Enable, Source={x:Static strings:Strings.Instance}}"
                                  IsChecked="{Binding AudioRumbleEnabled, Mode=TwoWay}"
                                  Margin="0,0,0,12"/>

                        <!-- Sensitivity -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" IsEnabled="{Binding AudioRumbleEnabled}">
                            <TextBlock Text="{Binding Settings_AudioRumble_Sensitivity, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                            <Slider Value="{Binding AudioRumbleSensitivity, Mode=TwoWay}"
                                    Style="{StaticResource DzSlider}"
                                    Minimum="1" Maximum="20" TickFrequency="0.1"/>
                            <TextBox Text="{Binding AudioRumbleSensitivity, Mode=TwoWay, StringFormat=F1, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource DzValueEdit}"/>
                            <Button Command="{Binding ResetAudioSensitivityCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetAudioSensitivity, Source={x:Static strings:Strings.Instance}}"/>
                        </StackPanel>

                        <!-- Bass Cutoff -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" IsEnabled="{Binding AudioRumbleEnabled}">
                            <TextBlock Text="{Binding Settings_AudioRumble_Cutoff, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                            <Slider Value="{Binding AudioRumbleCutoffHz, Mode=TwoWay}"
                                    Style="{StaticResource DzSlider}"
                                    Minimum="20" Maximum="200" TickFrequency="1"/>
                            <TextBox Text="{Binding AudioRumbleCutoffHz, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource DzValueEdit}"/>
                            <Button Command="{Binding ResetAudioCutoffCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetAudioCutoff, Source={x:Static strings:Strings.Instance}}"/>
                        </StackPanel>

                        <!-- Left Motor -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" IsEnabled="{Binding AudioRumbleEnabled}">
                            <TextBlock Text="{Binding Settings_AudioRumble_LeftMotor, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                            <Slider Value="{Binding AudioRumbleLeftMotor, Mode=TwoWay}"
                                    Style="{StaticResource DzSlider}"/>
                            <TextBox Text="{Binding AudioRumbleLeftMotor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource DzValueEdit}"/>
                            <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                            <Button Command="{Binding ResetAudioLeftMotorCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetAudioLeftMotor, Source={x:Static strings:Strings.Instance}}"/>
                        </StackPanel>

                        <!-- Right Motor -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" IsEnabled="{Binding AudioRumbleEnabled}">
                            <TextBlock Text="{Binding Settings_AudioRumble_RightMotor, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                            <Slider Value="{Binding AudioRumbleRightMotor, Mode=TwoWay}"
                                    Style="{StaticResource DzSlider}"/>
                            <TextBox Text="{Binding AudioRumbleRightMotor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource DzValueEdit}"/>
                            <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                            <Button Command="{Binding ResetAudioRightMotorCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetAudioRightMotor, Source={x:Static strings:Strings.Instance}}"/>
                        </StackPanel>

                        <!-- Level meter -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" IsEnabled="{Binding AudioRumbleEnabled}">
                            <TextBlock Text="{Binding Settings_AudioRumble_Level, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                            <ProgressBar Value="{Binding AudioRumbleLevelMeter, Mode=OneWay}"
                                         Minimum="0" Maximum="1"
                                         Width="200" Height="16" VerticalAlignment="Center"/>
                        </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════════════════════════
                 TAB 6: ADAPTIVE TRIGGERS
                 (visible only for DualSense / DualSense Edge slots)
                 ══════════════════════════════════════ -->
            <TabItem>
                <ScrollViewer Padding="24,0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Viewbox Width="24" Height="24" Stretch="Uniform"
                                     VerticalAlignment="Center" Margin="0,0,10,0">
                                <Grid Width="512" Height="512">
                                    <Path Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                          Data="{StaticResource ZackslyTriggerOuterBodyGeometry}"/>
                                    <Path Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                          Data="M445,180 L475,200 L445,220 L455,220 L485,200 L455,180 Z M445,280 L475,300 L445,320 L455,320 L485,300 L455,280 Z"/>
                                </Grid>
                            </Viewbox>
                            <TextBlock Text="{Binding Pad_AdaptiveTriggers_Header, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource TitleTextBlockStyle}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Pad_AdaptiveTriggers_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- Left Trigger -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <viewControls:LabeledShapeIcon Shape="TriggerLeft" Label="L2"
                                                                   Width="18" Height="18"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_LeftTrigger, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <Button Command="{Binding PlayStationConfig.ResetLeftTriggerCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetLeftTrigger, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <!-- Mode -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Pad_TriggerMode, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ComboBox Width="240" VerticalAlignment="Center"
                                              SelectedIndex="{Binding PlayStationConfig.LeftTriggerMode, Mode=TwoWay, Converter={StaticResource EnumIndexConverter}}">
                                        <ComboBoxItem Content="{Binding Pad_AT_Off, Source={x:Static strings:Strings.Instance}}"
                                                      ToolTip="{Binding Pad_AT_Off_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_AT_Feedback, Source={x:Static strings:Strings.Instance}}"
                                                      ToolTip="{Binding Pad_AT_Feedback_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_AT_Weapon, Source={x:Static strings:Strings.Instance}}"
                                                      ToolTip="{Binding Pad_AT_Weapon_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_AT_Vibration, Source={x:Static strings:Strings.Instance}}"
                                                      ToolTip="{Binding Pad_AT_Vibration_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_AT_MultiPosFeedback, Source={x:Static strings:Strings.Instance}}"
                                                      ToolTip="{Binding Pad_AT_MultiPosFeedback_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_AT_Slope, Source={x:Static strings:Strings.Instance}}"
                                                      ToolTip="{Binding Pad_AT_Slope_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_AT_MultiPosVibration, Source={x:Static strings:Strings.Instance}}"
                                                      ToolTip="{Binding Pad_AT_MultiPosVibration_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    </ComboBox>
                                    <Button Command="{Binding PlayStationConfig.ResetLeftTriggerCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetLeftTrigger, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <!-- Weapon-mode quick preset row. Indented 200 DIP to align
                                     with the Mode dropdown above. Visible only when the
                                     active mode is Weapon — the GameCube preset is a
                                     specific Weapon-parameter configuration that mimics the
                                     physical click feel of a real GameCube trigger. -->
                                <StackPanel Orientation="Horizontal" Margin="200,0,0,8"
                                            Visibility="{Binding PlayStationConfig.LeftTriggerMode, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=Weapon}">
                                    <Button Content="{Binding Pad_AT_LoadGameCubePreset, Source={x:Static strings:Strings.Instance}}"
                                            Command="{Binding PlayStationConfig.ApplyLeftGameCubePresetCommand}"
                                            ToolTip="{Binding Pad_AT_LoadGameCubePreset_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                            Padding="10,4"/>
                                </StackPanel>
                                <!-- Effect-profile preview: shows the resistance / vibration
                                     pattern across the trigger throw for the selected mode. -->
                                <viewControls:TriggerEffectGraph
                                    Mode="{Binding PlayStationConfig.LeftTriggerMode}"
                                    StartPosition="{Binding PlayStationConfig.LeftStartPosition}"
                                    EndPosition="{Binding PlayStationConfig.LeftEndPosition}"
                                    Strength="{Binding PlayStationConfig.LeftStrength}"
                                    Frequency="{Binding PlayStationConfig.LeftFrequency}"
                                    Height="72" Margin="0,0,0,12"/>
                                <!-- Range (start ↔ end) — dual-thumb -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Pad_AT_Range, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <controls:RangeSlider
                                        LowerValue="{Binding PlayStationConfig.LeftStartPosition, Mode=TwoWay}"
                                        UpperValue="{Binding PlayStationConfig.LeftEndPosition, Mode=TwoWay}"
                                        Minimum="0" Maximum="255"
                                        Width="200" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding PlayStationConfig.LeftStartPosition, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="—" VerticalAlignment="Center" Margin="2,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBox Text="{Binding PlayStationConfig.LeftEndPosition, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                    <Button Command="{Binding PlayStationConfig.ResetLeftRangeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetRange, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <!-- Strength -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Pad_AT_Strength, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding PlayStationConfig.LeftStrength, Mode=TwoWay}"
                                            Minimum="0" Maximum="255"
                                            Width="200" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding PlayStationConfig.LeftStrength, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                    <Button Command="{Binding PlayStationConfig.ResetLeftStrengthCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetStrength, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <!-- Frequency -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Pad_AT_Frequency, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding PlayStationConfig.LeftFrequency, Mode=TwoWay}"
                                            Minimum="0" Maximum="255" TickFrequency="16"
                                            Width="200" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding PlayStationConfig.LeftFrequency, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                    <Button Command="{Binding PlayStationConfig.ResetLeftFrequencyCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetFrequency, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Right Trigger -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <viewControls:LabeledShapeIcon Shape="TriggerRight" Label="R2"
                                                                   Width="18" Height="18"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_RightTrigger, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <Button Command="{Binding PlayStationConfig.ResetRightTriggerCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetRightTrigger, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <!-- Mode -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Pad_TriggerMode, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ComboBox Width="240" VerticalAlignment="Center"
                                              SelectedIndex="{Binding PlayStationConfig.RightTriggerMode, Mode=TwoWay, Converter={StaticResource EnumIndexConverter}}">
                                        <ComboBoxItem Content="{Binding Pad_AT_Off, Source={x:Static strings:Strings.Instance}}"
                                                      ToolTip="{Binding Pad_AT_Off_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_AT_Feedback, Source={x:Static strings:Strings.Instance}}"
                                                      ToolTip="{Binding Pad_AT_Feedback_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_AT_Weapon, Source={x:Static strings:Strings.Instance}}"
                                                      ToolTip="{Binding Pad_AT_Weapon_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_AT_Vibration, Source={x:Static strings:Strings.Instance}}"
                                                      ToolTip="{Binding Pad_AT_Vibration_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_AT_MultiPosFeedback, Source={x:Static strings:Strings.Instance}}"
                                                      ToolTip="{Binding Pad_AT_MultiPosFeedback_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_AT_Slope, Source={x:Static strings:Strings.Instance}}"
                                                      ToolTip="{Binding Pad_AT_Slope_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_AT_MultiPosVibration, Source={x:Static strings:Strings.Instance}}"
                                                      ToolTip="{Binding Pad_AT_MultiPosVibration_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    </ComboBox>
                                    <Button Command="{Binding PlayStationConfig.ResetRightTriggerCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetRightTrigger, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <!-- Weapon-mode quick preset row (right trigger). Mirrors
                                     the left-trigger layout above. -->
                                <StackPanel Orientation="Horizontal" Margin="200,0,0,8"
                                            Visibility="{Binding PlayStationConfig.RightTriggerMode, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=Weapon}">
                                    <Button Content="{Binding Pad_AT_LoadGameCubePreset, Source={x:Static strings:Strings.Instance}}"
                                            Command="{Binding PlayStationConfig.ApplyRightGameCubePresetCommand}"
                                            ToolTip="{Binding Pad_AT_LoadGameCubePreset_Tooltip, Source={x:Static strings:Strings.Instance}}"
                                            Padding="10,4"/>
                                </StackPanel>
                                <viewControls:TriggerEffectGraph
                                    Mode="{Binding PlayStationConfig.RightTriggerMode}"
                                    StartPosition="{Binding PlayStationConfig.RightStartPosition}"
                                    EndPosition="{Binding PlayStationConfig.RightEndPosition}"
                                    Strength="{Binding PlayStationConfig.RightStrength}"
                                    Frequency="{Binding PlayStationConfig.RightFrequency}"
                                    Height="72" Margin="0,0,0,12"/>
                                <!-- Range (start ↔ end) — dual-thumb -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Pad_AT_Range, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <controls:RangeSlider
                                        LowerValue="{Binding PlayStationConfig.RightStartPosition, Mode=TwoWay}"
                                        UpperValue="{Binding PlayStationConfig.RightEndPosition, Mode=TwoWay}"
                                        Minimum="0" Maximum="255"
                                        Width="200" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding PlayStationConfig.RightStartPosition, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="—" VerticalAlignment="Center" Margin="2,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBox Text="{Binding PlayStationConfig.RightEndPosition, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                    <Button Command="{Binding PlayStationConfig.ResetRightRangeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetRange, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <!-- Strength -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Pad_AT_Strength, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding PlayStationConfig.RightStrength, Mode=TwoWay}"
                                            Minimum="0" Maximum="255"
                                            Width="200" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding PlayStationConfig.RightStrength, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                    <Button Command="{Binding PlayStationConfig.ResetRightStrengthCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetStrength, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <!-- Frequency -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Pad_AT_Frequency, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding PlayStationConfig.RightFrequency, Mode=TwoWay}"
                                            Minimum="0" Maximum="255" TickFrequency="16"
                                            Width="200" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding PlayStationConfig.RightFrequency, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEdit}"/>
                                    <Button Command="{Binding PlayStationConfig.ResetRightFrequencyCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetFrequency, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════════════════════════
                 TAB 7: LIGHTING
                 (visible for DS4 / DualSense / DualSense Edge slots)
                 ══════════════════════════════════════ -->
            <TabItem>
                <ScrollViewer Padding="24,0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE781;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Pad_Lighting_Header, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource TitleTextBlockStyle}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Pad_Lighting_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- Unified lightbar mode picker. Replaces the
                             v3.0 BaseColor + AudioLightbar split. The
                             single-color RGB sub-block is shared by
                             Static / Breathing / AudioPulse. The audio
                             3-color bands are shared by Thresholds /
                             Gradient / CrossFade. Period drives the
                             time-based animations. Palette + Smooth
                             belong to ColorCycle; Decay + Randomize +
                             palette belong to InputReactive. -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_Lighting_BaseColor, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <Button Command="{Binding PlayStationConfig.ResetLightbarAllCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetLightbar, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Mode picker -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Pad_Lighting_Mode, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource DzLabel}"/>
                                    <!-- SelectedValue + Tag binding (rather than SelectedIndex
                                         + EnumIndexConverter): the LightbarMode enum has gaps
                                         (11..13 are legacy InputReactive values not exposed in
                                         this dropdown), so item index ≠ enum value. Tag-driven
                                         binding lets us reorder freely without breaking the
                                         enum mapping. Order is grouped by feel: simple time-
                                         based on a single color (Static/Breathing/Strobe),
                                         multi-color time-based (Rainbow/ColorCycle), battery
                                         indicator, then the audio-reactive cluster. -->
                                    <ComboBox SelectedValue="{Binding PlayStationConfig.LightbarMode, Mode=TwoWay}"
                                              SelectedValuePath="Tag"
                                              Width="540" VerticalAlignment="Center">
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_Off, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.Off}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_Static, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.Static}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_Breathing, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.Breathing}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_Strobe, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.Strobe}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_Rainbow, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.Rainbow}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_ColorCycle, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.ColorCycle}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_Battery, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.Battery}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_AudioPulse, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.AudioPulse}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_AudioPulseRandom, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.AudioPulseRandom}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_AudioPulseRainbow, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.AudioPulseRainbow}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_AudioThresholds, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.AudioThresholds}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_AudioGradient, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.AudioGradient}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_Mode_AudioCrossFade, Source={x:Static strings:Strings.Instance}}" Tag="{x:Static vm:LightbarMode.AudioCrossFade}"/>
                                    </ComboBox>
                                    <Button Command="{Binding PlayStationConfig.ResetLightbarModeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetLightbarMode, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- LightbarMode-dependent controls live directly under
                                     the mode dropdown so the user reads "I picked Mode X
                                     → here are X's settings" without the InputReactive
                                     dropdown breaking the visual flow. The InputReactive
                                     dropdown + its dependent Hold/Decay/Fixed-color block
                                     moves to the bottom of the card; palette stays in
                                     the middle since it's shared between ColorCycle (base
                                     mode) and InputReactive Cycle (overlay). -->

                                <!-- Period: Breathing / Rainbow / ColorCycle / AudioPulseRainbow / Strobe -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                            Visibility="{Binding PlayStationConfig.LightbarMode, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=Breathing|Rainbow|ColorCycle|AudioPulseRainbow|Strobe}">
                                    <TextBlock Text="{Binding Pad_Lighting_Period, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding PlayStationConfig.LightbarPeriodMs, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"
                                            Minimum="250" Maximum="10000" TickFrequency="250"/>
                                    <TextBox Text="{Binding PlayStationConfig.LightbarPeriodMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <Button Command="{Binding PlayStationConfig.ResetLightbarPeriodCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetLightbarPeriod, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Brightness: Rainbow only (no per-color picker so the
                                     user has no other way to dim the effect). -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                            Visibility="{Binding PlayStationConfig.LightbarMode, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=Rainbow}">
                                    <TextBlock Text="{Binding Pad_Lighting_RainbowBrightness, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding PlayStationConfig.LightbarRainbowBrightness, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"
                                            Minimum="0" Maximum="100" TickFrequency="1"/>
                                    <TextBox Text="{Binding PlayStationConfig.LightbarRainbowBrightness, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                    <Button Command="{Binding PlayStationConfig.ResetLightbarRainbowBrightnessCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetLightbarRainbowBrightness, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Smooth toggle (ColorCycle): blend or hop between palette colors -->
                                <CheckBox IsChecked="{Binding PlayStationConfig.LightbarColorCycleSmooth, Mode=TwoWay}"
                                          Content="{Binding Pad_Lighting_ColorCycleSmooth, Source={x:Static strings:Strings.Instance}}"
                                          Margin="0,0,0,8"
                                          Visibility="{Binding PlayStationConfig.LightbarMode, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=ColorCycle}"/>

                                <!-- Palette (variable count) — Base instance.
                                     Visible only when LightbarMode = ColorCycle so the
                                     palette sits directly below the dropdown that
                                     reveals it. The InputReactive Cycle overlay has
                                     its own palette instance below the InputReactive
                                     dropdown (same data, different position) so the
                                     editor doesn't appear above the dropdown that
                                     summoned it. ShowPaletteForBase / ShowPaletteForOverlay
                                     are mutually exclusive — palette renders exactly
                                     once at any time. -->
                                <StackPanel Visibility="{Binding PlayStationConfig.ShowPaletteForBase, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Pad_Lighting_PaletteHeader, Source={x:Static strings:Strings.Instance}}"
                                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding PlayStationConfig.LightbarPalette}" Margin="0,0,0,8">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:LightbarPaletteEntry}">
                                                <Border BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,8,8"
                                                        BorderBrush="{DynamicResource TextFillColorDisabledBrush}">
                                                    <StackPanel>
                                                        <Button Command="{Binding DataContext.PlayStationConfig.RemovePaletteColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                HorizontalAlignment="Right" Margin="0,0,0,4"
                                                                Padding="4,0" MinWidth="24"
                                                                ToolTip="{Binding Pad_Lighting_RemoveColor, Source={x:Static strings:Strings.Instance}}">
                                                            <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                                        </Button>
                                                        <views:ColorPickerControl HorizontalAlignment="Left" Margin="0,0,0,8"
                                                            Red="{Binding R, Mode=TwoWay}"
                                                            Green="{Binding G, Mode=TwoWay}"
                                                            Blue="{Binding B, Mode=TwoWay}"/>
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Width="36" Height="28" CornerRadius="4"
                                                                    BorderBrush="{DynamicResource TextFillColorDisabledBrush}" BorderThickness="1">
                                                                <Border.Background>
                                                                    <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                                                        <Binding Path="R"/>
                                                                        <Binding Path="G"/>
                                                                        <Binding Path="B"/>
                                                                    </MultiBinding>
                                                                </Border.Background>
                                                            </Border>
                                                            <TextBox Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                     FontFamily="Consolas" Padding="6,2"
                                                                     Text="{Binding Hex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                     ToolTip="{Binding Pad_Lighting_HexTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                        </Grid>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="R" Style="{StaticResource DzLabelTight}" Foreground="#FFD32F2F"/>
                                                            <Slider Value="{Binding R, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                            <TextBox Text="{Binding R, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="G" Style="{StaticResource DzLabelTight}" Foreground="#FF388E3C"/>
                                                            <Slider Value="{Binding G, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                            <TextBox Text="{Binding G, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="B" Style="{StaticResource DzLabelTight}" Foreground="#FF1976D2"/>
                                                            <Slider Value="{Binding B, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                            <TextBox Text="{Binding B, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Command="{Binding PlayStationConfig.AddPaletteColorCommand}"
                                                Padding="10,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Pad_Lighting_AddColor, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding PlayStationConfig.ResetPaletteCommand}"
                                                Margin="8,0,0,0" Padding="10,4"
                                                ToolTip="{Binding Pad_Lighting_ResetPaletteTooltip, Source={x:Static strings:Strings.Instance}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Pad_Lighting_ResetPalette, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Audio sensitivity: every Audio* mode -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                            Visibility="{Binding PlayStationConfig.LightbarMode, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=AudioPulse|AudioPulseRandom|AudioPulseRainbow|AudioThresholds|AudioGradient|AudioCrossFade}">
                                    <TextBlock Text="{Binding Pad_Lighting_AudioLightbar_Sensitivity, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding PlayStationConfig.AudioLightbarSensitivity, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"
                                            Minimum="1" Maximum="20" TickFrequency="0.1"/>
                                    <TextBox Text="{Binding PlayStationConfig.AudioLightbarSensitivity, Mode=TwoWay, StringFormat=F1, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <Button Command="{Binding PlayStationConfig.ResetAudioLightbarSensitivityCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetAudioLightbarSensitivity, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Audio band thresholds (settings) — moved out of the audio
                                     bands wrapper below so settings stay above colours. -->
                                <StackPanel Visibility="{Binding PlayStationConfig.LightbarMode, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=AudioThresholds|AudioGradient|AudioCrossFade}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Pad_Lighting_AudioLightbar_LowToMid, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <Slider Value="{Binding PlayStationConfig.AudioLowToMidPercent, Mode=TwoWay}"
                                                Style="{StaticResource DzSlider}"
                                                Minimum="0" Maximum="100" TickFrequency="1"/>
                                        <TextBox Text="{Binding PlayStationConfig.AudioLowToMidPercent, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                        <Button Command="{Binding PlayStationConfig.ResetAudioLowToMidPercentCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetAudioLowToMidPercent, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Pad_Lighting_AudioLightbar_MidToHigh, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <Slider Value="{Binding PlayStationConfig.AudioMidToHighPercent, Mode=TwoWay}"
                                                Style="{StaticResource DzSlider}"
                                                Minimum="0" Maximum="100" TickFrequency="1"/>
                                        <TextBox Text="{Binding PlayStationConfig.AudioMidToHighPercent, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                        <Button Command="{Binding PlayStationConfig.ResetAudioMidToHighPercentCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetAudioMidToHighPercent, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Crossfade width (setting) — only meaningful in CrossFade mode -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                            Visibility="{Binding PlayStationConfig.LightbarMode, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=AudioCrossFade}">
                                    <TextBlock Text="{Binding Pad_Lighting_AudioLightbar_CrossFadeWidth, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding PlayStationConfig.AudioCrossFadePercent, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"
                                            Minimum="0" Maximum="50" TickFrequency="0.5"/>
                                    <TextBox Text="{Binding PlayStationConfig.AudioCrossFadePercent, Mode=TwoWay, StringFormat=F1, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                    <Button Command="{Binding PlayStationConfig.ResetAudioCrossFadePercentCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetAudioCrossFadePercent, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Single colour: Static / Breathing / AudioPulse / Strobe base modes.
                                     Strobe square-waves between the configured RGB and
                                     black at LightbarPeriodMs cadence, so it uses the
                                     same base color as the static / breathing modes.
                                     The Input Reactive Fixed overlay has its own color
                                     picker below so users can pick a separate flash
                                     color independent of the base. -->
                                <Border BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        BorderBrush="{DynamicResource TextFillColorDisabledBrush}"
                                        Visibility="{Binding PlayStationConfig.LightbarMode, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=Static|Breathing|AudioPulse|Strobe}">
                                    <StackPanel>
                                        <views:ColorPickerControl Margin="0,0,0,12"
                                            HorizontalAlignment="Left"
                                            Red="{Binding PlayStationConfig.LightbarRed, Mode=TwoWay}"
                                            Green="{Binding PlayStationConfig.LightbarGreen, Mode=TwoWay}"
                                            Blue="{Binding PlayStationConfig.LightbarBlue, Mode=TwoWay}"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="48" Height="36" CornerRadius="4"
                                                    HorizontalAlignment="Left"
                                                    BorderBrush="{DynamicResource TextFillColorDisabledBrush}" BorderThickness="1">
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                                        <Binding Path="PlayStationConfig.LightbarRed" />
                                                        <Binding Path="PlayStationConfig.LightbarGreen" />
                                                        <Binding Path="PlayStationConfig.LightbarBlue" />
                                                    </MultiBinding>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Pad_Lighting_Hex, Source={x:Static strings:Strings.Instance}}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            <TextBox x:Name="LightbarHexBox" Grid.Column="2" Width="100"
                                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                                     FontFamily="Consolas" Padding="6,4"
                                                     KeyDown="LightbarHexBox_KeyDown"
                                                     LostFocus="LightbarHexBox_LostFocus"
                                                     ToolTip="{Binding Pad_Lighting_HexTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="R" Style="{StaticResource DzLabelTight}" Foreground="#FFD32F2F"/>
                                            <Slider Value="{Binding PlayStationConfig.LightbarRed, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                            <TextBox Text="{Binding PlayStationConfig.LightbarRed, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                            <Button Command="{Binding PlayStationConfig.ResetLightbarRedCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarRed, Source={x:Static strings:Strings.Instance}}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="G" Style="{StaticResource DzLabelTight}" Foreground="#FF388E3C"/>
                                            <Slider Value="{Binding PlayStationConfig.LightbarGreen, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                            <TextBox Text="{Binding PlayStationConfig.LightbarGreen, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                            <Button Command="{Binding PlayStationConfig.ResetLightbarGreenCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarGreen, Source={x:Static strings:Strings.Instance}}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="B" Style="{StaticResource DzLabelTight}" Foreground="#FF1976D2"/>
                                            <Slider Value="{Binding PlayStationConfig.LightbarBlue, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                            <TextBox Text="{Binding PlayStationConfig.LightbarBlue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                            <Button Command="{Binding PlayStationConfig.ResetLightbarBlueCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarBlue, Source={x:Static strings:Strings.Instance}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Battery mode: Low / Full color pair. Lightbar lerps
                                     from Low (0%) to Full (100%) based on the live
                                     battery percent reported by the controller. Two
                                     side-by-side cards mirror the audio-bands layout
                                     so a user familiar with that pattern immediately
                                     understands the picker. Per-channel ResetButtonTight
                                     next to each R/G/B slider matches the Static base
                                     and audio-band pickers (no standalone "reset all
                                     three" button — there's no precedent for one). -->
                                <StackPanel Visibility="{Binding PlayStationConfig.LightbarMode, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=Battery}">
                                    <Grid Margin="0,4,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- LOW (empty) color -->
                                        <Border Grid.Column="0" BorderThickness="1" CornerRadius="4" Padding="10"
                                                BorderBrush="{DynamicResource TextFillColorDisabledBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Pad_Lighting_BatteryLowColor, Source={x:Static strings:Strings.Instance}}"
                                                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                <views:ColorPickerControl Margin="0,0,0,8"
                                                    HorizontalAlignment="Left"
                                                    Red="{Binding PlayStationConfig.LightbarBatteryLowR, Mode=TwoWay}"
                                                    Green="{Binding PlayStationConfig.LightbarBatteryLowG, Mode=TwoWay}"
                                                    Blue="{Binding PlayStationConfig.LightbarBatteryLowB, Mode=TwoWay}"/>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="36" Height="28" CornerRadius="4"
                                                            BorderBrush="{DynamicResource TextFillColorDisabledBrush}" BorderThickness="1">
                                                        <Border.Background>
                                                            <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                                                <Binding Path="PlayStationConfig.LightbarBatteryLowR" />
                                                                <Binding Path="PlayStationConfig.LightbarBatteryLowG" />
                                                                <Binding Path="PlayStationConfig.LightbarBatteryLowB" />
                                                            </MultiBinding>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="R" Style="{StaticResource DzLabelTight}" Foreground="#FFD32F2F"/>
                                                    <Slider Value="{Binding PlayStationConfig.LightbarBatteryLowR, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding PlayStationConfig.LightbarBatteryLowR, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <Button Command="{Binding PlayStationConfig.ResetLightbarBatteryLowRCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarRed, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="G" Style="{StaticResource DzLabelTight}" Foreground="#FF388E3C"/>
                                                    <Slider Value="{Binding PlayStationConfig.LightbarBatteryLowG, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding PlayStationConfig.LightbarBatteryLowG, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <Button Command="{Binding PlayStationConfig.ResetLightbarBatteryLowGCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarGreen, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="B" Style="{StaticResource DzLabelTight}" Foreground="#FF1976D2"/>
                                                    <Slider Value="{Binding PlayStationConfig.LightbarBatteryLowB, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding PlayStationConfig.LightbarBatteryLowB, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <Button Command="{Binding PlayStationConfig.ResetLightbarBatteryLowBCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarBlue, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- HIGH (full) color -->
                                        <Border Grid.Column="2" BorderThickness="1" CornerRadius="4" Padding="10"
                                                BorderBrush="{DynamicResource TextFillColorDisabledBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Pad_Lighting_BatteryHighColor, Source={x:Static strings:Strings.Instance}}"
                                                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                <views:ColorPickerControl Margin="0,0,0,8"
                                                    HorizontalAlignment="Left"
                                                    Red="{Binding PlayStationConfig.LightbarBatteryHighR, Mode=TwoWay}"
                                                    Green="{Binding PlayStationConfig.LightbarBatteryHighG, Mode=TwoWay}"
                                                    Blue="{Binding PlayStationConfig.LightbarBatteryHighB, Mode=TwoWay}"/>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="36" Height="28" CornerRadius="4"
                                                            BorderBrush="{DynamicResource TextFillColorDisabledBrush}" BorderThickness="1">
                                                        <Border.Background>
                                                            <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                                                <Binding Path="PlayStationConfig.LightbarBatteryHighR" />
                                                                <Binding Path="PlayStationConfig.LightbarBatteryHighG" />
                                                                <Binding Path="PlayStationConfig.LightbarBatteryHighB" />
                                                            </MultiBinding>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="R" Style="{StaticResource DzLabelTight}" Foreground="#FFD32F2F"/>
                                                    <Slider Value="{Binding PlayStationConfig.LightbarBatteryHighR, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding PlayStationConfig.LightbarBatteryHighR, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <Button Command="{Binding PlayStationConfig.ResetLightbarBatteryHighRCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarRed, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="G" Style="{StaticResource DzLabelTight}" Foreground="#FF388E3C"/>
                                                    <Slider Value="{Binding PlayStationConfig.LightbarBatteryHighG, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding PlayStationConfig.LightbarBatteryHighG, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <Button Command="{Binding PlayStationConfig.ResetLightbarBatteryHighGCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarGreen, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="B" Style="{StaticResource DzLabelTight}" Foreground="#FF1976D2"/>
                                                    <Slider Value="{Binding PlayStationConfig.LightbarBatteryHighB, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding PlayStationConfig.LightbarBatteryHighB, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <Button Command="{Binding PlayStationConfig.ResetLightbarBatteryHighBCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarBlue, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>

                                <!-- Audio bands: 3 colors with thresholds, only visible
                                     when LightbarMode is AudioThresholds, AudioGradient,
                                     or AudioCrossFade. Lives inside the consolidated
                                     Lightbar border so the user has a single place
                                     to configure every effect mode. -->
                                <StackPanel Visibility="{Binding PlayStationConfig.LightbarMode, Converter={StaticResource EnumEqualityVisibilityConverter}, ConverterParameter=AudioThresholds|AudioGradient|AudioCrossFade}">
                                    <Grid Margin="0,4,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- LOW (quiet) color -->
                                        <Border Grid.Column="0" BorderThickness="1" CornerRadius="4" Padding="10"
                                                BorderBrush="{DynamicResource TextFillColorDisabledBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Pad_Lighting_AudioLightbar_LowColor, Source={x:Static strings:Strings.Instance}}"
                                                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                <views:ColorPickerControl Margin="0,0,0,8"
                                                    HorizontalAlignment="Left"
                                                    Red="{Binding PlayStationConfig.AudioLowR, Mode=TwoWay}"
                                                    Green="{Binding PlayStationConfig.AudioLowG, Mode=TwoWay}"
                                                    Blue="{Binding PlayStationConfig.AudioLowB, Mode=TwoWay}"/>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="36" Height="28" CornerRadius="4"
                                                            BorderBrush="{DynamicResource TextFillColorDisabledBrush}" BorderThickness="1">
                                                        <Border.Background>
                                                            <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                                                <Binding Path="PlayStationConfig.AudioLowR" />
                                                                <Binding Path="PlayStationConfig.AudioLowG" />
                                                                <Binding Path="PlayStationConfig.AudioLowB" />
                                                            </MultiBinding>
                                                        </Border.Background>
                                                    </Border>
                                                    <TextBox x:Name="AudioLowHexBox" Grid.Column="1" Tag="Low"
                                                             Margin="6,0,0,0" VerticalAlignment="Center"
                                                             FontFamily="Consolas" Padding="6,2"
                                                             KeyDown="AudioHexBox_KeyDown"
                                                             LostFocus="AudioHexBox_LostFocus"
                                                             ToolTip="{Binding Pad_Lighting_HexTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="R" Style="{StaticResource DzLabelTight}" Foreground="#FFD32F2F"/>
                                                    <Slider Value="{Binding PlayStationConfig.AudioLowR, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding PlayStationConfig.AudioLowR, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <Button Command="{Binding PlayStationConfig.ResetAudioLowRCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetAudioLowR, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="G" Style="{StaticResource DzLabelTight}" Foreground="#FF388E3C"/>
                                                    <Slider Value="{Binding PlayStationConfig.AudioLowG, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding PlayStationConfig.AudioLowG, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <Button Command="{Binding PlayStationConfig.ResetAudioLowGCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetAudioLowG, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="B" Style="{StaticResource DzLabelTight}" Foreground="#FF1976D2"/>
                                                    <Slider Value="{Binding PlayStationConfig.AudioLowB, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding PlayStationConfig.AudioLowB, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <Button Command="{Binding PlayStationConfig.ResetAudioLowBCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetAudioLowB, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- MID (medium) color -->
                                        <Border Grid.Column="2" BorderThickness="1" CornerRadius="4" Padding="10"
                                                BorderBrush="{DynamicResource TextFillColorDisabledBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Pad_Lighting_AudioLightbar_MidColor, Source={x:Static strings:Strings.Instance}}"
                                                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                <views:ColorPickerControl Margin="0,0,0,8"
                                                    HorizontalAlignment="Left"
                                                    Red="{Binding PlayStationConfig.AudioMidR, Mode=TwoWay}"
                                                    Green="{Binding PlayStationConfig.AudioMidG, Mode=TwoWay}"
                                                    Blue="{Binding PlayStationConfig.AudioMidB, Mode=TwoWay}"/>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="36" Height="28" CornerRadius="4"
                                                            BorderBrush="{DynamicResource TextFillColorDisabledBrush}" BorderThickness="1">
                                                        <Border.Background>
                                                            <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                                                <Binding Path="PlayStationConfig.AudioMidR" />
                                                                <Binding Path="PlayStationConfig.AudioMidG" />
                                                                <Binding Path="PlayStationConfig.AudioMidB" />
                                                            </MultiBinding>
                                                        </Border.Background>
                                                    </Border>
                                                    <TextBox x:Name="AudioMidHexBox" Grid.Column="1" Tag="Mid"
                                                             Margin="6,0,0,0" VerticalAlignment="Center"
                                                             FontFamily="Consolas" Padding="6,2"
                                                             KeyDown="AudioHexBox_KeyDown"
                                                             LostFocus="AudioHexBox_LostFocus"
                                                             ToolTip="{Binding Pad_Lighting_HexTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="R" Style="{StaticResource DzLabelTight}" Foreground="#FFD32F2F"/>
                                                    <Slider Value="{Binding PlayStationConfig.AudioMidR, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding PlayStationConfig.AudioMidR, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <Button Command="{Binding PlayStationConfig.ResetAudioMidRCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetAudioMidR, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="G" Style="{StaticResource DzLabelTight}" Foreground="#FF388E3C"/>
                                                    <Slider Value="{Binding PlayStationConfig.AudioMidG, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding PlayStationConfig.AudioMidG, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <Button Command="{Binding PlayStationConfig.ResetAudioMidGCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetAudioMidG, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="B" Style="{StaticResource DzLabelTight}" Foreground="#FF1976D2"/>
                                                    <Slider Value="{Binding PlayStationConfig.AudioMidB, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding PlayStationConfig.AudioMidB, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <Button Command="{Binding PlayStationConfig.ResetAudioMidBCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetAudioMidB, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- HIGH (loud) color -->
                                        <Border Grid.Column="4" BorderThickness="1" CornerRadius="4" Padding="10"
                                                BorderBrush="{DynamicResource TextFillColorDisabledBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Pad_Lighting_AudioLightbar_HighColor, Source={x:Static strings:Strings.Instance}}"
                                                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                <views:ColorPickerControl Margin="0,0,0,8"
                                                    HorizontalAlignment="Left"
                                                    Red="{Binding PlayStationConfig.AudioHighR, Mode=TwoWay}"
                                                    Green="{Binding PlayStationConfig.AudioHighG, Mode=TwoWay}"
                                                    Blue="{Binding PlayStationConfig.AudioHighB, Mode=TwoWay}"/>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="36" Height="28" CornerRadius="4"
                                                            BorderBrush="{DynamicResource TextFillColorDisabledBrush}" BorderThickness="1">
                                                        <Border.Background>
                                                            <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                                                <Binding Path="PlayStationConfig.AudioHighR" />
                                                                <Binding Path="PlayStationConfig.AudioHighG" />
                                                                <Binding Path="PlayStationConfig.AudioHighB" />
                                                            </MultiBinding>
                                                        </Border.Background>
                                                    </Border>
                                                    <TextBox x:Name="AudioHighHexBox" Grid.Column="1" Tag="High"
                                                             Margin="6,0,0,0" VerticalAlignment="Center"
                                                             FontFamily="Consolas" Padding="6,2"
                                                             KeyDown="AudioHexBox_KeyDown"
                                                             LostFocus="AudioHexBox_LostFocus"
                                                             ToolTip="{Binding Pad_Lighting_HexTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="R" Style="{StaticResource DzLabelTight}" Foreground="#FFD32F2F"/>
                                                    <Slider Value="{Binding PlayStationConfig.AudioHighR, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding PlayStationConfig.AudioHighR, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <Button Command="{Binding PlayStationConfig.ResetAudioHighRCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetAudioHighR, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="G" Style="{StaticResource DzLabelTight}" Foreground="#FF388E3C"/>
                                                    <Slider Value="{Binding PlayStationConfig.AudioHighG, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding PlayStationConfig.AudioHighG, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <Button Command="{Binding PlayStationConfig.ResetAudioHighGCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetAudioHighG, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="B" Style="{StaticResource DzLabelTight}" Foreground="#FF1976D2"/>
                                                    <Slider Value="{Binding PlayStationConfig.AudioHighB, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                    <TextBox Text="{Binding PlayStationConfig.AudioHighB, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                    <Button Command="{Binding PlayStationConfig.ResetAudioHighBCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetAudioHighB, Source={x:Static strings:Strings.Instance}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                </StackPanel>

                                <!-- Input Reactive overlay (v3.2+). Layered on top of the
                                     base mode above: a button-press flashes the chosen
                                     reactive color and decays back to the base. Off keeps
                                     the base mode untouched. Random rolls a hue per press,
                                     Cycle steps through the palette, Fixed flashes the
                                     base RGB color. Placed at the bottom of the lightbar
                                     card so the LightbarMode dropdown's mode-specific
                                     settings sit immediately under it without the
                                     InputReactive controls breaking up the visual flow. -->
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,12">
                                    <TextBlock Text="{Binding Pad_Lighting_InputReactive, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource DzLabel}"/>
                                    <ComboBox SelectedIndex="{Binding PlayStationConfig.InputReactiveMode, Mode=TwoWay, Converter={StaticResource EnumIndexConverter}}"
                                              Width="320" VerticalAlignment="Center">
                                        <ComboBoxItem Content="{Binding Pad_Lighting_InputReactive_Off, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_InputReactive_Random, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_InputReactive_Cycle, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_InputReactive_Fixed, Source={x:Static strings:Strings.Instance}}"/>
                                    </ComboBox>
                                    <Button Command="{Binding PlayStationConfig.ResetInputReactiveModeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetInputReactive, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- InputReactive controls. Hold + Decay sliders show whenever
                                     the input-reactive overlay is enabled in any variant —
                                     Random / Cycle / Fixed. Hold may be 0 for instant fade;
                                     Decay may be 0 for clean on/off with no fade. Placed
                                     before the Fixed color picker so the timing controls
                                     (which apply to every variant) read ahead of the
                                     variant-specific color block. -->
                                <StackPanel Visibility="{Binding PlayStationConfig.IsInputReactiveActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Pad_Lighting_InputHold, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <Slider Value="{Binding PlayStationConfig.LightbarInputHoldMs, Mode=TwoWay}"
                                                Style="{StaticResource DzSlider}"
                                                Minimum="0" Maximum="5000" TickFrequency="50"/>
                                        <TextBox Text="{Binding PlayStationConfig.LightbarInputHoldMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource DzValueEdit}"/>
                                        <Button Command="{Binding PlayStationConfig.ResetLightbarInputHoldCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetLightbarInputHold, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Pad_Lighting_InputDecay, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <Slider Value="{Binding PlayStationConfig.LightbarInputDecayMs, Mode=TwoWay}"
                                                Style="{StaticResource DzSlider}"
                                                Minimum="0" Maximum="5000" TickFrequency="50"/>
                                        <TextBox Text="{Binding PlayStationConfig.LightbarInputDecayMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource DzValueEdit}"/>
                                        <Button Command="{Binding PlayStationConfig.ResetLightbarInputDecayCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetLightbarInputDecay, Source={x:Static strings:Strings.Instance}}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Palette (variable count) — Overlay instance.
                                     Visible only when InputReactive = Cycle AND
                                     LightbarMode != ColorCycle (so this never co-renders
                                     with the Base palette instance above). Same data,
                                     placed here so the palette sits directly below the
                                     InputReactive dropdown that revealed it. -->
                                <StackPanel Visibility="{Binding PlayStationConfig.ShowPaletteForOverlay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Pad_Lighting_PaletteHeader, Source={x:Static strings:Strings.Instance}}"
                                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding PlayStationConfig.LightbarPalette}" Margin="0,0,0,8">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:LightbarPaletteEntry}">
                                                <Border BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,8,8"
                                                        BorderBrush="{DynamicResource TextFillColorDisabledBrush}">
                                                    <StackPanel>
                                                        <Button Command="{Binding DataContext.PlayStationConfig.RemovePaletteColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                HorizontalAlignment="Right" Margin="0,0,0,4"
                                                                Padding="4,0" MinWidth="24"
                                                                ToolTip="{Binding Pad_Lighting_RemoveColor, Source={x:Static strings:Strings.Instance}}">
                                                            <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                                        </Button>
                                                        <views:ColorPickerControl HorizontalAlignment="Left" Margin="0,0,0,8"
                                                            Red="{Binding R, Mode=TwoWay}"
                                                            Green="{Binding G, Mode=TwoWay}"
                                                            Blue="{Binding B, Mode=TwoWay}"/>
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Width="36" Height="28" CornerRadius="4"
                                                                    BorderBrush="{DynamicResource TextFillColorDisabledBrush}" BorderThickness="1">
                                                                <Border.Background>
                                                                    <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                                                        <Binding Path="R"/>
                                                                        <Binding Path="G"/>
                                                                        <Binding Path="B"/>
                                                                    </MultiBinding>
                                                                </Border.Background>
                                                            </Border>
                                                            <TextBox Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                     FontFamily="Consolas" Padding="6,2"
                                                                     Text="{Binding Hex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                     ToolTip="{Binding Pad_Lighting_HexTooltip, Source={x:Static strings:Strings.Instance}}"/>
                                                        </Grid>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="R" Style="{StaticResource DzLabelTight}" Foreground="#FFD32F2F"/>
                                                            <Slider Value="{Binding R, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                            <TextBox Text="{Binding R, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="G" Style="{StaticResource DzLabelTight}" Foreground="#FF388E3C"/>
                                                            <Slider Value="{Binding G, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                            <TextBox Text="{Binding G, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="B" Style="{StaticResource DzLabelTight}" Foreground="#FF1976D2"/>
                                                            <Slider Value="{Binding B, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                                            <TextBox Text="{Binding B, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Command="{Binding PlayStationConfig.AddPaletteColorCommand}"
                                                Padding="10,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Pad_Lighting_AddColor, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding PlayStationConfig.ResetPaletteCommand}"
                                                Margin="8,0,0,0" Padding="10,4"
                                                ToolTip="{Binding Pad_Lighting_ResetPaletteTooltip, Source={x:Static strings:Strings.Instance}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Pad_Lighting_ResetPalette, Source={x:Static strings:Strings.Instance}}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Per-press flash color for the Fixed overlay variant.
                                     Independent of LightbarRed/Green/Blue (which drives
                                     the base mode color), so users can layer a base
                                     color with a different flash color. -->
                                <Border BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        BorderBrush="{DynamicResource TextFillColorDisabledBrush}"
                                        Visibility="{Binding PlayStationConfig.IsInputReactiveFixed, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Pad_Lighting_InputReactive_FixedColor, Source={x:Static strings:Strings.Instance}}"
                                                   FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <views:ColorPickerControl Margin="0,0,0,12"
                                            HorizontalAlignment="Left"
                                            Red="{Binding PlayStationConfig.InputReactiveR, Mode=TwoWay}"
                                            Green="{Binding PlayStationConfig.InputReactiveG, Mode=TwoWay}"
                                            Blue="{Binding PlayStationConfig.InputReactiveB, Mode=TwoWay}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="R" Style="{StaticResource DzLabelTight}" Foreground="#FFD32F2F"/>
                                            <Slider Value="{Binding PlayStationConfig.InputReactiveR, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                            <TextBox Text="{Binding PlayStationConfig.InputReactiveR, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                            <Button Command="{Binding PlayStationConfig.ResetInputReactiveRCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarRed, Source={x:Static strings:Strings.Instance}}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="G" Style="{StaticResource DzLabelTight}" Foreground="#FF388E3C"/>
                                            <Slider Value="{Binding PlayStationConfig.InputReactiveG, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                            <TextBox Text="{Binding PlayStationConfig.InputReactiveG, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                            <Button Command="{Binding PlayStationConfig.ResetInputReactiveGCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarGreen, Source={x:Static strings:Strings.Instance}}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="B" Style="{StaticResource DzLabelTight}" Foreground="#FF1976D2"/>
                                            <Slider Value="{Binding PlayStationConfig.InputReactiveB, Mode=TwoWay}" Style="{StaticResource DzRgbSlider}"/>
                                            <TextBox Text="{Binding PlayStationConfig.InputReactiveB, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DzValueEditTight}"/>
                                            <Button Command="{Binding PlayStationConfig.ResetInputReactiveBCommand}" Style="{StaticResource ResetButtonTight}" ToolTip="{Binding Pad_ResetLightbarBlue, Source={x:Static strings:Strings.Instance}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Indicator LEDs — player number row + mic mute LED.
                             Grouped under one section because they share the
                             firmware's single brightness register (byte 42).
                             OpenRGB shows brightness as a property of every
                             mode (Direct / Mic Off / Mic Pulse) for the same
                             reason — there's only one register on the device.
                             DualSense / DualSense Edge only — DS4 has neither
                             player LEDs nor a mic LED, so the card is hidden
                             on DS4 slots via SyncTabVisibility. -->
                        <Border x:Name="IndicatorLedsCard" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="&#xEF31;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_Lighting_IndicatorLeds, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <Button Command="{Binding PlayStationConfig.ResetIndicatorLedsAllCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetIndicatorLeds, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Pad_Lighting_IndicatorLeds_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}" Margin="0,0,0,12"/>

                                <!-- Shared brightness — physically writes byte 42
                                     ledBrightness, which the DS5 firmware uses
                                     for the player LED row. Mute LED has only
                                     mode (Off / Solid / Pulse) — no register. -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Pad_Lighting_LedBrightness, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ComboBox SelectedIndex="{Binding PlayStationConfig.PlayerLedBrightness, Mode=TwoWay, Converter={StaticResource EnumIndexConverter}}"
                                              Width="140" VerticalAlignment="Center">
                                        <ComboBoxItem Content="{Binding Pad_Lighting_PlayerLed_Brightness_High, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_PlayerLed_Brightness_Medium, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_PlayerLed_Brightness_Low, Source={x:Static strings:Strings.Instance}}"/>
                                    </ComboBox>
                                    <Button Command="{Binding PlayStationConfig.ResetPlayerLedBrightnessCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetLedBrightness, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Player pattern -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Pad_Lighting_PlayerPattern, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ComboBox SelectedIndex="{Binding PlayStationConfig.PlayerLedMode, Mode=TwoWay, Converter={StaticResource EnumIndexConverter}}"
                                              Width="140" VerticalAlignment="Center">
                                        <ComboBoxItem Content="{Binding Pad_Lighting_PlayerLed_Off, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_PlayerLed_P1, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_PlayerLed_P2, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_PlayerLed_P3, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_PlayerLed_P4, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_PlayerLed_All, Source={x:Static strings:Strings.Instance}}"/>
                                    </ComboBox>
                                    <Button Command="{Binding PlayStationConfig.ResetPlayerLedModeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetPlayerPattern, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Mute LED mode -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Pad_Lighting_MuteLedMode, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ComboBox SelectedIndex="{Binding PlayStationConfig.MicLedMode, Mode=TwoWay, Converter={StaticResource EnumIndexConverter}}"
                                              Width="220" VerticalAlignment="Center">
                                        <ComboBoxItem Content="{Binding Pad_Lighting_MicLed_Off, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_MicLed_Solid, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_MicLed_Pulse, Source={x:Static strings:Strings.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Pad_Lighting_MicLed_FollowDevice, Source={x:Static strings:Strings.Instance}}"/>
                                    </ComboBox>
                                    <Button Command="{Binding PlayStationConfig.ResetMicLedModeCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetMuteLedMode, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Audio endpoint picker, only visible when MicLed mode
                                     is FollowDeviceMute. Lists every active input + output
                                     endpoint (each prefixed [In] / [Out]); the synthesizer
                                     polls the picked endpoint's mute state at 4 Hz and
                                     drives the LED Solid (muted) or Off (unmuted). The
                                     DropDownOpened handler refreshes the list so unplug /
                                     replug between settings opens is reflected. -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            Visibility="{Binding PlayStationConfig.IsMicLedFollowDevice, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Pad_Lighting_MicLed_FollowDevice_Picker, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ComboBox x:Name="MicLedDevicePicker"
                                              ItemsSource="{Binding PlayStationConfig.MicLedAvailableDevices}"
                                              DisplayMemberPath="Display"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding PlayStationConfig.MicLedFollowDeviceId, Mode=TwoWay}"
                                              DropDownOpened="MicLedDevicePicker_DropDownOpened"
                                              Width="320" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════════════════════════
                 TAB 8: GYRO
                 (visible when the selected mapped device has a gyroscope)
                 ══════════════════════════════════════ -->
            <TabItem>
                <ScrollViewer Padding="24,0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE7AD;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Pad_Gyro_Header, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource TitleTextBlockStyle}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Pad_Gyro_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- ─── Motion Passthrough card ─── -->
                        <!-- Tab-wide scope toggle: whether this tab's tuning
                             reaches the virtual controller's motion passthrough
                             (gyro report + DSU), not only gyro-as-mapping-source.
                             Uses CardBorder's default bottom-12 margin so the
                             gap between this and the Calibration card matches
                             every other adjacent-card gap on the Pad page. -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_Gyro_Passthrough_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <Button Command="{Binding ResetGyroApplyToPassthroughCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_Gyro_ResetPassthrough_All_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Content="{Binding Pad_Gyro_ApplyToPassthrough, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding GyroApplyTuningToPassthrough, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,4,0"
                                              ToolTip="{Binding Pad_Gyro_ApplyToPassthrough_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Command="{Binding ResetGyroApplyToPassthroughCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroApplyToPassthrough, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ─── Calibration card ─── -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xF272;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_Gyro_Calibration_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <Button Command="{Binding ResetGyroCalibrationCardCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_Gyro_ResetCalibration_All_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="{Binding Settings_GyroCalibrate_Button, Source={x:Static strings:Strings.Instance}}"
                                            Command="{Binding GyroCalibrateCommand}"
                                            Padding="10,4" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroCalibrate_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Content="{Binding Settings_GyroResetCalibration_Button, Source={x:Static strings:Strings.Instance}}"
                                            Command="{Binding GyroResetCalibrationCommand}"
                                            Padding="10,4" Margin="6,0,0,0" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroResetCalibration_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBlock Text="{Binding GyroCalibrationLabel}"
                                               FontSize="13" Opacity="0.7" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- Live readouts — calibrated gyro rate (deg/s) and
                                     raw accelerometer (g). Same font + size as the
                                     motor previews on the Controller tab: no
                                     FontFamily override, FontSize 14. Axis labels
                                     spelled out (Pitch / Yaw / Roll) instead of
                                     single-letter abbreviations. Per-axis Width is
                                     wide enough to hold the longest realistic value
                                     without text truncation. -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Settings_GyroLiveRate_Label, Source={x:Static strings:Strings.Instance}}"
                                               FontSize="14" Width="160" Opacity="0.85" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding GyroLiveRatePitch, StringFormat={}Pitch {0:+0.0;-0.0;0.0}°/s}"
                                               FontSize="14" Width="140" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding GyroLiveRateYaw,   StringFormat={}Yaw {0:+0.0;-0.0;0.0}°/s}"
                                               FontSize="14" Width="130" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding GyroLiveRateRoll,  StringFormat={}Roll {0:+0.0;-0.0;0.0}°/s}"
                                               FontSize="14" Width="135" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Settings_GyroLiveAccel_Label, Source={x:Static strings:Strings.Instance}}"
                                               FontSize="14" Width="160" Opacity="0.85" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AccelLiveX, StringFormat={}X {0:+0.00;-0.00;0.00}g}"
                                               FontSize="14" Width="140" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AccelLiveY, StringFormat={}Y {0:+0.00;-0.00;0.00}g}"
                                               FontSize="14" Width="130" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AccelLiveZ, StringFormat={}Z {0:+0.00;-0.00;0.00}g}"
                                               FontSize="14" Width="135" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ─── Sensitivity card ─── -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE9E9;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_Gyro_Sensitivity_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <Button Command="{Binding ResetGyroSensitivityCardCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_Gyro_ResetSensitivity_All_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Settings_GyroSensitivityUnits, Source={x:Static strings:Strings.Instance}}"
                                               Width="270" VerticalAlignment="Center"
                                               ToolTip="{Binding Settings_GyroSensitivityUnits_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBox ItemsSource="{Binding GyroSensitivityUnitsOptions}"
                                              SelectedValue="{Binding GyroSensitivityUnits, Mode=TwoWay}"
                                              SelectedValuePath="Value" DisplayMemberPath="Display"
                                              Width="200" VerticalAlignment="Center"
                                              ToolTip="{Binding Settings_GyroSensitivityUnits_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Command="{Binding ResetGyroSensitivityUnitsCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroSensitivityUnits, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Player/World Space — Jibb's recommended default
                                     is Player Space; we keep Local as the conservative default
                                     so existing configs feel identical. -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Settings_GyroSpace, Source={x:Static strings:Strings.Instance}}"
                                               Width="270" VerticalAlignment="Center"
                                               ToolTip="{Binding Settings_GyroSpace_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBox ItemsSource="{Binding GyroSpaceOptions}"
                                              SelectedValue="{Binding GyroSpace, Mode=TwoWay}"
                                              SelectedValuePath="Value" DisplayMemberPath="Display"
                                              Width="200" VerticalAlignment="Center"
                                              ToolTip="{Binding Settings_GyroSpace_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Command="{Binding ResetGyroSpaceCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroSpace, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding Settings_GyroSensitivityH, Source={x:Static strings:Strings.Instance}}"
                                               Width="270" VerticalAlignment="Center"
                                               ToolTip="{Binding Settings_GyroSensitivityH_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding GyroSensitivityH, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="0.1" Maximum="10" SmallChange="0.1" LargeChange="1"
                                            Width="200" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroSensitivityH_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding GyroSensitivityH, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                             Width="56" Margin="6,0,0,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="×" VerticalAlignment="Center" Margin="2,0,0,0" Opacity="0.6"/>
                                    <Button Command="{Binding ResetGyroSensitivityHCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroSensitivityH, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBlock Text="{Binding GyroSensitivityH_DegPerTurn, StringFormat={}≈ {0:0}°/turn}"
                                               VerticalAlignment="Center" Margin="14,0,0,0" Opacity="0.55" FontSize="11"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding Settings_GyroSensitivityV, Source={x:Static strings:Strings.Instance}}"
                                               Width="270" VerticalAlignment="Center"
                                               ToolTip="{Binding Settings_GyroSensitivityV_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding GyroSensitivityV, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="0.1" Maximum="10" SmallChange="0.1" LargeChange="1"
                                            Width="200" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroSensitivityV_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding GyroSensitivityV, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                             Width="56" Margin="6,0,0,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="×" VerticalAlignment="Center" Margin="2,0,0,0" Opacity="0.6"/>
                                    <Button Command="{Binding ResetGyroSensitivityVCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroSensitivityV, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBlock Text="{Binding GyroSensitivityV_DegPerTurn, StringFormat={}≈ {0:0}°/turn}"
                                               VerticalAlignment="Center" Margin="14,0,0,0" Opacity="0.55" FontSize="11"/>
                                </StackPanel>

                                <!-- Per-axis invert toggles. Independent from per-source
                                     Invert flags on the mapping table — Steam-style top-level
                                     convenience. -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <CheckBox Content="{Binding Settings_GyroInvertPitch, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding GyroInvertPitch, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,4,0"
                                              ToolTip="{Binding Settings_GyroInvertPitch_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Command="{Binding ResetGyroInvertPitchCommand}" Style="{StaticResource ResetButton}" Margin="0,0,12,0"
                                            ToolTip="{Binding Pad_ResetGyroInvertPitch, Source={x:Static strings:Strings.Instance}}"/>
                                    <CheckBox Content="{Binding Settings_GyroInvertYawRoll, Source={x:Static strings:Strings.Instance}}"
                                              IsChecked="{Binding GyroInvertYawRoll, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,4,0"
                                              ToolTip="{Binding Settings_GyroInvertYawRoll_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Command="{Binding ResetGyroInvertYawRollCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroInvertYawRoll, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Real-world calibration. 0 = disabled. -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Settings_GyroRealWorldCalibration, Source={x:Static strings:Strings.Instance}}"
                                               Width="270" VerticalAlignment="Center"
                                               ToolTip="{Binding Settings_GyroRealWorldCalibration_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding GyroRealWorldCalibration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="0" Maximum="2" SmallChange="0.01" LargeChange="0.1"
                                            Width="200" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroRealWorldCalibration_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding GyroRealWorldCalibration, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                             Width="56" Margin="6,0,0,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="×" VerticalAlignment="Center" Margin="2,0,0,0" Opacity="0.6"/>
                                    <Button Command="{Binding ResetGyroRealWorldCalibrationCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroRealWorldCalibration, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ─── Response shaping card ─── -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xF1CB;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_Gyro_Response_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <Button Command="{Binding ResetGyroResponseCardCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_Gyro_ResetResponse_All_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <TextBlock Text="{Binding Settings_GyroDeadZone, Source={x:Static strings:Strings.Instance}}"
                                               Width="270" VerticalAlignment="Center"
                                               ToolTip="{Binding Settings_GyroDeadZone_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding GyroDeadZoneDegPerSec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="0" Maximum="30" SmallChange="0.5" LargeChange="5"
                                            Width="200" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroDeadZone_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding GyroDeadZoneDegPerSec, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.0}}"
                                             Width="56" Margin="6,0,0,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="°/s" VerticalAlignment="Center" Margin="2,0,0,0" Opacity="0.6"/>
                                    <Button Command="{Binding ResetGyroDeadZoneCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroDeadZone, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- dual-threshold smoothing (JSM-style).
                                     Tightening = full smoothing below this rate (drop hand tremor).
                                     Smoothing threshold = pass-through above this rate (fast turns).
                                     Between thresholds = linear ramp. -->
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding Settings_GyroTightening, Source={x:Static strings:Strings.Instance}}"
                                               Width="270" VerticalAlignment="Center"
                                               ToolTip="{Binding Settings_GyroTightening_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding GyroTighteningThresholdDegPerSec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="0" Maximum="30" SmallChange="0.5" LargeChange="5"
                                            Width="200" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroTightening_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding GyroTighteningThresholdDegPerSec, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.0}}"
                                             Width="56" Margin="6,0,0,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="°/s" VerticalAlignment="Center" Margin="2,0,0,0" Opacity="0.6"/>
                                    <Button Command="{Binding ResetGyroTighteningCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroTightening, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding Settings_GyroSmoothingThreshold, Source={x:Static strings:Strings.Instance}}"
                                               Width="270" VerticalAlignment="Center"
                                               ToolTip="{Binding Settings_GyroSmoothingThreshold_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding GyroSmoothingThresholdDegPerSec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="0" Maximum="30" SmallChange="0.5" LargeChange="5"
                                            Width="200" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroSmoothingThreshold_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding GyroSmoothingThresholdDegPerSec, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.0}}"
                                             Width="56" Margin="6,0,0,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="°/s" VerticalAlignment="Center" Margin="2,0,0,0" Opacity="0.6"/>
                                    <Button Command="{Binding ResetGyroSmoothingThresholdCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroSmoothingThreshold, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding Settings_GyroSmoothingWindow, Source={x:Static strings:Strings.Instance}}"
                                               Width="270" VerticalAlignment="Center"
                                               ToolTip="{Binding Settings_GyroSmoothingWindow_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding GyroSmoothingWindowMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="10" Maximum="200" SmallChange="5" LargeChange="20"
                                            Width="200" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroSmoothingWindow_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding GyroSmoothingWindowMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}"
                                             Width="56" Margin="6,0,0,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="ms" VerticalAlignment="Center" Margin="2,0,0,0" Opacity="0.6"/>
                                    <Button Command="{Binding ResetGyroSmoothingWindowCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroSmoothingWindow, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding Settings_GyroAcceleration, Source={x:Static strings:Strings.Instance}}"
                                               Width="270" VerticalAlignment="Center"
                                               ToolTip="{Binding Settings_GyroAcceleration_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding GyroAcceleration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="0" Maximum="2" SmallChange="0.05" LargeChange="0.5"
                                            Width="200" VerticalAlignment="Center"
                                            ToolTip="{Binding Settings_GyroAcceleration_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding GyroAcceleration, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                             Width="56" Margin="6,0,0,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                    <Button Command="{Binding ResetGyroAccelerationCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroAcceleration, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding Settings_GyroOutputCurve, Source={x:Static strings:Strings.Instance}}"
                                               Width="270" VerticalAlignment="Center"
                                               ToolTip="{Binding Settings_GyroOutputCurve_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBox ItemsSource="{Binding GyroOutputCurveOptions}"
                                              SelectedValue="{Binding GyroOutputCurve, Mode=TwoWay}"
                                              SelectedValuePath="Value" DisplayMemberPath="Display"
                                              Width="200" VerticalAlignment="Center"
                                              ToolTip="{Binding Settings_GyroOutputCurve_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Button Command="{Binding ResetGyroOutputCurveCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroOutputCurve, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ─── Engage card ─── -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_Gyro_Engage_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <Button Command="{Binding ResetGyroEngageCardCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_Gyro_ResetEngage_All_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Pad_Gyro_Engage_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,8" FontSize="11"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Settings_GyroEasyAimThreshold, Source={x:Static strings:Strings.Instance}}"
                                               Width="270" VerticalAlignment="Center"
                                               ToolTip="{Binding Settings_GyroEasyAimThreshold_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <Slider Value="{Binding GyroEasyAimStickThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                                            Width="200" VerticalAlignment="Center" TickFrequency="5"
                                            ToolTip="{Binding Settings_GyroEasyAimThreshold_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <TextBox Text="{Binding GyroEasyAimStickThreshold, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}"
                                             Width="56" Margin="6,0,0,0" Padding="2,1" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="%" VerticalAlignment="Center" Margin="2,0,0,0" Opacity="0.6"/>
                                    <Button Command="{Binding ResetGyroEasyAimStickThresholdCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroEasyAimThreshold, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Aim Engage button — cross-device picker that writes
                                     both the descriptor and owning device GUID atomically.
                                     ItemsSource is the slot's combined cross-device InputChoice
                                     list, populated by InputService.PopulateAvailableInputs.
                                     Subtitle under the picker shows the owning device, matching
                                     the mapping row pattern at PadPage.xaml:2785-2800. -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Settings_GyroAimEngageButton, Source={x:Static strings:Strings.Instance}}"
                                               Width="270" VerticalAlignment="Top" Margin="0,4,0,0"
                                               ToolTip="{Binding Settings_GyroAimEngageButton_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <StackPanel Orientation="Vertical">
                                        <ComboBox ItemsSource="{Binding SlotAvailableInputsView}"
                                                  SelectedItem="{Binding GyroAimEngageSelectedInput, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName"
                                                  MinWidth="260" Padding="4,2"
                                                  ToolTip="{Binding Settings_GyroAimEngageButton_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                            <ComboBox.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,3,6,3">
                                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ComboBox.GroupStyle>
                                        </ComboBox>
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Margin="4,1,0,0"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding GyroAimEngageSelectedInput.DeviceLabel}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding GyroAimEngageSelectedInput}" Value="{x:Null}">
                                                            <Setter Property="Text" Value="{Binding Common_Unassigned, Source={x:Static strings:Strings.Instance}}"/>
                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Command="{Binding GyroAimEngageRecordCommand}"
                                            Width="40" VerticalAlignment="Top" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding GyroAimEngageRecordButtonIcon}" FontFamily="Segoe MDL2 Assets"/>
                                        <Button.ToolTip>
                                            <TextBlock Text="{Binding GyroAimEngageRecordButtonText}"/>
                                        </Button.ToolTip>
                                    </Button>
                                    <Button Command="{Binding ResetGyroAimEngageButtonCommand}" Style="{StaticResource ResetButton}"
                                            VerticalAlignment="Top"
                                            ToolTip="{Binding Pad_ResetGyroAimEngageButton, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <!-- Engage Mode — Hold (default) follows the
                                     button state directly; Toggle flips a
                                     sticky per-slot bit on each rising edge.
                                     Sibling to the engage-button row above so
                                     the two parameters of the same feature
                                     read as a pair. -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Settings_GyroAimEngageMode, Source={x:Static strings:Strings.Instance}}"
                                               Width="270" VerticalAlignment="Center"
                                               ToolTip="{Binding Settings_GyroAimEngageMode_Tooltip, Source={x:Static strings:Strings.Instance}}"/>
                                    <ComboBox SelectedValue="{Binding GyroAimEngageMode, Mode=TwoWay}"
                                              SelectedValuePath="Tag"
                                              Width="200" VerticalAlignment="Center"
                                              ScrollViewer.VerticalScrollBarVisibility="Visible"
                                              ToolTip="{Binding Settings_GyroAimEngageMode_Tooltip, Source={x:Static strings:Strings.Instance}}">
                                        <ComboBoxItem Content="{Binding Settings_GyroAimEngageMode_Hold, Source={x:Static strings:Strings.Instance}}" Tag="Hold"/>
                                        <ComboBoxItem Content="{Binding Settings_GyroAimEngageMode_Toggle, Source={x:Static strings:Strings.Instance}}" Tag="Toggle"/>
                                    </ComboBox>
                                    <Button Command="{Binding ResetGyroAimEngageModeCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetGyroAimEngageMode, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════════════════════════
                 TAB 9: IMPULSE TRIGGERS
                 (visible when the selected mapped device exposes
                 SDL_PROP_JOYSTICK_CAP_TRIGGER_RUMBLE_BOOLEAN —
                 Xbox One / Elite / Series).
                 ══════════════════════════════════════ -->
            <TabItem>
                <ScrollViewer Padding="24,0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Viewbox Width="24" Height="24" Stretch="Uniform"
                                     VerticalAlignment="Center" Margin="0,0,10,0">
                                <Grid Width="512" Height="512">
                                    <Path Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                          Data="{StaticResource ZackslyTriggerOuterBodyGeometry}"/>
                                    <Path Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                          Data="M445,180 L475,200 L445,220 L455,220 L485,200 L455,180 Z M445,280 L475,300 L445,320 L455,320 L485,300 L455,280 Z"/>
                                </Grid>
                            </Viewbox>
                            <TextBlock Text="{Binding Pad_ImpulseTriggers_Header, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource TitleTextBlockStyle}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Pad_ImpulseTriggers_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Viewbox Width="18" Height="18" Stretch="Uniform"
                                             VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Grid Width="512" Height="512">
                                            <Path Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                                  Data="{StaticResource ZackslyTriggerOuterBodyGeometry}"/>
                                            <Path Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                                  Data="M445,180 L475,200 L445,220 L455,220 L485,200 L455,180 Z M445,280 L475,300 L445,320 L455,320 L485,300 L455,280 Z"/>
                                        </Grid>
                                    </Viewbox>
                                    <TextBlock Text="{Binding Pad_ImpulseTriggers_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <Button Command="{Binding ResetImpulseAllCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetImpulseTriggers, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Overall gain -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Pad_OverallGain, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding ImpulseOverallGain, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding ImpulseOverallGain, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                    <Button Command="{Binding ResetImpulseOverallGainCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetImpulseOverallGain, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Left trigger -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Pad_ImpulseTriggers_LeftTrigger, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding ImpulseLeftStrength, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding ImpulseLeftStrength, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                    <Button Command="{Binding ResetImpulseLeftCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetImpulseLeft, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Right trigger -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Pad_ImpulseTriggers_RightTrigger, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding ImpulseRightStrength, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding ImpulseRightStrength, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                    <Button Command="{Binding ResetImpulseRightCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetImpulseRight, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <!-- Swap trigger motors -->
                                <CheckBox Content="{Binding Pad_ImpulseTriggers_SwapTriggers, Source={x:Static strings:Strings.Instance}}"
                                          IsChecked="{Binding ImpulseSwapTriggers, Mode=TwoWay}"
                                          Margin="0,0,0,12"/>

                                <!-- Test trigger buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button Content="{Binding Pad_ImpulseTriggers_TestLeftTrigger, Source={x:Static strings:Strings.Instance}}"
                                            Command="{Binding TestLeftImpulseTriggerCommand}"
                                            Padding="12,6" Margin="0,0,8,0"/>
                                    <Button Content="{Binding Pad_ImpulseTriggers_TestRightTrigger, Source={x:Static strings:Strings.Instance}}"
                                            Command="{Binding TestRightImpulseTriggerCommand}"
                                            Padding="12,6"/>
                                </StackPanel>

                                <!-- Live trigger motor display -->
                                <TextBlock Text="{Binding Pad_ImpulseTriggers_MotorActivity, Source={x:Static strings:Strings.Instance}}"
                                           FontWeight="SemiBold" Margin="0,8,0,8"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Pad_ImpulseTriggers_LeftTrigger, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ProgressBar Value="{Binding DeviceLeftTriggerMotorDisplay, Mode=OneWay}"
                                                 Minimum="0" Maximum="1"
                                                 Width="200" Height="16" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Pad_ImpulseTriggers_RightTrigger, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ProgressBar Value="{Binding DeviceRightTriggerMotorDisplay, Mode=OneWay}"
                                                 Minimum="0" Maximum="1"
                                                 Width="200" Height="16" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ── Constant Trigger Force section ── -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="&#xF0AD;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_ConstantTriggerForce_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <Button Command="{Binding ResetConstantTriggerForceCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetConstantTriggerForce, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Pad_ConstantTriggerForce_Description, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}" Margin="0,0,0,12"/>

                                <CheckBox Content="{Binding Pad_ConstantTriggerForce_Toggle, Source={x:Static strings:Strings.Instance}}"
                                          IsChecked="{Binding ConstantTriggerForceEnabled, Mode=TwoWay}"
                                          Margin="0,0,0,12"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" IsEnabled="{Binding ConstantTriggerForceEnabled}">
                                    <TextBlock Text="{Binding Pad_ConstantTriggerForce_Left, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding ConstantTriggerForceLeft, Mode=TwoWay}"
                                            Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                                            Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding ConstantTriggerForceLeft, Mode=TwoWay, StringFormat=F2, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <Button Command="{Binding ResetConstantTriggerLeftCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetConstantTriggerLeft, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" IsEnabled="{Binding ConstantTriggerForceEnabled}">
                                    <TextBlock Text="{Binding Pad_ConstantTriggerForce_Right, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding ConstantTriggerForceRight, Mode=TwoWay}"
                                            Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                                            Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding ConstantTriggerForceRight, Mode=TwoWay, StringFormat=F2, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <Button Command="{Binding ResetConstantTriggerRightCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetConstantTriggerRight, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ── Audio Bass Trigger Rumble section ── -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Pad_AudioTriggerRumble_Header, Source={x:Static strings:Strings.Instance}}"
                                               Style="{StaticResource CardTitle}"/>
                                    <Button Command="{Binding ResetAudioTriggerRumbleAllCommand}" Style="{StaticResource ResetAllButton}"
                                            Content="{Binding Pad_ResetAll, Source={x:Static strings:Strings.Instance}}" Margin="12,0,0,0"
                                            ToolTip="{Binding Pad_ResetAudioTriggerRumble, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Pad_AudioTriggerRumble_Description, Source={x:Static strings:Strings.Instance}}"
                                           Style="{StaticResource CardDescription}" Margin="0,0,0,12"/>

                                <CheckBox Content="{Binding Pad_AudioTriggerRumble_Toggle, Source={x:Static strings:Strings.Instance}}"
                                          IsChecked="{Binding AudioRumbleTriggersEnabled, Mode=TwoWay}"
                                          Margin="0,0,0,12"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" IsEnabled="{Binding AudioRumbleTriggersEnabled}">
                                    <TextBlock Text="{Binding Pad_AudioTriggerRumble_Sensitivity, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding AudioRumbleTriggersSensitivity, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"
                                            Minimum="1" Maximum="20" TickFrequency="0.1"/>
                                    <TextBox Text="{Binding AudioRumbleTriggersSensitivity, Mode=TwoWay, StringFormat=F1, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <Button Command="{Binding ResetAudioTriggerSensitivityCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetAudioTriggerSensitivity, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" IsEnabled="{Binding AudioRumbleTriggersEnabled}">
                                    <TextBlock Text="{Binding Pad_AudioTriggerRumble_Cutoff, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding AudioRumbleTriggersCutoffHz, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"
                                            Minimum="20" Maximum="200" TickFrequency="1"/>
                                    <TextBox Text="{Binding AudioRumbleTriggersCutoffHz, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <Button Command="{Binding ResetAudioTriggerCutoffCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetAudioTriggerCutoff, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" IsEnabled="{Binding AudioRumbleTriggersEnabled}">
                                    <TextBlock Text="{Binding Pad_AudioTriggerRumble_LeftTrigger, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding AudioRumbleLeftTrigger, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding AudioRumbleLeftTrigger, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                    <Button Command="{Binding ResetAudioLeftTriggerCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetAudioLeftTrigger, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" IsEnabled="{Binding AudioRumbleTriggersEnabled}">
                                    <TextBlock Text="{Binding Pad_AudioTriggerRumble_RightTrigger, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <Slider Value="{Binding AudioRumbleRightTrigger, Mode=TwoWay}"
                                            Style="{StaticResource DzSlider}"/>
                                    <TextBox Text="{Binding AudioRumbleRightTrigger, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DzValueEdit}"/>
                                    <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                    <Button Command="{Binding ResetAudioRightTriggerCommand}" Style="{StaticResource ResetButton}"
                                            ToolTip="{Binding Pad_ResetAudioRightTrigger, Source={x:Static strings:Strings.Instance}}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" IsEnabled="{Binding AudioRumbleTriggersEnabled}">
                                    <TextBlock Text="{Binding Pad_AudioTriggerRumble_Level, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                    <ProgressBar Value="{Binding AudioRumbleTriggersLevelMeter, Mode=OneWay}"
                                                 Minimum="0" Maximum="1"
                                                 Width="200" Height="16" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════════════════════════════════
                 INDEX 10 — Touchpad tab (per-(device, pad)
                 gesture settings). Visibility on the tab
                 strip is gated by SyncTabVisibility based on
                 UserDevice.HasTouchpad of the currently
                 selected mapped device.
                 ═══════════════════════════════════════════ -->
            <TabItem>
                <ScrollViewer Padding="24,0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xEFA5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Pad_Touchpad_Header, Source={x:Static strings:Strings.Instance}}"
                                       Style="{StaticResource TitleTextBlockStyle}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Pad_Touchpad_Subtitle, Source={x:Static strings:Strings.Instance}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- Per-pad pivot — visible only on multi-pad devices -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                                    Visibility="{Binding HasMultipleTouchpads, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding Pad_Touchpad_TouchpadIndex_Label, Source={x:Static strings:Strings.Instance}}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding TouchpadIndexOptions}"
                                      SelectedItem="{Binding SelectedTouchpadIndex, Mode=TwoWay}"
                                      Width="120" VerticalAlignment="Center"
                                      ScrollViewer.VerticalScrollBarVisibility="Visible">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Pad index is stored 0-based; show it 1-based
                                             ("1"/"2") to match the previews and picker. The
                                             adjacent label is already the word "Touchpad", so
                                             the dropdown shows only the number. -->
                                        <TextBlock Text="{Binding Converter={StaticResource OneBasedIndexConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

