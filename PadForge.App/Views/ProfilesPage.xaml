                                                              Fill="{DynamicResource TextFillColorTertiaryBrush}"
                                                              Width="10" Height="10" Stretch="Uniform"
                                                              VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding PlayStationCount}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="3,0,0,0"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <!-- Extended count badge -->
                                                <Border CornerRadius="8" Padding="7,2" Margin="0,0,4,0"
                                                        BorderThickness="1"
                                                        BorderBrush="{DynamicResource SteelLineSoftBrush}"
                                                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ExtendedCount}" Value="0">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
