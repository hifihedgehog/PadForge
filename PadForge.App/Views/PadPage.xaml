                                                <reset:SettingResetButton Command="{Binding ResetSettingCommand}" CommandParameter="ScreenRepeat" SettingLabel="{Binding Macro_Dreamcast_Repeat, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_MacroAction_ScreenRepeat_13104" Margin="4,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock common:BidiText.Text="{Binding MacroAction_ShowKeyboardScreen_Hint, Source={x:Static strings:Strings.Instance}}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
