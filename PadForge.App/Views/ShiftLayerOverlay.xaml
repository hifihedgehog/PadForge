<Window x:Class="PadForge.Views.ShiftLayerOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Background="Transparent">

    <!--
        Compact pill-shaped overlay shown top-right while any shift layer
        is engaged on the user's currently-viewed slot. Layer name on the
        left, a colored dot on the right (per-layer color from
        ShiftActivator.Color when authored). Hides itself when the slot
        returns to Base.
    -->
    <Grid ClipToBounds="True">
        <Grid x:Name="FlyoutPanel" Margin="10,10,10,10">
            <Border CornerRadius="14"
                    Background="#2D2E2E">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2"
                                      Direction="270" Opacity="0.30" Color="Black"/>
                </Border.Effect>
            </Border>
            <Border CornerRadius="14"
                    Background="#2D2E2E"
                    BorderBrush="#141516"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="14,8,14,8">
                    <TextBlock Text="&#xE950;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Foreground="White"/>
                    <TextBlock x:Name="LayerNameText"
                               FontSize="13"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Foreground="White"/>
                    <Ellipse x:Name="ColorDot"
                             Width="10" Height="10"
                             VerticalAlignment="Center"
                             Fill="#888"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
