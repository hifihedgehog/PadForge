                                                 is on. Both are bound, nothing is invented. -->
                                            <Border Margin="0,6,0,0" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource ChipCold}">
                                                        <Setter Property="Padding" Value="7,2"/>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding HasExecutables}" Value="True"/>
                                                                    <Condition Binding="{Binding DataContext.EnableAutoProfileSwitching, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
