<UserControl x:Class="PadForge.Views.Controls.LabeledShapeIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <Grid>
        <Image x:Name="ShapeImage" Stretch="Uniform"/>
        <Viewbox x:Name="LabelHost" Stretch="Uniform">
            <!-- Inner 512x512 canvas matches the icon viewBox so label
                 positions are expressed in icon coordinates. -->
            <Canvas Width="512" Height="512" Background="Transparent" IsHitTestVisible="False">
                <!-- Label fill needs maximum contrast against the shape,
                     which uses TextFillColorPrimaryBrush. The inverse
                     brush (white in light theme, black in dark theme)
                     is the exact opposite, so the knockout reads
                     clearly in both themes. -->
                <Path x:Name="LabelPath"
                      Fill="{DynamicResource TextFillColorInverseBrush}"/>
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
