                                    </controls:SettingRow>
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <TextBlock Text="{Binding Pad_Lighting_ScreenSaturation, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <Slider Value="{Binding DeviceConfig.ScreenColorSaturation, Mode=TwoWay}"
                                                Style="{StaticResource DzSlider}"
                                                Minimum="0" Maximum="200" TickFrequency="1"/>
                                        <TextBox Text="{Binding DeviceConfig.ScreenColorSaturation, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding DeviceConfig.ResetScreenColorSaturationCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetScreenColorSaturation, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <TextBlock Text="{Binding Pad_Lighting_RainbowBrightness, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <Slider Value="{Binding DeviceConfig.ScreenColorBrightness, Mode=TwoWay}"
                                                Style="{StaticResource DzSlider}"
                                                Minimum="0" Maximum="100" TickFrequency="1"/>
                                        <TextBox Text="{Binding DeviceConfig.ScreenColorBrightness, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding DeviceConfig.ResetScreenColorBrightnessCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetLightbarRainbowBrightness, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                    <controls:SettingRow Grow="True" ValueWidth="66" MinHeight="44">
                                        <TextBlock Text="{Binding Pad_Lighting_ScreenSmoothing, Source={x:Static strings:Strings.Instance}}" Style="{StaticResource DzLabel}"/>
                                        <Slider Value="{Binding DeviceConfig.ScreenColorSmoothing, Mode=TwoWay}"
                                                Style="{StaticResource DzSlider}"
                                                Minimum="0" Maximum="100" TickFrequency="1"/>
                                        <TextBox Text="{Binding DeviceConfig.ScreenColorSmoothing, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource DzValueEdit}"/>
                                        <TextBlock Text="%" Style="{StaticResource DzPercent}"/>
                                        <ui:Button Command="{Binding DeviceConfig.ResetScreenColorSmoothingCommand}" Style="{StaticResource ResetButton}" ToolTip="{Binding Pad_ResetScreenColorSmoothing, Source={x:Static strings:Strings.Instance}}"/>
                                    </controls:SettingRow>
                                    <!-- Only a device with more than one light has anything to spread across. -->
