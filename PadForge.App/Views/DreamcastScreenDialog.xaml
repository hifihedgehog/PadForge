<views:DialogWindow AutomationProperties.IsDialog="True" x:Class="PadForge.Views.DreamcastScreenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        xmlns:controls="clr-namespace:PadForge.Controls"
        xmlns:reset="clr-namespace:PadForge.Controls"
        xmlns:common="clr-namespace:PadForge.Common"
        xmlns:views="clr-namespace:PadForge.Views"
        Title="{Binding DreamcastScreen_Title, Source={x:Static strings:Strings.Instance}}"
        Subtitle="{Binding DreamcastScreen_Subtitle, Source={x:Static strings:Strings.Instance}}">

    <!-- What a Dreamcast pad's VMU shows in a Bliss-Box port (#469, #574),
         as the Dialogs-Screens board draws it: the VMU as it will look at
         the left, and at the right what it shows, a line that says what
         that is, and the picture choices the mode takes. -->
    <views:DialogWindow.Foot>
        <controls:FlexLinePanel Style="{StaticResource DialogFootPanel}">
            <Button Style="{StaticResource DialogButton}" IsCancel="True"
                    Content="{Binding Common_Cancel, Source={x:Static strings:Strings.Instance}}"/>
            <Button x:Name="SaveButton" Style="{StaticResource DialogPrimaryButton}" IsDefault="True" Click="SaveButton_Click"
                    Content="{Binding Common_Save, Source={x:Static strings:Strings.Instance}}"/>
        </controls:FlexLinePanel>
    </views:DialogWindow.Foot>

    <Grid common:InitialFocus.First="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="194"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- The VMU's 48 by 32 pixels, four screen pixels each, edge to edge
             in the board's box with corners of 6. The picture is clipped to
             the corners, so its own square ones do not cover the edge. -->
        <Border x:Name="PreviewFrame" Width="194" Height="130" HorizontalAlignment="Left" VerticalAlignment="Top"
                CornerRadius="6" Background="#FFBFD0B4" BorderBrush="{DynamicResource SteelPillLineBrush}" BorderThickness="1">
            <Image x:Name="PreviewImage" FlowDirection="LeftToRight" Width="192" Height="128"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   AutomationProperties.Name="{Binding Pad_Tab_Preview, Source={x:Static strings:Strings.Instance}}">
                <Image.Clip>
                    <RectangleGeometry Rect="0,0,192,128" RadiusX="5" RadiusY="5"/>
                </Image.Clip>
            </Image>
        </Border>

        <StackPanel Grid.Column="2">
            <!-- The label is as wide as its word, 50 at the least, and the
                 picker takes the rest of the row. -->
            <controls:SettingRow MinHeight="44">
                <TextBlock MinWidth="50" Margin="0,0,10,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{Binding DreamcastScreen_Mode_Label, Source={x:Static strings:Strings.Instance}}"/>
                <ComboBox x:Name="ModeBox" Style="{StaticResource DialogSelect}" controls:SettingRow.Fills="True"
                          SelectionChanged="ModeBox_SelectionChanged"
                          AutomationProperties.Name="{Binding DreamcastScreen_Mode_Label, Source={x:Static strings:Strings.Instance}}"/>
                <reset:SettingResetButton Click="ResetMode_Click" Tag="" Visibility="{Binding Visibility, ElementName=ModeBox}" IsEnabled="{Binding IsEnabled, ElementName=ModeBox}" SettingLabel="{Binding DreamcastScreen_Mode_Label, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_?dialog_ModeBox_48"/>
            </controls:SettingRow>
            <TextBlock x:Name="HintText" Style="{StaticResource DialogNote}" Margin="0,4,0,8"/>

            <controls:SettingRow x:Name="PictureRow" MinHeight="44" Visibility="Collapsed">
                <Button x:Name="ChoosePictureButton" Style="{StaticResource DialogButton}"
                        Content="{Binding DreamcastScreen_ChoosePicture, Source={x:Static strings:Strings.Instance}}"
                        Click="ChoosePicture_Click"/>
                <reset:SettingResetButton Click="ResetPicture_Click" Visibility="{Binding Visibility, ElementName=ChoosePictureButton}" SettingLabel="{Binding DreamcastScreen_Mode_Picture, Source={x:Static strings:Strings.Instance}}" AutomationProperties.AutomationId="Reset_?dialog_ChoosePictureButton_63"/>
            </controls:SettingRow>
            <!-- The active profile's own picture. Its button names the
                 profile, in words the code sets. -->
            <StackPanel x:Name="ProfilePicturePanel" Visibility="Collapsed">
                <Button x:Name="ChooseProfilePictureButton" Style="{StaticResource DialogButton}" HorizontalAlignment="Left"
                        MaxWidth="300" Margin="0,4,0,4" Click="ChooseProfilePicture_Click"/>
                <Button x:Name="RemoveProfilePictureButton" Style="{StaticResource DialogButton}" HorizontalAlignment="Left"
                        Margin="0,4,0,4" Click="RemoveProfilePicture_Click"
                        Content="{Binding DreamcastScreen_RemoveProfilePicture, Source={x:Static strings:Strings.Instance}}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</views:DialogWindow>
