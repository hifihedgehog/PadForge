<views:DialogWindow AutomationProperties.IsDialog="True" x:Class="PadForge.Views.RemoteLinkPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        xmlns:common="clr-namespace:PadForge.Common"
        xmlns:controls="clr-namespace:PadForge.Controls"
        xmlns:views="clr-namespace:PadForge.Views"
        Title="{Binding RemoteLink_PasswordSetTitle, Source={x:Static strings:Strings.Instance}}">

    <!-- The Remote Link password (#138, #574), as the Links board draws
         it. To set one it is typed twice. To unlock with one it is typed
         once, and the second row is left out. The code-behind sets the
         title for the mode and puts the caller's prompt under it. -->
    <views:DialogWindow.Foot>
        <controls:FlexLinePanel Style="{StaticResource DialogFootPanel}">
            <Button x:Name="CancelButton" Style="{StaticResource DialogButton}" IsCancel="True"
                    Content="{Binding Common_Cancel, Source={x:Static strings:Strings.Instance}}"/>
            <Button x:Name="OkButton" Style="{StaticResource DialogPrimaryButton}" IsDefault="True"
                    Content="{Binding Common_OK, Source={x:Static strings:Strings.Instance}}"
                    Click="Ok_Click"/>
        </controls:FlexLinePanel>
    </views:DialogWindow.Foot>

    <StackPanel>
        <controls:SettingRow MinHeight="44">
            <TextBlock Style="{StaticResource DialogLabel}"
                       Text="{Binding RemoteLink_PasswordLabel, Source={x:Static strings:Strings.Instance}}"/>
            <PasswordBox x:Name="PwBox" Style="{StaticResource DialogPasswordBox}" controls:SettingRow.Fills="True"
                         AutomationProperties.Name="{Binding RemoteLink_PasswordLabel, Source={x:Static strings:Strings.Instance}}"/>
        </controls:SettingRow>
        <controls:SettingRow x:Name="ConfirmRow" MinHeight="44">
            <TextBlock Style="{StaticResource DialogLabel}"
                       Text="{Binding RemoteLink_PasswordConfirm, Source={x:Static strings:Strings.Instance}}"/>
            <PasswordBox x:Name="ConfirmBox" Style="{StaticResource DialogPasswordBox}" controls:SettingRow.Fills="True"
                         AutomationProperties.Name="{Binding RemoteLink_PasswordConfirm, Source={x:Static strings:Strings.Instance}}"/>
        </controls:SettingRow>
        <!-- Why the password was not taken: none typed, or the two differ. -->
        <TextBlock x:Name="ErrorText" common:LiveText.Polite="True" Margin="160,4,0,0" FontSize="13" TextWrapping="Wrap"
                   Foreground="{DynamicResource WaitBrush}" Visibility="Collapsed"/>
    </StackPanel>
</views:DialogWindow>
