<views:DialogWindow common:Reach.Class="UsersOwn" AutomationProperties.IsDialog="True" x:Class="PadForge.Views.NetworkAssistantDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        xmlns:common="clr-namespace:PadForge.Common"
        xmlns:controls="clr-namespace:PadForge.Controls"
        xmlns:views="clr-namespace:PadForge.Views"
        Width="600">

    <!-- Add a Network Assistant… (#600 item 53), as the Assistants-Web
         board draws it. First it asks for a name and a level, up to the
         page's level. Then it shows the key once, with a line to paste for
         each assistant program seen connecting to a network address (Claude
         Code), or the address and the header for any other host. The user's
         alone: no program makes itself a key, and a program reads none of
         its values. -->
    <views:DialogWindow.Foot>
        <controls:FlexLinePanel Style="{StaticResource DialogFootPanel}">
            <Button x:Name="CancelButton" Style="{StaticResource DialogButton}" IsCancel="True"
                    Content="{Binding Common_Cancel, Source={x:Static strings:Strings.Instance}}"/>
            <Button x:Name="MakeButton" Style="{StaticResource DialogPrimaryButton}" IsDefault="True" Click="Make_Click"
                    AutomationProperties.AutomationId="Net_MakeKey"
                    Content="{Binding Net_Add_Make, Source={x:Static strings:Strings.Instance}}"/>
            <Button x:Name="DoneButton" Style="{StaticResource DialogPrimaryButton}" Click="Done_Click" Visibility="Collapsed"
                    AutomationProperties.AutomationId="Net_KeyDone"
                    Content="{Binding Net_Key_Done, Source={x:Static strings:Strings.Instance}}"/>
        </controls:FlexLinePanel>
    </views:DialogWindow.Foot>

    <Grid>
        <!-- The name and the level. -->
        <StackPanel x:Name="AskPanel">
            <controls:SettingRow MinHeight="44">
                <TextBlock Style="{StaticResource DialogLabel}" Text="{Binding Net_Add_Name, Source={x:Static strings:Strings.Instance}}"/>
                <TextBox x:Name="NameBox" controls:SettingRow.Fills="True" MaxLength="40"
                         AutomationProperties.AutomationId="Net_KeyName"
                         AutomationProperties.Name="{Binding Net_Add_Name, Source={x:Static strings:Strings.Instance}}"/>
            </controls:SettingRow>
            <controls:SettingRow MinHeight="44">
                <TextBlock Style="{StaticResource DialogLabel}" Text="{Binding Net_Add_Level, Source={x:Static strings:Strings.Instance}}"/>
                <ComboBox x:Name="LevelBox" controls:SettingRow.Fills="True" MaxWidth="260" DisplayMemberPath="Name"
                          AutomationProperties.AutomationId="Net_KeyLevel"
                          AutomationProperties.Name="{Binding Net_Add_Level, Source={x:Static strings:Strings.Instance}}"/>
            </controls:SettingRow>
            <TextBlock x:Name="ErrorText" common:LiveText.Polite="True" Margin="160,4,0,0" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource WaitBrush}" Visibility="Collapsed"/>
        </StackPanel>

        <!-- The key, shown once, and what to paste. -->
        <StackPanel x:Name="KeyPanel" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="KeyBox" IsReadOnly="True" VerticalAlignment="Center"
                         AutomationProperties.AutomationId="Net_Key"
                         AutomationProperties.Name="{Binding Net_Key_Label, Source={x:Static strings:Strings.Instance}}"/>
                <Button Grid.Column="1" Style="{StaticResource DialogButton}" Margin="10,0,0,0" Click="CopyKey_Click"
                        AutomationProperties.AutomationId="Net_CopyKey"
                        Content="{Binding Common_Copy, Source={x:Static strings:Strings.Instance}}"/>
            </Grid>
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Net_Key_For, Source={x:Static strings:Strings.Instance}}" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ComboBox x:Name="HostBox" Grid.Column="1" Width="180" DisplayMemberPath="Name" SelectionChanged="Host_Changed"
                          AutomationProperties.AutomationId="Net_KeyHost"
                          AutomationProperties.Name="{Binding Net_Key_For, Source={x:Static strings:Strings.Instance}}"/>
                <TextBlock Grid.Column="2" Text="{Binding Net_Key_ForHint, Source={x:Static strings:Strings.Instance}}" FontSize="13" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </Grid>
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="LineBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" FontSize="12" VerticalAlignment="Center"
                         AutomationProperties.AutomationId="Net_KeyLine"
                         AutomationProperties.Name="{Binding Net_Key_Line_Label, Source={x:Static strings:Strings.Instance}}"/>
                <Button Grid.Column="1" Style="{StaticResource DialogButton}" Margin="10,0,0,0" Click="CopyLine_Click" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="Net_CopyKeyLine"
                        Content="{Binding Common_Copy, Source={x:Static strings:Strings.Instance}}"/>
            </Grid>
            <TextBlock x:Name="LineHint" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0" common:LiveText.Polite="True"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </Grid>
</views:DialogWindow>
