<ui:FluentWindow AutomationProperties.IsDialog="True" x:Class="PadForge.Views.KeepDriverDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:strings="clr-namespace:PadForge.Resources.Strings"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Width="440" SizeToContent="Height"
        MinHeight="170"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <!-- The Keep prompt after a keyboard's switch to PadForge's driver
         (#549), ConfirmDialog's chrome and footer. Give It Back holds the
         default and the focus, so Enter, Esc, the close button and the
         countdown all end on the undo. Keep fires only on a deliberate
         click (or Tab + Enter). -->
    <Grid Margin="20,18,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5"
                       Fill="{DynamicResource EmberBrush}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="TitleText"
                       FontFamily="{StaticResource DisplayFontFamily}"
                       FontWeight="SemiBold" FontSize="15"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       VerticalAlignment="Center"
                       Text="{Binding Devices_DriverKeepTitle, Source={x:Static strings:Strings.Instance}}"/>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="MessageText" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

        <!-- The countdown, in the confirm's mono fact line. A live region,
             so a screen reader says each second as it changes. -->
        <TextBlock Grid.Row="2" x:Name="CountdownText" Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"
                   FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12"
                   Foreground="{DynamicResource ColdBrush}"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="GiveBackButton" MinWidth="90" Margin="0,0,8,0"
                    Content="{Binding Devices_DriverGiveBack, Source={x:Static strings:Strings.Instance}}"
                    IsCancel="True" IsDefault="True"/>
            <Button x:Name="KeepButton" MinWidth="90"
                    Style="{StaticResource EmberDestructiveButton}"
                    Content="{Binding Devices_DriverKeep, Source={x:Static strings:Strings.Instance}}"
                    Click="KeepButton_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
